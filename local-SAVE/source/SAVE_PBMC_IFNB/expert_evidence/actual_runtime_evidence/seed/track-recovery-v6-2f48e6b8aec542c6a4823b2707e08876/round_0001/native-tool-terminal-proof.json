      "command": "/bin/sh -lc \"/opt/runtime/bin/python -c \\\"\nimport scanpy as sc\nimport numpy as np\n\ntrain = sc.read_h5ad('/workspace/public_assets/train.h5ad')\ndev_ctrl = sc.read_h5ad('/workspace/public_assets/dev_controls.h5ad')\n\ncell_types = sorted(train.obs['cell_type'].unique())\nprint('Training CTs:', cell_types)\n\n# Get dev control mean\ndev_mean = np.asarray(dev_ctrl.X.mean(axis=0)).flatten()\n\n# Get per-CT control means\nfor ct in cell_types:\n    mask = (train.obs['cell_type'] == ct) & (train.obs['condition'] == 'control')\n    ct_mean = np.asarray(train[mask].X.mean(axis=0)).flatten()\n    c = np.corrcoef(dev_mean, ct_mean)[0, 1]\n    print(f'  {ct}: corr = {c:.4f}')\n\\\" 2>&1\"",

{"type":"item.started","item":{"id":"item_67","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/head_gate_probe.py <<'PY'\nimport os\nos.environ['OPENBLAS_NUM_THREADS']='2'\nos.environ['OMP_NUM_THREADS']='2'\nos.environ['MKL_NUM_THREADS']='2'\nimport sys,pickle,time\nsys.path.insert(0,'/workspace/solution')\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport research_validation as rv\nimport neural_calibration as network\nimport conditional_calibration as gate\nf,y=rv.load()\nsplits=[(np.arange(50),np.arange(50,74)),(np.r_[0:25,49:74],np.arange(25,49))]\nwith threadpool_limits(limits=2):\n    for k,(tr,te) in enumerate(splits):\n        started=time.monotonic()\n        with open('/tmp/conditional_block_%d.pkl'%k,'rb') as stream:state,tt,nt,ot,on=pickle.load(stream)\n        with open('/tmp/network_head_summary_True_%d.pkl'%k,'rb') as stream:headed,hp=pickle.load(stream)\n        ff=rv.subset(f,tr); ft=rv.subset(f,te); yy=y[tr]\n        last=network.predict({**headed,'params':headed['last_params']},ft)\n        oa=np.empty_like(yy); ol=np.empty_like(yy)\n        for held in np.array_split(np.arange(len(tr)),3):\n            train=np.setdiff1d(np.arange(len(tr)),held)\n            fold=network.fit(rv.subset(ff,train),yy[train],17,site_head=True,average=True)\n            oa[held]=network.predict(fold,rv.subset(ff,held))\n            ol[held]=network.predict({**fold,'params':fold['last_params']},rv.subset(ff,held))\n            print('HEAD_FOLD',k,int(held[0]),round(time.monotonic()-started,1),flush=True)\n        with open('/tmp/head_oof_%d.pkl'%k,'wb') as stream:pickle.dump((oa,ol),stream)\n        for name,oof,pred in [('last',ol,last),('average',oa,hp)]:\n            model=gate._gate_fit(ff,yy,ot,oof)\n            w=gate._weight(model,ft,tt,pred)\n            print('CONSISTENT_HEAD_GATE',k,name,rv.mae(y[te],tt+w*(pred-tt)),\n                  'coeff',model['coef'].round(4),'weight',np.percentile(w,[10,50,90]).round(3),flush=True)\nPY\nOPENBLAS_NUM_THREADS=2 OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 python /tmp/head_gate_probe.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/sh -lc 'cat blended_calibration.py horizon_calibration.py neural_calibration.py'","aggregated_output":"\"\"\"Horizon-specific median trees blended with a smooth residual network.\"\"\"\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport horizon_calibration\nimport neural_calibration\n\n\ndef fit(features, targets, seed, graph=None):\n    with threadpool_limits(limits=2):\n        return {'tree': horizon_calibration.fit(features, targets, seed, groups=2, graph=graph),\n                'network': neural_calibration.fit(features, targets, seed, graph=graph),\n                # The smooth model is more useful at longer horizons on both\n                # public origin blocks; keep a conservative horizon schedule.\n                'network_weight': np.where(np.arange(features['base'].shape[1]) < 6,\n                                           0.18, 0.32).astype(np.float32)}\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=2):\n        tree = horizon_calibration.predict(state['tree'], features)\n        network = neural_calibration.predict(state['network'], features)\n        weight = np.asarray(state.get('network_weight', 0.25), dtype=np.float32)\n        return (tree * (1.0 - weight[None, :, None]) +\n                network * weight[None, :, None]).astype(np.float32)\n\"\"\"Partial pooling of median residual trees specialized by forecast horizon.\"\"\"\nimport numpy as np\nfrom sklearn.ensemble import HistGradientBoostingRegressor\nfrom threadpoolctl import threadpool_limits\nimport spatial_calibration\n\n\ndef _model(seed):\n    return HistGradientBoostingRegressor(\n        loss='absolute_error', max_iter=90, learning_rate=0.06,\n        max_leaf_nodes=15, min_samples_leaf=250, l2_regularization=20,\n        categorical_features=[14], early_stopping=False, random_state=seed)\n\n\ndef fit(features, targets, seed, groups=3, graph=None):\n    with threadpool_limits(limits=2):\n        pooled = spatial_calibration.fit(features, targets, seed, graph=graph)\n        x = spatial_calibration._features(features, pooled['graph'])\n        shape = features['base'].shape\n        x = x.reshape(*shape, -1)\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets)\n        valid = np.isfinite(y) & (y > 0)\n        residual = y - np.asarray(features['base'])\n        models = []\n        for horizons in np.array_split(np.arange(shape[1]), groups):\n            xx = x[:, horizons].reshape(-1, x.shape[-1])\n            ok = valid[:, horizons].reshape(-1)\n            yy = residual[:, horizons].reshape(-1)\n            model = _model(seed)\n            model.fit(xx[ok], yy[ok])\n            models.append((horizons, model))\n        return {'pooled': pooled, 'models': models, 'expert_weight': 0.5}\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=2):\n        shape = features['base'].shape\n        x = spatial_calibration._features(features, state['pooled']['graph']).reshape(*shape, -1)\n        expert = np.zeros(shape, dtype=np.float32)\n        for horizons, model in state['models']:\n            expert[:, horizons] = model.predict(x[:, horizons].reshape(-1, x.shape[-1])).reshape(shape[0], len(horizons), shape[2])\n        pooled = state['pooled']['model'].predict(x.reshape(-1, x.shape[-1])).reshape(shape)\n        weight = state['expert_weight']\n        correction = pooled * (1 - weight) + expert * weight\n        return np.maximum(np.asarray(features['base']) + correction, 0).astype(np.float32)\n\"\"\"Small NumPy residual network trained with a smooth absolute-error objective.\"\"\"\nimport time\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport spatial_calibration\n\n\ndef _features(features, graph):\n    raw = spatial_calibration._features(features, graph)\n    node = raw[:, 14].astype(np.int64)\n    clock = np.asarray(features['clock']).reshape(-1)\n    periodic = [np.sin(2 * np.pi * clock), np.cos(2 * np.pi * clock),\n                np.sin(4 * np.pi * clock), np.cos(4 * np.pi * clock)]\n    return np.column_stack([np.delete(raw, 14, axis=1)] + periodic), node\n\n\ndef _forward(x, node, params):\n    xx = np.column_stack([x, params['embedding'][node]])\n    h1 = np.tanh(xx @ params['w1'] + params['b1'])\n    h2 = np.tanh(h1 @ params['w2'] + params['b2'])\n    output = (h2 @ params['w3'] + x @ params['w0'] + params['b3']).reshape(-1)\n    return output, (xx, h1, h2)\n\n\ndef fit(features, targets, seed, epochs=100, graph=None):\n    with threadpool_limits(limits=2):\n        start = time.monotonic()\n        rng = np.random.default_rng(seed)\n        if graph is None:\n            graph = spatial_calibration._neighborhood(features)\n        x, node = _features(features, graph)\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets)\n        valid = (np.isfinite(y) & (y > 0)).reshape(-1)\n        residual = (y - np.asarray(features['base'])).reshape(-1)[valid] / 20\n        x, node = x[valid], node[valid]\n        center = np.mean(x, axis=0)\n        scale = np.maximum(np.std(x, axis=0), 0.01)\n        x = np.clip((x - center) / scale, -8, 8).astype(np.float32)\n        dim = x.shape[1] + 6\n        params = {'embedding': (rng.normal(size=(features['base'].shape[-1], 6)) * 0.05).astype(np.float32),\n                  'w1': (rng.normal(size=(dim, 48)) / np.sqrt(dim)).astype(np.float32),\n                  'b1': np.zeros(48, dtype=np.float32),\n                  'w2': (rng.normal(size=(48, 24)) / np.sqrt(48)).astype(np.float32),\n                  'b2': np.zeros(24, dtype=np.float32),\n                  'w0': np.zeros((x.shape[1], 1), dtype=np.float32),\n                  'w3': np.zeros((24, 1), dtype=np.float32),\n                  'b3': np.array([np.median(residual)], dtype=np.float32)}\n        first = {k: np.zeros_like(v) for k, v in params.items()}\n        second = {k: np.zeros_like(v) for k, v in params.items()}\n        step = 0\n        for epoch in range(epochs):\n            order = rng.permutation(x.shape[0])\n            rate = 0.003 * (0.35 + 0.65 * (1 - epoch / epochs))\n            for offset in range(0, len(order), 4096):\n                index = order[offset:offset + 4096]\n                output, (xx, h1, h2) = _forward(x[index], node[index], params)\n                error = output - residual[index]\n                dout = (error / np.sqrt(error * error + 0.01) / len(index))[:, None]\n                gradients = {'w0': x[index].T @ dout, 'w3': h2.T @ dout, 'b3': dout.sum(axis=0)}\n                dh2 = (dout @ params['w3'].T) * (1 - h2 * h2)\n                gradients.update(w2=h1.T @ dh2, b2=dh2.sum(axis=0))\n                dh1 = (dh2 @ params['w2'].T) * (1 - h1 * h1)\n                gradients.update(w1=xx.T @ dh1, b1=dh1.sum(axis=0))\n                dembed = (dh1 @ params['w1'].T)[:, -6:]\n                gradients['embedding'] = np.zeros_like(params['embedding'])\n                np.add.at(gradients['embedding'], node[index], dembed)\n                step += 1\n                for key, gradient in gradients.items():\n                    if key.startswith('w') or key == 'embedding':\n                        gradient = gradient + params[key] * 0.0002\n                    first[key] = 0.9 * first[key] + 0.1 * gradient\n                    second[key] = 0.999 * second[key] + 0.001 * gradient * gradient\n                    corrected = first[key] / (1 - 0.9 ** step)\n                    variance = second[key] / (1 - 0.999 ** step)\n                    params[key] -= rate * corrected / (np.sqrt(variance) + 1e-7)\n            if time.monotonic() - start > 150:\n                break\n        return {'graph': graph, 'center': center, 'scale': scale, 'params': params,\n                'epochs': epoch + 1, 'fit_seconds': time.monotonic() - start}\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=2):\n        x, node = _features(features, state['graph'])\n        x = np.clip((x - state['center']) / state['scale'], -8, 8).astype(np.float32)\n        residual = np.empty(x.shape[0], dtype=np.float32)\n        for offset in range(0, len(x), 8192):\n            end = offset + 8192\n            residual[offset:end] = _forward(x[offset:end], node[offset:end], state['params'])[0] * 20\n        return np.maximum(np.asarray(features['base']) + residual.reshape(features['base'].shape), 0).astype(np.float32)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/sh -lc 'cat /workspace/public_assets/manifest.json'","aggregated_output":"{\n  \"task_id\": \"auto2912\",\n  \"shared_pretrained_forecast_sha256\": \"71eeb60fa52b2ee141f8c860920857edd434f259d7b5016efaea24b298817b2d\",\n  \"train_origins\": 74,\n  \"dev_origins\": 148,\n  \"prediction_shape\": [\n    148,\n    12,\n    170\n  ],\n  \"feature_axes\": {\n    \"base\": \"sample,horizon,node\",\n    \"history\": \"sample,history_step,node\",\n    \"anchor\": \"sample,horizon,node\",\n    \"clock\": \"sample,horizon,node\"\n  },\n  \"data_sha256\": {\n    \"train_features.npz\": \"2de8db762fab6c688391a52252ff07d06d63075773aba7dfae8a2129b31e0082\",\n    \"train_targets.npz\": \"ebf32aa014a125461c872e924704be8f4f5da28fc33779bad96d4818ee99508c\",\n    \"dev_features.npz\": \"2296bd6147d5bbaa1484929506f1d9f26f84568d99ba463ac875897004040bec\",\n    \"graph.npz\": \"25ead8eabe96ca61d00e77d45bb86e958a65a5c6ef87dc9201cf4f6dd763364b\"\n  },\n  \"hidden_materials_included\": false,\n  \"reference_materials_included\": false\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/sh -lc 'cat research_validation.py tree_calibration.py spatial_calibration.py seasonal_calibration.py'","aggregated_output":"\"\"\"Public calibration origin-block comparisons; never reads development targets.\"\"\"\nimport time\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport tree_calibration\nimport spatial_calibration\n\n\ndef load():\n    features = dict(np.load('/workspace/public_assets/train_features.npz'))\n    targets = np.load('/workspace/public_assets/train_targets.npz')['target']\n    return features, targets\n\n\ndef subset(features, index):\n    return {key: value[index] for key, value in features.items()}\n\n\ndef mae(target, prediction):\n    valid = np.isfinite(target) & (target > 0)\n    return float(np.mean(np.abs(target[valid] - prediction[valid])))\n\n\ndef evaluate(fit, predict, name, splits=None):\n    features, targets = load()\n    if splits is None:\n        splits = [(np.arange(50), np.arange(50, 74)),\n                  (np.r_[0:25, 49:74], np.arange(25, 49))]\n    start = time.monotonic()\n    output = []\n    for train, test in splits:\n        state = fit(subset(features, train), targets[train], 17)\n        pred = predict(state, subset(features, test))\n        value = mae(targets[test], pred)\n        output.append(value)\n        print(name, 'test', test[0], test[-1], 'MAE', value,\n              'elapsed', round(time.monotonic() - start, 2), flush=True)\n    return output\n\n\nif __name__ == '__main__':\n    with threadpool_limits(limits=2):\n        evaluate(tree_calibration.fit, tree_calibration.predict, 'retained')\n        for variant in ['neighbors', 'relative']:\n            evaluate(lambda f, y, s: spatial_calibration.fit(f, y, s, variant=variant),\n                     spatial_calibration.predict, variant)\n\"\"\"Pooled nonlinear correction from current, anchor and historical context.\"\"\"\nimport numpy as np\nfrom sklearn.ensemble import HistGradientBoostingRegressor\nfrom threadpoolctl import threadpool_limits\nimport calibration\n\n\ndef _features(f, context=False):\n    b = np.asarray(f['base'], dtype=np.float32)\n    a = np.asarray(f['anchor'], dtype=np.float32)\n    z = np.asarray(f['history'], dtype=np.float32)\n    clock = np.asarray(f['clock'], dtype=np.float32)\n    def broadcast(v):\n        return np.broadcast_to(v[:, None, :], b.shape)\n    last = broadcast(z[:, -1, :])\n    avg3 = broadcast(np.mean(z[:, -3:, :], axis=1))\n    avg6 = broadcast(np.mean(z[:, -6:, :], axis=1))\n    avg = broadcast(np.mean(z, axis=1))\n    std = broadcast(np.std(z, axis=1))\n    delta = broadcast(np.mean(z[:, -3:, :],axis=1)-np.mean(z[:, :3, :],axis=1))\n    spread = broadcast(np.max(z,axis=1)-np.min(z,axis=1))\n    horizon = np.broadcast_to(np.arange(b.shape[1])[None, :, None],b.shape)\n    bd = np.gradient(b, axis=1)\n    ad = np.gradient(a, axis=1)\n    node = np.broadcast_to(np.arange(b.shape[2])[None,None,:],b.shape)\n    features = [b, a-b, last-b, avg3-b, avg6-b, avg-b, std, delta,\n                spread, clock, horizon, bd, ad, a, node]\n    if context:\n        def network(v):\n            return np.broadcast_to(np.mean(v,axis=2,keepdims=True),b.shape)\n        def block(v):\n            return np.broadcast_to(np.mean(v,axis=1,keepdims=True),b.shape)\n        features.extend([network(b),network(a-b),network(avg3-b),\n                         network(delta),network(std),\n                         (a-b)/np.maximum(a,30),std/np.maximum(avg,30),\n                         block(a-b),block(b)-b,\n                         b[:,0,None,:]+np.zeros_like(b)-b,\n                         np.sin(2*np.pi*clock),np.cos(2*np.pi*clock)])\n    return np.stack(features,axis=-1).reshape(-1,len(features))\n\n\ndef fit(features, targets, seed, mode='raw', max_iter=90, context=False):\n    with threadpool_limits(limits=2):\n        y = np.asarray(targets['target'] if isinstance(targets,dict) else targets)\n        valid = np.isfinite(y)&(y>0)\n        x = _features(features,context)\n        residual = y-np.asarray(features['base'])\n        model = HistGradientBoostingRegressor(loss='absolute_error',\n                    max_iter=max_iter,learning_rate=0.06,max_leaf_nodes=15,\n                    min_samples_leaf=250,l2_regularization=20,\n                    categorical_features=[14],early_stopping=False,\n                    random_state=seed)\n        state = {'mode':mode, 'context':context}\n        if mode=='residual':\n            state['linear']=calibration.fit(features,targets,seed)\n            residual=y-calibration.predict(state['linear'],features)\n        model.fit(x[valid.ravel()],residual[valid])\n        state['model']=model\n        return state\n\n\ndef predict(state,features):\n    with threadpool_limits(limits=2):\n        residual=state['model'].predict(_features(features,state.get('context',False))).reshape(features['base'].shape)\n        base=np.asarray(features['base'])\n        if state['mode']=='residual':\n            base=calibration.predict(state['linear'],features)\n        return np.maximum(base+residual,0).astype(np.float32)\n\"\"\"Median residual trees with neighborhoods learned from calibration history.\"\"\"\nimport numpy as np\nfrom sklearn.ensemble import HistGradientBoostingRegressor\nfrom threadpoolctl import threadpool_limits\nimport tree_calibration\n\n\ndef _neighborhood(features, count=8):\n    history = np.asarray(features['history'], dtype=np.float64)\n    changes = np.diff(history, axis=1).reshape(-1, history.shape[2])\n    changes -= np.mean(changes, axis=0)\n    scale = np.maximum(np.std(history.reshape(-1, history.shape[2]), axis=0), 10)\n    norm = np.sqrt(np.sum(changes * changes, axis=0))\n    correlation = (changes.T @ changes) / np.maximum(norm[:, None] * norm[None, :], 1)\n    np.fill_diagonal(correlation, -1)\n    neighbors = np.argsort(correlation, axis=1)[:, -count:]\n    weights = np.maximum(np.take_along_axis(correlation, neighbors, axis=1), 0) ** 2\n    weights /= np.maximum(weights.sum(axis=1, keepdims=True), 1e-8)\n    return {'neighbors': neighbors, 'weights': weights.astype(np.float32),\n            'scale': scale.astype(np.float32)}\n\n\ndef _features(features, graph, variant='neighbors'):\n    x = tree_calibration._features(features)\n    base = np.asarray(features['base'], dtype=np.float32)\n    anchor = np.asarray(features['anchor'], dtype=np.float32)\n    history = np.asarray(features['history'], dtype=np.float32)\n    scale = graph['scale']\n    def aggregate(value):\n        normalized = value / scale\n        mean = np.sum(normalized[..., graph['neighbors']] * graph['weights'], axis=-1)\n        return mean * scale\n    recent = np.mean(history[:, -3:, :], axis=1)[:, None, :]\n    older = np.mean(history[:, :3, :], axis=1)[:, None, :]\n    last = history[:, -1:, :]\n    spread = np.std(history, axis=1)[:, None, :]\n    extra = [aggregate(anchor - base), aggregate(recent - base),\n             aggregate(last - base), np.broadcast_to(aggregate(recent - older), base.shape),\n             np.broadcast_to(aggregate(spread), base.shape)]\n    if variant == 'relative':\n        extra.extend([(anchor - base) / scale, (recent - base) / scale,\n                      np.broadcast_to(spread / scale, base.shape),\n                      base / np.maximum(anchor, 30),\n                      aggregate(anchor - base) - (anchor - base)])\n    if 'physical' in graph:\n        def physical(value):\n            return ((value / scale) @ graph['physical'].T) * scale\n        extra.extend([physical(anchor - base), physical(recent - base),\n                      physical(last - base),\n                      np.broadcast_to(physical(recent - older), base.shape),\n                      np.broadcast_to(physical(spread), base.shape)])\n    return np.column_stack([x] + [v.reshape(-1) for v in extra])\n\n\ndef fit(features, targets, seed, variant='neighbors', max_iter=90, graph=None):\n    with threadpool_limits(limits=2):\n        if graph is None:\n            graph = _neighborhood(features)\n        x = _features(features, graph, variant)\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets)\n        valid = np.isfinite(y) & (y > 0)\n        residual = y - np.asarray(features['base'])\n        model = HistGradientBoostingRegressor(\n            loss='absolute_error', max_iter=max_iter, learning_rate=0.06,\n            max_leaf_nodes=15, min_samples_leaf=250, l2_regularization=20,\n            categorical_features=[14], early_stopping=False, random_state=seed)\n        model.fit(x[valid.ravel()], residual[valid])\n        return {'graph': graph, 'variant': variant, 'model': model}\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=2):\n        x = _features(features, state['graph'], state['variant'])\n        residual = state['model'].predict(x).reshape(features['base'].shape)\n        return np.maximum(np.asarray(features['base']) + residual, 0).astype(np.float32)\n\"\"\"Median residual calibration using anchor-aligned historical innovations.\"\"\"\nimport numpy as np\nfrom sklearn.ensemble import HistGradientBoostingRegressor\nfrom threadpoolctl import threadpool_limits\nimport spatial_calibration\n\n\ndef _basis(clock, harmonics=8):\n    arr = [np.ones_like(clock)]\n    for k in range(1, harmonics + 1):\n        arr.extend([np.sin(2 * np.pi * k * clock), np.cos(2 * np.pi * k * clock)])\n    return np.stack(arr, axis=-1)\n\n\ndef _template(features):\n    clock = np.asarray(features['clock'], dtype=np.float64)[:, :, 0].reshape(-1)\n    anchor = np.asarray(features['anchor'], dtype=np.float64).reshape(-1, features['base'].shape[-1])\n    x = _basis(clock)\n    penalty = np.diag(np.r_[0.1, np.repeat(np.arange(1, 9) ** 2, 2) * 2])\n    coef = np.linalg.solve(x.T @ x + penalty, x.T @ anchor)\n    return coef.astype(np.float32)\n\n\ndef _features(features, state):\n    x = spatial_calibration._features(features, state['graph'])\n    base = np.asarray(features['base'], dtype=np.float32)\n    anchor = np.asarray(features['anchor'], dtype=np.float32)\n    history = np.asarray(features['history'], dtype=np.float32)\n    future_clock = np.asarray(features['clock'])[:, :, 0]\n    history_clock = (future_clock[:, :1] - np.arange(12, 0, -1)[None, :] / 288) % 1\n    template_future = _basis(future_clock) @ state['template']\n    template_history = _basis(history_clock) @ state['template']\n    def broadcast(v):\n        return np.broadcast_to(v[:, None, :], base.shape)\n    aligned_history = template_history + np.mean(anchor - template_future, axis=1)[:, None, :]\n    innovation = history - aligned_history\n    last = innovation[:, -1, :]\n    recent = np.mean(innovation[:, -3:, :], axis=1)\n    older = np.mean(innovation[:, :6, :], axis=1)\n    slope = np.mean(innovation[:, -3:, :], axis=1) - np.mean(innovation[:, :3, :], axis=1)\n    extra = [broadcast(last), broadcast(recent), broadcast(older), broadcast(slope),\n             broadcast(np.std(innovation, axis=1)), anchor - template_future,\n             template_future - base]\n    if state['variant'] == 'neighbors':\n        graph = state['graph']\n        def aggregate(v):\n            normalized = v / graph['scale']\n            return np.sum(normalized[..., graph['neighbors']] * graph['weights'], axis=-1) * graph['scale']\n        extra += [broadcast(aggregate(last)), broadcast(aggregate(recent)), broadcast(aggregate(slope))]\n    if state['variant'] == 'extrapolated':\n        slope_anchor = np.mean(np.diff(anchor[:, :4, :], axis=1), axis=1)\n        expected_last = anchor[:, 0, :] - slope_anchor\n        extra += [broadcast(history[:, -1, :] - expected_last),\n                  broadcast(np.mean(history[:, -3:, :], axis=1) - (expected_last - slope_anchor)),\n                  broadcast(slope_anchor)]\n    return np.column_stack([x] + [v.reshape(-1) for v in extra])\n\n\ndef fit(features, targets, seed, variant='local', max_iter=90):\n    with threadpool_limits(limits=2):\n        state = {'template': _template(features),\n                 'graph': spatial_calibration._neighborhood(features), 'variant': variant}\n        x = _features(features, state)\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets)\n        valid = np.isfinite(y) & (y > 0)\n        residual = y - np.asarray(features['base'])\n        model = HistGradientBoostingRegressor(\n            loss='absolute_error', max_iter=max_iter, learning_rate=0.06,\n            max_leaf_nodes=15, min_samples_leaf=250, l2_regularization=20,\n            categorical_features=[14], early_stopping=False, random_state=seed)\n        model.fit(x[valid.ravel()], residual[valid])\n        state['model'] = model\n        return state\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=2):\n        residual = state['model'].predict(_features(features, state)).reshape(features['base'].shape)\n        return np.maximum(np.asarray(features['base']) + residual, 0).astype(np.float32)\n","exit_code":0,"status":"completed"}}

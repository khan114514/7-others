{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/conditional_probe.py <<'PY'\nimport os\nos.environ['OMP_NUM_THREADS']='2'\nos.environ['OPENBLAS_NUM_THREADS']='2'\nos.environ['MKL_NUM_THREADS']='2'\nimport sys, time, pickle\nsys.path.insert(0, '/workspace/solution')\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport research_validation as rv\nimport blended_calibration as blend\nimport horizon_calibration as tree\nimport neural_calibration as network\nimport conditional_calibration as gate\n\nfeatures, target = rv.load()\nsplits=[(np.arange(50), np.arange(50,74)),(np.r_[0:25,49:74], np.arange(25,49))]\nwith threadpool_limits(limits=2):\n    for k,(train,test) in enumerate(splits):\n        started=time.monotonic()\n        f=rv.subset(features,train); ft=rv.subset(features,test); y=target[train]\n        cache='/tmp/conditional_block_%d.pkl'%k\n        if os.path.exists(cache):\n            with open(cache,'rb') as stream: data=pickle.load(stream)\n        else:\n            state=blend.fit(f,y,17)\n            tt=tree.predict(state['tree'],ft); nt=network.predict(state['network'],ft)\n            ot=np.empty_like(y); on=np.empty_like(y)\n            for held in np.array_split(np.arange(len(train)),3):\n                tr=np.setdiff1d(np.arange(len(train)),held)\n                fold=blend.fit(rv.subset(f,tr),y[tr],17)\n                ot[held]=tree.predict(fold['tree'],rv.subset(f,held))\n                on[held]=network.predict(fold['network'],rv.subset(f,held))\n                print('fold',k,int(held[0]),'elapsed',round(time.monotonic()-started,1),flush=True)\n            data=(state,tt,nt,ot,on)\n            with open(cache,'wb') as stream:pickle.dump(data,stream)\n        state,tt,nt,ot,on=data\n        baseline=blend.predict(state,ft)\n        print('BASELINE',k,rv.mae(target[test],baseline),flush=True)\n        for penalty in [0.04,0.01,0.002]:\n            model=gate._gate_fit(f,y,ot,on,penalty)\n            weights=gate._weight(model,ft,tt,nt)\n            prediction=tt+weights*(nt-tt)\n            print('GATE',k,penalty,rv.mae(target[test],prediction),'coef',model['coef'].round(4),'weights',np.percentile(weights,[10,50,90]).round(4),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

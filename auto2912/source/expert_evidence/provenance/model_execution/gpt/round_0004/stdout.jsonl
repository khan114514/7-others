{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/sh -lc 'cat stacked_calibration.py bagged_calibration.py dynamics_calibration.py hierarchical_calibration.py'","aggregated_output":"\"\"\"Cross-fitted tree forecasts with a smooth residual correction network.\"\"\"\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport horizon_calibration\nimport neural_calibration\n\n\ndef _with_base(features, base):\n    return {**features, 'base': base}\n\n\ndef fit(features, targets, seed):\n    with threadpool_limits(limits=2):\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets)\n        out_of_fold = np.zeros_like(y)\n        index = np.arange(len(y))\n        for held in np.array_split(index, 3):\n            train = np.setdiff1d(index, held)\n            fold = horizon_calibration.fit({k: v[train] for k, v in features.items()}, y[train], seed, groups=2)\n            out_of_fold[held] = horizon_calibration.predict(fold, {k: v[held] for k, v in features.items()})\n        network = neural_calibration.fit(_with_base(features, out_of_fold), y, seed)\n        tree = horizon_calibration.fit(features, y, seed, groups=2)\n        return {'tree': tree, 'network': network, 'correction_weight': 0.25}\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=2):\n        tree = horizon_calibration.predict(state['tree'], features)\n        corrected = neural_calibration.predict(state['network'], _with_base(features, tree))\n        weight = state['correction_weight']\n        return (tree * (1 - weight) + corrected * weight).astype(np.float32)\n\"\"\"Origin bootstrap regularization of the pooled residual-tree component.\"\"\"\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport blended_calibration\nimport horizon_calibration\nimport spatial_calibration\nimport neural_calibration\n\n\ndef fit(features, targets, seed, network=True, copies=3):\n    with threadpool_limits(limits=2):\n        state = (blended_calibration.fit(features, targets, seed) if network else\n                 {'tree': horizon_calibration.fit(features, targets, seed, groups=2)})\n        tree = state['tree']\n        x = spatial_calibration._features(features, tree['pooled']['graph'])\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets)\n        valid = np.isfinite(y) & (y > 0)\n        residual = y - np.asarray(features['base'])\n        rng = np.random.default_rng(seed)\n        models = []\n        for _ in range(copies):\n            counts = rng.poisson(1, size=y.shape[0]).astype(np.float32)\n            weights = np.broadcast_to(counts[:, None, None], y.shape)[valid]\n            weights = weights / np.mean(weights)\n            model = horizon_calibration._model(seed)\n            model.fit(x[valid.ravel()], residual[valid], sample_weight=weights)\n            models.append(model)\n        state['bags'] = models\n        state['bag_weight'] = 0.5\n        return state\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=2):\n        tree = state['tree']\n        shape = features['base'].shape\n        x = spatial_calibration._features(features, tree['pooled']['graph'])\n        pooled = tree['pooled']['model'].predict(x).reshape(shape)\n        bag = np.mean([model.predict(x).reshape(shape) for model in state['bags']], axis=0)\n        pooled = pooled * (1 - state['bag_weight']) + bag * state['bag_weight']\n        x = x.reshape(*shape, -1)\n        expert = np.zeros(shape, dtype=np.float32)\n        for horizons, model in tree['models']:\n            xx = x[:, horizons].reshape(-1, x.shape[-1])\n            expert[:, horizons] = model.predict(xx).reshape(shape[0], len(horizons), shape[2])\n        correction = pooled * (1 - tree['expert_weight']) + expert * tree['expert_weight']\n        forecast = np.maximum(np.asarray(features['base']) + correction, 0)\n        if 'network' in state:\n            forecast = 0.75 * forecast + 0.25 * neural_calibration.predict(state['network'], features)\n        return forecast.astype(np.float32)\n\"\"\"Residual trees with explicit history dynamics and sensor-level scaling.\"\"\"\nimport numpy as np\nfrom sklearn.ensemble import HistGradientBoostingRegressor\nfrom threadpoolctl import threadpool_limits\nimport tree_calibration\nimport spatial_calibration\n\n\ndef _profile(features):\n    history = np.asarray(features['history'], dtype=np.float32)\n    flat = history.reshape(-1, history.shape[-1])\n    return {'mean': np.maximum(np.mean(flat, axis=0), 10),\n            'std': np.maximum(np.std(flat, axis=0), 10),\n            'median': np.median(flat, axis=0),\n            'quartiles': np.percentile(flat, [10, 90], axis=0).astype(np.float32)}\n\n\ndef _features(f, state):\n    if state.get('neighbors'):\n        x = spatial_calibration._features(f, state['graph'])\n    else:\n        x = tree_calibration._features(f)\n    base = np.asarray(f['base'], dtype=np.float32)\n    anchor = np.asarray(f['anchor'], dtype=np.float32)\n    history = np.asarray(f['history'], dtype=np.float32)\n    def broadcast(v):\n        return np.broadcast_to(v, base.shape)\n    recent = np.mean(history[:, -3:, :], axis=1)[:, None, :]\n    extra = []\n    if state['variant'] in ('lags', 'both', 'robust'):\n        extra.extend([broadcast(history[:, j:j+1, :]) - base for j in (0, 3, 6, 8, 10)])\n        extra.extend([broadcast(base[:, :1, :]) - base,\n                      broadcast(base[:, -1:, :]) - base,\n                      broadcast(np.mean(base, axis=1, keepdims=True)) - base,\n                      broadcast(anchor[:, :1, :]) - anchor,\n                      broadcast(anchor[:, -1:, :]) - anchor,\n                      broadcast(np.median(history[:, -3:, :], axis=1)[:, None, :]) - base,\n                      broadcast(np.median(history, axis=1)[:, None, :]) - base])\n    if state['variant'] in ('profile', 'both', 'robust'):\n        profile = state['profile']\n        mean, std = profile['mean'], profile['std']\n        extra.extend([broadcast(mean), broadcast(std),\n                      base / mean, anchor / mean,\n                      (base - profile['median']) / std,\n                      (anchor - base) / std,\n                      (recent - base) / std])\n    if state['variant'] == 'robust':\n        spread = np.percentile(history, 75, axis=1) - np.percentile(history, 25, axis=1)\n        extra.extend([broadcast(spread[:, None, :]),\n                      broadcast(np.mean(history == 0, axis=1)[:, None, :]),\n                      (anchor - base) / np.maximum(anchor, 30),\n                      np.sin(2 * np.pi * f['clock']), np.cos(2 * np.pi * f['clock'])])\n    return np.column_stack([x] + [v.reshape(-1) for v in extra])\n\n\ndef fit(features, targets, seed, variant='both', neighbors=False, max_iter=90):\n    with threadpool_limits(limits=2):\n        state = {'variant': variant, 'profile': _profile(features), 'neighbors': neighbors}\n        if neighbors:\n            state['graph'] = spatial_calibration._neighborhood(features)\n        x = _features(features, state)\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets)\n        valid = np.isfinite(y) & (y > 0)\n        residual = y - np.asarray(features['base'])\n        model = HistGradientBoostingRegressor(\n            loss='absolute_error', max_iter=max_iter, learning_rate=0.06,\n            max_leaf_nodes=15, min_samples_leaf=250, l2_regularization=20,\n            categorical_features=[14], early_stopping=False, random_state=seed)\n        model.fit(x[valid.ravel()], residual[valid])\n        state['model'] = model\n        return state\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=2):\n        residual = state['model'].predict(_features(features, state)).reshape(features['base'].shape)\n        return np.maximum(np.asarray(features['base']) + residual, 0).astype(np.float32)\n\"\"\"Pooled median tree followed by regularized sensor-specific corrections.\"\"\"\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport spatial_calibration\n\n\ndef _design(features, mode, center):\n    base = np.asarray(features['base'], dtype=np.float64)\n    history = np.asarray(features['history'], dtype=np.float64)\n    anchor = np.asarray(features['anchor'], dtype=np.float64)\n    arr = [np.ones_like(base)]\n    if mode == 'affine':\n        horizon = np.broadcast_to(np.linspace(-1, 1, base.shape[1])[None, :, None], base.shape)\n        recent = np.mean(history[:, -3:, :], axis=1)[:, None, :]\n        arr += [horizon, np.clip((anchor - base) / 50, -5, 5),\n                np.clip((recent - base) / 50, -5, 5),\n                (base - center) / 200]\n    return np.stack(arr, axis=-1)\n\n\ndef _sensor_fit(x, residual, valid):\n    xx = x.transpose(2, 0, 1, 3).reshape(x.shape[2], -1, x.shape[-1])\n    yy = residual.transpose(2, 0, 1).reshape(x.shape[2], -1)\n    mask = valid.transpose(2, 0, 1).reshape(x.shape[2], -1)\n    yy = np.where(mask, yy, 0)\n    coef = np.zeros((x.shape[2], x.shape[-1]))\n    strength = np.array([10, 50, 60, 60, 60], dtype=np.float64)[:x.shape[-1]]\n    for _ in range(12):\n        error = yy - np.einsum('nrp,np->nr', xx, coef)\n        weights = mask / np.maximum(np.abs(error), 3)\n        gram = np.einsum('nrp,nr,nrq->npq', xx, weights, xx, optimize=True)\n        rhs = np.einsum('nrp,nr,nr->np', xx, weights, yy, optimize=True)\n        coef = np.linalg.solve(gram + np.diag(strength), rhs[..., None])[..., 0]\n    return coef.astype(np.float32)\n\n\ndef fit(features, targets, seed, mode='offset', crossfit=False):\n    with threadpool_limits(limits=2):\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets)\n        tree = spatial_calibration.fit(features, y, seed)\n        if crossfit:\n            prediction = np.zeros_like(y)\n            for held in np.array_split(np.arange(y.shape[0]), 3):\n                train = np.setdiff1d(np.arange(y.shape[0]), held)\n                fold = spatial_calibration.fit({k: v[train] for k, v in features.items()}, y[train], seed)\n                prediction[held] = spatial_calibration.predict(fold, {k: v[held] for k, v in features.items()})\n        else:\n            prediction = spatial_calibration.predict(tree, features)\n        valid = np.isfinite(y) & (y > 0)\n        center = np.mean(features['base'], axis=(0, 1), keepdims=True)\n        x = _design(features, mode, center)\n        coef = _sensor_fit(x, y - prediction, valid)\n        return {'tree': tree, 'coef': coef, 'mode': mode, 'center': center}\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=2):\n        baseline = spatial_calibration.predict(state['tree'], features)\n        correction = np.einsum('shnp,np->shn', _design(features, state['mode'], state['center']), state['coef'])\n        return np.maximum(baseline + correction, 0).astype(np.float32)\n","exit_code":0,"status":"completed"}}

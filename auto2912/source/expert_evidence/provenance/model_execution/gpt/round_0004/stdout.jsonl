{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/site_head_probe.py <<'PY'\nimport os\nos.environ['OPENBLAS_NUM_THREADS']='2'\nos.environ['OMP_NUM_THREADS']='2'\nos.environ['MKL_NUM_THREADS']='2'\nimport sys,pickle,time\nsys.path.insert(0,'/workspace/solution')\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport research_validation as rv\nimport neural_calibration as network\nimport conditional_calibration as gate\nf,y=rv.load()\nsplits=[(np.arange(50),np.arange(50,74)),(np.r_[0:25,49:74],np.arange(25,49))]\nwith threadpool_limits(limits=2):\n    for k,(tr,te) in enumerate(splits):\n        with open('/tmp/conditional_block_%d.pkl'%k,'rb') as stream:state,tt,nt,ot,on=pickle.load(stream)\n        with open('/tmp/network_relative_%d.pkl'%k,'rb') as stream:relative,nn=pickle.load(stream)\n        ft=rv.subset(f,te); model=gate._gate_fit(rv.subset(f,tr),y[tr],ot,on)\n        def evaluate(name,p):\n            w=gate._weight(model,ft,tt,p)\n            print(name,k,rv.mae(y[te],tt+w*(p-tt)),flush=True)\n        evaluate('GATE',nt); evaluate('GATE_RELATIVE_ENSEMBLE',(nt+nn)/2)\n        for mode in ['summary','relative']:\n            started=time.monotonic()\n            headed=network.fit(rv.subset(f,tr),y[tr],17,graph=state['tree']['pooled']['graph'],mode=mode,site_head=True)\n            hp=network.predict(headed,ft)\n            with open('/tmp/network_head_%s_%d.pkl'%(mode,k),'wb') as stream:pickle.dump((headed,hp),stream)\n            evaluate('HEAD_'+mode+'_REPLACE',hp)\n            evaluate('HEAD_'+mode+'_ENSEMBLE',(hp+nn)/2 if mode=='summary' else (nt+hp)/2)\n            print('HEAD_DIAGNOSTIC',mode,k,'pure',rv.mae(y[te],hp),'head coefficient rms',float(np.sqrt(np.mean(headed['params']['site_head']**2))),'seconds',round(time.monotonic()-started,1),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

57\t    graph = state['graph']\n   158\t    normalized = innovation / graph['scale']\n   159\t    pooling = state.get('pooling', 'static')\n   160\t    if pooling == 'static':\n   161\t        neighbor = np.sum(normalized[..., graph['neighbors']] * graph['weights'], axis=-1)\n   162\t        neighbor *= graph['scale']\n   163\t        return np.maximum(features['base'] + seasonal + 0.75 * innovation + 0.25 * neighbor, 0)\n   164\t    # A fixed history graph can connect sensors experiencing different current\n   165\t    # deviations. Share changing corrections preferentially along edges whose\n   166\t    # known anchor/base and recent-history/base disagreements currently match.\n   167\t    scale = graph['scale']\n   168\t    neighbors = graph['neighbors']\n   169\t    anchor = (np.asarray(features['anchor']) - features['base']) / scale\n   170\t    recent = (np.mean(features['history'][:, -3:, :], axis=1)[:, None, :]\n   171\t              - features['base']) / scale\n   172\t    distance = ((anchor[..., neighbors] - anchor[..., None]) ** 2\n   173\t                + (recent[..., neighbors] - recent[..., None]) ** 2) / 2\n   174\t    affinity = 1 / (1 + distance)\n   175\t    weights = graph['weights'] * affinity\n   176\t    if pooling == 'context_normalize':\n   177\t        weights /= np.maximum(weights.sum(axis=-1, keepdims=True), 1e-8)\n   178\t    difference = normalized[..., neighbors] - normalized[..., None]\n   179\t    if 'threshold' in state:\n   180\t        threshold = state['threshold'][:, None]\n   181\t        difference = threshold * np.tanh(difference / threshold)\n   182\t    shared = normalized + 0.25 * np.sum(weights * difference, axis=-1)\n   183\t    return np.maximum(features['base'] + seasonal + shared * scale, 0)\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/sh -lc \"sed -n '1,180p' /tmp/edge_turn_validation.py\"","aggregated_output":"\"\"\"Matched public-calibration experiments for block-stable innovation graphs.\"\"\"\nimport pickle\nimport sys\nimport time\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\n\nsys.path.insert(0, '/workspace/solution')\nsys.path.insert(0, '/tmp/forecast_turn_periodic')\nimport conditional_calibration as c\nimport spatial_calibration as s\nimport research_validation as r\nfrom temporal_validation import load\n\n\ndef innovation(f, p):\n    state = s.diffusion_fit(f, p, graph_mode='prediction')\n    shape = f['base'].shape\n    clock = np.asarray(f['clock'], dtype=np.float64)\n    h = np.broadcast_to(np.linspace(-1, 1, shape[1])[None, :, None], shape)\n    x = np.stack([np.ones(shape), h, np.sin(2 * np.pi * clock),\n                  np.cos(2 * np.pi * clock), np.sin(4 * np.pi * clock),\n                  np.cos(4 * np.pi * clock)], axis=-1)\n    seasonal = np.einsum('shni,ni->shn', x, state['coef'])\n    return state, np.asarray(p, dtype=np.float64) - f['base'] - seasonal\n\n\ndef correlation(a):\n    a = a.reshape(-1, a.shape[-1]).copy()\n    a -= a.mean(axis=0)\n    norm = np.sqrt(np.sum(a * a, axis=0))\n    return (a.T @ a) / np.maximum(norm[:, None] * norm[None, :], 1)\n\n\ndef graph_fit(f, p, mode):\n    state, residual = innovation(f, p)\n    if mode == 'control':\n        return state\n    blocks = np.array_split(np.arange(len(p)), 3)\n    correlations = np.stack([correlation(residual[b]) for b in blocks])\n    mean = correlations.mean(axis=0)\n    if mode == 'centered':\n        centered = residual.copy()\n        for block in blocks:\n            centered[block] -= centered[block].mean(axis=(0, 1), keepdims=True)\n        similarity = correlation(centered)\n    elif mode == 'trajectory':\n        similarity = correlation(np.diff(residual, axis=1))\n    elif mode == 'median':\n        similarity = np.median(correlations, axis=0)\n    elif mode == 'consensus':\n        similarity = np.min(correlations, axis=0)\n    elif mode == 'confidence':\n        similarity = mean - np.std(correlations, axis=0)\n    elif mode == 'confidence_fallback':\n        similarity = mean - np.std(correlations, axis=0)\n    else:\n        raise ValueError(mode)\n    np.fill_diagonal(similarity, -1)\n    neighbors = np.argsort(similarity, axis=1)[:, -8:]\n    evidence = np.maximum(np.take_along_axis(similarity, neighbors, axis=1), 0)\n    weights = evidence ** 2\n    weights /= np.maximum(weights.sum(axis=1, keepdims=True), 1e-8)\n    state['graph'] = {'neighbors': neighbors, 'weights': weights.astype(np.float32),\n                      'scale': state['graph']['scale'], 'source': mode}\n    if mode == 'confidence_fallback':\n        history = s._neighborhood(f)\n        raw_support = np.maximum(np.take_along_axis(mean, neighbors, axis=1), 0)\n        stable_fraction = (evidence ** 2).sum(axis=1) / np.maximum(\n            (raw_support ** 2).sum(axis=1), 1e-8)\n        state['confidence'] = np.clip(stable_fraction, 0, 1).astype(np.float32)\n        state['fallback'] = history\n    return state\n\n\ndef graph_predict(state, f, p):\n    value = s.diffusion_predict(state, f, p)\n    if 'fallback' not in state:\n        return value\n    fallback = dict(state, graph=state['fallback'])\n    alternate = s.diffusion_predict(fallback, f, p)\n    confidence = state['confidence'][None, None, :]\n    return confidence * value + (1 - confidence) * alternate\n\n\nif __name__ == '__main__':\n    started = time.monotonic()\n    modes = sys.argv[1:] or ['control', 'centered', 'consensus', 'confidence',\n                              'confidence_fallback']\n    splits = ['last', 'middle', 'first']\n    if modes[0] in splits:\n        splits = [modes.pop(0)]\n    with threadpool_limits(limits=1):\n        for split in splits:\n            q, raw_o, raw_v = load(split)\n            cache = pickle.load(open('/tmp/forecast_turn_additive/' + split + '.additive', 'rb'))\n            print(split, 'matched network maxdiff', np.max(np.abs(raw_v - q['network'])),\n                  'raw OOF vs q cached', np.mean(np.abs(raw_o - q.get('no', raw_o))), flush=True)\n            output = {'q': q, 'raw_o': raw_o, 'raw_v': raw_v}\n            for mode in modes:\n                diffusion = graph_fit(q['ft'], raw_o, mode)\n                no = graph_predict(diffusion, q['ft'], raw_o)\n                nv = graph_predict(diffusion, q['fv'], raw_v)\n                gate = c._gate_fit(q['ft'], q['yt'], q['to'], no,\n                                   mode='site_history_trend')\n                blend = c._blend(gate, q['fv'], q['tree'], nv)\n                stage = c._residual_tree_fit(q['ft'], q['yt'], q['to'], no, 17,\n                                            'site_history_trend', diffuse='context_smooth')\n                prediction = c._residual_tree_predict(stage, q['fv'], q['tree'], nv, blend)\n                value = r.mae(q['yv'], prediction)\n                output[mode] = {'diffusion': diffusion, 'gate': gate, 'stage': stage,\n                                'no': no, 'nv': nv, 'blend': blend,\n                                'prediction': prediction, 'mae': value}\n                print(split, mode, 'MAE', value, 'network', r.mae(q['yv'], nv),\n                      'elapsed', round(time.monotonic() - started, 1), flush=True)\n                if 'confidence' in diffusion:\n                    print(split, 'confidence quantiles',\n                          np.quantile(diffusion['confidence'], [0, .25, .5, .75, 1]).tolist(),\n                          flush=True)\n            suffix = '_'.join(modes)\n            with open('/tmp/' + split + '.edge_turn_' + suffix, 'wb') as out:\n                pickle.dump(output, out)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/sh -lc \"sed -n '1,180p' /tmp/edge_scale_turn_validation.py\"","aggregated_output":"\"\"\"Calibration-only scale and support tests after block-median edge selection.\"\"\"\nimport pickle\nimport sys\nimport time\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nsys.path.insert(0, '/workspace/solution')\nsys.path.insert(0, '/tmp')\nimport conditional_calibration as c\nimport spatial_calibration as s\nimport research_validation as r\nfrom edge_turn_validation import innovation, correlation\n\n\ndef variant_fit(f, raw, mode):\n    state = s.diffusion_fit(f, raw, graph_mode='prediction_median')\n    if mode == 'control':\n        return state\n    _, residual = innovation(f, raw)\n    blocks = np.array_split(np.arange(len(raw)), 3)\n    if mode in ('centered_scale', 'median_scale'):\n        variances = np.stack([np.var(residual[b], axis=(0, 1)) for b in blocks])\n        variance = np.mean(variances, axis=0) if mode == 'centered_scale' else np.median(variances, axis=0)\n        state['graph']['scale'] = np.maximum(np.sqrt(variance), 10).astype(np.float32)\n    elif mode == 'stable_weights':\n        correlations = np.stack([correlation(residual[b]) for b in blocks])\n        graph = state['graph']\n        median = np.median(correlations, axis=0)\n        uncertainty = np.std(correlations, axis=0)\n        evidence = np.maximum(median, 0) ** 2\n        reliability = evidence / np.maximum(evidence + uncertainty ** 2, 1e-8)\n        weights = graph['weights'] * np.take_along_axis(reliability, graph['neighbors'], axis=1)\n        graph['weights'] = (weights / np.maximum(weights.sum(axis=1, keepdims=True), 1e-8)).astype(np.float32)\n    elif mode == 'stable_fallback':\n        correlations = np.stack([correlation(residual[b]) for b in blocks])\n        graph = state['graph']\n        median = np.median(correlations, axis=0)\n        uncertainty = np.std(correlations, axis=0)\n        evidence = np.maximum(median, 0) ** 2\n        reliability = evidence / np.maximum(evidence + uncertainty ** 2, 1e-8)\n        support = np.take_along_axis(reliability, graph['neighbors'], axis=1)\n        state['confidence'] = np.sum(graph['weights'] * support, axis=1).astype(np.float32)\n        state['fallback'] = s._neighborhood(f)\n    elif mode == 'reciprocal':\n        graph = state['graph']\n        adjacency = np.zeros((len(graph['scale']), len(graph['scale'])))\n        np.put_along_axis(adjacency, graph['neighbors'], graph['weights'], axis=1)\n        reverse = np.take_along_axis(adjacency.T, graph['neighbors'], axis=1)\n        weights = np.sqrt(graph['weights'] * reverse)\n        no_reciprocal = weights.sum(axis=1) == 0\n        weights[no_reciprocal] = graph['weights'][no_reciprocal]\n        graph['weights'] = (weights / np.maximum(weights.sum(axis=1, keepdims=True), 1e-8)).astype(np.float32)\n    else:\n        raise ValueError(mode)\n    return state\n\n\ndef variant_predict(state, f, raw):\n    prediction = s.diffusion_predict(state, f, raw)\n    if 'fallback' not in state:\n        return prediction\n    fallback = dict(state, graph=state['fallback'])\n    alternate = s.diffusion_predict(fallback, f, raw)\n    confidence = state['confidence'][None, None, :]\n    return confidence * prediction + (1 - confidence) * alternate\n\n\nif __name__ == '__main__':\n    started = time.monotonic()\n    modes = sys.argv[1:] or ['control', 'centered_scale', 'median_scale',\n                              'stable_weights', 'stable_fallback', 'reciprocal']\n    with threadpool_limits(limits=1):\n        for split in ['last', 'middle', 'first']:\n            data = pickle.load(open('/tmp/' + split + '.edge_turn_motion', 'rb'))\n            q, raw_o, raw_v = data['q'], data['raw_o'], data['raw_v']\n            output = {}\n            for mode in modes:\n                state = variant_fit(q['ft'], raw_o, mode)\n                no = variant_predict(state, q['ft'], raw_o)\n                nv = variant_predict(state, q['fv'], raw_v)\n                gate = c._gate_fit(q['ft'], q['yt'], q['to'], no, mode='site_history_trend')\n                blend = c._blend(gate, q['fv'], q['tree'], nv)\n                stage = c._residual_tree_fit(q['ft'], q['yt'], q['to'], no, 17,\n                                            'site_history_trend', diffuse='context_smooth')\n                prediction = c._residual_tree_predict(stage, q['fv'], q['tree'], nv, blend)\n                value = r.mae(q['yv'], prediction)\n                output[mode] = {'mae': value, 'prediction': prediction, 'diffusion': state,\n                                'gate': gate, 'stage': stage, 'no': no, 'nv': nv}\n                print(split, mode, 'MAE', value, 'network', r.mae(q['yv'], nv),\n                      'elapsed', round(time.monotonic() - started, 1), flush=True)\n            with open('/tmp/' + split + '.edge_scale_turn', 'wb') as out:\n                pickle.dump(output, out)\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/sh -lc \"nl -ba spatial_calibration.py | sed -n '1,230p'\"","aggregated_output":"     1\t\"\"\"Median residual trees with neighborhoods learned from calibration history.\"\"\"\n     2\timport numpy as np\n     3\tfrom sklearn.ensemble import HistGradientBoostingRegressor\n     4\tfrom threadpoolctl import threadpool_limits\n     5\timport tree_calibration\n     6\t\n     7\t\n     8\tdef _neighborhood(features, count=8):\n     9\t    history = np.asarray(features['history'], dtype=np.float64)\n    10\t    changes = np.diff(history, axis=1).reshape(-1, history.shape[2])\n    11\t    changes -= np.mean(changes, axis=0)\n    12\t    scale = np.maximum(np.std(history.reshape(-1, history.shape[2]), axis=0), 10)\n    13\t    norm = np.sqrt(np.sum(changes * changes, axis=0))\n    14\t    correlation = (changes.T @ changes) / np.maximum(norm[:, None] * norm[None, :], 1)\n    15\t    np.fill_diagonal(correlation, -1)\n    16\t    neighbors = np.argsort(correlation, axis=1)[:, -count:]\n    17\t    weights = np.maximum(np.take_along_axis(correlation, neighbors, axis=1), 0) ** 2\n    18\t    weights /= np.maximum(weights.sum(axis=1, keepdims=True), 1e-8)\n    19\t    return {'neighbors': neighbors, 'weights': weights.astype(np.float32),\n    20\t            'scale': scale.astype(np.float32)}\n    21\t\n    22\t\n    23\tdef _prediction_neighborhood(features, prediction, count=8, mode='pooled'):\n    24\t    \"\"\"Learn edges from forecast innovations, with clock/horizon effects removed.\"\"\"\n    25\t    shape = features['base'].shape\n    26\t    clock = np.asarray(features['clock'], dtype=np.float64)\n    27\t    horizon = np.broadcast_to(np.linspace(-1, 1, shape[1])[None, :, None], shape)\n    28\t    design = np.stack([np.ones(shape), horizon, np.sin(2 * np.pi * clock),\n    29\t                       np.cos(2 * np.pi * clock), np.sin(4 * np.pi * clock),\n    30\t                   
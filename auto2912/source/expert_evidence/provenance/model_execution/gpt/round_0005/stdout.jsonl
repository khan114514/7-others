{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/sh -lc 'cat calibration.py scaled_calibration.py physical_calibration.py bagged_calibration.py'","aggregated_output":"\"\"\"Robust hierarchical residual calibration of fixed traffic forecasts.\"\"\"\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\n\n\ndef _design(features):\n    b = np.asarray(features['base'], dtype=np.float64)\n    a = np.asarray(features['anchor'], dtype=np.float64)\n    hist = np.asarray(features['history'], dtype=np.float64)\n    clock = np.asarray(features['clock'], dtype=np.float64)\n    hh = np.broadcast_to(np.linspace(-1.0, 1.0, b.shape[1])[None, :, None], b.shape)\n    recent = np.broadcast_to(np.median(hist[:, -3:, :], axis=1)[:, None, :], b.shape)\n    older = np.broadcast_to(np.median(hist[:, :6, :], axis=1)[:, None, :], b.shape)\n    allmean = np.broadcast_to(np.mean(hist, axis=1)[:, None, :], b.shape)\n    sine = np.sin(2 * np.pi * clock)\n    cosine = np.cos(2 * np.pi * clock)\n    anchor = np.clip((a - b) / 50, -5, 5)\n    level = b / 300\n    recent_delta = np.clip((recent - b) / 50, -5, 5)\n    trend = np.clip((recent - older) / 50, -5, 5)\n    arr = [np.ones_like(b), hh, hh * hh, sine, cosine,\n           np.sin(4 * np.pi * clock), np.cos(4 * np.pi * clock),\n           level, anchor, anchor * hh, recent_delta, recent_delta * hh,\n           np.clip((allmean - b) / 50, -5, 5), trend, trend * hh,\n           sine * hh, cosine * hh, sine * level, cosine * level]\n    return np.stack(arr, axis=-1)\n\n\ndef _global_fit(x, y, valid, iterations=8):\n    xx = x.reshape(-1, x.shape[-1])\n    yy = y.reshape(-1)\n    ok = valid.reshape(-1)\n    xx = xx[ok]\n    yy = yy[ok]\n    coef = np.zeros(xx.shape[1])\n    penalty = np.eye(xx.shape[1]) * 2.0\n    for _ in range(iterations):\n        residual = yy - xx @ coef\n        w = 1.0 / np.maximum(np.abs(residual), 4.0)\n        coef = np.linalg.solve(xx.T @ (w[:, None] * xx) + penalty,\n                               xx.T @ (w * yy))\n    return coef\n\n\ndef fit(features, targets, seed):\n    with threadpool_limits(limits=2):\n        x = _design(features)\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets,\n                       dtype=np.float64)\n        base = np.asarray(features['base'], dtype=np.float64)\n        valid = np.isfinite(y) & (y > 0)\n        y = np.where(valid, y - base, 0)\n        global_coef = _global_fit(x, y, valid)\n        # Every sensor gets a regularized deviation from the pooled model.\n        xx = x.transpose(2, 0, 1, 3).reshape(x.shape[2], -1, x.shape[-1])\n        yy = y.transpose(2, 0, 1).reshape(x.shape[2], -1)\n        mask = valid.transpose(2, 0, 1).reshape(x.shape[2], -1)\n        prior = np.broadcast_to(global_coef, (x.shape[2], x.shape[-1])).copy()\n        coef = prior.copy()\n        strength = np.array([3, 20, 40, 15, 15, 30, 30,\n                             60, 40, 80, 60, 100, 60, 80, 100,\n                             50, 50, 60, 60], dtype=np.float64)\n        reg = np.diag(strength)\n        for _ in range(8):\n            residual = yy - np.einsum('nrp,np->nr', xx, coef)\n            w = mask / np.maximum(np.abs(residual), 4.0)\n            gram = np.einsum('nrp,nr,nrq->npq', xx, w, xx, optimize=True)\n            rhs = np.einsum('nrp,nr,nr->np', xx, w, yy, optimize=True)\n            coef = np.linalg.solve(gram + reg, (rhs + prior * strength)[..., None])[..., 0]\n        return {'version': 2, 'coef': coef.astype(np.float32)}\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=2):\n        x = _design(features)\n        correction = np.einsum('shnp,np->shn', x, np.asarray(state['coef']))\n        return np.maximum(np.asarray(features['base']) + correction, 0).astype(np.float32)\n\"\"\"Heteroscedastic residual trees with weights preserving the raw MAE objective.\"\"\"\nimport numpy as np\nfrom sklearn.ensemble import HistGradientBoostingRegressor\nfrom threadpoolctl import threadpool_limits\nimport spatial_calibration\n\n\ndef _scale(features, state):\n    base = np.asarray(features['base'], dtype=np.float32)\n    if state['scaling'] == 'poisson':\n        return np.sqrt(np.maximum(base, 20))\n    if state['scaling'] == 'flow':\n        return np.maximum(base, 30)\n    return np.broadcast_to(state['node_scale'], base.shape)\n\n\ndef fit(features, targets, seed, scaling='node', max_iter=90):\n    with threadpool_limits(limits=2):\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets)\n        valid = np.isfinite(y) & (y > 0)\n        residual = y - np.asarray(features['base'])\n        masked = np.where(valid, np.abs(residual), np.nan)\n        node_scale = np.maximum(np.nanmedian(masked, axis=(0, 1)), 2).astype(np.float32)\n        node_scale = np.nan_to_num(node_scale, nan=10)\n        state = {'scaling': scaling, 'node_scale': node_scale,\n                 'graph': spatial_calibration._neighborhood(features)}\n        scale = _scale(features, state)\n        x = spatial_calibration._features(features, state['graph'])\n        x = np.column_stack([x, scale.reshape(-1)])\n        model = HistGradientBoostingRegressor(\n            loss='absolute_error', max_iter=max_iter, learning_rate=0.06,\n            max_leaf_nodes=15, min_samples_leaf=250, l2_regularization=20,\n            categorical_features=[14], early_stopping=False, random_state=seed)\n        weights = scale[valid]\n        weights = weights / np.mean(weights)\n        model.fit(x[valid.ravel()], (residual / scale)[valid], sample_weight=weights)\n        state['model'] = model\n        return state\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=2):\n        scale = _scale(features, state)\n        x = spatial_calibration._features(features, state['graph'])\n        x = np.column_stack([x, scale.reshape(-1)])\n        residual = state['model'].predict(x).reshape(features['base'].shape) * scale\n        return np.maximum(np.asarray(features['base']) + residual, 0).astype(np.float32)\n\"\"\"Learned and public physical-neighbor context for residual calibration.\"\"\"\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport spatial_calibration\nimport horizon_calibration\nimport blended_calibration\n\n\ndef _graph(features, mode='augment'):\n    graph = spatial_calibration._neighborhood(features)\n    adjacency = np.asarray(np.load('/workspace/public_assets/graph.npz')['adjacency'], dtype=np.float32)\n    weights = adjacency / np.maximum(adjacency.sum(axis=1, keepdims=True), 1e-8)\n    if mode == 'augment':\n        graph['physical'] = weights\n    else:\n        neighbors = np.argsort(weights, axis=1)[:, -9:]\n        graph['neighbors'] = neighbors\n        graph['weights'] = np.take_along_axis(weights, neighbors, axis=1)\n    return graph\n\n\ndef fit(features, targets, seed, mode='augment', network=True):\n    with threadpool_limits(limits=2):\n        graph = _graph(features, mode)\n        if network:\n            return {'blend': blended_calibration.fit(features, targets, seed, graph=graph)}\n        return {'tree': horizon_calibration.fit(features, targets, seed, groups=2, graph=graph)}\n\n\ndef predict(state, features):\n    if 'blend' in state:\n        return blended_calibration.predict(state['blend'], features)\n    return horizon_calibration.predict(state['tree'], features)\n\"\"\"Origin bootstrap regularization of the pooled residual-tree component.\"\"\"\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport blended_calibration\nimport horizon_calibration\nimport spatial_calibration\nimport neural_calibration\n\n\ndef fit(features, targets, seed, network=True, copies=3):\n    with threadpool_limits(limits=2):\n        state = (blended_calibration.fit(features, targets, seed) if network else\n                 {'tree': horizon_calibration.fit(features, targets, seed, groups=2)})\n        tree = state['tree']\n        x = spatial_calibration._features(features, tree['pooled']['graph'])\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets)\n        valid = np.isfinite(y) & (y > 0)\n        residual = y - np.asarray(features['base'])\n        rng = np.random.default_rng(seed)\n        models = []\n        for _ in range(copies):\n            counts = rng.poisson(1, size=y.shape[0]).astype(np.float32)\n            weights = np.broadcast_to(counts[:, None, None], y.shape)[valid]\n            weights = weights / np.mean(weights)\n            model = horizon_calibration._model(seed)\n            model.fit(x[valid.ravel()], residual[valid], sample_weight=weights)\n            models.append(model)\n        state['bags'] = models\n        state['bag_weight'] = 0.5\n        return state\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=2):\n        tree = state['tree']\n        shape = features['base'].shape\n        x = spatial_calibration._features(features, tree['pooled']['graph'])\n        pooled = tree['pooled']['model'].predict(x).reshape(shape)\n        bag = np.mean([model.predict(x).reshape(shape) for model in state['bags']], axis=0)\n        pooled = pooled * (1 - state['bag_weight']) + bag * state['bag_weight']\n        x = x.reshape(*shape, -1)\n        expert = np.zeros(shape, dtype=np.float32)\n        for horizons, model in tree['models']:\n            xx = x[:, horizons].reshape(-1, x.shape[-1])\n            expert[:, horizons] = model.predict(xx).reshape(shape[0], len(horizons), shape[2])\n        correction = pooled * (1 - tree['expert_weight']) + expert * tree['expert_weight']\n        forecast = np.maximum(np.asarray(features['base']) + correction, 0)\n        if 'network' in state:\n            forecast = 0.75 * forecast + 0.25 * neural_calibration.predict(state['network'], features)\n        return forecast.astype(np.float32)\n","exit_code":0,"status":"completed"}}

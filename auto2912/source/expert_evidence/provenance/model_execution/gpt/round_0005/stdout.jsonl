{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nfrom pathlib import Path\ns='''import pickle,time,sys\nimport numpy as np\nimport conditional_calibration as c\nimport neural_calibration as n\nimport horizon_calibration as h\nimport research_validation as r\nfrom threadpoolctl import threadpool_limits\nf,y=r.load()\nstart=time.monotonic()\nmodes=sys.argv[1:] or ['trend','graph']\nwith threadpool_limits(limits=2):\n for split in ['last','middle']:\n  with open('/tmp/forecast_turn_graph/'+split+'.baseline','rb') as inp: cache=pickle.load(inp)\n  train,test=cache['train'],cache['test']\n  ft,fv=r.subset(f,train),r.subset(f,test)\n  yt=y[train]\n  base_state=cache['state']\n  tree=h.predict(base_state['tree'],fv)\n  folds=[]\n  tree_oof=np.empty_like(yt)\n  for held in np.array_split(np.arange(len(yt)),3):\n   keep=np.setdiff1d(np.arange(len(yt)),held)\n   ff,fh=r.subset(ft,keep),r.subset(ft,held)\n   tt=h.fit(ff,yt[keep],17,groups=2)\n   tree_oof[held]=h.predict(tt,fh)\n   folds.append((held,keep,tt['pooled']['graph']))\n  for mode in modes:\n   with open('/tmp/forecast_turn_graph/'+split+'.'+mode,'rb') as inp: head_cache=pickle.load(inp)\n   network_oof=np.empty_like(yt)\n   for held,keep,graph in folds:\n    network=n.fit(r.subset(ft,keep),yt[keep],17,graph=graph,site_head=mode)\n    network_oof[held]=n.predict(network,r.subset(ft,held))\n   gate=c._gate_fit(ft,yt,tree_oof,network_oof)\n   pred=n.predict(head_cache['network'],fv)\n   weight=c._weight(gate,fv,tree,pred)\n   blend=tree+weight*(pred-tree)\n   print('matching',mode,split,'MAE',r.mae(y[test],blend),'gate',gate['coef'].tolist(),'elapsed',time.monotonic()-start,flush=True)\n   with open('/tmp/forecast_turn_graph/'+split+'.matching.'+mode,'wb') as out:pickle.dump({'gate':gate,'prediction':blend},out)\n'''\nPath('/tmp/forecast_turn_graph/matching_validation.py').write_text(s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

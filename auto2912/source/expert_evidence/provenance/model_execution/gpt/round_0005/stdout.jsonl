{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/sh -lc 'cat blended_calibration.py; cat /opt/forecast-engine/evaluate.py'","aggregated_output":"\"\"\"Horizon-specific median trees blended with a smooth residual network.\"\"\"\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport horizon_calibration\nimport neural_calibration\n\n\ndef fit(features, targets, seed, graph=None, network_mode='summary', auxiliary_mode=None,\n        site_head=False, average=False):\n    with threadpool_limits(limits=2):\n        state = {'tree': horizon_calibration.fit(features, targets, seed, groups=2, graph=graph),\n                'network': neural_calibration.fit(features, targets, seed, graph=graph, mode=network_mode,\n                                                  site_head=site_head, average=average),\n                # The smooth model is more useful at longer horizons on both\n                # public origin blocks; keep a conservative horizon schedule.\n                'network_weight': np.where(np.arange(features['base'].shape[1]) < 6,\n                                           0.18, 0.32).astype(np.float32)}\n        if auxiliary_mode is not None:\n            state['aux_network'] = neural_calibration.fit(\n                features, targets, seed, graph=state['tree']['pooled']['graph'], mode=auxiliary_mode)\n        return state\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=2):\n        tree = horizon_calibration.predict(state['tree'], features)\n        network = neural_calibration.predict(state['network'], features)\n        if 'aux_network' in state:\n            network = (network + neural_calibration.predict(state['aux_network'], features)) / 2\n        weight = np.asarray(state.get('network_weight', 0.25), dtype=np.float32)\n        return (tree * (1.0 - weight[None, :, None]) +\n                network * weight[None, :, None]).astype(np.float32)\n\"\"\"Public candidate evaluation: the owner lane sends bounded source, never scores.\"\"\"\nimport argparse\nimport json\nfrom pathlib import Path\nimport urllib.request\n\nparser=argparse.ArgumentParser()\nparser.add_argument('--solution',default='/workspace/solution')\nargs=parser.parse_args()\nbase=Path(args.solution)\nif (base/'solve.sh').read_bytes()!=Path('/opt/forecast-engine/solve.sh').read_bytes():\n    raise ValueError('Frozen solve.sh was altered; restore it before public evaluation')\nfiles={}\nfor path in base.rglob('*.py'):\n    relative=path.relative_to(base)\n    if path.is_symlink() or any(part=='..' for part in relative.parts):\n        raise ValueError('Source symlink or traversal refused')\n    value=path.read_text()\n    if len(value.encode())>1024**2:raise ValueError('Executable source file too large')\n    files[str(relative)]=value\nif 'method.py' not in files or len(files)>16 or sum(len(v.encode()) for v in files.values())>1536*1024:\n    raise ValueError('Executable source bundle exceeds public evaluation limit')\nbody=json.dumps({'files':files}).encode()\noperation=urllib.request.Request('http://127.0.0.1:8766/evaluate',data=body,headers={'Content-Type':'application/json'})\nwith urllib.request.urlopen(operation,timeout=1200) as response:\n    status=response.status\n    value=json.load(response)\nprint(json.dumps(value,ensure_ascii=False,indent=2))\nif status!=200 or value.get('status')!='ok':raise SystemExit(1)\n","exit_code":0,"status":"completed"}}

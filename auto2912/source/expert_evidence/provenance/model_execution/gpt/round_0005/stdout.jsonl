{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/sh -lc \"rg --files -g '\"'!__pycache__/*'\"'; cat seasonal_calibration.py hierarchical_calibration.py stacked_calibration.py dynamics_calibration.py\"","aggregated_output":"solve.sh\ncurrent_prompt.txt\ntree_calibration.py\nmethod_notes.json\nbagged_calibration.py\nspatial_calibration.py\nseasonal_calibration.py\nresearch_validation.py\nphysical_calibration.py\nnative-probe.txt\nconditional_calibration.py\nstacked_calibration.py\nscaled_calibration.py\nblended_calibration.py\nmethod.py\nhorizon_calibration.py\nresearch_journal.md\nhierarchical_calibration.py\ndynamics_calibration.py\nneural_calibration.py\ncalibration.py\n\"\"\"Median residual calibration using anchor-aligned historical innovations.\"\"\"\nimport numpy as np\nfrom sklearn.ensemble import HistGradientBoostingRegressor\nfrom threadpoolctl import threadpool_limits\nimport spatial_calibration\n\n\ndef _basis(clock, harmonics=8):\n    arr = [np.ones_like(clock)]\n    for k in range(1, harmonics + 1):\n        arr.extend([np.sin(2 * np.pi * k * clock), np.cos(2 * np.pi * k * clock)])\n    return np.stack(arr, axis=-1)\n\n\ndef _template(features):\n    clock = np.asarray(features['clock'], dtype=np.float64)[:, :, 0].reshape(-1)\n    anchor = np.asarray(features['anchor'], dtype=np.float64).reshape(-1, features['base'].shape[-1])\n    x = _basis(clock)\n    penalty = np.diag(np.r_[0.1, np.repeat(np.arange(1, 9) ** 2, 2) * 2])\n    coef = np.linalg.solve(x.T @ x + penalty, x.T @ anchor)\n    return coef.astype(np.float32)\n\n\ndef _features(features, state):\n    x = spatial_calibration._features(features, state['graph'])\n    base = np.asarray(features['base'], dtype=np.float32)\n    anchor = np.asarray(features['anchor'], dtype=np.float32)\n    history = np.asarray(features['history'], dtype=np.float32)\n    future_clock = np.asarray(features['clock'])[:, :, 0]\n    history_clock = (future_clock[:, :1] - np.arange(12, 0, -1)[None, :] / 288) % 1\n    template_future = _basis(future_clock) @ state['template']\n    template_history = _basis(history_clock) @ state['template']\n    def broadcast(v):\n        return np.broadcast_to(v[:, None, :], base.shape)\n    aligned_history = template_history + np.mean(anchor - template_future, axis=1)[:, None, :]\n    innovation = history - aligned_history\n    last = innovation[:, -1, :]\n    recent = np.mean(innovation[:, -3:, :], axis=1)\n    older = np.mean(innovation[:, :6, :], axis=1)\n    slope = np.mean(innovation[:, -3:, :], axis=1) - np.mean(innovation[:, :3, :], axis=1)\n    extra = [broadcast(last), broadcast(recent), broadcast(older), broadcast(slope),\n             broadcast(np.std(innovation, axis=1)), anchor - template_future,\n             template_future - base]\n    if state['variant'] == 'neighbors':\n        graph = state['graph']\n        def aggregate(v):\n            normalized = v / graph['scale']\n            return np.sum(normalized[..., graph['neighbors']] * graph['weights'], axis=-1) * graph['scale']\n        extra += [broadcast(aggregate(last)), broadcast(aggregate(recent)), broadcast(aggregate(slope))]\n    if state['variant'] == 'extrapolated':\n        slope_anchor = np.mean(np.diff(anchor[:, :4, :], axis=1), axis=1)\n        expected_last = anchor[:, 0, :] - slope_anchor\n        extra += [broadcast(history[:, -1, :] - expected_last),\n                  broadcast(np.mean(history[:, -3:, :], axis=1) - (expected_last - slope_anchor)),\n                  broadcast(slope_anchor)]\n    return np.column_stack([x] + [v.reshape(-1) for v in extra])\n\n\ndef fit(features, targets, seed, variant='local', max_iter=90):\n    with threadpool_limits(limits=2):\n        state = {'template': _template(features),\n                 'graph': spatial_calibration._neighborhood(features), 'variant': variant}\n        x = _features(features, state)\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets)\n        valid = np.isfinite(y) & (y > 0)\n        residual = y - np.asarray(features['base'])\n        model = HistGradientBoostingRegressor(\n            loss='absolute_error', max_iter=max_iter, learning_rate=0.06,\n            max_leaf_nodes=15, min_samples_leaf=250, l2_regularization=20,\n            categorical_features=[14], early_stopping=False, random_state=seed)\n        model.fit(x[valid.ravel()], residual[valid])\n        state['model'] = model\n        return state\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=2):\n        residual = state['model'].predict(_features(features, state)).reshape(features['base'].shape)\n        return np.maximum(np.asarray(features['base']) + residual, 0).astype(np.float32)\n\"\"\"Pooled median tree followed by regularized sensor-specific corrections.\"\"\"\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport spatial_calibration\n\n\ndef _design(features, mode, center):\n    base = np.asarray(features['base'], dtype=np.float64)\n    history = np.asarray(features['history'], dtype=np.float64)\n    anchor = np.asarray(features['anchor'], dtype=np.float64)\n    arr = [np.ones_like(base)]\n    if mode == 'affine':\n        horizon = np.broadcast_to(np.linspace(-1, 1, base.shape[1])[None, :, None], base.shape)\n        recent = np.mean(history[:, -3:, :], axis=1)[:, None, :]\n        arr += [horizon, np.clip((anchor - base) / 50, -5, 5),\n                np.clip((recent - base) / 50, -5, 5),\n                (base - center) / 200]\n    return np.stack(arr, axis=-1)\n\n\ndef _sensor_fit(x, residual, valid):\n    xx = x.transpose(2, 0, 1, 3).reshape(x.shape[2], -1, x.shape[-1])\n    yy = residual.transpose(2, 0, 1).reshape(x.shape[2], -1)\n    mask = valid.transpose(2, 0, 1).reshape(x.shape[2], -1)\n    yy = np.where(mask, yy, 0)\n    coef = np.zeros((x.shape[2], x.shape[-1]))\n    strength = np.array([10, 50, 60, 60, 60], dtype=np.float64)[:x.shape[-1]]\n    for _ in range(12):\n        error = yy - np.einsum('nrp,np->nr', xx, coef)\n        weights = mask / np.maximum(np.abs(error), 3)\n        gram = np.einsum('nrp,nr,nrq->npq', xx, weights, xx, optimize=True)\n        rhs = np.einsum('nrp,nr,nr->np', xx, weights, yy, optimize=True)\n        coef = np.linalg.solve(gram + np.diag(strength), rhs[..., None])[..., 0]\n    return coef.astype(np.float32)\n\n\ndef fit(features, targets, seed, mode='offset', crossfit=False):\n    with threadpool_limits(limits=2):\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets)\n        tree = spatial_calibration.fit(features, y, seed)\n        if crossfit:\n            prediction = np.zeros_like(y)\n            for held in np.array_split(np.arange(y.shape[0]), 3):\n                train = np.setdiff1d(np.arange(y.shape[0]), held)\n                fold = spatial_calibration.fit({k: v[train] for k, v in features.items()}, y[train], seed)\n                prediction[held] = spatial_calibration.predict(fold, {k: v[held] for k, v in features.items()})\n        else:\n            prediction = spatial_calibration.predict(tree, features)\n        valid = np.isfinite(y) & (y > 0)\n        center = np.mean(features['base'], axis=(0, 1), keepdims=True)\n        x = _design(features, mode, center)\n        coef = _sensor_fit(x, y - prediction, valid)\n        return {'tree': tree, 'coef': coef, 'mode': mode, 'center': center}\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=2):\n        baseline = spatial_calibration.predict(state['tree'], features)\n        correction = np.einsum('shnp,np->shn', _design(features, state['mode'], state['center']), state['coef'])\n        return np.maximum(baseline + correction, 0).astype(np.float32)\n\"\"\"Cross-fitted tree forecasts with a smooth residual correction network.\"\"\"\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport horizon_calibration\nimport neural_calibration\n\n\ndef _with_base(features, base):\n    return {**features, 'base': base}\n\n\ndef fit(features, targets, seed):\n    with threadpool_limits(limits=2):\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets)\n        out_of_fold = np.zeros_like(y)\n        index = np.arange(len(y))\n        for held in np.array_split(index, 3):\n            train = np.setdiff1d(index, held)\n            fold = horizon_calibration.fit({k: v[train] for k, v in features.items()}, y[train], seed, groups=2)\n            out_of_fold[held] = horizon_calibration.predict(fold, {k: v[held] for k, v in features.items()})\n        network = neural_calibration.fit(_with_base(features, out_of_fold), y, seed)\n        tree = horizon_calibration.fit(features, y, seed, groups=2)\n        return {'tree': tree, 'network': network, 'correction_weight': 0.25}\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=2):\n        tree = horizon_calibration.predict(state['tree'], features)\n        corrected = neural_calibration.predict(state['network'], _with_base(features, tree))\n        weight = state['correction_weight']\n        return (tree * (1 - weight) + corrected * weight).astype(np.float32)\n\"\"\"Residual trees with explicit history dynamics and sensor-level scaling.\"\"\"\nimport numpy as np\nfrom sklearn.ensemble import HistGradientBoostingRegressor\nfrom threadpoolctl import threadpool_limits\nimport tree_calibration\nimport spatial_calibration\n\n\ndef _profile(features):\n    history = np.asarray(features['history'], dtype=np.float32)\n    flat = history.reshape(-1, history.shape[-1])\n    return {'mean': np.maximum(np.mean(flat, axis=0), 10),\n            'std': np.maximum(np.std(flat, axis=0), 10),\n            'median': np.median(flat, axis=0),\n            'quartiles': np.percentile(flat, [10, 90], axis=0).astype(np.float32)}\n\n\ndef _features(f, state):\n    if state.get('neighbors'):\n        x = spatial_calibration._features(f, state['graph'])\n    else:\n        x = tree_calibration._features(f)\n    base = np.asarray(f['base'], dtype=np.float32)\n    anchor = np.asarray(f['anchor'], dtype=np.float32)\n    history = np.asarray(f['history'], dtype=np.float32)\n    def broadcast(v):\n        return np.broadcast_to(v, base.shape)\n    recent = np.mean(history[:, -3:, :], axis=1)[:, None, :]\n    extra = []\n    if state['variant'] in ('lags', 'both', 'robust'):\n        extra.extend([broadcast(history[:, j:j+1, :]) - base for j in (0, 3, 6, 8, 10)])\n        extra.extend([broadcast(base[:, :1, :]) - base,\n                      broadcast(base[:, -1:, :]) - base,\n                      broadcast(np.mean(base, axis=1, keepdims=True)) - base,\n                      broadcast(anchor[:, :1, :]) - anchor,\n                      broadcast(anchor[:, -1:, :]) - anchor,\n                      broadcast(np.median(history[:, -3:, :], axis=1)[:, None, :]) - base,\n                      broadcast(np.median(history, axis=1)[:, None, :]) - base])\n    if state['variant'] in ('profile', 'both', 'robust'):\n        profile = state['profile']\n        mean, std = profile['mean'], profile['std']\n        extra.extend([broadcast(mean), broadcast(std),\n                      base / mean, anchor / mean,\n                      (base - profile['median']) / std,\n                      (anchor - base) / std,\n                      (recent - base) / std])\n    if state['variant'] == 'robust':\n        spread = np.percentile(history, 75, axis=1) - np.percentile(history, 25, axis=1)\n        extra.extend([broadcast(spread[:, None, :]),\n                      broadcast(np.mean(history == 0, axis=1)[:, None, :]),\n                      (anchor - base) / np.maximum(anchor, 30),\n                      np.sin(2 * np.pi * f['clock']), np.cos(2 * np.pi * f['clock'])])\n    return np.column_stack([x] + [v.reshape(-1) for v in extra])\n\n\ndef fit(features, targets, seed, variant='both', neighbors=False, max_iter=90):\n    with threadpool_limits(limits=2):\n        state = {'variant': variant, 'profile': _profile(features), 'neighbors': neighbors}\n        if neighbors:\n            state['graph'] = spatial_calibration._neighborhood(features)\n        x = _features(features, state)\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets)\n        valid = np.isfinite(y) & (y > 0)\n        residual = y - np.asarray(features['base'])\n        model = HistGradientBoostingRegressor(\n            loss='absolute_error', max_iter=max_iter, learning_rate=0.06,\n            max_leaf_nodes=15, min_samples_leaf=250, l2_regularization=20,\n            categorical_features=[14], early_stopping=False, random_state=seed)\n        model.fit(x[valid.ravel()], residual[valid])\n        state['model'] = model\n        return state\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=2):\n        residual = state['model'].predict(_features(features, state)).reshape(features['base'].shape)\n        return np.maximum(np.asarray(features['base']) + residual, 0).astype(np.float32)\n","exit_code":0,"status":"completed"}}

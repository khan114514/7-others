{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/sh -lc 'cat horizon_calibration.py spatial_calibration.py tree_calibration.py'","aggregated_output":"\"\"\"Partial pooling of median residual trees specialized by forecast horizon.\"\"\"\nimport numpy as np\nfrom sklearn.ensemble import HistGradientBoostingRegressor\nfrom threadpoolctl import threadpool_limits\nimport spatial_calibration\n\n\ndef _model(seed):\n    return HistGradientBoostingRegressor(\n        loss='absolute_error', max_iter=90, learning_rate=0.06,\n        max_leaf_nodes=15, min_samples_leaf=250, l2_regularization=20,\n        categorical_features=[14], early_stopping=False, random_state=seed)\n\n\ndef fit(features, targets, seed, groups=3, graph=None):\n    with threadpool_limits(limits=2):\n        pooled = spatial_calibration.fit(features, targets, seed, graph=graph)\n        x = spatial_calibration._features(features, pooled['graph'])\n        shape = features['base'].shape\n        x = x.reshape(*shape, -1)\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets)\n        valid = np.isfinite(y) & (y > 0)\n        residual = y - np.asarray(features['base'])\n        models = []\n        for horizons in np.array_split(np.arange(shape[1]), groups):\n            xx = x[:, horizons].reshape(-1, x.shape[-1])\n            ok = valid[:, horizons].reshape(-1)\n            yy = residual[:, horizons].reshape(-1)\n            model = _model(seed)\n            model.fit(xx[ok], yy[ok])\n            models.append((horizons, model))\n        return {'pooled': pooled, 'models': models, 'expert_weight': 0.5}\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=2):\n        shape = features['base'].shape\n        x = spatial_calibration._features(features, state['pooled']['graph']).reshape(*shape, -1)\n        expert = np.zeros(shape, dtype=np.float32)\n        for horizons, model in state['models']:\n            expert[:, horizons] = model.predict(x[:, horizons].reshape(-1, x.shape[-1])).reshape(shape[0], len(horizons), shape[2])\n        pooled = state['pooled']['model'].predict(x.reshape(-1, x.shape[-1])).reshape(shape)\n        weight = state['expert_weight']\n        correction = pooled * (1 - weight) + expert * weight\n        return np.maximum(np.asarray(features['base']) + correction, 0).astype(np.float32)\n\"\"\"Median residual trees with neighborhoods learned from calibration history.\"\"\"\nimport numpy as np\nfrom sklearn.ensemble import HistGradientBoostingRegressor\nfrom threadpoolctl import threadpool_limits\nimport tree_calibration\n\n\ndef _neighborhood(features, count=8):\n    history = np.asarray(features['history'], dtype=np.float64)\n    changes = np.diff(history, axis=1).reshape(-1, history.shape[2])\n    changes -= np.mean(changes, axis=0)\n    scale = np.maximum(np.std(history.reshape(-1, history.shape[2]), axis=0), 10)\n    norm = np.sqrt(np.sum(changes * changes, axis=0))\n    correlation = (changes.T @ changes) / np.maximum(norm[:, None] * norm[None, :], 1)\n    np.fill_diagonal(correlation, -1)\n    neighbors = np.argsort(correlation, axis=1)[:, -count:]\n    weights = np.maximum(np.take_along_axis(correlation, neighbors, axis=1), 0) ** 2\n    weights /= np.maximum(weights.sum(axis=1, keepdims=True), 1e-8)\n    return {'neighbors': neighbors, 'weights': weights.astype(np.float32),\n            'scale': scale.astype(np.float32)}\n\n\ndef _features(features, graph, variant='neighbors'):\n    x = tree_calibration._features(features)\n    base = np.asarray(features['base'], dtype=np.float32)\n    anchor = np.asarray(features['anchor'], dtype=np.float32)\n    history = np.asarray(features['history'], dtype=np.float32)\n    scale = graph['scale']\n    def aggregate(value):\n        normalized = value / scale\n        mean = np.sum(normalized[..., graph['neighbors']] * graph['weights'], axis=-1)\n        return mean * scale\n    recent = np.mean(history[:, -3:, :], axis=1)[:, None, :]\n    older = np.mean(history[:, :3, :], axis=1)[:, None, :]\n    last = history[:, -1:, :]\n    spread = np.std(history, axis=1)[:, None, :]\n    extra = [aggregate(anchor - base), aggregate(recent - base),\n             aggregate(last - base), np.broadcast_to(aggregate(recent - older), base.shape),\n             np.broadcast_to(aggregate(spread), base.shape)]\n    if variant == 'relative':\n        extra.extend([(anchor - base) / scale, (recent - base) / scale,\n                      np.broadcast_to(spread / scale, base.shape),\n                      base / np.maximum(anchor, 30),\n                      aggregate(anchor - base) - (anchor - base)])\n    if 'physical' in graph:\n        def physical(value):\n            return ((value / scale) @ graph['physical'].T) * scale\n        extra.extend([physical(anchor - base), physical(recent - base),\n                      physical(last - base),\n                      np.broadcast_to(physical(recent - older), base.shape),\n                      np.broadcast_to(physical(spread), base.shape)])\n    return np.column_stack([x] + [v.reshape(-1) for v in extra])\n\n\ndef fit(features, targets, seed, variant='neighbors', max_iter=90, graph=None):\n    with threadpool_limits(limits=2):\n        if graph is None:\n            graph = _neighborhood(features)\n        x = _features(features, graph, variant)\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets)\n        valid = np.isfinite(y) & (y > 0)\n        residual = y - np.asarray(features['base'])\n        model = HistGradientBoostingRegressor(\n            loss='absolute_error', max_iter=max_iter, learning_rate=0.06,\n            max_leaf_nodes=15, min_samples_leaf=250, l2_regularization=20,\n            categorical_features=[14], early_stopping=False, random_state=seed)\n        model.fit(x[valid.ravel()], residual[valid])\n        return {'graph': graph, 'variant': variant, 'model': model}\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=2):\n        x = _features(features, state['graph'], state['variant'])\n        residual = state['model'].predict(x).reshape(features['base'].shape)\n        return np.maximum(np.asarray(features['base']) + residual, 0).astype(np.float32)\n\"\"\"Pooled nonlinear correction from current, anchor and historical context.\"\"\"\nimport numpy as np\nfrom sklearn.ensemble import HistGradientBoostingRegressor\nfrom threadpoolctl import threadpool_limits\nimport calibration\n\n\ndef _features(f, context=False):\n    b = np.asarray(f['base'], dtype=np.float32)\n    a = np.asarray(f['anchor'], dtype=np.float32)\n    z = np.asarray(f['history'], dtype=np.float32)\n    clock = np.asarray(f['clock'], dtype=np.float32)\n    def broadcast(v):\n        return np.broadcast_to(v[:, None, :], b.shape)\n    last = broadcast(z[:, -1, :])\n    avg3 = broadcast(np.mean(z[:, -3:, :], axis=1))\n    avg6 = broadcast(np.mean(z[:, -6:, :], axis=1))\n    avg = broadcast(np.mean(z, axis=1))\n    std = broadcast(np.std(z, axis=1))\n    delta = broadcast(np.mean(z[:, -3:, :],axis=1)-np.mean(z[:, :3, :],axis=1))\n    spread = broadcast(np.max(z,axis=1)-np.min(z,axis=1))\n    horizon = np.broadcast_to(np.arange(b.shape[1])[None, :, None],b.shape)\n    bd = np.gradient(b, axis=1)\n    ad = np.gradient(a, axis=1)\n    node = np.broadcast_to(np.arange(b.shape[2])[None,None,:],b.shape)\n    features = [b, a-b, last-b, avg3-b, avg6-b, avg-b, std, delta,\n                spread, clock, horizon, bd, ad, a, node]\n    if context:\n        def network(v):\n            return np.broadcast_to(np.mean(v,axis=2,keepdims=True),b.shape)\n        def block(v):\n            return np.broadcast_to(np.mean(v,axis=1,keepdims=True),b.shape)\n        features.extend([network(b),network(a-b),network(avg3-b),\n                         network(delta),network(std),\n                         (a-b)/np.maximum(a,30),std/np.maximum(avg,30),\n                         block(a-b),block(b)-b,\n                         b[:,0,None,:]+np.zeros_like(b)-b,\n                         np.sin(2*np.pi*clock),np.cos(2*np.pi*clock)])\n    return np.stack(features,axis=-1).reshape(-1,len(features))\n\n\ndef fit(features, targets, seed, mode='raw', max_iter=90, context=False):\n    with threadpool_limits(limits=2):\n        y = np.asarray(targets['target'] if isinstance(targets,dict) else targets)\n        valid = np.isfinite(y)&(y>0)\n        x = _features(features,context)\n        residual = y-np.asarray(features['base'])\n        model = HistGradientBoostingRegressor(loss='absolute_error',\n                    max_iter=max_iter,learning_rate=0.06,max_leaf_nodes=15,\n                    min_samples_leaf=250,l2_regularization=20,\n                    categorical_features=[14],early_stopping=False,\n                    random_state=seed)\n        state = {'mode':mode, 'context':context}\n        if mode=='residual':\n            state['linear']=calibration.fit(features,targets,seed)\n            residual=y-calibration.predict(state['linear'],features)\n        model.fit(x[valid.ravel()],residual[valid])\n        state['model']=model\n        return state\n\n\ndef predict(state,features):\n    with threadpool_limits(limits=2):\n        residual=state['model'].predict(_features(features,state.get('context',False))).reshape(features['base'].shape)\n        base=np.asarray(features['base'])\n        if state['mode']=='residual':\n            base=calibration.predict(state['linear'],features)\n        return np.maximum(base+residual,0).astype(np.float32)\n","exit_code":0,"status":"completed"}}

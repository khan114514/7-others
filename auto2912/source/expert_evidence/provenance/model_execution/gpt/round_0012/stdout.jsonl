rue]:\n    current_projection=s.diffusion_fit(ft,raw)\n    if context:\n     current_projection['pooling']='context_normalize'\n     fullprojection['pooling']='context_normalize'\n    else:fullprojection.pop('pooling',None)\n    for matched in [False,True]:\n     no=(fold_oof[context] if matched else s.diffusion_predict(current_projection,ft,raw))\n     nv=s.diffusion_predict(fullprojection if matched else current_projection,fv,fullval)\n     gate=c._gate_fit(ft,yt,q['to'],no,mode='site_neighbor_horizon')\n     blend=c._blend(gate,fv,q['tree'],nv)\n     stage=c._residual_tree_fit(ft,yt,q['to'],no,17,'site_neighbor_horizon',diffuse='context' if context else True)\n     pred=c._residual_tree_predict(stage,fv,q['tree'],nv,blend)\n     outputs[context,matched]={'gate':gate,'stage':stage,'prediction':pred,'mae':r.mae(yv,pred)}\n     print(split,'context',context,'matched projection',matched,'MAE',r.mae(yv,pred),'wall',round(time.monotonic()-start,1),flush=True)\n   with open(ROOT+split+'.matched_projection','wb') as out:pickle.dump(outputs,out)\nPY\nPYTHONPATH=/workspace/solution OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 python /tmp/forecast_turn_adaptive/model_projection_validation.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

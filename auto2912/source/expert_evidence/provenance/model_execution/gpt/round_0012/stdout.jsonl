{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/sh -lc 'cat /tmp/forecast_turn_graph/budget_replica_validation.py; cat /tmp/forecast_turn_resume/residual_tree_validation.py; cat /tmp/forecast_turn_residual/diffusion_implementation_check.py; cat horizon_calibration.py; cat blended_calibration.py; cat tree_calibration.py'","aggregated_output":"import pickle\nimport time\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport conditional_calibration as c\nimport horizon_calibration as h\nimport neural_calibration as n\nimport spatial_calibration as s\nimport research_validation as r\n\nf, y = r.load()\nstart = time.monotonic()\nwith threadpool_limits(limits=1):\n    for split in ['last', 'middle']:\n        prefix = '/tmp/forecast_turn_graph/' + split\n        with open(prefix + '.baseline', 'rb') as inp:\n            cache = pickle.load(inp)\n        train, test = cache['train'], cache['test']\n        ft, fv = r.subset(f, train), r.subset(f, test)\n        with open(prefix + '.tree_oof', 'rb') as inp:\n            tree_cache = pickle.load(inp)\n        with open(prefix + '.network_oof.graph', 'rb') as inp:\n            network_oof = pickle.load(inp)\n        with open(prefix + '.graph', 'rb') as inp:\n            network = pickle.load(inp)['network']\n        tree = h.predict(cache['state']['tree'], fv)\n        extra_oof = np.empty_like(network_oof)\n        for held, keep, graph in tree_cache['folds']:\n            extra = n.fit(r.subset(ft, keep), y[train][keep], 1026,\n                          epochs=80, graph=graph, site_head='graph')\n            extra_oof[held] = n.predict(extra, r.subset(ft, held))\n        extra = n.fit(ft, y[train], 1026, epochs=80, graph=network['graph'], site_head='graph')\n        ensemble = {'members': [network, extra]}\n        combined_oof = (network_oof + extra_oof) / 2\n        combined = n.predict(ensemble, fv)\n        output = {'network': ensemble, 'network_oof': combined_oof, 'extra_oof': extra_oof}\n        for diffuse in [False, True]:\n            oof, prediction = combined_oof, combined\n            diffusion = None\n            if diffuse:\n                diffusion = s.diffusion_fit(ft, oof)\n                oof = s.diffusion_predict(diffusion, ft, oof)\n                prediction = s.diffusion_predict(diffusion, fv, prediction)\n            gate = c._gate_fit(ft, y[train], tree_cache['prediction'], oof,\n                              mode='site_neighbor_horizon')\n            blend = c._blend(gate, fv, tree, prediction)\n            output[diffuse] = {'gate': gate, 'prediction': blend, 'diffusion': diffusion}\n            print(split, '100/80 epochs', 'diffusion', diffuse, 'MAE',\n                  r.mae(y[test], blend), 'elapsed', round(time.monotonic() - start, 2), flush=True)\n        with open(prefix + '.budget_replica', 'wb') as out:\n            pickle.dump(output, out)\nimport pickle\nimport numpy as np\nfrom sklearn.ensemble import HistGradientBoostingRegressor\nfrom threadpoolctl import threadpool_limits\nimport conditional_calibration as c\nimport horizon_calibration as h\nimport neural_calibration as n\nimport spatial_calibration as s\nimport research_validation as r\n\ndef design(f,tree,network,blend):\n raw=s._features(f,s._neighborhood(f))\n base=f['base']\n extra=[tree-base,network-base,network-tree,blend-base]\n return np.column_stack([raw]+[v.reshape(-1) for v in extra])\n\nf,y=r.load()\nwith threadpool_limits(limits=1):\n for split in ['last','middle']:\n  prefix='/tmp/forecast_turn_graph/'+split\n  with open(prefix+'.baseline','rb') as inp:cache=pickle.load(inp)\n  with open(prefix+'.tree_oof','rb') as inp:trees=pickle.load(inp)\n  with open(prefix+'.budget_replica','rb') as inp:ensemble=pickle.load(inp)\n  train,test=cache['train'],cache['test']\n  ft,fv=r.subset(f,train),r.subset(f,test)\n  tree=h.predict(cache['state']['tree'],fv)\n  network=n.predict(ensemble['network'],fv)\n  diffusion=ensemble[True]['diffusion']\n  no=s.diffusion_predict(diffusion,ft,ensemble['network_oof'])\n  nn=s.diffusion_predict(diffusion,fv,network)\n  gate=ensemble[True]['gate']\n  base=c._blend(gate,fv,tree,nn)\n  # Fit this target only after excluding each origin block from the gate.\n  oo=np.empty_like(y[train])\n  for held in np.array_split(np.arange(len(train)),3):\n   keep=np.setdiff1d(np.arange(len(train)),held)\n   cg=c._gate_fit(r.subset(ft,keep),y[train][keep],trees['prediction'][keep],no[keep],mode='site_neighbor_horizon')\n   oo[held]=c._blend(cg,r.subset(ft,held),trees['prediction'][held],no[held])\n  valid=np.isfinite(y[train])&(y[train]>0)\n  xx=design(ft,trees['prediction'],no,oo)\n  xv=design(fv,tree,nn,base)\n  residual=y[train]-oo\n  for name,columns in [('expert_only',[10,14,20,21,22,23]),('context',list(range(xx.shape[1])))]:\n   model=HistGradientBoostingRegressor(loss='absolute_error',max_iter=40,learning_rate=0.05,max_leaf_nodes=7,min_samples_leaf=2000,l2_regularization=50,categorical_features=[columns.index(14)],early_stopping=False,random_state=17)\n   model.fit(xx[valid.ravel()][:,columns],residual[valid])\n   correction=np.clip(model.predict(xv[:,columns]).reshape(base.shape),-10,10)\n   prediction=np.maximum(base+0.5*correction,0)\n   print(split,name,'control',r.mae(y[test],base),'residual tree',r.mae(y[test],prediction),'correction abs',np.mean(np.abs(correction)),flush=True)\nimport pickle\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport conditional_calibration as c\nimport research_validation as r\nwith threadpool_limits(limits=1):\n for split in ['last','middle']:\n  with open('/tmp/forecast_turn_residual/'+split+'.cache','rb') as inp:q=pickle.load(inp)\n  with open('/tmp/forecast_turn_residual/'+split+'.residual_diffusion','rb') as inp:trial=pickle.load(inp)\n  stage=c._residual_tree_fit(q['ft'],q['yt'],q['to'],q['no'],17,'site_neighbor_horizon',diffuse=True)\n  pred=c._residual_tree_predict(stage,q['fv'],q['tree'],q['network'],q['blend'])\n  print(split,'implemented MAE',r.mae(q['yv'],pred),'maximum difference vs prototype',np.max(np.abs(pred-trial[('seasonal',1.0)]['prediction'])),flush=True)\n  with open('/tmp/forecast_turn_residual/'+split+'.diffusion_stage','wb') as out:pickle.dump({'stage':stage,'prediction':pred},out)\n\"\"\"Partial pooling of median residual trees specialized by forecast horizon.\"\"\"\nimport numpy as np\nfrom sklearn.ensemble import HistGradientBoostingRegressor\nfrom threadpoolctl import threadpool_limits\nimport spatial_calibration\n\n\ndef _model(seed):\n    return HistGradientBoostingRegressor(\n        loss='absolute_error', max_iter=90, learning_rate=0.06,\n        max_leaf_nodes=15, min_samples_leaf=250, l2_regularization=20,\n        categorical_features=[14], early_stopping=False, random_state=seed)\n\n\ndef fit(features, targets, seed, groups=3, graph=None):\n    with threadpool_limits(limits=1):\n        pooled = spatial_calibration.fit(features, targets, seed, graph=graph)\n        x = spatial_calibration._features(features, pooled['graph'])\n        shape = features['base'].shape\n        x = x.reshape(*shape, -1)\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets)\n        valid = np.isfinite(y) & (y > 0)\n        residual = y - np.asarray(features['base'])\n        models = []\n        for horizons in np.array_split(np.arange(shape[1]), groups):\n            xx = x[:, horizons].reshape(-1, x.shape[-1])\n            ok = valid[:, horizons].reshape(-1)\n            yy = residual[:, horizons].reshape(-1)\n            model = _model(seed)\n            model.fit(xx[ok], yy[ok])\n            models.append((horizons, model))\n        return {'pooled': pooled, 'models': models, 'expert_weight': 0.5}\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=1):\n        shape = features['base'].shape\n        x = spatial_calibration._features(features, state['pooled']['graph']).reshape(*shape, -1)\n        expert = np.zeros(shape, dtype=np.float32)\n        for horizons, model in state['models']:\n            expert[:, horizons] = model.predict(x[:, horizons].reshape(-1, x.shape[-1])).reshape(shape[0], len(horizons), shape[2])\n        pooled = state['pooled']['model'].predict(x.reshape(-1, x.shape[-1])).reshape(shape)\n        weight = state['expert_weight']\n        correction = pooled * (1 - weight) + expert * weight\n        return np.maximum(np.asarray(features['base']) + correction, 0).astype(np.float32)\n\"\"\"Horizon-specific median trees blended with a smooth residual network.\"\"\"\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport horizon_calibration\nimport neural_calibration\n\n\ndef fit(features, targets, seed, graph=None, network_mode='summary', auxiliary_mode=None,\n        site_head=False, average=False, network_replicas=1, network_epochs=100):\n    with threadpool_limits(limits=1):\n        state = {'tree': horizon_calibration.fit(features, targets, seed, groups=2, graph=graph),\n                'network': neural_calibration.fit(features, targets, seed, graph=graph, mode=network_mode,\n                                                  site_head=site_head, average=average,\n                                                  replicas=network_replicas, epochs=network_epochs),\n                # The smooth model is more useful at longer horizons on both\n                # public origin blocks; keep a conservative horizon schedule.\n                'network_weight': np.where(np.arange(features['base'].shape[1]) < 6,\n                                           0.18, 0.32).astype(np.float32)}\n        if auxiliary_mode is not None:\n            state['aux_network'] = neural_calibration.fit(\n                features, targets, seed, graph=state['tree']['pooled']['graph'], mode=auxiliary_mode)\n        return state\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=1):\n        tree = horizon_calibration.predict(state['tree'], features)\n        network = neural_calibration.predict(state['network'], features)\n        if 'aux_network' in state:\n            network = (network + neural_calibration.predict(state['aux_network'], features)) / 2\n        weight = np.asarray(state.get('network_weight', 0.25), dtype=np.float32)\n        return (tree * (1.0 - weight[None, :, None]) +\n                network * weight[None, :, None]).astype(np.float32)\n\"\"\"Pooled nonlinear correction from current, anchor and historical context.\"\"\"\nimport numpy as np\nfrom sklearn.ensemble import HistGradientBoostingRegressor\nfrom threadpoolctl import threadpool_limits\nimport calibration\n\n\ndef _features(f, context=False):\n    b = np.asarray(f['base'], dtype=np.float32)\n    a = np.asarray(f['anchor'], dtype=np.float32)\n    z = np.asarray(f['history'], dtype=np.float32)\n    clock = np.asarray(f['clock'], dtype=np.float32)\n    def broadcast(v):\n        return np.broadcast_to(v[:, None, :], b.shape)\n    last = broadcast(z[:, -1, :])\n    avg3 = broadcast(np.mean(z[:, -3:, :], axis=1))\n    avg6 = broadcast(np.mean(z[:, -6:, :], axis=1))\n    avg = broadcast(np.mean(z, axis=1))\n    std = broadcast(np.std(z, axis=1))\n    delta = broadcast(np.mean(z[:, -3:, :],axis=1)-np.mean(z[:, :3, :],axis=1))\n    spread = broadcast(np.max(z,axis=1)-np.min(z,axis=1))\n    horizon = np.broadcast_to(np.arange(b.shape[1])[None, :, None],b.shape)\n    bd = np.gradient(b, axis=1)\n    ad = np.gradient(a, axis=1)\n    node = np.broadcast_to(np.arange(b.shape[2])[None,None,:],b.shape)\n    features = [b, a-b, last-b, avg3-b, avg6-b, avg-b, std, delta,\n                spread, clock, horizon, bd, ad, a, node]\n    if context:\n        def network(v):\n            return np.broadcast_to(np.mean(v,axis=2,keepdims=True),b.shape)\n        def block(v):\n            return np.broadcast_to(np.mean(v,axis=1,keepdims=True),b.shape)\n        features.extend([network(b),network(a-b),network(avg3-b),\n                         network(delta),network(std),\n                         (a-b)/np.maximum(a,30),std/np.maximum(avg,30),\n                         block(a-b),block(b)-b,\n                         b[:,0,None,:]+np.zeros_like(b)-b,\n                         np.sin(2*np.pi*clock),np.cos(2*np.pi*clock)])\n    return np.stack(features,axis=-1).reshape(-1,len(features))\n\n\ndef fit(features, targets, seed, mode='raw', max_iter=90, context=False):\n    with threadpool_limits(limits=2):\n        y = np.asarray(targets['target'] if isinstance(targets,dict) else targets)\n        valid = np.isfinite(y)&(y>0)\n        x = _features(features,context)\n        residual = y-np.asarray(features['base'])\n        model = HistGradientBoostingRegressor(loss='absolute_error',\n                    max_iter=max_iter,learning_rate=0.06,max_leaf_nodes=15,\n                    min_samples_leaf=250,l2_regularization=20,\n                    categorical_features=[14],early_stopping=False,\n                    random_state=seed)\n        state = {'mode':mode, 'context':context}\n        if mode=='residual':\n            state['linear']=calibration.fit(features,targets,seed)\n            residual=y-calibration.predict(state['linear'],features)\n        model.fit(x[valid.ravel()],residual[valid])\n        state['model']=model\n        return state\n\n\ndef predict(state,features):\n    with threadpool_limits(limits=2):\n        residual=state['model'].predict(_features(features,state.get('context',False))).reshape(features['base'].shape)\n        base=np.asarray(features['base'])\n        if state['mode']=='residual':\n            base=calibration.predict(state['linear'],features)\n        return np.maximum(base+residual,0).astype(np.float32)\n","exit_code":0,"status":"completed"}}

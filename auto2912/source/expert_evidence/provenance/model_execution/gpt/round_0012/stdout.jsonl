{"type":"item.completed","item":{"id":"item_45","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/forecast_turn_adaptive/factor_validation.py <<'PY'\nimport pickle,time\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport conditional_calibration as c\nimport spatial_calibration as s\nimport neural_calibration as n\nimport research_validation as r\n\nROOT='/tmp/forecast_turn_adaptive/'\ndef components_input(state,f,p):\n shape=f['base'].shape;clock=np.asarray(f['clock'],dtype=np.float64)\n h=np.broadcast_to(np.linspace(-1,1,shape[1])[None,:,None],shape)\n x=np.stack([np.ones(shape),h,np.sin(2*np.pi*clock),np.cos(2*np.pi*clock),np.sin(4*np.pi*clock),np.cos(4*np.pi*clock)],axis=-1)\n seasonal=np.einsum('shni,ni->shn',x,state['coef'])\n z=(p-f['base']-seasonal)/state['graph']['scale']\n return seasonal,z\n\ndef factor_fit(state,f,p):\n _,z=components_input(state,f,p)\n zz=z.reshape(-1,z.shape[-1])\n values,basis=np.linalg.eigh(zz.T@zz/len(zz))\n values=values[::-1];basis=basis[:,::-1]\n rank=min(12,max(2,int(np.searchsorted(np.cumsum(values)/values.sum(),.85)+1)))\n state=dict(state);state['factors']=basis[:,:rank]\n return state\n\ndef factor_predict(state,f,p,context):\n seasonal,z=components_input(state,f,p)\n factor=(z@state['factors'])@state['factors'].T\n innovation=z-factor\n graph=state['graph'];neighbors=graph['neighbors'];scale=graph['scale']\n weights=graph['weights']\n if context:\n  a=(f['anchor']-f['base'])/scale\n  recent=(np.mean(f['history'][:,-3:,:],axis=1)[:,None,:]-f['base'])/scale\n  dist=((a[...,neighbors]-a[...,None])**2+(recent[...,neighbors]-recent[...,None])**2)/2\n  weights=weights*(1/(1+dist));weights=weights/np.maximum(weights.sum(axis=-1,keepdims=True),1e-8)\n value=z+.25*np.sum(weights*(innovation[...,neighbors]-innovation[...,None]),axis=-1)\n return np.maximum(f['base']+seasonal+value*scale,0)\n\nif __name__=='__main__':\n start=time.monotonic()\n with threadpool_limits(limits=1):\n  for split in ['last','middle','first']:\n   if split=='first':\n    with open(ROOT+'first.cache','rb') as inp:q=pickle.load(inp)\n    raw_o,raw_v=q['network_oof'],q['network']\n   else:\n    with open('/tmp/forecast_turn_residual/'+split+'.cache','rb') as inp:q=pickle.load(inp)\n    with open('/tmp/forecast_turn_graph/'+split+'.budget_replica','rb') as inp:ens=pickle.load(inp)\n    raw_o,raw_v=ens['network_oof'],n.predict(ens['network'],q['fv'])\n   diff=factor_fit(s.diffusion_fit(q['ft'],raw_o),q['ft'],raw_o)\n   outputs={}\n   for context in [False,True]:\n    no=factor_predict(diff,q['ft'],raw_o,context)\n    nv=factor_predict(diff,q['fv'],raw_v,context)\n    gate=c._gate_fit(q['ft'],q['yt'],q['to'],no,mode='site_neighbor_horizon')\n    blend=c._blend(gate,q['fv'],q['tree'],nv)\n    stage=c._residual_tree_fit(q['ft'],q['yt'],q['to'],no,17,'site_neighbor_horizon',diffuse='context' if context else True)\n    pred=c._residual_tree_predict(stage,q['fv'],q['tree'],nv,blend)\n    outputs[context]={'diffusion':diff,'gate':gate,'stage':stage,'prediction':pred,'mae':r.mae(q['yv'],pred)}\n    print(split,'factor preservation','context',context,'rank',diff['factors'].shape[1],'MAE',r.mae(q['yv'],pred),'wall',round(time.monotonic()-start,1),flush=True)\n   with open(ROOT+split+'.factors','wb') as out:pickle.dump(outputs,out)\nPY\nPYTHONPATH=/workspace/solution OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 python /tmp/forecast_turn_adaptive/factor_validation.py\"","aggregated_output":"last factor preservation context False rank 12 MAE 13.340112148790885 wall 4.2\nlast factor preservation context True rank 12 MAE 13.337944156811918 wall 7.4\nmiddle factor preservation context False rank 12 MAE 13.082827746682407 wall 10.9\nmiddle factor preservation context True rank 12 MAE 13.08159801559502 wall 14.6\nfirst factor preservation context False rank 12 MAE 13.342807669174478 wall 17.8\nfirst factor preservation context True rank 12 MAE 13.340994506572848 wall 21.4\n","exit_code":0,"statu
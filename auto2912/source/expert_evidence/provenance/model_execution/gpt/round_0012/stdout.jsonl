.,None])**2+(recent[...,neigh]-recent[...,None])**2)/2\n  affinity=1/(1+dist)\n  weights=weights*affinity\n  if mode.endswith('normalize'):\n   weights=weights/np.maximum(weights.sum(axis=-1,keepdims=True),1e-8)\n  value=zi+.25*np.sum(weights*(zj-zi[...,None]),axis=-1)\n return np.maximum(f['base']+seasonal+value*scale,0)\n\nif __name__=='__main__':\n start=time.monotonic()\n with threadpool_limits(limits=1):\n  for split in ['last','middle']:\n   with open('/tmp/forecast_turn_residual/'+split+'.cache','rb') as inp:q=pickle.load(inp)\n   with open('/tmp/forecast_turn_graph/'+split+'.budget_replica','rb') as inp:ens=pickle.load(inp)\n   with open('/tmp/forecast_turn_residual/'+split+'.diffusion_stage','rb') as inp:stage=pickle.load(inp)\n   st=stage['stage'];model=st['model']\n   xv=c._residual_tree_design(q['fv'],q['tree'],q['network'],q['blend'])\n   correction=np.clip(model.predict(xv).reshape(q['yv'].shape),-10,10)\n   print(split,'old best',r.mae(q['yv'],q['control']),'pending diffusion best',r.mae(q['yv'],stage['prediction']),flush=True)\n   outputs={}\n   for mode in ['median','context_attenuate','context_normalize','history_attenuate','history_normalize','innovation_attenuate','innovation_normalize']:\n    residual=diffuse(st['diffusion'],q['fv'],q['fv']['base']+correction,mode)-q['fv']['base']\n    pred=np.maximum(q['blend']+residual,0)\n    outputs['residual',mode]={'prediction':pred,'mae':r.mae(q['yv'],pred)}\n    print(split,'residual',mode,r.mae(q['yv'],pred),flush=True)\n   raw_v=n.predict(ens['network'],q['fv'])\n   for mode in ['median','context_attenuate','context_normalize','history_attenuate','innovation_attenuate']:\n    no=diffuse(ens[True]['diffusion'],q['ft'],ens['network_oof'],mode)\n    nv=diffuse(ens[True]['diffusion'],q['fv'],raw_v,mode)\n    gate=c._gate_fit(q['ft'],q['yt'],q['to'],no,mode='site_neighbor_horizon')\n    blend=c._blend(gate,q['fv'],q['tree'],nv)\n    stage_new=c._residual_tree_fit(q['ft'],q['yt'],q['to'],no,17,'site_neighbor
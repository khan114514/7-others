or_horizon',diffuse=True)\n    pred=c._residual_tree_predict(stage_new,q['fv'],q['tree'],nv,blend)\n    outputs['network',mode]={'gate':gate,'stage':stage_new,'prediction':pred,'mae':r.mae(q['yv'],pred)}\n    print(split,'network',mode,r.mae(q['yv'],pred),'elapsed',round(time.monotonic()-start,1),flush=True)\n   with open(ROOT+split+'.adaptive','wb') as out:pickle.dump(outputs,out)\nPY\nPYTHONPATH=/workspace/solution OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 python /tmp/forecast_turn_adaptive/adaptive_validation.py\"","aggregated_output":"last old best 13.328192448814109 pending diffusion best 13.322585563668598\nlast residual median 13.324747892924108\nlast residual context_attenuate 13.32237243348819\nlast residual context_normalize 13.322887137686807\nlast residual history_attenuate 13.322763733651195\nlast residual history_normalize 13.322614969063357\nlast residual innovation_attenuate 13.32258557106009\nlast residual innovation_normalize 13.322585858231708\nlast network median 13.316415855569577 elapsed 3.6\nlast network context_attenuate 13.322941106900434 elapsed 6.5\nlast network context_normalize 13.322209461362256 elapsed 10.1\nlast network history_attenuate 13.316688639665612 elapsed 14.1\nlast network innovation_attenuate 13.321843437062505 elapsed 17.9\nmiddle old best 13.090810839485748 pending diffusion best 13.077336088687868\nmiddle residual median 13.076295814130136\nmiddle residual context_attenuate 13.076923677351799\nmiddle residual context_normalize 13.0769273031957\nmiddle residual history_attenuate 13.077758477848255\nmiddle residual history_normalize 13.077262792692668\nmiddle residual innovation_attenuate 13.077336667593686\nmiddle residual innovation_normalize 13.077336305435301\nmiddle network median 13.080498370334254 elapsed 25.0\nmiddle network context_attenuate 13.07572186215325 elapsed 29.3\nmiddle network context_normalize 13.074306544017457 elapsed 33.7\nmiddle network history_attenuate 13.077624412831907 elapsed 
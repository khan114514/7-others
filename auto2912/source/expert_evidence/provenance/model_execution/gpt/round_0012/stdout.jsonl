{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/forecast_turn_adaptive/support_validation.py <<'PY'\nimport pickle,time\nimport numpy as np\nfrom scipy.optimize import minimize\nfrom threadpoolctl import threadpool_limits\nimport conditional_calibration as c\nimport spatial_calibration as s\nimport neural_calibration as n\nimport research_validation as r\n\nROOT='/tmp/forecast_turn_adaptive/'\ndef design(f,graph,raw,dyn):\n scale=graph['scale'];neigh=graph['neighbors'];base=f['base'];shape=base.shape\n a=(f['anchor']-base)/scale\n b=(np.mean(f['history'][:,-3:,:],axis=1)[:,None,:]-base)/scale\n dist=((a[...,neigh]-a[...,None])**2+(b[...,neigh]-b[...,None])**2)/2\n support=np.sum(graph['weights']/(1+dist),axis=-1)\n h=np.broadcast_to(np.linspace(-1,1,shape[1])[None,:,None],shape)\n return np.stack([np.ones(shape),h,support,np.clip(np.abs(dyn-raw)/10,0,3)],axis=-1).reshape(-1,4)\n\ndef fit_strength(f,y,tree,raw,dyn,graph,site):\n x=design(f,graph,raw,dyn)\n valid=(np.isfinite(y)&(y>0)).ravel()\n node=np.broadcast_to(np.arange(y.shape[2])[None,None,:],y.shape).ravel()[valid]\n x=x[valid]\n center=x.mean(axis=0);center[0]=0\n scale=np.maximum(x.std(axis=0),.1);scale[0]=1\n x=np.clip((x-center)/scale,-4,4)\n index=np.arange(len(y));blend=np.empty_like(y);wg=np.empty_like(y)\n for held in np.array_split(index,3):\n  keep=np.setdiff1d(index,held)\n  cg=c._gate_fit(r.subset(f,keep),y[keep],tree[keep],dyn[keep],mode='site_neighbor_horizon')\n  wg[held]=c._weight(cg,r.subset(f,held),tree[held],dyn[held])\n  blend[held]=tree[held]+wg[held]*(dyn[held]-tree[held])\n residual=(blend-y).ravel()[valid]\n direction=(wg*(dyn-raw)/.25).ravel()[valid]\n nodes=y.shape[2]\n adj=np.zeros((nodes,nodes));np.put_along_axis(adj,graph['neighbors'],graph['weights'],axis=1)\n adj=(adj+adj.T)/2;lap=np.diag(adj.sum(axis=1))-adj\n def objective(coef):\n  logit=x@coef[:4]\n  if site:\n   sc=coef[4:]\n   logit+=sc[node]\n  activation=np.tanh(logit)\n  error=residual+.2*activation*direction\n  smooth=np.sqrt(error**2+4)\n  derivative=error/smooth*.2*(1-activation**2)*direction\n  loss=np.mean(smooth)/20+.01*np.dot(coef[:4],coef[:4])/2\n  grad=x.T@derivative/(len(x)*20)+.01*coef[:4]\n  if site:\n   reg=.02*sc+.05*lap@sc\n   loss+=sc@reg/(2*nodes)\n   grad=np.r_[grad,np.bincount(node,weights=derivative,minlength=nodes)/(len(x)*20)+reg/nodes]\n  return loss,grad\n result=minimize(objective,np.zeros(4+(nodes if site else 0)),jac=True,method='L-BFGS-B',options={'maxiter':100,'ftol':1e-10})\n return {'coef':result.x[:4],'site':result.x[4:] if site else None,'center':center,'scale':scale}\n\ndef apply(f,raw,dyn,graph,st):\n x=np.clip((design(f,graph,raw,dyn)-st['center'])/st['scale'],-4,4)\n z=(x@st['coef']).reshape(raw.shape)\n if st['site'] is not None:z+=st['site'][None,None,:]\n return np.maximum(dyn+.2*np.tanh(z)*(dyn-raw)/.25,0)\n\nif __name__=='__main__':\n start=time.monotonic()\n with threadpool_limits(limits=1):\n  for split in ['last','middle','first']:\n   if split=='first':\n    with open(ROOT+'first.cache','rb') as inp:q=pickle.load(inp)\n    raw_o,raw_v=q['network_oof'],q['network']\n   else:\n    with open('/tmp/forecast_turn_residual/'+split+'.cache','rb') as inp:q=pickle.load(inp)\n    with open('/tmp/forecast_turn_graph/'+split+'.budget_replica','rb') as inp:ens=pickle.load(inp)\n    raw_o,raw_v=ens['network_oof'],n.predict(ens['network'],q['fv'])\n   diff=s.diffusion_fit(q['ft'],raw_o);diff['pooling']='context_normalize'\n   no=s.diffusion_predict(diff,q['ft'],raw_o);nv=s.diffusion_predict(diff,q['fv'],raw_v)\n   output={}\n   for site in [False,True]:\n    strength=fit_strength(q['ft'],q['yt'],q['to'],raw_o,no,diff['graph'],site)\n    nto=apply(q['ft'],raw_o,no,diff['graph'],strength)\n    ntv=apply(q['fv'],raw_v,nv,diff['graph'],strength)\n    gate=c._gate_fit(q['ft'],q['yt'],q['to'],nto,mode='site_neighbor_horizon')\n    blend=c._blend(gate,q['fv'],q['tree'],ntv)\n    stage=c._residual_tree_fit(q['ft'],q['yt'],q['to'],nto,17,'site_neighbor_horizon',diffuse='context')\n    pred=c._residual_tree_predict(stage,q['fv'],q['tree'],ntv,blend)\n    output[site]={'strength':strength,'gate':gate,'stage':stage,'prediction':pred,'mae':r.mae(q['yv'],pred)}\n    print(split,'learned support','site',site,'MAE',r.mae(q['yv'],pred),'coefs',strength['coef'].tolist(),'wall',round(time.monotonic()-start,1),flush=True)\n   with open(ROOT+split+'.support','wb') as out:pickle.dump(output,out)\nPY\nPYTHONPATH=/workspace/solution OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 python /tmp/forecast_turn_adaptive/support_validation.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

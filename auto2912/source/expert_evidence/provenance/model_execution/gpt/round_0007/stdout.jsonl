{"type":"item.completed","item":{"id":"item_55","type":"command_execution","command":"/bin/sh -lc \"sed -n '1,280p' spatial_calibration.py && sed -n '1,260p' blended_calibration.py && sed -n '1,220p' research_validation.py\"","aggregated_output":"\"\"\"Median residual trees with neighborhoods learned from calibration history.\"\"\"\nimport numpy as np\nfrom sklearn.ensemble import HistGradientBoostingRegressor\nfrom threadpoolctl import threadpool_limits\nimport tree_calibration\n\n\ndef _neighborhood(features, count=8):\n    history = np.asarray(features['history'], dtype=np.float64)\n    changes = np.diff(history, axis=1).reshape(-1, history.shape[2])\n    changes -= np.mean(changes, axis=0)\n    scale = np.maximum(np.std(history.reshape(-1, history.shape[2]), axis=0), 10)\n    norm = np.sqrt(np.sum(changes * changes, axis=0))\n    correlation = (changes.T @ changes) / np.maximum(norm[:, None] * norm[None, :], 1)\n    np.fill_diagonal(correlation, -1)\n    neighbors = np.argsort(correlation, axis=1)[:, -count:]\n    weights = np.maximum(np.take_along_axis(correlation, neighbors, axis=1), 0) ** 2\n    weights /= np.maximum(weights.sum(axis=1, keepdims=True), 1e-8)\n    return {'neighbors': neighbors, 'weights': weights.astype(np.float32),\n            'scale': scale.astype(np.float32)}\n\n\ndef _features(features, graph, variant='neighbors'):\n    x = tree_calibration._features(features)\n    base = np.asarray(features['base'], dtype=np.float32)\n    anchor = np.asarray(features['anchor'], dtype=np.float32)\n    history = np.asarray(features['history'], dtype=np.float32)\n    scale = graph['scale']\n    def aggregate(value):\n        normalized = value / scale\n        mean = np.sum(normalized[..., graph['neighbors']] * graph['weights'], axis=-1)\n        return mean * scale\n    recent = np.mean(history[:, -3:, :], axis=1)[:, None, :]\n    older = np.mean(history[:, :3, :], axis=1)[:, None, :]\n    last = history[:, -1:, :]\n    spread = np.std(history, axis=1)[:, None, :]\n    extra = [aggregate(anchor - base), aggregate(recent - base),\n             aggregate(last - base), np.broadcast_to(aggregate(recent - older), base.shape),\n             np.broadcast_to(aggregate(spread), base.shape)]\n    if variant == 'relative':\n        extra.extend([(anchor - base) / scale, (recent - base) / scale,\n                      np.broadcast_to(spread / scale, base.shape),\n                      base / np.maximum(anchor, 30),\n                      aggregate(anchor - base) - (anchor - base)])\n    if 'physical' in graph:\n        def physical(value):\n            return ((value / scale) @ graph['physical'].T) * scale\n        extra.extend([physical(anchor - base), physical(recent - base),\n                      physical(last - base),\n                      np.broadcast_to(physical(recent - older), base.shape),\n                      np.broadcast_to(physical(spread), base.shape)])\n    return np.column_stack([x] + [v.reshape(-1) for v in extra])\n\n\ndef fit(features, targets, seed, variant='neighbors', max_iter=90, graph=None):\n    with threadpool_limits(limits=2):\n        if graph is None:\n            graph = _neighborhood(features)\n        x = _features(features, graph, variant)\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets)\n        valid = np.isfinite(y) & (y > 0)\n        residual = y - np.asarray(features['base'])\n        model = HistGradientBoostingRegressor(\n            loss='absolute_error', max_iter=max_iter, learning_rate=0.06,\n            max_leaf_nodes=15, min_samples_leaf=250, l2_regularization=20,\n            categorical_features=[14], early_stopping=False, random_state=seed)\n        model.fit(x[valid.ravel()], residual[valid])\n        return {'graph': graph, 'variant': variant, 'model': model}\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=2):\n        x = _features(features, state['graph'], state['variant'])\n        residual = state['model'].predict(x).reshape(features['base'].shape)\n        return np.maximum(np.asarray(features['base']) + residual, 0).astype(np.float32)\n\"\"\"Horizon-specific median trees blended with a smooth residual network.\"\"\"\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport horizon_calibration\nimport neural_calibration\n\n\ndef fit(features, targets, seed, graph=None, network_mode='summary', auxiliary_mode=None,\n        site_head=False, average=False):\n    with threadpool_limits(limits=2):\n        state = {'tree': horizon_calibration.fit(features, targets, seed, groups=2, graph=graph),\n                'network': neural_calibration.fit(features, targets, seed, graph=graph, mode=network_mode,\n                                                  site_head=site_head, average=average),\n                # The smooth model is more useful at longer horizons on both\n                # public origin blocks; keep a conservative horizon schedule.\n                'network_weight': np.where(np.arange(features['base'].shape[1]) < 6,\n                                           0.18, 0.32).astype(np.float32)}\n        if auxiliary_mode is not None:\n            state['aux_network'] = neural_calibration.fit(\n                features, targets, seed, graph=state['tree']['pooled']['graph'], mode=auxiliary_mode)\n        return state\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=2):\n        tree = horizon_calibration.predict(state['tree'], features)\n        network = neural_calibration.predict(state['network'], features)\n        if 'aux_network' in state:\n            network = (network + neural_calibration.predict(state['aux_network'], features)) / 2\n        weight = np.asarray(state.get('network_weight', 0.25), dtype=np.float32)\n        return (tree * (1.0 - weight[None, :, None]) +\n                network * weight[None, :, None]).astype(np.float32)\n\"\"\"Public calibration origin-block comparisons; never reads development targets.\"\"\"\nimport time\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport tree_calibration\nimport spatial_calibration\n\n\ndef load():\n    features = dict(np.load('/workspace/public_assets/train_features.npz'))\n    targets = np.load('/workspace/public_assets/train_targets.npz')['target']\n    return features, targets\n\n\ndef subset(features, index):\n    return {key: value[index] for key, value in features.items()}\n\n\ndef mae(target, prediction):\n    valid = np.isfinite(target) & (target > 0)\n    return float(np.mean(np.abs(target[valid] - prediction[valid])))\n\n\ndef evaluate(fit, predict, name, splits=None):\n    features, targets = load()\n    if splits is None:\n        splits = [(np.arange(50), np.arange(50, 74)),\n                  (np.r_[0:25, 49:74], np.arange(25, 49))]\n    start = time.monotonic()\n    output = []\n    for train, test in splits:\n        state = fit(subset(features, train), targets[train], 17)\n        pred = predict(state, subset(features, test))\n        value = mae(targets[test], pred)\n        output.append(value)\n        print(name, 'test', test[0], test[-1], 'MAE', value,\n              'elapsed', round(time.monotonic() - start, 2), flush=True)\n    return output\n\n\nif __name__ == '__main__':\n    with threadpool_limits(limits=2):\n        evaluate(tree_calibration.fit, tree_calibration.predict, 'retained')\n        for variant in ['neighbors', 'relative']:\n            evaluate(lambda f, y, s: spatial_calibration.fit(f, y, s, variant=variant),\n                     spatial_calibration.predict, variant)\n","exit_code":0,"status":"completed"}}

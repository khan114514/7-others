{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/sh -lc \"cat solve.sh; printf '\\\\n--- source summaries ---\\\\n'; for f in *.py; do echo ===\"'$f; sed -n '\"'1,100p' \\\"\"'$f\"; done'","aggregated_output":"#!/bin/sh\nset -eu\npython /opt/forecast-engine/evaluate.py --solution /workspace/solution\n\n--- source summaries ---\n===bagged_calibration.py\n\"\"\"Origin bootstrap regularization of the pooled residual-tree component.\"\"\"\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport blended_calibration\nimport horizon_calibration\nimport spatial_calibration\nimport neural_calibration\n\n\ndef fit(features, targets, seed, network=True, copies=3):\n    with threadpool_limits(limits=2):\n        state = (blended_calibration.fit(features, targets, seed) if network else\n                 {'tree': horizon_calibration.fit(features, targets, seed, groups=2)})\n        tree = state['tree']\n        x = spatial_calibration._features(features, tree['pooled']['graph'])\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets)\n        valid = np.isfinite(y) & (y > 0)\n        residual = y - np.asarray(features['base'])\n        rng = np.random.default_rng(seed)\n        models = []\n        for _ in range(copies):\n            counts = rng.poisson(1, size=y.shape[0]).astype(np.float32)\n            weights = np.broadcast_to(counts[:, None, None], y.shape)[valid]\n            weights = weights / np.mean(weights)\n            model = horizon_calibration._model(seed)\n            model.fit(x[valid.ravel()], residual[valid], sample_weight=weights)\n            models.append(model)\n        state['bags'] = models\n        state['bag_weight'] = 0.5\n        return state\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=2):\n        tree = state['tree']\n        shape = features['base'].shape\n        x = spatial_calibration._features(features, tree['pooled']['graph'])\n        pooled = tree['pooled']['model'].predict(x).reshape(shape)\n        bag = np.mean([model.predict(x).reshape(shape) for model in state['bags']], axis=0)\n        pooled = pooled * (1 - state['bag_weight']) + bag * state['bag_weight']\n        x = x.reshape(*shape, -1)\n        expert = np.zeros(shape, dtype=np.float32)\n        for horizons, model in tree['models']:\n            xx = x[:, horizons].reshape(-1, x.shape[-1])\n            expert[:, horizons] = model.predict(xx).reshape(shape[0], len(horizons), shape[2])\n        correction = pooled * (1 - tree['expert_weight']) + expert * tree['expert_weight']\n        forecast = np.maximum(np.asarray(features['base']) + correction, 0)\n        if 'network' in state:\n            forecast = 0.75 * forecast + 0.25 * neural_calibration.predict(state['network'], features)\n        return forecast.astype(np.float32)\n===blended_calibration.py\n\"\"\"Horizon-specific median trees blended with a smooth residual network.\"\"\"\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport horizon_calibration\nimport neural_calibration\n\n\ndef fit(features, targets, seed, graph=None, network_mode='summary', auxiliary_mode=None,\n        site_head=False, average=False, network_replicas=1, network_epochs=100):\n    with threadpool_limits(limits=1):\n        state = {'tree': horizon_calibration.fit(features, targets, seed, groups=2, graph=graph),\n                'network': neural_calibration.fit(features, targets, seed, graph=graph, mode=network_mode,\n                                                  site_head=site_head, average=average,\n                                                  replicas=network_replicas, epochs=network_epochs),\n                # The smooth model is more useful at longer horizons on both\n                # public origin blocks; keep a conservative horizon schedule.\n                'network_weight': np.where(np.arange(features['base'].shape[1]) < 6,\n                                           0.18, 0.32).astype(np.float32)}\n        if auxiliary_mode is not None:\n            state['aux_network'] = neural_calibration.fit(\n                features, targets, seed, graph=state['tree']['pooled']['graph'], mode=auxiliary_mode)\n        return state\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=1):\n        tree = horizon_calibration.predict(state['tree'], features)\n        network = neural_calibration.predict(state['network'], features)\n        if 'aux_network' in state:\n            network = (network + neural_calibration.predict(state['aux_network'], features)) / 2\n        weight = np.asarray(state.get('network_weight', 0.25), dtype=np.float32)\n        return (tree * (1.0 - weight[None, :, None]) +\n                network * weight[None, :, None]).astype(np.float32)\n===calibration.py\n\"\"\"Robust hierarchical residual calibration of fixed traffic forecasts.\"\"\"\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\n\n\ndef _design(features):\n    b = np.asarray(features['base'], dtype=np.float64)\n    a = np.asarray(features['anchor'], dtype=np.float64)\n    hist = np.asarray(features['history'], dtype=np.float64)\n    clock = np.asarray(features['clock'], dtype=np.float64)\n    hh = np.broadcast_to(np.linspace(-1.0, 1.0, b.shape[1])[None, :, None], b.shape)\n    recent = np.broadcast_to(np.median(hist[:, -3:, :], axis=1)[:, None, :], b.shape)\n    older = np.broadcast_to(np.median(hist[:, :6, :], axis=1)[:, None, :], b.shape)\n    allmean = np.broadcast_to(np.mean(hist, axis=1)[:, None, :], b.shape)\n    sine = np.sin(2 * np.pi * clock)\n    cosine = np.cos(2 * np.pi * clock)\n    anchor = np.clip((a - b) / 50, -5, 5)\n    level = b / 300\n    recent_delta = np.clip((recent - b) / 50, -5, 5)\n    trend = np.clip((recent - older) / 50, -5, 5)\n    arr = [np.ones_like(b), hh, hh * hh, sine, cosine,\n           np.sin(4 * np.pi * clock), np.cos(4 * np.pi * clock),\n           level, anchor, anchor * hh, recent_delta, recent_delta * hh,\n           np.clip((allmean - b) / 50, -5, 5), trend, trend * hh,\n           sine * hh, cosine * hh, sine * level, cosine * level]\n    return np.stack(arr, axis=-1)\n\n\ndef _global_fit(x, y, valid, iterations=8):\n    xx = x.reshape(-1, x.shape[-1])\n    yy = y.reshape(-1)\n    ok = valid.reshape(-1)\n    xx = xx[ok]\n    yy = yy[ok]\n    coef = np.zeros(xx.shape[1])\n    penalty = np.eye(xx.shape[1]) * 2.0\n    for _ in range(iterations):\n        residual = yy - xx @ coef\n        w = 1.0 / np.maximum(np.abs(residual), 4.0)\n        coef = np.linalg.solve(xx.T @ (w[:, None] * xx) + penalty,\n                               xx.T @ (w * yy))\n    return coef\n\n\ndef fit(features, targets, seed):\n    with threadpool_limits(limits=2):\n        x = _design(features)\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets,\n                       dtype=np.float64)\n        base = np.asarray(features['base'], dtype=np.float64)\n        valid = np.isfinite(y) & (y > 0)\n        y = np.where(valid, y - base, 0)\n        global_coef = _global_fit(x, y, valid)\n        # Every sensor gets a regularized deviation from the pooled model.\n        xx = x.transpose(2, 0, 1, 3).reshape(x.shape[2], -1, x.shape[-1])\n        yy = y.transpose(2, 0, 1).reshape(x.shape[2], -1)\n        mask = valid.transpose(2, 0, 1).reshape(x.shape[2], -1)\n        prior = np.broadcast_to(global_coef, (x.shape[2], x.shape[-1])).copy()\n        coef = prior.copy()\n        strength = np.array([3, 20, 40, 15, 15, 30, 30,\n                             60, 40, 80, 60, 100, 60, 80, 100,\n                             50, 50, 60, 60], dtype=np.float64)\n        reg = np.diag(strength)\n        for _ in range(8):\n            residual = yy - np.einsum('nrp,np->nr', xx, coef)\n            w = mask / np.maximum(np.abs(residual), 4.0)\n            gram = np.einsum('nrp,nr,nrq->npq', xx, w, xx, optimize=True)\n            rhs = np.einsum('nrp,nr,nr->np', xx, w, yy, optimize=True)\n            coef = np.linalg.solve(gram + reg, (rhs + prior * strength)[..., None])[..., 0]\n        return {'version': 2, 'coef': coef.astype(np.float32)}\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=2):\n        x = _design(features)\n        correction = np.einsum('shnp,np->shn', x, np.asarray(state['coef']))\n        return np.maximum(np.asarray(features['base']) + correction, 0).astype(np.float32)\n===conditional_calibration.py\n\"\"\"Cross-fitted, regularized conditional blending of residual experts.\"\"\"\nimport numpy as np\nfrom scipy.optimize import minimize\nfrom scipy.special import expit\nfrom threadpoolctl import threadpool_limits\nfrom sklearn.ensemble import HistGradientBoostingRegressor\nimport blended_calibration\nimport horizon_calibration\nimport neural_calibration\nimport spatial_calibration\n\n\ndef _design(features, tree, network, mode='standard', context_graph=None, replica_gap=None):\n    use_replica_gap = mode in ('site_replica_gap', 'site_replica_shared')\n    if use_replica_gap:\n        mode = 'site_neighbor_horizon'\n    base = np.asarray(features['base'], dtype=np.float64)\n    anchor = np.asarray(features['anchor'], dtype=np.float64)\n    history = np.asarray(features['history'], dtype=np.float64)\n    scale = np.maximum(np.mean(history, axis=1)[:, None, :], 30)\n    recent = np.mean(history[:, -3:, :], axis=1)[:, None, :]\n    std = np.std(history, axis=1)[:, None, :]\n    horizon = np.broadcast_to(np.arange(base.shape[1])[None, :, None] / 11, base.shape)\n    def broadcast(v):\n        return np.broadcast_to(v, base.shape)\n    variables = [np.ones_like(base), horizon,\n                 np.clip(np.abs(anchor - base) / scale, 0, 2),\n                 np.clip(np.abs(recent - base) / scale, 0, 2),\n                 broadcast(np.clip(std / scale, 0, 2)),\n                 np.clip(np.abs(network - tree) / 20, 0, 3),\n                 np.clip(base / 200, 0, 3)]\n    if mode == 'agreement':\n        last = history[:, -1:, :]\n        for reference in (anchor, recent, last):\n            variables.append(np.clip((np.abs(tree - reference) -\n                                      np.abs(network - reference)) / 20, -3, 3))\n    if mode in ('interactions', 'site', 'site_horizon', 'site_context', 'site_direction',\n                'site_direction_horizon', 'site_reliability', 'site_expert_direction', 'site_expert_shared',\n                'site_expert_horizon', 'site_expert_horizon_shared',\n                'site_neighbor_expert', 'site_neighbor_horizon',\n                'site_context_signed', 'periodic'):\n        variables.extend([(horizon - 0.5) * variables[j] for j in (2, 3, 4, 5)])\n    if mode in ('site_direction', 'site_direction_horizon', 'site_reliability',\n                'site_expert_direction', 'site_expert_shared', 'site_expert_horizon',\n                'site_expert_horizon_shared', 'site_neighbor_expert', 'site_neighbor_horizon',\n                'site_context_signed'):\n        variables.extend([np.clip((anchor - base) / scale, -2, 2),\n                          np.clip((recent - base) / scale, -2, 2)])\n    if mode == 'site_direction_horizon':\n        variables.extend([(horizon - 0.5) * variables[j] for j in (11, 12)])\n    if mode in ('site_expert_direction', 'site_expert_shared', 'site_expert_horizon',\n                'site_expert_horizon_shared', 'site_neighbor_expert', 'site_neighbor_horizon'):\n        variables.append(np.clip((network - tree) / 20, -3, 3))\n    if mode in ('site_expert_horizon', 'site_expert_horizon_shared', 'site_neighbor_horizon'):\n        variables.append((horizon - 0.5) * variables[13])\n    if mode in ('site_neighbor_expert', 'site_neighbor_horizon'):\n        normalized = (network - tree) / context_graph['scale']\n        neighbor_gap = np.sum(normalized[..., context_graph['neighbors']] *\n                              context_graph['weights'], axis=-1) * context_graph['scale']\n        variables.append(np.clip(neighbor_gap / 20, -3, 3))\n    if mode == 'periodic':\n        clock = np.asarray(features['clock'], dtype=np.float64)\n        variables.extend([np.sin(2 * np.pi * clock), np.cos(2 * np.pi * clock),\n                          np.sin(4 * np.pi * clock), np.cos(4 * np.pi * clock)])\n    if use_replica_gap:\n        uncertainty = np.clip(replica_gap / 20, 0, 3)\n        variables.extend([uncertainty, (horizon - 0.5) * uncertainty])\n    return np.stack(variables, axis=-1).reshape(-1, len(variables))\n\n\ndef _gate_fit(features, target, tree, network, penalty=0.01, mode='standard', replica_gap=None):\n    context_graph = (spatial_calibration._neighborhood(features)\n                     if mode in ('site_neighbor_expert', 'site_neighbor_horizon',\n                                 'site_replica_gap', 'site_replica_shared') else None)\n    x = _design(features, tree, network, mode, context_graph, replica_gap)\n    valid = (np.isfinite(target) & (target > 0)).reshape(-1)\n    x = x[valid]\n    center = x.mean(axis=0)\n    center[0] = 0\n    scale = np.maximum(x.std(axis=0), 0.1)\n    scale[0] = 1\n    x = np.clip((x - center) / scale, -4, 4)\n    residual = (tree - target).reshape(-1)[valid]\n    difference = (network - tree).reshape(-1)[valid]\n    weight0 = np.broadcast_to(np.where(np.arange(tree.shape[1]) < 6, 0.18, 0.32)[None, :, None], tree.shape).reshape(-1)[valid]\n    offset = np.log(weight0 / (1 - weight0))\n    use_site = mode in ('site', 'site_horizon', 'site_context', 'site_direction',\n                       'site_direction_horizon', 'site_reliability',\n                       'site_expert_direction', 'site_expert_shared', 'site_expert_horizon',\n                       'site_expert_horizon_shared', 'site_neighbor_expert', 'site_neighbor_horizon',\n                       'site_replica_gap', 'site_replica_shared',\n                       'site_context_signed')\n    if use_site:\n        nodes = tree.shape[2]\n        node = np.broadcast_to(np.arange(nodes)[None, None, :], tree.shape).reshape(-1)[valid]\n        width = {'site': 1, 'site_horizon': 2, 'site_context': 4, 'site_direction': 6,\n                 'site_direction_horizon': 10,\n                 'site_reliability': 8, 'site_expert_direction': 7,\n                 'site_expert_shared': 6,\n                 'site_expert_horizon': 8, 'site_expert_horizon_shared': 7,\n===dynamics_calibration.py\n\"\"\"Residual trees with explicit history dynamics and sensor-level scaling.\"\"\"\nimport numpy as np\nfrom sklearn.ensemble import HistGradientBoostingRegressor\nfrom threadpoolctl import threadpool_limits\nimport tree_calibration\nimport spatial_calibration\n\n\ndef _profile(features):\n    history = np.asarray(features['history'], dtype=np.float32)\n    flat = history.reshape(-1, history.shape[-1])\n    return {'mean': np.maximum(np.mean(flat, axis=0), 10),\n            'std': np.maximum(np.std(flat, axis=0), 10),\n            'median': np.median(flat, axis=0),\n            'quartiles': np.percentile(flat, [10, 90], axis=0).astype(np.float32)}\n\n\ndef _features(f, state):\n    if state.get('neighbors'):\n        x = spatial_calibration._features(f, state['graph'])\n    else:\n        x = tree_calibration._features(f)\n    base = np.asarray(f['base'], dtype=np.float32)\n    anchor = np.asarray(f['anchor'], dtype=np.float32)\n    history = np.asarray(f['history'], dtype=np.float32)\n    def broadcast(v):\n        return np.broadcast_to(v, base.shape)\n    recent = np.mean(history[:, -3:, :], axis=1)[:, None, :]\n    extra = []\n    if state['variant'] in ('lags', 'both', 'robust'):\n        extra.extend([broadcast(history[:, j:j+1, :]) - base for j in (0, 3, 6, 8, 10)])\n        extra.extend([broadcast(base[:, :1, :]) - base,\n                      broadcast(base[:, -1:, :]) - base,\n                      broadcast(np.mean(base, axis=1, keepdims=True)) - base,\n                      broadcast(anchor[:, :1, :]) - anchor,\n                      broadcast(anchor[:, -1:, :]) - anchor,\n                      broadcast(np.median(history[:, -3:, :], axis=1)[:, None, :]) - base,\n                      broadcast(np.median(history, axis=1)[:, None, :]) - base])\n    if state['variant'] in ('profile', 'both', 'robust'):\n        profile = state['profile']\n        mean, std = profile['mean'], profile['std']\n        extra.extend([broadcast(mean), broadcast(std),\n                      base / mean, anchor / mean,\n                      (base - profile['median']) / std,\n                      (anchor - base) / std,\n                      (recent - base) / std])\n    if state['variant'] == 'robust':\n        spread = np.percentile(history, 75, axis=1) - np.percentile(history, 25, axis=1)\n        extra.extend([broadcast(spread[:, None, :]),\n                      broadcast(np.mean(history == 0, axis=1)[:, None, :]),\n                      (anchor - base) / np.maximum(anchor, 30),\n                      np.sin(2 * np.pi * f['clock']), np.cos(2 * np.pi * f['clock'])])\n    return np.column_stack([x] + [v.reshape(-1) for v in extra])\n\n\ndef fit(features, targets, seed, variant='both', neighbors=False, max_iter=90):\n    with threadpool_limits(limits=2):\n        state = {'variant': variant, 'profile': _profile(features), 'neighbors': neighbors}\n        if neighbors:\n            state['graph'] = spatial_calibration._neighborhood(features)\n        x = _features(features, state)\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets)\n        valid = np.isfinite(y) & (y > 0)\n        residual = y - np.asarray(features['base'])\n        model = HistGradientBoostingRegressor(\n            loss='absolute_error', max_iter=max_iter, learning_rate=0.06,\n            max_leaf_nodes=15, min_samples_leaf=250, l2_regularization=20,\n            categorical_features=[14], early_stopping=False, random_state=seed)\n        model.fit(x[valid.ravel()], residual[valid])\n        state['model'] = model\n        return state\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=2):\n        residual = state['model'].predict(_features(features, state)).reshape(features['base'].shape)\n        return np.maximum(np.asarray(features['base']) + residual, 0).astype(np.float32)\n===hierarchical_calibration.py\n\"\"\"Pooled median tree followed by regularized sensor-specific corrections.\"\"\"\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport spatial_calibration\n\n\ndef _design(features, mode, center):\n    base = np.asarray(features['base'], dtype=np.float64)\n    history = np.asarray(features['history'], dtype=np.float64)\n    anchor = np.asarray(features['anchor'], dtype=np.float64)\n    arr = [np.ones_like(base)]\n    if mode == 'affine':\n        horizon = np.broadcast_to(np.linspace(-1, 1, base.shape[1])[None, :, None], base.shape)\n        recent = np.mean(history[:, -3:, :], axis=1)[:, None, :]\n        arr += [horizon, np.clip((anchor - base) / 50, -5, 5),\n                np.clip((recent - base) / 50, -5, 5),\n                (base - center) / 200]\n    return np.stack(arr, axis=-1)\n\n\ndef _sensor_fit(x, residual, valid):\n    xx = x.transpose(2, 0, 1, 3).reshape(x.shape[2], -1, x.shape[-1])\n    yy = residual.transpose(2, 0, 1).reshape(x.shape[2], -1)\n    mask = valid.transpose(2, 0, 1).reshape(x.shape[2], -1)\n    yy = np.where(mask, yy, 0)\n    coef = np.zeros((x.shape[2], x.shape[-1]))\n    strength = np.array([10, 50, 60, 60, 60], dtype=np.float64)[:x.shape[-1]]\n    for _ in range(12):\n        error = yy - np.einsum('nrp,np->nr', xx, coef)\n        weights = mask / np.maximum(np.abs(error), 3)\n        gram = np.einsum('nrp,nr,nrq->npq', xx, weights, xx, optimize=True)\n        rhs = np.einsum('nrp,nr,nr->np', xx, weights, yy, optimize=True)\n        coef = np.linalg.solve(gram + np.diag(strength), rhs[..., None])[..., 0]\n    return coef.astype(np.float32)\n\n\ndef fit(features, targets, seed, mode='offset', crossfit=False):\n    with threadpool_limits(limits=2):\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets)\n        tree = spatial_calibration.fit(features, y, seed)\n        if crossfit:\n            prediction = np.zeros_like(y)\n            for held in np.array_split(np.arange(y.shape[0]), 3):\n                train = np.setdiff1d(np.arange(y.shape[0]), held)\n                fold = spatial_calibration.fit({k: v[train] for k, v in features.items()}, y[train], seed)\n                prediction[held] = spatial_calibration.predict(fold, {k: v[held] for k, v in features.items()})\n        else:\n            prediction = spatial_calibration.predict(tree, features)\n        valid = np.isfinite(y) & (y > 0)\n        center = np.mean(features['base'], axis=(0, 1), keepdims=True)\n        x = _design(features, mode, center)\n        coef = _sensor_fit(x, y - prediction, valid)\n        return {'tree': tree, 'coef': coef, 'mode': mode, 'center': center}\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=2):\n        baseline = spatial_calibration.predict(state['tree'], features)\n        correction = np.einsum('shnp,np->shn', _design(features, state['mode'], state['center']), state['coef'])\n        return np.maximum(baseline + correction, 0).astype(np.float32)\n===horizon_calibration.py\n\"\"\"Partial pooling of median residual trees specialized by forecast horizon.\"\"\"\nimport numpy as np\nfrom sklearn.ensemble import HistGradientBoostingRegressor\nfrom threadpoolctl import threadpool_limits\nimport spatial_calibration\n\n\ndef _model(seed):\n    return HistGradientBoostingRegressor(\n        loss='absolute_error', max_iter=90, learning_rate=0.06,\n        max_leaf_nodes=15, min_samples_leaf=250, l2_regularization=20,\n        categorical_features=[14], early_stopping=False, random_state=seed)\n\n\ndef fit(features, targets, seed, groups=3, graph=None):\n    with threadpool_limits(limits=1):\n        pooled = spatial_calibration.fit(features, targets, seed, graph=graph)\n        x = spatial_calibration._features(features, pooled['graph'])\n        shape = features['base'].shape\n        x = x.reshape(*shape, -1)\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets)\n        valid = np.isfinite(y) & (y > 0)\n        residual = y - np.asarray(features['base'])\n        models = []\n        for horizons in np.array_split(np.arange(shape[1]), groups):\n            xx = x[:, horizons].reshape(-1, x.shape[-1])\n            ok = valid[:, horizons].reshape(-1)\n            yy = residual[:, horizons].reshape(-1)\n            model = _model(seed)\n            model.fit(xx[ok], yy[ok])\n            models.append((horizons, model))\n        return {'pooled': pooled, 'models': models, 'expert_weight': 0.5}\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=1):\n        shape = features['base'].shape\n        x = spatial_calibration._features(features, state['pooled']['graph']).reshape(*shape, -1)\n        expert = np.zeros(shape, dtype=np.float32)\n        for horizons, model in state['models']:\n            expert[:, horizons] = model.predict(x[:, horizons].reshape(-1, x.shape[-1])).reshape(shape[0], len(horizons), shape[2])\n        pooled = state['pooled']['model'].predict(x.reshape(-1, x.shape[-1])).reshape(shape)\n        weight = state['expert_weight']\n        correction = pooled * (1 - weight) + expert * weight\n        return np.maximum(np.asarray(features['base']) + correction, 0).astype(np.float32)\n===method.py\n\"\"\"Seasonal graph experts with bounded context-aware residual sharing.\"\"\"\nimport conditional_calibration\n\n\ndef fit(features, targets, seed):\n    return conditional_calibration.fit(features, targets, seed, site_head='graph',\n                                       gate_mode='site_neighbor_horizon', network_replicas=2,\n                                       network_epochs=(100, 80), network_diffusion=True,\n                                       residual_tree='context_smooth')\n\n\ndef predict(state, features):\n    return conditional_calibration.predict(state, features)\n===neural_calibration.py\n\"\"\"Small NumPy residual network trained with a smooth absolute-error objective.\"\"\"\nimport time\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport spatial_calibration\n\n\ndef _features(features, graph, mode='summary'):\n    raw = spatial_calibration._features(features, graph)\n    node = raw[:, 14].astype(np.int64)\n    clock = np.asarray(features['clock']).reshape(-1)\n    periodic = [np.sin(2 * np.pi * clock), np.cos(2 * np.pi * clock),\n                np.sin(4 * np.pi * clock), np.cos(4 * np.pi * clock)]\n    columns = [np.delete(raw, 14, axis=1)] + periodic\n    if mode == 'network_context':\n        base = np.asarray(features['base'], dtype=np.float32)\n        anchor = np.asarray(features['anchor'], dtype=np.float32)\n        history = np.asarray(features['history'], dtype=np.float32)\n        recent = np.mean(history[:, -3:, :], axis=1)[:, None, :]\n        scale = np.maximum(np.mean(history, axis=1)[:, None, :], 30)\n        anchor_difference = np.clip((anchor - base) / scale, -2, 2)\n        recent_difference = np.clip((recent - base) / scale, -2, 2)\n        summaries = [np.mean(np.clip(base / scale, 0, 3), axis=-1, keepdims=True),\n                     np.mean(anchor_difference, axis=-1, keepdims=True),\n                     np.mean(recent_difference, axis=-1, keepdims=True),\n                     np.std(anchor_difference, axis=-1, keepdims=True)]\n        columns += [np.broadcast_to(value, base.shape).reshape(-1) for value in summaries]\n    if mode in ('history', 'relative'):\n        base = np.asarray(features['base'], dtype=np.float32)\n        history = np.asarray(features['history'], dtype=np.float32)\n        recent = np.mean(history[:, -3:, :], axis=1)[:, None, :]\n        # The shared network can learn a temporal filter rather than relying\n        # only on fixed three/six-step averages and one trend statistic.\n        columns += [np.broadcast_to(history[:, j:j+1, :] - recent, base.shape).reshape(-1)\n                    for j in range(history.shape[1])]\n        columns += [(base[:, :1, :] - base).reshape(-1),\n                    (base[:, -1:, :] - base).reshape(-1)]\n        if mode == 'relative':\n            anchor = np.asarray(features['anchor'], dtype=np.float32)\n            scale = graph['scale']\n            columns += [np.broadcast_to(scale, base.shape).reshape(-1),\n                        (base / scale).reshape(-1),\n                        ((anchor - base) / scale).reshape(-1),\n                        ((recent - base) / scale).reshape(-1)]\n    return np.column_stack(columns), node\n\n\ndef _head_features(features, mode=True):\n    shape = features['base'].shape\n    clock = np.asarray(features['clock'], dtype=np.float32).reshape(-1)\n    horizon = np.broadcast_to(np.linspace(-1, 1, shape[1])[None, :, None], shape).reshape(-1)\n    if mode == 'trend':\n        return np.column_stack([np.ones_like(clock), horizon]).astype(np.float32)\n    columns = [np.ones_like(clock), horizon,\n               np.sin(2 * np.pi * clock), np.cos(2 * np.pi * clock),\n               np.sin(4 * np.pi * clock), np.cos(4 * np.pi * clock)]\n    if mode == 'innovation':\n        base = np.asarray(features['base'], dtype=np.float32)\n        anchor = np.asarray(features['anchor'], dtype=np.float32)\n        history = np.asarray(features['history'], dtype=np.float32)\n        scale = np.maximum(np.mean(history, axis=1)[:, None, :], 30)\n        recent = np.mean(history[:, -3:, :], axis=1)[:, None, :]\n        last = history[:, -1:, :]\n        columns.extend([np.clip((anchor - base) / scale, -1.5, 1.5).reshape(-1),\n                        np.clip((recent - base) / scale, -1.5, 1.5).reshape(-1),\n                        np.broadcast_to(np.clip((last - recent) / scale, -1, 1), shape).reshape(-1)])\n    return np.column_stack(columns).astype(np.float32)\n\n\ndef _forward(x, node, params, head_x=None):\n    xx = np.column_stack([x, params['embedding'][node]])\n    h1 = np.tanh(xx @ params['w1'] + params['b1'])\n    h2 = np.tanh(h1 @ params['w2'] + params['b2'])\n    output = (h2 @ params['w3'] + x @ params['w0'] + params['b3']).reshape(-1)\n    if 'site_head' in params:\n        output += np.sum(head_x * params['site_head'][node], axis=1)\n    return output, (xx, h1, h2)\n\n\ndef _node_gradient(node, values, nodes):\n    return np.column_stack([\n        np.bincount(node, weights=values[:, j], minlength=nodes)\n        for j in range(values.shape[1])]).astype(np.float32)\n\n\ndef fit(features, targets, seed, epochs=100, graph=None, mode='summary', site_head=False, average=False,\n        graph_strength=0.005, embedding_strength=0, replicas=1):\n    if replicas > 1:\n        members = [fit(features, targets, seed + 1009 * j,\n                       epochs[j] if isinstance(epochs, (tuple, list)) else epochs, graph,\n                       mode[j] if isinstance(mode, (tuple, list)) else mode,\n                       site_head, average, graph_strength, embedding_strength)\n                   for j in range(replicas)]\n        return {'members': members}\n    with threadpool_limits(limits=1):\n        start = time.monotonic()\n        rng = np.random.default_rng(seed)\n        if graph is None:\n            graph = spatial_calibration._neighborhood(features)\n        x, node = _features(features, graph, mode)\n===physical_calibration.py\n\"\"\"Learned and public physical-neighbor context for residual calibration.\"\"\"\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport spatial_calibration\nimport horizon_calibration\nimport blended_calibration\n\n\ndef _graph(features, mode='augment'):\n    graph = spatial_calibration._neighborhood(features)\n    adjacency = np.asarray(np.load('/workspace/public_assets/graph.npz')['adjacency'], dtype=np.float32)\n    weights = adjacency / np.maximum(adjacency.sum(axis=1, keepdims=True), 1e-8)\n    if mode == 'augment':\n        graph['physical'] = weights\n    else:\n        neighbors = np.argsort(weights, axis=1)[:, -9:]\n        graph['neighbors'] = neighbors\n        graph['weights'] = np.take_along_axis(weights, neighbors, axis=1)\n    return graph\n\n\ndef fit(features, targets, seed, mode='augment', network=True):\n    with threadpool_limits(limits=2):\n        graph = _graph(features, mode)\n        if network:\n            return {'blend': blended_calibration.fit(features, targets, seed, graph=graph)}\n        return {'tree': horizon_calibration.fit(features, targets, seed, groups=2, graph=graph)}\n\n\ndef predict(state, features):\n    if 'blend' in state:\n        return blended_calibration.predict(state['blend'], features)\n    return horizon_calibration.predict(state['tree'], features)\n===research_validation.py\n\"\"\"Public calibration origin-block comparisons; never reads development targets.\"\"\"\nimport time\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport tree_calibration\nimport spatial_calibration\n\n\ndef load():\n    features = dict(np.load('/workspace/public_assets/train_features.npz'))\n    targets = np.load('/workspace/public_assets/train_targets.npz')['target']\n    return features, targets\n\n\ndef subset(features, index):\n    return {key: value[index] for key, value in features.items()}\n\n\ndef mae(target, prediction):\n    valid = np.isfinite(target) & (target > 0)\n    return float(np.mean(np.abs(target[valid] - prediction[valid])))\n\n\ndef evaluate(fit, predict, name, splits=None):\n    features, targets = load()\n    if splits is None:\n        splits = [(np.arange(50), np.arange(50, 74)),\n                  (np.r_[0:25, 49:74], np.arange(25, 49))]\n    start = time.monotonic()\n    output = []\n    for train, test in splits:\n        state = fit(subset(features, train), targets[train], 17)\n        pred = predict(state, subset(features, test))\n        value = mae(targets[test], pred)\n        output.append(value)\n        print(name, 'test', test[0], test[-1], 'MAE', value,\n              'elapsed', round(time.monotonic() - start, 2), flush=True)\n    return output\n\n\nif __name__ == '__main__':\n    with threadpool_limits(limits=2):\n        evaluate(tree_calibration.fit, tree_calibration.predict, 'retained')\n        for variant in ['neighbors', 'relative']:\n            evaluate(lambda f, y, s: spatial_calibration.fit(f, y, s, variant=variant),\n                     spatial_calibration.predict, variant)\n===scaled_calibration.py\n\"\"\"Heteroscedastic residual trees with weights preserving the raw MAE objective.\"\"\"\nimport numpy as np\nfrom sklearn.ensemble import HistGradientBoostingRegressor\nfrom threadpoolctl import threadpool_limits\nimport spatial_calibration\n\n\ndef _scale(features, state):\n    base = np.asarray(features['base'], dtype=np.float32)\n    if state['scaling'] == 'poisson':\n        return np.sqrt(np.maximum(base, 20))\n    if state['scaling'] == 'flow':\n        return np.maximum(base, 30)\n    return np.broadcast_to(state['node_scale'], base.shape)\n\n\ndef fit(features, targets, seed, scaling='node', max_iter=90):\n    with threadpool_limits(limits=2):\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets)\n        valid = np.isfinite(y) & (y > 0)\n        residual = y - np.asarray(features['base'])\n        masked = np.where(valid, np.abs(residual), np.nan)\n        node_scale = np.maximum(np.nanmedian(masked, axis=(0, 1)), 2).astype(np.float32)\n        node_scale = np.nan_to_num(node_scale, nan=10)\n        state = {'scaling': scaling, 'node_scale': node_scale,\n                 'graph': spatial_calibration._neighborhood(features)}\n        scale = _scale(features, state)\n        x = spatial_calibration._features(features, state['graph'])\n        x = np.column_stack([x, scale.reshape(-1)])\n        model = HistGradientBoostingRegressor(\n            loss='absolute_error', max_iter=max_iter, learning_rate=0.06,\n            max_leaf_nodes=15, min_samples_leaf=250, l2_regularization=20,\n            categorical_features=[14], early_stopping=False, random_state=seed)\n        weights = scale[valid]\n        weights = weights / np.mean(weights)\n        model.fit(x[valid.ravel()], (residual / scale)[valid], sample_weight=weights)\n        state['model'] = model\n        return state\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=2):\n        scale = _scale(features, state)\n        x = spatial_calibration._features(features, state['graph'])\n        x = np.column_stack([x, scale.reshape(-1)])\n        residual = state['model'].predict(x).reshape(features['base'].shape) * scale\n        return np.maximum(np.asarray(features['base']) + residual, 0).astype(np.float32)\n===seasonal_calibration.py\n\"\"\"Median residual calibration using anchor-aligned historical innovations.\"\"\"\nimport numpy as np\nfrom sklearn.ensemble import HistGradientBoostingRegressor\nfrom threadpoolctl import threadpool_limits\nimport spatial_calibration\n\n\ndef _basis(clock, harmonics=8):\n    arr = [np.ones_like(clock)]\n    for k in range(1, harmonics + 1):\n        arr.extend([np.sin(2 * np.pi * k * clock), np.cos(2 * np.pi * k * clock)])\n    return np.stack(arr, axis=-1)\n\n\ndef _template(features):\n    clock = np.asarray(features['clock'], dtype=np.float64)[:, :, 0].reshape(-1)\n    anchor = np.asarray(features['anchor'], dtype=np.float64).reshape(-1, features['base'].shape[-1])\n    x = _basis(clock)\n    penalty = np.diag(np.r_[0.1, np.repeat(np.arange(1, 9) ** 2, 2) * 2])\n    coef = np.linalg.solve(x.T @ x + penalty, x.T @ anchor)\n    return coef.astype(np.float32)\n\n\ndef _features(features, state):\n    x = spatial_calibration._features(features, state['graph'])\n    base = np.asarray(features['base'], dtype=np.float32)\n    anchor = np.asarray(features['anchor'], dtype=np.float32)\n    history = np.asarray(features['history'], dtype=np.float32)\n    future_clock = np.asarray(features['clock'])[:, :, 0]\n    history_clock = (future_clock[:, :1] - np.arange(12, 0, -1)[None, :] / 288) % 1\n    template_future = _basis(future_clock) @ state['template']\n    template_history = _basis(history_clock) @ state['template']\n    def broadcast(v):\n        return np.broadcast_to(v[:, None, :], base.shape)\n    aligned_history = template_history + np.mean(anchor - template_future, axis=1)[:, None, :]\n    innovation = history - aligned_history\n    last = innovation[:, -1, :]\n    recent = np.mean(innovation[:, -3:, :], axis=1)\n    older = np.mean(innovation[:, :6, :], axis=1)\n    slope = np.mean(innovation[:, -3:, :], axis=1) - np.mean(innovation[:, :3, :], axis=1)\n    extra = [broadcast(last), broadcast(recent), broadcast(older), broadcast(slope),\n             broadcast(np.std(innovation, axis=1)), anchor - template_future,\n             template_future - base]\n    if state['variant'] == 'neighbors':\n        graph = state['graph']\n        def aggregate(v):\n            normalized = v / graph['scale']\n            return np.sum(normalized[..., graph['neighbors']] * graph['weights'], axis=-1) * graph['scale']\n        extra += [broadcast(aggregate(last)), broadcast(aggregate(recent)), broadcast(aggregate(slope))]\n    if state['variant'] == 'extrapolated':\n        slope_anchor = np.mean(np.diff(anchor[:, :4, :], axis=1), axis=1)\n        expected_last = anchor[:, 0, :] - slope_anchor\n        extra += [broadcast(history[:, -1, :] - expected_last),\n                  broadcast(np.mean(history[:, -3:, :], axis=1) - (expected_last - slope_anchor)),\n                  broadcast(slope_anchor)]\n    return np.column_stack([x] + [v.reshape(-1) for v in extra])\n\n\ndef fit(features, targets, seed, variant='local', max_iter=90):\n    with threadpool_limits(limits=2):\n        state = {'template': _template(features),\n                 'graph': spatial_calibration._neighborhood(features), 'variant': variant}\n        x = _features(features, state)\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets)\n        valid = np.isfinite(y) & (y > 0)\n        residual = y - np.asarray(features['base'])\n        model = HistGradientBoostingRegressor(\n            loss='absolute_error', max_iter=max_iter, learning_rate=0.06,\n            max_leaf_nodes=15, min_samples_leaf=250, l2_regularization=20,\n            categorical_features=[14], early_stopping=False, random_state=seed)\n        model.fit(x[valid.ravel()], residual[valid])\n        state['model'] = model\n        return state\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=2):\n        residual = state['model'].predict(_features(features, state)).reshape(features['base'].shape)\n        return np.maximum(np.asarray(features['base']) + residual, 0).astype(np.float32)\n===spatial_calibration.py\n\"\"\"Median residual trees with neighborhoods learned from calibration history.\"\"\"\nimport numpy as np\nfrom sklearn.ensemble import HistGradientBoostingRegressor\nfrom threadpoolctl import threadpool_limits\nimport tree_calibration\n\n\ndef _neighborhood(features, count=8):\n    history = np.asarray(features['history'], dtype=np.float64)\n    changes = np.diff(history, axis=1).reshape(-1, history.shape[2])\n    changes -= np.mean(changes, axis=0)\n    scale = np.maximum(np.std(history.reshape(-1, history.shape[2]), axis=0), 10)\n    norm = np.sqrt(np.sum(changes * changes, axis=0))\n    correlation = (changes.T @ changes) / np.maximum(norm[:, None] * norm[None, :], 1)\n    np.fill_diagonal(correlation, -1)\n    neighbors = np.argsort(correlation, axis=1)[:, -count:]\n    weights = np.maximum(np.take_along_axis(correlation, neighbors, axis=1), 0) ** 2\n    weights /= np.maximum(weights.sum(axis=1, keepdims=True), 1e-8)\n    return {'neighbors': neighbors, 'weights': weights.astype(np.float32),\n            'scale': scale.astype(np.float32)}\n\n\ndef _features(features, graph, variant='neighbors'):\n    x = tree_calibration._features(features)\n    base = np.asarray(features['base'], dtype=np.float32)\n    anchor = np.asarray(features['anchor'], dtype=np.float32)\n    history = np.asarray(features['history'], dtype=np.float32)\n    scale = graph['scale']\n    def aggregate(value):\n        normalized = value / scale\n        mean = np.sum(normalized[..., graph['neighbors']] * graph['weights'], axis=-1)\n        return mean * scale\n    recent = np.mean(history[:, -3:, :], axis=1)[:, None, :]\n    older = np.mean(history[:, :3, :], axis=1)[:, None, :]\n    last = history[:, -1:, :]\n    spread = np.std(history, axis=1)[:, None, :]\n    extra = [aggregate(anchor - base), aggregate(recent - base),\n             aggregate(last - base), np.broadcast_to(aggregate(recent - older), base.shape),\n             np.broadcast_to(aggregate(spread), base.shape)]\n    if variant == 'relative':\n        extra.extend([(anchor - base) / scale, (recent - base) / scale,\n                      np.broadcast_to(spread / scale, base.shape),\n                      base / np.maximum(anchor, 30),\n                      aggregate(anchor - base) - (anchor - base)])\n    if 'physical' in graph:\n        def physical(value):\n            return ((value / scale) @ graph['physical'].T) * scale\n        extra.extend([physical(anchor - base), physical(recent - base),\n                      physical(last - base),\n                      np.broadcast_to(physical(recent - older), base.shape),\n                      np.broadcast_to(physical(spread), base.shape)])\n    return np.column_stack([x] + [v.reshape(-1) for v in extra])\n\n\ndef fit(features, targets, seed, variant='neighbors', max_iter=90, graph=None):\n    with threadpool_limits(limits=1):\n        if graph is None:\n            graph = _neighborhood(features)\n        x = _features(features, graph, variant)\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets)\n        valid = np.isfinite(y) & (y > 0)\n        residual = y - np.asarray(features['base'])\n        model = HistGradientBoostingRegressor(\n            loss='absolute_error', max_iter=max_iter, learning_rate=0.06,\n            max_leaf_nodes=15, min_samples_leaf=250, l2_regularization=20,\n            categorical_features=[14], early_stopping=False, random_state=seed)\n        model.fit(x[valid.ravel()], residual[valid])\n        return {'graph': graph, 'variant': variant, 'model': model}\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=1):\n        x = _features(features, state['graph'], state['variant'])\n        residual = state['model'].predict(x).reshape(features['base'].shape)\n        return np.maximum(np.asarray(features['base']) + residual, 0).astype(np.float32)\n\n\ndef diffusion_fit(features, prediction, robust=False):\n    shape = features['base'].shape\n    clock = np.asarray(features['clock'], dtype=np.float64)\n    horizon = np.broadcast_to(np.linspace(-1, 1, shape[1])[None, :, None], shape)\n    x = np.stack([np.ones(shape), horizon, np.sin(2 * np.pi * clock),\n                  np.cos(2 * np.pi * clock), np.sin(4 * np.pi * clock),\n                  np.cos(4 * np.pi * clock)], axis=-1)\n    residual = prediction - features['base']\n    gram = np.einsum('shni,shnj->nij', x, x, optimize=True)\n    rhs = np.einsum('shni,shn->ni', x, residual, optimize=True)\n    ridge = np.diag([0, 1, 1, 1, 1, 1]) * shape[0] * shape[1] * 0.05\n    coef = np.linalg.solve(gram + ridge, rhs[..., None])[..., 0]\n    state = {'graph': _neighborhood(features), 'coef': coef.astype(np.float32)}\n    if robust:\n        seasonal = np.einsum('shni,ni->shn', x, state['coef'])\n        normalized = (prediction - features['base'] - seasonal) / state['graph']['scale']\n        difference = (normalized[..., state['graph']['neighbors']]\n                      - normalized[..., None])\n        # A forecast-only scale for each sensor bounds the influence of large\n        # disagreements without fitting any additional target-dependent rule.\n        state['threshold'] = np.maximum(\n            3 * np.median(np.abs(difference), axis=(0, 1, 3)), 0.05)\n    return state\n===stacked_calibration.py\n\"\"\"Cross-fitted tree forecasts with a smooth residual correction network.\"\"\"\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport horizon_calibration\nimport neural_calibration\n\n\ndef _with_base(features, base):\n    return {**features, 'base': base}\n\n\ndef fit(features, targets, seed):\n    with threadpool_limits(limits=2):\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets)\n        out_of_fold = np.zeros_like(y)\n        index = np.arange(len(y))\n        for held in np.array_split(index, 3):\n            train = np.setdiff1d(index, held)\n            fold = horizon_calibration.fit({k: v[train] for k, v in features.items()}, y[train], seed, groups=2)\n            out_of_fold[held] = horizon_calibration.predict(fold, {k: v[held] for k, v in features.items()})\n        network = neural_calibration.fit(_with_base(features, out_of_fold), y, seed)\n        tree = horizon_calibration.fit(features, y, seed, groups=2)\n        return {'tree': tree, 'network': network, 'correction_weight': 0.25}\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=2):\n        tree = horizon_calibration.predict(state['tree'], features)\n        corrected = neural_calibration.predict(state['network'], _with_base(features, tree))\n        weight = state['correction_weight']\n        return (tree * (1 - weight) + corrected * weight).astype(np.float32)\n===tree_calibration.py\n\"\"\"Pooled nonlinear correction from current, anchor and historical context.\"\"\"\nimport numpy as np\nfrom sklearn.ensemble import HistGradientBoostingRegressor\nfrom threadpoolctl import threadpool_limits\nimport calibration\n\n\ndef _features(f, context=False):\n    b = np.asarray(f['base'], dtype=np.float32)\n    a = np.asarray(f['anchor'], dtype=np.float32)\n    z = np.asarray(f['history'], dtype=np.float32)\n    clock = np.asarray(f['clock'], dtype=np.float32)\n    def broadcast(v):\n        return np.broadcast_to(v[:, None, :], b.shape)\n    last = broadcast(z[:, -1, :])\n    avg3 = broadcast(np.mean(z[:, -3:, :], axis=1))\n    avg6 = broadcast(np.mean(z[:, -6:, :], axis=1))\n    avg = broadcast(np.mean(z, axis=1))\n    std = broadcast(np.std(z, axis=1))\n    delta = broadcast(np.mean(z[:, -3:, :],axis=1)-np.mean(z[:, :3, :],axis=1))\n    spread = broadcast(np.max(z,axis=1)-np.min(z,axis=1))\n    horizon = np.broadcast_to(np.arange(b.shape[1])[None, :, None],b.shape)\n    bd = np.gradient(b, axis=1)\n    ad = np.gradient(a, axis=1)\n    node = np.broadcast_to(np.arange(b.shape[2])[None,None,:],b.shape)\n    features = [b, a-b, last-b, avg3-b, avg6-b, avg-b, std, delta,\n                spread, clock, horizon, bd, ad, a, node]\n    if context:\n        def network(v):\n            return np.broadcast_to(np.mean(v,axis=2,keepdims=True),b.shape)\n        def block(v):\n            return np.broadcast_to(np.mean(v,axis=1,keepdims=True),b.shape)\n        features.extend([network(b),network(a-b),network(avg3-b),\n                         network(delta),network(std),\n                         (a-b)/np.maximum(a,30),std/np.maximum(avg,30),\n                         block(a-b),block(b)-b,\n                         b[:,0,None,:]+np.zeros_like(b)-b,\n                         np.sin(2*np.pi*clock),np.cos(2*np.pi*clock)])\n    return np.stack(features,axis=-1).reshape(-1,len(features))\n\n\ndef fit(features, targets, seed, mode='raw', max_iter=90, context=False):\n    with threadpool_limits(limits=2):\n        y = np.asarray(targets['target'] if isinstance(targets,dict) else targets)\n        valid = np.isfinite(y)&(y>0)\n        x = _features(features,context)\n        residual = y-np.asarray(features['base'])\n        model = HistGradientBoostingRegressor(loss='absolute_error',\n                    max_iter=max_iter,learning_rate=0.06,max_leaf_nodes=15,\n                    min_samples_leaf=250,l2_regularization=20,\n                    categorical_features=[14],early_stopping=False,\n                    random_state=seed)\n        state = {'mode':mode, 'context':context}\n        if mode=='residual':\n            state['linear']=calibration.fit(features,targets,seed)\n            residual=y-calibration.predict(state['linear'],features)\n        model.fit(x[valid.ravel()],residual[valid])\n        state['model']=model\n        return state\n\n\ndef predict(state,features):\n    with threadpool_limits(limits=2):\n        residual=state['model'].predict(_features(features,state.get('context',False))).reshape(features['base'].shape)\n        base=np.asarray(features['base'])\n        if state['mode']=='residual':\n            base=calibration.predict(state['linear'],features)\n        return np.maximum(base+residual,0).astype(np.float32)\n","exit_code":0,"status":"completed"}}

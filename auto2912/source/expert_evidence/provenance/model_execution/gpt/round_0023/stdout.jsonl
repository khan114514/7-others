{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/sh -lc \"sed -n '1,140p' /tmp/trend_turn_runtime.py\"","aggregated_output":"\"\"\"Fit and independently reload the current public-only method.\"\"\"\nimport os\nimport pickle\nimport subprocess\nimport sys\nimport time\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport method\n\n\nif len(sys.argv) > 1:\n    start = time.monotonic()\n    with open('/tmp/trend_turn_state.pkl', 'rb') as inp:\n        state = pickle.load(inp)\n    features = dict(np.load('/workspace/public_assets/dev_features.npz'))\n    prediction = method.predict(state, features)\n    original = np.load('/tmp/trend_turn_prediction.npy')\n    print('reload seconds', time.monotonic() - start,\n          'max difference', np.max(np.abs(prediction - original)),\n          'shape', prediction.shape, 'finite', np.isfinite(prediction).all(), flush=True)\nelse:\n    f = dict(np.load('/workspace/public_assets/train_features.npz'))\n    y = np.load('/workspace/public_assets/train_targets.npz')['target']\n    wall, cpu = time.monotonic(), time.process_time()\n    with threadpool_limits(limits=1):\n        state = method.fit(f, y, 43)\n    print('fit seconds wall/cpu', time.monotonic() - wall, time.process_time() - cpu,\n          'gate mode', state['gate']['mode'], 'gate coef', state['gate']['coef'].shape,\n          'epochs', [v['epochs'] for v in state['network']['members']], flush=True)\n    payload = pickle.dumps(state)\n    with open('/tmp/trend_turn_state.pkl', 'wb') as out:\n        out.write(payload)\n    fv = dict(np.load('/workspace/public_assets/dev_features.npz'))\n    prediction = method.predict(state, fv)\n    np.save('/tmp/trend_turn_prediction.npy', prediction)\n    print('state bytes', len(payload), 'finite', np.isfinite(prediction).all(),\n          'shape', prediction.shape, flush=True)\n    subprocess.run([sys.executable, __file__, 'reload'], check=True, env=os.environ.copy())\n","exit_code":0,"status":"completed"}}

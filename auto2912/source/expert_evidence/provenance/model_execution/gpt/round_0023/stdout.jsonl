{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/sh -lc 'cat /tmp/forecast_turn_additive/graph_validation.py'","aggregated_output":"\"\"\"Calibration-only checks of robust residual pooling and graph resolvents.\"\"\"\nimport pickle\nimport time\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport conditional_calibration as c\nimport spatial_calibration as s\nimport research_validation as r\nfrom temporal_validation import load\n\nROOT = '/tmp/forecast_turn_additive/'\noriginal = s.diffusion_predict\n\n\ndef harmonic_fit(state):\n    graph = state['graph']\n    nodes = len(graph['scale'])\n    adjacency = np.zeros((nodes, nodes))\n    np.put_along_axis(adjacency, graph['neighbors'], graph['weights'], axis=1)\n    adjacency = (adjacency + adjacency.T) / 2\n    walk = adjacency / adjacency.sum(axis=1, keepdims=True)\n    state['operator'] = np.linalg.solve(np.eye(nodes) + (np.eye(nodes) - walk) / 3,\n                                        np.eye(nodes)).astype(np.float32)\n    return state\n\n\ndef predict(state, f, p):\n    bounded = state.get('pooling') == 'bounded_static'\n    if 'operator' not in state and not bounded:\n        return original(state, f, p)\n    shape = f['base'].shape\n    clock = np.asarray(f['clock'], dtype=np.float64)\n    horizon = np.broadcast_to(np.linspace(-1, 1, shape[1])[None, :, None], shape)\n    x = np.stack([np.ones(shape), horizon, np.sin(2 * np.pi * clock),\n                  np.cos(2 * np.pi * clock), np.sin(4 * np.pi * clock),\n                  np.cos(4 * np.pi * clock)], axis=-1)\n    seasonal = np.einsum('shni,ni->shn', x, state['coef'])\n    innovation = (p - f['base'] - seasonal) / state['graph']['scale']\n    if bounded:\n        graph = state['graph']\n        difference = innovation[..., graph['neighbors']] - innovation[..., None]\n        threshold = state['threshold'][:, None]\n        difference = threshold * np.tanh(difference / threshold)\n        shared = innovation + .25 * np.sum(graph['weights'] * difference, axis=-1)\n        return np.maximum(f['base'] + seasonal + shared * graph['scale'], 0)\n    return np.maximum(f['base'] + seasonal\n                      + (innovation @ state['operator'].T) * state['graph']['scale'], 0)\n\n\nif __name__ == '__main__':\n    start = time.monotonic()\n    s.diffusion_predict = predict\n    with threadpool_limits(limits=1):\n        for split in ['last', 'middle', 'first']:\n            q, raw_o, raw_v = load(split)\n            with open(ROOT + split + '.additive', 'rb') as inp:\n                cache = pickle.load(inp)\n            output = {}\n            for mode in ['robust_static', 'robust_context', 'harmonic_residual',\n                         'harmonic_network', 'harmonic_both']:\n                if mode == 'harmonic_residual' or mode.startswith('robust'):\n                    no, nv, blend, oo = cache['no'], cache['nv'], cache['blend'], cache['oo']\n                    stage = cache['stage']\n                    gate = cache['gate']\n                else:\n                    ds = harmonic_fit(s.diffusion_fit(q['ft'], raw_o))\n                    no, nv = predict(ds, q['ft'], raw_o), predict(ds, q['fv'], raw_v)\n                    gate = c._gate_fit(q['ft'], q['yt'], q['to'], no,\n                                       mode='site_neighbor_horizon')\n                    blend = c._blend(gate, q['fv'], q['tree'], nv)\n                    stage = c._residual_tree_fit(q['ft'], q['yt'], q['to'], no, 17,\n                                                'site_neighbor_horizon', diffuse=True)\n                    oo = np.empty_like(q['yt'])\n                    index = np.arange(len(q['yt']))\n                    for held in np.array_split(index, 3):\n                        keep = np.setdiff1d(index, held)\n                        g = c._gate_fit(r.subset(q['ft'], keep), q['yt'][keep],\n                                        q['to'][keep], no[keep], mode='site_neighbor_horizon')\n                        oo[held] = c._blend(g, r.subset(q['ft'], held), q['to'][held], no[held])\n                if mode.startswith('robust'):\n                    xt = c._residual_tree_design(q['ft'], q['to'], no, oo)\n                    cr = np.clip(stage['model'].predict(xt).reshape(q['yt'].shape), -10, 10)\n                    stage = dict(stage)\n                    stage['diffusion'] = s.diffusion_fit(q['ft'], q['ft']['base'] + cr,\n                                                        robust=True)\n                    if mode == 'robust_context':\n                        stage['diffusion']['pooling'] = 'context_attenuate'\n                    else:\n                        stage['diffusion']['pooling'] = 'bounded_static'\n                elif mode in ['harmonic_residual', 'harmonic_both']:\n                    stage = dict(stage)\n                    stage['diffusion'] = harmonic_fit(dict(stage['diffusion']))\n                prediction = c._residual_tree_predict(stage, q['fv'], q['tree'], nv, blend)\n                output[mode] = {'prediction': prediction, 'gate': gate, 'stage': stage,\n                                'mae': r.mae(q['yv'], prediction)}\n                print(split, mode, 'MAE', output[mode]['mae'],\n                      'control', r.mae(q['yv'], cache['control']),\n                      'wall', round(time.monotonic() - start, 1), flush=True)\n            with open(ROOT + split + '.graph', 'wb') as out:\n                pickle.dump(output, out)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/sh -lc \"sed -n '1,160p' blended_calibration.py\"","aggregated_output":"\"\"\"Horizon-specific median trees blended with a smooth residual network.\"\"\"\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport horizon_calibration\nimport neural_calibration\n\n\ndef fit(features, targets, seed, graph=None, network_mode='summary', auxiliary_mode=None,\n        site_head=False, average=False, network_replicas=1, network_epochs=100):\n    with threadpool_limits(limits=1):\n        state = {'tree': horizon_calibration.fit(features, targets, seed, groups=2, graph=graph),\n                'network': neural_calibration.fit(features, targets, seed, graph=graph, mode=network_mode,\n                                                  site_head=site_head, average=average,\n                                                  replicas=network_replicas, epochs=network_epochs),\n                # The smooth model is more useful at longer horizons on both\n                # public origin blocks; keep a conservative horizon schedule.\n                'network_weight': np.where(np.arange(features['base'].shape[1]) < 6,\n                                           0.18, 0.32).astype(np.float32)}\n        if auxiliary_mode is not None:\n            state['aux_network'] = neural_calibration.fit(\n                features, targets, seed, graph=state['tree']['pooled']['graph'], mode=auxiliary_mode)\n        return state\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=1):\n        tree = horizon_calibration.predict(state['tree'], features)\n        network = neural_calibration.predict(state['network'], features)\n        if 'aux_network' in state:\n            network = (network + neural_calibration.predict(state['aux_network'], features)) / 2\n        weight = np.asarray(state.get('network_weight', 0.25), dtype=np.float32)\n        return (tree * (1.0 - weight[None, :, None]) +\n                network * weight[None, :, None]).astype(np.float32)\n","exit_code":0,"status":"completed"}}

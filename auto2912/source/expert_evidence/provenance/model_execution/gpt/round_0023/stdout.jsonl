{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/sh -lc \"sed -n '260,540p' conditional_calibration.py\"","aggregated_output":"    node = np.broadcast_to(np.arange(base.shape[2])[None, None, :], base.shape)\n    return np.column_stack([value.reshape(-1) for value in\n                            (horizon, node, tree - base, network - base,\n                             network - tree, blend - base)]).astype(np.float32)\n\n\ndef _residual_tree_fit(features, y, tree, network, seed, gate_mode, diffuse=False):\n    # Hold out origins from the gate as well as the two primary experts when\n    # producing the errors used to train the final, deliberately shallow stage.\n    index = np.arange(len(y))\n    blend_oof = np.empty_like(y)\n    for held in np.array_split(index, 3):\n        keep = np.setdiff1d(index, held)\n        train_features = {k: v[keep] for k, v in features.items()}\n        held_features = {k: v[held] for k, v in features.items()}\n        gate = _gate_fit(train_features, y[keep], tree[keep], network[keep], mode=gate_mode)\n        blend_oof[held] = _blend(gate, held_features, tree[held], network[held])\n    x = _residual_tree_design(features, tree, network, blend_oof)\n    valid = np.isfinite(y) & (y > 0)\n    model = HistGradientBoostingRegressor(\n        loss='absolute_error', max_iter=40, learning_rate=0.05,\n        max_leaf_nodes=7, min_samples_leaf=2000, l2_regularization=50,\n        categorical_features=[1], early_stopping=False, random_state=seed)\n    model.fit(x[valid.reshape(-1)], (y - blend_oof)[valid])\n    if diffuse:\n        # Preserve the sensor's seasonal correction while sharing only its\n        # changing component with neighbors learned from calibration history.\n        correction = np.clip(model.predict(x).reshape(y.shape), -10, 10)\n        diffusion = spatial_calibration.diffusion_fit(\n            features, np.asarray(features['base']) + correction,\n            robust=diffuse == 'context_smooth')\n        if diffuse in ('context', 'context_smooth'):\n            diffusion['pooling'] = 'context_attenuate'\n        return {'model': model, 'diffusion': diffusion}\n    return model\n\n\ndef _residual_tree_predict(model, features, tree, network, blend):\n    x = _residual_tree_design(features, tree, network, blend)\n    if isinstance(model, dict):\n        base = np.asarray(features['base'])\n        correction = np.clip(model['model'].predict(x).reshape(blend.shape), -10, 10)\n        correction = spatial_calibration.diffusion_predict(\n            model['diffusion'], features, base + correction) - base\n        return np.maximum(blend + correction, 0)\n    correction = np.clip(model.predict(x).reshape(blend.shape), -10, 10)\n    return np.maximum(blend + 0.5 * correction, 0)\n\n\ndef fit(features, targets, seed, auxiliary_mode=None, site_head=False, average=False,\n        gate_mode='standard', amplitude=False, network_mode='summary', network_replicas=1,\n        network_diffusion=False, network_epochs=100, residual_tree=False):\n    with threadpool_limits(limits=1):\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets)\n        index = np.arange(len(y))\n        tree_oof, network_oof = np.empty_like(y), np.empty_like(y)\n        use_replica_gap = gate_mode in ('site_replica_gap', 'site_replica_shared')\n        replica_gap_oof = np.empty_like(y) if use_replica_gap else None\n        for held in np.array_split(index, 3):\n            train = np.setdiff1d(index, held)\n            train_features = {k: v[train] for k, v in features.items()}\n            test_features = {k: v[held] for k, v in features.items()}\n            fold = blended_calibration.fit(train_features, y[train], seed,\n                                           site_head=site_head, average=average,\n                                           network_mode=network_mode, network_replicas=network_replicas,\n                                           network_epochs=network_epochs)\n            tree_oof[held] = horizon_calibration.predict(fold['tree'], test_features)\n            network_oof[held] = neural_calibration.predict(fold['network'], test_features)\n            if use_replica_gap:\n                replica_gap_oof[held] = neural_calibration.replica_disagreement(\n                    fold['network'], test_features)\n        diffusion = None\n        if network_diffusion:\n            diffusion_graph = ('prediction' if network_diffusion in\n                               ('prediction', 'prediction_context',\n                                'prediction_context_smooth') else 'history')\n            diffusion = spatial_calibration.diffusion_fit(\n                features, network_oof,\n                robust=network_diffusion in ('context_smooth', 'prediction_context_smooth'),\n                graph_mode=diffusion_graph)\n            if network_diffusion in ('context', 'context_smooth',\n                                     'prediction_context', 'prediction_context_smooth'):\n                diffusion['pooling'] = 'context_normalize'\n            network_oof = spatial_calibration.diffusion_predict(diffusion, features, network_oof)\n        gate = _gate_fit(features, y, tree_oof, network_oof, mode=gate_mode,\n                         replica_gap=replica_gap_oof)\n        state = blended_calibration.fit(features, y, seed, site_head=site_head, average=average,\n                                        network_mode=network_mode, network_replicas=network_replicas,\n                                        network_epochs=network_epochs)\n        state['gate'] = gate\n        if diffusion is not None:\n            state['diffusion'] = diffusion\n        if residual_tree:\n            state['residual_tree'] = _residual_tree_fit(\n                features, y, tree_oof, network_oof, seed, gate_mode,\n                diffuse=(residual_tree if residual_tree in ('context', 'context_smooth')\n                         else residual_tree == 'diffused'))\n        if amplitude:\n            state['amplitude'] = _amplitude_fit(features, y, tree_oof, network_oof, gate)\n        if auxiliary_mode is not None:\n            state['aux_network'] = neural_calibration.fit(\n                features, y, seed, graph=state['tree']['pooled']['graph'], mode=auxiliary_mode)\n        return state\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=1):\n        tree = horizon_calibration.predict(state['tree'], features)\n        network = neural_calibration.predict(state['network'], features)\n        if 'aux_network' in state:\n            network = (network + neural_calibration.predict(state['aux_network'], features)) / 2\n        if 'diffusion' in state:\n            network = spatial_calibration.diffusion_predict(state['diffusion'], features, network)\n        replica_gap = (neural_calibration.replica_disagreement(state['network'], features)\n                       if state['gate'].get('mode') in ('site_replica_gap', 'site_replica_shared')\n                       else None)\n        blend = _blend(state['gate'], features, tree, network,\n                       state.get('amplitude'), replica_gap)\n        if 'residual_tree' in state:\n            blend = _residual_tree_predict(state['residual_tree'], features, tree, network, blend)\n        return blend.astype(np.float32)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/sh -lc \"sed -n '1,260p' /tmp/momentum_turn_validation.py\"","aggregated_output":"\"\"\"Observed-motion and expert-trajectory gate experiments.\"\"\"\nimport pickle\nimport time\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport conditional_calibration as c\nimport spatial_calibration as s\nimport research_validation as r\n\nROOT = '/tmp/forecast_turn_additive/'\nORIGINAL = c._design\nVARIANT = 'motion'\n\n\ndef extra(f, tree, network, variant):\n    base = np.asarray(f['base'], dtype=np.float64)\n    history = np.asarray(f['history'], dtype=np.float64)\n    anchor = np.asarray(f['anchor'], dtype=np.float64)\n    scale = np.maximum(np.mean(history, axis=1)[:, None, :], 30)\n    recent = history[:, -3:].mean(axis=1)[:, None, :]\n    last = history[:, -1:, :]\n    older = history[:, -6:-3].mean(axis=1)[:, None, :]\n    momentum = (recent - older) / 3\n    horizon = np.arange(1, base.shape[1] + 1)[None, :, None]\n    if variant == 'motion':\n        values = [np.clip((last - recent) / scale, -2, 2),\n                  np.clip(momentum / scale, -1, 1),\n                  np.clip((base - base[:, :1]) / scale, -2, 2),\n                  np.clip((anchor - anchor[:, :1]) / scale, -2, 2)]\n    elif variant in ('agreement', 'damped', 'anchor_motion', 'history_trend'):\n        persistence = np.broadcast_to(last, base.shape)\n        if variant == 'damped':\n            trend = last + horizon / (1 + horizon / 6) * momentum\n        elif variant == 'anchor_motion':\n            anchor_slope = np.mean(np.diff(anchor[:, :4], axis=1), axis=1)[:, None, :]\n            trend = (last + anchor - anchor[:, :1]\n                     + horizon / (1 + horizon / 6) * (momentum - anchor_slope))\n        elif variant == 'history_trend':\n            coordinate = np.arange(history.shape[1]) - (history.shape[1] - 1) / 2\n            slope = np.sum(history * coordinate[None, :, None], axis=1)[:, None, :] / np.sum(coordinate ** 2)\n            trend = last + horizon / (1 + horizon / 6) * slope\n        else:\n            trend = last + horizon * momentum\n        values = [np.clip((np.abs(tree - reference) - np.abs(network - reference)) / 20, -3, 3)\n                  for reference in [persistence, trend]]\n    elif variant == 'trajectory':\n        tree_trend = tree - tree[:, :1]\n        network_trend = network - network[:, :1]\n        observed_trend = horizon * momentum\n        values = [np.clip((np.abs(tree_trend - observed_trend)\n                           - np.abs(network_trend - observed_trend)) / 20, -3, 3),\n                  np.clip((network_trend - tree_trend) / 20, -3, 3)]\n    elif variant == 'local_agreement':\n        persistence = np.broadcast_to(last, base.shape)\n        values = [np.clip((np.abs(tree - persistence) - np.abs(network - persistence)) / 20, -3, 3),\n                  np.clip((np.abs(tree - anchor) - np.abs(network - anchor)) / 20, -3, 3),\n                  np.clip((np.abs(tree - recent) - np.abs(network - recent)) / 20, -3, 3)]\n    return np.stack([np.broadcast_to(v, base.shape) for v in values], axis=-1).reshape(-1, len(values))\n\n\ndef design(f, tree, network, mode='standard', context_graph=None, replica_gap=None):\n    return np.column_stack([ORIGINAL(f, tree, network, mode, context_graph, replica_gap),\n                            extra(f, tree, network, VARIANT)])\n\n\nif __name__ == '__main__':\n    start = time.monotonic()\n    with threadpool_limits(limits=1):\n        for split in ['last', 'middle', 'first']:\n            d = pickle.load(open(ROOT + split + '.additive', 'rb'))\n            q = d['q']\n            bounded = pickle.load(open(ROOT + split + '.graph', 'rb'))['robust_context']\n            print(split, 'control', r.mae(q['yv'], bounded['prediction']), flush=True)\n            output = {}\n            for VARIANT in ['damped', 'anchor_motion', 'history_trend']:\n                c._design = design\n                gate = c._gate_fit(q['ft'], q['yt'], q['to'], d['no'], mode='site_neighbor_horizon')\n                blend = c._blend(gate, q['fv'], q['tree'], d['nv'])\n                stage = c._residual_tree_fit(q['ft'], q['yt'], q['to'], d['no'], 17,\n                                             'site_neighbor_horizon', diffuse='context_smooth')\n                prediction = c._residual_tree_predict(stage, q['fv'], q['tree'], d['nv'], blend)\n                value = r.mae(q['yv'], prediction)\n                print(split, VARIANT, 'MAE', value, 'extra coef', gate['coef'][-extra(q['ft'], q['to'], d['no'], VARIANT).shape[1]:].tolist(),\n                      'wall', round(time.monotonic() - start, 1), flush=True)\n                output[VARIANT] = {'gate': gate, 'stage': stage, 'blend': blend,\n                                   'prediction': prediction, 'mae': value}\n            with open('/tmp/' + split + '.damped_turn', 'wb') as out:\n                pickle.dump(output, out)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/sh -lc \"sed -n '110,250p' spatial_calibration.py\"","aggregated_output":"    horizon = np.broadcast_to(np.linspace(-1, 1, shape[1])[None, :, None], shape)\n    x = np.stack([np.ones(shape), horizon, np.sin(2 * np.pi * clock),\n                  np.cos(2 * np.pi * clock), np.sin(4 * np.pi * clock),\n                  np.cos(4 * np.pi * clock)], axis=-1)\n    residual = prediction - features['base']\n    gram = np.einsum('shni,shnj->nij', x, x, optimize=True)\n    rhs = np.einsum('shni,shn->ni', x, residual, optimize=True)\n    ridge = np.diag([0, 1, 1, 1, 1, 1]) * shape[0] * shape[1] * 0.05\n    coef = np.linalg.solve(gram + ridge, rhs[..., None])[..., 0]\n    graph = (_prediction_neighborhood(features, prediction)\n             if graph_mode == 'prediction' else _neighborhood(features))\n    state = {'graph': graph, 'coef': coef.astype(np.float32), 'graph_mode': graph_mode}\n    if robust:\n        seasonal = np.einsum('shni,ni->shn', x, state['coef'])\n        normalized = (prediction - features['base'] - seasonal) / state['graph']['scale']\n        difference = (normalized[..., state['graph']['neighbors']]\n                      - normalized[..., None])\n        # A forecast-only scale for each sensor bounds the influence of large\n        # disagreements without fitting any additional target-dependent rule.\n        state['threshold'] = np.maximum(\n            3 * np.median(np.abs(difference), axis=(0, 1, 3)), 0.05)\n    return state\n\n\ndef diffusion_predict(state, features, prediction):\n    shape = features['base'].shape\n    clock = np.asarray(features['clock'], dtype=np.float64)\n    horizon = np.broadcast_to(np.linspace(-1, 1, shape[1])[None, :, None], shape)\n    x = np.stack([np.ones(shape), horizon, np.sin(2 * np.pi * clock),\n                  np.cos(2 * np.pi * clock), np.sin(4 * np.pi * clock),\n                  np.cos(4 * np.pi * clock)], axis=-1)\n    seasonal = np.einsum('shni,ni->shn', x, state['coef'])\n    innovation = prediction - features['base'] - seasonal\n    graph = state['graph']\n    normalized = innovation / graph['scale']\n    pooling = state.get('pooling', 'static')\n    if pooling == 'static':\n        neighbor = np.sum(normalized[..., graph['neighbors']] * graph['weights'], axis=-1)\n        neighbor *= graph['scale']\n        return np.maximum(features['base'] + seasonal + 0.75 * innovation + 0.25 * neighbor, 0)\n    # A fixed history graph can connect sensors experiencing different current\n    # deviations. Share changing corrections preferentially along edges whose\n    # known anchor/base and recent-history/base disagreements currently match.\n    scale = graph['scale']\n    neighbors = graph['neighbors']\n    anchor = (np.asarray(features['anchor']) - features['base']) / scale\n    recent = (np.mean(features['history'][:, -3:, :], axis=1)[:, None, :]\n              - features['base']) / scale\n    distance = ((anchor[..., neighbors] - anchor[..., None]) ** 2\n                + (recent[..., neighbors] - recent[..., None]) ** 2) / 2\n    affinity = 1 / (1 + distance)\n    weights = graph['weights'] * affinity\n    if pooling == 'context_normalize':\n        weights /= np.maximum(weights.sum(axis=-1, keepdims=True), 1e-8)\n    difference = normalized[..., neighbors] - normalized[..., None]\n    if 'threshold' in state:\n        threshold = state['threshold'][:, None]\n        difference = threshold * np.tanh(difference / threshold)\n    shared = normalized + 0.25 * np.sum(weights * difference, axis=-1)\n    return np.maximum(features['base'] + seasonal + shared * scale, 0)\n","exit_code":0,"status":"completed"}}

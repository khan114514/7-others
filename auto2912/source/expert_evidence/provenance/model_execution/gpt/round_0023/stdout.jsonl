{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/sh -lc \"sed -n '1,190p' /tmp/forecast_turn_additive/additive_validation.py\"","aggregated_output":"\"\"\"Smooth nonlinear calibration of honest OOF expert residuals.\"\"\"\nimport pickle\nimport time\nimport numpy as np\nfrom scipy.optimize import minimize\nfrom sklearn.preprocessing import SplineTransformer\nfrom threadpoolctl import threadpool_limits\nimport conditional_calibration as c\nimport spatial_calibration as s\nimport research_validation as r\nfrom temporal_validation import load\n\nROOT = '/tmp/forecast_turn_additive/'\n\n\ndef design(f, tree, network, blend):\n    raw = c._residual_tree_design(f, tree, network, blend)\n    return raw[:, [0, 2, 3, 4, 5]].astype(np.float64)\n\n\ndef fit(f, y, tree, network, blend, site=False):\n    valid = (np.isfinite(y) & (y > 0)).reshape(-1)\n    raw = design(f, tree, network, blend)\n    spline = SplineTransformer(n_knots=5, degree=2, knots='quantile',\n                               extrapolation='constant', include_bias=False)\n    spline.fit(raw[valid])\n    x = spline.transform(raw[valid])\n    center = x.mean(axis=0)\n    x = np.column_stack([np.ones(len(x)), x - center])\n    target = (y - blend).reshape(-1)[valid] / 20\n    nodes = y.shape[-1]\n    node = np.broadcast_to(np.arange(nodes), y.shape).reshape(-1)[valid]\n    gap = np.clip(raw[valid, 3] / 20, -3, 3)\n    basis = np.column_stack([np.ones(len(gap)), gap])\n    graph = s._neighborhood(f)\n    adjacency = np.zeros((nodes, nodes))\n    np.put_along_axis(adjacency, graph['neighbors'], graph['weights'], axis=1)\n    adjacency = (adjacency + adjacency.T) / 2\n    laplacian = np.diag(adjacency.sum(axis=1)) - adjacency\n    penalty = np.full(x.shape[1], .001)\n    penalty[0] = .0001\n\n    def objective(coef):\n        global_coef = coef[:x.shape[1]]\n        output = x @ global_coef\n        if site:\n            site_coef = coef[x.shape[1]:].reshape(nodes, 2)\n            centered = site_coef - site_coef.mean(axis=0)\n            output += np.sum(centered[node] * basis, axis=1)\n        error = output - target\n        smooth = np.sqrt(error * error + .01)\n        derivative = error / smooth\n        value = smooth.mean() + .5 * np.sum(penalty * global_coef ** 2)\n        gradient = x.T @ derivative / len(x) + penalty * global_coef\n        if site:\n            regularizer = .02 * site_coef + .05 * (laplacian @ site_coef)\n            sg = np.column_stack([np.bincount(node, weights=derivative * basis[:, j],\n                                             minlength=nodes) for j in range(2)]) / len(x)\n            sg -= sg.mean(axis=0)\n            sg += regularizer / nodes\n            value += np.sum(site_coef * regularizer) / (2 * nodes)\n            gradient = np.r_[gradient, sg.reshape(-1)]\n        return value, gradient\n\n    count = x.shape[1] + (nodes * 2 if site else 0)\n    result = minimize(objective, np.zeros(count), jac=True, method='L-BFGS-B',\n                      options={'maxiter': 100, 'ftol': 1e-10})\n    state = {'spline': spline, 'center': center, 'coef': result.x[:x.shape[1]],\n             'iterations': result.nit, 'success': result.success}\n    if site:\n        co = result.x[x.shape[1]:].reshape(nodes, 2)\n        state['site'] = co - co.mean(axis=0)\n    return state\n\n\ndef predict(state, f, tree, network, blend):\n    raw = design(f, tree, network, blend)\n    x = np.column_stack([np.ones(len(raw)), state['spline'].transform(raw) - state['center']])\n    correction = (x @ state['coef']).reshape(blend.shape) * 20\n    if 'site' in state:\n        correction += 20 * (state['site'][None, None, :, 0]\n                            + state['site'][None, None, :, 1]\n                            * np.clip((network - tree) / 20, -3, 3))\n    return np.clip(correction, -10, 10)\n\n\nif __name__ == '__main__':\n    start = time.monotonic()\n    with threadpool_limits(limits=1):\n        for split in ['last', 'middle', 'first']:\n            q, raw_o, raw_v = load(split)\n            diffusion = s.diffusion_fit(q['ft'], raw_o)\n            no = s.diffusion_predict(diffusion, q['ft'], raw_o)\n            nv = s.diffusion_predict(diffusion, q['fv'], raw_v)\n            gate = c._gate_fit(q['ft'], q['yt'], q['to'], no, mode='site_neighbor_horizon')\n            blend = c._blend(gate, q['fv'], q['tree'], nv)\n            oo = np.empty_like(q['yt'])\n            index = np.arange(len(q['yt']))\n            for held in np.array_split(index, 3):\n                keep = np.setdiff1d(index, held)\n                inner = c._gate_fit(r.subset(q['ft'], keep), q['yt'][keep],\n                                    q['to'][keep], no[keep], mode='site_neighbor_horizon')\n                oo[held] = c._blend(inner, r.subset(q['ft'], held), q['to'][held], no[held])\n            stage = c._residual_tree_fit(q['ft'], q['yt'], q['to'], no, 17,\n                                        'site_neighbor_horizon', diffuse=True)\n            control = c._residual_tree_predict(stage, q['fv'], q['tree'], nv, blend)\n            print(split, 'static control', r.mae(q['yv'], control), flush=True)\n            outputs = {'q': q, 'no': no, 'nv': nv, 'oo': oo, 'blend': blend,\n                       'diffusion': diffusion, 'gate': gate, 'stage': stage, 'control': control}\n            for mode in ['shared', 'site']:\n                model = fit(q['ft'], q['yt'], q['to'], no, oo, site=mode == 'site')\n                correction = predict(model, q['fv'], q['tree'], nv, blend)\n                ds = s.diffusion_fit(q['ft'], q['ft']['base'] + predict(model, q['ft'], q['to'], no, oo))\n                diffused = s.diffusion_predict(ds, q['fv'], q['fv']['base'] + correction) - q['fv']['base']\n                for variant, cr in [('raw', correction), ('diffused', diffused)]:\n                    prediction = np.maximum(blend + cr, 0)\n                    ensemble = (prediction + control) / 2\n                    outputs[mode, variant] = {'model': model, 'prediction': prediction,\n                                             'ensemble': ensemble, 'diffusion': ds}\n                    print(split, mode, variant, 'MAE', r.mae(q['yv'], prediction),\n                          'ensemble', r.mae(q['yv'], ensemble), 'iter', model['iterations'],\n                          'wall', round(time.monotonic() - start, 1), flush=True)\n            with open(ROOT + split + '.additive', 'wb') as out:\n                pickle.dump(outputs, out)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/sh -lc 'cat /tmp/forecast_turn_additive/cache_check.py'","aggregated_output":"import importlib.machinery\nimport importlib.util\nimport time\nimport numpy as np\nimport neural_calibration as n\nimport research_validation as r\nfrom threadpoolctl import threadpool_limits\n\nloader = importlib.machinery.SourceFileLoader('old_neural', '/tmp/forecast_turn_additive/neural.initial')\nspec = importlib.util.spec_from_loader(loader.name, loader)\nold = importlib.util.module_from_spec(spec)\nloader.exec_module(old)\nf, y = r.load()\nwith threadpool_limits(limits=1):\n    start = time.monotonic()\n    a = old.fit(f, y, 17, epochs=3, site_head='graph')\n    old_time = time.monotonic() - start\n    start = time.monotonic()\n    b = n.fit(f, y, 17, epochs=3, site_head='graph')\n    new_time = time.monotonic() - start\n    print('parameter maxdiff', max(np.max(np.abs(a['params'][k] - b['params'][k]))\n                                   for k in a['params']),\n          'prediction maxdiff', np.max(np.abs(old.predict(a, f) - n.predict(b, f))),\n          'old wall', old_time, 'new wall', new_time, flush=True)\n","exit_code":0,"status":"completed"}}

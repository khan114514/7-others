{"type":"item.completed","item":{"id":"item_107","type":"command_execution","command":"/bin/sh -lc \"sed -n '1,200p' /tmp/forecast_turn_graph/replica_gate_validation.py\"","aggregated_output":"import pickle\nimport time\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport conditional_calibration as c\nimport horizon_calibration as h\nimport neural_calibration as n\nimport research_validation as r\n\nf, y = r.load()\nstart = time.monotonic()\nwith threadpool_limits(limits=1):\n    for split in ['last', 'middle']:\n        prefix = '/tmp/forecast_turn_graph/' + split\n        with open(prefix + '.baseline', 'rb') as inp:\n            cache = pickle.load(inp)\n        train, test = cache['train'], cache['test']\n        ft, fv = r.subset(f, train), r.subset(f, test)\n        with open(prefix + '.tree_oof', 'rb') as inp:\n            tree_oof = pickle.load(inp)['prediction']\n        with open(prefix + '.replicas', 'rb') as inp:\n            ensemble = pickle.load(inp)\n        with open(prefix + '.network_oof.graph', 'rb') as inp:\n            network_oof = pickle.load(inp)\n        gap_oof = np.abs(network_oof - ensemble['extra_oof'])\n        tree = h.predict(cache['state']['tree'], fv)\n        pred = n.predict(ensemble['network'], fv)\n        gap = n.replica_disagreement(ensemble['network'], fv)\n        print(split, 'ensemble control', r.mae(y[test], ensemble['site_neighbor_horizon']['prediction']), flush=True)\n        output = {}\n        for mode in ['site_replica_shared', 'site_replica_gap']:\n            gate = c._gate_fit(ft, y[train], tree_oof, ensemble['network_oof'],\n                              mode=mode, replica_gap=gap_oof)\n            blend = c._blend(gate, fv, tree, pred, replica_gap=gap)\n            print(split, mode, 'MAE', r.mae(y[test], blend), 'elapsed',\n                  round(time.monotonic() - start, 2), flush=True)\n            output[mode] = {'gate': gate, 'prediction': blend}\n        with open(prefix + '.replica_gate', 'wb') as out:\n            pickle.dump(output, out)\n","exit_code":0,"status":"completed"}}

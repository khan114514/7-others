{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/sh -lc 'cat /tmp/prediction_graph_cached4.py /tmp/prediction_graph_mix.py'","aggregated_output":"import pickle, time, numpy as np, sys\nfrom threadpoolctl import threadpool_limits\nimport conditional_calibration as c\nimport spatial_calibration as s\nimport neural_calibration as n\nimport research_validation as r\nROOT='/tmp/forecast_turn_additive/'\nstart=time.monotonic()\nwith threadpool_limits(limits=1):\n  for split in ['last','middle','first']:\n    d=pickle.load(open(ROOT+split+'.additive','rb')); q=d['q']; ft=q['ft']; fv=q['fv']; y=q['yt'];\n    tree=q['tree']; to=q['to']; raw_v=q['network']\n    if split=='first': raw_o=q['network_oof']\n    else: raw_o=pickle.load(open('/tmp/forecast_turn_graph/'+split+'.budget_replica','rb'))['network_oof']\n    print(split,'raw vs cached no',np.mean(abs(raw_o-q['no'])), 'oldcontrol',r.mae(q['yv'],d['control']),flush=True)\n    for gm in ['history','prediction']:\n      diff=s.diffusion_fit(ft,raw_o,robust=False,graph_mode=gm)\n      no2=s.diffusion_predict(diff,ft,raw_o); nv2=s.diffusion_predict(diff,fv,raw_v)\n      gate=c._gate_fit(ft,y,to,no2,mode='site_history_trend')\n      blend=c._blend(gate,fv,tree,nv2)\n      stage=c._residual_tree_fit(ft,y,to,no2,17,'site_history_trend',diffuse='context_smooth')\n      pred=c._residual_tree_predict(stage,fv,tree,nv2,blend)\n      print(split,gm,'MAE',r.mae(q['yv'],pred),'network',r.mae(q['yv'],nv2),'OOFdiff',float(np.mean(np.abs(no2-raw_o))), 'elapsed',round(time.monotonic()-start,1),flush=True)\nimport pickle,time,numpy as np\nfrom threadpoolctl import threadpool_limits\nimport conditional_calibration as c\nimport spatial_calibration as s\nimport research_validation as r\nROOT='/tmp/forecast_turn_additive/'\nstart=time.monotonic()\nwith threadpool_limits(limits=1):\n for split in ['last','middle','first']:\n  d=pickle.load(open(ROOT+split+'.additive','rb'));q=d['q'];ft=q['ft'];fv=q['fv'];y=q['yt'];tree=q['tree'];to=q['to'];raw_v=q['network']\n  if split=='first': raw_o=q['network_oof']\n  else: raw_o=pickle.load(open('/tmp/forecast_turn_graph/'+split+'.budget_replica','rb'))['network_oof']\n  dh=s.diffusion_fit(ft,raw_o,robust=False,graph_mode='history'); dp=s.diffusion_fit(ft,raw_o,robust=False,graph_mode='prediction')\n  oh=s.diffusion_predict(dh,ft,raw_o); vh=s.diffusion_predict(dh,fv,raw_v)\n  op=s.diffusion_predict(dp,ft,raw_o); vp=s.diffusion_predict(dp,fv,raw_v)\n  print(split,'old',r.mae(q['yv'],d['control']),flush=True)\n  for a in [0,.1,.2,.35,.5,1.0]:\n   no=(1-a)*oh+a*op; nv=(1-a)*vh+a*vp\n   gate=c._gate_fit(ft,y,to,no,mode='site_history_trend');blend=c._blend(gate,fv,tree,nv)\n   stage=c._residual_tree_fit(ft,y,to,no,17,'site_history_trend',diffuse='context_smooth')\n   pred=c._residual_tree_predict(stage,fv,tree,nv,blend)\n   print(split,'mix',a,'MAE',r.mae(q['yv'],pred),'net',r.mae(q['yv'],nv),'elapsed',round(time.monotonic()-start,1),flush=True)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/sh -lc \"sed -n '1,220p' /tmp/forecast_turn_periodic/temporal_validation.py\"","aggregated_output":"\"\"\"Calibration-only test of seasonal-preserving horizon diffusion.\"\"\"\nimport pickle\nimport time\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport conditional_calibration as c\nimport spatial_calibration as s\nimport neural_calibration as n\nimport research_validation as r\n\nROOT = '/tmp/forecast_turn_adaptive/'\nOUT = '/tmp/forecast_turn_periodic/'\noriginal_predict = s.diffusion_predict\n\n\ndef temporal_predict(state, features, prediction):\n    value = original_predict(state, features, prediction)\n    if not state.get('temporal'):\n        return value\n    shape = features['base'].shape\n    clock = np.asarray(features['clock'], dtype=np.float64)\n    horizon = np.broadcast_to(np.linspace(-1, 1, shape[1])[None, :, None], shape)\n    x = np.stack([np.ones(shape), horizon, np.sin(2 * np.pi * clock),\n                  np.cos(2 * np.pi * clock), np.sin(4 * np.pi * clock),\n                  np.cos(4 * np.pi * clock)], axis=-1)\n    seasonal = np.einsum('shni,ni->shn', x, state['coef'])\n    innovation = value - features['base'] - seasonal\n    # Reflect at the endpoints; corrections, rather than the upstream\n    # trajectory, share the fixed horizon-chain diffusion operator.\n    previous = np.concatenate([innovation[:, :1], innovation[:, :-1]], axis=1)\n    following = np.concatenate([innovation[:, 1:], innovation[:, -1:]], axis=1)\n    innovation = innovation + 0.25 * (previous + following - 2 * innovation)\n    return np.maximum(features['base'] + seasonal + innovation, 0)\n\n\ndef load(split):\n    if split == 'first':\n        with open(ROOT + 'first.cache', 'rb') as inp:\n            q = pickle.load(inp)\n        return q, q['network_oof'], q['network']\n    with open('/tmp/forecast_turn_residual/' + split + '.cache', 'rb') as inp:\n        q = pickle.load(inp)\n    with open('/tmp/forecast_turn_graph/' + split + '.budget_replica', 'rb') as inp:\n        ensemble = pickle.load(inp)\n    return q, ensemble['network_oof'], n.predict(ensemble['network'], q['fv'])\n\n\nif __name__ == '__main__':\n    started = time.monotonic()\n    s.diffusion_predict = temporal_predict\n    with threadpool_limits(limits=1):\n        for split in ['last', 'middle', 'first']:\n            q, raw_o, raw_v = load(split)\n            outputs = {}\n            for mode in ['control', 'network', 'residual', 'both']:\n                diffusion = s.diffusion_fit(q['ft'], raw_o, robust=True)\n                diffusion['pooling'] = 'context_normalize'\n                diffusion['temporal'] = mode in ('network', 'both')\n                no = s.diffusion_predict(diffusion, q['ft'], raw_o)\n                nv = s.diffusion_predict(diffusion, q['fv'], raw_v)\n                gate = c._gate_fit(q['ft'], q['yt'], q['to'], no,\n                                   mode='site_neighbor_horizon')\n                blend = c._blend(gate, q['fv'], q['tree'], nv)\n                stage = c._residual_tree_fit(q['ft'], q['yt'], q['to'], no, 17,\n                                            'site_neighbor_horizon', diffuse='context')\n                stage['diffusion']['temporal'] = mode in ('residual', 'both')\n                prediction = c._residual_tree_predict(stage, q['fv'], q['tree'], nv, blend)\n                outputs[mode] = {'prediction': prediction, 'mae': r.mae(q['yv'], prediction),\n                                 'diffusion': diffusion, 'gate': gate, 'stage': stage}\n                print(split, mode, 'MAE', outputs[mode]['mae'],\n                      'wall', round(time.monotonic() - started, 1), flush=True)\n            with open(OUT + split + '.temporal', 'wb') as out:\n                pickle.dump(outputs, out)\n","exit_code":0,"status":"completed"}}

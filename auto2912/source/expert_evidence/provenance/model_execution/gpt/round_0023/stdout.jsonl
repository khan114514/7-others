{"type":"item.completed","item":{"id":"item_101","type":"command_execution","command":"/bin/sh -lc \"sed -n '1,180p' /tmp/forecast_turn_additive/latent_validation.py\"","aggregated_output":"\"\"\"Low-rank network-wide context for median residual-field correction.\"\"\"\nimport pickle\nimport time\nimport numpy as np\nfrom sklearn.decomposition import PCA\nfrom threadpoolctl import threadpool_limits\nimport spatial_calibration as s\nimport research_validation as r\n\nROOT = '/tmp/forecast_turn_additive/'\n\n\ndef raw_features(f, scale):\n    base = f['base']\n    recent = np.mean(f['history'][:, -3:], axis=1)[:, None, :]\n    return np.concatenate([np.clip((f['anchor'] - base) / scale, -3, 3),\n                           np.clip((recent - base) / scale, -3, 3)], axis=-1).reshape(-1, 2 * len(scale))\n\n\ndef design(state, f):\n    z = state['pca'].transform(raw_features(f, state['scale']))\n    z = np.clip(z, -4, 4)\n    clock = np.asarray(f['clock'][:, :, 0], dtype=np.float64).reshape(-1)\n    horizon = np.broadcast_to(np.linspace(-1, 1, f['base'].shape[1]),\n                               f['base'].shape[:2]).reshape(-1)\n    return np.column_stack([np.ones(len(z)), z, horizon,\n                            np.sin(2 * np.pi * clock), np.cos(2 * np.pi * clock),\n                            np.sin(4 * np.pi * clock), np.cos(4 * np.pi * clock)])\n\n\ndef fit(f, y, blend):\n    scale = s._neighborhood(f)['scale']\n    pca = PCA(n_components=8, whiten=True, svd_solver='full')\n    pca.fit(raw_features(f, scale))\n    state = {'pca': pca, 'scale': scale}\n    x = design(state, f)\n    target = (y - blend).reshape(-1, y.shape[-1]) / 20\n    valid = (np.isfinite(y) & (y > 0)).reshape(target.shape)\n    target = np.where(valid, target, 0).astype(np.float64)\n    penalty = np.eye(x.shape[1]) * .05\n    penalty[0, 0] = .02\n    coef = np.zeros((y.shape[-1], x.shape[1]))\n    for _ in range(12):\n        error = x @ coef.T - target\n        weight = valid / np.sqrt(error * error + .01)\n        gram = np.einsum('si,sn,sj->nij', x, weight, x, optimize=True)\n        rhs = np.einsum('si,sn,sn->ni', x, weight, target, optimize=True)\n        coef = np.linalg.solve(gram + len(x) * penalty, rhs[..., None])[..., 0]\n    state['coef'] = coef\n    return state\n\n\ndef predict(state, f):\n    return np.clip((design(state, f) @ state['coef'].T).reshape(f['base'].shape) * 20, -10, 10)\n\n\nif __name__ == '__main__':\n    start = time.monotonic()\n    with threadpool_limits(limits=1):\n        for split in ['last', 'middle', 'first']:\n            with open(ROOT + split + '.additive', 'rb') as inp:\n                cache = pickle.load(inp)\n            q = cache['q']\n            model = fit(q['ft'], q['yt'], cache['oo'])\n            correction = predict(model, q['fv'])\n            ds = s.diffusion_fit(q['ft'], q['ft']['base'] + predict(model, q['ft']))\n            shared = s.diffusion_predict(ds, q['fv'], q['fv']['base'] + correction) - q['fv']['base']\n            outputs = {}\n            for mode, cr in [('raw', correction), ('diffused', shared)]:\n                prediction = np.maximum(cache['blend'] + cr, 0)\n                ensemble = (prediction + cache['control']) / 2\n                outputs[mode] = {'prediction': prediction, 'ensemble': ensemble,\n                                 'model': model, 'diffusion': ds}\n                print(split, 'latent', mode, 'MAE', r.mae(q['yv'], prediction),\n                      'ensemble', r.mae(q['yv'], ensemble),\n                      'wall', round(time.monotonic() - start, 1), flush=True)\n            with open(ROOT + split + '.latent', 'wb') as out:\n                pickle.dump(outputs, out)\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/sh -lc 'cat horizon_calibration.py'","aggregated_output":"\"\"\"Partial pooling of median residual trees specialized by forecast horizon.\"\"\"\nimport numpy as np\nfrom sklearn.ensemble import HistGradientBoostingRegressor\nfrom threadpoolctl import threadpool_limits\nimport spatial_calibration\n\n\ndef _model(seed):\n    return HistGradientBoostingRegressor(\n        loss='absolute_error', max_iter=90, learning_rate=0.06,\n        max_leaf_nodes=15, min_samples_leaf=250, l2_regularization=20,\n        categorical_features=[14], early_stopping=False, random_state=seed)\n\n\ndef fit(features, targets, seed, groups=3, graph=None):\n    with threadpool_limits(limits=2):\n        pooled = spatial_calibration.fit(features, targets, seed, graph=graph)\n        x = spatial_calibration._features(features, pooled['graph'])\n        shape = features['base'].shape\n        x = x.reshape(*shape, -1)\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets)\n        valid = np.isfinite(y) & (y > 0)\n        residual = y - np.asarray(features['base'])\n        models = []\n        for horizons in np.array_split(np.arange(shape[1]), groups):\n            xx = x[:, horizons].reshape(-1, x.shape[-1])\n            ok = valid[:, horizons].reshape(-1)\n            yy = residual[:, horizons].reshape(-1)\n            model = _model(seed)\n            model.fit(xx[ok], yy[ok])\n            models.append((horizons, model))\n        return {'pooled': pooled, 'models': models, 'expert_weight': 0.5}\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=2):\n        shape = features['base'].shape\n        x = spatial_calibration._features(features, state['pooled']['graph']).reshape(*shape, -1)\n        expert = np.zeros(shape, dtype=np.float32)\n        for horizons, model in state['models']:\n            expert[:, horizons] = model.predict(x[:, horizons].reshape(-1, x.shape[-1])).reshape(shape[0], len(horizons), shape[2])\n        pooled = state['pooled']['model'].predict(x.reshape(-1, x.shape[-1])).reshape(shape)\n        weight = state['expert_weight']\n        correction = pooled * (1 - weight) + expert * weight\n        return np.maximum(np.asarray(features['base']) + correction, 0).astype(np.float32)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/sh -lc 'cat spatial_calibration.py'","aggregated_output":"\"\"\"Median residual trees with neighborhoods learned from calibration history.\"\"\"\nimport numpy as np\nfrom sklearn.ensemble import HistGradientBoostingRegressor\nfrom threadpoolctl import threadpool_limits\nimport tree_calibration\n\n\ndef _neighborhood(features, count=8):\n    history = np.asarray(features['history'], dtype=np.float64)\n    changes = np.diff(history, axis=1).reshape(-1, history.shape[2])\n    changes -= np.mean(changes, axis=0)\n    scale = np.maximum(np.std(history.reshape(-1, history.shape[2]), axis=0), 10)\n    norm = np.sqrt(np.sum(changes * changes, axis=0))\n    correlation = (changes.T @ changes) / np.maximum(norm[:, None] * norm[None, :], 1)\n    np.fill_diagonal(correlation, -1)\n    neighbors = np.argsort(correlation, axis=1)[:, -count:]\n    weights = np.maximum(np.take_along_axis(correlation, neighbors, axis=1), 0) ** 2\n    weights /= np.maximum(weights.sum(axis=1, keepdims=True), 1e-8)\n    return {'neighbors': neighbors, 'weights': weights.astype(np.float32),\n            'scale': scale.astype(np.float32)}\n\n\ndef _features(features, graph, variant='neighbors'):\n    x = tree_calibration._features(features)\n    base = np.asarray(features['base'], dtype=np.float32)\n    anchor = np.asarray(features['anchor'], dtype=np.float32)\n    history = np.asarray(features['history'], dtype=np.float32)\n    scale = graph['scale']\n    def aggregate(value):\n        normalized = value / scale\n        mean = np.sum(normalized[..., graph['neighbors']] * graph['weights'], axis=-1)\n        return mean * scale\n    recent = np.mean(history[:, -3:, :], axis=1)[:, None, :]\n    older = np.mean(history[:, :3, :], axis=1)[:, None, :]\n    last = history[:, -1:, :]\n    spread = np.std(history, axis=1)[:, None, :]\n    extra = [aggregate(anchor - base), aggregate(recent - base),\n             aggregate(last - base), np.broadcast_to(aggregate(recent - older), base.shape),\n             np.broadcast_to(aggregate(spread), base.shape)]\n    if variant == 'relative':\n        extra.extend([(anchor - base) / scale, (recent - base) / scale,\n                      np.broadcast_to(spread / scale, base.shape),\n                      base / np.maximum(anchor, 30),\n                      aggregate(anchor - base) - (anchor - base)])\n    if 'physical' in graph:\n        def physical(value):\n            return ((value / scale) @ graph['physical'].T) * scale\n        extra.extend([physical(anchor - base), physical(recent - base),\n                      physical(last - base),\n                      np.broadcast_to(physical(recent - older), base.shape),\n                      np.broadcast_to(physical(spread), base.shape)])\n    return np.column_stack([x] + [v.reshape(-1) for v in extra])\n\n\ndef fit(features, targets, seed, variant='neighbors', max_iter=90, graph=None):\n    with threadpool_limits(limits=2):\n        if graph is None:\n            graph = _neighborhood(features)\n        x = _features(features, graph, variant)\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets)\n        valid = np.isfinite(y) & (y > 0)\n        residual = y - np.asarray(features['base'])\n        model = HistGradientBoostingRegressor(\n            loss='absolute_error', max_iter=max_iter, learning_rate=0.06,\n            max_leaf_nodes=15, min_samples_leaf=250, l2_regularization=20,\n            categorical_features=[14], early_stopping=False, random_state=seed)\n        model.fit(x[valid.ravel()], residual[valid])\n        return {'graph': graph, 'variant': variant, 'model': model}\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=2):\n        x = _features(features, state['graph'], state['variant'])\n        residual = state['model'].predict(x).reshape(features['base'].shape)\n        return np.maximum(np.asarray(features['base']) + residual, 0).astype(np.float32)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/sh -lc 'cat /tmp/forecast_turn_graph/matching_validation.py /tmp/forecast_turn_graph/head_validation.py /tmp/forecast_turn_graph/site_gate_validation.py'","aggregated_output":"import pickle,time,sys\nimport numpy as np\nimport conditional_calibration as c\nimport neural_calibration as n\nimport horizon_calibration as h\nimport research_validation as r\nfrom threadpoolctl import threadpool_limits\nf,y=r.load()\nstart=time.monotonic()\nmodes=sys.argv[1:] or ['trend','graph']\nwith threadpool_limits(limits=2):\n for split in ['last','middle']:\n  with open('/tmp/forecast_turn_graph/'+split+'.baseline','rb') as inp: cache=pickle.load(inp)\n  train,test=cache['train'],cache['test']\n  ft,fv=r.subset(f,train),r.subset(f,test)\n  yt=y[train]\n  base_state=cache['state']\n  tree=h.predict(base_state['tree'],fv)\n  folds=[]\n  tree_oof=np.empty_like(yt)\n  for held in np.array_split(np.arange(len(yt)),3):\n   keep=np.setdiff1d(np.arange(len(yt)),held)\n   ff,fh=r.subset(ft,keep),r.subset(ft,held)\n   tt=h.fit(ff,yt[keep],17,groups=2)\n   tree_oof[held]=h.predict(tt,fh)\n   folds.append((held,keep,tt['pooled']['graph']))\n  with open('/tmp/forecast_turn_graph/'+split+'.tree_oof','wb') as out: pickle.dump({'prediction':tree_oof,'folds':folds},out)\n  for mode in modes:\n   with open('/tmp/forecast_turn_graph/'+split+'.'+mode,'rb') as inp: head_cache=pickle.load(inp)\n   network_oof=np.empty_like(yt)\n   for held,keep,graph in folds:\n    network=n.fit(r.subset(ft,keep),yt[keep],17,graph=graph,site_head=mode)\n    network_oof[held]=n.predict(network,r.subset(ft,held))\n   with open('/tmp/forecast_turn_graph/'+split+'.network_oof.'+mode,'wb') as out: pickle.dump(network_oof,out)\n   gate=c._gate_fit(ft,yt,tree_oof,network_oof)\n   pred=n.predict(head_cache['network'],fv)\n   weight=c._weight(gate,fv,tree,pred)\n   blend=tree+weight*(pred-tree)\n   print('matching',mode,split,'MAE',r.mae(y[test],blend),'gate',gate['coef'].tolist(),'elapsed',time.monotonic()-start,flush=True)\n   with open('/tmp/forecast_turn_graph/'+split+'.matching.'+mode,'wb') as out:pickle.dump({'gate':gate,'prediction':blend},out)\nimport pickle,time\nimport numpy as np\nimport conditional_calibration as c\nimport neural_calibration as n\nimport horizon_calibration as h\nimport research_validation as r\nfrom threadpoolctl import threadpool_limits\nf,y=r.load()\nstart=time.monotonic()\nwith threadpool_limits(limits=2):\n for split in ['last','middle']:\n  with open('/tmp/forecast_turn_graph/'+split+'.baseline','rb') as inp: cache=pickle.load(inp)\n  train,test=cache['train'],cache['test']\n  ft,fv=r.subset(f,train),r.subset(f,test)\n  base_state=cache['state']\n  tree=h.predict(base_state['tree'],fv)\n  for mode in ['trend','graph']:\n   network=n.fit(ft,y[train],17,graph=base_state['tree']['pooled']['graph'],site_head=mode)\n   pred=n.predict(network,fv)\n   weight=c._weight(base_state['gate'],fv,tree,pred)\n   blend=tree+weight*(pred-tree)\n   train_pred=n.predict(network,ft)\n   print(mode,split,'blend_mae',r.mae(y[test],blend),'network_mae',r.mae(y[test],pred),'train_network_mae',r.mae(y[train],train_pred),'network_fit_s',network['fit_seconds'],'elapsed',time.monotonic()-start,flush=True)\n   with open('/tmp/forecast_turn_graph/'+split+'.'+mode,'wb') as out:pickle.dump({'network':network,'prediction':blend},out)\nimport pickle\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport conditional_calibration as c\nimport neural_calibration as n\nimport horizon_calibration as h\nimport research_validation as r\n\nf, y = r.load()\nwith threadpool_limits(limits=2):\n    for split in ['last', 'middle']:\n        with open('/tmp/forecast_turn_graph/' + split + '.baseline', 'rb') as inp:\n            cache = pickle.load(inp)\n        train, test = cache['train'], cache['test']\n        ft, fv = r.subset(f, train), r.subset(f, test)\n        with open('/tmp/forecast_turn_graph/' + split + '.tree_oof', 'rb') as inp:\n            tree_oof = pickle.load(inp)['prediction']\n        with open('/tmp/forecast_turn_graph/' + split + '.network_oof.graph', 'rb') as inp:\n            network_oof = pickle.load(inp)\n        with open('/tmp/forecast_turn_graph/' + split + '.graph', 'rb') as inp:\n            network = pickle.load(inp)['network']\n        tree, pred = h.predict(cache['state']['tree'], fv), n.predict(network, fv)\n        for mode in ['site_context_signed']:\n            gate = c._gate_fit(ft, y[train], tree_oof, network_oof, mode=mode)\n            blend = tree + c._weight(gate, fv, tree, pred) * (pred - tree)\n            print(split, mode, 'MAE', r.mae(y[test], blend),\n                  'site range', np.percentile(gate.get('site', np.zeros(1)), [0, 50, 100]), flush=True)\n            with open('/tmp/forecast_turn_graph/' + split + '.hierarchical.' + mode, 'wb') as out:\n                pickle.dump({'gate': gate, 'prediction': blend}, out)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/sh -lc 'cat blended_calibration.py'","aggregated_output":"\"\"\"Horizon-specific median trees blended with a smooth residual network.\"\"\"\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport horizon_calibration\nimport neural_calibration\n\n\ndef fit(features, targets, seed, graph=None, network_mode='summary', auxiliary_mode=None,\n        site_head=False, average=False):\n    with threadpool_limits(limits=2):\n        state = {'tree': horizon_calibration.fit(features, targets, seed, groups=2, graph=graph),\n                'network': neural_calibration.fit(features, targets, seed, graph=graph, mode=network_mode,\n                                                  site_head=site_head, average=average),\n                # The smooth model is more useful at longer horizons on both\n                # public origin blocks; keep a conservative horizon schedule.\n                'network_weight': np.where(np.arange(features['base'].shape[1]) < 6,\n                                           0.18, 0.32).astype(np.float32)}\n        if auxiliary_mode is not None:\n            state['aux_network'] = neural_calibration.fit(\n                features, targets, seed, graph=state['tree']['pooled']['graph'], mode=auxiliary_mode)\n        return state\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=2):\n        tree = horizon_calibration.predict(state['tree'], features)\n        network = neural_calibration.predict(state['network'], features)\n        if 'aux_network' in state:\n            network = (network + neural_calibration.predict(state['aux_network'], features)) / 2\n        weight = np.asarray(state.get('network_weight', 0.25), dtype=np.float32)\n        return (tree * (1.0 - weight[None, :, None]) +\n                network * weight[None, :, None]).astype(np.float32)\n","exit_code":0,"status":"completed"}}

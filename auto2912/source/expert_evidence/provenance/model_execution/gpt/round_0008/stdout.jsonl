{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/sh -lc 'cat neural_calibration.py'","aggregated_output":"\"\"\"Small NumPy residual network trained with a smooth absolute-error objective.\"\"\"\nimport time\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport spatial_calibration\n\n\ndef _features(features, graph, mode='summary'):\n    raw = spatial_calibration._features(features, graph)\n    node = raw[:, 14].astype(np.int64)\n    clock = np.asarray(features['clock']).reshape(-1)\n    periodic = [np.sin(2 * np.pi * clock), np.cos(2 * np.pi * clock),\n                np.sin(4 * np.pi * clock), np.cos(4 * np.pi * clock)]\n    columns = [np.delete(raw, 14, axis=1)] + periodic\n    if mode in ('history', 'relative'):\n        base = np.asarray(features['base'], dtype=np.float32)\n        history = np.asarray(features['history'], dtype=np.float32)\n        recent = np.mean(history[:, -3:, :], axis=1)[:, None, :]\n        # The shared network can learn a temporal filter rather than relying\n        # only on fixed three/six-step averages and one trend statistic.\n        columns += [np.broadcast_to(history[:, j:j+1, :] - recent, base.shape).reshape(-1)\n                    for j in range(history.shape[1])]\n        columns += [(base[:, :1, :] - base).reshape(-1),\n                    (base[:, -1:, :] - base).reshape(-1)]\n        if mode == 'relative':\n            anchor = np.asarray(features['anchor'], dtype=np.float32)\n            scale = graph['scale']\n            columns += [np.broadcast_to(scale, base.shape).reshape(-1),\n                        (base / scale).reshape(-1),\n                        ((anchor - base) / scale).reshape(-1),\n                        ((recent - base) / scale).reshape(-1)]\n    return np.column_stack(columns), node\n\n\ndef _head_features(features, mode=True):\n    shape = features['base'].shape\n    clock = np.asarray(features['clock'], dtype=np.float32).reshape(-1)\n    horizon = np.broadcast_to(np.linspace(-1, 1, shape[1])[None, :, None], shape).reshape(-1)\n    if mode == 'trend':\n        return np.column_stack([np.ones_like(clock), horizon]).astype(np.float32)\n    columns = [np.ones_like(clock), horizon,\n               np.sin(2 * np.pi * clock), np.cos(2 * np.pi * clock),\n               np.sin(4 * np.pi * clock), np.cos(4 * np.pi * clock)]\n    if mode == 'innovation':\n        base = np.asarray(features['base'], dtype=np.float32)\n        anchor = np.asarray(features['anchor'], dtype=np.float32)\n        history = np.asarray(features['history'], dtype=np.float32)\n        scale = np.maximum(np.mean(history, axis=1)[:, None, :], 30)\n        recent = np.mean(history[:, -3:, :], axis=1)[:, None, :]\n        last = history[:, -1:, :]\n        columns.extend([np.clip((anchor - base) / scale, -1.5, 1.5).reshape(-1),\n                        np.clip((recent - base) / scale, -1.5, 1.5).reshape(-1),\n                        np.broadcast_to(np.clip((last - recent) / scale, -1, 1), shape).reshape(-1)])\n    return np.column_stack(columns).astype(np.float32)\n\n\ndef _forward(x, node, params, head_x=None):\n    xx = np.column_stack([x, params['embedding'][node]])\n    h1 = np.tanh(xx @ params['w1'] + params['b1'])\n    h2 = np.tanh(h1 @ params['w2'] + params['b2'])\n    output = (h2 @ params['w3'] + x @ params['w0'] + params['b3']).reshape(-1)\n    if 'site_head' in params:\n        output += np.sum(head_x * params['site_head'][node], axis=1)\n    return output, (xx, h1, h2)\n\n\ndef fit(features, targets, seed, epochs=100, graph=None, mode='summary', site_head=False, average=False,\n        graph_strength=0.005, embedding_strength=0):\n    with threadpool_limits(limits=2):\n        start = time.monotonic()\n        rng = np.random.default_rng(seed)\n        if graph is None:\n            graph = spatial_calibration._neighborhood(features)\n        x, node = _features(features, graph, mode)\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets)\n        valid = (np.isfinite(y) & (y > 0)).reshape(-1)\n        residual = (y - np.asarray(features['base'])).reshape(-1)[valid] / 20\n        x, node = x[valid], node[valid]\n        head_x = _head_features(features, site_head)[valid] if site_head else None\n        laplacian = None\n        if site_head in ('graph', 'innovation') or embedding_strength:\n            adjacency = np.zeros((features['base'].shape[-1], features['base'].shape[-1]), dtype=np.float32)\n            np.put_along_axis(adjacency, graph['neighbors'], graph['weights'], axis=1)\n            adjacency = (adjacency + adjacency.T) / 2\n            laplacian = np.diag(adjacency.sum(axis=1)) - adjacency\n        center = np.mean(x, axis=0)\n        scale = np.maximum(np.std(x, axis=0), 0.01)\n        x = np.clip((x - center) / scale, -8, 8).astype(np.float32)\n        dim = x.shape[1] + 6\n        params = {'embedding': (rng.normal(size=(features['base'].shape[-1], 6)) * 0.05).astype(np.float32),\n                  'w1': (rng.normal(size=(dim, 48)) / np.sqrt(dim)).astype(np.float32),\n                  'b1': np.zeros(48, dtype=np.float32),\n                  'w2': (rng.normal(size=(48, 24)) / np.sqrt(48)).astype(np.float32),\n                  'b2': np.zeros(24, dtype=np.float32),\n                  'w0': np.zeros((x.shape[1], 1), dtype=np.float32),\n                  'w3': np.zeros((24, 1), dtype=np.float32),\n                  'b3': np.array([np.median(residual)], dtype=np.float32)}\n        if site_head:\n            params['site_head'] = np.zeros((features['base'].shape[-1], head_x.shape[1]), dtype=np.float32)\n        first = {k: np.zeros_like(v) for k, v in params.items()}\n        second = {k: np.zeros_like(v) for k, v in params.items()}\n        average_params = {k: np.zeros_like(v) for k, v in params.items()} if average else None\n        average_count = 0\n        step = 0\n        for epoch in range(epochs):\n            order = rng.permutation(x.shape[0])\n            rate = 0.003 * (0.35 + 0.65 * (1 - epoch / epochs))\n            for offset in range(0, len(order), 4096):\n                index = order[offset:offset + 4096]\n                output, (xx, h1, h2) = _forward(x[index], node[index], params,\n                                             head_x[index] if site_head else None)\n                error = output - residual[index]\n                dout = (error / np.sqrt(error * error + 0.01) / len(index))[:, None]\n                gradients = {'w0': x[index].T @ dout, 'w3': h2.T @ dout, 'b3': dout.sum(axis=0)}\n                dh2 = (dout @ params['w3'].T) * (1 - h2 * h2)\n                gradients.update(w2=h1.T @ dh2, b2=dh2.sum(axis=0))\n                dh1 = (dh2 @ params['w2'].T) * (1 - h1 * h1)\n                gradients.update(w1=xx.T @ dh1, b1=dh1.sum(axis=0))\n                dembed = (dh1 @ params['w1'].T)[:, -6:]\n                gradients['embedding'] = np.zeros_like(params['embedding'])\n                np.add.at(gradients['embedding'], node[index], dembed)\n                if site_head:\n                    gradients['site_head'] = np.zeros_like(params['site_head'])\n                    np.add.at(gradients['site_head'], node[index], head_x[index] * dout)\n                step += 1\n                for key, gradient in gradients.items():\n                    if key == 'site_head':\n                        gradient = gradient + params[key] * 0.0005\n                        if laplacian is not None:\n                            gradient[:, 2:] += graph_strength * (laplacian @ params[key][:, 2:])\n                    elif key.startswith('w') or key == 'embedding':\n                        gradient = gradient + params[key] * 0.0002\n                        if key == 'embedding' and embedding_strength:\n                            gradient += embedding_strength * (laplacian @ params[key])\n                    first[key] = 0.9 * first[key] + 0.1 * gradient\n                    second[key] = 0.999 * second[key] + 0.001 * gradient * gradient\n                    corrected = first[key] / (1 - 0.9 ** step)\n                    variance = second[key] / (1 - 0.999 ** step)\n                    params[key] -= rate * corrected / (np.sqrt(variance) + 1e-7)\n            if average and epoch >= 3 * epochs // 4:\n                for key in params:\n                    average_params[key] += params[key]\n                average_count += 1\n            if time.monotonic() - start > 150:\n                break\n        state = {'graph': graph, 'center': center, 'scale': scale, 'params': params, 'mode': mode,\n                 'epochs': epoch + 1, 'fit_seconds': time.monotonic() - start, 'head_mode': site_head}\n        if average_count:\n            state['last_params'] = params\n            state['params'] = {key: value / average_count for key, value in average_params.items()}\n        return state\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=2):\n        x, node = _features(features, state['graph'], state.get('mode', 'summary'))\n        x = np.clip((x - state['center']) / state['scale'], -8, 8).astype(np.float32)\n        head_x = _head_features(features, state.get('head_mode', True)) if 'site_head' in state['params'] else None\n        residual = np.empty(x.shape[0], dtype=np.float32)\n        for offset in range(0, len(x), 8192):\n            end = offset + 8192\n            residual[offset:end] = _forward(x[offset:end], node[offset:end], state['params'],\n                                          head_x[offset:end] if head_x is not None else None)[0] * 20\n        return np.maximum(np.asarray(features['base']) + residual.reshape(features['base'].shape), 0).astype(np.float32)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/sh -lc 'cat conditional_calibration.py'","aggregated_output":"\"\"\"Cross-fitted, regularized conditional blending of residual experts.\"\"\"\nimport numpy as np\nfrom scipy.optimize import minimize\nfrom scipy.special import expit\nfrom threadpoolctl import threadpool_limits\nimport blended_calibration\nimport horizon_calibration\nimport neural_calibration\nimport spatial_calibration\n\n\ndef _design(features, tree, network, mode='standard'):\n    base = np.asarray(features['base'], dtype=np.float64)\n    anchor = np.asarray(features['anchor'], dtype=np.float64)\n    history = np.asarray(features['history'], dtype=np.float64)\n    scale = np.maximum(np.mean(history, axis=1)[:, None, :], 30)\n    recent = np.mean(history[:, -3:, :], axis=1)[:, None, :]\n    std = np.std(history, axis=1)[:, None, :]\n    horizon = np.broadcast_to(np.arange(base.shape[1])[None, :, None] / 11, base.shape)\n    def broadcast(v):\n        return np.broadcast_to(v, base.shape)\n    variables = [np.ones_like(base), horizon,\n                 np.clip(np.abs(anchor - base) / scale, 0, 2),\n                 np.clip(np.abs(recent - base) / scale, 0, 2),\n                 broadcast(np.clip(std / scale, 0, 2)),\n                 np.clip(np.abs(network - tree) / 20, 0, 3),\n                 np.clip(base / 200, 0, 3)]\n    if mode == 'agreement':\n        last = history[:, -1:, :]\n        for reference in (anchor, recent, last):\n            variables.append(np.clip((np.abs(tree - reference) -\n                                      np.abs(network - reference)) / 20, -3, 3))\n    if mode in ('interactions', 'site', 'site_horizon', 'site_context', 'site_direction',\n                'site_context_signed', 'periodic'):\n        variables.extend([(horizon - 0.5) * variables[j] for j in (2, 3, 4, 5)])\n    if mode in ('site_direction', 'site_context_signed'):\n        variables.extend([np.clip((anchor - base) / scale, -2, 2),\n                          np.clip((recent - base) / scale, -2, 2)])\n    if mode == 'periodic':\n        clock = np.asarray(features['clock'], dtype=np.float64)\n        variables.extend([np.sin(2 * np.pi * clock), np.cos(2 * np.pi * clock),\n                          np.sin(4 * np.pi * clock), np.cos(4 * np.pi * clock)])\n    return np.stack(variables, axis=-1).reshape(-1, len(variables))\n\n\ndef _gate_fit(features, target, tree, network, penalty=0.01, mode='standard'):\n    x = _design(features, tree, network, mode)\n    valid = (np.isfinite(target) & (target > 0)).reshape(-1)\n    x = x[valid]\n    center = x.mean(axis=0)\n    center[0] = 0\n    scale = np.maximum(x.std(axis=0), 0.1)\n    scale[0] = 1\n    x = np.clip((x - center) / scale, -4, 4)\n    residual = (tree - target).reshape(-1)[valid]\n    difference = (network - tree).reshape(-1)[valid]\n    weight0 = np.broadcast_to(np.where(np.arange(tree.shape[1]) < 6, 0.18, 0.32)[None, :, None], tree.shape).reshape(-1)[valid]\n    offset = np.log(weight0 / (1 - weight0))\n    use_site = mode in ('site', 'site_horizon', 'site_context', 'site_direction', 'site_context_signed')\n    if use_site:\n        nodes = tree.shape[2]\n        node = np.broadcast_to(np.arange(nodes)[None, None, :], tree.shape).reshape(-1)[valid]\n        width = {'site': 1, 'site_horizon': 2, 'site_context': 4, 'site_direction': 6,\n                 'site_context_signed': 4}[mode]\n        basis = np.ones((len(node), width))\n        if width >= 2:\n            basis[:, 1] = np.broadcast_to(np.linspace(-1, 1, tree.shape[1])[None, :, None], tree.shape).reshape(-1)[valid]\n        site_columns = [2, 3] if width >= 4 else []\n        if width == 6:\n            site_columns.extend([11, 12])\n        if site_columns:\n            basis[:, 2:] = x[:, site_columns]\n        graph = spatial_calibration._neighborhood(features)\n        adjacency = np.zeros((nodes, nodes))\n        np.put_along_axis(adjacency, graph['neighbors'], graph['weights'], axis=1)\n        adjacency = (adjacency + adjacency.T) / 2\n        laplacian = np.diag(adjacency.sum(axis=1)) - adjacency\n        site_shape = (nodes, basis.shape[1])\n    def objective(coef):\n        global_coef = coef[:x.shape[1]]\n        logit = offset + x @ global_coef\n        if use_site:\n            site = coef[x.shape[1]:].reshape(site_shape)\n            centered_site = site - site.mean(axis=0)\n            logit += np.sum(centered_site[node] * basis, axis=1)\n        weight = expit(logit)\n        error = residual + weight * difference\n        smooth = np.sqrt(error * error + 4)\n        derivative = error / smooth * difference * weight * (1 - weight)\n        value = np.mean(smooth) / 20 + penalty * np.dot(global_coef, global_coef) / 2\n        gradient = x.T @ derivative / (len(x) * 20) + penalty * global_coef\n        if use_site:\n            site_gradient = np.column_stack([\n                np.bincount(node, weights=derivative * basis[:, j], minlength=nodes)\n                for j in range(basis.shape[1])]) / (len(x) * 20)\n            site_gradient -= site_gradient.mean(axis=0)\n            regularizer = 0.02 * site + 0.05 * (laplacian @ site)\n            site_gradient += regularizer / nodes\n            value += np.sum(site * regularizer) / (2 * nodes)\n            gradient = np.r_[gradient, site_gradient.reshape(-1)]\n        return value, gradient\n    count = x.shape[1] + nodes * basis.shape[1] if use_site else x.shape[1]\n    result = minimize(objective, np.zeros(count), jac=True, method='L-BFGS-B',\n                      options={'maxiter': 100 if use_site else 60, 'ftol': 1e-10})\n    state = {'coef': result.x[:x.shape[1]].astype(np.float32), 'center': center.astype(np.float32),\n             'scale': scale.astype(np.float32), 'penalty': penalty, 'mode': mode}\n    if use_site:\n        site = result.x[x.shape[1]:].reshape(site_shape)\n        state['site'] = (site - site.mean(axis=0)).astype(np.float32)\n        state['site_columns'] = site_columns\n    return state\n\n\ndef _weight(state, features, tree, network):\n    x = _design(features, tree, network, state.get('mode', 'standard'))\n    x = np.clip((x - state['center']) / state['scale'], -4, 4)\n    initial = np.broadcast_to(np.where(np.arange(tree.shape[1]) < 6, 0.18, 0.32)[None, :, None], tree.shape)\n    offset = np.log(initial / (1 - initial))\n    logit = offset + (x @ state['coef']).reshape(tree.shape)\n    if 'site' in state:\n        site = state['site']\n        logit += site[None, None, :, 0]\n        if site.shape[1] >= 2:\n            logit += np.linspace(-1, 1, tree.shape[1])[None, :, None] * site[None, None, :, 1]\n        for j, column in enumerate(state.get('site_columns', range(2, site.shape[1])), 2):\n            logit += x[:, column].reshape(tree.shape) * site[None, None, :, j]\n    return np.clip(expit(logit), 0.05, 0.65)\n\n\ndef _amplitude_design(features, correction):\n    base = np.asarray(features['base'], dtype=np.float64)\n    history = np.asarray(features['history'], dtype=np.float64)\n    scale = np.maximum(np.mean(history, axis=1)[:, None, :], 30)\n    anchor = np.asarray(features['anchor'])\n    recent = np.mean(history[:, -3:, :], axis=1)[:, None, :]\n    horizon = np.broadcast_to(np.linspace(0, 1, base.shape[1])[None, :, None], base.shape)\n    variables = [np.ones_like(base), horizon,\n                 np.clip(np.abs(anchor - base) / scale, 0, 2),\n                 np.clip(np.abs(recent - base) / scale, 0, 2),\n                 np.broadcast_to(np.clip(np.std(history, axis=1)[:, None, :] / scale, 0, 2), base.shape),\n                 np.clip(np.abs(correction) / 20, 0, 3),\n                 np.clip(np.sign(correction) * (anchor - base) / scale, -2, 2)]\n    return np.stack(variables, axis=-1).reshape(-1, len(variables))\n\n\ndef _amplitude_fit(features, target, tree, network, gate):\n    base = np.asarray(features['base'], dtype=np.float64)\n    correction = tree + _weight(gate, features, tree, network) * (network - tree) - base\n    valid = (np.isfinite(target) & (target > 0)).reshape(-1)\n    x = _amplitude_design(features, correction)[valid]\n    center = x.mean(axis=0)\n    center[0] = 0\n    scale = np.maximum(x.std(axis=0), 0.1)\n    scale[0] = 1\n    x = np.clip((x - center) / scale, -4, 4)\n    residual = (base - target).reshape(-1)[valid]\n    correction = correction.reshape(-1)[valid]\n    def objective(coef):\n        activation = np.tanh(x @ coef)\n        error = residual + (1 + 0.5 * activation) * correction\n        smooth = np.sqrt(error * error + 4)\n        derivative = error / smooth * correction * 0.5 * (1 - activation * activation)\n        return (np.mean(smooth) / 20 + 0.02 * np.dot(coef, coef) / 2,\n                x.T @ derivative / (len(x) * 20) + 0.02 * coef)\n    result = minimize(objective, np.zeros(x.shape[1]), jac=True, method='L-BFGS-B',\n                      options={'maxiter': 60, 'ftol': 1e-10})\n    return {'coef': result.x.astype(np.float32), 'center': center.astype(np.float32),\n            'scale': scale.astype(np.float32)}\n\n\ndef _blend(gate, features, tree, network, amplitude=None):\n    blend = tree + _weight(gate, features, tree, network) * (network - tree)\n    if amplitude is not None:\n        base = np.asarray(features['base'], dtype=np.float64)\n        correction = blend - base\n        x = _amplitude_design(features, correction)\n        x = np.clip((x - amplitude['center']) / amplitude['scale'], -4, 4)\n        factor = (1 + 0.5 * np.tanh(x @ amplitude['coef'])).reshape(base.shape)\n        blend = np.maximum(base + factor * correction, 0)\n    return blend\n\n\ndef fit(features, targets, seed, auxiliary_mode=None, site_head=False, average=False,\n        gate_mode='standard', amplitude=False):\n    with threadpool_limits(limits=2):\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets)\n        index = np.arange(len(y))\n        tree_oof, network_oof = np.empty_like(y), np.empty_like(y)\n        for held in np.array_split(index, 3):\n            train = np.setdiff1d(index, held)\n            train_features = {k: v[train] for k, v in features.items()}\n            test_features = {k: v[held] for k, v in features.items()}\n            fold = blended_calibration.fit(train_features, y[train], seed,\n                                           site_head=site_head, average=average)\n            tree_oof[held] = horizon_calibration.predict(fold['tree'], test_features)\n            network_oof[held] = neural_calibration.predict(fold['network'], test_features)\n        gate = _gate_fit(features, y, tree_oof, network_oof, mode=gate_mode)\n        state = blended_calibration.fit(features, y, seed, site_head=site_head, average=average)\n        state['gate'] = gate\n        if amplitude:\n            state['amplitude'] = _amplitude_fit(features, y, tree_oof, network_oof, gate)\n        if auxiliary_mode is not None:\n            state['aux_network'] = neural_calibration.fit(\n                features, y, seed, graph=state['tree']['pooled']['graph'], mode=auxiliary_mode)\n        return state\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=2):\n        tree = horizon_calibration.predict(state['tree'], features)\n        network = neural_calibration.predict(state['network'], features)\n        if 'aux_network' in state:\n            network = (network + neural_calibration.predict(state['aux_network'], features)) / 2\n        return _blend(state['gate'], features, tree, network,\n                      state.get('amplitude')).astype(np.float32)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/sh -lc 'cat research_validation.py'","aggregated_output":"\"\"\"Public calibration origin-block comparisons; never reads development targets.\"\"\"\nimport time\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport tree_calibration\nimport spatial_calibration\n\n\ndef load():\n    features = dict(np.load('/workspace/public_assets/train_features.npz'))\n    targets = np.load('/workspace/public_assets/train_targets.npz')['target']\n    return features, targets\n\n\ndef subset(features, index):\n    return {key: value[index] for key, value in features.items()}\n\n\ndef mae(target, prediction):\n    valid = np.isfinite(target) & (target > 0)\n    return float(np.mean(np.abs(target[valid] - prediction[valid])))\n\n\ndef evaluate(fit, predict, name, splits=None):\n    features, targets = load()\n    if splits is None:\n        splits = [(np.arange(50), np.arange(50, 74)),\n                  (np.r_[0:25, 49:74], np.arange(25, 49))]\n    start = time.monotonic()\n    output = []\n    for train, test in splits:\n        state = fit(subset(features, train), targets[train], 17)\n        pred = predict(state, subset(features, test))\n        value = mae(targets[test], pred)\n        output.append(value)\n        print(name, 'test', test[0], test[-1], 'MAE', value,\n              'elapsed', round(time.monotonic() - start, 2), flush=True)\n    return output\n\n\nif __name__ == '__main__':\n    with threadpool_limits(limits=2):\n        evaluate(tree_calibration.fit, tree_calibration.predict, 'retained')\n        for variant in ['neighbors', 'relative']:\n            evaluate(lambda f, y, s: spatial_calibration.fit(f, y, s, variant=variant),\n                     spatial_calibration.predict, variant)\n","exit_code":0,"status":"completed"}}

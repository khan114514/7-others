port threadpool_limits\nf,y=r.load()\nstart=time.monotonic()\nmodes=sys.argv[1:] or ['trend','graph']\nwith threadpool_limits(limits=2):\n for split in ['last','middle']:\n  with open('/tmp/forecast_turn_graph/'+split+'.baseline','rb') as inp: cache=pickle.load(inp)\n  train,test=cache['train'],cache['test']\n  ft,fv=r.subset(f,train),r.subset(f,test)\n  yt=y[train]\n  base_state=cache['state']\n  tree=h.predict(base_state['tree'],fv)\n  folds=[]\n  tree_oof=np.empty_like(yt)\n  for held in np.array_split(np.arange(len(yt)),3):\n   keep=np.setdiff1d(np.arange(len(yt)),held)\n   ff,fh=r.subset(ft,keep),r.subset(ft,held)\n   tt=h.fit(ff,yt[keep],17,groups=2)\n   tree_oof[held]=h.predict(tt,fh)\n   folds.append((held,keep,tt['pooled']['graph']))\n  with open('/tmp/forecast_turn_graph/'+split+'.tree_oof','wb') as out: pickle.dump({'prediction':tree_oof,'folds':folds},out)\n  for mode in modes:\n   with open('/tmp/forecast_turn_graph/'+split+'.'+mode,'rb') as inp: head_cache=pickle.load(inp)\n   network_oof=np.empty_like(yt)\n   for held,keep,graph in folds:\n    network=n.fit(r.subset(ft,keep),yt[keep],17,graph=graph,site_head=mode)\n    network_oof[held]=n.predict(network,r.subset(ft,held))\n   with open('/tmp/forecast_turn_graph/'+split+'.network_oof.'+mode,'wb') as out: pickle.dump(network_oof,out)\n   gate=c._gate_fit(ft,yt,tree_oof,network_oof)\n   pred=n.predict(head_cache['network'],fv)\n   weight=c._weight(gate,fv,tree,pred)\n   blend=tree+weight*(pred-tree)\n   print('matching',mode,split,'MAE',r.mae(y[test],blend),'gate',gate['coef'].tolist(),'elapsed',time.monotonic()-start,flush=True)\n   with open('/tmp/forecast_turn_graph/'+split+'.matching.'+mode,'wb') as out:pickle.dump({'gate':gate,'prediction':blend},out)\nimport pickle\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport conditional_calibration as c\nimport neural_calibration as n\nimport horizon_calibration as h\nimport research_validation as r\n\nf, y = r.load()\nwith threadpool_limits(limits=2):\n    for split in ['last', 'middle']:\n        with open('/tmp/forecast_turn_graph/' + split + '.baseline', 'rb') as inp:\n            cache = pickle.load(inp)\n        train, test = cache['train'], cache['test']\n        ft, fv = r.subset(f, train), r.subset(f, test)\n        with open('/tmp/forecast_turn_graph/' + split + '.tree_oof', 'rb') as inp:\n            tree_oof = pickle.load(inp)['prediction']\n        tree = h.predict(cache['state']['tree'], fv)\n        for mode in ['standard', 'graph', 'trend']:\n            with open('/tmp/forecast_turn_graph/' + split + '.network_oof.' + mode, 'rb') as inp:\n                network_oof = pickle.load(inp)\n            if mode == 'standard':\n                network = cache['state']['network']\n            else:\n                with open('/tmp/forecast_turn_graph/' + split + '.' + mode, 'rb') as inp:\n                    network = pickle.load(inp)['network']\n            pred = n.predict(network, fv)\n            gate = c._gate_fit(ft, y[train], tree_oof, network_oof, mode='interactions')\n            weight = c._weight(gate, fv, tree, pred)\n            blend = tree + weight * (pred - tree)\n            print(split, mode, 'interactions MAE', r.mae(y[test], blend),\n                  'coef', gate['coef'].tolist(), flush=True)\n            with open('/tmp/forecast_turn_graph/' + split + '.interactions.' + mode, 'wb') as out:\n                pickle.dump({'gate': gate, 'prediction': blend}, out)\nimport os\nos.environ['OMP_NUM_THREADS']='2'\nos.environ['OPENBLAS_NUM_THREADS']='2'\nos.environ['MKL_NUM_THREADS']='2'\nimport sys, time, pickle\nsys.path.insert(0, '/workspace/solution')\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport research_validation as rv\nimport blended_calibration as blend\nimport horizon_calibration as tree\nimport neural_calibration as network\nimport conditional_calibration as gate\n\nfeatures, target = rv.load()\nsplits=[(np.arange(50), np.arange(50,74)),(np.r_[0:25,49:74], np.arange(25,49))]\nwith threadpool_limits(limits=2):\n    for k,(train,test) in enumerate(splits):\n        started=time.monotonic()\n        f=rv.subset(features,train); ft=rv.subset(features,test); y=target[train]\n        cache='/tmp/conditional_block_%d.pkl'%k\n        if os.path.exists(cache):\n            with open(cache,'rb') as stream: data=pickle.load(stream)\n        else:\n            state=blend.fit(f,y,17)\n            tt=tree.predict(state['tree'],ft); nt=network.predict(state['network'],ft)\n            ot=np.empty_like(y); on=np.empty_like(y)\n            for held in np.array_split(np.arange(len(train)),3):\n                tr=np.setdiff1d(np.arange(len(train)),held)\n                fold=blend.fit(rv.subset(f,tr),y[tr],17)\n                ot[held]=tree.predict(fold['tree'],rv.subset(f,held))\n                on[held]=network.predict(fold['network'],rv.subset(f,held))\n                print('fold',k,int(held[0]),'elapsed',round(time.monotonic()-started,1),flush=True)\n            data=(state,tt,nt,ot,on)\n            with open(cache,'wb') as stream:pickle.dump(data,stream)\n        state,tt,nt,ot,on=data\n        baseline=blend.predict(state,ft)\n        print('BASELINE',k,rv.mae(target[test],baseline),flush=True)\n        for penalty in [0.04,0.01,0.002]:\n            model=gate._gate_fit(f,y,ot,on,penalty)\n            weights=gate._weight(model,ft,tt,nt)\n            prediction=tt+weights*(nt-tt)\n            print('GATE',k,penalty,rv.mae(target[test],prediction),'coef',model['coef'].round(4),'weights',np.percentile(weights,[10,50,90]).round(4),flush=True)\n8f76542e99d52de01f6f0a3bab86648732ccd0af96306de9a561051741d95b30  /workspace/instruction.md\n626139cb54e05049efafc931d82ed1fce749d2baf7eb990e68983073dcdb84f3  /workspace/task.toml\nd6e0c77a5c20b1afee86cdc5576402b45fea48f5623a0729b3c748d2ee5b4a4a  /workspace/solution/solve.sh\n3af0fd777362df1e40a73ba4af5b3e3127b60b66779066f8f922d881cc736e35  /workspace/public_assets/manifest
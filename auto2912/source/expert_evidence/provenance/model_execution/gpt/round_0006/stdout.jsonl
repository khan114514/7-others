{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/sh -lc \"OPENBLAS_NUM_THREADS=2 OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 PYTHONPATH=/workspace/solution python - <<'PY'\nimport pickle,numpy as np\nimport research_validation as r\nimport conditional_calibration as c\nimport horizon_calibration as h\nimport neural_calibration as n\nf,y=r.load()\nfor split in ['last','middle']:\n p='/tmp/forecast_turn_graph/'+split\n with open(p+'.baseline','rb') as inp:b=pickle.load(inp)\n with open(p+'.hierarchical.interactions','rb') as inp:old=pickle.load(inp)\n with open(p+'.hierarchical.site_horizon','rb') as inp:new=pickle.load(inp)\n with open(p+'.graph','rb') as inp:nn=pickle.load(inp)['network']\n ft=r.subset(f,b['test']); truth=y[b['test']]; valid=truth>0\n olderror=np.abs(old['prediction']-truth); newerror=np.abs(new['prediction']-truth)\n improvement=np.sum((olderror-newerror)*valid,axis=(0,1))/valid.sum(axis=(0,1))\n tree=h.predict(b['state']['tree'],ft); network=n.predict(nn,ft)\n weight=c._weight(new['gate'],ft,tree,network)\n print(split,'improved sensors',np.sum(improvement>0),'of',len(improvement),'sensor gain quantiles',np.percentile(improvement,[0,10,50,90,100]))\n print('weight quantiles',np.percentile(weight,[0,10,50,90,100]),'site intercept std',np.std(new['gate']['site'][:,0]),'horizon slope std',np.std(new['gate']['site'][:,1]))\n print('per horizon gain',[float(np.mean((olderror-newerror)[:,i][valid[:,i]])) for i in range(12)])\n print('first/second half gain',[r.mae(truth[idx],old['prediction'][idx])-r.mae(truth[idx],new['prediction'][idx]) for idx in [slice(0,12),slice(12,None)]])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

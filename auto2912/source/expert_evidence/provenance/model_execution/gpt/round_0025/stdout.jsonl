{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/sh -lc \"sed -n '1,280p' /tmp/horizon_edge_turn_validation.py\"","aggregated_output":"\"\"\"Calibration-only short/long-horizon conditional innovation neighborhoods.\"\"\"\nimport pickle\nimport sys\nimport time\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nsys.path.insert(0, '/workspace/solution')\nsys.path.insert(0, '/tmp')\nimport conditional_calibration as c\nimport spatial_calibration as s\nimport research_validation as r\nfrom edge_turn_validation import correlation\n\n\ndef design(f):\n    shape = f['base'].shape\n    clock = np.asarray(f['clock'], dtype=np.float64)\n    horizon = np.broadcast_to(np.linspace(-1, 1, shape[1])[None, :, None], shape)\n    return np.stack([np.ones(shape), horizon, np.sin(2 * np.pi * clock),\n                     np.cos(2 * np.pi * clock), np.sin(4 * np.pi * clock),\n                     np.cos(4 * np.pi * clock)], axis=-1)\n\n\ndef fit(f, raw, mode):\n    state = s.diffusion_fit(f, raw, graph_mode='prediction_median_scale')\n    if mode == 'control':\n        return state\n    residual = raw - f['base'] - np.einsum('shni,ni->shn', design(f), state['coef'])\n    blocks = np.array_split(np.arange(len(raw)), 3)\n    groups = []\n    for horizons in [np.arange(6), np.arange(6, 12)]:\n        correlations = np.stack([correlation(residual[b][:, horizons]) for b in blocks])\n        similarity = np.median(correlations, axis=0)\n        np.fill_diagonal(similarity, -1)\n        neighbors = np.argsort(similarity, axis=1)[:, -8:]\n        weights = np.maximum(np.take_along_axis(similarity, neighbors, axis=1), 0) ** 2\n        weights /= np.maximum(weights.sum(axis=1, keepdims=True), 1e-8)\n        scale = state['graph']['scale']\n        if mode == 'split_scaled':\n            variance = np.stack([np.var(residual[b][:, horizons], axis=(0, 1)) for b in blocks])\n            scale = np.maximum(np.sqrt(np.median(variance, axis=0)), 10).astype(np.float32)\n        groups.append({'horizons': horizons, 'neighbors': neighbors,\n                       'weights': weights.astype(np.float32), 'scale': scale})\n    state['horizon_graphs'] = groups\n    return state\n\n\ndef predict(state, f, raw):\n    if 'horizon_graphs' not in state:\n        return s.diffusion_predict(state, f, raw)\n    seasonal = np.einsum('shni,ni->shn', design(f), state['coef'])\n    innovation = raw - f['base'] - seasonal\n    shared = np.empty_like(innovation)\n    for graph in state['horizon_graphs']:\n        horizons = graph['horizons']\n        normalized = innovation[:, horizons] / graph['scale']\n        neighbor = np.sum(normalized[..., graph['neighbors']] * graph['weights'], axis=-1)\n        shared[:, horizons] = .75 * innovation[:, horizons] + .25 * neighbor * graph['scale']\n    return np.maximum(f['base'] + seasonal + shared, 0)\n\n\nif __name__ == '__main__':\n    started = time.monotonic()\n    with threadpool_limits(limits=1):\n        for split in ['last', 'middle', 'first']:\n            data = pickle.load(open('/tmp/' + split + '.edge_turn_motion', 'rb'))\n            q, raw_o, raw_v = data['q'], data['raw_o'], data['raw_v']\n            output = {}\n            for mode in ['control', 'split_edges', 'split_scaled']:\n                diffusion = fit(q['ft'], raw_o, mode)\n                no, nv = predict(diffusion, q['ft'], raw_o), predict(diffusion, q['fv'], raw_v)\n                gate = c._gate_fit(q['ft'], q['yt'], q['to'], no, mode='site_history_trend')\n                blend = c._blend(gate, q['fv'], q['tree'], nv)\n                stage = c._residual_tree_fit(q['ft'], q['yt'], q['to'], no, 17,\n                                            'site_history_trend', diffuse='context_smooth')\n                prediction = c._residual_tree_predict(stage, q['fv'], q['tree'], nv, blend)\n                value = r.mae(q['yv'], prediction)\n                output[mode] = {'diffusion': diffusion, 'gate': gate, 'stage': stage,\n                                'prediction': prediction, 'mae': value}\n                print(split, mode, 'MAE', value, 'network', r.mae(q['yv'], nv),\n                      'elapsed', round(time.monotonic() - started, 1), flush=True)\n            with open('/tmp/' + split + '.horizon_edge_turn', 'wb') as out:\n                pickle.dump(output, out)\n","exit_code":0,"status":"completed"}}

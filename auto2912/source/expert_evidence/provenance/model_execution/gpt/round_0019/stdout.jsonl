{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/sh -lc 'cat /tmp/forecast_turn_periodic/fold_ensemble_validation.py'","aggregated_output":"\"\"\"Calibration-only test of retaining the already-fitted cross-fit networks.\"\"\"\nimport pickle\nimport time\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport conditional_calibration as c\nimport spatial_calibration as s\nimport neural_calibration as n\nimport research_validation as r\nfrom temporal_validation import load\n\nOUT = '/tmp/forecast_turn_periodic/'\n\nif __name__ == '__main__':\n    started = time.monotonic()\n    with threadpool_limits(limits=1):\n        for split in ['last', 'middle', 'first']:\n            q, raw_o, raw_v = load(split)\n            fold_predictions, folds = [], []\n            index = np.arange(len(q['yt']))\n            for held in np.array_split(index, 3):\n                keep = np.setdiff1d(index, held)\n                model = n.fit(r.subset(q['ft'], keep), q['yt'][keep], 17,\n                              site_head='graph', replicas=2, epochs=(100, 80))\n                fold_predictions.append(n.predict(model, q['fv']))\n                folds.append(model)\n                print(split, 'retained-fold network', held[0], held[-1],\n                      'wall', round(time.monotonic() - started, 1), flush=True)\n            fold_average = np.mean(fold_predictions, axis=0)\n            diffusion = s.diffusion_fit(q['ft'], raw_o, robust=True)\n            diffusion['pooling'] = 'context_normalize'\n            no = s.diffusion_predict(diffusion, q['ft'], raw_o)\n            gate = c._gate_fit(q['ft'], q['yt'], q['to'], no,\n                               mode='site_neighbor_horizon')\n            stage = c._residual_tree_fit(q['ft'], q['yt'], q['to'], no, 17,\n                                        'site_neighbor_horizon', diffuse='context')\n            outputs = {'folds': folds, 'fold_predictions': fold_predictions,\n                       'gate': gate, 'stage': stage, 'diffusion': diffusion}\n            for mode, raw in [('control', raw_v), ('folds', fold_average),\n                              ('all', (raw_v + 3 * fold_average) / 4)]:\n                nv = s.diffusion_predict(diffusion, q['fv'], raw)\n                blend = c._blend(gate, q['fv'], q['tree'], nv)\n                prediction = c._residual_tree_predict(stage, q['fv'], q['tree'], nv, blend)\n                outputs[mode] = {'prediction': prediction, 'mae': r.mae(q['yv'], prediction)}\n                print(split, mode, 'MAE', outputs[mode]['mae'],\n                      'network MAE', r.mae(q['yv'], raw),\n                      'wall', round(time.monotonic() - started, 1), flush=True)\n            with open(OUT + split + '.folds', 'wb') as out:\n                pickle.dump(outputs, out)\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/sh -lc 'cat /tmp/forecast_turn_periodic/temporal_validation.py'","aggregated_output":"\"\"\"Calibration-only test of seasonal-preserving horizon diffusion.\"\"\"\nimport pickle\nimport time\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport conditional_calibration as c\nimport spatial_calibration as s\nimport neural_calibration as n\nimport research_validation as r\n\nROOT = '/tmp/forecast_turn_adaptive/'\nOUT = '/tmp/forecast_turn_periodic/'\noriginal_predict = s.diffusion_predict\n\n\ndef temporal_predict(state, features, prediction):\n    value = original_predict(state, features, prediction)\n    if not state.get('temporal'):\n        return value\n    shape = features['base'].shape\n    clock = np.asarray(features['clock'], dtype=np.float64)\n    horizon = np.broadcast_to(np.linspace(-1, 1, shape[1])[None, :, None], shape)\n    x = np.stack([np.ones(shape), horizon, np.sin(2 * np.pi * clock),\n                  np.cos(2 * np.pi * clock), np.sin(4 * np.pi * clock),\n                  np.cos(4 * np.pi * clock)], axis=-1)\n    seasonal = np.einsum('shni,ni->shn', x, state['coef'])\n    innovation = value - features['base'] - seasonal\n    # Reflect at the endpoints; corrections, rather than the upstream\n    # trajectory, share the fixed horizon-chain diffusion operator.\n    previous = np.concatenate([innovation[:, :1], innovation[:, :-1]], axis=1)\n    following = np.concatenate([innovation[:, 1:], innovation[:, -1:]], axis=1)\n    innovation = innovation + 0.25 * (previous + following - 2 * innovation)\n    return np.maximum(features['base'] + seasonal + innovation, 0)\n\n\ndef load(split):\n    if split == 'first':\n        with open(ROOT + 'first.cache', 'rb') as inp:\n            q = pickle.load(inp)\n        return q, q['network_oof'], q['network']\n    with open('/tmp/forecast_turn_residual/' + split + '.cache', 'rb') as inp:\n        q = pickle.load(inp)\n    with open('/tmp/forecast_turn_graph/' + split + '.budget_replica', 'rb') as inp:\n        ensemble = pickle.load(inp)\n    return q, ensemble['network_oof'], n.predict(ensemble['network'], q['fv'])\n\n\nif __name__ == '__main__':\n    started = time.monotonic()\n    s.diffusion_predict = temporal_predict\n    with threadpool_limits(limits=1):\n        for split in ['last', 'middle', 'first']:\n            q, raw_o, raw_v = load(split)\n            outputs = {}\n            for mode in ['control', 'network', 'residual', 'both']:\n                diffusion = s.diffusion_fit(q['ft'], raw_o, robust=True)\n                diffusion['pooling'] = 'context_normalize'\n                diffusion['temporal'] = mode in ('network', 'both')\n                no = s.diffusion_predict(diffusion, q['ft'], raw_o)\n                nv = s.diffusion_predict(diffusion, q['fv'], raw_v)\n                gate = c._gate_fit(q['ft'], q['yt'], q['to'], no,\n                                   mode='site_neighbor_horizon')\n                blend = c._blend(gate, q['fv'], q['tree'], nv)\n                stage = c._residual_tree_fit(q['ft'], q['yt'], q['to'], no, 17,\n                                            'site_neighbor_horizon', diffuse='context')\n                stage['diffusion']['temporal'] = mode in ('residual', 'both')\n                prediction = c._residual_tree_predict(stage, q['fv'], q['tree'], nv, blend)\n                outputs[mode] = {'prediction': prediction, 'mae': r.mae(q['yv'], prediction),\n                                 'diffusion': diffusion, 'gate': gate, 'stage': stage}\n                print(split, mode, 'MAE', outputs[mode]['mae'],\n                      'wall', round(time.monotonic() - started, 1), flush=True)\n            with open(OUT + split + '.temporal', 'wb') as out:\n                pickle.dump(outputs, out)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/sh -lc 'cat blended_calibration.py'","aggregated_output":"\"\"\"Horizon-specific median trees blended with a smooth residual network.\"\"\"\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport horizon_calibration\nimport neural_calibration\n\n\ndef fit(features, targets, seed, graph=None, network_mode='summary', auxiliary_mode=None,\n        site_head=False, average=False, network_replicas=1, network_epochs=100):\n    with threadpool_limits(limits=1):\n        state = {'tree': horizon_calibration.fit(features, targets, seed, groups=2, graph=graph),\n                'network': neural_calibration.fit(features, targets, seed, graph=graph, mode=network_mode,\n                                                  site_head=site_head, average=average,\n                                                  replicas=network_replicas, epochs=network_epochs),\n                # The smooth model is more useful at longer horizons on both\n                # public origin blocks; keep a conservative horizon schedule.\n                'network_weight': np.where(np.arange(features['base'].shape[1]) < 6,\n                                           0.18, 0.32).astype(np.float32)}\n        if auxiliary_mode is not None:\n            state['aux_network'] = neural_calibration.fit(\n                features, targets, seed, graph=state['tree']['pooled']['graph'], mode=auxiliary_mode)\n        return state\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=1):\n        tree = horizon_calibration.predict(state['tree'], features)\n        network = neural_calibration.predict(state['network'], features)\n        if 'aux_network' in state:\n            network = (network + neural_calibration.predict(state['aux_network'], features)) / 2\n        weight = np.asarray(state.get('network_weight', 0.25), dtype=np.float32)\n        return (tree * (1.0 - weight[None, :, None]) +\n                network * weight[None, :, None]).astype(np.float32)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/sh -lc 'cat /tmp/forecast_turn_graph/residual_validation.py'","aggregated_output":"import pickle\nimport time\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport conditional_calibration as c\nimport horizon_calibration as h\nimport neural_calibration as n\nimport research_validation as r\n\nf, y = r.load()\nstart = time.monotonic()\nwith threadpool_limits(limits=1):\n    for split in ['last', 'middle']:\n        prefix = '/tmp/forecast_turn_graph/' + split\n        with open(prefix + '.baseline', 'rb') as inp:\n            cache = pickle.load(inp)\n        train, test = cache['train'], cache['test']\n        ft, fv = r.subset(f, train), r.subset(f, test)\n        with open(prefix + '.tree_oof', 'rb') as inp:\n            tree_oof = pickle.load(inp)['prediction']\n        with open(prefix + '.network_oof.graph', 'rb') as inp:\n            network_oof = pickle.load(inp)\n        with open(prefix + '.graph', 'rb') as inp:\n            network = pickle.load(inp)['network']\n        tree, pred = h.predict(cache['state']['tree'], fv), n.predict(network, fv)\n        for gate_mode in ['site_expert_direction', 'site_neighbor_horizon']:\n            with open(prefix + '.hierarchical.' + gate_mode, 'rb') as inp:\n                control = pickle.load(inp)\n            gate = control['gate']\n            oof_blend = c._blend(gate, ft, tree_oof, network_oof)\n            output = {}\n            print(split, gate_mode, 'control', r.mae(y[test], control['prediction']), flush=True)\n            for mode, shared_only in [('offset', True), ('offset', False),\n                                      ('seasonal', False), ('context', False)]:\n                head = c._residual_fit(ft, y[train], oof_blend, mode, shared_only)\n                prediction = c._residual_predict(head, fv, control['prediction'])\n                name = mode + ('_shared' if shared_only else '_site')\n                output[name] = {'head': head, 'prediction': prediction}\n                print(split, gate_mode, name, 'MAE', r.mae(y[test], prediction),\n                      'elapsed', round(time.monotonic() - start, 2), flush=True)\n            with open(prefix + '.residual.' + gate_mode, 'wb') as out:\n                pickle.dump(output, out)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/sh -lc 'cat /tmp/forecast_turn_residual/design_validation.py'","aggregated_output":"import sys,pickle,time\nimport numpy as np\nfrom sklearn.ensemble import HistGradientBoostingRegressor\nfrom threadpoolctl import threadpool_limits\nimport conditional_calibration as c\nimport spatial_calibration as s\nimport research_validation as r\n\ndef design(f,t,n,b,mode,graph=None):\n x=c._residual_tree_design(f,t,n,b)\n base=f['base']\n tc,nc,gap=t-base,n-base,n-t\n def broad(v):return np.broadcast_to(v,base.shape)\n def average(v):return broad(np.mean(v,axis=1,keepdims=True))\n if mode=='trajectory':\n  extra=[average(tc),average(nc),average(gap),gap-average(gap),\n         broad(tc[:,-1:]-tc[:,:1]),broad(nc[:,-1:]-nc[:,:1])]\n elif mode=='persistent_gap':\n  extra=[average(gap),gap-average(gap)]\n elif mode=='spatial':\n  if graph is None:graph=s._neighborhood(f)\n  def aggregate(v):return np.sum((v/graph['scale'])[...,graph['neighbors']]*graph['weights'],axis=-1)*graph['scale']\n  extra=[aggregate(gap),aggregate(b-base),aggregate(nc)]\n elif mode=='trajectory_spatial':\n  if graph is None:graph=s._neighborhood(f)\n  ng=np.sum((gap/graph['scale'])[...,graph['neighbors']]*graph['weights'],axis=-1)*graph['scale']\n  extra=[average(gap),gap-average(gap),ng]\n elif mode=='slope':\n  extra=[np.gradient(tc,axis=1),np.gradient(nc,axis=1),np.gradient(gap,axis=1)]\n else:raise ValueError(mode)\n return np.column_stack([x]+[v.reshape(-1) for v in extra]).astype(np.float32)\n\nif __name__=='__main__':\n start=time.monotonic()\n with threadpool_limits(limits=1):\n  for split in ['last','middle']:\n   with open('/tmp/forecast_turn_residual/'+split+'.cache','rb') as inp:q=pickle.load(inp)\n   graph=s._neighborhood(q['ft'])\n   valid=np.isfinite(q['yt'])&(q['yt']>0)\n   print(split,'control',r.mae(q['yv'],q['control']),flush=True)\n   output={}\n   for mode in ['persistent_gap','trajectory','spatial','trajectory_spatial','slope']:\n    xt=design(q['ft'],q['to'],q['no'],q['oo'],mode,graph)\n    xv=design(q['fv'],q['tree'],q['network'],q['blend'],mode,graph)\n    model=HistGradientBoostingRegressor(loss='absolute_error',max_iter=40,learning_rate=0.05,max_leaf_nodes=7,min_samples_leaf=2000,l2_regularization=50,categorical_features=[1],early_stopping=False,random_state=17)\n    model.fit(xt[valid.ravel()],(q['yt']-q['oo'])[valid])\n    correction=np.clip(model.predict(xv).reshape(q['blend'].shape),-10,10)\n    pred=np.maximum(q['blend']+0.5*correction,0)\n    score=r.mae(q['yv'],pred)\n    print(split,mode,'MAE',score,'elapsed',round(time.monotonic()-start,1),flush=True)\n    output[mode]={'model':model,'prediction':pred,'mae':score}\n   with open('/tmp/forecast_turn_residual/'+split+'.designs','wb') as out:pickle.dump(output,out)\n","exit_code":0,"status":"completed"}}

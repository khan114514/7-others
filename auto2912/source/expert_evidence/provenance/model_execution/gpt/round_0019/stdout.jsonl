{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/sh -lc 'cat /tmp/forecast_turn_periodic/runtime_check.py'","aggregated_output":"\"\"\"Fit and reload the current method using only calibration targets.\"\"\"\nimport cProfile\nimport pickle\nimport sys\nimport time\nimport numpy as np\nimport method\nimport research_validation as r\n\nROOT = '/tmp/forecast_turn_periodic/'\nstarted, cpu = time.monotonic(), time.process_time()\nfv = dict(np.load('/workspace/public_assets/dev_features.npz'))\nif sys.argv[1] == 'reload':\n    with open(ROOT + 'runtime.state', 'rb') as inp:\n        state = pickle.load(inp)\n    with open(ROOT + 'runtime.prediction', 'rb') as inp:\n        control = pickle.load(inp)\n    prediction = method.predict(state, fv)\n    print('reload wall', time.monotonic() - started, 'CPU', time.process_time() - cpu,\n          'maxdiff', np.max(np.abs(control - prediction)),\n          'finite', np.isfinite(prediction).all(), 'shape', prediction.shape, flush=True)\nelse:\n    f, y = r.load()\n    profiler = cProfile.Profile()\n    profiler.enable()\n    state = method.fit(f, y, int(sys.argv[1]))\n    profiler.disable()\n    profiler.dump_stats(ROOT + 'fit.profile')\n    print('fit wall', time.monotonic() - started, 'CPU', time.process_time() - cpu,\n          'epochs', [m['epochs'] for m in state['network']['members']], flush=True)\n    payload = pickle.dumps(state)\n    with open(ROOT + 'runtime.state', 'wb') as out:\n        out.write(payload)\n    prediction = method.predict(state, fv)\n    with open(ROOT + 'runtime.prediction', 'wb') as out:\n        pickle.dump(prediction, out)\n    print('state bytes', len(payload), 'finite', np.isfinite(prediction).all(),\n          'shape', prediction.shape, flush=True)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/sh -lc 'cat research_validation.py'","aggregated_output":"\"\"\"Public calibration origin-block comparisons; never reads development targets.\"\"\"\nimport time\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport tree_calibration\nimport spatial_calibration\n\n\ndef load():\n    features = dict(np.load('/workspace/public_assets/train_features.npz'))\n    targets = np.load('/workspace/public_assets/train_targets.npz')['target']\n    return features, targets\n\n\ndef subset(features, index):\n    return {key: value[index] for key, value in features.items()}\n\n\ndef mae(target, prediction):\n    valid = np.isfinite(target) & (target > 0)\n    return float(np.mean(np.abs(target[valid] - prediction[valid])))\n\n\ndef evaluate(fit, predict, name, splits=None):\n    features, targets = load()\n    if splits is None:\n        splits = [(np.arange(50), np.arange(50, 74)),\n                  (np.r_[0:25, 49:74], np.arange(25, 49))]\n    start = time.monotonic()\n    output = []\n    for train, test in splits:\n        state = fit(subset(features, train), targets[train], 17)\n        pred = predict(state, subset(features, test))\n        value = mae(targets[test], pred)\n        output.append(value)\n        print(name, 'test', test[0], test[-1], 'MAE', value,\n              'elapsed', round(time.monotonic() - start, 2), flush=True)\n    return output\n\n\nif __name__ == '__main__':\n    with threadpool_limits(limits=2):\n        evaluate(tree_calibration.fit, tree_calibration.predict, 'retained')\n        for variant in ['neighbors', 'relative']:\n            evaluate(lambda f, y, s: spatial_calibration.fit(f, y, s, variant=variant),\n                     spatial_calibration.predict, variant)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/sh -lc 'cat /tmp/forecast_turn_adaptive/robust_validation.py'","aggregated_output":"import pickle,time\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport conditional_calibration as c\nimport spatial_calibration as s\nimport neural_calibration as n\nimport research_validation as r\nfrom factor_validation import components_input,factor_fit\nROOT='/tmp/forecast_turn_adaptive/'\ndef pooling_weights(state,f):\n graph=state['graph'];neighbors=graph['neighbors'];scale=graph['scale']\n a=(f['anchor']-f['base'])/scale\n recent=(np.mean(f['history'][:,-3:,:],axis=1)[:,None,:]-f['base'])/scale\n dist=((a[...,neighbors]-a[...,None])**2+(recent[...,neighbors]-recent[...,None])**2)/2\n weights=graph['weights']*(1/(1+dist))\n return weights/np.maximum(weights.sum(axis=-1,keepdims=True),1e-8)\n\ndef fit(state,f,p):\n state=factor_fit(state,f,p)\n _,z=components_input(state,f,p)\n neighbors=state['graph']['neighbors']\n diff=z[...,neighbors]-z[...,None]\n state['threshold']=np.maximum(3*np.median(np.abs(diff),axis=(0,1,3)),.05)\n return state\n\ndef predict(state,f,p,mode):\n seasonal,z=components_input(state,f,p)\n graph=state['graph'];neighbors=graph['neighbors'];scale=graph['scale']\n weights=pooling_weights(state,f)\n if mode=='factor_only':\n  factor=(z@state['factors'])@state['factors'].T\n  difference=factor[...,neighbors]-factor[...,None]\n else:\n  difference=z[...,neighbors]-z[...,None]\n  threshold=state['threshold'][:,None]\n  if mode=='hard':difference=np.clip(difference,-threshold,threshold)\n  else:difference=threshold*np.tanh(difference/threshold)\n value=z+.25*np.sum(weights*difference,axis=-1)\n return np.maximum(f['base']+seasonal+value*scale,0)\n\nif __name__=='__main__':\n start=time.monotonic()\n with threadpool_limits(limits=1):\n  for split in ['last','middle','first']:\n   if split=='first':\n    with open(ROOT+'first.cache','rb') as inp:q=pickle.load(inp)\n    raw_o,raw_v=q['network_oof'],q['network']\n   else:\n    with open('/tmp/forecast_turn_residual/'+split+'.cache','rb') as inp:q=pickle.load(inp)\n    with open('/tmp/forecast_turn_graph/'+split+'.budget_replica','rb') as inp:ens=pickle.load(inp)\n    raw_o,raw_v=ens['network_oof'],n.predict(ens['network'],q['fv'])\n   diff=fit(s.diffusion_fit(q['ft'],raw_o),q['ft'],raw_o)\n   outputs={}\n   for mode in ['factor_only','hard','smooth']:\n    no=predict(diff,q['ft'],raw_o,mode);nv=predict(diff,q['fv'],raw_v,mode)\n    gate=c._gate_fit(q['ft'],q['yt'],q['to'],no,mode='site_neighbor_horizon')\n    blend=c._blend(gate,q['fv'],q['tree'],nv)\n    stage=c._residual_tree_fit(q['ft'],q['yt'],q['to'],no,17,'site_neighbor_horizon',diffuse='context')\n    pred=c._residual_tree_predict(stage,q['fv'],q['tree'],nv,blend)\n    outputs[mode]={'diffusion':diff,'gate':gate,'stage':stage,'prediction':pred,'mae':r.mae(q['yv'],pred)}\n    print(split,'conditional pooling',mode,'MAE',r.mae(q['yv'],pred),'median threshold',float(np.median(diff['threshold'])),'wall',round(time.monotonic()-start,1),flush=True)\n   with open(ROOT+split+'.robust','wb') as out:pickle.dump(outputs,out)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/sh -lc 'cat neural_calibration.py'","aggregated_output":"\"\"\"Small NumPy residual network trained with a smooth absolute-error objective.\"\"\"\nimport time\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport spatial_calibration\n\n\ndef _features(features, graph, mode='summary'):\n    raw = spatial_calibration._features(features, graph)\n    node = raw[:, 14].astype(np.int64)\n    clock = np.asarray(features['clock']).reshape(-1)\n    periodic = [np.sin(2 * np.pi * clock), np.cos(2 * np.pi * clock),\n                np.sin(4 * np.pi * clock), np.cos(4 * np.pi * clock)]\n    columns = [np.delete(raw, 14, axis=1)] + periodic\n    if mode == 'network_context':\n        base = np.asarray(features['base'], dtype=np.float32)\n        anchor = np.asarray(features['anchor'], dtype=np.float32)\n        history = np.asarray(features['history'], dtype=np.float32)\n        recent = np.mean(history[:, -3:, :], axis=1)[:, None, :]\n        scale = np.maximum(np.mean(history, axis=1)[:, None, :], 30)\n        anchor_difference = np.clip((anchor - base) / scale, -2, 2)\n        recent_difference = np.clip((recent - base) / scale, -2, 2)\n        summaries = [np.mean(np.clip(base / scale, 0, 3), axis=-1, keepdims=True),\n                     np.mean(anchor_difference, axis=-1, keepdims=True),\n                     np.mean(recent_difference, axis=-1, keepdims=True),\n                     np.std(anchor_difference, axis=-1, keepdims=True)]\n        columns += [np.broadcast_to(value, base.shape).reshape(-1) for value in summaries]\n    if mode in ('history', 'relative'):\n        base = np.asarray(features['base'], dtype=np.float32)\n        history = np.asarray(features['history'], dtype=np.float32)\n        recent = np.mean(history[:, -3:, :], axis=1)[:, None, :]\n        # The shared network can learn a temporal filter rather than relying\n        # only on fixed three/six-step averages and one trend statistic.\n        columns += [np.broadcast_to(history[:, j:j+1, :] - recent, base.shape).reshape(-1)\n                    for j in range(history.shape[1])]\n        columns += [(base[:, :1, :] - base).reshape(-1),\n                    (base[:, -1:, :] - base).reshape(-1)]\n        if mode == 'relative':\n            anchor = np.asarray(features['anchor'], dtype=np.float32)\n            scale = graph['scale']\n            columns += [np.broadcast_to(scale, base.shape).reshape(-1),\n                        (base / scale).reshape(-1),\n                        ((anchor - base) / scale).reshape(-1),\n                        ((recent - base) / scale).reshape(-1)]\n    return np.column_stack(columns), node\n\n\ndef _head_features(features, mode=True):\n    shape = features['base'].shape\n    clock = np.asarray(features['clock'], dtype=np.float32).reshape(-1)\n    horizon = np.broadcast_to(np.linspace(-1, 1, shape[1])[None, :, None], shape).reshape(-1)\n    if mode == 'trend':\n        return np.column_stack([np.ones_like(clock), horizon]).astype(np.float32)\n    columns = [np.ones_like(clock), horizon,\n               np.sin(2 * np.pi * clock), np.cos(2 * np.pi * clock),\n               np.sin(4 * np.pi * clock), np.cos(4 * np.pi * clock)]\n    if mode == 'innovation':\n        base = np.asarray(features['base'], dtype=np.float32)\n        anchor = np.asarray(features['anchor'], dtype=np.float32)\n        history = np.asarray(features['history'], dtype=np.float32)\n        scale = np.maximum(np.mean(history, axis=1)[:, None, :], 30)\n        recent = np.mean(history[:, -3:, :], axis=1)[:, None, :]\n        last = history[:, -1:, :]\n        columns.extend([np.clip((anchor - base) / scale, -1.5, 1.5).reshape(-1),\n                        np.clip((recent - base) / scale, -1.5, 1.5).reshape(-1),\n                        np.broadcast_to(np.clip((last - recent) / scale, -1, 1), shape).reshape(-1)])\n    return np.column_stack(columns).astype(np.float32)\n\n\ndef _forward(x, node, params, head_x=None):\n    xx = np.column_stack([x, params['embedding'][node]])\n    h1 = np.tanh(xx @ params['w1'] + params['b1'])\n    h2 = np.tanh(h1 @ params['w2'] + params['b2'])\n    output = (h2 @ params['w3'] + x @ params['w0'] + params['b3']).reshape(-1)\n    if 'site_head' in params:\n        output += np.sum(head_x * params['site_head'][node], axis=1)\n    return output, (xx, h1, h2)\n\n\ndef _node_gradient(node, values, nodes):\n    return np.column_stack([\n        np.bincount(node, weights=values[:, j], minlength=nodes)\n        for j in range(values.shape[1])]).astype(np.float32)\n\n\ndef fit(features, targets, seed, epochs=100, graph=None, mode='summary', site_head=False, average=False,\n        graph_strength=0.005, embedding_strength=0, replicas=1):\n    if replicas > 1:\n        members = [fit(features, targets, seed + 1009 * j,\n                       epochs[j] if isinstance(epochs, (tuple, list)) else epochs, graph,\n                       mode[j] if isinstance(mode, (tuple, list)) else mode,\n                       site_head, average, graph_strength, embedding_strength)\n                   for j in range(replicas)]\n        return {'members': members}\n    with threadpool_limits(limits=1):\n        start = time.monotonic()\n        rng = np.random.default_rng(seed)\n        if graph is None:\n            graph = spatial_calibration._neighborhood(features)\n        x, node = _features(features, graph, mode)\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets)\n        valid = (np.isfinite(y) & (y > 0)).reshape(-1)\n        residual = (y - np.asarray(features['base'])).reshape(-1)[valid]\n        if mode == 'scaled_summary':\n            normalizer = graph['scale'][node[valid]]\n            residual = residual / normalizer\n        else:\n            residual = residual / 20\n        x, node = x[valid], node[valid]\n        head_x = _head_features(features, site_head)[valid] if site_head else None\n        laplacian = None\n        if site_head in ('graph', 'graph_horizon', 'innovation') or embedding_strength:\n            adjacency = np.zeros((features['base'].shape[-1], features['base'].shape[-1]), dtype=np.float32)\n            np.put_along_axis(adjacency, graph['neighbors'], graph['weights'], axis=1)\n            adjacency = (adjacency + adjacency.T) / 2\n            laplacian = np.diag(adjacency.sum(axis=1)) - adjacency\n        center = np.mean(x, axis=0)\n        scale = np.maximum(np.std(x, axis=0), 0.01)\n        x = np.clip((x - center) / scale, -8, 8).astype(np.float32)\n        dim = x.shape[1] + 6\n        params = {'embedding': (rng.normal(size=(features['base'].shape[-1], 6)) * 0.05).astype(np.float32),\n                  'w1': (rng.normal(size=(dim, 48)) / np.sqrt(dim)).astype(np.float32),\n                  'b1': np.zeros(48, dtype=np.float32),\n                  'w2': (rng.normal(size=(48, 24)) / np.sqrt(48)).astype(np.float32),\n                  'b2': np.zeros(24, dtype=np.float32),\n                  'w0': np.zeros((x.shape[1], 1), dtype=np.float32),\n                  'w3': np.zeros((24, 1), dtype=np.float32),\n                  'b3': np.array([np.median(residual)], dtype=np.float32)}\n        if site_head:\n            params['site_head'] = np.zeros((features['base'].shape[-1], head_x.shape[1]), dtype=np.float32)\n        first = {k: np.zeros_like(v) for k, v in params.items()}\n        second = {k: np.zeros_like(v) for k, v in params.items()}\n        average_params = {k: np.zeros_like(v) for k, v in params.items()} if average else None\n        average_count = 0\n        step = 0\n        for epoch in range(epochs):\n            order = rng.permutation(x.shape[0])\n            rate = 0.003 * (0.35 + 0.65 * (1 - epoch / epochs))\n            for offset in range(0, len(order), 4096):\n                index = order[offset:offset + 4096]\n                output, (xx, h1, h2) = _forward(x[index], node[index], params,\n                                             head_x[index] if site_head else None)\n                error = output - residual[index]\n                if mode == 'scaled_summary':\n                    local_scale = normalizer[index]\n                    dout = (error / np.sqrt(error * error + (2 / local_scale) ** 2)\n                            * local_scale / 20 / len(index))[:, None]\n                else:\n                    dout = (error / np.sqrt(error * error + 0.01) / len(index))[:, None]\n                gradients = {'w0': x[index].T @ dout, 'w3': h2.T @ dout, 'b3': dout.sum(axis=0)}\n                dh2 = (dout @ params['w3'].T) * (1 - h2 * h2)\n                gradients.update(w2=h1.T @ dh2, b2=dh2.sum(axis=0))\n                dh1 = (dh2 @ params['w2'].T) * (1 - h1 * h1)\n                gradients.update(w1=xx.T @ dh1, b1=dh1.sum(axis=0))\n                dembed = dh1 @ params['w1'][-6:, :].T\n                gradients['embedding'] = _node_gradient(node[index], dembed, len(params['embedding']))\n                if site_head:\n                    gradients['site_head'] = _node_gradient(\n                        node[index], head_x[index] * dout, len(params['site_head']))\n                step += 1\n                for key, gradient in gradients.items():\n                    if key == 'site_head':\n                        gradient = gradient + params[key] * 0.0005\n                        if laplacian is not None:\n                            first_shared = 1 if site_head == 'graph_horizon' else 2\n                            gradient[:, first_shared:] += graph_strength * (laplacian @ params[key][:, first_shared:])\n                    elif key.startswith('w') or key == 'embedding':\n                        gradient = gradient + params[key] * 0.0002\n                        if key == 'embedding' and embedding_strength:\n                            gradient += embedding_strength * (laplacian @ params[key])\n                    first[key] = 0.9 * first[key] + 0.1 * gradient\n                    second[key] = 0.999 * second[key] + 0.001 * gradient * gradient\n                    corrected = first[key] / (1 - 0.9 ** step)\n                    variance = second[key] / (1 - 0.999 ** step)\n                    params[key] -= rate * corrected / (np.sqrt(variance) + 1e-7)\n            if average and epoch >= 3 * epochs // 4:\n                for key in params:\n                    average_params[key] += params[key]\n                average_count += 1\n            if time.monotonic() - start > 150:\n                break\n        state = {'graph': graph, 'center': center, 'scale': scale, 'params': params, 'mode': mode,\n                 'epochs': epoch + 1, 'fit_seconds': time.monotonic() - start, 'head_mode': site_head}\n        if mode == 'scaled_summary':\n            state['target_scale'] = graph['scale']\n        if average_count:\n            state['last_params'] = params\n            state['params'] = {key: value / average_count for key, value in average_params.items()}\n        return state\n\n\ndef replica_disagreement(state, features):\n    prediction = np.stack([predict(member, features) for member in state['members']])\n    return 2 * np.std(prediction, axis=0)\n\n\ndef predict(state, features):\n    if 'members' in state:\n        return np.mean([predict(member, features) for member in state['members']], axis=0)\n    with threadpool_limits(limits=1):\n        x, node = _features(features, state['graph'], state.get('mode', 'summary'))\n        x = np.clip((x - state['center']) / state['scale'], -8, 8).astype(np.float32)\n        head_x = _head_features(features, state.get('head_mode', True)) if 'site_head' in state['params'] else None\n        residual = np.empty(x.shape[0], dtype=np.float32)\n        for offset in range(0, len(x), 8192):\n            end = offset + 8192\n            multiplier = state['target_scale'][node[offset:end]] if 'target_scale' in state else 20\n            residual[offset:end] = _forward(x[offset:end], node[offset:end], state['params'],\n                                          head_x[offset:end] if head_x is not None else None)[0] * multiplier\n        return np.maximum(np.asarray(features['base']) + residual.reshape(features['base'].shape), 0).astype(np.float32)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/sh -lc 'cat spatial_calibration.py'","aggregated_output":"\"\"\"Median residual trees with neighborhoods learned from calibration history.\"\"\"\nimport numpy as np\nfrom sklearn.ensemble import HistGradientBoostingRegressor\nfrom threadpoolctl import threadpool_limits\nimport tree_calibration\n\n\ndef _neighborhood(features, count=8):\n    history = np.asarray(features['history'], dtype=np.float64)\n    changes = np.diff(history, axis=1).reshape(-1, history.shape[2])\n    changes -= np.mean(changes, axis=0)\n    scale = np.maximum(np.std(history.reshape(-1, history.shape[2]), axis=0), 10)\n    norm = np.sqrt(np.sum(changes * changes, axis=0))\n    correlation = (changes.T @ changes) / np.maximum(norm[:, None] * norm[None, :], 1)\n    np.fill_diagonal(correlation, -1)\n    neighbors = np.argsort(correlation, axis=1)[:, -count:]\n    weights = np.maximum(np.take_along_axis(correlation, neighbors, axis=1), 0) ** 2\n    weights /= np.maximum(weights.sum(axis=1, keepdims=True), 1e-8)\n    return {'neighbors': neighbors, 'weights': weights.astype(np.float32),\n            'scale': scale.astype(np.float32)}\n\n\ndef _features(features, graph, variant='neighbors'):\n    x = tree_calibration._features(features)\n    base = np.asarray(features['base'], dtype=np.float32)\n    anchor = np.asarray(features['anchor'], dtype=np.float32)\n    history = np.asarray(features['history'], dtype=np.float32)\n    scale = graph['scale']\n    def aggregate(value):\n        normalized = value / scale\n        mean = np.sum(normalized[..., graph['neighbors']] * graph['weights'], axis=-1)\n        return mean * scale\n    recent = np.mean(history[:, -3:, :], axis=1)[:, None, :]\n    older = np.mean(history[:, :3, :], axis=1)[:, None, :]\n    last = history[:, -1:, :]\n    spread = np.std(history, axis=1)[:, None, :]\n    extra = [aggregate(anchor - base), aggregate(recent - base),\n             aggregate(last - base), np.broadcast_to(aggregate(recent - older), base.shape),\n             np.broadcast_to(aggregate(spread), base.shape)]\n    if variant == 'relative':\n        extra.extend([(anchor - base) / scale, (recent - base) / scale,\n                      np.broadcast_to(spread / scale, base.shape),\n                      base / np.maximum(anchor, 30),\n                      aggregate(anchor - base) - (anchor - base)])\n    if 'physical' in graph:\n        def physical(value):\n            return ((value / scale) @ graph['physical'].T) * scale\n        extra.extend([physical(anchor - base), physical(recent - base),\n                      physical(last - base),\n                      np.broadcast_to(physical(recent - older), base.shape),\n                      np.broadcast_to(physical(spread), base.shape)])\n    return np.column_stack([x] + [v.reshape(-1) for v in extra])\n\n\ndef fit(features, targets, seed, variant='neighbors', max_iter=90, graph=None):\n    with threadpool_limits(limits=1):\n        if graph is None:\n            graph = _neighborhood(features)\n        x = _features(features, graph, variant)\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets)\n        valid = np.isfinite(y) & (y > 0)\n        residual = y - np.asarray(features['base'])\n        model = HistGradientBoostingRegressor(\n            loss='absolute_error', max_iter=max_iter, learning_rate=0.06,\n            max_leaf_nodes=15, min_samples_leaf=250, l2_regularization=20,\n            categorical_features=[14], early_stopping=False, random_state=seed)\n        model.fit(x[valid.ravel()], residual[valid])\n        return {'graph': graph, 'variant': variant, 'model': model}\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=1):\n        x = _features(features, state['graph'], state['variant'])\n        residual = state['model'].predict(x).reshape(features['base'].shape)\n        return np.maximum(np.asarray(features['base']) + residual, 0).astype(np.float32)\n\n\ndef diffusion_fit(features, prediction, robust=False):\n    shape = features['base'].shape\n    clock = np.asarray(features['clock'], dtype=np.float64)\n    horizon = np.broadcast_to(np.linspace(-1, 1, shape[1])[None, :, None], shape)\n    x = np.stack([np.ones(shape), horizon, np.sin(2 * np.pi * clock),\n                  np.cos(2 * np.pi * clock), np.sin(4 * np.pi * clock),\n                  np.cos(4 * np.pi * clock)], axis=-1)\n    residual = prediction - features['base']\n    gram = np.einsum('shni,shnj->nij', x, x, optimize=True)\n    rhs = np.einsum('shni,shn->ni', x, residual, optimize=True)\n    ridge = np.diag([0, 1, 1, 1, 1, 1]) * shape[0] * shape[1] * 0.05\n    coef = np.linalg.solve(gram + ridge, rhs[..., None])[..., 0]\n    state = {'graph': _neighborhood(features), 'coef': coef.astype(np.float32)}\n    if robust:\n        seasonal = np.einsum('shni,ni->shn', x, state['coef'])\n        normalized = (prediction - features['base'] - seasonal) / state['graph']['scale']\n        difference = (normalized[..., state['graph']['neighbors']]\n                      - normalized[..., None])\n        # A forecast-only scale for each sensor bounds the influence of large\n        # disagreements without fitting any additional target-dependent rule.\n        state['threshold'] = np.maximum(\n            3 * np.median(np.abs(difference), axis=(0, 1, 3)), 0.05)\n    return state\n\n\ndef diffusion_predict(state, features, prediction):\n    shape = features['base'].shape\n    clock = np.asarray(features['clock'], dtype=np.float64)\n    horizon = np.broadcast_to(np.linspace(-1, 1, shape[1])[None, :, None], shape)\n    x = np.stack([np.ones(shape), horizon, np.sin(2 * np.pi * clock),\n                  np.cos(2 * np.pi * clock), np.sin(4 * np.pi * clock),\n                  np.cos(4 * np.pi * clock)], axis=-1)\n    seasonal = np.einsum('shni,ni->shn', x, state['coef'])\n    innovation = prediction - features['base'] - seasonal\n    graph = state['graph']\n    normalized = innovation / graph['scale']\n    pooling = state.get('pooling', 'static')\n    if pooling == 'static':\n        neighbor = np.sum(normalized[..., graph['neighbors']] * graph['weights'], axis=-1)\n        neighbor *= graph['scale']\n        return np.maximum(features['base'] + seasonal + 0.75 * innovation + 0.25 * neighbor, 0)\n    # A fixed history graph can connect sensors experiencing different current\n    # deviations. Share changing corrections preferentially along edges whose\n    # known anchor/base and recent-history/base disagreements currently match.\n    scale = graph['scale']\n    neighbors = graph['neighbors']\n    anchor = (np.asarray(features['anchor']) - features['base']) / scale\n    recent = (np.mean(features['history'][:, -3:, :], axis=1)[:, None, :]\n              - features['base']) / scale\n    distance = ((anchor[..., neighbors] - anchor[..., None]) ** 2\n                + (recent[..., neighbors] - recent[..., None]) ** 2) / 2\n    affinity = 1 / (1 + distance)\n    weights = graph['weights'] * affinity\n    if pooling == 'context_normalize':\n        weights /= np.maximum(weights.sum(axis=-1, keepdims=True), 1e-8)\n    difference = normalized[..., neighbors] - normalized[..., None]\n    if 'threshold' in state:\n        threshold = state['threshold'][:, None]\n        difference = threshold * np.tanh(difference / threshold)\n    shared = normalized + 0.25 * np.sum(weights * difference, axis=-1)\n    return np.maximum(features['base'] + seasonal + shared * scale, 0)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/sh -lc 'cat /tmp/forecast_turn_adaptive/adaptive_validation.py'","aggregated_output":"import pickle,time\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport conditional_calibration as c\nimport spatial_calibration as s\nimport research_validation as r\nimport neural_calibration as n\n\nROOT='/tmp/forecast_turn_adaptive/'\ndef diffuse(state,f,p,mode):\n shape=f['base'].shape\n clock=np.asarray(f['clock'],dtype=np.float64)\n horizon=np.broadcast_to(np.linspace(-1,1,shape[1])[None,:,None],shape)\n x=np.stack([np.ones(shape),horizon,np.sin(2*np.pi*clock),np.cos(2*np.pi*clock),np.sin(4*np.pi*clock),np.cos(4*np.pi*clock)],axis=-1)\n seasonal=np.einsum('shni,ni->shn',x,state['coef'])\n innovation=p-f['base']-seasonal\n graph=state['graph'];scale=graph['scale'];neigh=graph['neighbors']\n zi=innovation/scale\n zj=zi[...,neigh]\n weights=graph['weights']\n if mode=='median':\n  order=np.argsort(zj,axis=-1)\n  sorted_weight=np.take_along_axis(np.broadcast_to(weights,zj.shape),order,axis=-1)\n  sorted_value=np.take_along_axis(zj,order,axis=-1)\n  index=(np.cumsum(sorted_weight,axis=-1)<.5).sum(axis=-1)\n  neighbor=np.take_along_axis(sorted_value,np.minimum(index,7)[...,None],axis=-1)[...,0]\n  value=.75*zi+.25*neighbor\n else:\n  anchor=(f['anchor']-f['base'])/scale\n  recent=(np.mean(f['history'][:,-3:,:],axis=1)[:,None,:]-f['base'])/scale\n  if mode.startswith('history'):\n   recent=(np.mean(f['history'][:,-3:,:],axis=1)-np.mean(f['history'][:,:3,:],axis=1))[:,None,:]/scale\n   z=recent\n   dist=(z[...,neigh]-z[...,None])**2\n  elif mode.startswith('innovation'):\n   dist=(zj-zi[...,None])**2\n  else:\n   dist=((anchor[...,neigh]-anchor[...,None])**2+(recent[...,neigh]-recent[...,None])**2)/2\n  affinity=1/(1+dist)\n  weights=weights*affinity\n  if mode.endswith('normalize'):\n   weights=weights/np.maximum(weights.sum(axis=-1,keepdims=True),1e-8)\n  value=zi+.25*np.sum(weights*(zj-zi[...,None]),axis=-1)\n return np.maximum(f['base']+seasonal+value*scale,0)\n\nif __name__=='__main__':\n start=time.monotonic()\n with threadpool_limits(limits=1):\n  for split in ['last','middle']:\n   with open('/tmp/forecast_turn_residual/'+split+'.cache','rb') as inp:q=pickle.load(inp)\n   with open('/tmp/forecast_turn_graph/'+split+'.budget_replica','rb') as inp:ens=pickle.load(inp)\n   with open('/tmp/forecast_turn_residual/'+split+'.diffusion_stage','rb') as inp:stage=pickle.load(inp)\n   st=stage['stage'];model=st['model']\n   xv=c._residual_tree_design(q['fv'],q['tree'],q['network'],q['blend'])\n   correction=np.clip(model.predict(xv).reshape(q['yv'].shape),-10,10)\n   print(split,'old best',r.mae(q['yv'],q['control']),'pending diffusion best',r.mae(q['yv'],stage['prediction']),flush=True)\n   outputs={}\n   for mode in ['median','context_attenuate','context_normalize','history_attenuate','history_normalize','innovation_attenuate','innovation_normalize']:\n    residual=diffuse(st['diffusion'],q['fv'],q['fv']['base']+correction,mode)-q['fv']['base']\n    pred=np.maximum(q['blend']+residual,0)\n    outputs['residual',mode]={'prediction':pred,'mae':r.mae(q['yv'],pred)}\n    print(split,'residual',mode,r.mae(q['yv'],pred),flush=True)\n   raw_v=n.predict(ens['network'],q['fv'])\n   for mode in ['median','context_attenuate','context_normalize','history_attenuate','innovation_attenuate']:\n    no=diffuse(ens[True]['diffusion'],q['ft'],ens['network_oof'],mode)\n    nv=diffuse(ens[True]['diffusion'],q['fv'],raw_v,mode)\n    gate=c._gate_fit(q['ft'],q['yt'],q['to'],no,mode='site_neighbor_horizon')\n    blend=c._blend(gate,q['fv'],q['tree'],nv)\n    stage_new=c._residual_tree_fit(q['ft'],q['yt'],q['to'],no,17,'site_neighbor_horizon',diffuse=True)\n    pred=c._residual_tree_predict(stage_new,q['fv'],q['tree'],nv,blend)\n    outputs['network',mode]={'gate':gate,'stage':stage_new,'prediction':pred,'mae':r.mae(q['yv'],pred)}\n    print(split,'network',mode,r.mae(q['yv'],pred),'elapsed',round(time.monotonic()-start,1),flush=True)\n   with open(ROOT+split+'.adaptive','wb') as out:pickle.dump(outputs,out)\n","exit_code":0,"status":"completed"}}

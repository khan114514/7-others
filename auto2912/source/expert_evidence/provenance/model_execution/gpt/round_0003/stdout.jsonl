{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/sh -lc \"sed -n '1,220p' solve.sh; printf '\\\\n---MODULES---\\\\n'; for f in calibration.py blended_calibration.py dynamics_calibration.py spatial_calibration.py; do echo ===\"'$f; sed -n '\"'1,180p' \"'$f; done'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/sh -lc \"sed -n '1,220p' solve.sh; printf '\\\\n---MODULES---\\\\n'; for f in calibration.py blended_calibration.py dynamics_calibration.py spatial_calibration.py; do echo ===\"'$f; sed -n '\"'1,180p' \"'$f; done'","aggregated_output":"#!/bin/sh\nset -eu\npython /opt/forecast-engine/evaluate.py --solution /workspace/solution\n\n---MODULES---\n===calibration.py\n\"\"\"Robust hierarchical residual calibration of fixed traffic forecasts.\"\"\"\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\n\n\ndef _design(features):\n    b = np.asarray(features['base'], dtype=np.float64)\n    a = np.asarray(features['anchor'], dtype=np.float64)\n    hist = np.asarray(features['history'], dtype=np.float64)\n    clock = np.asarray(features['clock'], dtype=np.float64)\n    hh = np.broadcast_to(np.linspace(-1.0, 1.0, b.shape[1])[None, :, None], b.shape)\n    recent = np.broadcast_to(np.median(hist[:, -3:, :], axis=1)[:, None, :], b.shape)\n    older = np.broadcast_to(np.median(hist[:, :6, :], axis=1)[:, None, :], b.shape)\n    allmean = np.broadcast_to(np.mean(hist, axis=1)[:, None, :], b.shape)\n    sine = np.sin(2 * np.pi * clock)\n    cosine = np.cos(2 * np.pi * clock)\n    anchor = np.clip((a - b) / 50, -5, 5)\n    level = b / 300\n    recent_delta = np.clip((recent - b) / 50, -5, 5)\n    trend = np.clip((recent - older) / 50, -5, 5)\n    arr = [np.ones_like(b), hh, hh * hh, sine, cosine,\n           np.sin(4 * np.pi * clock), np.cos(4 * np.pi * clock),\n           level, anchor, anchor * hh, recent_delta, recent_delta * hh,\n           np.clip((allmean - b) / 50, -5, 5), trend, trend * hh,\n           sine * hh, cosine * hh, sine * level, cosine * level]\n    return np.stack(arr, axis=-1)\n\n\ndef _global_fit(x, y, valid, iterations=8):\n    xx = x.reshape(-1, x.shape[-1])\n    yy = y.reshape(-1)\n    ok = valid.reshape(-1)\n    xx = xx[ok]\n    yy = yy[ok]\n    coef = np.zeros(xx.shape[1])\n    penalty = np.eye(xx.shape[1]) * 2.0\n    for _ in range(iterations):\n        residual = yy - xx @ coef\n        w = 1.0 / np.maximum(np.abs(residual), 4.0)\n        coef = np.linalg.solve(xx.T @ (w[:, None] * xx) + penalty,\n                               xx.T @ (w * yy))\n    return coef\n\n\ndef fit(features, targets, seed):\n    with threadpool_limits(limits=2):\n        x = _design(features)\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets,\n                       dtype=np.float64)\n        base = np.asarray(features['base'], dtype=np.float64)\n        valid = np.isfinite(y) & (y > 0)\n        y = np.where(valid, y - base, 0)\n        global_coef = _global_fit(x, y, valid)\n        # Every sensor gets a regularized deviation from the pooled model.\n        xx = x.transpose(2, 0, 1, 3).reshape(x.shape[2], -1, x.shape[-1])\n        yy = y.transpose(2, 0, 1).reshape(x.shape[2], -1)\n        mask = valid.transpose(2, 0, 1).reshape(x.shape[2], -1)\n        prior = np.broadcast_to(global_coef, (x.shape[2], x.shape[-1])).copy()\n        coef = prior.copy()\n        strength = np.array([3, 20, 40, 15, 15, 30, 30,\n                             60, 40, 80, 60, 100, 60, 80, 100,\n                             50, 50, 60, 60], dtype=np.float64)\n        reg = np.diag(strength)\n        for _ in range(8):\n            residual = yy - np.einsum('nrp,np->nr', xx, coef)\n            w = mask / np.maximum(np.abs(residual), 4.0)\n            gram = np.einsum('nrp,nr,nrq->npq', xx, w, xx, optimize=True)\n            rhs = np.einsum('nrp,nr,nr->np', xx, w, yy, optimize=True)\n            coef = np.linalg.solve(gram + reg, (rhs + prior * strength)[..., None])[..., 0]\n        return {'version': 2, 'coef': coef.astype(np.float32)}\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=2):\n        x = _design(features)\n        correction = np.einsum('shnp,np->shn', x, np.asarray(state['coef']))\n        return np.maximum(np.asarray(features['base']) + correction, 0).astype(np.float32)\n===blended_calibration.py\n\"\"\"Horizon-specific median trees blended with a smooth residual network.\"\"\"\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport horizon_calibration\nimport neural_calibration\n\n\ndef fit(features, targets, seed, graph=None):\n    with threadpool_limits(limits=2):\n        return {'tree': horizon_calibration.fit(features, targets, seed, groups=2, graph=graph),\n                'network': neural_calibration.fit(features, targets, seed, graph=graph)}\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=2):\n        tree = horizon_calibration.predict(state['tree'], features)\n        network = neural_calibration.predict(state['network'], features)\n        return (0.75 * tree + 0.25 * network).astype(np.float32)\n===dynamics_calibration.py\n\"\"\"Residual trees with explicit history dynamics and sensor-level scaling.\"\"\"\nimport numpy as np\nfrom sklearn.ensemble import HistGradientBoostingRegressor\nfrom threadpoolctl import threadpool_limits\nimport tree_calibration\nimport spatial_calibration\n\n\ndef _profile(features):\n    history = np.asarray(features['history'], dtype=np.float32)\n    flat = history.reshape(-1, history.shape[-1])\n    return {'mean': np.maximum(np.mean(flat, axis=0), 10),\n            'std': np.maximum(np.std(flat, axis=0), 10),\n            'median': np.median(flat, axis=0),\n            'quartiles': np.percentile(flat, [10, 90], axis=0).astype(np.float32)}\n\n\ndef _features(f, state):\n    if state.get('neighbors'):\n        x = spatial_calibration._features(f, state['graph'])\n    else:\n        x = tree_calibration._features(f)\n    base = np.asarray(f['base'], dtype=np.float32)\n    anchor = np.asarray(f['anchor'], dtype=np.float32)\n    history = np.asarray(f['history'], dtype=np.float32)\n    def broadcast(v):\n        return np.broadcast_to(v, base.shape)\n    recent = np.mean(history[:, -3:, :], axis=1)[:, None, :]\n    extra = []\n    if state['variant'] in ('lags', 'both', 'robust'):\n        extra.extend([broadcast(history[:, j:j+1, :]) - base for j in (0, 3, 6, 8, 10)])\n        extra.extend([broadcast(base[:, :1, :]) - base,\n                      broadcast(base[:, -1:, :]) - base,\n                      broadcast(np.mean(base, axis=1, keepdims=True)) - base,\n                      broadcast(anchor[:, :1, :]) - anchor,\n                      broadcast(anchor[:, -1:, :]) - anchor,\n                      broadcast(np.median(history[:, -3:, :], axis=1)[:, None, :]) - base,\n                      broadcast(np.median(history, axis=1)[:, None, :]) - base])\n    if state['variant'] in ('profile', 'both', 'robust'):\n        profile = state['profile']\n        mean, std = profile['mean'], profile['std']\n        extra.extend([broadcast(mean), broadcast(std),\n                      base / mean, anchor / mean,\n                      (base - profile['median']) / std,\n                      (anchor - base) / std,\n                      (recent - base) / std])\n    if state['variant'] == 'robust':\n        spread = np.percentile(history, 75, axis=1) - np.percentile(history, 25, axis=1)\n        extra.extend([broadcast(spread[:, None, :]),\n                      broadcast(np.mean(history == 0, axis=1)[:, None, :]),\n                      (anchor - base) / np.maximum(anchor, 30),\n                      np.sin(2 * np.pi * f['clock']), np.cos(2 * np.pi * f['clock'])])\n    return np.column_stack([x] + [v.reshape(-1) for v in extra])\n\n\ndef fit(features, targets, seed, variant='both', neighbors=False, max_iter=90):\n    with threadpool_limits(limits=2):\n        state = {'variant': variant, 'profile': _profile(features), 'neighbors': neighbors}\n        if neighbors:\n            state['graph'] = spatial_calibration._neighborhood(features)\n        x = _features(features, state)\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets)\n        valid = np.isfinite(y) & (y > 0)\n        residual = y - np.asarray(features['base'])\n        model = HistGradientBoostingRegressor(\n            loss='absolute_error', max_iter=max_iter, learning_rate=0.06,\n            max_leaf_nodes=15, min_samples_leaf=250, l2_regularization=20,\n            categorical_features=[14], early_stopping=False, random_state=seed)\n        model.fit(x[valid.ravel()], residual[valid])\n        state['model'] = model\n        return state\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=2):\n        residual = state['model'].predict(_features(features, state)).reshape(features['base'].shape)\n        return np.maximum(np.asarray(features['base']) + residual, 0).astype(np.float32)\n===spatial_calibration.py\n\"\"\"Median residual trees with neighborhoods learned from calibration history.\"\"\"\nimport numpy as np\nfrom sklearn.ensemble import HistGradientBoostingRegressor\nfrom threadpoolctl import threadpool_limits\nimport tree_calibration\n\n\ndef _neighborhood(features, count=8):\n    history = np.asarray(features['history'], dtype=np.float64)\n    changes = np.diff(history, axis=1).reshape(-1, history.shape[2])\n    changes -= np.mean(changes, axis=0)\n    scale = np.maximum(np.std(history.reshape(-1, history.shape[2]), axis=0), 10)\n    norm = np.sqrt(np.sum(changes * changes, axis=0))\n    correlation = (changes.T @ changes) / np.maximum(norm[:, None] * norm[None, :], 1)\n    np.fill_diagonal(correlation, -1)\n    neighbors = np.argsort(correlation, axis=1)[:, -count:]\n    weights = np.maximum(np.take_along_axis(correlation, neighbors, axis=1), 0) ** 2\n    weights /= np.maximum(weights.sum(axis=1, keepdims=True), 1e-8)\n    return {'neighbors': neighbors, 'weights': weights.astype(np.float32),\n            'scale': scale.astype(np.float32)}\n\n\ndef _features(features, graph, variant='neighbors'):\n    x = tree_calibration._features(features)\n    base = np.asarray(features['base'], dtype=np.float32)\n    anchor = np.asarray(features['anchor'], dtype=np.float32)\n    history = np.asarray(features['history'], dtype=np.float32)\n    scale = graph['scale']\n    def aggregate(value):\n        normalized = value / scale\n        mean = np.sum(normalized[..., graph['neighbors']] * graph['weights'], axis=-1)\n        return mean * scale\n    recent = np.mean(history[:, -3:, :], axis=1)[:, None, :]\n    older = np.mean(history[:, :3, :], axis=1)[:, None, :]\n    last = history[:, -1:, :]\n    spread = np.std(history, axis=1)[:, None, :]\n    extra = [aggregate(anchor - base), aggregate(recent - base),\n             aggregate(last - base), np.broadcast_to(aggregate(recent - older), base.shape),\n             np.broadcast_to(aggregate(spread), base.shape)]\n    if variant == 'relative':\n        extra.extend([(anchor - base) / scale, (recent - base) / scale,\n                      np.broadcast_to(spread / scale, base.shape),\n                      base / np.maximum(anchor, 30),\n                      aggregate(anchor - base) - (anchor - base)])\n    if 'physical' in graph:\n        def physical(value):\n            return ((value / scale) @ graph['physical'].T) * scale\n        extra.extend([physical(anchor - base), physical(recent - base),\n                      physical(last - base),\n                      np.broadcast_to(physical(recent - older), base.shape),\n                      np.broadcast_to(physical(spread), base.shape)])\n    return np.column_stack([x] + [v.reshape(-1) for v in extra])\n\n\ndef fit(features, targets, seed, variant='neighbors', max_iter=90, graph=None):\n    with threadpool_limits(limits=2):\n        if graph is None:\n            graph = _neighborhood(features)\n        x = _features(features, graph, variant)\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets)\n        valid = np.isfinite(y) & (y > 0)\n        residual = y - np.asarray(features['base'])\n        model = HistGradientBoostingRegressor(\n            loss='absolute_error', max_iter=max_iter, learning_rate=0.06,\n            max_leaf_nodes=15, min_samples_leaf=250, l2_regularization=20,\n            categorical_features=[14], early_stopping=False, random_state=seed)\n        model.fit(x[valid.ravel()], residual[valid])\n        return {'graph': graph, 'variant': variant, 'model': model}\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=2):\n        x = _features(features, state['graph'], state['variant'])\n        residual = state['model'].predict(x).reshape(features['base'].shape)\n        return np.maximum(np.asarray(features['base']) + residual, 0).astype(np.float32)\n","exit_code":0,"status":"completed"}}

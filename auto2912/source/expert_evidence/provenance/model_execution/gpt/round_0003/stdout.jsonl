{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport numpy as np, blended_calibration, research_validation as rv\nfrom threadpoolctl import threadpool_limits\nf,y=rv.load(); splits=[(np.arange(50),np.arange(50,74)),(np.r_[0:25,49:74],np.arange(25,49))]\ndef sub(ix): return {k:v[ix] for k,v in f.items()}\ndef mae(t,p):\n o=np.isfinite(t)&(t>0); return np.mean(np.abs(t[o]-p[o]))\nfor mode in ['base','short','long']:\n vals=[]\n for tr,te in splits:\n  st=blended_calibration.fit(sub(tr),y[tr],17)\n  tree=blended_calibration.horizon_calibration.predict(st['tree'],sub(te))\n  net=blended_calibration.neural_calibration.predict(st['network'],sub(te))\n  h=np.arange(tree.shape[1])[None,:,None]\n  if mode=='base': w=.25\n  elif mode=='short': w=np.where(h<6,.32,.18)\n  else: w=np.where(h<6,.18,.32)\n  p=tree*(1-w)+net*w\n  vals.append(mae(y[te],p))\n print(mode,vals,np.mean(vals),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

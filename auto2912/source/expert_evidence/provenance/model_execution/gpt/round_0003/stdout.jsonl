{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/sh -lc \"sed -n '1,240p' neural_calibration.py\"","aggregated_output":"\"\"\"Small NumPy residual network trained with a smooth absolute-error objective.\"\"\"\nimport time\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport spatial_calibration\n\n\ndef _features(features, graph):\n    raw = spatial_calibration._features(features, graph)\n    node = raw[:, 14].astype(np.int64)\n    clock = np.asarray(features['clock']).reshape(-1)\n    periodic = [np.sin(2 * np.pi * clock), np.cos(2 * np.pi * clock),\n                np.sin(4 * np.pi * clock), np.cos(4 * np.pi * clock)]\n    return np.column_stack([np.delete(raw, 14, axis=1)] + periodic), node\n\n\ndef _forward(x, node, params):\n    xx = np.column_stack([x, params['embedding'][node]])\n    h1 = np.tanh(xx @ params['w1'] + params['b1'])\n    h2 = np.tanh(h1 @ params['w2'] + params['b2'])\n    output = (h2 @ params['w3'] + x @ params['w0'] + params['b3']).reshape(-1)\n    return output, (xx, h1, h2)\n\n\ndef fit(features, targets, seed, epochs=100, graph=None):\n    with threadpool_limits(limits=2):\n        start = time.monotonic()\n        rng = np.random.default_rng(seed)\n        if graph is None:\n            graph = spatial_calibration._neighborhood(features)\n        x, node = _features(features, graph)\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets)\n        valid = (np.isfinite(y) & (y > 0)).reshape(-1)\n        residual = (y - np.asarray(features['base'])).reshape(-1)[valid] / 20\n        x, node = x[valid], node[valid]\n        center = np.mean(x, axis=0)\n        scale = np.maximum(np.std(x, axis=0), 0.01)\n        x = np.clip((x - center) / scale, -8, 8).astype(np.float32)\n        dim = x.shape[1] + 6\n        params = {'embedding': (rng.normal(size=(features['base'].shape[-1], 6)) * 0.05).astype(np.float32),\n                  'w1': (rng.normal(size=(dim, 48)) / np.sqrt(dim)).astype(np.float32),\n                  'b1': np.zeros(48, dtype=np.float32),\n                  'w2': (rng.normal(size=(48, 24)) / np.sqrt(48)).astype(np.float32),\n                  'b2': np.zeros(24, dtype=np.float32),\n                  'w0': np.zeros((x.shape[1], 1), dtype=np.float32),\n                  'w3': np.zeros((24, 1), dtype=np.float32),\n                  'b3': np.array([np.median(residual)], dtype=np.float32)}\n        first = {k: np.zeros_like(v) for k, v in params.items()}\n        second = {k: np.zeros_like(v) for k, v in params.items()}\n        step = 0\n        for epoch in range(epochs):\n            order = rng.permutation(x.shape[0])\n            rate = 0.003 * (0.35 + 0.65 * (1 - epoch / epochs))\n            for offset in range(0, len(order), 4096):\n                index = order[offset:offset + 4096]\n                output, (xx, h1, h2) = _forward(x[index], node[index], params)\n                error = output - residual[index]\n                dout = (error / np.sqrt(error * error + 0.01) / len(index))[:, None]\n                gradients = {'w0': x[index].T @ dout, 'w3': h2.T @ dout, 'b3': dout.sum(axis=0)}\n                dh2 = (dout @ params['w3'].T) * (1 - h2 * h2)\n                gradients.update(w2=h1.T @ dh2, b2=dh2.sum(axis=0))\n                dh1 = (dh2 @ params['w2'].T) * (1 - h1 * h1)\n                gradients.update(w1=xx.T @ dh1, b1=dh1.sum(axis=0))\n                dembed = (dh1 @ params['w1'].T)[:, -6:]\n                gradients['embedding'] = np.zeros_like(params['embedding'])\n                np.add.at(gradients['embedding'], node[index], dembed)\n                step += 1\n                for key, gradient in gradients.items():\n                    if key.startswith('w') or key == 'embedding':\n                        gradient = gradient + params[key] * 0.0002\n                    first[key] = 0.9 * first[key] + 0.1 * gradient\n                    second[key] = 0.999 * second[key] + 0.001 * gradient * gradient\n                    corrected = first[key] / (1 - 0.9 ** step)\n                    variance = second[key] / (1 - 0.999 ** step)\n                    params[key] -= rate * corrected / (np.sqrt(variance) + 1e-7)\n            if time.monotonic() - start > 150:\n                break\n        return {'graph': graph, 'center': center, 'scale': scale, 'params': params,\n                'epochs': epoch + 1, 'fit_seconds': time.monotonic() - start}\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=2):\n        x, node = _features(features, state['graph'])\n        x = np.clip((x - state['center']) / state['scale'], -8, 8).astype(np.float32)\n        residual = np.empty(x.shape[0], dtype=np.float32)\n        for offset in range(0, len(x), 8192):\n            end = offset + 8192\n            residual[offset:end] = _forward(x[offset:end], node[offset:end], state['params'])[0] * 20\n        return np.maximum(np.asarray(features['base']) + residual.reshape(features['base'].shape), 0).astype(np.float32)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/sh -lc \"sed -n '1,260p' stacked_calibration.py\"","aggregated_output":"\"\"\"Cross-fitted tree forecasts with a smooth residual correction network.\"\"\"\nimport numpy as np\nfrom threadpoolctl import threadpool_limits\nimport horizon_calibration\nimport neural_calibration\n\n\ndef _with_base(features, base):\n    return {**features, 'base': base}\n\n\ndef fit(features, targets, seed):\n    with threadpool_limits(limits=2):\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets)\n        out_of_fold = np.zeros_like(y)\n        index = np.arange(len(y))\n        for held in np.array_split(index, 3):\n            train = np.setdiff1d(index, held)\n            fold = horizon_calibration.fit({k: v[train] for k, v in features.items()}, y[train], seed, groups=2)\n            out_of_fold[held] = horizon_calibration.predict(fold, {k: v[held] for k, v in features.items()})\n        network = neural_calibration.fit(_with_base(features, out_of_fold), y, seed)\n        tree = horizon_calibration.fit(features, y, seed, groups=2)\n        return {'tree': tree, 'network': network, 'correction_weight': 0.25}\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=2):\n        tree = horizon_calibration.predict(state['tree'], features)\n        corrected = neural_calibration.predict(state['network'], _with_base(features, tree))\n        weight = state['correction_weight']\n        return (tree * (1 - weight) + corrected * weight).astype(np.float32)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/sh -lc \"sed -n '1,220p' horizon_calibration.py\"","aggregated_output":"\"\"\"Partial pooling of median residual trees specialized by forecast horizon.\"\"\"\nimport numpy as np\nfrom sklearn.ensemble import HistGradientBoostingRegressor\nfrom threadpoolctl import threadpool_limits\nimport spatial_calibration\n\n\ndef _model(seed):\n    return HistGradientBoostingRegressor(\n        loss='absolute_error', max_iter=90, learning_rate=0.06,\n        max_leaf_nodes=15, min_samples_leaf=250, l2_regularization=20,\n        categorical_features=[14], early_stopping=False, random_state=seed)\n\n\ndef fit(features, targets, seed, groups=3, graph=None):\n    with threadpool_limits(limits=2):\n        pooled = spatial_calibration.fit(features, targets, seed, graph=graph)\n        x = spatial_calibration._features(features, pooled['graph'])\n        shape = features['base'].shape\n        x = x.reshape(*shape, -1)\n        y = np.asarray(targets['target'] if isinstance(targets, dict) else targets)\n        valid = np.isfinite(y) & (y > 0)\n        residual = y - np.asarray(features['base'])\n        models = []\n        for horizons in np.array_split(np.arange(shape[1]), groups):\n            xx = x[:, horizons].reshape(-1, x.shape[-1])\n            ok = valid[:, horizons].reshape(-1)\n            yy = residual[:, horizons].reshape(-1)\n            model = _model(seed)\n            model.fit(xx[ok], yy[ok])\n            models.append((horizons, model))\n        return {'pooled': pooled, 'models': models, 'expert_weight': 0.5}\n\n\ndef predict(state, features):\n    with threadpool_limits(limits=2):\n        shape = features['base'].shape\n        x = spatial_calibration._features(features, state['pooled']['graph']).reshape(*shape, -1)\n        expert = np.zeros(shape, dtype=np.float32)\n        for horizons, model in state['models']:\n            expert[:, horizons] = model.predict(x[:, horizons].reshape(-1, x.shape[-1])).reshape(shape[0], len(horizons), shape[2])\n        pooled = state['pooled']['model'].predict(x.reshape(-1, x.shape[-1])).reshape(shape)\n        weight = state['expert_weight']\n        correction = pooled * (1 - weight) + expert * weight\n        return np.maximum(np.asarray(features['base']) + correction, 0).astype(np.float32)\n","exit_code":0,"status":"completed"}}

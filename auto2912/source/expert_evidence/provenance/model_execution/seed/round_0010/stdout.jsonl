[:, h, n]\n            if m.sum() > 15:\n                best_mae, best_w = float('inf'), anchor_h[h]\n                for w in np.linspace(0, 0.40, 21):\n                    pred = (1-w)*b_tr[:,h,n][m] + w*a_tr[:,h,n][m]\n                    mae = np.abs(pred - t_tr[:,h,n][m]).mean()\n                    if mae < best_mae: best_mae, best_w = mae, w\n                anchor_nh[h,n] = best_w\n            else:\n                anchor_nh[h,n] = anchor_h[h]\n    anchor_nh = pna_shrink * anchor_nh + (1-pna_shrink) * anchor_h[:, np.newaxis]\n    \n    blended_tr = (1-anchor_nh[np.newaxis,:,:])*b_tr + anchor_nh[np.newaxis,:,:]*a_tr\n    blended_va = (1-anchor_nh[np.newaxis,:,:])*b_va + anchor_nh[np.newaxis,:,:]*a_va\n    \n    h_bias = np.zeros(nh)\n    for h in range(nh):\n        m = m_tr[:, h, :]\n        h_bias[h] = np.median(blended_tr[:,h,:][m] - t_tr[:,h,:][m])\n    corrected_tr = blended_tr - h_bias[np.newaxis,:,np.newaxis]\n    corrected_va = blended_va - h_bias[np.newaxis,:,np.newaxis]\n    \n    node_shrink = 0.4\n    node_bias = np.zeros(nn)\n    res_tr = corrected_tr - t_tr\n    for n in range(nn):\n        m = m_tr[:, :, n]\n        if m.sum() > 5:\n            node_bias[n] = np.median(res_tr[:,:,n][m])\n    node_bias = node_shrink * node_bias\n    corrected_tr = corrected_tr - node_bias[np.newaxis, np.newaxis, :]\n    corrected_va = corrected_va - node_bias[np.newaxis, np.newaxis, :]\n    \n    pnh_shrink = 0.15\n    bias_nh = np.zeros((nh, nn))\n    res_tr = corrected_tr - t_tr\n    for h in range(nh):\n        for n in range(nn):\n            m = m_tr[:, h, n]\n            if m.sum() > 0:\n                bias_nh[h,n] = pnh_shrink * np.median(res_tr[:,h,n][m])\n    corrected_tr = corrected_tr - bias_nh[np.newaxis,:,:]\n    corrected_va = corrected_va - bias_nh[np.newaxis,:,:]\n    \n    mult_shrink = 0.5\n    mult_factor = np.ones(nn)\n    for n in range(nn):\n        m = m_tr[:, :, n]\n        p = corrected_tr[:,:,n][m]\n        tgt = t_tr[:,:,n][m]\n        if m.sum() > 20 and np.min(p) > 1:\n            mult_factor[n] = np.median(tgt / p)\n    mult_factor = 1.0 + mult_shrink * (mult_factor - 1.0)\n    corrected_tr = corrected_tr * mult_factor[np.newaxis, np.newaxis, :]\n    corrected_va = corrected_va * mult_factor[np.newaxis, np.newaxis, :]\n    \n    return corrected_tr, corrected_va\n\n# Test rich features with different alpha/shrink combos\ndef ridge_rich(alpha, shrink):\n    def predict_fn(train_idx, val_idx):\n        b_tr, t_tr = base[train_idx], targets[train_idx]\n        a_tr, h_tr = anchor[train_idx], history[train_idx]\n        c_tr = clock[train_idx]\n        m_tr = mask[train_idx]\n        b_va, a_va = base[val_idx], anchor[val_idx]\n        h_va, c_va = history[val_idx], clock[val_idx]\n        nh, nn = n_horizons, n_nodes\n        ns_tr = len(train_idx)\n        ns_va = len(val_idx)\n        \n        corrected_tr, corrected_va = build_base(b_tr, a_tr, t_tr, m_tr, b_va, a_va)\n        res_tr = corrected_tr - t_tr\n        \n        sample_ba_tr = np.zeros((ns_tr, nh))\n        sample_ba_va = np.zeros((ns_va, nh))\n        for h in range(nh):\n            for i in range(ns_tr):\n                mi = m_tr[i, h, :]\n                if mi.sum() > 0:\n                    sample_ba_tr[i, h] = (b_tr[i, h, :][mi] - a_tr[i, h, :][mi]).mean()\n            sample_ba_va[:, h] = (b_va[:, h, :] - a_va[:, h, :]).mean(axis=1)\n        \n        hist_last_tr = h_tr[:, -1, :]\n        hist_avg_tr = h_tr.mean(axis=1)\n        hist_trend_tr = (h_tr[:, -1, :] - h_tr[:, 0, :]) / 12.0\n        hist_last_va = h_va[:, -1, :]\n        hist_avg_va = h_va.mean(axis=1)\n        hist_trend_va = (h_va[:, -1, :] - h_va[:, 0, :]) / 12.0\n        \n        for h in range(nh):\n            m = m_tr[:, h, :]\n            y = res_tr[:, h, :][m].flatten()\n            if len(y) < 100: continue\n            \n            node_idx_flat = np.tile(np.arange(nn), (ns_tr, 1)).reshape(-1, 1)\n            node_idx_flat_v = np.tile(np.arange(nn), (ns_va, 1)).reshape(-1, 1)\n            \n            ba_sample_tr = np.repeat(sample_ba_tr[:, h], nn).reshape(-1, 1)\n            ba_sample_va = np.repeat(sample_ba_va[:, h], nn).reshape(-1, 1)\n            \n            feat_tr = [\n                b_tr[:, h, :].reshape(-1, 1),\n                a_tr[:, h, :].reshape(-1, 1),\n                (b_tr[:, h, :] - a_tr[:, h, :]).reshape(-1, 1),\n                hist_last_tr.reshape(-1, 1),\n                hist_avg_tr.reshape(-1, 1),\n                hist_trend_tr.reshape(-1, 1),\n                (b_tr[:, h, :] / np.maximum(hist_last_tr, 1)).reshape(-1, 1),\n                np.sin(2 * np.pi * np.repeat(c_tr[:, h, 0], nn)).reshape(-1, 1),\n                np.cos(2 * np.pi * np.repeat(c_tr[:, h, 0], nn)).reshape(-1, 1),\n                np.sin(2 * np.pi * node_idx_flat / nn),\n                np.cos(2 * np.pi * node_idx_flat / nn),\n                ba_sample_tr,\n            ]\n            feat_va = [\n                b_va[:, h, :].reshape(-1, 1),\n                a_va[:, h, :].reshape(-1, 1),\n                (b_va[:, h, :] - a_va[:, h, :]).reshape(-1, 1),\n                hist_last_va.reshape(-1, 1),\n                hist_avg_va.reshape(-1, 1),\n                hist_trend_va.reshape(-1, 1),\n                (b_va[:, h, :] / np.maximum(hist_last_va, 1)).reshape(-1, 1),\n                np.sin(2 * np.pi * np.repeat(c_va[:, h, 0], nn)).reshape(-1, 1),\n                np.cos(2 * np.pi * np.repeat(c_va[:, h, 0], nn)).reshape(-1, 1),\n                np.sin(2 * np.pi * node_idx_flat_v / nn),\n                np.cos(2 * np.pi * node_idx_flat_v / nn),\n                ba_sample_va,\n            ]\n            \n            X = np.hstack(feat_tr)\n            X_valid = X[m.flatten()]\n            mu = X_valid.mean(axis=0)\n            sd = X_valid.std(axis=0)\n            sd[sd < 1e-6] = 1.0\n            Xs = (X_valid - mu) / sd\n            \n            model = Ridge(alpha=alpha, fit_intercept=True)\n            model.fit(Xs, y)\n            \n            Xv = np.hstack(feat_va)\n            Xvs = (Xv - mu) / sd\n            correction = shrink * (Xvs @ model.coef_ + model.intercept_)\n            corrected_va[:, h, :] = corrected_va[:, h, :] - correction.reshape(ns_va, nn)\n        \n        return np.maximum(corrected_va, 0.0)\n    return predict_fn\n\nprint('=== Rich features (12 features), multiple seeds ===')\nbest_overall = float('inf')\nbest_config = None\nfor alpha in [50, 100, 200, 500]:\n    for shrink in [0.3, 0.5, 0.7]:\n        maes = []\n        for seed in [42, 123, 777]:\n            mae, _ = cv_evaluate(ridge_rich(alpha, shrink), seed=seed)\n            maes.append(mae)\n        avg = np.mean(maes)\n        if avg < best_overall:\n            best_overall = avg\n            best_config = (alpha, shrink)\n        print(f'  alpha={alpha:4d} shrink={shrink:.1f}: avg_mae={avg:.4f} (seeds: {[f\\\\\\\"{m:.4f}\\\\\\\" for m in maes]})')\n\nprint(f'\\\\\\\\nBest: alpha={best_config[0]}, shrink={best_config[1]}, avg_mae={best_overall:.4f}')\n\\\" 2>&1\n\"","aggregated_output":"=== Rich features (12 features), multiple seeds ===\n  alpha=  50 shrink=0.3: avg_mae=14.3937 (seeds: ['14.4573', '14.3295', '14.3944'])\n  alpha=  50 shrink=0.5: avg_mae=14.3803 (seeds: ['14.4478', '14.3153', '14.3779'])\n  alpha=  50 shrink=0.7: avg_mae=14.3845 (seeds: ['14.4564', '14.3181', '14.3789'])\n  alpha= 100 shrink=0.3: avg_mae=14.3944 (seeds: ['14.4580', '14.3299', '14.3954'])\n  alpha= 100 shrink=0.5: avg_mae=14.3807 (seeds: ['14.4483', '14.3151', '14.3788'])\n  alpha= 100 shrink=0.7: avg_mae=14.3840 (seeds: ['14.4561', '14.3169', '14.3791'])\n  alpha= 200 shrink=0.3: avg_mae=14.3956 (seeds: ['14.4592', '14.3307', '14.3967'])\n  alpha= 200 shrink=0.5: avg_mae=14.3817 (seeds: ['14.4495', '14.3156', '14.3802'])\n  alpha= 200 shrink=0.7: avg_mae=14.3843 (seeds: ['14.4563', '14.3166', '14.3799'])\n  alpha= 500 shrink=0.3: avg_mae=14.3980 (seeds: ['14.4617', '14.3329', '14.3995'])\n  alpha= 500 shrink=0.5: avg_mae=14.3842 (seeds: ['14.4518', '14.3177', '14.3832'])\n  alpha= 500 shrink=0.7: avg_mae=14.3854 (seeds: ['14.4571', '14.3174', '14.3817'])\n\nBest: alpha=50, shrink=0.5, avg_mae=14.3803\n","exit_code":0,"status":"completed"}}

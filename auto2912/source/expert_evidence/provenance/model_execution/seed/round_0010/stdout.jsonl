io[m], r[m])[0,1]\n    print(f'  h={h}: corr(base/hist_last, residual) = {corr2:.4f}')\n\n# Graph analysis\nprint('\\\\n=== Graph analysis ===')\nprint(f'Edges: {(adj > 0).sum()}')\ndegrees = (adj > 0).sum(axis=1)\nprint(f'Degree: min={degrees.min()}, max={degrees.max()}, mean={degrees.mean():.1f}, median={np.median(degrees):.0f}')\nprint(f'Weight: min={adj[adj>0].min():.4f}, max={adj[adj>0].max():.4f}, mean={adj[adj>0].mean():.4f}')\n\n# Graph smoothing of residuals\n# For each node, is the average residual of neighbors predictive?\nprint('\\\\n=== Graph-smoothed residual correlation ===')\n# Build normalized adjacency\nD_inv = np.diag(1.0 / np.maximum(degrees, 1e-6))\nA_norm = D_inv @ adj  # row-normalized\n\nfor h in [0, 5, 11]:\n    resid_h = residual[:, h, :]  # (n_samples, n_nodes)\n    # Graph-smoothed residual for each sample\n    smooth_resid = resid_h @ A_norm.T  # (n_samples, n_nodes) - average neighbor residual\n    m = mask[:, h, :]\n    corr = np.corrcoef(resid_h[m], smooth_resid[m])[0, 1]\n    print(f'  h={h}: corr(node_resid, neighbor_avg_resid) = {corr:.4f}')\n\n# Can we predict residual from neighbor base error?\nfor h in [0, 5, 11]:\n    base_h = base[:, h, :]\n    smooth_base = base_h @ A_norm.T  # average neighbor base\n    m = mask[:, h, :]\n    # Use neighbor base avg as feature for residual\n    feat = smooth_base - base_h  # difference from neighbor average\n    corr = np.corrcoef(feat[m], residual[:, h, :][m])[0, 1]\n    print(f'  h={h}: corr(neighbor_base_avg - node_base, residual) = {corr:.4f}')\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

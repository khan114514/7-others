- Step 7: Enriched ridge residual correction (per horizon) ----\n    ridge_alpha = 50.0\n    ridge_shrink = 0.5\n    ridge_models = []\n\n    hist_last = history[:, -1, :]\n    hist_avg = history.mean(axis=1)\n    hist_trend = (history[:, -1, :] - history[:, 0, :]) / 12.0\n\n    # Per-sample average base-anchor difference (strong predictor of sample-level bias)\n    sample_ba_diff = np.zeros((n_samples, n_horizons))\n    for h in range(n_horizons):\n        for i in range(n_samples):\n            mi = mask[i, h, :]\n            if mi.sum() > 0:\n                sample_ba_diff[i, h] = (base[i, h, :][mi] - anchor[i, h, :][mi]).mean()\n            else:\n                sample_ba_diff[i, h] = (base[i, h, :] - anchor[i, h, :]).mean()\n\n    for h in range(n_horizons):\n        m = mask[:, h, :]\n        y = residual[:, h, :][m].flatten()\n        if len(y) < 100:\n            ridge_models.append(None)\n            continue\n\n        node_idx_flat = np.tile(np.arange(n_nodes), (n_samples, 1)).reshape(-1, 1)\n        ba_sample_flat = np.repeat(sample_ba_diff[:, h], n_nodes).reshape(-1, 1)\n\n        X = np.hstack([\n            base[:, h, :].reshape(-1, 1),           # 1: base value\n            anchor[:, h, :].reshape(-1, 1),         # 2: anchor value\n            (base[:, h, :] - anchor[:, h, :]).reshape(-1, 1),  # 3: base-anchor diff (per-node)\n            hist_last.reshape(-1, 1),               # 4: last history step\n            hist_avg.reshape(-1, 1),                # 5: history average\n            hist_trend.reshape(-1, 1),              # 6: history trend\n            (base[:, h, :] / np.maximum(hist_last, 1.0)).reshape(-1, 1),  # 7: base/hist ratio\n            np.sin(2 * np.pi * np.repeat(clock[:, h, 0], n_nodes)).reshape(-1, 1),  # 8: sin(tod)\n            np.cos(2 * np.pi * np.repeat(clock[:, h, 0], n_nodes)).reshape(-1, 1),  # 9: cos(tod)\n            np.sin(2 * np.pi * node_idx_flat / n_nodes),   # 10: sin(node)\n            np.cos(2 * np.pi * node_idx_fl
{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np\nfrom sklearn.linear_model import Ridge\n\ntrain_feats = np.load('/workspace/public_assets/train_features.npz')\ntrain_targets = np.load('/workspace/public_assets/train_targets.npz')\ngraph = np.load('/workspace/public_assets/graph.npz')\n\nbase = train_feats['base'].astype(np.float64)\ntargets = train_targets['target'].astype(np.float64)\nanchor = train_feats['anchor'].astype(np.float64)\nhistory = train_feats['history'].astype(np.float64)\nclock = train_feats['clock'].astype(np.float64)\nadj = graph['adjacency'].astype(np.float64)\n\nn_samples, n_horizons, n_nodes = base.shape\nmask = np.isfinite(targets) & (targets > 0)\n\n# Check: is the bias multiplicative or additive?\n# If log(target) = log(base) + bias, then multiplicative\n# If target = base + bias, then additive\nprint('=== Additive vs multiplicative bias ===')\nresid_add = base - targets\nresid_mult = np.log(base) - np.log(targets)\n\nfor h in [0, 5, 11]:\n    m = mask[:, h, :]\n    # For additive: std of residual across nodes within a sample\n    add_std_per_sample = np.std(resid_add[:, h, :], axis=1).mean()\n    mult_std_per_sample = np.std(resid_mult[:, h, :], axis=1).mean()\n    print(f'  h={h}: mean per-sample std (additive) = {add_std_per_sample:.3f}')\n    print(f'  h={h}: mean per-sample std (multiplicative) = {mult_std_per_sample:.4f}')\n    \n    # Correlation between node value and residual\n    corr_add = np.corrcoef(base[:,h,:][m], resid_add[:,h,:][m])[0,1]\n    corr_mult = np.corrcoef(base[:,h,:][m], resid_mult[:,h,:][m])[0,1]\n    print(f'  h={h}: corr(base_value, additive_resid) = {corr_add:.4f}')\n    print(f'  h={h}: corr(base_value, log_resid) = {corr_mult:.4f}')\n    print()\n\n# Per-node bias in log domain\nprint('=== Per-node log bias ===')\nnode_log_bias = np.zeros(n_nodes)\nfor n in range(n_nodes):\n    m = mask[:, :, n]\n    if m.sum() > 5:\n        node_log_bias[n] = np.median((np.log(base[:,:,n]) - np.log(targets[:,:,n]))[m])\n\nprint(f'node log bias: mean={node_log_bias.mean():.4f}, std={node_log_bias.std():.4f}')\nprint(f'exp(mean bias) = {np.exp(node_log_bias.mean()):.4f}')\n\n# How much variance is per-node vs per-sample?\nprint()\nprint('=== Variance decomposition of log residual ===')\nlog_resid = np.log(base) - np.log(targets)\nfor h in [0, 5, 11]:\n    m = mask[:, h, :]\n    total_var = np.var(log_resid[:, h, :][m])\n    # Per-node mean (average across samples)\n    node_mean = np.zeros(n_nodes)\n    for n in range(n_nodes):\n        mn = mask[:, h, n]\n        if mn.sum() > 0:\n            node_mean[n] = log_resid[:, h, n][mn].mean()\n    node_var = np.var(node_mean)\n    \n    # Per-sample mean\n    sample_mean = np.zeros(n_samples)\n    for i in range(n_samples):\n        mi = mask[i, h, :]\n        if mi.sum() > 0:\n            sample_mean[i] = log_resid[i, h, :][mi].mean()\n    sample_var = np.var(sample_mean)\n    \n    print(f'  h={h}: total_var={total_var:.4f}, node_var={node_var:.4f} ({node_var/total_var*100:.1f}%), sample_var={sample_var:.4f} ({sample_var/total_var*100:.1f}%)')\n\n# How about ToD variance?\nprint()\nprint('=== ToD variance in log residual ===')\nlog_resid = np.log(base) - np.log(targets)\nfor h in [0, 5, 11]:\n    m = mask[:, h, :]\n    total_var = np.var(log_resid[:, h, :][m])\n    \n    # Per-tod mean\n    tod_vals = np.sort(np.unique(clock[:, h, 0]))\n    tod_mean = []\n    for cv in tod_vals:\n        idx = np.abs(clock[:, h, 0] - cv) < 0.001\n        mi = m & idx[:, np.newaxis]\n        if mi.sum() > 0:\n            tod_mean.append(log_resid[:, h, :][mi].mean())\n    tod_var = np.var(tod_mean)\n    print(f'  h={h}: total_var={total_var:.4f}, tod_var={tod_var:.4f} ({tod_var/total_var*100:.1f}%)')\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np\nfrom sklearn.linear_model import Ridge\n\ntrain_feats = np.load('/workspace/public_assets/train_features.npz')\ntrain_targets = np.load('/workspace/public_assets/train_targets.npz')\ngraph = np.load('/workspace/public_assets/graph.npz')\n\nbase = train_feats['base'].astype(np.float64)\ntargets = train_targets['target'].astype(np.float64)\nanchor = train_feats['anchor'].astype(np.float64)\nhistory = train_feats['history'].astype(np.float64)\nclock = train_feats['clock'].astype(np.float64)\n\nn_samples, n_horizons, n_nodes = base.shape\nmask = np.isfinite(targets) & (targets > 0)\n\n# 5-fold CV\ndef cv_evaluate(predict_fn, n_folds=5, seed=42):\n    rng = np.random.RandomState(seed)\n    indices = np.arange(n_samples)\n    rng.shuffle(indices)\n    fold_size = n_samples // n_folds\n    maes = []\n    for fold in range(n_folds):\n        val_start = fold * fold_size\n        val_end = val_start + fold_size if fold < n_folds-1 else n_samples\n        val_idx = indices[val_start:val_end]\n        train_idx = np.setdiff1d(indices, val_idx)\n        pred = predict_fn(train_idx, val_idx)\n        m = mask[val_idx]\n        mae = np.abs(pred[m] - targets[val_idx][m]).mean()\n        maes.append(mae)\n    return np.mean(maes), np.std(maes)\n\n# ============================================================\n# Core building blocks (shared)\n# ============================================================\ndef build_base_corrected(b_tr, a_tr, t_tr, m_tr, b_va, a_va):\n    '''v23-style base correction without ridge'''\n    nh, nn = n_horizons, n_nodes\n    \n    # Per-horizon anchor weight\n    anchor_h = np.zeros(nh)\n    for h in range(nh):\n        m = m_tr[:, h, :]\n        best_mae, best_w = float('inf'), 0\n        for w in np.linspace(0, 0.30, 31):\n            pred = (1-w)*b_tr[:,h,:][m] + w*a_tr[:,h,:][m]\n            mae = np.abs(pred - t_tr[:,h,:][m]).mean()\n            if mae < best_mae: best_mae, best_w = mae, w\n        anchor_h[h] = best_w\n    \n    # PNA anchor blending\n    pna_shrink = 0.2\n    anchor_nh = np.zeros((nh, nn))\n    for h in range(nh):\n        for n in range(nn):\n            m = m_tr[:, h, n]\n            if m.sum() > 15:\n                best_mae, best_w = float('inf'), anchor_h[h]\n                for w in np.linspace(0, 0.40, 21):\n                    pred = (1-w)*b_tr[:,h,n][m] + w*a_tr[:,h,n][m]\n                    mae = np.abs(pred - t_tr[:,h,n][m]).mean()\n                    if mae < best_mae: best_mae, best_w = mae, w\n                anchor_nh[h,n] = best_w\n            else:\n                anchor_nh[h,n] = anchor_h[h]\n    anchor_nh = pna_shrink * anchor_nh + (1-pna_shrink) * anchor_h[:, np.newaxis]\n    \n    blended_tr = (1-anchor_nh[np.newaxis,:,:])*b_tr + anchor_nh[np.newaxis,:,:]*a_tr\n    blended_va = (1-anchor_nh[np.newaxis,:,:])*b_va + anchor_nh[np.newaxis,:,:]*a_va\n    \n    # H bias\n    h_bias = np.zeros(nh)\n    for h in range(nh):\n        m = m_tr[:, h, :]\n        h_bias[h] = np.median(blended_tr[:,h,:][m] - t_tr[:,h,:][m])\n    corrected_tr = blended_tr - h_bias[np.newaxis,:,np.newaxis]\n    corrected_va = blended_va - h_bias[np.newaxis,:,np.newaxis]\n    \n    # Node bias\n    node_shrink = 0.4\n    node_bias = np.zeros(nn)\n    res_tr = corrected_tr - t_tr\n    for n in range(nn):\n        m = m_tr[:, :, n]\n        if m.sum() > 5:\n            node_bias[n] = np.median(res_tr[:,:,n][m])\n    node_bias = node_shrink * node_bias\n    corrected_tr = corrected_tr - node_bias[np.newaxis, np.newaxis, :]\n    corrected_va = corrected_va - node_bias[np.newaxis, np.newaxis, :]\n    \n    # PNH bias\n    pnh_shrink = 0.15\n    bias_nh = np.zeros((nh, nn))\n    res_tr = corrected_tr - t_tr\n    for h in range(nh):\n        for n in range(nn):\n            m = m_tr[:, h, n]\n            if m.sum() > 0:\n                bias_nh[h,n] = pnh_shrink * np.median(res_tr[:,h,n][m])\n    corrected_tr = corrected_tr - bias_nh[np.newaxis,:,:]\n    corrected_va = corrected_va - bias_nh[np.newaxis,:,:]\n    \n    # Mult factor\n    mult_shrink = 0.5\n    mult_factor = np.ones(nn)\n    for n in range(nn):\n        m = m_tr[:, :, n]\n        p = corrected_tr[:,:,n][m]\n        tgt = t_tr[:,:,n][m]\n        if m.sum() > 20 and np.min(p) > 1:\n            mult_factor[n] = np.median(tgt / p)\n    mult_factor = 1.0 + mult_shrink * (mult_factor - 1.0)\n    corrected_tr = corrected_tr * mult_factor[np.newaxis, np.newaxis, :]\n    corrected_va = corrected_va * mult_factor[np.newaxis, np.newaxis, :]\n    \n    return corrected_tr, corrected_va, anchor_nh\n\ndef v23_noridge_pred(train_idx, val_idx):\n    b_tr, t_tr = base[train_idx], targets[train_idx]\n    a_tr = anchor[train_idx]\n    m_tr = mask[train_idx]\n    b_va, a_va = base[val_idx], anchor[val_idx]\n    \n    _, corrected_va, _ = build_base_corrected(b_tr, a_tr, t_tr, m_tr, b_va, a_va)\n    corrected_va = np.maximum(corrected_va, 0.0)\n    return corrected_va\n\nmae, std = cv_evaluate(v23_noridge_pred)\nprint(f'v23 w/o ridge: MAE = {mae:.4f} +/- {std:.4f}')\n\n# ============================================================\n# Per-sample bias correction using base-anchor difference\n# ============================================================\ndef sample_bias_pred(train_idx, val_idx):\n    b_tr, t_tr = base[train_idx], targets[train_idx]\n    a_tr, h_tr = anchor[train_idx], history[train_idx]\n    c_tr = clock[train_idx]\n    m_tr = mask[train_idx]\n    b_va, a_va = base[val_idx], anchor[val_idx]\n    h_va, c_va = history[val_idx], clock[val_idx]\n    nh, nn = n_horizons, n_nodes\n    ns_tr = len(train_idx)\n    ns_va = len(val_idx)\n    \n    corrected_tr, corrected_va, _ = build_base_corrected(b_tr, a_tr, t_tr, m_tr, b_va, a_va)\n    res_tr = corrected_tr - t_tr\n    \n    # Per-sample per-horizon average residual\n    # Feature: average (base - anchor) per sample per horizon\n    # This captures 'how far base is from anchor' per sample\n    \n    sample_ba_diff_tr = np.zeros((ns_tr, nh))\n    sample_resid_tr = np.zeros((ns_tr, nh))\n    for h in range(nh):\n        for i in range(ns_tr):\n            mi = m_tr[i, h, :]\n            if mi.sum() > 0:\n                sample_ba_diff_tr[i, h] = (b_tr[i, h, :][mi] - a_tr[i, h, :][mi]).mean()\n                sample_resid_tr[i, h] = res_tr[i, h, :][mi].mean()\n    \n    sample_ba_diff_va = np.zeros((ns_va, nh))\n    for h in range(nh):\n        for i in range(ns_va):\n            # Use all nodes for val (no mask needed for features)\n            sample_ba_diff_va[i, h] = (b_va[i, h, :] - a_va[i, h, :]).mean()\n    \n    # Fit per-horizon linear model: sample_resid = alpha + beta * (base - anchor)\n    # Then apply correction to val\n    sample_bias_coef = np.zeros((nh, 2))  # intercept, slope\n    sample_bias_shrink = 0.5  # shrink correction\n    \n    for h in range(nh):\n        valid = np.isfinite(sample_resid_tr[:, h]) & np.isfinite(sample_ba_diff_tr[:, h])\n        if valid.sum() < 10:\n            sample_bias_coef[h] = [0, 0]\n            continue\n        \n        x = sample_ba_diff_tr[valid, h]\n        y = sample_resid_tr[valid, h]\n        \n        # Robust linear fit (Theil-Sen or just least squares with regularization)\n        # Simple: fit with intercept\n        X = np.column_stack([np.ones(len(x)), x])\n        # Ridge with small alpha\n        alpha = 5.0\n        coef = np.linalg.lstsq(X.T @ X + alpha * np.eye(2), X.T @ y, rcond=None)[0]\n        sample_bias_coef[h] = coef\n    \n    # Apply per-sample bias correction\n    for h in range(nh):\n        intercept, slope = sample_bias_coef[h]\n        pred_bias = intercept + slope * sample_ba_diff_va[:, h]\n        corrected_va[:, h, :] = corrected_va[:, h, :] - sample_bias_shrink * pred_bias[:, np.newaxis]\n    \n    corrected_va = np.maximum(corrected_va, 0.0)\n    return corrected_va\n\nmae, std = cv_evaluate(sample_bias_pred)\nprint(f'+ sample bias (base-anchor, shrink=0.5): MAE = {mae:.4f} +/- {std:.4f}')\n\n# Try different shrinkage levels\nfor shrink in [0.2, 0.3, 0.4, 0.6, 0.8, 1.0]:\n    def make_fn(sh):\n        def fn(train_idx, val_idx):\n            b_tr, t_tr = base[train_idx], targets[train_idx]\n            a_tr = anchor[train_idx]\n            m_tr = mask[train_idx]\n            b_va, a_va = base[val_idx], anchor[val_idx]\n            nh, nn = n_horizons, n_nodes\n            ns_tr = len(train_idx)\n            ns_va = len(val_idx)\n            \n            corrected_tr, corrected_va, _ = build_base_corrected(b_tr, a_tr, t_tr, m_tr, b_va, a_va)\n            res_tr = corrected_tr - t_tr\n            \n            sample_ba_diff_tr = np.zeros((ns_tr, nh))\n            sample_resid_tr = np.zeros((ns_tr, nh))\n            for h in range(nh):\n                for i in range(ns_tr):\n                    mi = m_tr[i, h, :]\n                    if mi.sum() > 0:\n                        sample_ba_diff_tr[i, h] = (b_tr[i, h, :][mi] - a_tr[i, h, :][mi]).mean()\n                        sample_resid_tr[i, h] = res_tr[i, h, :][mi].mean()\n            \n            sample_ba_diff_va = np.zeros((ns_va, nh))\n            for h in range(nh):\n                for i in range(ns_va):\n                    sample_ba_diff_va[i, h] = (b_va[i, h, :] - a_va[i, h, :]).mean()\n            \n            for h in range(nh):\n                valid = np.isfinite(sample_resid_tr[:, h]) & np.isfinite(sample_ba_diff_tr[:, h])\n                if valid.sum() < 10: continue\n                x = sample_ba_diff_tr[valid, h]\n                y = sample_resid_tr[valid, h]\n                X = np.column_stack([np.ones(len(x)), x])\n                alpha = 5.0\n                coef = np.linalg.lstsq(X.T @ X + alpha * np.eye(2), X.T @ y, rcond=None)[0]\n                pred_bias = coef[0] + coef[1] * sample_ba_diff_va[:, h]\n                corrected_va[:, h, :] = corrected_va[:, h, :] - sh * pred_bias[:, np.newaxis]\n            \n            return np.maximum(corrected_va, 0.0)\n        return fn\n    \n    mae, std = cv_evaluate(make_fn(shrink))\n    print(f'  shrink={shrink:.1f}: MAE = {mae:.4f} +/- {std:.4f}')\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_52","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np\nfrom sklearn.linear_model import Ridge\n\ntrain_feats = np.load('/workspace/public_assets/train_features.npz')\ntrain_targets = np.load('/workspace/public_assets/train_targets.npz')\ngraph = np.load('/workspace/public_assets/graph.npz')\n\nbase = train_feats['base'].astype(np.float64)\ntargets = train_targets['target'].astype(np.float64)\nanchor = train_feats['anchor'].astype(np.float64)\nhistory = train_feats['history'].astype(np.float64)\nclock = train_feats['clock'].astype(np.float64)\n\nn_samples, n_horizons, n_nodes = base.shape\nmask = np.isfinite(targets) & (targets > 0)\n\ndef cv_evaluate(predict_fn, n_folds=5, seed=42):\n    rng = np.random.RandomState(seed)\n    indices = np.arange(n_samples)\n    rng.shuffle(indices)\n    fold_size = n_samples // n_folds\n    maes = []\n    for fold in range(n_folds):\n        val_start = fold * fold_size\n        val_end = val_start + fold_size if fold < n_folds-1 else n_samples\n        val_idx = indices[val_start:val_end]\n        train_idx = np.setdiff1d(indices, val_idx)\n        pred = predict_fn(train_idx, val_idx)\n        m = mask[val_idx]\n        mae = np.abs(pred[m] - targets[val_idx][m]).mean()\n        maes.append(mae)\n    return np.mean(maes), np.std(maes)\n\n# Reference: v23 no-ridge\ndef build_base(b_tr, a_tr, t_tr, m_tr, b_va, a_va):\n    nh, nn = n_horizons, n_nodes\n    anchor_h = np.zeros(nh)\n    for h in range(nh):\n        m = m_tr[:, h, :]\n        best_mae, best_w = float('inf'), 0\n        for w in np.linspace(0, 0.30, 31):\n            pred = (1-w)*b_tr[:,h,:][m] + w*a_tr[:,h,:][m]\n            mae = np.abs(pred - t_tr[:,h,:][m]).mean()\n            if mae < best_mae: best_mae, best_w = mae, w\n        anchor_h[h] = best_w\n    \n    pna_shrink = 0.2\n    anchor_nh = np.zeros((nh, nn))\n    for h in range(nh):\n        for n in range(nn):\n            m = m_tr[:, h, n]\n            if m.sum() > 15:\n                best_mae, best_w = float('inf'), anchor_h[h]\n                for w in np.linspace(0, 0.40, 21):\n                    pred = (1-w)*b_tr[:,h,n][m] + w*a_tr[:,h,n][m]\n                    mae = np.abs(pred - t_tr[:,h,n][m]).mean()\n                    if mae < best_mae: best_mae, best_w = mae, w\n                anchor_nh[h,n] = best_w\n            else:\n                anchor_nh[h,n] = anchor_h[h]\n    anchor_nh = pna_shrink * anchor_nh + (1-pna_shrink) * anchor_h[:, np.newaxis]\n    \n    blended_tr = (1-anchor_nh[np.newaxis,:,:])*b_tr + anchor_nh[np.newaxis,:,:]*a_tr\n    blended_va = (1-anchor_nh[np.newaxis,:,:])*b_va + anchor_nh[np.newaxis,:,:]*a_va\n    \n    h_bias = np.zeros(nh)\n    for h in range(nh):\n        m = m_tr[:, h, :]\n        h_bias[h] = np.median(blended_tr[:,h,:][m] - t_tr[:,h,:][m])\n    corrected_tr = blended_tr - h_bias[np.newaxis,:,np.newaxis]\n    corrected_va = blended_va - h_bias[np.newaxis,:,np.newaxis]\n    \n    node_shrink = 0.4\n    node_bias = np.zeros(nn)\n    res_tr = corrected_tr - t_tr\n    for n in range(nn):\n        m = m_tr[:, :, n]\n        if m.sum() > 5:\n            node_bias[n] = np.median(res_tr[:,:,n][m])\n    node_bias = node_shrink * node_bias\n    corrected_tr = corrected_tr - node_bias[np.newaxis, np.newaxis, :]\n    corrected_va = corrected_va - node_bias[np.newaxis, np.newaxis, :]\n    \n    pnh_shrink = 0.15\n    bias_nh = np.zeros((nh, nn))\n    res_tr = corrected_tr - t_tr\n    for h in range(nh):\n        for n in range(nn):\n            m = m_tr[:, h, n]\n            if m.sum() > 0:\n                bias_nh[h,n] = pnh_shrink * np.median(res_tr[:,h,n][m])\n    corrected_tr = corrected_tr - bias_nh[np.newaxis,:,:]\n    corrected_va = corrected_va - bias_nh[np.newaxis,:,:]\n    \n    mult_shrink = 0.5\n    mult_factor = np.ones(nn)\n    for n in range(nn):\n        m = m_tr[:, :, n]\n        p = corrected_tr[:,:,n][m]\n        tgt = t_tr[:,:,n][m]\n        if m.sum() > 20 and np.min(p) > 1:\n            mult_factor[n] = np.median(tgt / p)\n    mult_factor = 1.0 + mult_shrink * (mult_factor - 1.0)\n    corrected_tr = corrected_tr * mult_factor[np.newaxis, np.newaxis, :]\n    corrected_va = corrected_va * mult_factor[np.newaxis, np.newaxis, :]\n    \n    return corrected_tr, corrected_va\n\n# ============================================================\n# Test different ridge feature sets\n# ============================================================\ndef ridge_with_features(feat_set='v23', ridge_alpha=1000.0, ridge_shrink=0.3):\n    def predict_fn(train_idx, val_idx):\n        b_tr, t_tr = base[train_idx], targets[train_idx]\n        a_tr, h_tr = anchor[train_idx], history[train_idx]\n        c_tr = clock[train_idx]\n        m_tr = mask[train_idx]\n        b_va, a_va = base[val_idx], anchor[val_idx]\n        h_va, c_va = history[val_idx], clock[val_idx]\n        nh, nn = n_horizons, n_nodes\n        ns_tr = len(train_idx)\n        ns_va = len(val_idx)\n        \n        corrected_tr, corrected_va = build_base(b_tr, a_tr, t_tr, m_tr, b_va, a_va)\n        res_tr = corrected_tr - t_tr\n        \n        # Per-sample average features\n        sample_ba_tr = np.zeros((ns_tr, nh))\n        sample_ba_va = np.zeros((ns_va, nh))\n        for h in range(nh):\n            for i in range(ns_tr):\n                mi = m_tr[i, h, :]\n                if mi.sum() > 0:\n                    sample_ba_tr[i, h] = (b_tr[i, h, :][mi] - a_tr[i, h, :][mi]).mean()\n            sample_ba_va[:, h] = (b_va[:, h, :] - a_va[:, h, :]).mean(axis=1)\n        \n        hist_last_tr = h_tr[:, -1, :]\n        hist_avg_tr = h_tr.mean(axis=1)\n        hist_trend_tr = (h_tr[:, -1, :] - h_tr[:, 0, :]) / 12.0\n        hist_last_va = h_va[:, -1, :]\n        hist_avg_va = h_va.mean(axis=1)\n        hist_trend_va = (h_va[:, -1, :] - h_va[:, 0, :]) / 12.0\n        \n        for h in range(nh):\n            m = m_tr[:, h, :]\n            y = res_tr[:, h, :][m].flatten()\n            if len(y) < 100: continue\n            \n            node_idx_flat = np.tile(np.arange(nn), (ns_tr, 1)).reshape(-1, 1)\n            node_idx_flat_v = np.tile(np.arange(nn), (ns_va, 1)).reshape(-1, 1)\n            \n            feat_list_tr = []\n            feat_list_va = []\n            \n            # Always include base features\n            feat_list_tr.append(b_tr[:, h, :].reshape(-1, 1))\n            feat_list_va.append(b_va[:, h, :].reshape(-1, 1))\n            \n            if feat_set in ['v23', 'plus', 'rich']:\n                feat_list_tr.append(a_tr[:, h, :].reshape(-1, 1))\n                feat_list_va.append(a_va[:, h, :].reshape(-1, 1))\n                feat_list_tr.append(hist_last_tr.reshape(-1, 1))\n                feat_list_va.append(hist_last_va.reshape(-1, 1))\n                feat_list_tr.append(hist_avg_tr.reshape(-1, 1))\n                feat_list_va.append(hist_avg_va.reshape(-1, 1))\n                feat_list_tr.append(hist_trend_tr.reshape(-1, 1))\n                feat_list_va.append(hist_trend_va.reshape(-1, 1))\n                feat_list_tr.append(np.sin(2 * np.pi * np.repeat(c_tr[:, h, 0], nn)).reshape(-1, 1))\n                feat_list_va.append(np.sin(2 * np.pi * np.repeat(c_va[:, h, 0], nn)).reshape(-1, 1))\n                feat_list_tr.append(np.cos(2 * np.pi * np.repeat(c_tr[:, h, 0], nn)).reshape(-1, 1))\n                feat_list_va.append(np.cos(2 * np.pi * np.repeat(c_va[:, h, 0], nn)).reshape(-1, 1))\n                feat_list_tr.append(np.sin(2 * np.pi * node_idx_flat / nn))\n                feat_list_va.append(np.sin(2 * np.pi * node_idx_flat_v / nn))\n                feat_list_tr.append(np.cos(2 * np.pi * node_idx_flat / nn))\n                feat_list_va.append(np.cos(2 * np.pi * node_idx_flat_v / nn))\n            \n            if feat_set in ['plus', 'rich']:\n                # base - anchor (per-node)\n                feat_list_tr.append((b_tr[:, h, :] - a_tr[:, h, :]).reshape(-1, 1))\n                feat_list_va.append((b_va[:, h, :] - a_va[:, h, :]).reshape(-1, 1))\n                # base / hist_last\n                feat_list_tr.append((b_tr[:, h, :] / np.maximum(hist_last_tr, 1)).reshape(-1, 1))\n                feat_list_va.append((b_va[:, h, :] / np.maximum(hist_last_va, 1)).reshape(-1, 1))\n                # Per-sample base-anchor diff (broadcast to all nodes)\n                ba_sample_tr = np.repeat(sample_ba_tr[:, h], nn).reshape(-1, 1)\n                ba_sample_va = np.repeat(sample_ba_va[:, h], nn).reshape(-1, 1)\n                feat_list_tr.append(ba_sample_tr)\n                feat_list_va.append(ba_sample_va)\n            \n            if feat_set == 'rich':\n                # More history features\n                for step in [0, 3, 6]:\n                    feat_list_tr.append(h_tr[:, step, :].reshape(-1, 1))\n                    feat_list_va.append(h_va[:, step, :].reshape(-1, 1))\n                # base value squared\n                feat_list_tr.append((b_tr[:, h, :]**2).reshape(-1, 1))\n                feat_list_va.append((b_va[:, h, :]**2).reshape(-1, 1))\n                # log base\n                feat_list_tr.append(np.log(np.maximum(b_tr[:, h, :], 1)).reshape(-1, 1))\n                feat_list_va.append(np.log(np.maximum(b_va[:, h, :], 1)).reshape(-1, 1))\n            \n            X = np.hstack(feat_list_tr)\n            X_valid = X[m.flatten()]\n            mu = X_valid.mean(axis=0)\n            sd = X_valid.std(axis=0)\n            sd[sd < 1e-6] = 1.0\n            Xs = (X_valid - mu) / sd\n            \n            model = Ridge(alpha=ridge_alpha, fit_intercept=True)\n            model.fit(Xs, y)\n            \n            Xv = np.hstack(feat_list_va)\n            Xvs = (Xv - mu) / sd\n            correction = ridge_shrink * (Xvs @ model.coef_ + model.intercept_)\n            corrected_va[:, h, :] = corrected_va[:, h, :] - correction.reshape(ns_va, nn)\n        \n        return np.maximum(corrected_va, 0.0)\n    return predict_fn\n\nfor feat_set in ['v23', 'plus', 'rich']:\n    mae, std = cv_evaluate(ridge_with_features(feat_set))\n    print(f'Ridge feat={feat_set}: MAE = {mae:.4f} +/- {std:.4f}')\n\n# Try different ridge alpha and shrinkage with 'plus' features\nprint()\nfor alpha in [100, 500, 1000, 2000, 5000]:\n    for shrink in [0.2, 0.3, 0.5]:\n        mae, std = cv_evaluate(ridge_with_features('plus', alpha, shrink))\n        print(f'  plus alpha={alpha:5d} shrink={shrink:.1f}: MAE = {mae:.4f}')\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

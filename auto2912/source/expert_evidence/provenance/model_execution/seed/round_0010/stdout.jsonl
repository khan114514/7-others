_va, 0.0)\n    return predict_fn\n\nfor feat_set in ['v23', 'plus', 'rich']:\n    mae, std = cv_evaluate(ridge_with_features(feat_set))\n    print(f'Ridge feat={feat_set}: MAE = {mae:.4f} +/- {std:.4f}')\n\n# Try different ridge alpha and shrinkage with 'plus' features\nprint()\nfor alpha in [100, 500, 1000, 2000, 5000]:\n    for shrink in [0.2, 0.3, 0.5]:\n        mae, std = cv_evaluate(ridge_with_features('plus', alpha, shrink))\n        print(f'  plus alpha={alpha:5d} shrink={shrink:.1f}: MAE = {mae:.4f}')\n\\\" 2>&1\n\"","aggregated_output":"Ridge feat=v23: MAE = 14.4880 +/- 0.9677\nRidge feat=plus: MAE = 14.4644 +/- 0.9711\nRidge feat=rich: MAE = 14.4569 +/- 0.9728\n\n  plus alpha=  100 shrink=0.2: MAE = 14.4700\n  plus alpha=  100 shrink=0.3: MAE = 14.4580\n  plus alpha=  100 shrink=0.5: MAE = 14.4483\n  plus alpha=  500 shrink=0.2: MAE = 14.4729\n  plus alpha=  500 shrink=0.3: MAE = 14.4617\n  plus alpha=  500 shrink=0.5: MAE = 14.4518\n  plus alpha= 1000 shrink=0.2: MAE = 14.4751\n  plus alpha= 1000 shrink=0.3: MAE = 14.4644\n  plus alpha= 1000 shrink=0.5: MAE = 14.4542\n  plus alpha= 2000 shrink=0.2: MAE = 14.4781\n  plus alpha= 2000 shrink=0.3: MAE = 14.4681\n  plus alpha= 2000 shrink=0.5: MAE = 14.4574\n  plus alpha= 5000 shrink=0.2: MAE = 14.4839\n  plus alpha= 5000 shrink=0.3: MAE = 14.4753\n  plus alpha= 5000 shrink=0.5: MAE = 14.4644\n","exit_code":0,"status":"completed"}}

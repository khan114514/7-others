{"type":"item.started","item":{"id":"item_84","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np\nfrom sklearn.linear_model import Ridge\n\ntrain_feats = np.load('/workspace/public_assets/train_features.npz')\ntrain_targets = np.load('/workspace/public_assets/train_targets.npz')\ngraph = np.load('/workspace/public_assets/graph.npz')\n\nbase = train_feats['base'].astype(np.float64)\ntargets = train_targets['target'].astype(np.float64)\nanchor = train_feats['anchor'].astype(np.float64)\nhistory = train_feats['history'].astype(np.float64)\nclock = train_feats['clock'].astype(np.float64)\nadj = graph['adjacency'].astype(np.float64)\n\nn_samples, n_horizons, n_nodes = base.shape\nmask = np.isfinite(targets) & (targets > 0)\n\ndegrees = (adj > 0).sum(axis=1)\nD_inv = np.diag(1.0 / np.maximum(degrees, 1e-6))\nA_rn = D_inv @ adj  # row-normalized adjacency\n\ndef cv_evaluate(predict_fn, n_folds=5, seed=42):\n    rng = np.random.RandomState(seed)\n    indices = np.arange(n_samples)\n    rng.shuffle(indices)\n    fold_size = n_samples // n_folds\n    maes = []\n    for fold in range(n_folds):\n        val_start = fold * fold_size\n        val_end = val_start + fold_size if fold < n_folds-1 else n_samples\n        val_idx = indices[val_start:val_end]\n        train_idx = np.setdiff1d(indices, val_idx)\n        pred = predict_fn(train_idx, val_idx)\n        m = mask[val_idx]\n        mae = np.abs(pred[m] - targets[val_idx][m]).mean()\n        maes.append(mae)\n    return np.mean(maes), np.std(maes)\n\n# Reference: v25-like (v23 + sample bias)\ndef v25_like(train_idx, val_idx):\n    b_tr, t_tr = base[train_idx], targets[train_idx]\n    a_tr, h_tr = anchor[train_idx], history[train_idx]\n    c_tr = clock[train_idx]\n    m_tr = mask[train_idx]\n    b_va, a_va = base[val_idx], anchor[val_idx]\n    h_va, c_va = history[val_idx], clock[val_idx]\n    nh, nn = n_horizons, n_nodes\n    ns_tr = len(train_idx)\n    ns_va = len(val_idx)\n    \n    anchor_h = np.zeros(nh)\n    for h in range(nh):\n        m = m_tr[:, h, :]\n        best_mae, best_w = float('inf'), 0\n        for w in np.linspace(0, 0.30, 31):\n            pred = (1-w)*b_tr[:,h,:][m] + w*a_tr[:,h,:][m]\n            mae = np.abs(pred - t_tr[:,h,:][m]).mean()\n            if mae < best_mae: best_mae, best_w = mae, w\n        anchor_h[h] = best_w\n    \n    pna_shrink = 0.2\n    anchor_nh = np.zeros((nh, nn))\n    for h in range(nh):\n        for n in range(nn):\n            m = m_tr[:, h, n]\n            if m.sum() > 15:\n                best_mae, best_w = float('inf'), anchor_h[h]\n                for w in np.linspace(0, 0.40, 21):\n                    pred = (1-w)*b_tr[:,h,n][m] + w*a_tr[:,h,n][m]\n                    mae = np.abs(pred - t_tr[:,h,n][m]).mean()\n                    if mae < best_mae: best_mae, best_w = mae, w\n                anchor_nh[h,n] = best_w\n            else:\n                anchor_nh[h,n] = anchor_h[h]\n    anchor_nh = pna_shrink * anchor_nh + (1-pna_shrink) * anchor_h[:, np.newaxis]\n    \n    blended_tr = (1-anchor_nh[np.newaxis,:,:])*b_tr + anchor_nh[np.newaxis,:,:]*a_tr\n    blended_va = (1-anchor_nh[np.newaxis,:,:])*b_va + anchor_nh[np.newaxis,:,:]*a_va\n    \n    h_bias = np.zeros(nh)\n    for h in range(nh):\n        m = m_tr[:, h, :]\n        h_bias[h] = np.median(blended_tr[:,h,:][m] - t_tr[:,h,:][m])\n    corrected_tr = blended_tr - h_bias[np.newaxis,:,np.newaxis]\n    corrected_va = blended_va - h_bias[np.newaxis,:,np.newaxis]\n    \n    # Per-node bias\n    node_shrink = 0.4\n    node_bias = np.zeros(nn)\n    res_tr = corrected_tr - t_tr\n    for n in range(nn):\n        m = m_tr[:, :, n]\n        if m.sum() > 5:\n            node_bias[n] = np.median(res_tr[:,:,n][m])\n    node_bias = node_shrink * node_bias\n    corrected_tr = corrected_tr - node_bias[np.newaxis, np.newaxis, :]\n    corrected_va = corrected_va - node_bias[np.newaxis, np.newaxis, :]\n    \n    pnh_shrink = 0.15\n    bias_nh = np.zeros((nh, nn))\n    res_tr = corrected_tr - t_tr\n    for h in range(nh):\n        for n in range(nn):\n            m = m_tr[:, h, n]\n            if m.sum() > 0:\n                bias_nh[h,n] = pnh_shrink * np.median(res_tr[:,h,n][m])\n    corrected_tr = corrected_tr - bias_nh[np.newaxis,:,:]\n    corrected_va = corrected_va - bias_nh[np.newaxis,:,:]\n    \n    mult_shrink = 0.5\n    mult_factor = np.ones(nn)\n    for n in range(nn):\n        m = m_tr[:, :, n]\n        p = corrected_tr[:,:,n][m]\n        tgt = t_tr[:,:,n][m]\n        if m.sum() > 20 and np.min(p) > 1:\n            mult_factor[n] = np.median(tgt / p)\n    mult_factor = 1.0 + mult_shrink * (mult_factor - 1.0)\n    corrected_tr = corrected_tr * mult_factor[np.newaxis, np.newaxis, :]\n    corrected_va = corrected_va * mult_factor[np.newaxis, np.newaxis, :]\n    res_tr = corrected_tr - t_tr\n    \n    # Per-sample bias\n    sample_shrink = 0.2\n    sample_slope = np.zeros(nh)\n    sample_intercept = np.zeros(nh)\n    sample_ba_tr = np.zeros((ns_tr, nh))\n    sample_resid_tr = np.zeros((ns_tr, nh))\n    for h in range(nh):\n        for i in range(ns_tr):\n            mi = m_tr[i, h, :]\n            if mi.sum() > 0:\n                sample_ba_tr[i, h] = (b_tr[i, h, :][mi] - a_tr[i, h, :][mi]).mean()\n                sample_resid_tr[i, h] = res_tr[i, h, :][mi].mean()\n    sample_ba_va = np.zeros((ns_va, nh))\n    for h in range(nh):\n        sample_ba_va[:, h] = (b_va[:, h, :] - a_va[:, h, :]).mean(axis=1)\n    \n    sample_alpha = 10.0\n    for h in range(nh):\n        valid = np.isfinite(sample_resid_tr[:, h]) & np.isfinite(sample_ba_tr[:, h])\n        if valid.sum() < 10: continue\n        x = sample_ba_tr[valid, h]\n        y = sample_resid_tr[valid, h]\n        X = np.column_stack([np.ones(len(x)), x])\n        coef = np.linalg.lstsq(X.T @ X + sample_alpha * np.eye(2), X.T @ y, rcond=None)[0]\n        sample_intercept[h] = coef[0]\n        sample_slope[h] = coef[1]\n    \n    pred_bias_tr = sample_intercept[np.newaxis, :] + sample_ba_tr * sample_slope[np.newaxis, :]\n    pred_bias_va = sample_intercept[np.newaxis, :] + sample_ba_va * sample_slope[np.newaxis, :]\n    corrected_tr = corrected_tr - sample_shrink * pred_bias_tr[:, :, np.newaxis]\n    corrected_va = corrected_va - sample_shrink * pred_bias_va[:, :, np.newaxis]\n    res_tr = corrected_tr - t_tr\n    \n    # Ridge\n    ridge_alpha = 1000.0\n    ridge_shrink = 0.3\n    hist_last_tr = h_tr[:, -1, :]\n    hist_avg_tr = h_tr.mean(axis=1)\n    hist_trend_tr = (h_tr[:, -1, :] - h_tr[:, 0, :]) / 12.0\n    hist_last_va = h_va[:, -1, :]\n    hist_avg_va = h_va.mean(axis=1)\n    hist_trend_va = (h_va[:, -1, :] - h_va[:, 0, :]) / 12.0\n    \n    for h in range(nh):\n        m = m_tr[:, h, :]\n        y = res_tr[:, h, :][m].flatten()\n        if len(y) < 100: continue\n        node_idx_flat = np.tile(np.arange(nn), (ns_tr, 1)).reshape(-1, 1)\n        X = np.hstack([\n            b_tr[:, h, :].reshape(-1, 1),\n            a_tr[:, h, :].reshape(-1, 1),\n            hist_last_tr.reshape(-1, 1),\n            hist_avg_tr.reshape(-1, 1),\n            hist_trend_tr.reshape(-1, 1),\n            np.sin(2 * np.pi * np.repeat(c_tr[:, h, 0], nn)).reshape(-1, 1),\n            np.cos(2 * np.pi * np.repeat(c_tr[:, h, 0], nn)).reshape(-1, 1),\n            np.sin(2 * np.pi * node_idx_flat / nn),\n            np.cos(2 * np.pi * node_idx_flat / nn),\n        ])\n        X_valid = X[m.flatten()]\n        mu = X_valid.mean(axis=0)\n        sd = X_valid.std(axis=0)\n        sd[sd < 1e-6] = 1.0\n        Xs = (X_valid - mu) / sd\n        model = Ridge(alpha=ridge_alpha, fit_intercept=True)\n        model.fit(Xs, y)\n        \n        node_idx_flat_v = np.tile(np.arange(nn), (ns_va, 1)).reshape(-1, 1)\n        Xv = np.hstack([\n            b_va[:, h, :].reshape(-1, 1),\n            a_va[:, h, :].reshape(-1, 1),\n            hist_last_va.reshape(-1, 1),\n            hist_avg_va.reshape(-1, 1),\n            hist_trend_va.reshape(-1, 1),\n            np.sin(2 * np.pi * np.repeat(c_va[:, h, 0], nn)).reshape(-1, 1),\n            np.cos(2 * np.pi * np.repeat(c_va[:, h, 0], nn)).reshape(-1, 1),\n            np.sin(2 * np.pi * node_idx_flat_v / nn),\n            np.cos(2 * np.pi * node_idx_flat_v / nn),\n        ])\n        Xvs = (Xv - mu) / sd\n        correction = ridge_shrink * (Xvs @ model.coef_ + model.intercept_)\n        corrected_va[:, h, :] = corrected_va[:, h, :] - correction.reshape(ns_va, nn)\n    \n    return np.maximum(corrected_va, 0.0)\n\nmaes = []\nfor seed in [42, 123, 777]:\n    mae, _ = cv_evaluate(v25_like, seed=seed)\n    maes.append(mae)\nprint(f'v25-like baseline: avg={np.mean(maes):.4f} ({[f\\\\\\\"{m:.4f}\\\\\\\" for m in maes]})')\n\n# ============================================================\n# Graph-regularized per-node bias\n# Instead of node_bias = shrink * raw_bias (shrinking toward 0),\n# shrink toward graph-smoothed bias: node_bias = shrink * raw_bias + (1-shrink) * neighbor_avg_bias\n# ============================================================\ndef v25_graph_nodebias(graph_weight=0.0, node_shrink=0.4):\n    def predict_fn(train_idx, val_idx):\n        b_tr, t_tr = base[train_idx], targets[train_idx]\n        a_tr, h_tr = anchor[train_idx], history[train_idx]\n        c_tr = clock[train_idx]\n        m_tr = mask[train_idx]\n        b_va, a_va = base[val_idx], anchor[val_idx]\n        h_va, c_va = history[val_idx], clock[val_idx]\n        nh, nn = n_horizons, n_nodes\n        ns_tr = len(train_idx)\n        ns_va = len(val_idx)\n        \n        anchor_h = np.zeros(nh)\n        for h in range(nh):\n            m = m_tr[:, h, :]\n            best_mae, best_w = float('inf'), 0\n            for w in np.linspace(0, 0.30, 31):\n                pred = (1-w)*b_tr[:,h,:][m] + w*a_tr[:,h,:][m]\n                mae = np.abs(pred - t_tr[:,h,:][m]).mean()\n                if mae < best_mae: best_mae, best_w = mae, w\n            anchor_h[h] = best_w\n        \n        pna_shrink = 0.2\n        anchor_nh = np.zeros((nh, nn))\n        for h in range(nh):\n            for n in range(nn):\n                m = m_tr[:, h, n]\n                if m.sum() > 15:\n                    best_mae, best_w = float('inf'), anchor_h[h]\n                    for w in np.linspace(0, 0.40, 21):\n                        pred = (1-w)*b_tr[:,h,n][m] + w*a_tr[:,h,n][m]\n                        mae = np.abs(pred - t_tr[:,h,n][m]).mean()\n                        if mae < best_mae: best_mae, best_w = mae, w\n                    anchor_nh[h,n] = best_w\n                else:\n                    anchor_nh[h,n] = anchor_h[h]\n        anchor_nh = pna_shrink * anchor_nh + (1-pna_shrink) * anchor_h[:, np.newaxis]\n        \n        blended_tr = (1-anchor_nh[np.newaxis,:,:])*b_tr + anchor_nh[np.newaxis,:,:]*a_tr\n        blended_va = (1-anchor_nh[np.newaxis,:,:])*b_va + anchor_nh[np.newaxis,:,:]*a_va\n        \n        h_bias = np.zeros(nh)\n        for h in range(nh):\n            m = m_tr[:, h, :]\n            h_bias[h] = np.median(blended_tr[:,h,:][m] - t_tr[:,h,:][m])\n        corrected_tr = blended_tr - h_bias[np.newaxis,:,np.newaxis]\n        corrected_va = blended_va - h_bias[np.newaxis,:,np.newaxis]\n        \n        # Graph-regularized per-node bias\n        # raw_bias is per-node median residual\n        # smoothed_bias = graph-smoothed version (neighbor average)\n        # final = (1-node_shrink)*smoothed_bias + node_shrink*raw_bias\n        # When graph_weight=0, smoothed_bias=0, this reduces to original node_shrink*raw_bias\n        res_tr = corrected_tr - t_tr\n        raw_node_bias = np.zeros(nn)\n        for n in range(nn):\n            m = m_tr[:, :, n]\n            if m.sum() > 5:\n                raw_node_bias[n] = np.median(res_tr[:,:,n][m])\n        \n        # Graph-smoothed bias target\n        smooth_bias = A_rn @ raw_node_bias  # neighbor-weighted average\n        # Blend: target = graph_weight * smooth_bias + (1-graph_weight) * 0\n        target_bias = graph_weight * smooth_bias\n        # Shrink raw toward target\n        node_bias = target_bias + node_shrink * (raw_node_bias - target_bias)\n        \n        corrected_tr = corrected_tr - node_bias[np.newaxis, np.newaxis, :]\n        corrected_va = corrected_va - node_bias[np.newaxis, np.newaxis, :]\n        \n        pnh_shrink = 0.15\n        bias_nh = np.zeros((nh, nn))\n        res_tr = corrected_tr - t_tr\n        for h in range(nh):\n            for n in range(nn):\n                m = m_tr[:, h, n]\n                if m.sum() > 0:\n                    bias_nh[h,n] = pnh_shrink * np.median(res_tr[:,h,n][m])\n        corrected_tr = corrected_tr - bias_nh[np.newaxis,:,:]\n        corrected_va = corrected_va - bias_nh[np.newaxis,:,:]\n        \n        mult_shrink = 0.5\n        mult_factor = np.ones(nn)\n        for n in range(nn):\n            m = m_tr[:, :, n]\n            p = corrected_tr[:,:,n][m]\n            tgt = t_tr[:,:,n][m]\n            if m.sum() > 20 and np.min(p) > 1:\n                mult_factor[n] = np.median(tgt / p)\n        mult_factor = 1.0 + mult_shrink * (mult_factor - 1.0)\n        corrected_tr = corrected_tr * mult_factor[np.newaxis, np.newaxis, :]\n        corrected_va = corrected_va * mult_factor[np.newaxis, np.newaxis, :]\n        res_tr = corrected_tr - t_tr\n        \n        # Per-sample bias\n        sample_shrink = 0.2\n        sample_slope = np.zeros(nh)\n        sample_intercept = np.zeros(nh)\n        sample_ba_tr = np.zeros((ns_tr, nh))\n        sample_resid_tr = np.zeros((ns_tr, nh))\n        for h in range(nh):\n            for i in range(ns_tr):\n                mi = m_tr[i, h, :]\n                if mi.sum() > 0:\n                    sample_ba_tr[i, h] = (b_tr[i, h, :][mi] - a_tr[i, h, :][mi]).mean()\n                    sample_resid_tr[i, h] = res_tr[i, h, :][mi].mean()\n        sample_ba_va = np.zeros((ns_va, nh))\n        for h in range(nh):\n            sample_ba_va[:, h] = (b_va[:, h, :] - a_va[:, h, :]).mean(axis=1)\n        \n        sample_alpha = 10.0\n        for h in range(nh):\n            valid = np.isfinite(sample_resid_tr[:, h]) & np.isfinite(sample_ba_tr[:, h])\n            if valid.sum() < 10: continue\n            x = sample_ba_tr[valid, h]\n            y = sample_resid_tr[valid, h]\n            X = np.column_stack([np.ones(len(x)), x])\n            coef = np.linalg.lstsq(X.T @ X + sample_alpha * np.eye(2), X.T @ y, rcond=None)[0]\n            sample_intercept[h] = coef[0]\n            sample_slope[h] = coef[1]\n        \n        pred_bias_tr = sample_intercept[np.newaxis, :] + sample_ba_tr * sample_slope[np.newaxis, :]\n        pred_bias_va = sample_intercept[np.newaxis, :] + sample_ba_va * sample_slope[np.newaxis, :]\n        corrected_tr = corrected_tr - sample_shrink * pred_bias_tr[:, :, np.newaxis]\n        corrected_va = corrected_va - sample_shrink * pred_bias_va[:, :, np.newaxis]\n        res_tr = corrected_tr - t_tr\n        \n        # Ridge\n        ridge_alpha = 1000.0\n        ridge_shrink = 0.3\n        hist_last_tr = h_tr[:, -1, :]\n        hist_avg_tr = h_tr.mean(axis=1)\n        hist_trend_tr = (h_tr[:, -1, :] - h_tr[:, 0, :]) / 12.0\n        hist_last_va = h_va[:, -1, :]\n        hist_avg_va = h_va.mean(axis=1)\n        hist_trend_va = (h_va[:, -1, :] - h_va[:, 0, :]) / 12.0\n        \n        for h in range(nh):\n            m = m_tr[:, h, :]\n            y = res_tr[:, h, :][m].flatten()\n            if len(y) < 100: continue\n            node_idx_flat = np.tile(np.arange(nn), (ns_tr, 1)).reshape(-1, 1)\n            X = np.hstack([\n                b_tr[:, h, :].reshape(-1, 1),\n                a_tr[:, h, :].reshape(-1, 1),\n                hist_last_tr.reshape(-1, 1),\n                hist_avg_tr.reshape(-1, 1),\n                hist_trend_tr.reshape(-1, 1),\n                np.sin(2 * np.pi * np.repeat(c_tr[:, h, 0], nn)).reshape(-1, 1),\n                np.cos(2 * np.pi * np.repeat(c_tr[:, h, 0], nn)).reshape(-1, 1),\n                np.sin(2 * np.pi * node_idx_flat / nn),\n                np.cos(2 * np.pi * node_idx_flat / nn),\n            ])\n            X_valid = X[m.flatten()]\n            mu = X_valid.mean(axis=0)\n            sd = X_valid.std(axis=0)\n            sd[sd < 1e-6] = 1.0\n            Xs = (X_valid - mu) / sd\n            model = Ridge(alpha=ridge_alpha, fit_intercept=True)\n            model.fit(Xs, y)\n            \n            node_idx_flat_v = np.tile(np.arange(nn), (ns_va, 1)).reshape(-1, 1)\n            Xv = np.hstack([\n                b_va[:, h, :].reshape(-1, 1),\n                a_va[:, h, :].reshape(-1, 1),\n                hist_last_va.reshape(-1, 1),\n                hist_avg_va.reshape(-1, 1),\n                hist_trend_va.reshape(-1, 1),\n                np.sin(2 * np.pi * np.repeat(c_va[:, h, 0], nn)).reshape(-1, 1),\n                np.cos(2 * np.pi * np.repeat(c_va[:, h, 0], nn)).reshape(-1, 1),\n                np.sin(2 * np.pi * node_idx_flat_v / nn),\n                np.cos(2 * np.pi * node_idx_flat_v / nn),\n            ])\n            Xvs = (Xv - mu) / sd\n            correction = ridge_shrink * (Xvs @ model.coef_ + model.intercept_)\n            corrected_va[:, h, :] = corrected_va[:, h, :] - correction.reshape(ns_va, nn)\n        \n        return np.maximum(corrected_va, 0.0)\n    return predict_fn\n\nprint()\nprint('=== Graph-regularized per-node bias ===')\nfor gw in [0.0, 0.3, 0.5, 0.7, 1.0]:\n    for ns in [0.3, 0.4, 0.5, 0.6]:\n        maes = []\n        for seed in [42, 123, 777]:\n            mae, _ = cv_evaluate(v25_graph_nodebias(gw, ns), seed=seed)\n            maes.append(mae)\n        print(f'  gw={gw:.1f}, ns={ns:.1f}: avg={np.mean(maes):.4f}')\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np\n\ntrain_feats = np.load('/workspace/public_assets/train_features.npz')\ntrain_targets = np.load('/workspace/public_assets/train_targets.npz')\n\nbase = train_feats['base'].astype(np.float64)\ntargets = train_targets['target'].astype(np.float64)\nanchor = train_feats['anchor'].astype(np.float64)\nhistory = train_feats['history'].astype(np.float64)\nclock = train_feats['clock'].astype(np.float64)\n\nn_samples, n_horizons, n_nodes = base.shape\nmask = np.isfinite(targets) & (targets > 0)\n\n# Check relationship between history and base forecast\nprint('=== History vs base forecast relationship ===')\nprint(f'history shape: {history.shape}')\nprint(f'history last step mean: {history[:, -1, :].mean():.2f}')\nprint(f'base h=0 mean: {base[:, 0, :][mask[:,0,:]].mean():.2f}')\n\n# Correlation between last history step and base h=0\nm = mask[:, 0, :]\ncorr = np.corrcoef(history[:, -1, :][m], base[:, 0, :][m])[0,1]\nprint(f'corr(hist_last, base_h0) = {corr:.4f}')\n\n# Ratio of base to history across horizons\nprint()\nprint('=== base/history ratio per horizon ===')\nfor h in range(12):\n    m = mask[:, h, :]\n    ratio = base[:, h, :][m] / np.maximum(history[:, -1, :][m], 1)\n    print(f'  h={h}: ratio mean={ratio.mean():.4f}, median={np.median(ratio):.4f}')\n\n# Does the base forecast 'start' from the last history?\n# i.e., is base_h0 close to hist_last?\ndiff = base[:, 0, :] - history[:, -1, :]\nm = mask[:, 0, :]\nprint(f'\\\\\\\\nbase_h0 - hist_last: mean={diff[m].mean():.3f}, median={np.median(diff[m]):.3f}, mae={np.abs(diff[m]).mean():.3f}')\nprint(f'base_h0 MAE: {np.abs(base[:,0,:][m] - targets[:,0,:][m]).mean():.3f}')\nprint(f'hist_last MAE (for h0): {np.abs(history[:,-1,:][m] - targets[:,0,:][m]).mean():.3f}')\n\n# History-based error estimation\n# If we know the recent error (hist vs base extrapolation), can we correct?\n# Let's compute: for each sample, what's the bias of base at h0 vs hist_last?\n# And how does that predict future bias?\nprint()\nprint('=== History as error predictor ===')\n# Use the difference between base[h=0] and hist[-1] as a 'recent drift' measure\ndrift0 = base[:, 0, :] - history[:, -1, :]\n\nfor h in [0, 3, 6, 9, 11]:\n    m = mask[:, h, :]\n    resid = base[:, h, :] - targets[:, h, :]\n    corr = np.corrcoef(drift0[m], resid[m])[0, 1]\n    print(f'  h={h}: corr(base_h0 - hist_last, base_h - target) = {corr:.4f}')\n\n# How about using the history trend?\nhist_trend = (history[:, -1, :] - history[:, 0, :]) / 12.0\nfor h in [0, 3, 6, 9, 11]:\n    m = mask[:, h, :]\n    resid = base[:, h, :] - targets[:, h, :]\n    corr = np.corrcoef(hist_trend[m], resid[m])[0, 1]\n    print(f'  h={h}: corr(hist_trend, base_h - target) = {corr:.4f}')\n\n# What about the ratio?\nratio0 = base[:, 0, :] / np.maximum(history[:, -1, :], 1)\nfor h in [0, 3, 6, 9, 11]:\n    m = mask[:, h, :]\n    resid = base[:, h, :] - targets[:, h, :]\n    corr = np.corrcoef(ratio0[m], resid[m])[0, 1]\n    print(f'  h={h}: corr(base_h0/hist_last, base_h - target) = {corr:.4f}')\n\n# How good is hist_last as a predictor for each horizon?\nprint()\nprint('=== hist_last as naive forecast ===')\nfor h in range(12):\n    m = mask[:, h, :]\n    mae = np.abs(history[:, -1, :][m] - targets[:, h, :][m]).mean()\n    print(f'  h={h}: MAE = {mae:.3f}')\n\n# What's the optimal blend of base and hist_last for each horizon?\nprint()\nprint('=== Optimal blend base + hist_last ===')\nfor h in range(12):\n    m = mask[:, h, :]\n    best_w, best_mae = 0, float('inf')\n    for w in np.linspace(0, 0.3, 31):\n        pred = (1-w)*base[:,h,:][m] + w*history[:,-1,:][m]\n        mae = np.abs(pred - targets[:,h,:][m]).mean()\n        if mae < best_mae: best_mae, best_w = mae, w\n    print(f'  h={h}: w_hist={best_w:.2f}, MAE={best_mae:.4f}')\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np\nfrom sklearn.linear_model import Ridge\n\ntrain_feats = np.load('/workspace/public_assets/train_features.npz')\ntrain_targets = np.load('/workspace/public_assets/train_targets.npz')\ngraph = np.load('/workspace/public_assets/graph.npz')\n\nbase = train_feats['base'].astype(np.float64)\ntargets = train_targets['target'].astype(np.float64)\nanchor = train_feats['anchor'].astype(np.float64)\nhistory = train_feats['history'].astype(np.float64)\nclock = train_feats['clock'].astype(np.float64)\nadj = graph['adjacency'].astype(np.float64)\n\nn_samples, n_horizons, n_nodes = base.shape\nmask = np.isfinite(targets) & (targets > 0)\n\n# Build normalized adjacency for graph smoothing\ndegrees = (adj > 0).sum(axis=1)\nD_inv_sqrt = np.diag(1.0 / np.sqrt(np.maximum(degrees, 1e-6)))\nA_sym = D_inv_sqrt @ adj @ D_inv_sqrt  # symmetric normalized\n\n# ============================================================\n# 5-fold CV framework\n# ============================================================\ndef cv_evaluate(predict_fn, n_folds=5, seed=42):\n    rng = np.random.RandomState(seed)\n    indices = np.arange(n_samples)\n    rng.shuffle(indices)\n    fold_size = n_samples // n_folds\n    \n    maes = []\n    for fold in range(n_folds):\n        val_start = fold * fold_size\n        val_end = val_start + fold_size if fold < n_folds-1 else n_samples\n        val_idx = indices[val_start:val_end]\n        train_idx = np.setdiff1d(indices, val_idx)\n        \n        pred = predict_fn(train_idx, val_idx)\n        m = mask[val_idx]\n        mae = np.abs(pred[m] - targets[val_idx][m]).mean()\n        maes.append(mae)\n    \n    return np.mean(maes), np.std(maes)\n\n# Baseline: identity\ndef baseline_pred(train_idx, val_idx):\n    return base[val_idx]\n\nmae, std = cv_evaluate(baseline_pred)\nprint(f'Baseline (identity): MAE = {mae:.4f} +/- {std:.4f}')\n\n# ============================================================\n# Current v23-like method (simplified)\n# ============================================================\ndef v23_like_pred(train_idx, val_idx):\n    b_tr, t_tr = base[train_idx], targets[train_idx]\n    a_tr, h_tr = anchor[train_idx], history[train_idx]\n    c_tr = clock[train_idx]\n    m_tr = mask[train_idx]\n    \n    b_va, a_va = base[val_idx], anchor[val_idx]\n    h_va, c_va = history[val_idx], clock[val_idx]\n    \n    nh, nn = n_horizons, n_nodes\n    \n    # Per-horizon anchor weight\n    anchor_h = np.zeros(nh)\n    for h in range(nh):\n        m = m_tr[:, h, :]\n        best_mae = float('inf')\n        for w in np.linspace(0, 0.30, 31):\n            pred = (1-w)*b_tr[:,h,:][m] + w*a_tr[:,h,:][m]\n            mae = np.abs(pred - t_tr[:,h,:][m]).mean()\n            if mae < best_mae:\n                best_mae = mae\n                anchor_h[h] = w\n    \n    # Per-node-horizon anchor weight, shrunken\n    pna_shrink = 0.2\n    anchor_nh = np.zeros((nh, nn))\n    for h in range(nh):\n        for n in range(nn):\n            m = m_tr[:, h, n]\n            if m.sum() > 15:\n                best_mae = float('inf')\n                best_w = anchor_h[h]\n                for w in np.linspace(0, 0.40, 21):\n                    pred = (1-w)*b_tr[:,h,n][m] + w*a_tr[:,h,n][m]\n                    mae = np.abs(pred - t_tr[:,h,n][m]).mean()\n                    if mae < best_mae:\n                        best_mae = mae\n                        best_w = w\n                anchor_nh[h,n] = best_w\n            else:\n                anchor_nh[h,n] = anchor_h[h]\n    anchor_nh = pna_shrink * anchor_nh + (1-pna_shrink) * anchor_h[:, np.newaxis]\n    \n    blended = (1-anchor_nh[np.newaxis,:,:])*b_va + anchor_nh[np.newaxis,:,:]*a_va\n    \n    # Per-horizon median bias\n    h_bias = np.zeros(nh)\n    blended_tr = (1-anchor_nh[np.newaxis,:,:])*b_tr + anchor_nh[np.newaxis,:,:]*a_tr\n    for h in range(nh):\n        m = m_tr[:, h, :]\n        h_bias[h] = np.median(blended_tr[:,h,:][m] - t_tr[:,h,:][m])\n    corrected = blended - h_bias[np.newaxis,:,np.newaxis]\n    residual_tr = blended_tr - h_bias[np.newaxis,:,np.newaxis] - t_tr\n    \n    # Per-node median bias\n    node_shrink = 0.4\n    node_bias = np.zeros(nn)\n    for n in range(nn):\n        m = m_tr[:, :, n]\n        if m.sum() > 5:\n            node_bias[n] = np.median(residual_tr[:,:,n][m])\n    node_bias = node_shrink * node_bias\n    corrected = corrected - node_bias[np.newaxis, np.newaxis, :]\n    residual_tr = residual_tr - node_bias[np.newaxis, np.newaxis, :]\n    \n    # Per-node-horizon median bias\n    pnh_shrink = 0.15\n    bias_nh = np.zeros((nh, nn))\n    for h in range(nh):\n        for n in range(nn):\n            m = m_tr[:, h, n]\n            if m.sum() > 0:\n                bias_nh[h,n] = pnh_shrink * np.median(residual_tr[:,h,n][m])\n    corrected = corrected - bias_nh[np.newaxis,:,:]\n    \n    # Multiplicative per-node\n    mult_shrink = 0.5\n    mult_factor = np.ones(nn)\n    corrected_tr = blended_tr - h_bias[np.newaxis,:,np.newaxis] - node_bias[np.newaxis,np.newaxis,:] - bias_nh[np.newaxis,:,:]\n    for n in range(nn):\n        m = m_tr[:, :, n]\n        p = corrected_tr[:,:,n][m]\n        tgt = t_tr[:,:,n][m]\n        if m.sum() > 20 and np.min(p) > 1:\n            mult_factor[n] = np.median(tgt / p)\n    mult_factor = 1.0 + mult_shrink * (mult_factor - 1.0)\n    corrected = corrected * mult_factor[np.newaxis, np.newaxis, :]\n    \n    return corrected\n\nmae, std = cv_evaluate(v23_like_pred)\nprint(f'v23-like (simplified): MAE = {mae:.4f} +/- {std:.4f}')\nprint()\n\n# ============================================================\n# Test: Add time-of-day Fourier bias\n# ============================================================\ndef tod_fourier_pred(train_idx, val_idx):\n    b_tr, t_tr = base[train_idx], targets[train_idx]\n    a_tr = anchor[train_idx]\n    c_tr = clock[train_idx]\n    m_tr = mask[train_idx]\n    \n    b_va, a_va = base[val_idx], anchor[val_idx]\n    c_va = clock[val_idx]\n    \n    nh, nn = n_horizons, n_nodes\n    \n    # Per-horizon anchor weight  \n    anchor_h = np.zeros(nh)\n    for h in range(nh):\n        m = m_tr[:, h, :]\n        best_mae = float('inf')\n        for w in np.linspace(0, 0.30, 31):\n            pred = (1-w)*b_tr[:,h,:][m] + w*a_tr[:,h,:][m]\n            mae = np.abs(pred - t_tr[:,h,:][m]).mean()\n            if mae < best_mae:\n                best_mae = mae\n                anchor_h[h] = w\n    \n    # PNA anchor blending (simplified, just per-horizon for speed)\n    blended_tr = (1-anchor_h[np.newaxis,:,np.newaxis])*b_tr + anchor_h[np.newaxis,:,np.newaxis]*a_tr\n    blended_va = (1-anchor_h[np.newaxis,:,np.newaxis])*b_va + anchor_h[np.newaxis,:,np.newaxis]*a_va\n    \n    # Per-horizon median bias\n    h_bias = np.zeros(nh)\n    for h in range(nh):\n        m = m_tr[:, h, :]\n        h_bias[h] = np.median(blended_tr[:,h,:][m] - t_tr[:,h,:][m])\n    corrected_tr = blended_tr - h_bias[np.newaxis,:,np.newaxis]\n    corrected_va = blended_va - h_bias[np.newaxis,:,np.newaxis]\n    residual_tr = corrected_tr - t_tr\n    \n    # Time-of-day Fourier bias correction per horizon\n    # Fit: residual_h = a0 + a1*sin(2pi*tod) + b1*cos(2pi*tod) + a2*sin(4pi*tod) + b2*cos(4pi*tod) + ...\n    n_fourier = 3\n    tod_coefs = np.zeros((nh, 1 + 2*n_fourier))  # intercept + sin/cos pairs\n    \n    for h in range(nh):\n        m = m_tr[:, h, :]\n        # For each sample, get average residual at that horizon and tod\n        samp_resid = np.zeros(len(train_idx))\n        samp_tod = c_tr[:, h, 0]\n        valid = np.zeros(len(train_idx), dtype=bool)\n        for i in range(len(train_idx)):\n            mi = m[i, :]\n            if mi.sum() > 0:\n                samp_resid[i] = residual_tr[i, h, :][mi].mean()\n                valid[i] = True\n        \n        if valid.sum() < 10:\n            tod_coefs[h, 0] = 0\n            continue\n        \n        tod_v = samp_tod[valid]\n        res_v = samp_resid[valid]\n        \n        # Build Fourier features\n        X = np.ones((len(tod_v), 1 + 2*n_fourier))\n        for k in range(1, n_fourier+1):\n            X[:, 2*k-1] = np.sin(2*np.pi*k*tod_v)\n            X[:, 2*k] = np.cos(2*np.pi*k*tod_v)\n        \n        # Ridge regression\n        alpha = 5.0\n        coef = np.linalg.lstsq(X.T @ X + alpha*np.eye(X.shape[1]), X.T @ res_v, rcond=None)[0]\n        tod_coefs[h] = coef\n    \n    # Apply ToD correction to validation\n    for h in range(nh):\n        tod_v = c_va[:, h, 0]\n        X = np.ones((len(tod_v), 1 + 2*n_fourier))\n        for k in range(1, n_fourier+1):\n            X[:, 2*k-1] = np.sin(2*np.pi*k*tod_v)\n            X[:, 2*k] = np.cos(2*np.pi*k*tod_v)\n        correction = X @ tod_coefs[h]\n        corrected_va[:, h, :] = corrected_va[:, h, :] - correction[:, np.newaxis]\n    \n    # Per-node bias\n    residual_tr2 = corrected_tr.copy()\n    for h in range(nh):\n        tod_v = c_tr[:, h, 0]\n        X = np.ones((len(tod_v), 1 + 2*n_fourier))\n        for k in range(1, n_fourier+1):\n            X[:, 2*k-1] = np.sin(2*np.pi*k*tod_v)\n            X[:, 2*k] = np.cos(2*np.pi*k*tod_v)\n        correction = X @ tod_coefs[h]\n        residual_tr2[:, h, :] = residual_tr2[:, h, :] - correction[:, np.newaxis]\n    residual_tr2 = residual_tr2 - t_tr\n    \n    node_shrink = 0.4\n    node_bias = np.zeros(nn)\n    for n in range(nn):\n        m = m_tr[:, :, n]\n        if m.sum() > 5:\n            node_bias[n] = np.median(residual_tr2[:,:,n][m])\n    node_bias = node_shrink * node_bias\n    corrected_va = corrected_va - node_bias[np.newaxis, np.newaxis, :]\n    \n    return corrected_va\n\nmae, std = cv_evaluate(tod_fourier_pred)\nprint(f'+ ToD Fourier (n=3, alpha=5): MAE = {mae:.4f} +/- {std:.4f}')\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

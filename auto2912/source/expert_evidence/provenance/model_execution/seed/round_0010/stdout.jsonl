nh_shrink = 0.15\n    bias_nh = np.zeros((nh, nn))\n    res_tr = corrected_tr - t_tr\n    for h in range(nh):\n        for n in range(nn):\n            m = m_tr[:, h, n]\n            if m.sum() > 0:\n                bias_nh[h,n] = pnh_shrink * np.median(res_tr[:,h,n][m])\n    corrected_tr = corrected_tr - bias_nh[np.newaxis,:,:]\n    corrected_va = corrected_va - bias_nh[np.newaxis,:,:]\n    \n    # Mult factor\n    mult_shrink = 0.5\n    mult_factor = np.ones(nn)\n    for n in range(nn):\n        m = m_tr[:, :, n]\n        p = corrected_tr[:,:,n][m]\n        tgt = t_tr[:,:,n][m]\n        if m.sum() > 20 and np.min(p) > 1:\n            mult_factor[n] = np.median(tgt / p)\n    mult_factor = 1.0 + mult_shrink * (mult_factor - 1.0)\n    corrected_tr = corrected_tr * mult_factor[np.newaxis, np.newaxis, :]\n    corrected_va = corrected_va * mult_factor[np.newaxis, np.newaxis, :]\n    res_tr = corrected_tr - t_tr\n    \n    # Graph smoothing of bias: for each node, the neighbor-averaged residual \n    # tells us about local bias. Learn per-horizon graph smoothing weight.\n    # Apply: new_pred[i,h,n] = pred[i,h,n] - alpha * avg_neighbor_residual_pred\n    # But we don't have residuals at test time... \n    # Instead: use graph-smoothed BASE forecast as a feature.\n    # Or: use graph smooth of the prediction itself as denoising.\n    \n    # Idea: Graph denoising - blend prediction with graph-smoothed prediction\n    # pred_smooth[i,h,:] = pred[i,h,:] @ A_rn.T\n    # final = (1-w)*pred + w*pred_smooth\n    # This is like graph convolution denoising\n    \n    best_graph_w = np.zeros(nh)\n    for h in range(nh):\n        m = m_tr[:, h, :]\n        best_mae, best_w = float('inf'), 0\n        for w in np.linspace(0, 0.5, 26):\n            p = corrected_tr[:, h, :].copy()\n            p_smooth = p @ A_rn.T\n            p_denoised = (1-w)*p + w*p_smooth\n            mae = np.abs(p_denoised[m] - t_tr[:,h,:][m]).mean()\n            if mae < best_mae: best_mae, best_w = mae, w\n 
{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np\nfrom sklearn.linear_model import Ridge\n\ntrain_feats = np.load('/workspace/public_assets/train_features.npz')\ntrain_targets = np.load('/workspace/public_assets/train_targets.npz')\n\nbase = train_feats['base'].astype(np.float64)\ntargets = train_targets['target'].astype(np.float64)\nanchor = train_feats['anchor'].astype(np.float64)\nhistory = train_feats['history'].astype(np.float64)\nclock = train_feats['clock'].astype(np.float64)\n\nn_samples, n_horizons, n_nodes = base.shape\nmask = np.isfinite(targets) & (targets > 0) & (base > 0) & (anchor > 0)\n\nprint(f'Mask coverage (all positive): {mask.sum()} / {mask.size} = {mask.mean():.3f}')\n\n# Variance decomposition\nprint()\nprint('=== Variance decomposition of residual ===')\nfor h in [0, 5, 11]:\n    m = mask[:, h, :]\n    resid = (base[:, h, :] - targets[:, h, :])\n    \n    total_var = np.var(resid[m])\n    \n    # Per-node variance in mean bias\n    node_means = np.zeros(n_nodes)\n    for n in range(n_nodes):\n        mn = mask[:, h, n]\n        if mn.sum() > 0:\n            node_means[n] = resid[:, n][mn].mean()\n    node_var = np.var(node_means)\n    \n    # Per-sample variance in mean bias\n    sample_means = np.zeros(n_samples)\n    for i in range(n_samples):\n        mi = mask[i, h, :]\n        if mi.sum() > 0:\n            sample_means[i] = resid[i, :][mi].mean()\n    sample_var = np.var(sample_means)\n    \n    # Per-tod variance\n    tod_vals = np.sort(np.unique(clock[:, h, 0]))\n    tod_means = []\n    for cv in tod_vals:\n        idx = np.abs(clock[:, h, 0] - cv) < 0.001\n        mi = m & idx[:, np.newaxis]\n        if mi.sum() > 0:\n            tod_means.append(resid[mi].mean())\n    tod_var = np.var(tod_means)\n    \n    print(f'  h={h}: total={total_var:.1f}, node={node_var:.1f} ({node_var/total_var*100:.1f}%), sample={sample_var:.1f} ({sample_var/total_var*100:.1f}%), tod={tod_var:.1f} ({tod_var/total_var*100:.1f}%)')\n\n# Key insight: per-sample variance is large\"'!\n# Can we estimate per-sample bias?\nprint()\nprint('\"'=== Per-sample bias estimation ===')\n# Using base vs anchor difference as proxy for sample-level bias\n# Or: using history to estimate sample-level bias\nfor h in [0, 5, 11]:\n    m = mask[:, h, :]\n    sample_resid = np.array([\n        (base[i, h, :][mask[i,h,:]] - targets[i, h, :][mask[i,h,:]]).mean()\n        for i in range(n_samples)\n    ])\n    \n    # Can base h0 - hist_last predict sample-level bias?\n    sample_drift = np.array([\n        (base[i, 0, :][mask[i,h,:]] - history[i, -1, :][mask[i,h,:]]).mean()\n        for i in range(n_samples)\n    ])\n    \n    valid = np.isfinite(sample_resid) & np.isfinite(sample_drift)\n    corr = np.corrcoef(sample_resid[valid], sample_drift[valid])[0,1]\n    print(f'  h={h}: corr(sample_bias, base_h0 - hist_last) = {corr:.4f}')\n    \n    # How about base - anchor as predictor of sample bias?\n    sample_ba_diff = np.array([\n        (base[i, h, :][mask[i,h,:]] - anchor[i, h, :][mask[i,h,:]]).mean()\n        for i in range(n_samples)\n    ])\n    valid = np.isfinite(sample_resid) & np.isfinite(sample_ba_diff)\n    corr2 = np.corrcoef(sample_resid[valid], sample_ba_diff[valid])[0,1]\n    print(f'  h={h}: corr(sample_bias, base - anchor) = {corr2:.4f}')\n\n# Multiplicative bias analysis (in ratio form, not log)\nprint()\nprint('=== Multiplicative bias analysis ===')\nfor h in [0, 5, 11]:\n    m = mask[:, h, :]\n    ratio = targets[:, h, :][m] / base[:, h, :][m]\n    print(f'  h={h}: ratio mean={ratio.mean():.4f}, median={np.median(ratio):.4f}, std={ratio.std():.4f}')\n    \n    # Is the ratio correlated with base value?\n    corr = np.corrcoef(base[:,h,:][m], ratio)[0,1]\n    print(f'  h={h}: corr(base_value, target/base ratio) = {corr:.4f}')\n\n# Now let me look at per-node additive vs multiplicative\nprint()\nprint('=== Per-node: additive vs multiplicative correction ===')\n# Compare: per-node additive bias correction vs per-node multiplicative\n# Which gives better MAE?\nh_bias = np.zeros(n_horizons)\nfor h in range(n_horizons):\n    m = mask[:, h, :]\n    h_bias[h] = np.median(base[:,h,:][m] - targets[:,h,:][m])\n\n# Per-node additive bias (after per-horizon correction)\nnode_add = np.zeros(n_nodes)\ncorrected = base - h_bias[np.newaxis, :, np.newaxis]\nfor n in range(n_nodes):\n    m = mask[:, :, n]\n    if m.sum() > 5:\n        node_add[n] = np.median((corrected[:,:,n] - targets[:,:,n])[m])\n\n# Per-node multiplicative factor\nnode_mult = np.ones(n_nodes)\nfor n in range(n_nodes):\n    m = mask[:, :, n]\n    if m.sum() > 5:\n        ratios = targets[:,:,n][m] / base[:,:,n][m]\n        node_mult[n] = np.median(ratios)\n\nprint(f'Node additive bias: mean={node_add.mean():.3f}, std={node_add.std():.3f}')\nprint(f'Node mult factor: mean={node_mult.mean():.4f}, std={node_mult.std():.4f}')\n\n# Quick test: which is better?\ndef test_node_correction(mode='add'):\n    total_mae = 0\n    total_count = 0\n    for h in range(n_horizons):\n        m = mask[:, h, :]\n        if mode == 'add':\n            pred = base[:,h,:] - h_bias[h] - node_add[np.newaxis, :]\n        elif mode == 'mult':\n            pred = base[:,h,:] * node_mult[np.newaxis, :] - h_bias[h]\n        elif mode == 'both':\n            pred = base[:,h,:] * node_mult[np.newaxis, :] - h_bias[h] - node_add[np.newaxis, :]\n        pred = np.maximum(pred, 0)\n        mae = np.abs(pred[m] - targets[:,h,:][m]).mean()\n        total_mae += mae * m.sum()\n        total_count += m.sum()\n    return total_mae / total_count\n\nprint(f'Per-horizon only: {test_node_correction(\\\\\\\"add\\\\\\\") - (np.abs((base - h_bias[np.newaxis,:,np.newaxis] - targets)[mask]).mean()):.4f} baseline')\nbase_h_mae = np.abs((base - h_bias[np.newaxis,:,np.newaxis] - targets)[mask]).mean()\nprint(f'Per-horizon median bias MAE: {base_h_mae:.4f}')\nprint(f'+ per-node additive: {np.abs((base - h_bias[np.newaxis,:,np.newaxis] - node_add[np.newaxis,np.newaxis,:] - targets)[mask]).mean():.4f}')\nprint(f'+ per-node multiplicative: {np.abs((base * node_mult[np.newaxis,np.newaxis,:] - h_bias[np.newaxis,:,np.newaxis] - targets)[mask]).mean():.4f}')\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

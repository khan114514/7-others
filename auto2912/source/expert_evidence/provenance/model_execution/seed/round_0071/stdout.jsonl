is=1)\n                hist_avg_te = history[te_idx, :, n].mean(axis=1)\n                \n                # Training features\n                feat_tr = np.column_stack([\n                    base[tr_idx, h, n][m_tr],\n                    anchor[tr_idx, h, n][m_tr],\n                    hist_last_tr[m_tr],\n                    hist_avg_tr[m_tr],\n                    np.sin(2*np.pi*tod_tr[m_tr]),\n                    np.cos(2*np.pi*tod_tr[m_tr]),\n                ])\n                X_tr.append(feat_tr)\n                y_tr.append(targets[tr_idx, h, n][m_tr])\n                \n                # Test features (all, we'll mask later)\n                feat_te = np.column_stack([\n                    base[te_idx, h, n],\n                    anchor[te_idx, h, n],\n                    hist_last_te,\n                    hist_avg_te,\n                    np.sin(2*np.pi*tod_te),\n                    np.cos(2*np.pi*tod_te),\n                ])\n                X_te.append(feat_te)\n            \n            X_tr = np.vstack(X_tr)\n            y_tr = np.concatenate(y_tr)\n            \n            if len(y_tr) < 10:\n                # Fall back to base\n                for h in range(n_horizons):\n                    node_preds[:, h, n] = base[te_idx, h, n]\n                continue\n            \n            mu = X_tr.mean(axis=0)\n            sd = X_tr.std(axis=0)\n            sd[sd < 1e-6] = 1.0\n            Xs_tr = (X_tr - mu) / sd\n            \n            model = Ridge(alpha=node_alpha, fit_intercept=True)\n            model.fit(Xs_tr, y_tr)\n            \n            for h in range(n_horizons):\n                Xs_te = (X_te[h] - mu) / sd\n                node_preds[:, h, n] = model.predict(Xs_te)\n        \n        # Compute MAE\n        te_mask = mask[te_idx]\n        all_mae = np.abs(node_preds[te_mask] - targets[te_idx][te_mask]).mean()\n        base_mae_val = np.abs(base[te_idx][te_mask] - targets[te_idx][te_mask]).mean()\n        fold_mae.append(all_mae)\n     
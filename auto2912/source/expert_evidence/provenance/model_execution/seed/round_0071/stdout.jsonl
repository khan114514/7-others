zons):\n    m = mask[:, h, :]\n    h_bias[h] = np.median(blended[:, h, :][m] - targets[:, h, :][m])\ncorrected = blended - h_bias[np.newaxis, :, np.newaxis]\nresidual = corrected - targets\n\nnode_shrink = 0.4\nnode_bias = np.zeros(n_nodes)\nfor n in range(n_nodes):\n    m = mask[:, :, n]\n    if m.sum() > 5:\n        node_bias[n] = np.median(residual[:, :, n][m])\nnode_bias = node_shrink * node_bias\ncorrected = corrected - node_bias[np.newaxis, np.newaxis, :]\nresidual = corrected - targets\n\npnh_bias_shrink = 0.15\nbias_nh = np.zeros((n_horizons, n_nodes))\nfor h in range(n_horizons):\n    for n in range(n_nodes):\n        m = mask[:, h h, n]\n        if m.sum() > 0:\n            raw = np.median(residual[:, h, n][m])\n            bias_nh[h, n] = pnh_bias_shrink * raw\ncorrected = corrected - bias_nh[np.newaxis, :, :]\nresidual = corrected - targets\n\nmult_shrink = 0.5\nmult_factor = np.ones(n_nodes)\nfor n in range(n_nodes):\n    m = mask[:, :, n]\n    p = corrected[:, :, n][m]\n    tgt = targets[:, :, n][m]\n    if m.sum() > 20 and np.min(p) > 1:\n        ratios = tgt / p\n        mult_factor[n] = np.median(ratios)\nmult_factor = 1.0 + mult_shrink * (mult_factor - 1.0)\ncorrected = corrected * mult_factor[np.newaxis, np.newaxis, :]\nresidual = residual * mult_factor[np.newaxis, np.newaxis, :]\n\nprint(f'v25 calibration MAE (in-sample): {np.abs(residual[mask]).mean():.4f}')\n\n# CV for TOD-based correction with full feature set\n# Features per sample: sin/cos of TOD, and per-node: base level, history features\nprint()\nprint('=== Full CV analysis of residual prediction ===')\n\n# Let me try a different approach: per-horizon per-sample bias from TOD\n# More specifically: TOD bin median bias with shrinkage toward global\ntod = clock[:, :, 0]  # (74, 12)\n\n# Per-horizon TOD-bin bias with CV\nkf = KFold(n_splits=5, shuffle=True, random_state=42)\nprint()\nprint('=== Per-sample TOD bias correction (CV) ===')\nfor shrink in [0.0, 0.2, 0.4, 0.6, 0.8]:\n    fold_improvements = []\n    for tr_idx, te_idx in kf.split(np.arange(n_samples)):\n        base_mae_list = []\n        corr_mae_list = []\n        for h in range(n_horizons):\n            m_tr = mask[tr_idx, h, :]\n            m_te = mask[te_idx, h, :]\n            \n            # Compute TOD bin bias on training samples\n            tod_h = tod[:, h h]  # TOD values for all samples at this horizon\n            tod_tr = tod_h[tr_idx]\n            # Bin TOD into 24 hour bins\n            n_bins = 24\n            bin_edges = np.linspace(0, 1, n_bins + 1)\n            bin_tr = np.digitize(tod_tr, bin_edges) - 1\n            bin_te = np.digitize(tod_h[te_idx], bin_edges) - 1\n            \n            # Global per-horizon bias (train)\n            global_bias = residual[tr_idx, h h, :][m_tr].mean()\n            \n            # Per-bin bias\n            bin_bias = np.full(n_bins, global_bias)\n            for b in range(n_bins):\n                in_bin = bin_tr == b\n                if in_bin.sum() > 0:\n                    m_bin = m_tr[in_bin]\n                    bin_bias[b] = residual[tr_idx[in_bin], h, :][m_bin].mean()\n            \n            # Shrink toward global\n            bin_bias_shrunk = shrink * global_bias + (1 - shrink) * bin_bias\n            \n            # Apply to test\n            y_te = residual[te_idx, h h, :][m_te]\n            # Correction: subtract predicted bias (bin_bias)\n            correction = np.zeros_like(y_te)\n            idx = 0\n            for i_s, s in enumerate(te_idx):\n                b = bin_te[i_s]\n                nv = int(m_te[i_s].sum())\n                correction[idx:idx+nv] = bin_bias_shrunk[b]\n                idx += nv\n            \n            base_mae_list.append(np.abs(y_te).mean())\n            corr_mae_list.append(np.abs(y_te - correction).mean())\n        \n        imp = np.mean(base_mae_list) - np.mean(corr_mae_list)\n        fold_improvements.append(imp)\n    \n    print(f'  shrink={shrink:.1f}: avg_improvement={np.me
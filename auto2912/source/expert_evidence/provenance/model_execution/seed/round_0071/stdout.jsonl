{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/sh -lc \"python3 -c \\\"\nimport numpy as np\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_tgt = np.load('/workspace/public_assets/train_targets.npz')\nbase = train_feat['base'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\ntargets = train_tgt['target'].astype(np.float64)\n\nn_samples, n_horizons, n_nodes = base.shape\nmask = np.isfinite(targets) & (targets > 0)\n\n# Clock is 24 hours (24 unique values per h=0), each horizon adds ~3.5 min\n# so each horizon is ~5 minutes. 12 horizons = 1 hour forecast.\n\n# Let's check if TOD-dependent bias exists\n# Bin TOD into 24 hours and look at per-hour bias\ntod_h0 = clock[:, 0, 0]  # TOD for each sample at horizon 0\ntod_bins = np.digitize(tod_h0, np.linspace(0, 1, 25)) - 1  # 0..23\n\nprint('=== TOD bias analysis (h=0) ===')\nfor b in range(24):\n    s = tod_bins == b\n    if s.sum() > 0:\n        m = mask[s, 0, :]\n        bias = (base[s, 0, :][m] - targets[s, 0, :][m]).mean()\n        print(f'  TOD bin {b:2d} (n={s.sum():2d}): mean_bias={bias:.3f}')\n\n# How does history-based recent value compare to base?\n# history has 12 steps. Last history step is closest in time.\nprint()\nprint('=== History analysis ===')\nhist_last = history[:, -1, :]  # (74, 170)\n# Compare history last value to target at h=0\nm0 = mask[:, 0, :]\nhist_mae_h0 = np.abs(hist_last[m0] - targets[:, 0, :][m0]).mean()\nbase_mae_h0 = np.abs(base[:, 0, :][m0] - targets[:, 0, :][m0]).mean()\nprint(f'  history-last MAE at h=0: {hist_mae_h0:.4f}')\nprint(f'  base MAE at h=0: {base_mae_h0:.4f}')\n\n# Is history useful for correcting base?\n# residual vs (base - history_last)\ndiff_base_hist = base[:, 0, :] - hist_last\nresid_h0 = base[:, 0, :] - targets[:, 0, :]\nm = mask[:, 0, :].flatten()\ncorr = np.corrcoef(diff_base_hist.flatten()[m], resid_h0.flatten()[m])[0,1]\nprint(f'  correlation (base-hist_last) vs residual at h=0: {corr:.4f}')\n\n# Try: per-node simple linear correction using history\n# base_corrected = base + alpha * (hist_last - base[:,0,:]) for h=0\n# Essentially blending base with recent observation\nprint()\nprint('=== History blending at h=0 ===')\nfor w in np.linspace(0, 0.5, 11):\n    pred = (1-w)*base[:, 0, :] + w*hist_last\n    mae = np.abs(pred[m0] - targets[:, 0, :][m0]).mean()\n    print(f'  w={w:.2f}: MAE={mae:.4f}')\n\n# What about per horizon? History might still be informative for short horizons\nprint()\nprint('=== History blending per horizon ===')\nfor h in range(12):\n    mh = mask[:, h, :]\n    base_mae = np.abs(base[:, h, :][mh] - targets[:, h, :][mh]).mean()\n    # Find best blend weight\n    best_w, best_mae = 0, base_mae\n    for w in np.linspace(0, 0.4, 21):\n        pred = (1-w)*base[:, h, :] + w*hist_last\n        mae = np.abs(pred[mh] - targets[:, h, :][mh]).mean()\n        if mae < best_mae:\n            best_mae = mae\n            best_w = w\n    print(f'  h={h:2d}: base={base_mae:.4f}, best_w={best_w:.2f}, best_mae={best_mae:.4f}')\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

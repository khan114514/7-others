ias[h] = np.median(blended[:, h, :][m] - targets[:, h, :][m])\ncorrected = blended - h_bias[np.newaxis, :, np.newaxis]\nresidual = corrected - targets\n\nnode_shrink = 0.4\nnode_bias = np.zeros(n_nodes)\nfor n in range(n_nodes):\n    m = mask[:, :, n]\n    if m.sum() > 5:\n        node_bias[n] = np.median(residual[:, :, n][m])\nnode_bias = node_shrink * node_bias\ncorrected = corrected - node_bias[np.newaxis, np.newaxis, :]\nresidual = corrected - targets\n\npnh_bias_shrink = 0.15\nbias_nh = np.zeros((n_horizons, n_nodes))\nfor h in range(n_horizons):\n    for n in range(n_nodes):\n        m = mask[:, h, n]\n        if m.sum() > 0:\n            raw = np.median(residual[:, h, n][m])\n            bias_nh[h, n] = pnh_bias_shrink * raw\ncorrected = corrected - bias_nh[np.newaxis, :, :]\nresidual = corrected - targets\n\nmult_shrink = 0.5\nmult_factor = np.ones(n_nodes)\nfor n in range(n_nodes):\n    m = mask[:, :, n]\n    p = corrected[:, :, n][m]\n    tgt = targets[:, :, n][m]\n    if m.sum() > 20 and np.min(p) > 1:\n        ratios = tgt / p\n        mult_factor[n] = np.median(ratios)\nmult_factor = 1.0 + mult_shrink * (mult_factor - 1.0)\ncorrected = corrected * mult_factor[np.newaxis, np.newaxis, :]\nresidual = residual * mult_factor[np.newaxis, np.newaxis, :]\n\nprint(f'v25 calibration MAE (in-sample): {np.abs(residual[mask]).mean():.4f}')\n\n# CV for TOD-based per-sample bias correction\ntod = clock[:, :, 0]\nkf = KFold(n_splits=5, shuffle=True, random_state=42)\n\nprint()\nprint('=== TOD-bin per-sample bias correction (CV) ===')\nfor shrink in [0.0, 0.3, 0.5, 0.7, 0.9]:\n    fold_improvements = []\n    for tr_idx, te_idx in kf.split(np.arange(n_samples)):\n        base_mae_h = []\n        corr_mae_h = []\n        for h in range(n_horizons):\n            m_tr = mask[tr_idx, h, :]\n            m_te = mask[te_idx, h, :]\n            \n            tod_h = tod[:, h]\n            tod_tr = tod_h[tr_idx]\n            \n            n_bins = 24\n            bin_edges = np.linspace(0, 1, n_bins + 1)\n            bin_tr = np.digitize(tod_tr, bin_edges) - 1\n            bin_te = np.digitize(tod_h[te_idx], bin_edges) - 1\n            \n            global_bias = residual[tr_idx, h, :][m_tr].mean()\n            \n            bin_bias = np.full(n_bins, global_bias)\n            for b in range(n_bins):\n                in_bin = bin_tr == b\n                if in_bin.sum() > 0:\n                    m_bin = m_tr[in_bin]\n                    bin_bias[b] = residual[tr_idx[in_bin], h, :][m_bin].mean()\n            \n            bin_bias_shrunk = shrink * global_bias + (1 - shrink) * bin_bias\n            \n            y_te = residual[te_idx, h, :][m_te]\n            correction = np.zeros_like(y_te)\n            idx = 0\n            for i_s, s in enumerate(te_idx):\n                b = bin_te[i_s]\n                nv = int(m_te[i_s].sum())\n                correction[idx:idx+nv] = bin_bias_shrunk[b]\n                idx += nv\n            \n            base_mae_h.append(np.abs(y_te).mean())\n            corr_mae_h.append(np.abs(y_te - correction).mean())\n        \n        imp = np.mean(base_mae_h) - np.mean(corr_mae_h)\n        fold_improvements.append(imp)\n    \n    print(f'  shrink={shrink:.1f}: avg_improvement={np.mean(fold_improvements):.4f}')\n\n# Now try: ridge with richer features per sample\nprint()\nprint('=== Ridge per-sample residual prediction (CV) ===')\n# Features: sin/cos(tod), base_mean, anchor_mean, history_mean, history_last, history_trend\nfor h in [0, 6, 11]:\n    m_all = mask[:, h, :]  # (74, 170)\n    \n    # Per-sample features\n    tod_h = tod[:, h]\n    feat_base_mean = base[:, h, :].mean(axis=1)\n    feat_anchor_mean = anchor[:, h, :].mean(axis=1)\n    feat_hist_last = history[:, -1, :].mean(axis=1)\n    feat_hist_avg = history.mean(axis=(1,2))\n    feat_hist_trend = (history[:, -1, :] - history[:, 0, :]).mean(axis=1) / 12.0\n    \n    X_sample = np.column_stack([\n        np.sin(2 * np.pi * tod_h),\n        np.cos(2 * np.pi * tod_h),\n        feat_base_mean,\n        feat_anchor_mean,\n        feat_hist_last,\n        feat_hist_avg,\n        feat_hist_trend,\n    ])\n    \n    # For per-node residual, we'll predict per-sample mean residual and apply uniformly\n    sample_resid = np.zeros(n_samples)\n    for i in range(n_samples):\n        mi = m_all[i]\n        if mi.sum() > 0:\n            sample_resid[i] = residual[i, h, :][mi].mean()\n    \n    fold_base = []\n    fold_ridge = []\n    for tr_idx, te_idx in kf.split(np.arange(n_samples)):\n        valid_tr = np.isfinite(sample_resid[tr_idx])\n        valid_te = np.isfinite(sample_resid[te_idx])\n        tr = tr_idx[valid_tr]\n        te = te_idx[valid_te]\n        \n        mu = X_sample[tr].mean(axis=0)\n        sd = X_sample[tr].std(axis=0)\n        sd[sd < 1e-6] = 1.0\n        Xs_tr = (X_sample[tr] - mu) / sd\n        Xs_te = (X_sample[te] - mu) / sd\n        \n        for alpha in [1.0, 10.0, 100.0, 1000.0]:\n            model = Ridge(alpha=alpha, fit_intercept=True)\n            model.fit(Xs_tr, sample_resid[tr])\n            pred = model.predict(Xs_te)\n            \n            # Now compute node-level MAE\n            y_te_all = []\n            corr_te_all = []\n            for i_s, s in enumerate(te):\n                mi = m_all[s]\n                if mi.sum() > 0:\n                    y = residual[s, h, :][mi]\n                    y_te_all.append(y)\n                    corr_te_all.append(y - pred[i_s])\n            \n            y_flat = np.concatenate(y_te_all)\n            corr_flat = np.concatenate(corr_te_all)\n            base_mae = np.abs(y_flat).mean()\n            ridge_mae = np.abs(corr_flat).mean()\n            \n            if alpha == 100.0:\n                fold_base.append(base_mae)\n                fold_ridge.append(ridge_mae)\n    \n    print(f'  h={h:2d}: base={np.mean(fold_base):.4f}, ridge={np.mean(fold_ridge):.4f}, imp={np.mean(fold_base)-np.mean(fold_ridge):.4f}')\n\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

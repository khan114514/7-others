{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/sh -lc \"python3 -c \\\"\nimport numpy as np\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_tgt = np.load('/workspace/public_assets/train_targets.npz')\nbase = train_feat['base'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\ntargets = train_tgt['target'].astype(np.float64)\n\nn_samples, n_horizons, n_nodes = base.shape\nmask = np.isfinite(targets) & (targets > 0)\n\n# Compute current best method (v25) calibration error as baseline\n# Simple version: per-horizon median bias + global correction\n# Then see what structure remains in residual\n\n# Step 1: simple per-horizon median bias correction\nh_bias = np.zeros(n_horizons)\nfor h in range(n_horizons):\n    m = mask[:, h, :]\n    h_bias[h] = np.median(base[:, h, :][m] - targets[:, h, :][m])\n\ncorrected = base - h_bias[np.newaxis, :, np.newaxis]\nresidual = corrected - targets  # positive = overprediction\n\n# Cross-validation check: can we predict residual from features?\n# Try: does graph smoothing of base/history help?\ngraph = np.load('/workspace/public_assets/graph.npz')\nadj = graph['adjacency'].astype(np.float64)\n# Normalize adjacency\ndeg = adj.sum(axis=1, keepdims=True)\nadj_norm = adj / (deg + 1e-8)\n\nprint('=== Residual analysis after per-horizon median bias ===')\nprint(f'  MAE: {np.abs(residual[mask]).mean():.4f}')\n\n# Per-node residual std - is there spatial structure?\nnode_resid_std = np.zeros(n_nodes)\nfor n in range(n_nodes):\n    m = mask[:, :, n]\n    node_resid_std[n] = residual[:, :, n][m].std()\nprint(f'  per-node residual std: mean={node_resid_std.mean():.3f}, std={node_resid_std.std():.3f}')\n\n# Is residual spatially correlated?\n# Check: for each edge, are residuals correlated?\nedges = np.where(adj > 0)\nedge_corrs = []\nfor i, j in zip(edges[0], edges[1]):\n    if i >= j:\n        continue\n    ri = residual[:, :, i][mask[:, :, i]]\n    rj = residual[:, :, j][mask[:, :, j]]\n    min_len = min(len(ri), len(rj))\n    if min_len > 10:\n        corr = np.corrcoef(ri[:min_len], rj[:min_len])[0,1]\n        edge_corrs.append(corr)\nedge_corrs = np.array(edge_corrs)\nprint(f'  edge-wise residual correlation: mean={edge_corrs.mean():.4f}, median={np.median(edge_corrs):.4f}')\n\n# How about graph-smoothed base forecast vs raw?\nbase_smooth = base @ adj_norm.T\nbase_smooth_mae = np.abs(base_smooth[mask] - targets[mask]).mean()\nprint(f'  graph-smoothed base MAE: {base_smooth_mae:.4f}')\n\n# Blend raw and smoothed?\nfor w in [0.05, 0.1, 0.15, 0.2, 0.3]:\n    blended = (1-w)*base + w*base_smooth\n    mae = np.abs(blended[mask] - targets[mask]).mean()\n    print(f'  blend w={w:.2f}: MAE={mae:.4f}')\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

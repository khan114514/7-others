{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/sh -lc \"python3 << 'PYEOF'\nimport numpy as np\nfrom sklearn.linear_model import Ridge\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_tgt = np.load('/workspace/public_assets/train_targets.npz')\nbase = train_feat['base'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\ntargets = train_tgt['target'].astype(np.float64)\n\nn_samples, n_horizons, n_nodes = base.shape\nmask = np.isfinite(targets) & (targets > 0)\n\n# Reproduce v25 method to get residual, then see if TOD-based correction helps\nrng = np.random.RandomState(42)\n\n# Step 1: Per-horizon anchor blending\nanchor_h = np.zeros(n_horizons)\nfor h in range(n_horizons):\n    m = mask[:, h, :]\n    best_mae = float('inf')\n    for w in np.linspace(0, 0.30, 31):\n        pred = (1 - w) * base[:, h, :][m] + w * anchor[:, h, :][m]\n        mae = np.abs(pred - target[:, h, :][m]).mean() if False else np.abs(pred - targets[:, h, :][m]).mean()\n        if mae < best_mae:\n            best_mae = mae\n            anchor_h[h] = w\n\n# Step 2: per-node-horizon anchor\npna_shrink = 0.2\nanchor_nh = np.zeros((n_horizons, n_nodes))\nfor h in range(n_horizons):\n    for n in range(n_nodes):\n        m = mask[:, h, n]\n        if m.sum() > 15:\n            best_mae = float('inf')\n            best_w = anchor_h[h]\n            for w in np.linspace(0, 0.40, 21):\n                pred = (1 - w) * base[:, h, n][m] + w * anchor[:, h, n][m]\n                mae = np.abs(pred - targets[:, h, n][m]).mean()\n                if mae < best_mae:\n                    best_mae = mae\n                    best_w = w\n            anchor_nh[h, n] = best_w\n        else:\n            anchor_nh[h, n] = anchor_h[h]\nanchor_nh = pna_shrink * anchor_nh + (1 - pna_shrink) * anchor_h[:, np.newaxis]\nblended = (1 - anchor_nh[np.newaxis, :, :]) * base + anchor_nh[np.newaxis, :, :] * anchor\n\n# Step 3: per-horizon median bias\nh_bias = np.zeros(n_horizons)\nfor h in range(n_horizons):\n    m = mask[:, h, :]\n    h_bias[h] = np.median(blended[:, h, :][m] - targets[:, h, :][m])\ncorrected = blended - h_bias[np.newaxis, :, np.newaxis]\nresidual = corrected - targets\n\n# Step 4: per-node median bias\nnode_shrink = 0.4\nnode_bias = np.zeros(n_nodes)\nfor n in range(n_nodes):\n    m = mask[:, :, n]\n    if m.sum() > 5:\n        node_bias[n] = np.median(residual[:, :, n][m])\nnode_bias = node_shrink * node_bias\ncorrected = corrected - node_bias[np.newaxis, np.newaxis, :]\nresidual = corrected - targets\n\n# Step 5: per-node-horizon bias\npnh_bias_shrink = 0.15\nbias_nh = np.zeros((n_horizons, n_nodes))\nfor h in range(n_horizons):\n    for n in range(n_nodes):\n        m = mask[:, h, n]\n        if m.sum() > 0:\n            raw = np.median(residual[:, h, n][m])\n            bias_nh[h, n] = pnh_bias_shrink * raw\ncorrected = corrected - bias_nh[np.newaxis, :, :]\nresidual = corrected - targets\n\n# Step 6: multiplicative\nmult_shrink = 0.5\nmult_factor = np.ones(n_nodes)\nfor n in range(n_nodes):\n    m = mask[:, :, n]\n    p = corrected[:, :, n][m]\n    tgt = targets[:, :, n][m]\n    if m.sum() > 20 and np.min(p) > 1:\n        ratios = tgt / p\n        mult_factor[n] = np.median(ratios)\nmult_factor = 1.0 + mult_shrink * (mult_factor - 1.0)\ncorrected = corrected * mult_factor[np.newaxis, np.newaxis, :]\nresidual = residual * mult_factor[np.newaxis, np.newaxis, :]\n\nprint(f'v25 calibration MAE (in-sample): {np.abs(residual[mask]).mean():.4f}')\n\n# Now: does TOD help predict residual?\n# For each horizon, build a feature matrix with TOD sin/cos and see ridge CV MAE\nprint()\nprint('=== TOD-based residual prediction ===')\ntod = clock[:, :, 0]  # (74, 12) - TOD for each sample at each horizon\nfor h in range(n_horizons):\n    m = mask[:, h, :]  # (74, 170)\n    y = residual[:, h, :][m]  # flattened valid residuals\n    \n    # Features: TOD sin/cos per sample, repeated for each node\n    tod_h = tod[:, h]  # (74,)\n    sin_tod = np.sin(2 * np.pi * tod_h)\n    cos_tod = np.cos(2 * np.pi * tod_h)\n    \n    # Repeat per node\n    n_valid_per_sample = m.sum(axis=1)\n    X = np.zeros((y.shape[0], 2))\n    idx = 0\n    for i in range(n_samples):\n        nv = int(m[i].sum())\n        X[idx:idx+nv, 0] = sin_tod[i]\n        X[idx:idx+nv, 1] = cos_tod[i]\n        idx += nv\n    \n    # Ridge\n    for alpha in [0.1, 1.0, 10.0, 100.0]:\n        model = Ridge(alpha=alpha, fit_intercept=True)\n        model.fit(X, y)\n        pred = model.predict(X)\n        reduction = np.abs(y).mean() - np.abs(y - pred).mean()\n        if alpha == 10.0:\n            print(f'  h={h:2d}: raw_mae={np.abs(y).mean():.4f}, ridge_mae={np.abs(y-pred).mean():.4f}, reduction={reduction:.4f}')\n\n# In-sample analysis is overfit. Let's do proper CV.\nprint()\nprint('=== Cross-validated TOD correction ===')\nkf = KFold(n_splits=5, shuffle=True, random_state=42)\nfor h in [0, 3, 6, 9, 11]:\n    m = mask[:, h, :]\n    fold_mae_raw = []\n    fold_mae_tod = []\n    for tr_idx, te_idx in kf.split(np.arange(n_samples)):\n        m_tr = m[tr_idx]\n        m_te = m[te_idx]\n        y_tr = residual[tr_idx, h, :][m_tr]\n        y_te = residual[te_idx, h, :][m_te]\n        \n        tod_h = tod[:, h]\n        sin_tod = np.sin(2 * np.pi * tod_h)\n        cos_tod = np.cos(2 * np.pi * tod_h)\n        \n        def build_feats(samples, mask_s):\n            n = int(mask_s.sum())\n            X = np.zeros((n, 2))\n            idx = 0\n            for i_s, s in enumerate(samples):\n                nv = int(mask_s[i_s].sum())\n                X[idx:idx+nv, 0] = sin_tod[s]\n                X[idx:idx+nv, 1] = cos_tod[s]\n                idx += nv\n            return X\n        \n        X_tr = build_feats(tr_idx, m_tr)\n        X_te = build_feats(te_idx, m_te)\n        \n        fold_mae_raw.append(np.abs(y_te).mean())\n        for alpha in [1.0, 10.0, 100.0]:\n            model = Ridge(alpha=alpha, fit_intercept=True)\n            model.fit(X_tr, y_tr)\n            pred = model.predict(X_te)\n            mae = np.abs(y_te - pred).mean()\n            if alpha == 10.0:\n                fold_mae_tod.append(mae)\n    \n    print(f'  h={h:2d}: raw={np.mean(fold_mae_raw):.4f}, tod={np.mean(fold_mae_tod):.4f}, diff={np.mean(fold_mae_raw)-np.mean(fold_mae_tod):.4f}')\n\nfrom sklearn.model_selection import KFold\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

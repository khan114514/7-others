{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 << 'PYEOF'\nimport numpy as np\nfrom sklearn.model_selection import KFold\nfrom sklearn.linear_model import Ridge\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_tgt = np.load('/workspace/public_assets/train_targets.npz')\ntgt = train_tgt['target'].astype(np.float64)\nbase = train_feat['base'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\nmask = np.isfinite(tgt) & (tgt > 0)\n\nn_samples, n_horizons, n_nodes = base.shape\n\ndef compute_mae(pred, tgt, mask):\n    return np.abs(pred[mask] - tgt[mask]).mean()\n\nkf = KFold(n_splits=5, shuffle=True, random_state=42)\n\ndef fit_and_predict(train_idx, test_idx, seed=42, sample_alpha=10.0, sample_shrink=0.5,\n                    ridge_alpha=10.0, ridge_shrink=0.15):\n    \\\"\\\"\\\"v26: enhanced per-sample correction with richer features + node-level ridge\\\"\\\"\\\"\n    rng = np.random.RandomState(seed)\n    b_tr = base[train_idx].astype(np.float64)\n    a_tr = anchor[train_idx].astype(np.float64)\n    h_tr = history[train_idx].astype(np.float64)\n    c_tr = clock[train_idx].astype(np.float64)\n    t_tr = tgt[train_idx].astype(np.float64)\n    m_tr = mask[train_idx]\n    n_train = len(train_idx)\n    \n    # ---- Step 1: Per-horizon optimal anchor blending ----\n    anchor_h = np.zeros(n_horizons)\n    for h in range(n_horizons):\n        m = m_tr[:, h, :]\n        best_mae = float('inf')\n        for w in np.linspace(0, 0.30, 31):\n            pred = (1 - w) * b_tr[:, h, :][m] + w * a_tr[:, h, :][m]\n            mae = np.abs(pred - t_tr[:, h, :][m]).mean()\n            if mae < best_mae:\n                best_mae = mae\n                anchor_h[h] = w\n    \n    # ---- Step 2: Per-node-horizon anchor blending (shrunken) ----\n    pna_shrink = 0.2\n    anchor_nh = np.zeros((n_horizons, n_nodes))\n    for h in range(n_horizons):\n        for n in range(n_nodes):\n            m = m_tr[:, h, n]\n            if m.sum() > 15:\n                best_mae = float('inf')\n                best_w = anchor_h[h]\n                for w in np.linspace(0, 0.40, 21):\n                    pred = (1 - w) * b_tr[:, h, n][m] + w * a_tr[:, h, n][m]\n                    mae = np.abs(pred - t_tr[:, h, n][m]).mean()\n                    if mae < best_mae:\n                        best_mae = mae\n                        best_w = w\n                anchor_nh[h, n] = best_w\n            else:\n                anchor_nh[h, n] = anchor_h[h]\n    \n    anchor_nh = pna_shrink * anchor_nh + (1 - pna_shrink) * anchor_h[:, np.newaxis]\n    blended = (1 - anchor_nh[np.newaxis, :, :]) * b_tr + anchor_nh[np.newaxis, :, :] * a_tr\n    \n    # ---- Step 3: Per-horizon median bias ----\n    h_bias = np.zeros(n_horizons)\n    for h in range(n_horizons):\n        m = m_tr[:, h, :]\n        h_bias[h] = np.median(blended[:, h, :][m] - t_tr[:, h, :][m])\n    \n    corrected = blended - h_bias[np.newaxis, :, np.newaxis]\n    residual = corrected - t_tr\n    \n    # ---- Step 4: Per-node median bias (shrunken) ----\n    node_shrink = 0.4\n    node_bias = np.zeros(n_nodes)\n    for n in range(n_nodes):\n        m = m_tr[:, :, n]\n        if m.sum() > 5:\n            node_bias[n] = np.median(residual[:, :, n][m])\n    \n    node_bias = node_shrink * node_bias\n    corrected = corrected - node_bias[np.newaxis, np.newaxis, :]\n    residual = corrected - t_tr\n    \n    # ---- Step 5: Per-node-horizon median bias ----\n    pnh_bias_shrink = 0.15\n    bias_nh = np.zeros((n_horizons, n_nodes))\n    for h in range(n_horizons):\n        for n in range(n_nodes):\n            m = m_tr[:, h, n]\n            if m.sum() > 0:\n                raw = np.median(residual[:, h, n][m])\n                bias_nh[h, n] = pnh_bias_shrink * raw\n    \n    corrected = corrected - bias_nh[np.newaxis, :, :]\n    residual = corrected - t_tr\n    \n    # ---- Step 6: Multiplicative per-node correction ----\n    mult_shrink = 0.5\n    mult_factor = np.ones(n_nodes)\n    for n in range(n_nodes):\n        m = m_tr[:, :, n]\n        p = corrected[:, :, n][m]\n        tgt_n = t_tr[:, :, n][m]\n        if m.sum() > 20 and np.min(p) > 1:\n            ratios = tgt_n / p\n            mult_factor[n] = np.median(ratios)\n    \n    mult_factor = 1.0 + mult_shrink * (mult_factor - 1.0)\n    corrected = corrected * mult_factor[np.newaxis, np.newaxis, :]\n    residual = residual * mult_factor[np.newaxis, np.newaxis, :]\n    \n    # ---- Step 7: Enhanced per-sample correction with richer features ----\n    # For each horizon, fit a ridge model of sample mean residual on:\n    #  - mean(base - anchor)\n    #  - mean(base - hist_last)\n    #  - mean(hist_trend)\n    #  - time-of-day sin/cos (1x and 2x)\n    #  - mean(hist_last)\n    sample_features_tr = []\n    sample_residuals_tr = []\n    for h in range(n_horizons):\n        feat_h = np.zeros((n_train, 7))\n        resid_h = np.zeros(n_train)\n        valid = np.zeros(n_train, dtype=bool)\n        for i in range(n_train):\n            mi = m_tr[i, h, :]\n            if mi.sum() > 0:\n                feat_h[i, 0] = (b_tr[i, h, :][mi] - a_tr[i, h, :][mi]).mean()\n                feat_h[i, 1] = (b_tr[i, h, :][mi] - h_tr[i, -1, :][mi]).mean()\n                feat_h[i, 2] = (h_tr[i, -1, :][mi] - h_tr[i, 0, :][mi]).mean() / 12.0\n                feat_h[i, 3] = np.sin(2*np.pi*c_tr[i, h, 0])\n                feat_h[i, 4] = np.cos(2*np.pi*c_tr[i, h, 0])\n                feat_h[i, 5] = np.sin(4*np.pi*c_tr[i, h, 0])\n                feat_h[i, 6] = np.cos(4*np.pi*c_tr[i, h, 0])\n                resid_h[i] = residual[i, h, :][mi].mean()\n                valid[i] = True\n        \n        sample_features_tr.append(feat_h[valid])\n        sample_residuals_tr.append(resid_h[valid])\n    \n    # Fit ridge per horizon\n    sample_models = []\n    for h in range(n_horizons):\n        X = sample_features_tr[h]\n        y = sample_residuals_tr[h]\n        if len(y) < 10:\n            sample_models.append(None)\n            continue\n        model = Ridge(alpha=sample_alpha, fit_intercept=True)\n        model.fit(X, y)\n        sample_models.append(model)\n    \n    # Apply sample correction to training\n    for h in range(n_horizons):\n        if sample_models[h] is None:\n            continue\n        feat_h = np.zeros((n_train, 7))\n        for i in range(n_train):\n            mi = m_tr[i, h, :]\n            if mi.sum() > 0:\n                feat_h[i, 0] = (b_tr[i, h, :][mi] - a_tr[i, h, :][mi]).mean()\n                feat_h[i, 1] = (b_tr[i, h, :][mi] - h_tr[i, -1, :][mi]).mean()\n                feat_h[i, 2] = (h_tr[i, -1, :][mi] - h_tr[i, 0, :][mi]).mean() / 12.0\n                feat_h[i, 3] = np.sin(2*np.pi*c_tr[i, h, 0])\n                feat_h[i, 4] = np.cos(2*np.pi*c_tr[i, h, 0])\n                feat_h[i, 5] = np.sin(4*np.pi*c_tr[i, h, 0])\n                feat_h[i, 6] = np.cos(4*np.pi*c_tr[i, h, 0])\n        pred_bias = sample_models[h].predict(feat_h)\n        corrected[:, h, :] -= sample_shrink * pred_bias[:, np.newaxis]\n        residual[:, h, :] -= sample_shrink * pred_bias[:, np.newaxis]\n    \n    # ---- Step 8: Node-level ridge correction per horizon ----\n    hist_last_tr = h_tr[:, -1, :]\n    hist_avg_tr = h_tr.mean(axis=1)\n    hist_trend_tr = (h_tr[:, -1, :] - h_tr[:, 0, :]) / 12.0\n    \n    node_idx_flat = np.tile(np.arange(n_nodes), (n_train, 1)).reshape(-1)\n    node_sin = np.sin(2*np.pi*node_idx_flat/n_nodes)\n    node_cos = np.cos(2*np.pi*node_idx_flat/n_nodes)\n    \n    ridge_models = []\n    for h in range(n_horizons):\n        m = m_tr[:, h, :].flatten()\n        y = residual[:, h, :].flatten()[m]\n        if len(y) < 100:\n            ridge_models.append(None)\n            continue\n        \n        clock_h = c_tr[:, h, 0]\n        clock_rep = np.repeat(clock_h, n_nodes)\n        \n        X = np.column_stack([\n            corrected[:, h, :].flatten(),\n            a_tr[:, h, :].flatten(),\n            hist_last_tr.flatten(),\n            hist_avg_tr.flatten(),\n            hist_trend_tr.flatten(),\n            np.sin(2*np.pi*clock_rep),\n            np.cos(2*np.pi*clock_rep),\n            np.sin(4*np.pi*clock_rep),\n            np.cos(4*np.pi*clock_rep),\n            node_sin,\n            node_cos,\n            corrected[:, h, :].flatten() - a_tr[:, h, :].flatten(),\n            corrected[:, h, :].flatten() - hist_last_tr.flatten(),\n        ])\n        X_valid = X[m]\n        \n        mu = X_valid.mean(axis=0)\n        sd = X_valid.std(axis=0)\n        sd[sd < 1e-6] = 1.0\n        Xs = (X_valid - mu) / sd\n        \n        model = Ridge(alpha=ridge_alpha, fit_intercept=True)\n        model.fit(Xs, y)\n        \n        ridge_models.append({\n            'coef': model.coef_, 'intercept': model.intercept_, 'mu': mu, 'sd': sd\n        })\n    \n    # ---- Predict on test ----\n    b_te = base[test_idx].astype(np.float64)\n    a_te = anchor[test_idx].astype(np.float64)\n    h_te = history[test_idx].astype(np.float64)\n    c_te = clock[test_idx].astype(np.float64)\n    n_test = len(test_idx)\n    \n    result = (1 - anchor_nh[np.newaxis]) * b_te + anchor_nh[np.newaxis] * a_te\n    result -= h_bias[np.newaxis, :, np.newaxis]\n    result -= node_bias[np.newaxis, np.newaxis, :]\n    result -= bias_nh[np.newaxis, :, :]\n    result *= mult_factor[np.newaxis, np.newaxis, :]\n    \n    # Sample correction\n    for h in range(n_horizons):\n        if sample_models[h] is None:\n            continue\n        feat_h = np.zeros((n_test, 7))\n        for i in range(n_test):\n            feat_h[i, 0] = (b_te[i, h, :] - a_te[i, h, :]).mean()\n            feat_h[i, 1] = (b_te[i, h, :] - h_te[i, -1, :]).mean()\n            feat_h[i, 2] = (h_te[i, -1, :] - h_te[i, 0, :]).mean() / 12.0\n            feat_h[i, 3] = np.sin(2*np.pi*c_te[i, h, 0])\n            feat_h[i, 4] = np.cos(2*np.pi*c_te[i, h, 0])\n            feat_h[i, 5] = np.sin(4*np.pi*c_te[i, h, 0])\n            feat_h[i, 6] = np.cos(4*np.pi*c_te[i, h, 0])\n        pred_bias = sample_models[h].predict(feat_h)\n        result[:, h, :] -= sample_shrink * pred_bias[:, np.newaxis]\n    \n    # Ridge correction\n    hist_last_te = h_te[:, -1, :]\n    hist_avg_te = h_te.mean(axis=1)\n    hist_trend_te = (h_te[:, -1, :] - h_te[:, 0, :]) / 12.0\n    \n    node_idx_te = np.tile(np.arange(n_nodes), (n_test, 1)).reshape(-1)\n    node_sin_te = np.sin(2*np.pi*node_idx_te/n_nodes)\n    node_cos_te = np.cos(2*np.pi*node_idx_te/n_nodes)\n    \n    for h in range(n_horizons):\n        if ridge_models[h] is None:\n            continue\n        rm = ridge_models[h]\n        clock_h = c_te[:, h, 0]\n        clock_rep = np.repeat(clock_h, n_nodes)\n        \n        X = np.column_stack([\n            result[:, h, :].flatten(),\n            a_te[:, h, :].flatten(),\n            hist_last_te.flatten(),\n            hist_avg_te.flatten(),\n            hist_trend_te.flatten(),\n            np.sin(2*np.pi*clock_rep),\n            np.cos(2*np.pi*clock_rep),\n            np.sin(4*np.pi*clock_rep),\n            np.cos(4*np.pi*clock_rep),\n            node_sin_te,\n            node_cos_te,\n            result[:, h, :].flatten() - a_te[:, h, :].flatten(),\n            result[:, h, :].flatten() - hist_last_te.flatten(),\n        ])\n        Xs = (X - rm['mu']) / rm['sd']\n        correction = ridge_shrink * (Xs @ rm['coef'] + rm['intercept'])\n        result[:, h, :] -= correction.reshape(n_test, n_nodes)\n    \n    result = np.maximum(result, 0.0)\n    return compute_mae(result, tgt[test_idx], mask[test_idx])\n\n# Current v25 baseline\nimport sys\nsys.path.insert(0, '/workspace/solution')\nimport importlib\nimport method\nimportlib.reload(method)\n\nv25_maes = []\nfor tr, te in kf.split(np.arange(n_samples)):\n    feat_tr = {'base': base[tr], 'anchor': anchor[tr], 'history': history[tr], 'clock': clock[tr]}\n    state = method.fit(feat_tr, tgt[tr], seed=42)\n    feat_te = {'base': base[te], 'anchor': anchor[te], 'history': history[te], 'clock': clock[te]}\n    pred = method.predict(state, feat_te)\n    v25_maes.append(compute_mae(pred, tgt[te], mask[te]))\nprint(f'v25 (current) CV MAE: {np.mean(v25_maes):.4f} +/- {np.std(v25_maes):.4f}')\n\n# Test different configs\nprint()\nprint('Testing v26 variants:')\nfor sa in [1.0, 10.0]:\n    for ss in [0.3, 0.5, 0.7]:\n        for ra in [1.0, 10.0, 100.0]:\n            for rs in [0.1, 0.15, 0.2]:\n                maes = []\n                for tr, te in kf.split(np.arange(n_samples)):\n                    maes.append(fit_and_predict(tr, te, seed=42, sample_alpha=sa, sample_shrink=ss,\n                                                ridge_alpha=ra, ridge_shrink=rs))\n                print(f'  sa={sa}, ss={ss}, ra={ra}, rs={rs}: MAE={np.mean(maes):.4f} +/- {np.std(maes):.4f}')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

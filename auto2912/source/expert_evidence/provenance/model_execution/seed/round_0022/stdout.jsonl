{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_tgt = np.load('/workspace/public_assets/train_targets.npz')\ntgt = train_tgt['target'].astype(np.float64)\nbase = train_feat['base'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\nmask = np.isfinite(tgt) & (tgt > 0)\n\n# Explore history - last observation as a predictor\nprint('=== History analysis ===')\nhist_last = history[:, -1, :]  # last observed step\nprint('hist_last shape:', hist_last.shape)\n# How does last history step compare to base forecast for horizon 0?\n# For horizon 0, base should be close to last history if it's a 1-step forecast\n# But history has 12 steps of past observations\n\n# Check: can we use history residuals to predict forecast errors?\n# base - target is the error. Is error related to recent history?\nbase_error = base - tgt\n\n# Correlation of error with history features per horizon\nfor h in [0, 5, 11]:\n    m = mask[:, h, :]\n    err = base_error[:, h, :][m]\n    h_last = hist_last[m]\n    h_avg = history.mean(axis=1)[m]\n    h_trend = (history[:, -1, :] - history[:, 0, :])[m] / 12.0\n    print(f'H{h}: err vs hist_last corr = {np.corrcoef(err, h_last)[0,1]:.4f}')\n    print(f'H{h}: err vs hist_avg corr = {np.corrcoef(err, h_avg)[0,1]:.4f}')\n    print(f'H{h}: err vs hist_trend corr = {np.corrcoef(err, h_trend)[0,1]:.4f}')\n    base_flat = base[:, h, :][m]\n    print(f'H{h}: err vs base corr = {np.corrcoef(err, base_flat)[0,1]:.4f}')\n    anchor_flat = anchor[:, h, :][m]\n    print(f'H{h}: err vs anchor corr = {np.corrcoef(err, anchor_flat)[0,1]:.4f}')\n    print()\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

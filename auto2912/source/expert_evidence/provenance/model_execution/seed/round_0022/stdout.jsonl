t_idx, 0, :]) / 12.0\n    \n    node_idx_flat = np.tile(np.arange(n_nodes), (len(train_idx), 1)).reshape(-1)\n    node_sin = np.sin(2*np.pi*node_idx_flat/n_nodes)\n    node_cos = np.cos(2*np.pi*node_idx_flat/n_nodes)\n    \n    node_idx_te = np.tile(np.arange(n_nodes), (len(test_idx), 1)).reshape(-1)\n    node_sin_te = np.sin(2*np.pi*node_idx_te/n_nodes)\n    node_cos_te = np.cos(2*np.pi*node_idx_te/n_nodes)\n    \n    for h in range(n_horizons):\n        m = mask[train_idx][:, h, :].flatten()\n        y = (corrected_tr[:, h, :] - tgt[train_idx, h, :]).flatten()[m]\n        if len(y) < 50:\n            continue\n        \n        clock_h = clock[train_idx, h, 0]\n        clock_rep = np.repeat(clock_h, n_nodes)\n        \n        X_tr = np.column_stack([\n            corrected_tr[:, h, :].flatten(),\n            anchor[train_idx, h, :].flatten(),\n            hist_last_tr.flatten(),\n            hist_avg_tr.flatten(),\n            hist_trend_tr.flatten(),\n            np.sin(2*np.pi*clock_rep),\n            np.cos(2*np.pi*clock_rep),\n            np.sin(4*np.pi*clock_rep),\n            np.cos(4*np.pi*clock_rep),\n            node_sin,\n            node_cos,\n            corrected_tr[:, h, :].flatten() - anchor[train_idx, h, :].flatten(),\n            corrected_tr[:, h, :].flatten() - hist_last_tr.flatten(),\n        ])\n        X_valid = X_tr[m]\n        \n        mu = X_valid.mean(axis=0)\n        sd = X_valid.std(axis=0)\n        sd[sd < 1e-6] = 1.0\n        Xs = (X_valid - mu) / sd\n        \n        model = Ridge(alpha=ridge_alpha, fit_intercept=True)\n        model.fit(Xs, y)\n        \n        # Predict on test\n        clock_h_te = clock[test_idx, h, 0]\n        clock_rep_te = np.repeat(clock_h_te, n_nodes)\n        X_te = np.column_stack([\n            corrected_te[:, h, :].flatten(),\n            anchor[test_idx, h, :].flatten(),\n            hist_last_te.flatten(),\n            hist_avg_te.flatten(),\n            hist_trend_te.flatten(),\n            np.sin
{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 << 'PYEOF'\nimport numpy as np\nfrom sklearn.model_selection import KFold\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_tgt = np.load('/workspace/public_assets/train_targets.npz')\ntgt = train_tgt['target'].astype(np.float64)\nbase = train_feat['base'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\nmask = np.isfinite(tgt) & (tgt > 0)\ngraph = np.load('/workspace/public_assets/graph.npz')\nadj = graph['adjacency'].astype(np.float64)\n\nn_samples, n_horizons, n_nodes = base.shape\nD = adj.sum(axis=1)\nD_inv_sqrt = np.where(D > 0, 1.0 / np.sqrt(D), 0.0)\nadj_norm = D_inv_sqrt[:, None] * adj * D_inv_sqrt[None, :]\n\ndef compute_mae(pred, tgt, mask):\n    return np.abs(pred[mask] - tgt[mask]).mean()\n\n# Test many improvements systematically\nkf = KFold(n_splits=5, shuffle=True, random_state=42)\n\n# Idea: temporal pattern in errors - use clock features more richly\n# Idea: history-based ensemble with EWMA \n# Idea: per-sample residual prediction with richer features\n\n# Let me try a full ridge regression approach to residual prediction\n# Features: base, anchor, history_last, history_avg, history_trend, clock sin/cos, node_id sin/cos, base-anchor diff, base-history diff\nfrom sklearn.linear_model import Ridge\n\ndef full_ridge_method(train_idx, test_idx, ridge_alpha=1.0, ridge_shrink=0.3):\n    \\\"\\\"\\\"Full pipeline + ridge residual correction per horizon\\\"\\\"\\\"\n    # Step 1: anchor blending per-horizon\n    anchor_nh = np.zeros((n_horizons, n_nodes))\n    for h in range(n_horizons):\n        m = mask[train_idx][:, h, :]\n        best_mae = float('inf')\n        best_w = 0.0\n        for w in np.linspace(0, 0.3, 31):\n            pred = (1-w)*base[train_idx,h,:][m] + w*anchor[train_idx,h,:][m]\n            mae = np.abs(pred - tgt[train_idx,h,:][m]).mean()\n            if mae < best_mae:\n                best_mae = mae\n                best_w = w\n        anchor_nh[h, :] = best_w\n    \n    blended_tr = (1-anchor_nh[None])*base[train_idx] + anchor_nh[None]*anchor[train_idx]\n    blended_te = (1-anchor_nh[None])*base[test_idx] + anchor_nh[None]*anchor[test_idx]\n    \n    # Step 2: per-horizon median bias\n    h_bias = np.zeros(n_horizons)\n    for h in range(n_horizons):\n        m = mask[train_idx][:, h, :]\n        h_bias[h] = np.median(blended_tr[:, h, :][m] - tgt[train_idx, h, :][m])\n    \n    corrected_tr = blended_tr - h_bias[None, :, None]\n    corrected_te = blended_te - h_bias[None, :, None]\n    \n    # Step 3: per-node median bias (shrunken)\n    node_bias = np.zeros(n_nodes)\n    for n in range(n_nodes):\n        m = mask[train_idx][:, :, n]\n        if m.sum() > 5:\n            node_bias[n] = np.median(corrected_tr[:, :, n][m] - tgt[train_idx, :, n][m])\n    node_bias = 0.4 * node_bias\n    corrected_tr -= node_bias[None, None, :]\n    corrected_te -= node_bias[None, None, :]\n    \n    # Step 4: Multiplicative per-node\n    mult_factor = np.ones(n_nodes)\n    for n in range(n_nodes):\n        m = mask[train_idx][:, :, n]\n        p = corrected_tr[:, :, n][m]\n        tgt_n = tgt[train_idx, :, n][m]\n        if m.sum() > 20 and np.min(p) > 1:\n            mult_factor[n] = np.median(tgt_n / p)\n    mult_factor = 1.0 + 0.5 * (mult_factor - 1.0)\n    corrected_tr *= mult_factor[None, None, :]\n    corrected_te *= mult_factor[None, None, :]\n    \n    # Step 5: Ridge residual correction per horizon\n    hist_last_tr = history[train_idx, -1, :]\n    hist_avg_tr = history[train_idx].mean(axis=1)\n    hist_trend_tr = (history[train_idx, -1, :] - history[train_idx, 0, :]) / 12.0\n    hist_last_te = history[test_idx, -1, :]\n    hist_avg_te = history[test_idx].mean(axis=1)\n    hist_trend_te = (history[test_idx, -1, :] - history[test_idx, 0, :]) / 12.0\n    \n    node_idx_flat = np.tile(np.arange(n_nodes), (len(train_idx), 1)).reshape(-1)\n    node_sin = np.sin(2*np.pi*node_idx_flat/n_nodes)\n    node_cos = np.cos(2*np.pi*node_idx_flat/n_nodes)\n    \n    node_idx_te = np.tile(np.arange(n_nodes), (len(test_idx), 1)).reshape(-1)\n    node_sin_te = np.sin(2*np.pi*node_idx_te/n_nodes)\n    node_cos_te = np.cos(2*np.pi*node_idx_te/n_nodes)\n    \n    for h in range(n_horizons):\n        m = mask[train_idx][:, h, :].flatten()\n        y = (corrected_tr[:, h, :] - tgt[train_idx, h, :]).flatten()[m]\n        if len(y) < 50:\n            continue\n        \n        clock_h = clock[train_idx, h, 0]\n        clock_rep = np.repeat(clock_h, n_nodes)\n        \n        X_tr = np.column_stack([\n            corrected_tr[:, h, :].flatten(),\n            anchor[train_idx, h, :].flatten(),\n            hist_last_tr.flatten(),\n            hist_avg_tr.flatten(),\n            hist_trend_tr.flatten(),\n            np.sin(2*np.pi*clock_rep),\n            np.cos(2*np.pi*clock_rep),\n            np.sin(4*np.pi*clock_rep),\n            np.cos(4*np.pi*clock_rep),\n            node_sin,\n            node_cos,\n            corrected_tr[:, h, :].flatten() - anchor[train_idx, h, :].flatten(),\n            corrected_tr[:, h, :].flatten() - hist_last_tr.flatten(),\n        ])\n        X_valid = X_tr[m]\n        \n        mu = X_valid.mean(axis=0)\n        sd = X_valid.std(axis=0)\n        sd[sd < 1e-6] = 1.0\n        Xs = (X_valid - mu) / sd\n        \n        model = Ridge(alpha=ridge_alpha, fit_intercept=True)\n        model.fit(Xs, y)\n        \n        # Predict on test\n        clock_h_te = clock[test_idx, h, 0]\n        clock_rep_te = np.repeat(clock_h_te, n_nodes)\n        X_te = np.column_stack([\n            corrected_te[:, h, :].flatten(),\n            anchor[test_idx, h, :].flatten(),\n            hist_last_te.flatten(),\n            hist_avg_te.flatten(),\n            hist_trend_te.flatten(),\n            np.sin(2*np.pi*clock_rep_te),\n            np.cos(2*np.pi*clock_rep_te),\n            np.sin(4*np.pi*clock_rep_te),\n            np.cos(4*np.pi*clock_rep_te),\n            node_sin_te,\n            node_cos_te,\n            corrected_te[:, h, :].flatten() - anchor[test_idx, h, :].flatten(),\n            corrected_te[:, h, :].flatten() - hist_last_te.flatten(),\n        ])\n        Xs_te = (X_te - mu) / sd\n        correction = model.predict(Xs_te).reshape(len(test_idx), n_nodes)\n        corrected_te[:, h, :] -= ridge_shrink * correction\n    \n    corrected_te = np.maximum(corrected_te, 0.0)\n    return compute_mae(corrected_te, tgt[test_idx], mask[test_idx])\n\n# Test with different ridge settings\nfor alpha in [0.1, 1.0, 10.0, 100.0]:\n    for shrink in [0.1, 0.2, 0.3, 0.5]:\n        maes = []\n        for tr, te in kf.split(np.arange(n_samples)):\n            maes.append(full_ridge_method(tr, te, ridge_alpha=alpha, ridge_shrink=shrink))\n        print(f'Ridge alpha={alpha:.1f}, shrink={shrink:.2f}: MAE={np.mean(maes):.4f} +/- {np.std(maes):.4f}')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

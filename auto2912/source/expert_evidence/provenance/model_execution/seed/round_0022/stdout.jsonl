ne]*anchor[te]\n    blended_tr = (1-anchor_w[None,:,None])*base[tr] + anchor_w[None,:,None]*anchor[tr]\n    \n    # per-horizon bias\n    h_bias = np.zeros(n_horizons)\n    for h in range(n_horizons):\n        m = mask[tr][:, h, :]\n        h_bias[h] = np.median(blended_tr[:, h, :][m] - tgt[tr, h, :][m])\n    corrected = blended - h_bias[None, :, None]\n    corrected_tr = blended_tr - h_bias[None, :, None]\n    \n    maes_base.append(compute_mae(corrected, tgt[te], mask[te]))\n    \n    # Per-node bias\n    node_bias = np.zeros(n_nodes)\n    for n in range(n_nodes):\n        m = mask[tr][:, :, n]\n        if m.sum() > 5:\n            node_bias[n] = np.median(corrected_tr[:, :, n][m] - tgt[tr, :, n][m])\n    \n    # With graph smoothing\n    node_bias_smooth = graph_smooth(node_bias.copy(), adj_norm, n_iter=2)\n    \n    corrected_g = corrected - 0.4 * node_bias_smooth[None, None, :]\n    maes_graph.append(compute_mae(corrected_g, tgt[te], mask[te]))\n\nprint(f'Simple baseline CV MAE: {np.mean(maes_base):.4f} +/- {np.std(maes_base):.4f}')\nprint(f'+ graph-smoothed node bias: {np.mean(maes_graph):.4f} +/- {np.std(maes_graph):.4f}')\n\n# Try: history-based residual prediction\n# The last history step is the observed value just before forecast\n# base - last_history = \\\"jump\\\" from last observation\n# Maybe the error correlates with how much base differs from history\nmaes_hist = []\nfor tr, te in kf.split(np.arange(n_samples)):\n    anchor_w = np.zeros(n_horizons)\n    for h in range(n_horizons):\n        m = mask[tr][:, h, :]\n        best_mae = float('inf')\n        for w in np.linspace(0, 0.3, 31):\n            pred = (1-w)*base[tr,h,:][m] + w*anchor[tr,h,:][m]\n            mae = np.abs(pred - tgt[tr,h,:][m]).mean()\n            if mae < best_mae:\n                best_mae = mae\n                anchor_w[h] = w\n    \n    blended = (1-anchor_w[None,:,None])*base[te] + anchor_w[None,:,None]*anchor[te]\n    blended_tr = (1-anchor_w[None,:,None])*base[tr] + anchor_w[None,:,None]*anchor[tr]\n    \n    h_bias = np.zeros(n_horizons)\n    for h in range(n_horizons):\n        m = mask[tr][:, h, :]\n        h_bias[h] = np.median(blended_tr[:, h, :][m] - tgt[tr, h, :][m])\n    corrected = blended - h_bias[None, :, None]\n    corrected_tr = blended_tr - h_bias[None, :, None]\n    \n    node_bias = np.zeros(n_nodes)\n    for n in range(n_nodes):\n        m = mask[tr][:, :, n]\n        if m.sum() > 5:\n            node_bias[n] = np.median(corrected_tr[:, :, n][m] - tgt[tr, :, n][m])\n    corrected = corrected - 0.4 * node_bias[None, None, :]\n    corrected_tr = corrected_tr - 0.4 * node_bias[None, None, :]\n    \n    # History-based correction: per horizon, fit residual ~ base - hist_last\n    hist_last = history[:, -1, :]\n    hist_correction = np.zeros((n_horizons, 2))  # intercept, slope\n    for h in range(n_horizons):\n        m = mask[tr][:, h, :]\n        resid = corrected_tr[:, h, :][m] - tgt[tr, h, :][m]\n        jump = (base[tr, h, :] - hist_last[tr, :])[m]\n        # ridge\n        X = np.column_stack([np.ones(len(jump)), jump])\n        alpha = 100.0\n        coef = np.linalg.lstsq(X.T @ X + alpha*np.eye(2), X.T @ resid, rcond=None)[0]\n        hist_correction[h] = coef\n    \n    # Apply\n    for h in range(n_horizons):\n        jump = base[te, h, :] - hist_last[te, :]\n        pred_err = hist_correction[h, 0] + hist_correction[h, 1] * jump\n        corrected[:, h, :] -= 0.3 * pred_err\n    \n    maes_hist.append(compute_mae(corrected, tgt[te], mask[te]))\n\nprint(f'+ history jump correction: {np.mean(maes_hist):.4f} +/- {np.std(maes_hist):.4f}')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

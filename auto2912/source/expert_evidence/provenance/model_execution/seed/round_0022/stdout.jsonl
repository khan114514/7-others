{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 << 'PYEOF'\nimport numpy as np\nfrom sklearn.model_selection import KFold\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_tgt = np.load('/workspace/public_assets/train_targets.npz')\ntgt = train_tgt['target'].astype(np.float64)\nbase = train_feat['base'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\nmask = np.isfinite(tgt) & (tgt > 0)\ngraph = np.load('/workspace/public_assets/graph.npz')\nadj = graph['adjacency'].astype(np.float64)\n\nn_samples, n_horizons, n_nodes = base.shape\n\ndef compute_mae(pred, tgt, mask):\n    return np.abs(pred[mask] - tgt[mask]).mean()\n\n# Current v25 baseline from import\nimport sys\nsys.path.insert(0, '/workspace/solution')\nimport importlib\nimport method\nimportlib.reload(method)\n\nkf = KFold(n_splits=5, shuffle=True, random_state=42)\nv25_maes = []\nfor tr, te in kf.split(np.arange(n_samples)):\n    feat_tr = {'base': base[tr], 'anchor': anchor[tr], 'history': history[tr], 'clock': clock[tr]}\n    state = method.fit(feat_tr, tgt[tr], seed=42)\n    feat_te = {'base': base[te], 'anchor': anchor[te], 'history': history[te], 'clock': clock[te]}\n    pred = method.predict(state, feat_te)\n    v25_maes.append(compute_mae(pred, tgt[te], mask[te]))\nprint(f'Current v25 CV MAE: {np.mean(v25_maes):.4f} +/- {np.std(v25_maes):.4f}')\n\n# Ridge gives ~14.46 which is worse than v25's 14.34\n# The current method has more features. Let me look at what the v25 method has that the simple ridge doesn't.\n# It has per-node-horizon anchor blending, per-node-horizon bias, per-sample bias correction via base-anchor diff.\n\n# Let me think about what NEW structural improvements to try:\n# 1. Per-node multiplicative correction with graph smoothing\n# 2. More history features (multiple lag values, not just last)\n# 3. Clock-based per-node corrections\n# 4. Ensemble of multiple methods\n# 5. Quantile regression or MAE-optimized regression\n# 6. Graph convolution on residuals\n\n# Let me try graph smoothing on the per-node-horizon bias\nD = adj.sum(axis=1)\nD_inv_sqrt = np.where(D > 0, 1.0 / np.sqrt(D), 0.0)\nadj_norm = D_inv_sqrt[:, None] * adj * D_inv_sqrt[None, :]\n\ndef graph_smooth_2d(x_hxN, adj_norm, n_iter=2):\n    \\\"\\\"\\\"Smooth per-horizon node features across graph\\\"\\\"\\\"\n    result = x_hxN.copy()\n    for _ in range(n_iter):\n        result = 0.5 * result + 0.5 * result @ adj_norm.T\n    return result\n\n# Test: add graph-smoothed per-node-horizon bias to v25\n# Actually let me try a focused experiment: graph smoothing of residuals from v25 method\n\n# Simpler test: does graph smoothing of per-node bias help in the v25 pipeline?\n# Let me try a variant: instead of shrunken per-node bias, use graph-smoothed per-node bias\ndef v25_modified(train_idx, test_idx, seed=42):\n    \\\"\\\"\\\"v25 but with graph-smoothed node bias and pnh bias\\\"\\\"\\\"\n    rng = np.random.RandomState(seed)\n    b_tr = base[train_idx]\n    a_tr = anchor[train_idx]\n    h_tr = history[train_idx]\n    c_tr = clock[train_idx]\n    t_tr = tgt[train_idx]\n    m_tr = mask[train_idx]\n    \n    n_train = len(train_idx)\n    \n    # Per-horizon anchor blending\n    anchor_h = np.zeros(n_horizons)\n    for h in range(n_horizons):\n        m = m_tr[:, h, :]\n        best_mae = float('inf')\n        for w in np.linspace(0, 0.30, 31):\n            pred = (1 - w) * b_tr[:, h, :][m] + w * a_tr[:, h, :][m]\n            mae = np.abs(pred - t_tr[:, h, :][m]).mean()\n            if mae < best_mae:\n                best_mae = mae\n                anchor_h[h] = w\n    \n    # Per-node-horizon anchor blending\n    pna_shrink = 0.2\n    anchor_nh = np.zeros((n_horizons, n_nodes))\n    for h in range(n_horizons):\n        for n in range(n_nodes):\n            m = m_tr[:, h, n]\n            if m.sum() > 15:\n                best_mae = float('inf')\n                best_w = anchor_h[h]\n                for w in np.linspace(0, 0.40, 21):\n                    pred = (1 - w) * b_tr[:, h, n][m] + w * a_tr[:, h, n][m]\n                    mae = np.abs(pred - t_tr[:, h, n][m]).mean()\n                    if mae < best_mae:\n                        best_mae = mae\n                        best_w = w\n                anchor_nh[h, n] = best_w\n            else:\n                anchor_nh[h, n] = anchor_h[h]\n    \n    # Graph smooth anchor weights\n    anchor_nh_smooth = graph_smooth_2d(anchor_nh, adj_norm, 2)\n    anchor_nh = 0.3 * anchor_nh_smooth + 0.7 * anchor_nh\n    \n    anchor_nh = pna_shrink * anchor_nh + (1 - pna_shrink) * anchor_h[:, np.newaxis]\n    \n    blended = (1 - anchor_nh[np.newaxis, :, :]) * b_tr + anchor_nh[np.newaxis, :, :] * a_tr\n    \n    # Per-horizon median bias\n    h_bias = np.zeros(n_horizons)\n    for h in range(n_horizons):\n        m = m_tr[:, h, :]\n        h_bias[h] = np.median(blended[:, h, :][m] - t_tr[:, h, :][m])\n    \n    corrected = blended - h_bias[np.newaxis, :, np.newaxis]\n    residual = corrected - t_tr\n    \n    # Per-node median bias with graph smoothing\n    node_shrink = 0.4\n    node_bias = np.zeros(n_nodes)\n    for n in range(n_nodes):\n        m = m_tr[:, :, n]\n        if m.sum() > 5:\n            node_bias[n] = np.median(residual[:, :, n][m])\n    \n    # Graph smooth\n    node_bias_smooth = adj_norm @ node_bias\n    node_bias = 0.5 * node_bias + 0.5 * node_bias_smooth\n    node_bias = node_shrink * node_bias\n    \n    corrected = corrected - node_bias[np.newaxis, np.newaxis, :]\n    residual = corrected - t_tr\n    \n    # Per-node-horizon median bias\n    pnh_bias_shrink = 0.15\n    bias_nh = np.zeros((n_horizons, n_nodes))\n    for h in range(n_horizons):\n        for n in range(n_nodes):\n            m = m_tr[:, h, n]\n            if m.sum() > 0:\n                raw = np.median(residual[:, h, n][m])\n                bias_nh[h, n] = pnh_bias_shrink * raw\n    \n    # Graph smooth per-node-horizon bias\n    bias_nh_smooth = graph_smooth_2d(bias_nh, adj_norm, 2)\n    bias_nh = 0.3 * bias_nh_smooth + 0.7 * bias_nh\n    \n    corrected = corrected - bias_nh[np.newaxis, :, :]\n    residual = corrected - t_tr\n    \n    # Multiplicative per-node\n    mult_shrink = 0.5\n    mult_factor = np.ones(n_nodes)\n    for n in range(n_nodes):\n        m = m_tr[:, :, n]\n        p = corrected[:, :, n][m]\n        tgt_n = t_tr[:, :, n][m]\n        if m.sum() > 20 and np.min(p) > 1:\n            ratios = tgt_n / p\n            mult_factor[n] = np.median(ratios)\n    \n    mult_factor_smooth = adj_norm @ mult_factor\n    mult_factor = 0.7 * mult_factor + 0.3 * mult_factor_smooth\n    mult_factor = 1.0 + mult_shrink * (mult_factor - 1.0)\n    corrected = corrected * mult_factor[np.newaxis, np.newaxis, :]\n    residual = residual * mult_factor[np.newaxis, np.newaxis, :]\n    \n    # Predict on test\n    b_te = base[test_idx]\n    a_te = anchor[test_idx]\n    h_te = history[test_idx]\n    c_te = clock[test_idx]\n    \n    result = (1 - anchor_nh[np.newaxis]) * b_te + anchor_nh[np.newaxis] * a_te\n    result = result - h_bias[np.newaxis, :, np.newaxis]\n    result = result - node_bias[np.newaxis, np.newaxis, :]\n    result = result - bias_nh[np.newaxis, :, :]\n    result = result * mult_factor[np.newaxis, np.newaxis, :]\n    result = np.maximum(result, 0.0)\n    \n    return compute_mae(result, tgt[test_idx], mask[test_idx])\n\ngraph_maes = []\nfor tr, te in kf.split(np.arange(n_samples)):\n    graph_maes.append(v25_modified(tr, te))\nprint(f'v25 + graph smoothing CV MAE: {np.mean(graph_maes):.4f} +/- {np.std(graph_maes):.4f}')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

0, :][m]).mean() / 12.0\n            sample_clock[i, h] = clock[i, h, 0]\n\nprint('=== Per-sample error variance ===')\nprint(f'Overall sample error std (per h): {sample_errors.std(axis=0).mean():.4f}')\nprint(f'Sample error range per horizon:')\nfor h in range(n_horizons):\n    print(f'  H{h}: mean={sample_errors[:,h].mean():.3f}, std={sample_errors[:,h].std():.3f}')\n\n# How much of sample error can base-anchor diff explain?\nprint()\nprint('=== Correlations with per-sample mean error ===')\nfor h in [0, 3, 6, 9, 11]:\n    valid = np.isfinite(sample_errors[:,h])\n    print(f'H{h}: ba_diff={np.corrcoef(sample_errors[valid,h], sample_base_anchor_diff[valid,h])[0,1]:.4f}, '\n          f'bh_diff={np.corrcoef(sample_errors[valid,h], sample_base_hist_diff[valid,h])[0,1]:.4f}, '\n          f'hist_trend={np.corrcoef(sample_errors[valid,h], sample_hist_trend[valid,h])[0,1]:.4f}')\n\n# Try richer per-sample model: ridge with multiple features\nfrom sklearn.linear_model import Ridge\n\n# Build per-sample feature matrix for each horizon\n# Features: base-anchor diff mean, base-hist diff mean, hist trend, clock sin/cos, \n# hist last mean, hist avg mean, base mean, anchor mean\nprint()\nprint('=== Per-sample ridge correction ===')\n\nfor h in [0, 6, 11]:\n    valid = np.isfinite(sample_errors[:,h])\n    X = np.column_stack([\n        sample_base_anchor_diff[valid, h],\n        sample_base_hist_diff[valid, h],\n        sample_hist_trend[valid, h],\n        np.sin(2*np.pi*sample_clock[valid, h]),\n        np.cos(2*np.pi*sample_clock[valid, h]),\n        np.sin(4*np.pi*sample_clock[valid, h]),\n        np.cos(4*np.pi*sample_clock[valid, h]),\n    ])\n    y = sample_errors[valid, h]\n    \n    maes_raw = []\n    maes_corrected = []\n    kf_inner = KFold(n_splits=5, shuffle=True, random_state=h)\n    indices = np.where(valid)[0]\n    for tr, te in kf_inner.split(indices):\n        maes_raw.append(np.abs(y[te]).mean())\n        model = Ridge(alpha=1.0, fit_intercept=True)\n        model.fit(X[tr], y[tr])\n        pred = model.predict(X[te])\n        maes_corrected.append(np.abs(y[te] - 0.5*pred).mean())\n    \n    print(f'H{h}: raw_mean_abs_err={np.mean(maes_raw):.4f}, corrected={np.mean(maes_corrected):.4f}')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

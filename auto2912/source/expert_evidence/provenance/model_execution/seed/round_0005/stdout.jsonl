= global_coefs[h]\n            node_intercepts[h, n] = global_intercepts[h]\n\nelapsed = time.time() - start\nprint(f\\\"Single seed fit time: {elapsed:.3f}s\\\")\nprint(f\\\"3 seeds would take ~{elapsed*3:.1f}s\\\")\n\n# In-sample check\npred = np.zeros_like(base)\nfor h in range(n_horizons):\n    pred[:, h, :] = node_coefs[h, :, 0] * base[:, h, :] + node_coefs[h, :, 1] * anchor[:, h, :] + node_intercepts[h, :]\npred = np.maximum(pred, 0)\nmae = np.abs(pred - target)[mask].mean()\nprint(f\\\"In-sample MAE: {mae:.4f}\\\")\n\n# Check coefficient stats\nprint(f\\\"\\\\nBase coef stats: mean={node_coefs[:, :, 0].mean():.4f}, std={node_coefs[:, :, 0].std():.4f}\\\")\nprint(f\\\"Anchor coef stats: mean={node_coefs[:, :, 1].mean():.4f}, std={node_coefs[:, :, 1].std():.4f}\\\")\nprint(f\\\"Intercept stats: mean={node_intercepts.mean():.4f}, std={node_intercepts.std():.4f}\\\")\n\nEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

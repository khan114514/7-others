{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 << 'EOF'\nimport numpy as np\nfrom sklearn.linear_model import Ridge, Lasso\nfrom sklearn.model_selection import KFold\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_targ = np.load('/workspace/public_assets/train_targets.npz')\ngraph = np.load('/workspace/public_assets/graph.npz')\n\nbase = train_feat['base'].astype(np.float64)\ntarget = train_targ['target'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nadj = graph['adjacency'].astype(np.float64)\n\nmask = np.isfinite(target) & (target > 0)\nn_samples, n_horizons, n_nodes = base.shape\n\ndef compute_mae(pred, target, mask):\n    return np.abs(pred - target)[mask].mean()\n\nkf = KFold(n_splits=5, shuffle=True, random_state=42)\n\ndef graph_smooth(values_n, adj, alpha=0.1, n_iter=2):\n    result = values_n.copy()\n    deg = np.maximum(adj.sum(axis=1), 1.0)\n    for _ in range(n_iter):\n        neighbor_sum = adj.T @ result\n        neighbor_avg = neighbor_sum / deg\n        result = (1 - alpha) * result + alpha * neighbor_avg\n    return result\n\ndef cv_evaluate(fit_fn, predict_fn):\n    maes = []\n    for train_idx, val_idx in kf.split(range(n_samples)):\n        train_feat_fold = {\n            'base': base[train_idx], 'anchor': anchor[train_idx],\n            'history': history[train_idx],\n        }\n        train_targ_fold = target[train_idx]\n        val_feat_fold = {\n            'base': base[val_idx], 'anchor': anchor[val_idx],\n            'history': history[val_idx],\n        }\n        val_targ_fold = target[val_idx]\n        val_mask = mask[val_idx]\n        state = fit_fn(train_feat_fold, train_targ_fold)\n        pred = predict_fn(state, val_feat_fold)\n        maes.append(compute_mae(pred, val_targ_fold, val_mask))\n    return np.mean(maes), np.std(maes)\n\n# Per-node base+anchor Ridge per horizon (highly regularized)\ndef fit_pernode_ba(feat, targ, node_alpha=1000.0, global_alpha=100.0, node_shrink=0.3):\n    b = feat['base']\n    a = feat['anchor']\n    m = np.isfinite(targ) & (targ > 0)\n    \n    # Global per-horizon model\n    global_coefs = np.zeros((n_horizons, 2))\n    global_intercepts = np.zeros(n_horizons)\n    for h in range(n_horizons):\n        mh = m[:, h, :]\n        X = np.column_stack([b[:, h, :][mh], a[:, h, :][mh]])\n        y = targ[:, h, :][mh]\n        model = Ridge(alpha=global_alpha, fit_intercept=True).fit(X, y)\n        global_coefs[h] = model.coef_\n        global_intercepts[h] = model.intercept_\n    \n    # Per-node per-horizon model (shrunken toward global)\n    node_coefs = np.zeros((n_horizons, n_nodes, 2))\n    node_intercepts = np.zeros((n_horizons, n_nodes))\n    \n    for h in range(n_horizons):\n        for n in range(n_nodes):\n            mn = m[:, h, n]\n            if mn.sum() > 5:\n                X = np.column_stack([b[mn, h, n], a[mn, h, n]])\n                y = targ[mn, h, n]\n                model = Ridge(alpha=node_alpha, fit_intercept=True).fit(X, y)\n                # Shrink toward global\n                node_coefs[h, n, :] = node_shrink * model.coef_ + (1 - node_shrink) * global_coefs[h]\n                node_intercepts[h, n] = node_shrink * model.intercept_ + (1 - node_shrink) * global_intercepts[h]\n            else:\n                node_coefs[h, n, :] = global_coefs[h]\n                node_intercepts[h, n] = global_intercepts[h]\n    \n    return {'node_coefs': node_coefs, 'node_intercepts': node_intercepts}\n\ndef pred_pernode_ba(state, feat):\n    b = feat['base']\n    a = feat['anchor']\n    result = np.zeros_like(b)\n    for h in range(n_horizons):\n        result[:, h, :] = state['node_coefs'][h, :, 0] * b[:, h, :] + state['node_coefs'][h, :, 1] * a[:, h, :] + state['node_intercepts'][h, :]\n    return np.maximum(result, 0)\n\nprint(\\\"=== Per-node base+anchor Ridge (shrunken to global) ===\\\")\nfor node_shrink in [0.1, 0.2, 0.3, 0.5]:\n    for node_alpha in [100, 1000, 10000]:\n        mae, std = cv_evaluate(\n            lambda f, t: fit_pernode_ba(f, t, node_alpha=node_alpha, node_shrink=node_shrink),\n            pred_pernode_ba\n        )\n        print(f\\\"  shrink={node_shrink:.1f}, alpha={node_alpha:5d}: MAE={mae:.4f} +/- {std:.4f}\\\")\n\n# Let's also try: per-node intercept only (bias correction) on top of global model\n# This is essentially what we had before but with per-horizon per-node bias\n# Let's compare to the previous best\n\n# Previous best (reference): base+anchor Ridge + node bias + NH bias = 14.52\n# Let me try a version with graph-smoothed per-node coefficients\n\nEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

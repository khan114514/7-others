{"type":"item.started","item":{"id":"item_66","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 << 'EOF'\nimport numpy as np\nimport time\nfrom sklearn.linear_model import Ridge\nfrom sklearn.model_selection import KFold\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_targ = np.load('/workspace/public_assets/train_targets.npz')\n\nbase = train_feat['base'].astype(np.float64)\ntarget = train_targ['target'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\n\nmask = np.isfinite(target) & (target > 0)\nn_samples, n_horizons, n_nodes = base.shape\n\ndef compute_mae(pred, target, mask):\n    return np.abs(pred - target)[mask].mean()\n\ndef lad_fit(X, y, max_iter=100, tol=1e-8, min_weight=1e-6):\n    \\\"\\\"\\\"LAD regression via IRLS.\\\"\\\"\\\"\n    n, p = X.shape\n    X_aug = np.column_stack([X, np.ones(n)])\n    beta = np.linalg.lstsq(X_aug, y, rcond=None)[0]\n    \n    for _ in range(max_iter):\n        resid = y - X_aug @ beta\n        w = 1.0 / np.maximum(np.abs(resid), min_weight)\n        W = np.diag(w)\n        XtW = X_aug.T @ W\n        beta_new = np.linalg.solve(XtW @ X_aug + 1e-10 * np.eye(p+1), XtW @ y)\n        if np.max(np.abs(beta_new - beta)) < tol:\n            break\n        beta = beta_new\n    \n    return beta[:-1], beta[-1]\n\n# Time LAD fit\nstart = time.time()\nfor h in range(n_horizons):\n    for n in range(n_nodes):\n        mn = mask[:, h, n]\n        if mn.sum() > 5:\n            X = np.column_stack([base[mn, h, n], anchor[mn, h, n]])\n            y = target[mn, h, n]\n            lad_fit(X, y)\nelapsed = time.time() - start\nprint(f\\\"LAD per-node fit time (single seed): {elapsed:.3f}s\\\")\nprint(f\\\"3 seeds: ~{elapsed*3:.1f}s (budget: 180s)\\\")\n\n# LAD with shrinkage toward global\nkf = KFold(n_splits=5, shuffle=True, random_state=42)\n\nprint(\\\"\\\\n=== LAD with shrinkage toward global ===\\\")\nfor node_shrink in [0.7, 0.8, 0.9, 1.0]:\n    maes = []\n    for train_idx, val_idx in kf.split(range(n_samples)):\n        b_tr, b_val = base[train_idx], base[val_idx]\n        a_tr, a_val = anchor[train_idx], anchor[val_idx]\n        t_tr, t_val = target[train_idx], target[val_idx]\n        m_tr, m_val = mask[train_idx], mask[val_idx]\n        \n        # Global LAD\n        global_coefs = np.zeros((n_horizons, 2))\n        global_intercepts = np.zeros(n_horizons)\n        for h in range(n_horizons):\n            mh = m_tr[:, h, :]\n            X = np.column_stack([b_tr[:, h, :][mh], a_tr[:, h, :][mh]])\n            y = t_tr[:, h, :][mh]\n            c, i = lad_fit(X, y)\n            global_coefs[h] = c\n            global_intercepts[h] = i\n        \n        # Per-node LAD with shrinkage\n        node_coefs = np.zeros((n_horizons, n_nodes, 2))\n        node_intercepts = np.zeros((n_horizons, n_nodes))\n        for h in range(n_horizons):\n            for n in range(n_nodes):\n                mn = m_tr[:, h, n]\n                if mn.sum() > 5:\n                    X = np.column_stack([b_tr[mn, h, n], a_tr[mn, h, n]])\n                    y = t_tr[mn, h, n]\n                    c, i = lad_fit(X, y)\n                    node_coefs[h, n, :] = node_shrink * c + (1 - node_shrink) * global_coefs[h]\n                    node_intercepts[h, n] = node_shrink * i + (1 - node_shrink) * global_intercepts[h]\n                else:\n                    node_coefs[h, n, :] = global_coefs[h]\n                    node_intercepts[h, n] = global_intercepts[h]\n        \n        pred = np.zeros_like(b_val)\n        for h in range(n_horizons):\n            pred[:, h, :] = node_coefs[h, :, 0] * b_val[:, h, :] + node_coefs[h, :, 1] * a_val[:, h, :] + node_intercepts[h, :]\n        pred = np.maximum(pred, 0)\n        maes.append(compute_mae(pred, t_val, m_val))\n    \n    print(f\\\"  shrink={node_shrink:.1f}: MAE={np.mean(maes):.4f} +/- {np.std(maes):.4f}\\\")\n\n# LAD + node-horizon residual bias\nprint(\\\"\\\\n=== LAD per-node + residual bias ===\\\")\nnode_shrink = 1.0\nfor nh_shrink in [0.05, 0.1, 0.2, 0.3]:\n    maes = []\n    for train_idx, val_idx in kf.split(range(n_samples)):\n        b_tr, b_val = base[train_idx], base[val_idx]\n        a_tr, a_val = anchor[train_idx], anchor[val_idx]\n        t_tr, t_val = target[train_idx], target[val_idx]\n        m_tr, m_val = mask[train_idx], mask[val_idx]\n        \n        node_coefs = np.zeros((n_horizons, n_nodes, 2))\n        node_intercepts = np.zeros((n_horizons, n_nodes))\n        for h in range(n_horizons):\n            for n in range(n_nodes):\n                mn = m_tr[:, h, n]\n                if mn.sum() > 5:\n                    X = np.column_stack([b_tr[mn, h, n], a_tr[mn, h, n]])\n                    y = t_tr[mn, h, n]\n                    c, i = lad_fit(X, y)\n                    node_coefs[h, n, :] = c\n                    node_intercepts[h, n] = i\n                else:\n                    mh = m_tr[:, h, :]\n                    X = np.column_stack([b_tr[:, h, :][mh], a_tr[:, h, :][mh]])\n                    y = t_tr[:, h, :][mh]\n                    c, i = lad_fit(X, y)\n                    node_coefs[h, n, :] = c\n                    node_intercepts[h, n] = i\n        \n        # Compute residual and add node-horizon bias\n        pred_tr = np.zeros_like(b_tr)\n        for h in range(n_horizons):\n            pred_tr[:, h, :] = node_coefs[h, :, 0] * b_tr[:, h, :] + node_coefs[h, :, 1] * a_tr[:, h, :] + node_intercepts[h, :]\n        \n        residual = pred_tr - t_tr\n        bias_nh = np.zeros((n_horizons, n_nodes))\n        for h in range(n_horizons):\n            global_h_res = residual[:, h, :][m_tr[:, h, :]].mean()\n            for n in range(n_nodes):\n                mn = m_tr[:, h, n]\n                if mn.sum() > 3:\n                    node_res = residual[:, h, n][mn].mean()\n                    bias_nh[h, n] = nh_shrink * node_res + (1 - nh_shrink) * global_h_res\n                else:\n                    bias_nh[h, n] = global_h_res\n        \n        pred = np.zeros_like(b_val)\n        for h in range(n_horizons):\n            pred[:, h, :] = node_coefs[h, :, 0] * b_val[:, h, :] + node_coefs[h, :, 1] * a_val[:, h, :] + node_intercepts[h, :]\n        pred -= bias_nh[np.newaxis, :, :]\n        pred = np.maximum(pred, 0)\n        maes.append(compute_mae(pred, t_val, m_val))\n    \n    print(f\\\"  nh_shrink={nh_shrink:.2f}: MAE={np.mean(maes):.4f} +/- {np.std(maes):.4f}\\\")\n\nEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

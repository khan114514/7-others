{"type":"item.started","item":{"id":"item_62","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 << 'EOF'\nimport numpy as np\nfrom sklearn.linear_model import Ridge\nfrom sklearn.model_selection import KFold\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_targ = np.load('/workspace/public_assets/train_targets.npz')\n\nbase = train_feat['base'].astype(np.float64)\ntarget = train_targ['target'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\n\nmask = np.isfinite(target) & (target > 0)\nn_samples, n_horizons, n_nodes = base.shape\n\ndef compute_mae(pred, target, mask):\n    return np.abs(pred - target)[mask].mean()\n\n# Quick LAD implementation using numpy (iteratively reweighted)\ndef lad_fit(X, y, max_iter=50, tol=1e-6):\n    \\\"\\\"\\\"Least absolute deviation regression via IRLS.\\\"\\\"\\\"\n    n, p = X.shape\n    X_with_intercept = np.column_stack([X, np.ones(n)])\n    # Initialize with OLS\n    beta = np.linalg.lstsq(X_with_intercept, y, rcond=None)[0]\n    \n    for _ in range(max_iter):\n        resid = y - X_with_intercept @ beta\n        weights = 1.0 / np.maximum(np.abs(resid), 1e-6)\n        # Weighted least squares\n        W = np.diag(weights)\n        XtW = X_with_intercept.T @ W\n        beta_new = np.linalg.solve(XtW @ X_with_intercept + 1e-8 * np.eye(p+1), XtW @ y)\n        if np.max(np.abs(beta_new - beta)) < tol:\n            break\n        beta = beta_new\n    \n    return beta[:-1], beta[-1]  # coefs, intercept\n\n# Test LAD vs Ridge\nprint(\\\"=== LAD vs Ridge comparison (shrink=1.0, per-node) ===\\\")\nkf = KFold(n_splits=5, shuffle=True, random_state=42)\n\nfor method_name, fit_fn in [\n    (\\\"Ridge alpha=1\\\", lambda X, y: (Ridge(alpha=1.0, fit_intercept=True).fit(X, y).coef_, \n                                     Ridge(alpha=1.0, fit_intercept=True).fit(X, y).intercept_)),\n    (\\\"Ridge alpha=10\\\", lambda X, y: (Ridge(alpha=10.0, fit_intercept=True).fit(X, y).coef_,\n                                      Ridge(alpha=10.0, fit_intercept=True).fit(X, y).intercept_)),\n    (\\\"LAD\\\", lambda X, y: lad_fit(X, y)),\n]:\n    maes = []\n    for train_idx, val_idx in kf.split(range(n_samples)):\n        b_tr, b_val = base[train_idx], base[val_idx]\n        a_tr, a_val = anchor[train_idx], anchor[val_idx]\n        t_tr, t_val = target[train_idx], target[val_idx]\n        m_tr, m_val = mask[train_idx], mask[val_idx]\n        \n        node_coefs = np.zeros((n_horizons, n_nodes, 2))\n        node_intercepts = np.zeros((n_horizons, n_nodes))\n        \n        for h in range(n_horizons):\n            for n in range(n_nodes):\n                mn = m_tr[:, h, n]\n                if mn.sum() > 5:\n                    X = np.column_stack([b_tr[mn, h, n], a_tr[mn, h, n]])\n                    y = t_tr[mn, h, n]\n                    coefs, intercept = fit_fn(X, y)\n                    node_coefs[h, n, :] = coefs\n                    node_intercepts[h, n] = intercept\n                else:\n                    # fallback to global\n                    mh = m_tr[:, h, :]\n                    X = np.column_stack([b_tr[:, h, :][mh], a_tr[:, h, :][mh]])\n                    y = t_tr[:, h, :][mh]\n                    coefs, intercept = fit_fn(X, y)\n                    node_coefs[h, n, :] = coefs\n                    node_intercepts[h, n] = intercept\n        \n        pred = np.zeros_like(b_val)\n        for h in range(n_horizons):\n            pred[:, h, :] = node_coefs[h, :, 0] * b_val[:, h, :] + node_coefs[h, :, 1] * a_val[:, h, :] + node_intercepts[h, :]\n        pred = np.maximum(pred, 0)\n        maes.append(compute_mae(pred, t_val, m_val))\n    \n    print(f\\\"  {method_name}: MAE={np.mean(maes):.4f} +/- {np.std(maes):.4f}\\\")\n\n# Also check: does adding ridge regularization to LAD help?\n# Try Ridge with alpha=0.1\nprint(\\\"\\\\n=== Ridge very low alpha (per-node, shrink=1.0) ===\\\")\nfor alpha in [0.01, 0.1, 0.5, 1.0, 5.0]:\n    maes = []\n    for train_idx, val_idx in kf.split(range(n_samples)):\n        b_tr, b_val = base[train_idx], base[val_idx]\n        a_tr, a_val = anchor[train_idx], anchor[val_idx]\n        t_tr, t_val = target[train_idx], target[val_idx]\n        m_tr, m_val = mask[train_idx], mask[val_idx]\n        \n        node_coefs = np.zeros((n_horizons, n_nodes, 2))\n        node_intercepts = np.zeros((n_horizons, n_nodes))\n        \n        for h in range(n_horizons):\n            for n in range(n_nodes):\n                mn = m_tr[:, h, n]\n                if mn.sum() > 5:\n                    X = np.column_stack([b_tr[mn, h, n], a_tr[mn, h, n]])\n                    y = t_tr[mn, h, n]\n                    model = Ridge(alpha=alpha, fit_intercept=True).fit(X, y)\n                    node_coefs[h, n, :] = model.coef_\n                    node_intercepts[h, n] = model.intercept_\n                else:\n                    mh = m_tr[:, h, :]\n                    X = np.column_stack([b_tr[:, h, :][mh], a_tr[:, h, :][mh]])\n                    y = t_tr[:, h, :][mh]\n                    model = Ridge(alpha=alpha, fit_intercept=True).fit(X, y)\n                    node_coefs[h, n, :] = model.coef_\n                    node_intercepts[h, n] = model.intercept_\n        \n        pred = np.zeros_like(b_val)\n        for h in range(n_horizons):\n            pred[:, h, :] = node_coefs[h, :, 0] * b_val[:, h, :] + node_coefs[h, :, 1] * a_val[:, h, :] + node_intercepts[h, :]\n        pred = np.maximum(pred, 0)\n        maes.append(compute_mae(pred, t_val, m_val))\n    \n    print(f\\\"  alpha={alpha:5.2f}: MAE={np.mean(maes):.4f} +/- {np.std(maes):.4f}\\\")\n\nEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

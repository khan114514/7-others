{"type":"item.started","item":{"id":"item_57","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 << 'EOF'\nimport numpy as np\nfrom sklearn.linear_model import Ridge\nfrom sklearn.model_selection import KFold\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_targ = np.load('/workspace/public_assets/train_targets.npz')\n\nbase = train_feat['base'].astype(np.float64)\ntarget = train_targ['target'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\n\nmask = np.isfinite(target) & (target > 0)\nn_samples, n_horizons, n_nodes = base.shape\n\ndef compute_mae(pred, target, mask):\n    return np.abs(pred - target)[mask].mean()\n\nkf = KFold(n_splits=5, shuffle=True, random_state=42)\n\ndef cv_pernode(node_shrink, node_alpha, global_alpha=100.0, add_history=False):\n    maes = []\n    for train_idx, val_idx in kf.split(range(n_samples)):\n        b_tr, b_val = base[train_idx], base[val_idx]\n        a_tr, a_val = anchor[train_idx], anchor[val_idx]\n        h_tr, h_val = history[train_idx], history[val_idx]\n        t_tr, t_val = target[train_idx], target[val_idx]\n        m_tr, m_val = mask[train_idx], mask[val_idx]\n        \n        n_feat = 3 if add_history else 2\n        \n        # Global per-horizon model\n        global_coefs = np.zeros((n_horizons, n_feat))\n        global_intercepts = np.zeros(n_horizons)\n        for h in range(n_horizons):\n            mh = m_tr[:, h, :]\n            feats = [b_tr[:, h, :][mh], a_tr[:, h, :][mh]]\n            if add_history:\n                feats.append(h_tr[:, -1, :][mh])\n            X = np.column_stack(feats)\n            y = t_tr[:, h, :][mh]\n            model = Ridge(alpha=global_alpha, fit_intercept=True).fit(X, y)\n            global_coefs[h] = model.coef_\n            global_intercepts[h] = model.intercept_\n        \n        # Per-node per-horizon model\n        node_coefs = np.zeros((n_horizons, n_nodes, n_feat))\n        node_intercepts = np.zeros((n_horizons, n_nodes))\n        for h in range(n_horizons):\n            for n in range(n_nodes):\n                mn = m_tr[:, h, n]\n                if mn.sum() > 5:\n                    feats = [b_tr[mn, h, n], a_tr[mn, h, n]]\n                    if add_history:\n                        feats.append(h_tr[mn, -1, n])\n                    X = np.column_stack(feats)\n                    y = t_tr[mn, h, n]\n                    model = Ridge(alpha=node_alpha, fit_intercept=True).fit(X, y)\n                    node_coefs[h, n, :] = node_shrink * model.coef_ + (1 - node_shrink) * global_coefs[h]\n                    node_intercepts[h, n] = node_shrink * model.intercept_ + (1 - node_shrink) * global_intercepts[h]\n                else:\n                    node_coefs[h, n, :] = global_coefs[h]\n                    node_intercepts[h, n] = global_intercepts[h]\n        \n        # Predict\n        pred = np.zeros_like(b_val)\n        for h in range(n_horizons):\n            val_feats = [b_val[:, h, :], a_val[:, h, :]]\n            if add_history:\n                val_feats.append(h_val[:, -1, :])\n            for k in range(n_feat):\n                pred[:, h, :] += node_coefs[h, :, k] * val_feats[k]\n            pred[:, h, :] += node_intercepts[h, :]\n        pred = np.maximum(pred, 0)\n        maes.append(compute_mae(pred, t_val, m_val))\n    return np.mean(maes), np.std(maes)\n\n# High shrinkage sweep\nprint(\\\"=== High shrinkage sweep (alpha=100) ===\\\")\nfor node_shrink in [0.7, 0.8, 0.85, 0.9, 0.95, 1.0]:\n    mae, std = cv_pernode(node_shrink, node_alpha=100.0)\n    print(f\\\"  shrink={node_shrink:.2f}: MAE={mae:.4f} +/- {std:.4f}\\\")\n\n# Alpha sweep at high shrinkage\nprint(\\\"\\\\n=== Alpha sweep at shrink=0.8 ===\\\")\nfor node_alpha in [1, 10, 50, 100, 500, 1000, 5000]:\n    mae, std = cv_pernode(0.8, node_alpha)\n    print(f\\\"  alpha={node_alpha:5d}: MAE={mae:.4f} +/- {std:.4f}\\\")\n\nprint(\\\"\\\\n=== Alpha sweep at shrink=0.9 ===\\\")\nfor node_alpha in [1, 10, 50, 100, 500, 1000]:\n    mae, std = cv_pernode(0.9, node_alpha)\n    print(f\\\"  alpha={node_alpha:5d}: MAE={mae:.4f} +/- {std:.4f}\\\")\n\n# Add history feature\nprint(\\\"\\\\n=== With last history step as feature ===\\\")\nfor node_shrink in [0.5, 0.7, 0.8, 0.9]:\n    mae, std = cv_pernode(node_shrink, node_alpha=100.0, add_history=True)\n    print(f\\\"  shrink={node_shrink:.1f}: MAE={mae:.4f} +/- {std:.4f}\\\")\n\nEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

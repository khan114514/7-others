{"type":"item.started","item":{"id":"item_79","type":"command_execution","command":"/bin/sh -lc \"cat > /workspace/solution/method.py << 'PYEOF'\n\\\"\\\"\\\"Per-node per-horizon LAD regression with base + anchor features.\n\nOptimizes MAE directly via iteratively reweighted least squares.\nFalls back to per-horizon global LAD when insufficient samples per node.\n\\\"\\\"\\\"\nimport numpy as np\n\n\ndef _lad_fit(X, y, max_iter=50, tol=1e-6, min_weight=1e-6):\n    \\\"\\\"\\\"Least absolute deviation regression via IRLS.\\\"\\\"\\\"\n    n, p = X.shape\n    X_aug = np.column_stack([X, np.ones(n)])\n    beta = np.linalg.lstsq(X_aug, y, rcond=None)[0]\n\n    for _ in range(max_iter):\n        resid = y - X_aug @ beta\n        w = 1.0 / np.maximum(np.abs(resid), min_weight)\n        XtWX = (X_aug.T * w) @ X_aug\n        XtWy = (X_aug.T * w) @ y\n        try:\n            beta_new = np.linalg.solve(XtWX + 1e-10 * np.eye(p + 1), XtWy)\n        except np.linalg.LinAlgError:\n            break\n        if np.max(np.abs(beta_new - beta)) < tol:\n            break\n        beta = beta_new\n\n    return beta[:-1], beta[-1]\n\n\ndef fit(features, targets, seed):\n    rng = np.random.RandomState(seed)\n    base = features['base'].astype(np.float64)\n    target = targets.astype(np.float64)\n    anchor = features['anchor'].astype(np.float64)\n\n    n_samples, n_horizons, n_nodes = base.shape\n    mask = np.isfinite(target) & (target > 0)\n\n    # Global per-horizon LAD (used as fallback)\n    global_coefs = np.zeros((n_horizons, 2), dtype=np.float64)\n    global_intercepts = np.zeros(n_horizons, dtype=np.float64)\n    for h in range(n_horizons):\n        mh = mask[:, h, :]\n        X = np.column_stack([base[:, h, :][mh], anchor[:, h, :][mh]])\n        y = target[:, h, :][mh]\n        c, i = _lad_fit(X, y)\n        global_coefs[h] = c\n        global_intercepts[h] = i\n\n    # Per-node per-horizon LAD\n    node_coefs = np.zeros((n_horizons, n_nodes, 2), dtype=np.float64)\n    node_intercepts = np.zeros((n_horizons, n_nodes), dtype=np.float64)\n    min_samples = 5\n\n    for h in range(n_horizons):\n        for n in range(n_nodes):\n            mn = mask[:, h, n]\n            if mn.sum() > min_samples:\n                X = np.column_stack([base[mn, h, n], anchor[mn, h, n]])\n                y = target[mn, h, n]\n                c, i = _lad_fit(X, y)\n                node_coefs[h, n, :] = c\n                node_intercepts[h, n] = i\n            else:\n                node_coefs[h, n, :] = global_coefs[h]\n                node_intercepts[h, n] = global_intercepts[h]\n\n    state = {\n        'method': 'per_node_lad_base_anchor',\n        'version': 1,\n        'node_coefs': node_coefs.astype(np.float32),\n        'node_intercepts': node_intercepts.astype(np.float32),\n    }\n    return state\n\n\ndef predict(state, features):\n    base = np.array(features['base'], dtype=np.float64)\n    anchor = np.array(features['anchor'], dtype=np.float64)\n\n    node_coefs = state['node_coefs'].astype(np.float64)\n    node_intercepts = state['node_intercepts'].astype(np.float64)\n\n    n_horizons = node_coefs.shape[0]\n    result = np.zeros_like(base)\n    for h in range(n_horizons):\n        result[:, h, :] = (\n            node_coefs[h, :, 0] * base[:, h, :]\n            + node_coefs[h, :, 1] * anchor[:, h, :]\n            + node_intercepts[h, :]\n        )\n\n    result = np.maximum(result, 0.0)\n    return result.astype(np.float32)\nPYEOF\necho \\\"Written method.py\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

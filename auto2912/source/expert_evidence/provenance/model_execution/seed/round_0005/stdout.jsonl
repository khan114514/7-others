{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 << 'EOF'\nimport numpy as np\nfrom sklearn.linear_model import Ridge, Lasso\nfrom sklearn.model_selection import KFold\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_targ = np.load('/workspace/public_assets/train_targets.npz')\ngraph = np.load('/workspace/public_assets/graph.npz')\n\nbase = train_feat['base'].astype(np.float64)\ntarget = train_targ['target'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\nadj = graph['adjacency'].astype(np.float64)\n\nmask = np.isfinite(target) & (target > 0)\nn_samples, n_horizons, n_nodes = base.shape\n\ndef compute_mae(pred, target, mask):\n    return np.abs(pred - target)[mask].mean()\n\n# Baseline\nprint(f\\\"Baseline MAE (base forecast): {compute_mae(base, target, mask):.4f}\\\")\nprint(f\\\"Anchor MAE: {compute_mae(anchor, target, mask):.4f}\\\")\n\n# Cross-validation setup\nkf = KFold(n_splits=5, shuffle=True, random_state=42)\n\ndef cv_evaluate(fit_fn, predict_fn):\n    maes = []\n    for train_idx, val_idx in kf.split(range(n_samples)):\n        train_feat_fold = {\n            'base': base[train_idx],\n            'anchor': anchor[train_idx],\n            'history': history[train_idx],\n            'clock': clock[train_idx],\n        }\n        train_targ_fold = target[train_idx]\n        val_feat_fold = {\n            'base': base[val_idx],\n            'anchor': anchor[val_idx],\n            'history': history[val_idx],\n            'clock': clock[val_idx],\n        }\n        val_targ_fold = target[val_idx]\n        val_mask = mask[val_idx]\n        \n        state = fit_fn(train_feat_fold, train_targ_fold)\n        pred = predict_fn(state, val_feat_fold)\n        maes.append(compute_mae(pred, val_targ_fold, val_mask))\n    return np.mean(maes), np.std(maes)\n\n# Method 1: Global bias correction\ndef fit_global_bias(feat, targ):\n    b = feat['base']\n    m = np.isfinite(targ) & (targ > 0)\n    bias = (b - targ)[m].mean()\n    return {'bias': bias}\n\ndef pred_global_bias(state, feat):\n    return np.maximum(feat['base'] - state['bias'], 0)\n\nmae, std = cv_evaluate(fit_global_bias, pred_global_bias)\nprint(f\\\"\\\\nGlobal bias correction: {mae:.4f} +/- {std:.4f}\\\")\n\n# Method 2: Per-horizon bias\ndef fit_h_bias(feat, targ):\n    b = feat['base']\n    m = np.isfinite(targ) & (targ > 0)\n    h_bias = np.zeros(n_horizons)\n    for h in range(n_horizons):\n        h_bias[h] = (b[:, h, :] - targ[:, h, :])[m[:, h, :]].mean()\n    return {'h_bias': h_bias}\n\ndef pred_h_bias(state, feat):\n    return np.maximum(feat['base'] - state['h_bias'][np.newaxis, :, np.newaxis], 0)\n\nmae, std = cv_evaluate(fit_h_bias, pred_h_bias)\nprint(f\\\"Per-horizon bias: {mae:.4f} +/- {std:.4f}\\\")\n\n# Method 3: Per-horizon Ridge (slope + intercept)\ndef fit_h_ridge(feat, targ):\n    b = feat['base']\n    m = np.isfinite(targ) & (targ > 0)\n    slopes = np.zeros(n_horizons)\n    intercepts = np.zeros(n_horizons)\n    for h in range(n_horizons):\n        mh = m[:, h, :]\n        X = b[:, h, :][mh].reshape(-1, 1)\n        y = targ[:, h, :][mh]\n        model = Ridge(alpha=100.0, fit_intercept=True).fit(X, y)\n        slopes[h] = model.coef_[0]\n        intercepts[h] = model.intercept_\n    return {'slopes': slopes, 'intercepts': intercepts}\n\ndef pred_h_ridge(state, feat):\n    b = feat['base']\n    result = np.zeros_like(b)\n    for h in range(n_horizons):\n        result[:, h, :] = state['slopes'][h] * b[:, h, :] + state['intercepts'][h]\n    return np.maximum(result, 0)\n\nmae, std = cv_evaluate(fit_h_ridge, pred_h_ridge)\nprint(f\\\"Per-horizon Ridge (alpha=100): {mae:.4f} +/- {std:.4f}\\\")\n\n# Method 4: Per-horizon Ridge with base + anchor\ndef fit_h_ridge_anchor(feat, targ):\n    b = feat['base']\n    a = feat['anchor']\n    m = np.isfinite(targ) & (targ > 0)\n    coefs = np.zeros((n_horizons, 2))\n    intercepts = np.zeros(n_horizons)\n    for h in range(n_horizons):\n        mh = m[:, h, :]\n        X = np.column_stack([b[:, h, :][mh], a[:, h, :][mh]])\n        y = targ[:, h, :][mh]\n        model = Ridge(alpha=100.0, fit_intercept=True).fit(X, y)\n        coefs[h] = model.coef_\n        intercepts[h] = model.intercept_\n    return {'coefs': coefs, 'intercepts': intercepts}\n\ndef pred_h_ridge_anchor(state, feat):\n    b = feat['base']\n    a = feat['anchor']\n    result = np.zeros_like(b)\n    for h in range(n_horizons):\n        result[:, h, :] = state['coefs'][h, 0] * b[:, h, :] + state['coefs'][h, 1] * a[:, h, :] + state['intercepts'][h]\n    return np.maximum(result, 0)\n\nmae, std = cv_evaluate(fit_h_ridge_anchor, pred_h_ridge_anchor)\nprint(f\\\"Per-horizon Ridge base+anchor (alpha=100): {mae:.4f} +/- {std:.4f}\\\")\n\n# Method 5: Per-horizon Ridge + per-node bias (shrunken)\ndef fit_h_ridge_nodebias(feat, targ):\n    b = feat['base']\n    m = np.isfinite(targ) & (targ > 0)\n    slopes = np.zeros(n_horizons)\n    intercepts = np.zeros(n_horizons)\n    for h in range(n_horizons):\n        mh = m[:, h, :]\n        X = b[:, h, :][mh].reshape(-1, 1)\n        y = targ[:, h, :][mh]\n        model = Ridge(alpha=100.0, fit_intercept=True).fit(X, y)\n        slopes[h] = model.coef_[0]\n        intercepts[h] = model.intercept_\n    \n    pred = np.zeros_like(b)\n    for h in range(n_horizons):\n        pred[:, h, :] = slopes[h] * b[:, h, :] + intercepts[h]\n    \n    residual = pred - targ\n    node_bias = np.zeros(n_nodes)\n    for n in range(n_nodes):\n        mn = m[:, :, n]\n        if mn.sum() > 5:\n            node_bias[n] = residual[:, :, n][mn].mean()\n    \n    # Shrink toward 0\n    node_bias = 0.5 * node_bias\n    \n    return {'slopes': slopes, 'intercepts': intercepts, 'node_bias': node_bias}\n\ndef pred_h_ridge_nodebias(state, feat):\n    b = feat['base']\n    result = np.zeros_like(b)\n    for h in range(n_horizons):\n        result[:, h, :] = state['slopes'][h] * b[:, h, :] + state['intercepts'][h]\n    result -= state['node_bias'][np.newaxis, np.newaxis, :]\n    return np.maximum(result, 0)\n\nmae, std = cv_evaluate(fit_h_ridge_nodebias, pred_h_ridge_nodebias)\nprint(f\\\"Per-horizon Ridge + per-node bias (shrink=0.5): {mae:.4f} +/- {std:.4f}\\\")\n\n# Method 6: History-based correction\ndef fit_hist_corr(feat, targ):\n    b = feat['base']\n    h = feat['history']\n    m = np.isfinite(targ) & (targ > 0)\n    \n    # Per-horizon Ridge first\n    slopes = np.zeros(n_horizons)\n    intercepts = np.zeros(n_horizons)\n    for hi in range(n_horizons):\n        mh = m[:, hi, :]\n        X = b[:, hi, :][mh].reshape(-1, 1)\n        y = targ[:, hi, :][mh]\n        model = Ridge(alpha=100.0, fit_intercept=True).fit(X, y)\n        slopes[hi] = model.coef_[0]\n        intercepts[hi] = model.intercept_\n    \n    pred = np.zeros_like(b)\n    for hi in range(n_horizons):\n        pred[:, hi, :] = slopes[hi] * b[:, hi, :] + intercepts[hi]\n    \n    # History feature: last observation vs forecast at h=0\n    h_last = h[:, -1, :]\n    base_h0 = b[:, 0, :]\n    init_error = h_last - base_h0\n    \n    # Fit per-horizon coefficient\n    hist_coefs = np.zeros(n_horizons)\n    for hi in range(n_horizons):\n        mh = m[:, hi, :].flatten()\n        res_flat = (pred[:, hi, :] - targ[:, hi, :]).flatten()[mh]\n        ie_flat = init_error.flatten()[mh]\n        if len(ie_flat) > 10 and np.std(ie_flat) > 0:\n            X = ie_flat.reshape(-1, 1)\n            model = Ridge(alpha=100.0, fit_intercept=False).fit(X, res_flat)\n            hist_coefs[hi] = model.coef_[0]\n    \n    return {'slopes': slopes, 'intercepts': intercepts, 'hist_coefs': hist_coefs}\n\ndef pred_hist_corr(state, feat):\n    b = feat['base']\n    h = feat['history']\n    result = np.zeros_like(b)\n    for hi in range(n_horizons):\n        result[:, hi, :] = state['slopes'][hi] * b[:, hi, :] + state['intercepts'][hi]\n    \n    h_last = h[:, -1, :]\n    base_h0 = b[:, 0, :]\n    init_error = h_last - base_h0\n    for hi in range(n_horizons):\n        result[:, hi, :] -= state['hist_coefs'][hi] * init_error\n    \n    return np.maximum(result, 0)\n\nmae, std = cv_evaluate(fit_hist_corr, pred_hist_corr)\nprint(f\\\"Per-horizon Ridge + history correction: {mae:.4f} +/- {std:.4f}\\\")\n\nEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

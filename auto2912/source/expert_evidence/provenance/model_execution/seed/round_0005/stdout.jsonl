{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 << 'EOF'\nimport numpy as np\nfrom sklearn.linear_model import Ridge\nfrom sklearn.model_selection import KFold\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_targ = np.load('/workspace/public_assets/train_targets.npz')\ngraph = np.load('/workspace/public_assets/graph.npz')\n\nbase = train_feat['base'].astype(np.float64)\ntarget = train_targ['target'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\nadj = graph['adjacency'].astype(np.float64)\n\nmask = np.isfinite(target) & (target > 0)\nn_samples, n_horizons, n_nodes = base.shape\n\ndef compute_mae(pred, target, mask):\n    return np.abs(pred - target)[mask].mean()\n\nkf = KFold(n_splits=5, shuffle=True, random_state=42)\n\ndef graph_smooth(values_n, adj, alpha=0.1, n_iter=2):\n    result = values_n.copy()\n    deg = np.maximum(adj.sum(axis=1), 1.0)\n    for _ in range(n_iter):\n        neighbor_sum = adj.T @ result\n        neighbor_avg = neighbor_sum / deg\n        result = (1 - alpha) * result + alpha * neighbor_avg\n    return result\n\ndef cv_evaluate(fit_fn, predict_fn):\n    maes = []\n    for train_idx, val_idx in kf.split(range(n_samples)):\n        train_feat_fold = {\n            'base': base[train_idx], 'anchor': anchor[train_idx],\n            'history': history[train_idx], 'clock': clock[train_idx],\n        }\n        train_targ_fold = target[train_idx]\n        val_feat_fold = {\n            'base': base[val_idx], 'anchor': anchor[val_idx],\n            'history': history[val_idx], 'clock': clock[val_idx],\n        }\n        val_targ_fold = target[val_idx]\n        val_mask = mask[val_idx]\n        state = fit_fn(train_feat_fold, train_targ_fold)\n        pred = predict_fn(state, val_feat_fold)\n        maes.append(compute_mae(pred, val_targ_fold, val_mask))\n    return np.mean(maes), np.std(maes)\n\n# Explore clock features\nprint(\\\"=== Clock feature exploration ===\\\")\nprint(f\\\"Clock unique (node 0, sample 0): {np.unique(clock[0, :, 0])}\\\")\nprint(f\\\"Clock range: [{clock.min():.4f}, {clock.max():.4f}]\\\")\n# Check if clock varies across samples\nprint(f\\\"Clock unique values overall: {len(np.unique(clock))}\\\")\nprint(f\\\"Clock[:, 0, 0] unique: {np.unique(clock[:, 0, 0])}\\\")\n\n# Build features per sample-horizon-node\n# Try: base, anchor, clock, clock sin/cos, history last, history avg, history trend\ndef build_features(feat, h_idx):\n    \\\"\\\"\\\"Build feature matrix for a given horizon, flattened across samples*nodes.\\\"\\\"\\\"\n    b = feat['base'][:, h_idx, :]  # (sample, node)\n    a = feat['anchor'][:, h_idx, :]\n    c = feat['clock'][:, h_idx, :]\n    h = feat['history']  # (sample, hist_step, node)\n    \n    n_s, n_n = b.shape\n    \n    features = []\n    features.append(b.reshape(-1, 1))  # base\n    features.append(a.reshape(-1, 1))  # anchor\n    features.append(c.reshape(-1, 1))  # clock (time of day)\n    features.append(np.sin(2 * np.pi * c).reshape(-1, 1))  # clock sin\n    features.append(np.cos(2 * np.pi * c).reshape(-1, 1))  # clock cos\n    features.append(h[:, -1, :].reshape(-1, 1))  # last history\n    features.append(h.mean(axis=1).reshape(-1, 1))  # history mean\n    features.append((h[:, -1, :] - h[:, 0, :]).reshape(-1, 1))  # history trend\n    features.append(h[:, -3:, :].mean(axis=1).reshape(-1, 1))  # recent history mean\n    \n    return np.concatenate(features, axis=1)  # (sample*node, n_features)\n\n# Test: per-horizon Ridge with rich features\ndef fit_rich_ridge(feat, targ, alpha=100.0):\n    m = np.isfinite(targ) & (targ > 0)\n    coefs = []\n    intercepts = []\n    \n    for h in range(n_horizons):\n        X = build_features(feat, h)\n        y = targ[:, h, :].reshape(-1)\n        mh = m[:, h, :].reshape(-1)\n        X_m = X[mh]\n        y_m = y[mh]\n        model = Ridge(alpha=alpha, fit_intercept=True).fit(X_m, y_m)\n        coefs.append(model.coef_)\n        intercepts.append(model.intercept_)\n    \n    return {'coefs': np.array(coefs), 'intercepts': np.array(intercepts)}\n\ndef pred_rich_ridge(state, feat):\n    result = np.zeros((feat['base'].shape[0], n_horizons, n_nodes))\n    for h in range(n_horizons):\n        X = build_features(feat, h)\n        result[:, h, :] = (X @ state['coefs'][h] + state['intercepts'][h]).reshape(-1, n_nodes)\n    return np.maximum(result, 0)\n\nprint(\\\"\\\\n=== Rich feature Ridge per horizon ===\\\")\nfor alpha in [1, 10, 100, 1000, 10000]:\n    mae, std = cv_evaluate(\n        lambda f, t: fit_rich_ridge(f, t, alpha=alpha),\n        pred_rich_ridge\n    )\n    print(f\\\"  alpha={alpha:6d}: MAE={mae:.4f} +/- {std:.4f}\\\")\n\n# Method: rich Ridge + graph-smoothed per-node bias\ndef fit_rich_ridge_nodebias(feat, targ, alpha=100.0, shrink=0.5):\n    b = feat['base']\n    m = np.isfinite(targ) & (targ > 0)\n    \n    coefs = []\n    intercepts = []\n    for h in range(n_horizons):\n        X = build_features(feat, h)\n        y = targ[:, h, :].reshape(-1)\n        mh = m[:, h, :].reshape(-1)\n        model = Ridge(alpha=alpha, fit_intercept=True).fit(X[mh], y[mh])\n        coefs.append(model.coef_)\n        intercepts.append(model.intercept_)\n    \n    pred = np.zeros_like(b)\n    for h in range(n_horizons):\n        X = build_features(feat, h)\n        pred[:, h, :] = (X @ coefs[h] + intercepts[h]).reshape(-1, n_nodes)\n    \n    # Per-node residual bias\n    residual = pred - targ\n    node_bias = np.zeros(n_nodes)\n    for n in range(n_nodes):\n        mn = m[:, :, n]\n        if mn.sum() > 5:\n            node_bias[n] = residual[:, :, n][mn].mean()\n    \n    node_bias = shrink * node_bias\n    node_bias = graph_smooth(node_bias, adj, alpha=0.2, n_iter=3)\n    \n    return {'coefs': np.array(coefs), 'intercepts': np.array(intercepts), 'node_bias': node_bias}\n\ndef pred_rich_ridge_nodebias(state, feat):\n    result = np.zeros((feat['base'].shape[0], n_horizons, n_nodes))\n    for h in range(n_horizons):\n        X = build_features(feat, h)\n        result[:, h, :] = (X @ state['coefs'][h] + state['intercepts'][h]).reshape(-1, n_nodes)\n    result -= state['node_bias'][np.newaxis, np.newaxis, :]\n    return np.maximum(result, 0)\n\nprint(\\\"\\\\n=== Rich feature Ridge + node bias ===\\\")\nfor shrink in [0.3, 0.5, 0.7]:\n    mae, std = cv_evaluate(\n        lambda f, t: fit_rich_ridge_nodebias(f, t, alpha=100.0, shrink=shrink),\n        pred_rich_ridge_nodebias\n    )\n    print(f\\\"  shrink={shrink:.1f}: MAE={mae:.4f} +/- {std:.4f}\\\")\n\n# Rich Ridge + node bias + node-horizon bias\ndef fit_rich_ridge_nhbias(feat, targ, alpha=100.0, nb_shrink=0.5, nh_shrink=0.3):\n    b = feat['base']\n    m = np.isfinite(targ) & (targ > 0)\n    \n    coefs = []\n    intercepts = []\n    for h in range(n_horizons):\n        X = build_features(feat, h)\n        y = targ[:, h, :].reshape(-1)\n        mh = m[:, h, :].reshape(-1)\n        model = Ridge(alpha=alpha, fit_intercept=True).fit(X[mh], y[mh])\n        coefs.append(model.coef_)\n        intercepts.append(model.intercept_)\n    \n    pred = np.zeros_like(b)\n    for h in range(n_horizons):\n        X = build_features(feat, h)\n        pred[:, h, :] = (X @ coefs[h] + intercepts[h]).reshape(-1, n_nodes)\n    \n    # Node bias\n    residual = pred - targ\n    node_bias = np.zeros(n_nodes)\n    for n in range(n_nodes):\n        mn = m[:, :, n]\n        if mn.sum() > 5:\n            node_bias[n] = residual[:, :, n][mn].mean()\n    node_bias = nb_shrink * node_bias\n    node_bias = graph_smooth(node_bias, adj, alpha=0.2, n_iter=3)\n    pred -= node_bias[np.newaxis, np.newaxis, :]\n    \n    # Node-horizon bias\n    residual = pred - targ\n    bias_nh = np.zeros((n_horizons, n_nodes))\n    for h in range(n_horizons):\n        global_h_res = residual[:, h, :][m[:, h, :]].mean()\n        for n in range(n_nodes):\n            mn = m[:, h, n]\n            if mn.sum() > 3:\n                node_res = residual[:, h, n][mn].mean()\n                bias_nh[h, n] = nh_shrink * node_res + (1 - nh_shrink) * global_h_res\n            else:\n                bias_nh[h, n] = global_h_res\n    \n    for h in range(n_horizons):\n        bias_nh[h] = graph_smooth(bias_nh[h], adj, alpha=0.2, n_iter=3)\n    \n    return {\n        'coefs': np.array(coefs), 'intercepts': np.array(intercepts),\n        'node_bias': node_bias, 'bias_nh': bias_nh\n    }\n\ndef pred_rich_ridge_nhbias(state, feat):\n    result = np.zeros((feat['base'].shape[0], n_horizons, n_nodes))\n    for h in range(n_horizons):\n        X = build_features(feat, h)\n        result[:, h, :] = (X @ state['coefs'][h] + state['intercepts'][h]).reshape(-1, n_nodes)\n    result -= state['node_bias'][np.newaxis, np.newaxis, :]\n    result -= state['bias_nh'][np.newaxis, :, :]\n    return np.maximum(result, 0)\n\nprint(\\\"\\\\n=== Rich feature Ridge + node bias + NH bias ===\\\")\nfor nh_shrink in [0.1, 0.2, 0.3, 0.4]:\n    mae, std = cv_evaluate(\n        lambda f, t: fit_rich_ridge_nhbias(f, t, alpha=100.0, nb_shrink=0.5, nh_shrink=nh_shrink),\n        pred_rich_ridge_nhbias\n    )\n    print(f\\\"  nh_shrink={nh_shrink:.1f}: MAE={mae:.4f} +/- {std:.4f}\\\")\n\nEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

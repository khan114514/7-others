     best_w = anchor_h[h]\n                for w in np.linspace(0, 0.40, 21):\n                    pred = (1 - w) * base[:, h, n][m] + w * anchor[:, h, n][m]\n                    mae = np.abs(pred - target[:, h, n][m]).mean()\n                    if mae < best_mae:\n                        best_mae = mae\n                        best_w = w\n                anchor_nh[h, n] = best_w\n            else:\n                anchor_nh[h, n] = anchor_h[h]\n    anchor_nh = pna_shrink * anchor_nh + (1 - pna_shrink) * anchor_h[:, np.newaxis]\n    \n    blended = (1 - anchor_nh[np.newaxis, :, :]) * base + anchor_nh[np.newaxis, :, :] * anchor\n    \n    # Step 3: per-horizon median bias\n    h_bias = np.zeros(n_h)\n    for h in range(n_h):\n        m = mask[:, h, :]\n        h_bias[h] = np.median(blended[:, h, :][m] - target[:, h, :][m])\n    corrected = blended - h_bias[np.newaxis, :, np.newaxis]\n    residual = corrected - target\n    \n    # Step 4: per-node median bias\n    node_shrink = 0.4\n    node_bias = np.zeros(n_n)\n    for n in range(n_n):\n        m = mask[:, :, n]\n        if m.sum() > 5:\n            node_bias[n] = np.median(residual[:, :, n][m])\n    node_bias = node_shrink * node_bias\n    corrected = corrected - node_bias[np.newaxis, np.newaxis, :]\n    residual = corrected - target\n    \n    # Step 5: per-node-horizon median bias\n    pnh_bias_shrink = 0.15\n    bias_nh = np.zeros((n_h, n_n))\n    for h in range(n_h):\n        for n in range(n_n):\n            m = mask[:, h, n]\n            if m.sum() > 10:\n                bias_nh[h, n] = np.median(residual[:, h, n][m])\n    bias_nh = pnh_bias_shrink * bias_nh + (1 - pnh_bias_shrink) * 0\n    corrected = corrected - bias_nh[np.newaxis, :, :]\n    residual = corrected - target\n    \n    # Step 6: per-node multiplicative correction\n    node_mult_target = target / np.maximum(corrected, 1e-6)\n    mult_shrink = 0.1\n    mult_factor = np.ones(n_n)\n    for n in range(n_n):\n        m = mask[:, :, n]\n        if m.sum() > 10:\n            mult_factor[n] = np.median(node_mult_target[:, :, n][m])\n    mult_factor = 1 + mult_shrink * (mult_factor - 1)\n    \n    corrected = corrected * mult_factor[np.newaxis, np.newaxis, :]\n    residual = corrected - target\n    \n    return corrected, residual, anchor_nh, h_bias, node_bias, bias_nh, mult_factor\n\ncorrected, residual, anchor_nh, h_bias, node_bias, bias_nh, mult_factor = \\\\\n    build_method_state(base, anchor, history, clock, target, mask, 42)\n\nprint(f'After steps 1-6 (in-sample): MAE = {np.abs(-residual[mask]).mean():.4f}')\nprint(f'Reference base MAE: {np.abs(base[mask]-target[mask]).mean():.4f}')\n\n# Now let's check: can we add history-based features?\n# The current method uses history only in step 7/8 ridge features\n# History has 12 steps per node - can we use it more effectively?\nprint()\nprint('History shape:', history.shape)\nprint('History last step vs base h0 correlation:')\ncorr = np.corrcoef(history[:, -1, :].flatten(), base[:, 0, :].flatten())[0,1]\nprint(f'  h_last vs base_h0: {corr:.4f}')\ncorr = np.corrcoef(history[:, -1, :].flatten(), target[:, 0, :].flatten())[0,1]\nprint(f'  h_last vs target_h0: {corr:.4f}')\n\n# How much does history alone tell us about the error?\n# residual[s,h,n] = corrected[s,h,n] - target[s,h,n]\n# Can we predict residual from history?\nfor h in [0, 5, 11]:\n    err = residual[:, h, :]\n    # correlation of error with recent history levels\n    hist_last = history[:, -1, :]\n    valid = mask[:, h, :]\n    corr = np.corrcoef(err[valid], hist_last[valid])[0,1]\n    print(f'  H{h}: residual vs hist_last corr = {corr:.4f}')\n\\\"\n\"","aggregated_output":"After steps 1-6 (in-sample): MAE = 14.2447\nReference base MAE: 14.9934\n\nHistory shape: (74, 12, 170)\nHistory last step vs base h0 correlation:\n  h_last vs base_h0: 0.9939\n  h_last vs target_h0: 0.9858\n  H0: residual vs hist_last corr = -0.0568\n  H5: residual vs hist_last corr = 0.0251\n  H11: residual vs hist_last corr = 0.0489\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/sh -lc \"python -c \\\"\nimport numpy as np\nfrom sklearn.linear_model import Ridge\nfrom sklearn.model_selection import KFold\n\ntr_f = np.load('/workspace/public_assets/train_features.npz')\ntr_t = np.load('/workspace/public_assets/train_targets.npz')\nbase = tr_f['base'].astype(np.float64)\nhistory = tr_f['history'].astype(np.float64)\nanchor = tr_f['anchor'].astype(np.float64)\nclock = tr_f['clock'].astype(np.float64)\ntarget = tr_t['target'].astype(np.float64)\n\nn_s, n_h, n_n = base.shape\nmask = np.isfinite(target) & (target > 0)\n\n# Let me do proper 5-fold CV of the existing method and understand the gaps\n# First, replicate the full method in a CV-compatible way\n\ndef fit_and_predict(base_tr, anchor_tr, hist_tr, clock_tr, target_tr, mask_tr,\n                    base_te, anchor_te, hist_te, clock_te, seed):\n    from sklearn.linear_model import Ridge\n    rng = np.random.RandomState(seed)\n    ns_tr, nh, nn = base_tr.shape\n    ns_te = base_te.shape[0]\n    \n    # Step 1: per-horizon anchor blending\n    anchor_h = np.zeros(nh)\n    for h in range(nh):\n        m = mask_tr[:, h, :]\n        best_mae = float('inf')\n        for w in np.linspace(0, 0.30, 31):\n            pred = (1 - w) * base_tr[:, h, :][m] + w * anchor_tr[:, h, :][m]\n            mae = np.abs(pred - target_tr[:, h, :][m]).mean()\n            if mae < best_mae:\n                best_mae = mae\n                anchor_h[h] = w\n    \n    # Step 2: per-node-horizon anchor blending\n    pna_shrink = 0.3\n    anchor_nh = np.zeros((nh, nn))\n    for h in range(nh):\n        for n in range(nn):\n            m = mask_tr[:, h, n]\n            if m.sum() > 15:\n                best_mae = float('inf')\n                best_w = anchor_h[h]\n                for w in np.linspace(0, 0.40, 21):\n                    pred = (1 - w) * base_tr[:, h, n][m] + w * anchor_tr[:, h, n][m]\n                    mae = np.abs(pred - target_tr[:, h, n][m]).mean()\n                    if mae < best_mae:\n                        best_mae = mae\n                        best_w = w\n                anchor_nh[h, n] = best_w\n            else:\n                anchor_nh[h, n] = anchor_h[h]\n    anchor_nh = pna_shrink * anchor_nh + (1 - pna_shrink) * anchor_h[:, np.newaxis]\n    \n    # Blend\n    def apply_blend(b, a):\n        return (1 - anchor_nh[np.newaxis, :, :]) * b + anchor_nh[np.newaxis, :, :] * a\n    \n    blended_tr = apply_blend(base_tr, anchor_tr)\n    blended_te = apply_blend(base_te, anchor_te)\n    \n    # Step 3: per-horizon median bias\n    h_bias = np.zeros(nh)\n    for h in range(nh):\n        m = mask_tr[:, h, :]\n        h_bias[h] = np.median(blended_tr[:, h, :][m] - target_tr[:, h, :][m])\n    \n    corrected_tr = blended_tr - h_bias[np.newaxis, :, np.newaxis]\n    corrected_te = blended_te - h_bias[np.newaxis, :, np.newaxis]\n    residual_tr = corrected_tr - target_tr\n    \n    # Step 4: per-node median bias\n    node_shrink = 0.4\n    node_bias = np.zeros(nn)\n    for n in range(nn):\n        m = mask_tr[:, :, n]\n        if m.sum() > 5:\n            node_bias[n] = np.median(residual_tr[:, :, n][m])\n    node_bias = node_shrink * node_bias\n    corrected_tr = corrected_tr - node_bias[np.newaxis, np.newaxis, :]\n    corrected_te = corrected_te - node_bias[np.newaxis, np.newaxis, :]\n    residual_tr = corrected_tr - target_tr\n    \n    # Step 5: per-node-horizon median bias\n    pnh_bias_shrink = 0.15\n    bias_nh = np.zeros((nh, nn))\n    for h in range(nh):\n        for n in range(nn):\n            m = mask_tr[:, h, n]\n            if m.sum() > 10:\n                bias_nh[h, n] = np.median(residual_tr[:, h, n][m])\n    bias_nh = pnh_bias_shrink * bias_nh + (1 - pnh_bias_shrink) * 0\n    corrected_tr = corrected_tr - bias_nh[np.newaxis, :, :]\n    corrected_te = corrected_te - bias_nh[np.newaxis, :, :]\n    residual_tr = corrected_tr - target_tr\n    \n    # Step 6: per-node multiplicative correction\n    node_mult_target = target_tr / np.maximum(corrected_tr, 1e-6)\n    mult_shrink = 0.1\n    mult_factor = np.ones(nn)\n    for n in range(nn):\n        m = mask_tr[:, :, n]\n        if m.sum() > 10:\n            mult_factor[n] = np.median(node_mult_target[:, :, n][m])\n    mult_factor = 1 + mult_shrink * (mult_factor - 1)\n    corrected_tr = corrected_tr * mult_factor[np.newaxis, np.newaxis, :]\n    corrected_te = corrected_te * mult_factor[np.newaxis, np.newaxis, :]\n    residual_tr = corrected_tr - target_tr\n    \n    # Step 7: per-sample bias ridge\n    sample_shrink = 0.5\n    \n    def build_sample_feats(b, a, h, c):\n        fl = []\n        fl.append(b.mean(axis=2)[:, :, np.newaxis])\n        fl.append(a.mean(axis=2)[:, :, np.newaxis])\n        fl.append((b - a).mean(axis=2)[:, :, np.newaxis])\n        hist_last = h[:, -1, :]\n        fl.append(np.tile(hist_last.mean(axis=1)[:, np.newaxis, np.newaxis], (1, nh, 1)))\n        fl.append(np.tile(h.mean(axis=(1, 2))[:, np.newaxis, np.newaxis], (1, nh, 1)))\n        hist_trend = (h[:, -1, :] - h[:, 0, :]) / 12.0\n        fl.append(np.tile(hist_trend.mean(axis=1)[:, np.newaxis, np.newaxis], (1, nh, 1)))\n        fl.append(np.sin(2 * np.pi * c[:, :, 0:1]))\n        fl.append(np.cos(2 * np.pi * c[:, :, 0:1]))\n        fl.append(np.sin(4 * np.pi * c[:, :, 0:1]))\n        fl.append(np.cos(4 * np.pi * c[:, :, 0:1]))\n        return np.concatenate(fl, axis=2)\n    \n    sample_feat_tr = build_sample_feats(base_tr, anchor_tr, hist_tr, clock_tr)\n    sample_feat_te = build_sample_feats(base_te, anchor_te, hist_te, clock_te)\n    \n    sample_models = []\n    sample_pred_tr = np.zeros((ns_tr, nh))\n    sample_pred_te = np.zeros((ns_te, nh))\n    for h in range(nh):\n        m = mask_tr[:, h, :]\n        y = residual_tr[:, h, :].mean(axis=1)\n        X = sample_feat_tr[:, h, :]\n        X_valid = X\n        mu = X_valid.mean(axis=0)\n        sd = X_valid.std(axis=0)\n        sd[sd < 1e-6] = 1.0\n        Xs = (X_valid - mu) / sd\n        model = Ridge(alpha=10.0, fit_intercept=True)\n        model.fit(Xs, y)\n        sample_models.append((model, mu, sd))\n        sample_pred_tr[:, h] = model.predict(Xs)\n        Xs_te = (sample_feat_te[:, h, :] - mu) / sd\n        sample_pred_te[:, h] = model.predict(Xs_te)\n    \n    corrected_tr = corrected_tr - sample_shrink * sample_pred_tr[:, :, np.newaxis]\n    corrected_te = corrected_te - sample_shrink * sample_pred_te[:, :, np.newaxis]\n    residual_tr = corrected_tr - target_tr\n    \n    # Step 8: ridge per-node\n    ridge_shrink = 0.3\n    ridge_alpha = 100.0\n    \n    hist_last_tr = hist_tr[:, -1, :]\n    hist_avg_tr = hist_tr.mean(axis=1)\n    hist_trend_tr = (hist_tr[:, -1, :] - hist_tr[:, 0, :]) / 12.0\n    hist_last_te = hist_te[:, -1, :]\n    hist_avg_te = hist_te.mean(axis=1)\n    hist_trend_te = (hist_te[:, -1, :] - hist_te[:, 0, :]) / 12.0\n    \n    def build_node_feats(base_h, anchor_h, hl, ha, ht, clock_h, ns):\n        node_idx = np.tile(np.arange(nn), (ns, 1)).reshape(-1, 1)\n        X = np.hstack([\n            base_h.reshape(-1, 1),\n            anchor_h.reshape(-1, 1),\n            (base_h - anchor_h).reshape(-1, 1),\n            hl.reshape(-1, 1),\n            ha.reshape(-1, 1),\n            ht.reshape(-1, 1),\n            (hl - base_h).reshape(-1, 1),\n            np.sin(2 * np.pi * np.repeat(clock_h, nn)).reshape(-1, 1),\n            np.cos(2 * np.pi * np.repeat(clock_h, nn)).reshape(-1, 1),\n            np.sin(4 * np.pi * np.repeat(clock_h, nn)).reshape(-1, 1),\n            np.cos(4 * np.pi * np.repeat(clock_h, nn)).reshape(-1, 1),\n            np.sin(2 * np.pi * node_idx / nn),\n            np.cos(2 * np.pi * node_idx / nn),\n            np.sin(4 * np.pi * node_idx / nn),\n            np.cos(4 * np.pi * node_idx / nn),\n        ])\n        return X\n    \n    for h in range(nh):\n        m = mask_tr[:, h, :]\n        y = residual_tr[:, h, :][m].flatten()\n        if len(y) < 100:\n            continue\n        X = build_node_feats(base_tr[:, h, :], anchor_tr[:, h, :],\n                            hist_last_tr, hist_avg_tr, hist_trend_tr,\n                            clock_tr[:, h, 0], ns_tr)\n        X_valid = X[m.flatten()]\n        mu = X_valid.mean(axis=0)\n        sd = X_valid.std(axis=0)\n        sd[sd < 1e-6] = 1.0\n        Xs = (X_valid - mu) / sd\n        model = Ridge(alpha=ridge_alpha, fit_intercept=True)\n        model.fit(Xs, y)\n        \n        # Apply to train\n        X_tr = build_node_feats(base_tr[:, h, :], anchor_tr[:, h, :],\n                               hist_last_tr, hist_avg_tr, hist_trend_tr,\n                               clock_tr[:, h, 0], ns_tr)\n        Xs_tr = (X_tr - mu) / sd\n        corr_tr = ridge_shrink * model.predict(Xs_tr).reshape(ns_tr, nn)\n        corrected_tr[:, h, :] -= corr_tr\n        \n        # Apply to test\n        X_te = build_node_feats(base_te[:, h, :], anchor_te[:, h, :],\n                               hist_last_te, hist_avg_te, hist_trend_te,\n                               clock_te[:, h, 0], ns_te)\n        Xs_te = (X_te - mu) / sd\n        corr_te = ridge_shrink * model.predict(Xs_te).reshape(ns_te, nn)\n        corrected_te[:, h, :] -= corr_te\n    \n    return np.maximum(corrected_te, 0.0)\n\n# 5-fold CV\nkf = KFold(n_splits=5, shuffle=True, random_state=42)\nmaes = []\nfor fold, (tr_idx, te_idx) in enumerate(kf.split(np.arange(n_s))):\n    pred = fit_and_predict(\n        base[tr_idx], anchor[tr_idx], history[tr_idx], clock[tr_idx], target[tr_idx], mask[tr_idx],\n        base[te_idx], anchor[te_idx], history[te_idx], clock[te_idx], 42\n    )\n    te_mask = mask[te_idx]\n    mae = np.abs(pred[te_mask] - target[te_idx][te_mask]).mean()\n    maes.append(mae)\n    print(f'Fold {fold}: MAE = {mae:.4f}')\n\nprint(f'CV Mean MAE: {np.mean(maes):.4f} +/- {np.std(maes):.4f}')\nprint(f'Baseline (identity) MAE: {np.abs(base[mask]-target[mask]).mean():.4f}')\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/sh -lc \"python -c \\\"\nimport numpy as np\nfrom sklearn.linear_model import Ridge\nfrom sklearn.model_selection import KFold\n\ntr_f = np.load('/workspace/public_assets/train_features.npz')\ntr_t = np.load('/workspace/public_assets/train_targets.npz')\nbase = tr_f['base'].astype(np.float64)\nhistory = tr_f['history'].astype(np.float64)\nanchor = tr_f['anchor'].astype(np.float64)\nclock = tr_f['clock'].astype(np.float64)\ntarget = tr_t['target'].astype(np.float64)\n\nn_s, n_h, n_n = base.shape\nmask = np.isfinite(target) & (target > 0)\n\n# Let me do proper 5-fold CV of the existing method and understand the gaps\n# First, replicate the full method in a CV-compatible way\n\ndef fit_and_predict(base_tr, anchor_tr, hist_tr, clock_tr, target_tr, mask_tr,\n                    base_te, anchor_te, hist_te, clock_te, seed):\n    from sklearn.linear_model import Ridge\n    rng = np.random.RandomState(seed)\n    ns_tr, nh, nn = base_tr.shape\n    ns_te = base_te.shape[0]\n    \n    # Step 1: per-horizon anchor blending\n    anchor_h = np.zeros(nh)\n    for h in range(nh):\n        m = mask_tr[:, h, :]\n        best_mae = float('inf')\n        for w in np.linspace(0, 0.30, 31):\n            pred = (1 - w) * base_tr[:, h, :][m] + w * anchor_tr[:, h, :][m]\n            mae = np.abs(pred - target_tr[:, h, :][m]).mean()\n            if mae < best_mae:\n                best_mae = mae\n                anchor_h[h] = w\n    \n    # Step 2: per-node-horizon anchor blending\n    pna_shrink = 0.3\n    anchor_nh = np.zeros((nh, nn))\n    for h in range(nh):\n        for n in range(nn):\n            m = mask_tr[:, h, n]\n            if m.sum() > 15:\n                best_mae = float('inf')\n                best_w = anchor_h[h]\n                for w in np.linspace(0, 0.40, 21):\n                    pred = (1 - w) * base_tr[:, h, n][m] + w * anchor_tr[:, h, n][m]\n                    mae = np.abs(pred - target_tr[:, h, n][m]).mean()\n                    if mae < best_mae:\n                        best_mae = mae\n                        best_w = w\n                anchor_nh[h, n] = best_w\n            else:\n                anchor_nh[h, n] = anchor_h[h]\n    anchor_nh = pna_shrink * anchor_nh + (1 - pna_shrink) * anchor_h[:, np.newaxis]\n    \n    # Blend\n    def apply_blend(b, a):\n        return (1 - anchor_nh[np.newaxis, :, :]) * b + anchor_nh[np.newaxis, :, :] * a\n    \n    blended_tr = apply_blend(base_tr, anchor_tr)\n    blended_te = apply_blend(base_te, anchor_te)\n    \n    # Step 3: per-horizon median bias\n    h_bias = np.zeros(nh)\n    for h in range(nh):\n        m = mask_tr[:, h, :]\n        h_bias[h] = np.median(blended_tr[:, h, :][m] - target_tr[:, h, :][m])\n    \n    corrected_tr = blended_tr - h_bias[np.newaxis, :, np.newaxis]\n    corrected_te = blended_te - h_bias[np.newaxis, :, np.newaxis]\n    residual_tr = corrected_tr - target_tr\n    \n    # Step 4: per-node median bias\n    node_shrink = 0.4\n    node_bias = np.zeros(nn)\n    for n in range(nn):\n        m = mask_tr[:, :, n]\n        if m.sum() > 5:\n            node_bias[n] = np.median(residual_tr[:, :, n][m])\n    node_bias = node_shrink * node_bias\n    corrected_tr = corrected_tr - node_bias[np.newaxis, np.newaxis, :]\n    corrected_te = corrected_te - node_bias[np.newaxis, np.newaxis, :]\n    residual_tr = corrected_tr - target_tr\n    \n    # Step 5: per-node-horizon median bias\n    pnh_bias_shrink = 0.15\n    bias_nh = np.zeros((nh, nn))\n    for h in range(nh):\n        for n in range(nn):\n            m = mask_tr[:, h, n]\n            if m.sum() > 10:\n                bias_nh[h, n] = np.median(residual_tr[:, h, n][m])\n    bias_nh = pnh_bias_shrink * bias_nh + (1 - pnh_bias_shrink) * 0\n    corrected_tr = corrected_tr - bias_nh[np.newaxis, :, :]\n    corrected_te = corrected_te - bias_nh[np.newaxis, :, :]\n    residual_tr = corrected_tr - target_tr\n    \n    # Step 6: per-node multiplicative correction\n    node_mult_target = target_tr / np.maximum(corrected_tr, 1e-6)\n    mult_shrink = 0.1\n    mult_factor = np.ones(nn)\n    for n in range(nn):\n        m = mask_tr[:, :, n]\n        if m.sum() > 10:\n            mult_factor[n] = np.median(node_mult_target[:, :, n][m])\n    mult_factor = 1 + mult_shrink * (mult_factor - 1)\n    corrected_tr = corrected_tr * mult_factor[np.newaxis, np.newaxis, :]\n    corrected_te = corrected_te * mult_factor[np.newaxis, np.newaxis, :]\n    residual_tr = corrected_tr - target_tr\n    \n    # Step 7: per-sample bias ridge\n    sample_shrink = 0.5\n    \n    def build_sample_feats(b, a, h, c):\n        fl = []\n        fl.append(b.mean(axis=2)[:, :, np.newaxis])\n        fl.append(a.mean(axis=2)[:, :, np.newaxis])\n        fl.append((b - a).mean(axis=2)[:, :, np.newaxis])\n        hist_last = h[:, -1, :]\n        fl.append(np.tile(hist_last.mean(axis=1)[:, np.newaxis, np.newaxis], (1, nh, 1)))\n        fl.append(np.tile(h.mean(axis=(1, 2))[:, np.newaxis, np.newaxis], (1, nh, 1)))\n        hist_trend = (h[:, -1, :] - h[:, 0, :]) / 12.0\n        fl.append(np.tile(hist_trend.mean(axis=1)[:, np.newaxis, np.newaxis], (1, nh, 1)))\n        fl.append(np.sin(2 * np.pi * c[:, :, 0:1]))\n        fl.append(np.cos(2 * np.pi * c[:, :, 0:1]))\n        fl.append(np.sin(4 * np.pi * c[:, :, 0:1]))\n        fl.append(np.cos(4 * np.pi * c[:, :, 0:1]))\n        return np.concatenate(fl, axis=2)\n    \n    sample_feat_tr = build_sample_feats(base_tr, anchor_tr, hist_tr, clock_tr)\n    sample_feat_te = build_sample_feats(base_te, anchor_te, hist_te, clock_te)\n    \n    sample_models = []\n    sample_pred_tr = np.zeros((ns_tr, nh))\n    sample_pred_te = np.zeros((ns_te, nh))\n    for h in range(nh):\n        m = mask_tr[:, h, :]\n        y = residual_tr[:, h, :].mean(axis=1)\n        X = sample_feat_tr[:, h, :]\n        X_valid = X\n        mu = X_valid.mean(axis=0)\n        sd = X_valid.std(axis=0)\n        sd[sd < 1e-6] = 1.0\n        Xs = (X_valid - mu) / sd\n        model = Ridge(alpha=10.0, fit_intercept=True)\n        model.fit(Xs, y)\n        sample_models.append((model, mu, sd))\n        sample_pred_tr[:, h] = model.predict(Xs)\n        Xs_te = (sample_feat_te[:, h, :] - mu) / sd\n        sample_pred_te[:, h] = model.predict(Xs_te)\n    \n    corrected_tr = corrected_tr - sample_shrink * sample_pred_tr[:, :, np.newaxis]\n    corrected_te = corrected_te - sample_shrink * sample_pred_te[:, :, np.newaxis]\n    residual_tr = corrected_tr - target_tr\n    \n    # Step 8: ridge per-node\n    ridge_shrink = 0.3\n    ridge_alpha = 100.0\n    \n    hist_last_tr = hist_tr[:, -1, :]\n    hist_avg_tr = hist_tr.mean(axis=1)\n    hist_trend_tr = (hist_tr[:, -1, :] - hist_tr[:, 0, :]) / 12.0\n    hist_last_te = hist_te[:, -1, :]\n    hist_avg_te = hist_te.mean(axis=1)\n    hist_trend_te = (hist_te[:, -1, :] - hist_te[:, 0, :]) / 12.0\n    \n    def build_node_feats(base_h, anchor_h, hl, ha, ht, clock_h, ns):\n        node_idx = np.tile(np.arange(nn), (ns, 1)).reshape(-1, 1)\n        X = np.hstack([\n            base_h.reshape(-1, 1),\n            anchor_h.reshape(-1, 1),\n            (base_h - anchor_h).reshape(-1, 1),\n            hl.reshape(-1, 1),\n            ha.reshape(-1, 1),\n            ht.reshape(-1, 1),\n            (hl - base_h).reshape(-1, 1),\n            np.sin(2 * np.pi * np.repeat(clock_h, nn)).reshape(-1, 1),\n            np.cos(2 * np.pi * np.repeat(clock_h, nn)).reshape(-1, 1),\n            np.sin(4 * np.pi * np.repeat(clock_h, nn)).reshape(-1, 1),\n            np.cos(4 * np.pi * np.repeat(clock_h, nn)).reshape(-1, 1),\n            np.sin(2 * np.pi * node_idx / nn),\n            np.cos(2 * np.pi * node_idx / nn),\n            np.sin(4 * np.pi * node_idx / nn),\n            np.cos(4 * np.pi * node_idx / nn),\n        ])\n        return X\n    \n    for h in range(nh):\n        m = mask_tr[:, h, :]\n        y = residual_tr[:, h, :][m].flatten()\n        if len(y) < 100:\n            continue\n        X = build_node_feats(base_tr[:, h, :], anchor_tr[:, h, :],\n                            hist_last_tr, hist_avg_tr, hist_trend_tr,\n                            clock_tr[:, h, 0], ns_tr)\n        X_valid = X[m.flatten()]\n        mu = X_valid.mean(axis=0)\n        sd = X_valid.std(axis=0)\n        sd[sd < 1e-6] = 1.0\n        Xs = (X_valid - mu) / sd\n        model = Ridge(alpha=ridge_alpha, fit_intercept=True)\n        model.fit(Xs, y)\n        \n        # Apply to train\n        X_tr = build_node_feats(base_tr[:, h, :], anchor_tr[:, h, :],\n                               hist_last_tr, hist_avg_tr, hist_trend_tr,\n                               clock_tr[:, h, 0], ns_tr)\n        Xs_tr = (X_tr - mu) / sd\n        corr_tr = ridge_shrink * model.predict(Xs_tr).reshape(ns_tr, nn)\n        corrected_tr[:, h, :] -= corr_tr\n        \n        # Apply to test\n        X_te = build_node_feats(base_te[:, h, :], anchor_te[:, h, :],\n                               hist_last_te, hist_avg_te, hist_trend_te,\n                               clock_te[:, h, 0], ns_te)\n        Xs_te = (X_te - mu) / sd\n        corr_te = ridge_shrink * model.predict(Xs_te).reshape(ns_te, nn)\n        corrected_te[:, h, :] -= corr_te\n    \n    return np.maximum(corrected_te, 0.0)\n\n# 5-fold CV\nkf = KFold(n_splits=5, shuffle=True, random_state=42)\nmaes = []\nfor fold, (tr_idx, te_idx) in enumerate(kf.split(np.arange(n_s))):\n    pred = fit_and_predict(\n        base[tr_idx], anchor[tr_idx], history[tr_idx], clock[tr_idx], target[tr_idx], mask[tr_idx],\n        base[te_idx], anchor[te_idx], history[te_idx], clock[te_idx], 42\n    )\n    te_mask = mask[te_idx]\n    mae = np.abs(pred[te_mask] - target[te_idx][te_mask]).mean()\n    maes.append(mae)\n    print(f'Fold {fold}: MAE = {mae:.4f}')\n\nprint(f'CV Mean MAE: {np.mean(maes):.4f} +/- {np.std(maes):.4f}')\nprint(f'Baseline (identity) MAE: {np.abs(base[mask]-target[mask]).mean():.4f}')\n\\\" 2>&1\n\"","aggregated_output":"Fold 0: MAE = 14.8527\nFold 1: MAE = 14.4929\nFold 2: MAE = 15.3144\nFold 3: MAE = 14.4224\nFold 4: MAE = 12.2589\nCV Mean MAE: 14.2683 +/- 1.0533\nBaseline (identity) MAE: 14.9934\n","exit_code":0,"status":"completed"}}

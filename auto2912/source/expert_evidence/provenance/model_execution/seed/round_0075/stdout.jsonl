{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/sh -lc \"python << 'PYEOF'\nimport numpy as np\nfrom sklearn.linear_model import Ridge\nfrom sklearn.model_selection import KFold\n\ntr_f = np.load('/workspace/public_assets/train_features.npz')\ntr_t = np.load('/workspace/public_assets/train_targets.npz')\nbase = tr_f['base'].astype(np.float64)\nhistory = tr_f['history'].astype(np.float64)\nanchor = tr_f['anchor'].astype(np.float64)\nclock = tr_f['clock'].astype(np.float64)\ntarget = tr_t['target'].astype(np.float64)\n\nn_s, n_h, n_n = base.shape\nmask = np.isfinite(target) & (target > 0)\n\n# IDENTITY: what if we use history as a predictor for short horizons?\n# History has 12 steps - these are past observations\n# For horizon 0, history[-1] is the most recent observation\n# Maybe we can blend history extrapolation with base forecast\n\nprint(\\\"=== History as predictor ===\\\")\nfor h in range(n_h):\n    # The last history step is the most recent observation\n    # How well does it predict target at horizon h?\n    m = mask[:, h, :]\n    hist_mae = np.abs(history[:, -1, :][m] - target[:, h, :][m]).mean()\n    base_mae = np.abs(base[:, h, :][m] - target[:, h, :][m]).mean()\n    # Try optimal blend of base + hist_last\n    best_mae = float('inf')\n    best_w = 0\n    for w in np.linspace(0, 1, 101):\n        pred = (1-w) * base[:, h, :][m] + w * history[:, -1, :][m]\n        mae = np.abs(pred - target[:, h, :][m]).mean()\n        if mae < best_mae:\n            best_mae = mae\n            best_w = w\n    print(f\\\"H{h:2d}: base={base_mae:.3f}, hist_last={hist_mae:.3f}, best_blend={best_mae:.3f} (w={best_w:.2f})\\\")\n\nprint()\nprint(\\\"=== Clock-based bias (time of day) ===\\\")\n# Clock is time of day in [0,1). Errors might have diurnal patterns.\n# Let's see if we can get a better per-horizon bias by conditioning on time of day\nclock_vals = clock[:, 0, 0]  # all same per sample\nprint(f\\\"Unique clock values: {len(np.unique(clock_vals))}\\\")\n\n# Try: per-horizon, per-time-of-day bias \n# But 288 time bins * 12 horizons * 170 nodes with 74 samples is too sparse\n# Let's try per-horizon time-of-day bias (aggregated over nodes)\nfor h in [0, 6, 11]:\n    # Residual of just base minus target\n    res = base[:, h, :] - target[:, h, :]\n    # Bin clock into 24 bins (hourly)\n    n_bins = 24\n    bin_idx = np.floor(clock_vals * n_bins).astype(int) % n_bins\n    \n    # Compute per-bin median bias (over all samples and nodes)\n    bin_bias = np.zeros(n_bins)\n    for b in range(n_bins):\n        idx = bin_idx == b\n        m = mask[:, h, :] & idx[:, np.newaxis]\n        if m.sum() > 50:\n            bin_bias[b] = np.median(res[m])\n    \n    # Apply and measure improvement (in-sample)\n    corrected = base[:, h, :] - bin_bias[bin_idx][:, np.newaxis]\n    m = mask[:, h, :]\n    base_mae = np.abs(base[:, h, :][m] - target[:, h, :][m]).mean()\n    corr_mae = np.abs(corrected[m] - target[:, h, :][m]).mean()\n    print(f\\\"H{h}: base_mae={base_mae:.3f}, time-of-day_bias={corr_mae:.3f} (improvement={base_mae-corr_mae:.4f})\\\")\n\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

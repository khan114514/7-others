{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_targ = np.load('/workspace/public_assets/train_targets.npz')\n\ntargets = train_targ['target'].astype(np.float64)\nbase = train_feat['base'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\n\nn_samples, n_horizons, n_nodes = base.shape\nmask = np.isfinite(targets) & (targets > 0)\n\n# TOD analysis - bin clock values and compute per-bin errors\n# 288 unique values = 5-minute bins. Group into coarser bins.\nn_bins = 24  # hourly\ntod = clock[:, 0, 0]  # same across horizons and nodes, just get starting TOD\ntod_idx = np.floor(tod * n_bins).astype(int)\ntod_idx = np.clip(tod_idx, 0, n_bins - 1)\n\nprint('Per-TOD-hour base error statistics:')\nfor b in range(n_bins):\n    idx = tod_idx == b\n    if idx.sum() > 0:\n        m = mask[idx]\n        err = base[idx][m] - targets[idx][m]\n        print(f'  bin {b:2d} ({idx.sum():2d} samples): bias={err.mean():+.3f}, MAE={np.abs(err).mean():.3f}')\n\n# What about the graph?\ngraph = np.load('/workspace/public_assets/graph.npz')\nadj = graph['adjacency']\nprint(f'\\\\nGraph: shape={adj.shape}, nnz={(adj>0).sum()}')\nprint(f'  symmetric? {np.allclose(adj, adj.T)}')\nprint(f'  row sums range: {adj.sum(axis=1).min():.1f} to {adj.sum(axis=1).max():.1f}')\nprint(f'  isolated nodes: {(adj.sum(axis=1) == 0).sum()}')\n\n# Check per-node error variance\nprint('\\\\nPer-node bias stats:')\nnode_biases = np.zeros(n_nodes)\nfor n in range(n_nodes):\n    m = mask[:, :, n]\n    if m.sum() > 0:\n        node_biases[n] = (base[:, :, n][m] - targets[:, :, n][m]).mean()\nprint(f'  mean bias: {node_biases.mean():.3f}')\nprint(f'  std of node biases: {node_biases.std():.3f}')\nprint(f'  range: [{node_biases.min():.3f}, {node_biases.max():.3f}]')\n\n# How much variance does per-node bias explain?\n# If we subtract per-node bias, what's the MAE reduction?\ncorrected = base - node_biases[np.newaxis, np.newaxis, :]\nprint(f'  MAE after per-node mean bias: {np.abs(corrected[mask] - targets[mask]).mean():.4f}')\n\n# Per-horizon bias\nhorizon_biases = np.zeros(n_horizons)\nfor h in range(n_horizons):\n    m = mask[:, h, :]\n    horizon_biases[h] = (base[:, h, :][m] - targets[:, h, :][m]).mean()\ncorrected2 = base - horizon_biases[np.newaxis, :, np.newaxis]\nprint(f'  MAE after per-horizon mean bias: {np.abs(corrected2[mask] - targets[mask]).mean():.4f}')\n\n# Both\ncorrected3 = base - node_biases[np.newaxis, np.newaxis, :] - horizon_biases[np.newaxis, :, np.newaxis]\nprint(f'  MAE after both: {np.abs(corrected3[mask] - targets[mask]).mean():.4f}')\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

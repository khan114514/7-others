{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np\nfrom sklearn.linear_model import Ridge, Lasso\nfrom sklearn.model_selection import KFold\nimport sys\nsys.path.insert(0, '/workspace/solution')\nfrom method import fit, predict\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_targ = np.load('/workspace/public_assets/train_targets.npz')\n\ntargets = train_targ['target'].astype(np.float64)\nbase = train_feat['base'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\n\nn_samples, n_horizons, n_nodes = base.shape\nmask = np.isfinite(targets) & (targets > 0)\n\nfeatures_dict = {'base': base, 'anchor': anchor, 'history': history, 'clock': clock}\nstate = fit(features_dict, targets, 42)\npreds = predict(state, features_dict)\nresidual = preds - targets\n\n# Key idea: sample-level bias correction is important but hard with 74 samples\n# Let's look at how predictable the sample-level bias is\n# Sample bias = mean residual per sample\nsample_bias = np.zeros(n_samples)\nfor s in range(n_samples):\n    m = mask[s, :, :]\n    sample_bias[s] = residual[s, :, :][m].mean()\n\nprint(f'Sample bias std: {sample_bias.std():.4f}')\nprint(f'Sample bias range: [{sample_bias.min():.3f}, {sample_bias.max():.3f}]')\n\n# Can we predict sample bias from features?\n# Features: base mean, anchor mean, history mean, history trend, clock, etc.\nsample_feat_list = []\nsample_feat_list.append(base.mean(axis=(1,2)))  # overall base level\nsample_feat_list.append(anchor.mean(axis=(1,2)))\nsample_feat_list.append(history.mean(axis=(1,2)))\nsample_feat_list.append((history[:, -1, :] - history[:, 0, :]).mean(axis=1))  # trend\nsample_feat_list.append(history[:, -1, :] - history[:, -2, :]).mean(axis=1)  # recent change\nsample_feat_list.append(history.std(axis=(1,2)))  # variability\nsample_feat_list.append(np.sin(2*np.pi*clock[:, 0, 0]))\nsample_feat_list.append(np.cos(2*np.pi*clock[:, 0, 0]))\nsample_feat_list.append(np.sin(4*np.pi*clock[:, 0, 0]))\nsample_feat_list.append(np.cos(4*np.pi*clock[:, 0, 0]))\nsample_feat_list.append(np.sin(6*np.pi*clock[:, 0, 0]))\nsample_feat_list.append(np.cos(6*np.pi*clock[:, 0, 0]))\nsample_feat_list.append((base - anchor).mean(axis=(1,2)))\nsample_feat_list.append((base[:, 0, :] - history[:, -1, :]).mean(axis=1))  # short-horizon error\nsample_feat_list.append(base[:, 5, :].mean(axis=1) - base[:, 0, :].mean(axis=1))  # forecast trajectory slope\n\nX_sample = np.column_stack(sample_feat_list)\nprint(f'X_sample shape: {X_sample.shape}')\n\n# CV of sample bias prediction\nkf = KFold(n_splits=5, shuffle=True, random_state=42)\nprint('\\\\nSample-level bias prediction CV:')\nfor alpha in [0.1, 1.0, 10.0, 100.0]:\n    fold_r2 = []\n    fold_mae_improve = []\n    for train_idx, val_idx in kf.split(range(n_samples)):\n        X_tr = X_sample[train_idx]\n        y_tr = sample_bias[train_idx]\n        X_va = X_sample[val_idx]\n        y_va = sample_bias[val_idx]\n        \n        mu = X_tr.mean(axis=0)\n        sd = X_tr.std(axis=0)\n        sd[sd < 1e-6] = 1.0\n        Xs_tr = (X_tr - mu) / sd\n        Xs_va = (X_va - mu) / sd\n        \n        model = Ridge(alpha=alpha, fit_intercept=True)\n        model.fit(Xs_tr, y_tr)\n        pred = model.predict(Xs_va)\n        \n        # R2\n        ss_res = np.sum((y_va - pred)**2)\n        ss_tot = np.sum((y_va - y_tr.mean())**2)\n        r2 = 1 - ss_res / ss_tot if ss_tot > 0 else 0\n        fold_r2.append(r2)\n        \n        # If we correct with this, how much does overall MAE improve?\n        # Apply sample bias correction to val samples\n        # new_residual = residual - predicted_bias\n        # MAE improvement = |residual| - |residual - predicted_bias|\n    print(f'  alpha={alpha:6.1f}: mean R2={np.mean(fold_r2):.4f}')\n\n# Also try per-horizon sample bias\nprint('\\\\nPer-horizon sample bias prediction (h=0):')\nh = 0\nsample_bias_h = np.zeros(n_samples)\nfor s in range(n_samples):\n    m = mask[s, h, :]\n    sample_bias_h[s] = residual[s, h, :][m].mean()\nprint(f'  h={h}: sample bias std={sample_bias_h.std():.4f}')\n\nfor alpha in [0.1, 1.0, 10.0, 100.0]:\n    fold_r2 = []\n    for train_idx, val_idx in kf.split(range(n_samples)):\n        X_tr = X_sample[train_idx]\n        y_tr = sample_bias_h[train_idx]\n        X_va = X_sample[val_idx]\n        y_va = sample_bias_h[val_idx]\n        \n        mu = X_tr.mean(axis=0)\n        sd = X_tr.std(axis=0)\n        sd[sd < 1e-6] = 1.0\n        Xs_tr = (X_tr - mu) / sd\n        Xs_va = (X_va - mu) / sd\n        \n        model = Ridge(alpha=alpha, fit_intercept=True)\n        model.fit(Xs_tr, y_tr)\n        pred = model.predict(Xs_va)\n        \n        ss_res = np.sum((y_va - pred)**2)\n        ss_tot = np.sum((y_va - y_tr.mean())**2)\n        r2 = 1 - ss_res / ss_tot if ss_tot > 0 else 0\n        fold_r2.append(r2)\n    print(f'  alpha={alpha:6.1f}: mean R2={np.mean(fold_r2):.4f}')\n\n# What if we add per-horizon base mean features?\nsample_feat_v2 = []\nfor h in range(0, 12, 3):  # every 3rd horizon\n    sample_feat_v2.append(base[:, h, :].mean(axis=1))\n    sample_feat_v2.append(history[:, min(h, 11), :].mean(axis=1))\nsample_feat_v2.append(X_sample)  # add all previous features\nX_sample_v2 = np.column_stack(sample_feat_v2)\nprint(f'\\\\nX_sample_v2 shape: {X_sample_v2.shape}')\n\nfor alpha in [1.0, 10.0, 100.0]:\n    fold_r2 = []\n    for train_idx, val_idx in kf.split(range(n_samples)):\n        X_tr = X_sample_v2[train_idx]\n        y_tr = sample_bias[train_idx]\n        X_va = X_sample_v2[val_idx]\n        y_va = sample_bias[val_idx]\n        \n        mu = X_tr.mean(axis=0)\n        sd = X_tr.std(axis=0)\n        sd[sd < 1e-6] = 1.0\n        Xs_tr = (X_tr - mu) / sd\n        Xs_va = (X_va - mu) / sd\n        \n        model = Ridge(alpha=alpha, fit_intercept=True)\n        model.fit(Xs_tr, y_tr)\n        pred = model.predict(Xs_va)\n        \n        ss_res = np.sum((y_va - pred)**2)\n        ss_tot = np.sum((y_va - y_tr.mean())**2)\n        r2 = 1 - ss_res / ss_tot if ss_tot > 0 else 0\n        fold_r2.append(r2)\n    print(f'  alpha={alpha:6.1f}: mean R2={np.mean(fold_r2):.4f}')\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

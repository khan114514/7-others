{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np\nfrom sklearn.linear_model import Ridge\nfrom sklearn.model_selection import KFold\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_targ = np.load('/workspace/public_assets/train_targets.npz')\n\ntargets = train_targ['target'].astype(np.float64)\nbase = train_feat['base'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\n\nn_samples, n_horizons, n_nodes = base.shape\nmask = np.isfinite(targets) & (targets > 0)\n\n# Load current method and get its residuals\nimport sys\nsys.path.insert(0, '/workspace/solution')\nfrom method import fit, predict\n\nfeatures_dict = {'base': base, 'anchor': anchor, 'history': history, 'clock': clock}\nstate = fit(features_dict, targets, 42)\npreds = predict(state, features_dict)\nresidual = preds - targets\nprint(f'Current method in-sample MAE: {np.abs(residual[mask]).mean():.4f}')\n\n# Now let's build a better per-node residual model\n# For each node, we have 74 samples x 12 horizons = 888 observations\n# With only 74 samples, per-node models will overfit\n# \n# Better approach: pooled model across all nodes with node embeddings\n# and richer features including interactions\n\ndef build_pooled_features(base, anchor, history, clock, h_start=0, h_end=None):\n    '''Build pooled features for all nodes and samples across horizons.\n    Returns X: (n_samples * n_horizons * n_nodes, n_feat)\n    '''\n    if h_end is None:\n        h_end = n_horizons\n    n_h = h_end - h_start\n    n_s = base.shape[0]\n    n_n = base.shape[2]\n    \n    X_list = []\n    \n    for h_idx in range(h_start, h_end):\n        h = h_idx - h_start\n        feat_h = []\n        \n        # Base value\n        feat_h.append(base[:, h_idx, :].reshape(-1, 1))\n        # Anchor value\n        feat_h.append(anchor[:, h_idx, :].reshape(-1, 1))\n        # Base - anchor\n        feat_h.append((base[:, h_idx, :] - anchor[:, h_idx, :]).reshape(-1, 1))\n        # History last\n        feat_h.append(history[:, -1, :].reshape(-1, 1))\n        # History mean\n        feat_h.append(history.mean(axis=1).reshape(-1, 1))\n        # History trend  \n        feat_h.append((history[:, -1, :] - history[:, 0, :]).reshape(-1, 1) / 12.0)\n        # History std\n        feat_h.append(history.std(axis=1).reshape(-1, 1))\n        # base - history_last\n        feat_h.append((base[:, h_idx, :] - history[:, -1, :]).reshape(-1, 1))\n        # base - history_mean\n        feat_h.append((base[:, h_idx, :] - history.mean(axis=1)).reshape(-1, 1))\n        \n        # Time features\n        tod = clock[:, h_idx, 0]  # (n_s,)\n        feat_h.append(np.tile(np.sin(2*np.pi*tod)[:, np.newaxis], (1, n_n)).reshape(-1, 1))\n        feat_h.append(np.tile(np.cos(2*np.pi*tod)[:, np.newaxis], (1, n_n)).reshape(-1, 1))\n        feat_h.append(np.tile(np.sin(4*np.pi*tod)[:, np.newaxis], (1, n_n)).reshape(-1, 1))\n        feat_h.append(np.tile(np.cos(4*np.pi*tod)[:, np.newaxis], (1, n_n)).reshape(-1, 1))\n        \n        # Node index features\n        node_idx = np.tile(np.arange(n_n), (n_s, 1)).reshape(-1, 1)\n        feat_h.append(np.sin(2 * np.pi * node_idx / n_n))\n        feat_h.append(np.cos(2 * np.pi * node_idx / n_n))\n        feat_h.append(np.sin(4 * np.pi * node_idx / n_n))\n        feat_h.append(np.cos(4 * np.pi * node_idx / n_n))\n        feat_h.append(np.sin(6 * np.pi * node_idx / n_n))\n        feat_h.append(np.cos(6 * np.pi * node_idx / n_n))\n        \n        # Interactions: base * tod\n        feat_h.append((base[:, h_idx, :] * np.tile(np.sin(2*np.pi*tod)[:, np.newaxis], (1, n_n))).reshape(-1, 1))\n        feat_h.append((base[:, h_idx, :] * np.tile(np.cos(2*np.pi*tod)[:, np.newaxis], (1, n_n))).reshape(-1, 1))\n        \n        # Horizon index\n        feat_h.append(np.full((n_s * n_n, 1), h_idx / n_horizons))\n        \n        X_h = np.hstack(feat_h)\n        X_list.append(X_h)\n    \n    X = np.vstack(X_list)  # (n_s * n_h * n_n, n_feat)\n    return X\n\n# Build target\ny_all = targets[:, :, :].reshape(-1)\nmask_all = mask[:, :, :].reshape(-1)\nbase_all = base[:, :, :].reshape(-1)\n\n# Test ridge model predicting target directly\nprint('\\\\n=== Ridge model: predicting target directly (all horizons pooled) ===')\nX_all = build_pooled_features(base, anchor, history, clock)\nprint(f'X shape: {X_all.shape}')\n\nkf = KFold(n_splits=5, shuffle=True, random_state=42)\n\n# Sample-wise CV: don't let same sample appear in train and val\nfor alpha in [10.0, 100.0, 1000.0, 10000.0]:\n    fold_maes = []\n    for train_idx, val_idx in kf.split(range(n_samples)):\n        # Build masks\n        train_mask = np.zeros((n_samples, n_horizons, n_nodes), dtype=bool)\n        val_mask = np.zeros_like(train_mask)\n        train_mask[train_idx] = mask[train_idx]\n        val_mask[val_idx] = mask[val_idx]\n        train_m = train_mask.reshape(-1)\n        val_m = val_mask.reshape(-1)\n        \n        X_train = X_all[train_m]\n        y_train = y_all[train_m]\n        X_val = X_all[val_m]\n        y_val = y_all[val_m]\n        \n        mu = X_train.mean(axis=0)\n        sd = X_train.std(axis=0)\n        sd[sd < 1e-6] = 1.0\n        Xs_train = (X_train - mu) / sd\n        Xs_val = (X_val - mu) / sd\n        \n        model = Ridge(alpha=alpha, fit_intercept=True)\n        model.fit(Xs_train, y_train)\n        preds_val = model.predict(Xs_val)\n        preds_val = np.maximum(preds_val, 0.0)\n        \n        fold_mae = np.abs(preds_val - y_val).mean()\n        fold_maes.append(fold_mae)\n    \n    print(f'  alpha={alpha:8.1f}: CV MAE={np.mean(fold_maes):.4f} (base=14.9934, current_method_cv=14.2731)')\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

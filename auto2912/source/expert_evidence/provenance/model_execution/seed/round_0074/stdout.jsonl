{"type":"item.started","item":{"id":"item_52","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np\nfrom sklearn.linear_model import Ridge\nfrom sklearn.model_selection import KFold\nimport sys\nsys.path.insert(0, '/workspace/solution')\nfrom method import fit, predict\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_targ = np.load('/workspace/public_assets/train_targets.npz')\n\ntargets = train_targ['target'].astype(np.float64)\nbase = train_feat['base'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\n\nn_samples, n_horizons, n_nodes = base.shape\nmask = np.isfinite(targets) & (targets > 0)\n\nfeatures_dict = {'base': base, 'anchor': anchor, 'history': history, 'clock': clock}\nstate = fit(features_dict, targets, 42)\npreds = predict(state, features_dict)\nresidual = preds - targets\nprint(f'Current method in-sample: {np.abs(residual[mask]).mean():.4f}')\n\n# NEW IDEA: Per-node TOD-aware bias correction\n# For each node, the bias depends on time-of-day\n# Model: bias_node(tod) = node_bias + node_tod_coeffs * fourier_basis(tod)\n# With only 74 samples per node, we need heavy regularization\n# \n# Alternative: Pooled model across nodes with node interactions\n# bias(sample, h, node) = sum_k node_specific_coeff[k] * fourier_k(tod(sample, h))\n#\n# Better approach: Use a low-rank model\n# bias(node, tod) = V[node, :] @ F[tod, :].T  (low-rank factorization)\n# But this is complicated.\n\n# Simpler: For each node, fit a Ridge regression of residual on TOD features\n# 74 samples * 12 horizons = 888 obs per node\n# Features: intercept, sin(2*pi*tod), cos(2*pi*tod), sin(4*pi*tod), cos(4*pi*tod)\n# Plus horizon index\n# That's 6 features per node, 888 obs - should be reasonable\n\nprint('\\\\n=== Per-node TOD-aware residual ridge ===')\ndef per_node_tod_ridge(residual, mask, clock, alpha=100.0):\n    '''Fit per-node Ridge model of residual on TOD+horizon features.\n    Returns per-node model parameters.\n    '''\n    models = []\n    for n in range(n_nodes):\n        # Collect all valid (sample, horizon) pairs for this node\n        samples = []\n        feats = []\n        ys = []\n        for s in range(n_samples):\n            for h in range(n_horizons):\n                if mask[s, h, n]:\n                    tod = clock[s, h, 0]\n                    feat = [\n                        1.0,  # intercept\n                        np.sin(2*np.pi*tod),\n                        np.cos(2*np.pi*tod),\n                        np.sin(4*np.pi*tod),\n                        np.cos(4*np.pi*tod),\n                        h / 12.0,  # normalized horizon\n                    ]\n                    feats.append(feat)\n                    ys.append(residual[s, h, n])\n        \n        if len(ys) < 20:\n            models.append(None)\n            continue\n        \n        X = np.array(feats)\n        y = np.array(ys)\n        \n        model = Ridge(alpha=alpha, fit_intercept=False)  # intercept is in features\n        model.fit(X, y)\n        models.append(model.coef_)\n    \n    return models\n\ndef apply_per_node_tod(models, base_preds, clock, shrink=1.0):\n    result = base_preds.copy()\n    for n in range(n_nodes):\n        if models[n] is None:\n            continue\n        coef = models[n]\n        for s in range(n_samples):\n            for h in range(n_horizons):\n                tod = clock[s, h, 0]\n                feat = np.array([\n                    1.0,\n                    np.sin(2*np.pi*tod),\n                    np.cos(2*np.pi*tod),\n                    np.sin(4*np.pi*tod),\n                    np.cos(4*np.pi*tod),\n                    h / 12.0,\n                ])\n                bias_pred = feat @ coef\n                result[s, h, n] -= shrink * bias_pred\n    return result\n\n# In-sample test\nmodels = per_node_tod_ridge(residual, mask, clock, alpha=100.0)\ncorrected = apply_per_node_tod(models, preds, clock, shrink=1.0)\ncorrected = np.maximum(corrected, 0.0)\nprint(f'In-sample (alpha=100, shrink=1.0): {np.abs(corrected[mask]-targets[mask]).mean():.4f}')\n\n# CV test\nkf = KFold(n_splits=5, shuffle=True, random_state=42)\nfor alpha in [10.0, 50.0, 100.0, 500.0, 1000.0]:\n    for shrink in [0.1, 0.2, 0.3, 0.5]:\n        fold_maes = []\n        for train_idx, val_idx in kf.split(range(n_samples)):\n            tf = {k: v[train_idx] for k, v in features_dict.items()}\n            state_tr = fit(tf, targets[train_idx], 42)\n            p_tr = predict(state_tr, tf)\n            r_tr = p_tr - targets[train_idx]\n            m_tr = mask[train_idx]\n            \n            # Fit per-node TOD ridge on train\n            # We need to compute it only for training samples\n            # But the function expects full arrays - let's adapt\n            # Actually just use training subset\n            n_train = len(train_idx)\n            r_train_3d = np.zeros((n_train, n_horizons, n_nodes))\n            m_train_3d = np.zeros_like(r_train_3d, dtype=bool)\n            c_train_3d = np.zeros((n_train, n_horizons, n_nodes))\n            for i, idx in enumerate(train_idx):\n                r_train_3d[i] = r_tr[i]\n                m_train_3d[i] = m_tr[i]\n                c_train_3d[i] = clock[idx]\n            \n            # Just use standard approach: fit on train residuals\n            # Using a simplified version\n            train_models = []\n            for n in range(n_nodes):\n                feats = []\n                ys = []\n                for i in range(n_train):\n                    for h in range(n_horizons):\n                        if m_train_3d[i, h, n]:\n                            tod = c_train_3d[i, h, 0]\n                            feat = [\n                                1.0,\n                                np.sin(2*np.pi*tod),\n                                np.cos(2*np.pi*tod),\n                                np.sin(4*np.pi*tod),\n                                np.cos(4*np.pi*tod),\n                                h / 12.0,\n                            ]\n                            feats.append(feat)\n                            ys.append(r_train_3d[i, h, n])\n                \n                if len(ys) < 20:\n                    train_models.append(None)\n                    continue\n                \n                X = np.array(feats)\n                y = np.array(ys)\n                model = Ridge(alpha=alpha, fit_intercept=False)\n                model.fit(X, y)\n                train_models.append(model.coef_)\n            \n            # Apply to validation\n            vf = {k: v[val_idx] for k, v in features_dict.items()}\n            p_val = predict(state_tr, vf)\n            n_val = len(val_idx)\n            \n            # Apply correction\n            for n in range(n_nodes):\n                if train_models[n] is None:\n                    continue\n                coef = train_models[n]\n                for i in range(n_val):\n                    for h in range(n_horizons):\n                        tod = vf['clock'][i, h, 0]\n                        feat = np.array([\n                            1.0,\n                            np.sin(2*np.pi*tod),\n                            np.cos(2*np.pi*tod),\n                            np.sin(4*np.pi*tod),\n                            np.cos(4*np.pi*tod),\n                            h / 12.0,\n                        ])\n                        bias_pred = feat @ coef\n                        p_val[i, h, n] -= shrink * bias_pred\n            \n            p_val = np.maximum(p_val, 0.0)\n            m_val = mask[val_idx]\n            fold_maes.append(np.abs(p_val[m_val] - targets[val_idx][m_val]).mean())\n        \n        cv_mae = np.mean(fold_maes)\n        if alpha == 100.0 and shrink in [0.1, 0.2, 0.3, 0.5]:\n            print(f'  alpha={alpha:6.1f}, shrink={shrink:.2f}: CV={cv_mae:.4f}')\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

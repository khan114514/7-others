{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np\nfrom sklearn.model_selection import KFold\nimport sys\nsys.path.insert(0, '/workspace/solution')\nfrom method import fit, predict\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_targ = np.load('/workspace/public_assets/train_targets.npz')\n\ntargets = train_targ['target'].astype(np.float64)\nbase = train_feat['base'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\n\nn_samples, n_horizons, n_nodes = base.shape\nmask = np.isfinite(targets) & (targets > 0)\n\n# Get in-sample predictions and analyze residuals\ntrain_features_dict = {\n    'base': base, 'anchor': anchor, 'history': history, 'clock': clock,\n}\nstate = fit(train_features_dict, targets, 42)\npreds = predict(state, train_features_dict)\nresidual = preds - targets\n\nprint('In-sample analysis of current method:')\nprint(f'  In-sample MAE: {np.abs(residual[mask]).mean():.4f}')\nprint(f'  In-sample bias: {residual[mask].mean():.4f}')\n\n# Per-horizon analysis of residual\nprint('\\\\nPer-horizon residual MAE:')\nfor h in range(n_horizons):\n    m = mask[:, h, :]\n    print(f'  h={h:2d}: MAE={np.abs(residual[:,h,:][m]).mean():.4f}, bias={residual[:,h,:][m].mean():.4f}')\n\n# Can we predict residuals from features?\n# Check correlation of residual with various features at h=0\nh = 0\nm = mask[:, h, :]\nprint(f'\\\\nResidual correlations (h={h}):')\nprint(f'  vs base value: {np.corrcoef(residual[:,h,:][m], base[:,h,:][m])[0,1]:.4f}')\nprint(f'  vs anchor: {np.corrcoef(residual[:,h,:][m], anchor[:,h,:][m])[0,1]:.4f}')\nprint(f'  vs history last: {np.corrcoef(residual[:,h,:][m], history[:,-1,:][m])[0,1]:.4f}')\nprint(f'  vs (base - history_last): {np.corrcoef(residual[:,h,:][m], (base[:,h,:]-history[:,-1,:])[m])[0,1]:.4f}')\nprint(f'  vs (base - anchor): {np.corrcoef(residual[:,h,:][m], (base[:,h,:]-anchor[:,h,:])[m])[0,1]:.4f}')\nprint(f'  vs history mean: {np.corrcoef(residual[:,h,:][m], history.mean(axis=1)[m[:,0,:].flatten()])[0,1]:.4f}')\nprint(f'  vs history trend: {np.corrcoef(residual[:,h,:][m], (history[:,-1,:]-history[:,0,:])[m])[0,1]:.4f}')\n\n# Per-node residual structure\nprint('\\\\nPer-node residual bias stats:')\nnode_res_bias = np.zeros(n_nodes)\nfor n in range(n_nodes):\n    m = mask[:, :, n]\n    if m.sum() > 0:\n        node_res_bias[n] = residual[:, :, n][m].mean()\nprint(f'  std of per-node residual bias: {node_res_bias.std():.4f}')\nprint(f'  range: [{node_res_bias.min():.3f}, {node_res_bias.max():.3f}]')\n\n# If we could further shrink per-node bias...\ncorrected = preds - node_res_bias[np.newaxis, np.newaxis, :] * 0.3\nprint(f'  residual MAE after 0.3 * per-node residual bias: {np.abs(corrected[mask]-targets[mask]).mean():.4f}')\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

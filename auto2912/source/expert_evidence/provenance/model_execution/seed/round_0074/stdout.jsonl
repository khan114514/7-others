{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np\nfrom sklearn.linear_model import Ridge, Lasso\nfrom sklearn.model_selection import KFold\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_targ = np.load('/workspace/public_assets/train_targets.npz')\n\ntargets = train_targ['target'].astype(np.float64)\nbase = train_feat['base'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\n\nn_samples, n_horizons, n_nodes = base.shape\nmask = np.isfinite(targets) & (targets > 0)\n\nprint(f'Base MAE: {np.abs(base[mask] - targets[mask]).mean():.4f}')\nprint(f'Anchor MAE: {np.abs(anchor[mask] - targets[mask]).mean():.4f}')\n\n# History is same shape as base (74, 12, 170)\n# History step 0 is earliest, step 11 is most recent\nprint(f'\\\\nHistory shape: {history.shape}')\nprint(f'History last step MAE vs target[:,0,:]: {np.abs(history[:, -1, :][mask[:,0,:]] - targets[:, 0, :][mask[:,0,:]]).mean():.4f}')\n\n# Check if history last step is like a persistence forecast\n# history[:, -1, :] is the last observed value before the forecast window\nprint(f'History last (t=-1) vs target h=0: {np.abs(history[:, -1, :] - targets[:, 0, :])[mask[:,0,:]].mean():.4f}')\nprint(f'History h=0 (t=-12) vs target h=0: {np.abs(history[:, 0, :] - targets[:, 0, :])[mask[:,0,:]].mean():.4f}')\n\n# Clock structure - same across nodes?\nprint(f'\\\\nClock same across nodes: {np.allclose(clock[:, :, 0:1], clock)}')\nprint(f'Clock[:,0,0] first 5 samples: {clock[:5, 0, 0]}')\n\n# What's the relationship between base/anchor/history/targets?\n# For each horizon, look at correlation of errors with features\nprint('\\\\nError correlations with features (h=0):')\nh = 0\nm = mask[:, h, :]\nerr = base[:, h, :][m] - targets[:, h, :][m]\nprint(f'  err vs anchor-base diff: {np.corrcoef(err, (anchor[:,h,:]-base[:,h,:])[m])[0,1]:.4f}')\nprint(f'  err vs history last: {np.corrcoef(err, history[:, -1, :][m])[0,1]:.4f}')\nprint(f'  err vs base value: {np.corrcoef(err, base[:,h,:][m])[0,1]:.4f}')\nprint(f'  err vs (history_last - base): {np.corrcoef(err, (history[:,-1,:]-base[:,h,:])[m])[0,1]:.4f}')\n\n# How about hour-of-day patterns?\nprint('\\\\nClock values (tod fraction):')\nprint(f'  unique values per horizon: {np.unique(clock[:,:,0]).shape}')\nprint(f'  clock[0,:,0]: {clock[0,:,0]}')\nprint(f'  clock[1,:,0]: {clock[1,:,0]}')\nprint(f'  clock[10,:,0]: {clock[10,:,0]}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_targ = np.load('/workspace/public_assets/train_targets.npz')\n\ntargets = train_targ['target'].astype(np.float64)\nbase = train_feat['base'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\n\nn_samples, n_horizons, n_nodes = base.shape\nmask = np.isfinite(targets) & (targets > 0)\n\n# Analyze the graph\ngraph = np.load('/workspace/public_assets/graph.npz')\nprint('Graph files:', graph.files)\nfor k in graph.files:\n    print(f'  {k}: shape={graph[k].shape}, dtype={graph[k].dtype}')\n\n# Look at adjacency\nif 'adjacency' in graph.files:\n    adj = graph['adjacency']\n    print(f'Adjacency nnz: {(adj > 0).sum()} / {adj.size} ({(adj>0).sum()/adj.size*100:.2f}%)')\n    print(f'Degrees: min={adj.sum(axis=0).min():.0f}, max={adj.sum(axis=0).max():.0f}, mean={adj.sum(axis=0).mean():.1f}')\n\n# Let's do proper cross-validation analysis of the current method\nfrom sklearn.model_selection import KFold\nimport sys\nsys.path.insert(0, '/workspace/solution')\nfrom method import fit, predict\n\ndef cv_mae(n_folds=5, seed=42):\n    kf = KFold(n_splits=n_folds, shuffle=True, random_state=seed)\n    maes = []\n    for train_idx, val_idx in kf.split(range(n_samples)):\n        train_feat_fold = {\n            'base': base[train_idx],\n            'anchor': anchor[train_idx],\n            'history': history[train_idx],\n            'clock': clock[train_idx],\n        }\n        train_targ_fold = targets[train_idx]\n        state = fit(train_feat_fold, train_targ_fold, seed)\n        \n        val_feat_fold = {\n            'base': base[val_idx],\n            'anchor': anchor[val_idx],\n            'history': history[val_idx],\n            'clock': clock[val_idx],\n        }\n        preds = predict(state, val_feat_fold)\n        val_mask = mask[val_idx]\n        mae = np.abs(preds[val_mask] - targets[val_idx][val_mask]).mean()\n        maes.append(mae)\n    return np.mean(maes), maes\n\ncv_mean, cv_maes = cv_mae(5, 42)\nprint(f'\\\\n5-fold CV MAE (current method): {cv_mean:.4f}')\nprint(f'  folds: {[f\\\\\\\"{m:.4f}\\\\\\\" for m in cv_maes]}')\nprint(f'  baseline (identity): 14.9934 (train) / 15.42 (dev)')\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

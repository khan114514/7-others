{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np\nfrom sklearn.linear_model import Ridge, Lasso, ElasticNet\nfrom sklearn.model_selection import KFold\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_targ = np.load('/workspace/public_assets/train_targets.npz')\n\ntargets = train_targ['target'].astype(np.float64)\nbase = train_feat['base'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\n\nn_samples, n_horizons, n_nodes = base.shape\nmask = np.isfinite(targets) & (targets > 0)\n\n# Key insight: with only 74 samples and 170 nodes, we need strong regularization\n# Let's try a different approach: build per-horizon Ridge models using all nodes together\n# with features that capture per-node, per-sample, and time-of-day structure\n\n# Approach: For each horizon h, build a Ridge model that predicts the target \n# using base, anchor, history features, and node/time embeddings\n# This gives a single model per horizon, trained across all nodes and samples\n\ndef build_horizon_features(h_idx):\n    '''Build features for horizon h across all samples and nodes.\n    Returns X: (n_samples * n_nodes, n_feat), y: (n_samples * n_nodes,), m: (n_samples * n_nodes,)\n    '''\n    X_list = []\n    \n    # Base forecast value (most important)\n    X_list.append(base[:, h_idx, :].reshape(-1, 1))\n    \n    # Anchor value\n    X_list.append(anchor[:, h_idx, :].reshape(-1, 1))\n    \n    # Base - anchor difference\n    X_list.append((base[:, h_idx, :] - anchor[:, h_idx, :]).reshape(-1, 1))\n    \n    # History last value\n    X_list.append(history[:, -1, :].reshape(-1, 1))\n    \n    # History mean\n    X_list.append(history.mean(axis=1).reshape(-1, 1))\n    \n    # History trend\n    hist_trend = (history[:, -1, :] - history[:, 0, :]) / 12.0\n    X_list.append(hist_trend.reshape(-1, 1))\n    \n    # Base - history_last (recent error proxy)\n    X_list.append((base[:, h_idx, :] - history[:, -1, :]).reshape(-1, 1))\n    \n    # History std\n    X_list.append(history.std(axis=1).reshape(-1, 1))\n    \n    # Clock features (same for all nodes at a given sample)\n    tod = clock[:, h_idx, 0]  # (n_samples,)\n    X_list.append(np.tile(np.sin(2*np.pi*tod)[:, np.newaxis], (1, n_nodes)).reshape(-1, 1))\n    X_list.append(np.tile(np.cos(2*np.pi*tod)[:, np.newaxis], (1, n_nodes)).reshape(-1, 1))\n    X_list.append(np.tile(np.sin(4*np.pi*tod)[:, np.newaxis], (1, n_nodes)).reshape(-1, 1))\n    X_list.append(np.tile(np.cos(4*np.pi*tod)[:, np.newaxis], (1, n_nodes)).reshape(-1, 1))\n    \n    # Node index embeddings (periodic)\n    node_idx = np.tile(np.arange(n_nodes), (n_samples, 1)).reshape(-1, 1)\n    X_list.append(np.sin(2 * np.pi * node_idx / n_nodes))\n    X_list.append(np.cos(2 * np.pi * node_idx / n_nodes))\n    X_list.append(np.sin(4 * np.pi * node_idx / n_nodes))\n    X_list.append(np.cos(4 * np.pi * node_idx / n_nodes))\n    \n    # Interaction: base * tod\n    X_list.append((base[:, h_idx, :] * np.tile(np.sin(2*np.pi*tod)[:, np.newaxis], (1, n_nodes))).reshape(-1, 1))\n    X_list.append((base[:, h_idx, :] * np.tile(np.cos(2*np.pi*tod)[:, np.newaxis], (1, n_nodes))).reshape(-1, 1))\n    \n    X = np.hstack(X_list)\n    y = targets[:, h_idx, :].reshape(-1)\n    m = mask[:, h_idx, :].reshape(-1)\n    return X, y, m\n\n# Cross-validate per-horizon ridge\nprint('=== Per-horizon Ridge (all nodes pooled) ===')\nkf = KFold(n_splits=5, shuffle=True, random_state=42)\n\nfor alpha in [1.0, 10.0, 100.0, 1000.0]:\n    fold_maes = []\n    for train_idx, val_idx in kf.split(range(n_samples)):\n        total_ae = 0\n        total_n = 0\n        for h in range(n_horizons):\n            X, y, m = build_horizon_features(h)\n            # train on train_idx samples\n            train_mask = m.copy()\n            # reshape m to (n_samples, n_nodes) to filter by sample\n            m_2d = m.reshape(n_samples, n_nodes)\n            train_m_2d = m_2d.copy()\n            val_m_2d = m_2d.copy()\n            train_m_2d[val_idx, :] = False  # remove val samples\n            val_m_2d[train_idx, :] = False  # remove train samples\n            \n            train_m = train_m_2d.reshape(-1)\n            val_m = val_m_2d.reshape(-1)\n            \n            if train_m.sum() < 10:\n                continue\n                \n            X_train = X[train_m]\n            y_train = y[train_m]\n            \n            # standardize\n            mu = X_train.mean(axis=0)\n            sd = X_train.std(axis=0)\n            sd[sd < 1e-6] = 1.0\n            Xs_train = (X_train - mu) / sd\n            \n            model = Ridge(alpha=alpha, fit_intercept=True)\n            model.fit(Xs_train, y_train)\n            \n            X_val = X[val_m]\n            y_val = y[val_m]\n            Xs_val = (X_val - mu) / sd\n            preds = model.predict(Xs_val)\n            \n            total_ae += np.abs(preds - y_val).sum()\n            total_n += len(y_val)\n        \n        fold_mae = total_ae / total_n if total_n > 0 else float('inf')\n        fold_maes.append(fold_mae)\n    \n    print(f'  alpha={alpha:8.1f}: CV MAE={np.mean(fold_maes):.4f} (folds: {[f\\\\\\\"{m:.3f}\\\\\\\" for m in fold_maes]})')\n\nprint(f'  baseline (identity): train MAE=14.9934')\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

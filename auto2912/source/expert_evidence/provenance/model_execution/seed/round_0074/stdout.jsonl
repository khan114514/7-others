{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np\nfrom sklearn.linear_model import Ridge\nfrom sklearn.model_selection import KFold\nimport sys\nsys.path.insert(0, '/workspace/solution')\nfrom method import fit, predict, _build_sample_feats, _build_node_feats\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_targ = np.load('/workspace/public_assets/train_targets.npz')\n\ntargets = train_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_targ = np.load('/workspace/public_assets/train_targets.npz')\n\ntargets = train_targ['target'].astype(np.float64)\nbase = train_feat['base'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\n\nn_samples, n_horizons, n_nodes = base.shape\nmask = np.isfinite(targets) & (targets > 0)\n\nfeatures_dict = {'base': base, 'anchor': anchor, 'history': history, 'clock': clock}\nstate = fit(features_dict, targets, 42)\npreds = predict(state, features_dict)\nresidual = preds - targets\nprint(f'Current method in-sample MAE: {np.abs(residual[mask]).mean():.4f}')\n\n# Let's test: can we improve the per-node-horizon ridge correction?\n# Currently it uses per-horizon ridge with node features\n# Let's try adding more features and tuning alpha/shrinkage\n\n# First, let's do proper CV of the ridge correction step alone\n# to see how much it contributes\nprint('\\\\n=== CV analysis of ridge correction contribution ===')\nkf = KFold(n_splits=5, shuffle=True, random_state=42)\n\n# Use the _build_node_feats from current method\nhist_last = history[:, -1, :]\nhist_avg = history.mean(axis=1)\nhist_trend = (history[:, -1, :] - history[:, 0, :]) / 12.0\n\n# For each horizon, build features and see how well Ridge predicts residual\nfold_maes_no_ridge = []\nfold_maes_with_ridge = []\n\nfor train_idx, val_idx in kf.split(range(n_samples)):\n    tf = {'base': base[train_idx], 'anchor': anchor[train_idx], \n          'history': history[train_idx], 'clock': clock[train_idx]}\n    state_tr = fit(tf, targets[train_idx], 42)\n    \n    vf = {'base': base[val_idx], 'anchor': anchor[val_idx], \n          'history': history[val_idx], 'clock': clock[val_idx]}\n    p_val = predict(state_tr, vf)\n    m_val = mask[val_idx]\n    mae_no_ridge = np.abs(p_val[m_val] - targets[val_idx][m_val]).mean()\n    fold_maes_no_ridge.append(mae_no_ridge)\n    \n    # Now add extra ridge correction trained on validation residuals\n    # (this is cheating in-sample, but shows potential)\n    # Actually let's do it properly: train ridge on train residuals, apply to val\n    # The current method already includes ridge, so this is the full method\n    fold_maes_with_ridge.append(mae_no_ridge)  # same thing\n\nprint(f'Full method CV MAE: {np.mean(fold_maes_no_ridge):.4f}')\nprint(f'Folds: {[f\\\\\\\"{m:.4f}\\\\\\\" for m in fold_maes_no_ridge]}')\n\n# Let's try to add a SECOND round of ridge with different features\n# Idea: residual of residual - there might be remaining structure\n# Let's test what fraction of residual variance is explainable\n\nprint('\\\\n=== Residual variance analysis ===')\n# Overall residual variance\nprint(f'Residual std: {residual[mask].std():.4f}')\nprint(f'Residual MAE: {np.abs(residual[mask]).mean():.4f}')\n\n# Per-horizon\nfor h in range(n_horizons):\n    m = mask[:, h, :]\n    r = residual[:, h, :][m]\n    print(f'  h={h:2d}: MAE={np.abs(r).mean():.4f}, std={r.std():.4f}')\n\n# Can we predict residual with a better model?\n# Let's try adding per-sample features as additional node-level features\n# i.e., features that are same for all nodes but vary by sample\n\n# Let's build a richer feature set per (sample, horizon, node)\ndef build_rich_features(h_idx, base_h, anchor_h, hist_last, hist_avg, hist_trend, \n                         hist_std, clock_h, n_nodes, n_samples):\n    '''Rich feature set for per-node residual prediction.'''\n    node_idx = np.tile(np.arange(n_nodes), (n_samples, 1)).reshape(-1, 1)\n    tod_sin = np.sin(2 * np.pi * clock_h)  # (n_samples,)\n    tod_cos = np.cos(2 * np.pi * clock_h)\n    tod_sin2 = np.sin(4 * np.pi * clock_h)\n    tod_cos2 = np.cos(4 * np.pi * clock_h)\n    \n    X = np.hstack([\n        base_h.reshape(-1, 1),\n        anchor_h.reshape(-1, 1),\n        (base_h - anchor_h).reshape(-1, 1),\n        hist_last.reshape(-1, 1),\n        hist_avg.reshape(-1, 1),\n        hist_trend.reshape(-1, 1),\n        hist_std.reshape(-1, 1),\n        (hist_last - base_h).reshape(-1, 1),\n        (hist_avg - base_h).reshape(-1, 1),\n        (hist_last - anchor_h).reshape(-1, 1),\n        # tod repeated\n        np.repeat(tod_sin, n_nodes).reshape(-1, 1),\n        np.repeat(tod_cos, n_nodes).reshape(-1, 1),\n        np.repeat(tod_sin2, n_nodes).reshape(-1, 1),\n        np.repeat(tod_cos2, n_nodes).reshape(-1, 1),\n        # node embeddings\n        np.sin(2 * np.pi * node_idx / n_nodes),\n        np.cos(2 * np.pi * node_idx / n_nodes),\n        np.sin(4 * np.pi * node_idx / n_nodes),\n        np.cos(4 * np.pi * node_idx / n_nodes),\n        np.sin(6 * np.pi * node_idx / n_nodes),\n        np.cos(6 * np.pi * node_idx / n_nodes),\n        # interactions: base * node (captures per-node scaling)\n        base_h.reshape(-1, 1) * np.sin(2 * np.pi * node_idx / n_nodes),\n        base_h.reshape(-1, 1) * np.cos(2 * np.pi * node_idx / n_nodes),\n        # interactions: base * tod\n        base_h.reshape(-1, 1) * np.repeat(tod_sin, n_nodes).reshape(-1, 1),\n        base_h.reshape(-1, 1) * np.repeat(tod_cos, n_nodes).reshape(-1, 1),\n        # horizon\n        np.full((n_samples * n_nodes, 1), h_idx / 12.0),\n    ])\n    return X\n\n# Test richer ridge per-horizon\nhist_std = history.std(axis=1)\nprint('\\\\n=== Richer per-horizon ridge on residual (in-sample check) ===')\nfor alpha in [10.0, 100.0, 1000.0]:\n    total_ae = 0\n    total_n = 0\n    for h in range(n_horizons):\n        m = mask[:, h, :]\n        r = residual[:, h, :][m].flatten()\n        if len(r) < 100:\n            continue\n        X = build_rich_features(h, base[:, h, :], anchor[:, h, :], \n                                hist_last, hist_avg, hist_trend, hist_std,\n                                clock[:, h, 0], n_nodes, n_samples)\n        X_valid = X[m.flatten()]\n        mu = X_valid.mean(axis=0)\n        sd = X_valid.std(axis=0)\n        sd[sd < 1e-6] = 1.0\n        Xs = (X_valid - mu) / sd\n        model = Ridge(alpha=alpha, fit_intercept=True)\n        model.fit(Xs, r)\n        pred_r = model.predict(Xs)\n        # Try shrink=0.5\n        new_resid = r - 0.5 * pred_r\n        total_ae += np.abs(new_resid).sum()\n        total_n += len(r)\n    print(f'  alpha={alpha:8.1f}: in-sample residual MAE after 0.5*ridge = {total_ae/total_n:.4f}')\n\nprint(f'  baseline residual MAE: {np.abs(residual[mask]).mean():.4f}')\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/sh -lc \"python3 << 'EOF'\nimport numpy as np\nfrom sklearn.linear_model import Ridge\nfrom sklearn.model_selection import KFold\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_targ = np.load('/workspace/public_assets/train_targets.npz')\n\nbase = train_feat['base'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\ntarget = train_targ['target'].astype(np.float64)\n\nn_s, n_h, n_n = base.shape\nmask = np.isfinite(target) & (target > 0)\nkf = KFold(n_splits=5, shuffle=True, random_state=42)\n\n# =============================================\n# IDEA 1: History-based local level correction\n# The forecast base might be biased. If we know the last observation (history[:,-1,:]),\n# we can compute the \\\"level shift\\\" and apply it.\n# =============================================\nprint(\\\"=== Idea 1: History-based level correction ===\\\")\nhist_last = history[:, -1, :]  # (74, 170)\n\n# What's the relationship between base[h] - hist_last and target[h] - hist_last?\n# If base underestimates, target might too\n# Try: pred = base + beta * (hist_last - base[0])  -- but careful with horizons\n\n# Simple test: per-node per-horizon optimal blending between base and hist_last\n# This is like saying \\\"the forecast should be pulled toward the last known value\\\"\nfor h in [0, 3, 6, 9, 11]:\n    m = mask[:, h, :]\n    base_mae = np.abs(base[:,h,:][m] - target[:,h,:][m]).mean()\n    best_mae = base_mae\n    best_a = 0\n    for alpha in np.linspace(-0.3, 0.5, 41):\n        pred = base[:,h,:] + alpha * (hist_last - base[:,0,:])\n        mae = np.abs(pred[m] - target[:,h,:][m]).mean()\n        if mae < best_mae:\n            best_mae = mae\n            best_a = alpha\n    print(f\\\"  h={h:2d}: base={base_mae:.3f}, best_alpha={best_a:.2f}, best_mae={best_mae:.3f}\\\")\n\n# =============================================\n# IDEA 2: Per-sample adaptive bias using history \n# If history levels are high/low, bias might differ\n# =============================================\nprint(\\\"\\\\n=== Idea 2: Per-sample bias from history level (ridge) ===\\\")\n# Build per-sample features: hist_last mean, hist_mean, hist_trend, hist_std, base mean\n# Fit a ridge model to predict per-sample per-horizon mean bias\n\ndef sample_mae_improvement(base_pred, target_pred, mask_pred):\n    \\\"\\\"\\\"Compute MAE.\\\"\\\"\\\"\n    return np.abs(base_pred[mask_pred] - target_pred[mask_pred]).mean()\n\n# Compute per-sample per-horizon bias (mean over nodes)\nsample_bias = np.zeros((n_s, n_h))\nfor s in range(n_s):\n    for h in range(n_h):\n        m = mask[s, h, :]\n        if m.sum() > 10:\n            sample_bias[s, h] = np.mean(base[s, h, :][m] - target[s, h, :][m])\n\n# Features for sample-level prediction\nhist_last_mean = hist_last.mean(axis=1)\nhist_mean = history.mean(axis=(1,2))\nhist_trend = (history[:, -1, :] - history[:, 0, :]).mean(axis=1) / 12.0\nhist_std = history.std(axis=(1,2))\nbase_h_mean = base.mean(axis=2)  # (74, 12)\nclock_h = clock[:, :, 0]  # (74, 12)\n\n# Build features for each horizon\nfor h in [0, 3, 6, 9, 11]:\n    X = np.column_stack([\n        hist_last_mean,\n        hist_mean,\n        hist_trend,\n        hist_std,\n        base_h_mean[:, h],\n        np.sin(2*np.pi*clock_h[:, h]),\n        np.cos(2*np.pi*clock_h[:, h]),\n        np.sin(4*np.pi*clock_h[:, h]),\n        np.cos(4*np.pi*clock_h[:, h]),\n        hist_last_mean * np.sin(2*np.pi*clock_h[:, h]),\n        hist_last_mean * np.cos(2*np.pi*clock_h[:, h]),\n    ])\n    y = sample_bias[:, h]\n    \n    # CV\n    maes_base = []\n    maes_ridge = []\n    for tr, te in kf.split(range(n_s)):\n        X_tr, X_te = X[tr], X[te]\n        y_tr = y[tr]\n        mu = X_tr.mean(axis=0)\n        sd = X_tr.std(axis=0)\n        sd[sd < 1e-6] = 1.0\n        X_tr_s = (X_tr - mu) / sd\n        X_te_s = (X_te - mu) / sd\n        \n        for alpha_r in [0.1, 1, 10, 100, 1000]:\n            model = Ridge(alpha=alpha_r, fit_intercept=True)\n            model.fit(X_tr_s, y_tr)\n            pred_bias = model.predict(X_te_s)\n            \n            # Apply correction\n            corrected = base[te, h, :] - pred_bias[:, np.newaxis]\n            m_te = mask[te, h, :]\n            mae_corr = np.abs(corrected[m_te] - target[te, h, :][m_te]).mean()\n            mae_base = np.abs(base[te, h, :][m_te] - target[te, h, :][m_te]).mean()\n        \n        # Use best alpha\n        best_mae = float('inf')\n        best_alpha = 100\n        for alpha_r in [0.1, 1, 10, 100, 1000]:\n            model = Ridge(alpha=alpha_r, fit_intercept=True)\n            model.fit(X_tr_s, y_tr)\n            pred_bias = model.predict(X_te_s)\n            corrected = base[te, h, :] - pred_bias[:, np.newaxis]\n            m_te = mask[te, h, :]\n            mae_corr = np.abs(corrected[m_te] - target[te, h, :][m_te]).mean()\n            if mae_corr < best_mae:\n                best_mae = mae_corr\n                best_alpha = alpha_r\n        \n        maes_base.append(mae_base)\n        maes_ridge.append(best_mae)\n    \n    print(f\\\"  h={h:2d}: base={np.mean(maes_base):.3f}, ridge_sample={np.mean(maes_ridge):.3f}, improv={np.mean(maes_base)-np.mean(maes_ridge):.3f}\\\")\n\n# =============================================\n# IDEA 3: Multiplicative correction (scale per node per clock)\n# Maybe the bias is proportional to the value, not additive\n# =============================================\nprint(\\\"\\\\n=== Idea 3: Multiplicative bias structure ===\\\")\n# Check: is bias proportional to base value?\nfor h in [0, 6, 11]:\n    m = mask[:, h, :]\n    b = base[:,h,:][m]\n    t = target[:,h,:][m]\n    bias = b - t\n    # Correlation between base and bias\n    corr = np.corrcoef(b, bias)[0, 1]\n    # Ratio\n    ratio = np.median((b / np.maximum(t, 1)))\n    print(f\\\"  h={h:2d}: corr(base, bias)={corr:.4f}, median(base/target)={ratio:.4f}\\\")\n\nEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

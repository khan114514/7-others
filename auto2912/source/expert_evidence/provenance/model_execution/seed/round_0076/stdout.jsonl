ed_bias = model.predict(X_te_s)\n            pred[:, h, n] -= pred_bias\n    \n    return pred\n\n# Quick test: just clock correction on raw base\nprint(\\\"Clock correction on raw base (per-node per-horizon):\\\")\nclk_maes = []\nfor tr, te in kf.split(range(n_s)):\n    pred = add_clock_correction(\n        base[tr], target[tr], mask[tr], base[te],\n        clock[tr], clock[te], base[te], n_harmonics=4, alpha=100\n    )\n    clk_maes.append(np.abs(pred[mask[te]] - target[te][mask[te]]).mean())\nprint(f\\\"  Clock-only: {np.mean(clk_maes):.4f} (base was {np.mean(base_maes):.4f})\\\")\nprint(f\\\"  Improvement: {np.mean(base_maes)-np.mean(clk_maes):.4f}\\\")\nEOF\n\"","aggregated_output":"Traceback (most recent call last):\n  File \"<stdin>\", line 89, in <module>\n  File \"<stdin>\", line 69, in baseline_method\nNameError: name 'target_te' is not defined. Did you mean: 'target_tr'?\n=== Baseline v26 (simplified) CV ===\n","exit_code":1,"status":"failed"}}
{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/sh -lc \"python3 << 'EOF'\nimport numpy as np\nfrom sklearn.linear_model import Ridge\nfrom sklearn.model_selection import KFold\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_targ = np.load('/workspace/public_assets/train_targets.npz')\n\nbase = train_feat['base'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\ntarget = train_targ['target'].astype(np.float64)\n\nn_s, n_h, n_n = base.shape\nmask = np.isfinite(target) & (target > 0)\nkf = KFold(n_splits=5, shuffle=True, random_state=42)\n\ndef v26_method(base_tr, target_tr, mask_tr, base_te, anchor_tr, anchor_te, history_tr, history_te, clock_tr, clock_te):\n    \\\"\\\"\\\"Current v26 core method.\\\"\\\"\\\"\n    n_h, n_n = base_tr.shape[1], base_tr.shape[2]\n    \n    # Per-horizon anchor blending\n    anchor_h = np.zeros(n_h)\n    for h in range(n_h):\n        m = mask_tr[:, h, :]\n        best_mae = float('inf')\n        for w in np.linspace(0, 0.30, 31):\n            pred = (1-w)*base_tr[:,h,:][m] + w*anchor_tr[:,h,:][m]\n            mae = np.abs(pred - target_tr[:,h,:][m]).mean()\n            if mae < best_mae:\n                best_mae = mae\n                anchor_h[h] = w\n    \n    # Per-node-horizon anchor blending\n    pna_shrink = 0.3\n    anchor_nh = np.zeros((n_h, n_n))\n    for h in range(n_h):\n        for n in range(n_n):\n            m = mask_tr[:, h, n]\n            if m.sum() > 15:\n                best_mae = float('inf')\n                best_w = anchor_h[h]\n                for w in np.linspace(0, 0.40, 21):\n                    pred = (1-w)*base_tr[:,h,n][m] + w*anchor_tr[:,h,n][m]\n                    mae = np.abs(pred - target_tr[:,h,n][m]).mean()\n                    if mae < best_mae:\n                        best_mae = mae\n                        best_w = w\n                anchor_nh[h,n] = best_w\n            else:\n                anchor_nh[h,n] = anchor_h[h]\n    anchor_nh = pna_shrink * anchor_nh + (1-pna_shrink) * anchor_h[:, np.newaxis]\n    \n    pred = (1 - anchor_nh[np.newaxis,:,:]) * base_te + anchor_nh[np.newaxis,:,:] * anchor_te\n    \n    # Per-horizon median bias\n    h_bias = np.zeros(n_h)\n    train_blended = (1 - anchor_nh[np.newaxis,:,:]) * base_tr + anchor_nh[np.newaxis,:,:] * anchor_tr\n    for h in range(n_h):\n        m = mask_tr[:, h, :]\n        h_bias[h] = np.median(train_blended[:,h,:][m] - target_tr[:,h,:][m])\n    pred = pred - h_bias[np.newaxis,:,np.newaxis]\n    train_corrected = train_blended - h_bias[np.newaxis,:,np.newaxis]\n    \n    # Per-node median bias (shrunken)\n    node_shrink = 0.4\n    node_bias = np.zeros(n_n)\n    for n in range(n_n):\n        m = mask_tr[:, :, n]\n        if m.sum() > 5:\n            node_bias[n] = np.median((train_corrected - target_tr)[:, :, n][m])\n    node_bias = node_shrink * node_bias\n    pred = pred - node_bias[np.newaxis, np.newaxis, :]\n    train_corrected = train_corrected - node_bias[np.newaxis, np.newaxis, :]\n    \n    return pred, train_corrected\n\n# Run baseline\nprint(\\\"=== Baseline v26 core CV ===\\\")\nbase_maes = []\nbl_maes = []\nfor tr, te in kf.split(range(n_s)):\n    pred, _ = v26_method(\n        base[tr], target[tr], mask[tr], base[te],\n        anchor[tr], anchor[te], history[tr], history[te],\n        clock[tr], clock[te]\n    )\n    bm = np.abs(base[te][mask[te]] - target[te][mask[te]]).mean()\n    bm2 = np.abs(pred[mask[te]] - target[te][mask[te]]).mean()\n    base_maes.append(bm)\n    bl_maes.append(bm2)\nprint(f\\\"Base: {np.mean(base_maes):.4f}\\\")\nprint(f\\\"v26 core: {np.mean(bl_maes):.4f}\\\")\nprint(f\\\"Improvement: {np.mean(base_maes)-np.mean(bl_maes):.4f}\\\")\nprint()\n\n# Now test: per-node clock-based ridge correction\n# Apply AFTER the v26 core, using residual\nprint(\\\"=== Adding per-node clock correction (Ridge on residual) ===\\\")\n\ndef add_node_clock_ridge(pred_te, train_corrected_tr, target_tr, mask_tr, clock_tr, clock_te, alpha=100, shrink=0.3):\n    n_h, n_n = pred_te.shape[1], pred_te.shape[2]\n    pred = pred_te.copy()\n    residual_tr = train_corrected_tr - target_tr\n    \n    for n in range(n_n):\n        for h in range(n_h):\n            m_tr = mask_tr[:, h, n]\n            if m_tr.sum() < 10:\n                continue\n            \n            y_tr = residual_tr[:, h, n][m_tr]\n            c_tr = clock_tr[:, h, n][m_tr]\n            c_te = clock_te[:, h, n]\n            \n            X_tr = np.column_stack([np.sin(2*k*np.pi*c_tr) for k in range(1,5)] +\n                                   [np.cos(2*k*np.pi*c_tr) for k in range(1,5)])\n            X_te = np.column_stack([np.sin(2*k*np.pi*c_te) for k in range(1,5)] +\n                                   [np.cos(2*k*np.pi*c_te) for k in range(1,5)])\n            \n            mu = X_tr.mean(axis=0)\n            sd = X_tr.std(axis=0)\n            sd[sd < 1e-6] = 1.0\n            X_tr_s = (X_tr - mu) / sd\n            X_te_s = (X_te - mu) / sd\n            \n            model = Ridge(alpha=alpha, fit_intercept=True)\n            model.fit(X_tr_s, y_tr)\n            pred_bias = model.predict(X_te_s)\n            pred[:, h, n] -= shrink * pred_bias\n    \n    return pred\n\n# This will be slow (170 nodes * 12 horizons = 2040 ridge models). \n# Let's test with a pooled version first - all nodes together with node embedding\nprint(\\\"Pooled node-clock ridge (faster, shared parameters with node features):\\\")\n\ndef add_pooled_clock_ridge(pred_te, train_corrected_tr, target_tr, mask_tr, clock_tr, clock_te, \n                           base_tr, base_te, alpha=100, shrink=0.3):\n    \\\"\\\"\\\"Pooled across nodes, with node index embeddings and base value as feature.\\\"\\\"\\\"\n    n_s_tr, n_h, n_n = base_tr.shape\n    n_s_te = pred_te.shape[0]\n    pred = pred_te.copy()\n    residual_tr = train_corrected_tr - target_tr\n    \n    for h in range(n_h):\n        # Build per-sample-per-node feature matrix\n        rows_tr = []\n        y_rows_tr = []\n        rows_te = []\n        \n        for n in range(n_n):\n            m_tr = mask_tr[:, h, n]\n            if m_tr.sum() < 5:\n                continue\n            \n            c_tr = clock_tr[:, h, n][m_tr]\n            y_tr = residual_tr[:, h, n][m_tr]\n            b_tr = base_tr[:, h, n][m_tr]\n            \n            c_te = clock_te[:, h, n]\n            b_te = base_te[:, h, n]\n            \n            n_feat_tr = len(c_tr)\n            n_feat_te = len(c_te)\n            \n            # Features: base, 4 sin/cos of clock, node position sin/cos\n            x_tr = np.column_stack([\n                b_tr,\n                *[np.sin(2*k*np.pi*c_tr) for k in range(1,5)],\n                *[np.cos(2*k*np.pi*c_tr) for k in range(1,5)],\n                np.full(n_feat_tr, np.sin(2*np.pi*n/n_n)),\n                np.full(n_feat_tr, np.cos(2*np.pi*n/n_n)),\n                np.full(n_feat_tr, np.sin(4*np.pi*n/n_n)),\n                np.full(n_feat_tr, np.cos(4*np.pi*n/n_n)),\n            ])\n            rows_tr.append(x_tr)\n            y_rows_tr.append(y_tr)\n            \n            x_te = np.column_stack([\n                b_te,\n                *[np.sin(2*k*np.pi*c_te) for k in range(1,5)],\n                *[np.cos(2*k*np.pi*c_te) for k in range(1,5)],\n                np.full(n_feat_te, np.sin(2*np.pi*n/n_n)),\n                np.full(n_feat_te, np.cos(2*np.pi*n/n_n)),\n                np.full(n_feat_te, np.sin(4*np.pi*n/n_n)),\n                np.full(n_feat_te, np.cos(4*np.pi*n/n_n)),\n            ])\n            rows_te.append(x_te)\n        \n        X_tr = np.vstack(rows_tr)\n        y_tr = np.concatenate(y_rows_tr)\n        X_te_all = np.vstack(rows_te)\n        \n        mu = X_tr.mean(axis=0)\n        sd = X_tr.std(axis=0)\n        sd[sd < 1e-6] = 1.0\n        X_tr_s = (X_tr - mu) / sd\n        X_te_s
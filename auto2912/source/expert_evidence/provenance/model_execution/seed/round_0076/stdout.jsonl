          ntr = len(y)\n            nte = len(b_te)\n            x_tr = np.column_stack([\n                b_tr, hl_tr, hm_tr, ht_tr, (b_tr - hl_tr),\n                (hl_tr - anchor_tr[:, h, n][m]),\n                *[np.sin(2*k*np.pi*c_tr) for k in range(1,4)],\n                *[np.cos(2*k*np.pi*c_tr) for k in range(1,4)],\n                np.full(ntr, np.sin(2*np.pi*n/n_n)),\n                np.full(ntr, np.cos(2*np.pi*n/n_n)),\n                np.full(ntr, np.sin(4*np.pi*n/n_n)),\n                np.full(ntr, np.cos(4*np.pi*n/n_n)),\n                b_tr * np.sin(2*np.pi*c_tr), b_tr * np.cos(2*np.pi*c_tr),\n                b_tr * np.sin(4*np.pi*c_tr), b_tr * np.cos(4*np.pi*c_tr),\n                hl_tr * np.sin(2*np.pi*c_tr), hl_tr * np.cos(2*np.pi*c_tr),\n            ])\n            X_tr_list.append(x_tr)\n            y_tr_list.append(y)\n            x_te = np.column_stack([\n                b_te, hl_te, hm_te, ht_te, (b_te - hl_te),\n                (hl_te - anchor_te[:, h, n]),\n                *[np.sin(2*k*np.pi*c_te) for k in range(1,4)],\n                *[np.cos(2*k*np.pi*c_te) for k in range(1,4)],\n                np.full(nte, np.sin(2*np.pi*n/n_n)),\n                np.full(nte, np.cos(2*np.pi*n/n_n)),\n                np.full(nte, np.sin(4*np.pi*n/n_n)),\n                np.full(nte, np.cos(4*np.pi*n/n_n)),\n                b_te * np.sin(2*np.pi*c_te), b_te * np.cos(2*np.pi*c_te),\n                b_te * np.sin(4*np.pi*c_te), b_te * np.cos(4*np.pi*c_te),\n                hl_te * np.sin(2*np.pi*c_te), hl_te * np.cos(2*np.pi*c_te),\n            ])\n            X_te_list.append(x_te)\n        if not X_tr_list:\n            continue\n        X_tr_all = np.vstack(X_tr_list)\n        y_tr_all = np.concatenate(y_tr_list)\n        X_te_all = np.vstack(X_te_list)\n        mu = X_tr_all.mean(axis=0)\n        sd = X_tr_all.std(axis=0)\n        sd[sd < 1e-6] = 1.0\n        X_tr_s = (X_tr_all - mu) / sd\n        X_te_s = (X_te_all - mu) / sd\n        model = Ridge(alpha=ridge_alpha, fit_intercept=True)\n        model.fit(X_tr_s, y_tr_all)\n        pred_bias_all = model.predict(X_te_s)\n        idx = 0\n        for n in range(n_n):\n            m = mask_tr[:, h, n]\n            if m.sum() < 5:\n                continue\n            nte = len(base_te)\n            pred[:, h, n] -= ridge_shrink * pred_bias_all[idx:idx+nte]\n            idx += nte\n    \n    pred = np.maximum(pred, 0.0)\n    return pred\n\n\n# ======================================\n# NEW IDEA: Isotonic/quantile calibration per node per horizon\n# ======================================\nprint(\\\"=== Idea: Isotonic regression calibration ===\\\")\n# For each (node, horizon), learn a non-parametric mapping from base -> target\n# via isotonic regression. This handles nonlinear bias patterns.\nfrom sklearn.isotonic import IsotonicRegression\n\nprint(\\\"Testing isotonic regression (per-node per-horizon)...\\\")\niso_maes = []\nfor tr, te in kf.split(range(n_s)):\n    pred = v28_method(\n        base[tr], target[tr], mask[tr], base[te],\n        anchor[tr], anchor[te], history[tr], history[te],\n        clock[tr], clock[te]\n    )\n    \n    # Apply isotonic correction on top\n    iso_corrected = pred.copy()\n    for n in range(n_n):\n        for h in range(n_h):\n            m_tr = mask[tr, h, n]\n            if m_tr.sum() < 20:\n                continue\n            # Use v28 train predictions as input to isotonic\n            # We'd need train predictions... let's approximate with base for now\n            # Actually, let's test: isotonic on base forecast directly\n            try:\n                iso = IsotonicRegression(out_of_bounds='clip', y_min=0)\n                iso.fit(base[tr, h, n][m_tr], target[tr, h, n][m_tr])\n                iso_pred = iso.predict(base[te, h, n])\n                # Blend with v28 pred\n                blend = 0.15 * iso_pred + 0.85 * pred[:, h, n]\n                iso_corrected[:, h, n] = blend\n            except:\n                pass\n    \n    base_mae = np.abs(base[te][mask[te]] - target[te][mask[te]]).mean()\n    v28_mae = np.abs(pred[mask[te]] - target[te][mask[te]]).mean()\n    iso_mae = np.abs(iso_corrected[mask[te]] - target[te][mask[te]]).mean()\n    iso_maes.append(iso_mae)\n    print(f\\\"  Fold: base={base_mae:.3f}, v28={v28_mae:.3f}, iso_blend={iso_mae:.3f}\\\")\n\nprint(f\\\"\\\\nMean iso blend: {np.mean(iso_maes):.4f}\\\")\nEOF\n\"","aggregated_output":"=== Idea: Isotonic regression calibration ===\nTesting isotonic regression (per-node per-horizon)...\n  Fold: base=15.473, v28=14.899, iso_blend=14.954\n  Fold: base=15.227, v28=14.468, iso_blend=14.487\n  Fold: base=15.956, v28=15.297, iso_blend=15.314\n  Fold: base=15.084, v28=14.439, iso_blend=14.475\n  Fold: base=13.096, v28=12.244, iso_blend=12.293\n\nMean iso blend: 14.3045\n","exit_code":0,"status":"completed"}}

{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/sh -lc \"python3 << 'EOF'\nimport numpy as np\nfrom sklearn.linear_model import Ridge\nfrom sklearn.model_selection import KFold\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_targ = np.load('/workspace/public_assets/train_targets.npz')\n\nbase = train_feat['base'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\ntarget = train_targ['target'].astype(np.float64)\n\nn_s, n_h, n_n = base.shape\nmask = np.isfinite(target) & (target > 0)\nkf = KFold(n_splits=5, shuffle=True, random_state=42)\n\ndef build_sample_features(base, anchor, history, clock):\n    n_s, n_h, n_n = base.shape\n    feats = []\n    feats.append(base.mean(axis=2, keepdims=True))\n    feats.append(base.std(axis=2, keepdims=True))\n    feats.append(np.median(base, axis=2, keepdims=True))\n    feats.append(np.percentile(base, 25, axis=2, keepdims=True))\n    feats.append(np.percentile(base, 75, axis=2, keepdims=True))\n    feats.append(anchor.mean(axis=2, keepdims=True))\n    feats.append((base - anchor).mean(axis=2, keepdims=True))\n    hist_last_mean = history[:, -1, :].mean(axis=1)\n    hist_mean = history.mean(axis=(1, 2))\n    hist_trend_mean = (history[:, -1, :] - history[:, 0, :]).mean(axis=1) / 12.0\n    hist_std = history.std(axis=(1, 2))\n    hist_max = history.max(axis=(1, 2))\n    hist_min = history.min(axis=(1, 2))\n    for feat_val in [hist_last_mean, hist_mean, hist_trend_mean, hist_std, hist_max, hist_min]:\n        feats.append(np.tile(feat_val[:, np.newaxis, np.newaxis], (1, n_h, 1)))\n    for i in range(12):\n        h_mean = history[:, i, :].mean(axis=1)\n        feats.append(np.tile(h_mean[:, np.newaxis, np.newaxis], (1, n_h, 1)))\n    for k in range(1, 5):\n        feats.append(np.sin(2 * k * np.pi * clock[:, :, 0:1]))\n        feats.append(np.cos(2 * k * np.pi * clock[:, :, 0:1]))\n    bm = base.mean(axis=2, keepdims=True)\n    feats.append(bm * np.sin(2 * np.pi * clock[:, :, 0:1]))\n    feats.append(bm * np.cos(2 * np.pi * clock[:, :, 0:1]))\n    feats.append(bm * np.sin(4 * np.pi * clock[:, :, 0:1]))\n    feats.append(bm * np.cos(4 * np.pi * clock[:, :, 0:1]))\n    hl = np.tile(hist_last_mean[:, np.newaxis, np.newaxis], (1, n_h, 1))\n    feats.append(hl * np.sin(2 * np.pi * clock[:, :, 0:1]))\n    feats.append(hl * np.cos(2 * np.pi * clock[:, :, 0:1]))\n    return np.concatenate(feats, axis=2)\n\n\ndef v28_core(base_tr, target_tr, mask_tr, base_te, anchor_tr, anchor_te, \n             history_tr, history_te, clock_tr, clock_te,\n             sample_shrink=0.4, sample_alpha=10.0, node_shrink=0.5,\n             ridge_shrink=0.15, ridge_alpha=1000.0,\n             pnh_shrink=0.15, mult_shrink=0.2):\n    n_h, n_n = base_tr.shape[1], base_tr.shape[2]\n    \n    anchor_h = np.zeros(n_h)\n    for h in range(n_h):\n        m = mask_tr[:, h, :]\n        best_mae = float('inf')\n        for w in np.linspace(0, 0.30, 31):\n            pred = (1-w)*base_tr[:,h,:][m] + w*anchor_tr[:,h,:][m]\n            mae = np.abs(pred - target_tr[:,h,:][m]).mean()\n            if mae < best_mae:\n                best_mae = mae\n                anchor_h[h] = w\n    \n    pna_shrink = 0.3\n    anchor_nh = np.zeros((n_h, n_n))\n    for h in range(n_h):\n        for n in range(n_n):\n            m = mask_tr[:, h, n]\n            if m.sum() > 15:\n                best_mae = float('inf')\n                best_w = anchor_h[h]\n                for w in np.linspace(0, 0.40, 21):\n                    pred = (1-w)*base_tr[:,h,n][m] + w*anchor_tr[:,h,n][m]\n                    mae = np.abs(pred - target_tr[:,h,n][m]).mean()\n                    if mae < best_mae:\n                        best_mae = mae\n                        best_w = w\n                anchor_nh[h,n] = best_w\n            else:\n                anchor_nh[h,n] = anchor_h[h]\n    anchor_nh = pna_shrink * anchor_nh + (1-pna_shrink) * anchor_h[:, np.newaxis]\n    \n    pred = (1 - anchor_nh[np.newaxis,:,:]) * base_te + anchor_nh[np.newaxis,:,:] * anchor_te\n    train_pred = (1 - anchor_nh[np.newaxis,:,:]) * base_tr + anchor_nh[np.newaxis,:,:] * anchor_tr\n    \n    # Per-horizon bias\n    h_bias = np.zeros(n_h)\n    for h in range(n_h):\n        m = mask_tr[:, h, :]\n        h_bias[h] = np.median(train_pred[:,h,:][m] - target_tr[:,h,:][m])\n    pred = pred - h_bias[np.newaxis,:,np.newaxis]\n    train_pred = train_pred - h_bias[np.newaxis,:,np.newaxis]\n    \n    # Per-node bias\n    node_bias = np.zeros(n_n)\n    residual_tr = train_pred - target_tr\n    for n in range(n_n):\n        m = mask_tr[:, :, n]\n        if m.sum() > 5:\n            node_bias[n] = np.median(residual_tr[:, :, n][m])\n    node_bias = node_shrink * node_bias\n    pred = pred - node_bias[np.newaxis, np.newaxis, :]\n    train_pred = train_pred - node_bias[np.newaxis, np.newaxis, :]\n    \n    # Per-node-horizon bias\n    bias_nh = np.zeros((n_h, n_n))\n    residual_tr = train_pred - target_tr\n    for h in range(n_h):\n        for n in range(n_n):\n            m = mask_tr[:, h, n]\n            if m.sum() > 10:\n                bias_nh[h, n] = np.median(residual_tr[:, h, n][m])\n    bias_nh = pnh_shrink * bias_nh\n    pred = pred - bias_nh[np.newaxis, :, :]\n    train_pred = train_pred - bias_nh[np.newaxis, :, :]\n    \n    # Multiplicative per-node\n    mult_factor = np.ones(n_n)\n    residual_tr = train_pred - target_tr\n    for n in range(n_n):\n        m = mask_tr[:, :, n]\n        if m.sum() > 20:\n            tp = train_pred[:, :, n][m]\n            tg = target_tr[:, :, n][m]\n            tp_safe = np.maximum(tp, 1e-6)\n            mult_factor[n] = np.median(tg / tp_safe)\n    mult_factor = 1.0 + mult_shrink * (mult_factor - 1.0)\n    pred = pred * mult_factor[np.newaxis, np.newaxis, :]\n    train_pred = train_pred * mult_factor[np.newaxis, np.newaxis, :]\n    \n    # Sample-level ridge\n    sample_feat_tr = build_sample_features(base_tr, anchor_tr, history_tr, clock_tr)\n    sample_feat_te = build_sample_features(base_te, anchor_te, history_te, clock_te)\n    \n    sample_bias_tr = np.zeros((len(base_tr), n_h))\n    residual_tr = train_pred - target_tr\n    for s in range(len(base_tr)):\n        for h in range(n_h):\n            m = mask_tr[s, h, :]\n            if m.sum() > 10:\n                sample_bias_tr[s, h] = np.mean(residual_tr[s, h, :][m])\n    \n    for h in range(n_h):\n        y_tr = sample_bias_tr[:, h]\n        X_tr = sample_feat_tr[:, h, :]\n        X_te = sample_feat_te[:, h, :]\n        mu = X_tr.mean(axis=0)\n        sd = X_tr.std(axis=0)\n        sd[sd < 1e-6] = 1.0\n        X_tr_s = (X_tr - mu) / sd\n        X_te_s = (X_te - mu) / sd\n        model = Ridge(alpha=sample_alpha, fit_intercept=True)\n        model.fit(X_tr_s, y_tr)\n        pred_bias_te = model.predict(X_te_s)\n        pred[:, h, :] -= sample_shrink * pred_bias_te[:, np.newaxis]\n        train_pred[:, h, :] -= sample_shrink * model.predict(X_tr_s)[:, np.newaxis]\n    \n    # Pooled node ridge\n    residual_tr = train_pred - target_tr\n    for h in range(n_h):\n        X_tr_list = []\n        y_tr_list = []\n        X_te_list = []\n        for n in range(n_n):\n            m = mask_tr[:, h, n]\n            if m.sum() < 5:\n                continue\n            y = residual_tr[:, h, n][m]\n            b_tr = base_tr[:, h, n][m]\n            c_tr = clock_tr[:, h, n][m]\n            hl_tr = history_tr[:, -1, n][m]\n            hm_tr = history_tr[:, :, n].mean(axis=1)[m]\n            ht_tr = ((history_tr[:, -1, n] - history_tr[:, 0, n]) / 12.0)[m]\n            b_te = base_te[:, h, n]\n            c_te = clock_te[:, h, n]\n            hl_te = history_te[:, -1, n]\n            hm_te = history_te[:, :, n].mean(axis=1)\n            ht_te = (history_te[:, -1, n] - history_te[:, 0, n]) / 12.0\n            ntr = len(y)\n            nte = len(b_te)\n            x_tr = np.column_stack([\n                b_tr, hl_tr, hm_tr, ht_tr, (b_tr - hl_tr),\n                (hl_tr - anchor_tr[:, h, n][m]),\n                *[np.sin(2*k*np.pi*c_tr) for k in range(1,4)],\n                *[np.cos(2*k*np.pi*c_tr) for k in range(1,4)],\n                np.full(ntr, np.sin(2*np.pi*n/n_n)),\n                np.full(ntr, np.cos(2*np.pi*n/n_n)),\n                np.full(ntr, np.sin(4*np.pi*n/n_n)),\n                np.full(ntr, np.cos(4*np.pi*n/n_n)),\n                b_tr * np.sin(2*np.pi*c_tr), b_tr * np.cos(2*np.pi*c_tr),\n                b_tr * np.sin(4*np.pi*c_tr), b_tr * np.cos(4*np.pi*c_tr),\n                hl_tr * np.sin(2*np.pi*c_tr), hl_tr * np.cos(2*np.pi*c_tr),\n            ])\n            X_tr_list.append(x_tr)\n            y_tr_list.append(y)\n            x_te = np.column_stack([\n                b_te, hl_te, hm_te, ht_te, (b_te - hl_te),\n                (hl_te - anchor_te[:, h, n]),\n                *[np.sin(2*k*np.pi*c_te) for k in range(1,4)],\n                *[np.cos(2*k*np.pi*c_te) for k in range(1,4)],\n                np.full(nte, np.sin(2*np.pi*n/n_n)),\n                np.full(nte, np.cos(2*np.pi*n/n_n)),\n                np.full(nte, np.sin(4*np.pi*n/n_n)),\n                np.full(nte, np.cos(4*np.pi*n/n_n)),\n                b_te * np.sin(2*np.pi*c_te), b_te * np.cos(2*np.pi*c_te),\n                b_te * np.sin(4*np.pi*c_te), b_te * np.cos(4*np.pi*c_te),\n                hl_te * np.sin(2*np.pi*c_te), hl_te * np.cos(2*np.pi*c_te),\n            ])\n            X_te_list.append(x_te)\n        if not X_tr_list:\n            continue\n        X_tr_all = np.vstack(X_tr_list)\n        y_tr_all = np.concatenate(y_tr_list)\n        X_te_all = np.vstack(X_te_list)\n        mu = X_tr_all.mean(axis=0)\n        sd = X_tr_all.std(axis=0)\n        sd[sd < 1e-6] = 1.0\n        X_tr_s = (X_tr_all - mu) / sd\n        X_te_s = (X_te_all - mu) / sd\n        model = Ridge(alpha=ridge_alpha, fit_intercept=True)\n        model.fit(X_tr_s, y_tr_all)\n        pred_bias_all = model.predict(X_te_s)\n        idx = 0\n        for n in range(n_n):\n            m = mask_tr[:, h, n]\n            if m.sum() < 5:\n                continue\n            nte = len(base_te)\n            pred[:, h, n] -= ridge_shrink * pred_bias_all[idx:idx+nte]\n            idx += nte\n    \n    pred = np.maximum(pred, 0.0)\n    return pred\n\n\n# ======================================\n# IDEA: Per-node \\\"history level\\\" re-centering\n# For each node, base forecast may be biased relative to history level.\n# Test: per-node per-horizon optimal linear correction base -> target using history as covariate\n# ======================================\nprint(\\\"=== Idea: Per-node per-horizon ridge with just base+history (stronger regularization) ===\\\")\n\n# Let me test: what if we add a \\\"second round\\\" of sample correction \n# using the residual from the first round? (boosting-like)\nprint(\\\"\\\\n=== Idea: Two-stage sample correction (boosting) ===\\\")\n\nfor shrink2 in [0.1, 0.15, 0.2, 0.3]:\n    maes = []\n    for tr, te in kf.split(range(n_s)):\n        # First stage\n        pred = v28_core(\n            base[tr], target[tr], mask[tr], base[te],\n            anchor[tr], anchor[te], history[tr], history[te],\n            clock[tr], clock[te]\n        )\n        \n        # Second stage: apply sample correction again on the residual\n        # We need to re-fit sample-level ridge on the training residual\n        # But v28 already includes sample correction. Let's just do another round.\n        # Actually let's test: two rounds of sample correction with smaller shrink\n        \n        # Compute train predictions for second stage\n        train_pred = v28_core(\n            base[tr], target[tr], mask[tr], base[tr],  # train input\n            anchor[tr], anchor[tr], history[tr], history[tr],\n            clock[tr], clock[tr]\n        )\n        train_residual = train_pred - target[tr]\n        \n        # Re-fit sample model on residual\n        sample_feat_tr = build_sample_features(base[tr], anchor[tr], history[tr], clock[tr])\n        sample_feat_te = build_sample_features(base[te], anchor[te], history[te], clock[te])\n        \n        sample_bias2 = np.zeros((len(tr), n_h))\n        for s in range(len(tr)):\n            for h in range(n_h):\n                m = mask[tr[s], h, :]\n                if m.sum() > 10:\n                    sample_bias2[s, h] = np.mean(train_residual[s, h, :][m])\n        \n        for h in range(n_h):\n            y_tr = sample_bias2[:, h]\n            X_tr = sample_feat_tr[:, h, :]\n            X_te = sample_feat_te[:, h, :]\n            mu = X_tr.mean(axis=0)\n            sd = X_tr.std(axis=0)\n            sd[sd < 1e-6] = 1.0\n            X_tr_s = (X_tr - mu) / sd\n            X_te_s = (X_te - mu) / sd\n            model = Ridge(alpha=10, fit_intercept=True)\n            model.fit(X_tr_s, y_tr)\n            pred_bias_te = model.predict(X_te_s)\n            pred[:, h, :] -= shrink2 * pred_bias_te[:, np.newaxis]\n        \n        pred = np.maximum(pred, 0.0)\n        maes.append(np.abs(pred[mask[te]] - target[te][mask[te]]).mean())\n    \n    print(f\\\"  shrink2={shrink2:.2f}: MAE={np.mean(maes):.4f}\\\")\n\n# ======================================\n# IDEA: Per-node per-clock-bin median bias\n# ======================================\nprint(\\\"\\\\n=== Idea: Per-node clock-bin median bias ===\\\")\n# Clock has 24 unique values (hour of day). For each node, compute median bias \n# per time-of-day bin, with shrinkage toward node-level mean.\n\nn_bins = 6  # 6 time-of-day bins\nbin_edges = np.linspace(0, 1, n_bins + 1)\n\nfor shrink_clk in [0.05, 0.1, 0.15, 0.2, 0.3]:\n    maes = []\n    for tr, te in kf.split(range(n_s)):\n        pred = v28_core(\n            base[tr], target[tr], mask[tr], base[te],\n            anchor[tr], anchor[te], history[tr], history[te],\n            clock[tr], clock[te]\n        )\n        \n        # Train predictions (for residual)\n        train_pred = v28_core(\n            base[tr], target[tr], mask[tr], base[tr],\n            anchor[tr], anchor[tr], history[tr], history[tr],\n            clock[tr], clock[tr]\n        )\n        train_resid = train_pred - target[tr]\n        \n        # For each node, compute per-clock-bin median bias\n        # Use h=0 clock to bin samples (same for all nodes at same h)\n        # Actually clock is per-horizon, let's do per-horizon bins\n        \n        clock_bias = np.zeros((n_h, n_n, n_bins))\n        for h in range(n_h):\n            for n in range(n_n):\n                clock_vals = clock[tr, h, n]\n                bins = np.digitize(clock_vals, bin_edges[1:-1])\n                for b in range(n_bins):\n                    idx = (bins == b) & mask[tr, h, n]\n                    if idx.sum() >= 3:\n                        clock_bias[h, n, b] = np.median(train_resid[idx, h, n])\n        \n        # Apply correction\n        for h in range(n_h):\n            clock_vals = clock[te, h, 0]\n            bins_te = np.digitize(clock_vals, bin_edges[1:-1])\n            for n in range(n_n):\n                for s_idx, b in enumerate(bins_te):\n                    pred[s_idx, h, n] -= shrink_clk * clock_bias[h, n, b]\n        \n        pred = np.maximum(pred, 0.0)\n        maes.append(np.abs(pred[mask[te]] - target[te][mask[te]]).mean())\n    \n    print(f\\\"  shrink_clk={shrink_clk:.2f}: MAE={np.mean(maes):.4f}\\\")\n\nEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_45","type":"command_execution","command":"/bin/sh -lc \"python3 << 'EOF'\nimport numpy as np\nfrom sklearn.linear_model import Ridge\nfrom sklearn.model_selection import KFold\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_targ = np.load('/workspace/public_assets/train_targets.npz')\n\nbase = train_feat['base'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\ntarget = train_targ['target'].astype(np.float64)\n\nn_s, n_h, n_n = base.shape\nmask = np.isfinite(target) & (target > 0)\nkf = KFold(n_splits=5, shuffle=True, random_state=42)\n\ndef build_sample_features(base, anchor, history, clock):\n    n_s, n_h, n_n = base.shape\n    feats = []\n    feats.append(base.mean(axis=2, keepdims=True))\n    feats.append(base.std(axis=2, keepdims=True))\n    feats.append(np.median(base, axis=2, keepdims=True))\n    feats.append(np.percentile(base, 25, axis=2, keepdims=True))\n    feats.append(np.percentile(base, 75, axis=2, keepdims=True))\n    feats.append(anchor.mean(axis=2, keepdims=True))\n    feats.append((base - anchor).mean(axis=2, keepdims=True))\n    hist_last_mean = history[:, -1, :].mean(axis=1)\n    hist_mean = history.mean(axis=(1, 2))\n    hist_trend_mean = (history[:, -1, :] - history[:, 0, :]).mean(axis=1) / 12.0\n    hist_std = history.std(axis=(1, 2))\n    hist_max = history.max(axis=(1, 2))\n    hist_min = history.min(axis=(1, 2))\n    for feat_val in [hist_last_mean, hist_mean, hist_trend_mean, hist_std, hist_max, hist_min]:\n        feats.append(np.tile(feat_val[:, np.newaxis, np.newaxis], (1, n_h, 1)))\n    for i in range(12):\n        h_mean = history[:, i, :].mean(axis=1)\n        feats.append(np.tile(h_mean[:, np.newaxis, np.newaxis], (1, n_h, 1)))\n    for k in range(1, 5):\n        feats.append(np.sin(2 * k * np.pi * clock[:, :, 0:1]))\n        feats.append(np.cos(2 * k * np.pi * clock[:, :, 0:1]))\n    bm = base.mean(axis=2, keepdims=True)\n    feats.append(bm * np.sin(2 * np.pi * clock[:, :, 0:1]))\n    feats.append(bm * np.cos(2 * np.pi * clock[:, :, 0:1]))\n    feats.append(bm * np.sin(4 * np.pi * clock[:, :, 0:1]))\n    feats.append(bm * np.cos(4 * np.pi * clock[:, :, 0:1]))\n    hl = np.tile(hist_last_mean[:, np.newaxis, np.newaxis], (1, n_h, 1))\n    feats.append(hl * np.sin(2 * np.pi * clock[:, :, 0:1]))\n    feats.append(hl * np.cos(2 * np.pi * clock[:, :, 0:1]))\n    return np.concatenate(feats, axis=2)\n\n\ndef v28_core(base_tr, target_tr, mask_tr, base_te, anchor_tr, anchor_te, \n             history_tr, history_te, clock_tr, clock_te,\n             sample_shrink=0.4, sample_alpha=10.0, node_shrink=0.5,\n             ridge_shrink=0.15, ridge_alpha=1000.0,\n             pnh_shrink=0.15, mult_shrink=0.2):\n    n_h, n_n = base_tr.shape[1], base_tr.shape[2]\n    \n    anchor_h = np.zeros(n_h)\n    for h in range(n_h):\n        m = mask_tr[:, h, :]\n        best_mae = float('inf')\n        for w in np.linspace(0, 0.30, 31):\n            pred = (1-w)*base_tr[:,h,:][m] + w*anchor_tr[:,h,:][m]\n            mae = np.abs(pred - target_tr[:,h,:][m]).mean()\n            if mae < best_mae:\n                best_mae = mae\n                anchor_h[h] = w\n    \n    pna_shrink = 0.3\n    anchor_nh = np.zeros((n_h, n_n))\n    for h in range(n_h):\n        for n in range(n_n):\n            m = mask_tr[:, h, n]\n            if m.sum() > 15:\n                best_mae = float('inf')\n                best_w = anchor_h[h]\n                for w in np.linspace(0, 0.40, 21):\n                    pred = (1-w)*base_tr[:,h,n][m] + w*anchor_tr[:,h,n][m]\n                    mae = np.abs(pred - target_tr[:,h,n][m]).mean()\n                    if mae < best_mae:\n                        best_mae = mae\n                        best_w = w\n                anchor_nh[h,n] = best_w\n            else:\n                anchor_nh[h,n] = anchor_h[h]\n    anchor_nh = pna_shrink * anchor_nh + (1-pna_shrink) * anchor_h[:, np.newaxis]\n    \n    pred = (1 - anchor_nh[np.newaxis,:,:]) * base_te + anchor_nh[np.newaxis,:,:] * anchor_te\n    train_pred = (1 - anchor_nh[np.newaxis,:,:]) * base_tr + anchor_nh[np.newaxis,:,:] * anchor_tr\n    \n    # Per-horizon bias\n    h_bias = np.zeros(n_h)\n    for h in range(n_h):\n        m = mask_tr[:, h, :]\n        h_bias[h] = np.median(train_pred[:,h,:][m] - target_tr[:,h,:][m])\n    pred = pred - h_bias[np.newaxis,:,np.newaxis]\n    train_pred = train_pred - h_bias[np.newaxis,:,np.newaxis]\n    \n    # Per-node bias\n    node_bias = np.zeros(n_n)\n    residual_tr = train_pred - target_tr\n    for n in range(n_n):\n        m = mask_tr[:, :, n]\n        if m.sum() > 5:\n            node_bias[n] = np.median(residual_tr[:, :, n][m])\n    node_bias = node_shrink * node_bias\n    pred = pred - node_bias[np.newaxis, np.newaxis, :]\n    train_pred = train_pred - node_bias[np.newaxis, np.newaxis, :]\n    \n    # Per-node-horizon bias\n    bias_nh = np.zeros((n_h, n_n))\n    residual_tr = train_pred - target_tr\n    for h in range(n_h):\n        for n in range(n_n):\n            m = mask_tr[:, h, n]\n            if m.sum() > 10:\n                bias_nh[h, n] = np.median(residual_tr[:, h, n][m])\n    bias_nh = pnh_shrink * bias_nh\n    pred = pred - bias_nh[np.newaxis, :, :]\n    train_pred = train_pred - bias_nh[np.newaxis, :, :]\n    \n    # Multiplicative per-node\n    mult_factor = np.ones(n_n)\n    residual_tr = train_pred - target_tr\n    for n in range(n_n):\n        m = mask_tr[:, :, n]\n        if m.sum() > 20:\n            tp = train_pred[:, :, n][m]\n            tg = target_tr[:, :, n][m]\n            tp_safe = np.maximum(tp, 1e-6)\n            mult_factor[n] = np.median(tg / tp_safe)\n    mult_factor = 1.0 + mult_shrink * (mult_factor - 1.0)\n    pred = pred * mult_factor[np.newaxis, np.newaxis, :]\n    train_pred = train_pred * mult_factor[np.newaxis, np.newaxis, :]\n    \n    # Sample-level ridge\n    sample_feat_tr = build_sample_features(base_tr, anchor_tr, history_tr, clock_tr)\n    sample_feat_te = build_sample_features(base_te, anchor_te, history_te, clock_te)\n    \n    sample_bias_tr = np.zeros((len(base_tr), n_h))\n    residual_tr = train_pred - target_tr\n    for s in range(len(base_tr)):\n        for h in range(n_h):\n            m = mask_tr[s, h, :]\n            if m.sum() > 10:\n                sample_bias_tr[s, h] = np.mean(residual_tr[s, h, :][m])\n    \n    for h in range(n_h):\n        y_tr = sample_bias_tr[:, h]\n        X_tr = sample_feat_tr[:, h, :]\n        X_te = sample_feat_te[:, h, :]\n        mu = X_tr.mean(axis=0)\n        sd = X_tr.std(axis=0)\n        sd[sd < 1e-6] = 1.0\n        X_tr_s = (X_tr - mu) / sd\n        X_te_s = (X_te - mu) / sd\n        model = Ridge(alpha=sample_alpha, fit_intercept=True)\n        model.fit(X_tr_s, y_tr)\n        pred_bias_te = model.predict(X_te_s)\n        pred[:, h, :] -= sample_shrink * pred_bias_te[:, np.newaxis]\n        train_pred[:, h, :] -= sample_shrink * model.predict(X_tr_s)[:, np.newaxis]\n    \n    # Pooled node ridge\n    residual_tr = train_pred - target_tr\n    for h in range(n_h):\n        X_tr_list = []\n        y_tr_list = []\n        X_te_list = []\n        for n in range(n_n):\n            m = mask_tr[:, h, n]\n            if m.sum() < 5:\n                continue\n            y = residual_tr[:, h, n][m]\n            b_tr = base_tr[:, h, n][m]\n            c_tr = clock_tr[:, h, n][m]\n            hl_tr = history_tr[:, -1, n][m]\n            hm_tr = history_tr[:, :, n].mean(axis=1)[m]\n            ht_tr = ((history_tr[:, -1, n] - history_tr[:, 0, n]) / 12.0)[m]\n            b_te = base_te[:, h, n]\n            c_te = clock_te[:, h, n]\n            hl_te = history_te[:, -1, n]\n            hm_te = history_te[:, :, n].mean(axis=1)\n            ht_te = (history_te[:, -1, n] - history_te[:, 0, n]) / 12.0\n            ntr = len(y)\n            nte = len(b_te)\n            x_tr = np.column_stack([\n                b_tr, hl_tr, hm_tr, ht_tr, (b_tr - hl_tr),\n                (hl_tr - anchor_tr[:, h, n][m]),\n                *[np.sin(2*k*np.pi*c_tr) for k in range(1,4)],\n                *[np.cos(2*k*np.pi*c_tr) for k in range(1,4)],\n                np.full(ntr, np.sin(2*np.pi*n/n_n)),\n                np.full(ntr, np.cos(2*np.pi*n/n_n)),\n                np.full(ntr, np.sin(4*np.pi*n/n_n)),\n                np.full(ntr, np.cos(4*np.pi*n/n_n)),\n                b_tr * np.sin(2*np.pi*c_tr), b_tr * np.cos(2*np.pi*c_tr),\n                b_tr * np.sin(4*np.pi*c_tr), b_tr * np.cos(4*np.pi*c_tr),\n                hl_tr * np.sin(2*np.pi*c_tr), hl_tr * np.cos(2*np.pi*c_tr),\n            ])\n            X_tr_list.append(x_tr)\n            y_tr_list.append(y)\n            x_te = np.column_stack([\n                b_te, hl_te, hm_te, ht_te, (b_te - hl_te),\n                (hl_te - anchor_te[:, h, n]),\n                *[np.sin(2*k*np.pi*c_te) for k in range(1,4)],\n                *[np.cos(2*k*np.pi*c_te) for k in range(1,4)],\n                np.full(nte, np.sin(2*np.pi*n/n_n)),\n                np.full(nte, np.cos(2*np.pi*n/n_n)),\n                np.full(nte, np.sin(4*np.pi*n/n_n)),\n                np.full(nte, np.cos(4*np.pi*n/n_n)),\n                b_te * np.sin(2*np.pi*c_te), b_te * np.cos(2*np.pi*c_te),\n                b_te * np.sin(4*np.pi*c_te), b_te * np.cos(4*np.pi*c_te),\n                hl_te * np.sin(2*np.pi*c_te), hl_te * np.cos(2*np.pi*c_te),\n            ])\n            X_te_list.append(x_te)\n        if not X_tr_list:\n            continue\n        X_tr_all = np.vstack(X_tr_list)\n        y_tr_all = np.concatenate(y_tr_list)\n        X_te_all = np.vstack(X_te_list)\n        mu = X_tr_all.mean(axis=0)\n        sd = X_tr_all.std(axis=0)\n        sd[sd < 1e-6] = 1.0\n        X_tr_s = (X_tr_all - mu) / sd\n        X_te_s = (X_te_all - mu) / sd\n        model = Ridge(alpha=ridge_alpha, fit_intercept=True)\n        model.fit(X_tr_s, y_tr_all)\n        pred_bias_all = model.predict(X_te_s)\n        idx = 0\n        for n in range(n_n):\n            m = mask_tr[:, h, n]\n            if m.sum() < 5:\n                continue\n            nte = len(base_te)\n            pred[:, h, n] -= ridge_shrink * pred_bias_all[idx:idx+nte]\n            idx += nte\n    \n    pred = np.maximum(pred, 0.0)\n    return pred\n\n\n# ======================================\n# IDEA: Per-node \\\"history level\\\" re-centering\n# For each node, base forecast may be biased relative to history level.\n# Test: per-node per-horizon optimal linear correction base -> target using history as covariate\n# ======================================\nprint(\\\"=== Idea: Per-node per-horizon ridge with just base+history (stronger regularization) ===\\\")\n\n# Let me test: what if we add a \\\"second round\\\" of sample correction \n# using the residual from the first round? (boosting-like)\nprint(\\\"\\\\n=== Idea: Two-stage sample correction (boosting) ===\\\")\n\nfor shrink2 in [0.1, 0.15, 0.2, 0.3]:\n    maes = []\n    for tr, te in kf.split(range(n_s)):\n        # First stage\n        pred = v28_core(\n            base[tr], target[tr], mask[tr], base[te],\n            anchor[tr], anchor[te], history[tr], history[te],\n            clock[tr], clock[te]\n        )\n        \n        # Second stage: apply sample correction again on the residual\n        # We need to re-fit sample-level ridge on the training residual\n        # But v28 already includes sample correction. Let's just do another round.\n        # Actually let's test: two rounds of sample correction with smaller shrink\n        \n        # Compute train predictions for second stage\n        train_pred = v28_core(\n            base[tr], target[tr], mask[tr], base[tr],  # train input\n            anchor[tr], anchor[tr], history[tr], history[tr],\n            clock[tr], clock[tr]\n        )\n        train_residual = train_pred - target[tr]\n        \n        # Re-fit sample model on residual\n        sample_feat_tr = build_sample_features(base[tr], anchor[tr], history[tr], clock[tr])\n        sample_feat_te = build_sample_features(base[te], anchor[te], history[te], clock[te])\n        \n        sample_bias2 = np.zeros((len(tr), n_h))\n        for s in range(len(tr)):\n            for h in range(n_h):\n                m = mask[tr[s], h, :]\n                if m.sum() > 10:\n                    sample_bias2[s, h] = np.mean(train_residual[s, h, :][m])\n        \n        for h in range(n_h):\n            y_tr = sample_bias2[:, h]\n            X_tr = sample_feat_tr[:, h, :]\n            X_te = sample_feat_te[:, h, :]\n            mu = X_tr.mean(axis=0)\n            sd = X_tr.std(axis=0)\n            sd[sd < 1e-6] = 1.0\n            X_tr_s = (X_tr - mu) / sd\n            X_te_s = (X_te - mu) / sd\n            model = Ridge(alpha=10, fit_intercept=True)\n            model.fit(X_tr_s, y_tr)\n            pred_bias_te = model.predict(X_te_s)\n            pred[:, h, :] -= shrink2 * pred_bias_te[:, np.newaxis]\n        \n        pred = np.maximum(pred, 0.0)\n        maes.append(np.abs(pred[mask[te]] - target[te][mask[te]]).mean())\n    \n    print(f\\\"  shrink2={shrink2:.2f}: MAE={np.mean(maes):.4f}\\\")\n\n# ======================================\n# IDEA: Per-node per-clock-bin median bias\n# ======================================\nprint(\\\"\\\\n=== Idea: Per-node clock-bin median bias ===\\\")\n# Clock has 24 unique values (hour of day). For each node, compute median bias \n# per time-of-day bin, with shrinkage toward node-level mean.\n\nn_bins = 6  # 6 time-of-day bins\nbin_edges = np.linspace(0, 1, n_bins + 1)\n\nfor shrink_clk in [0.05, 0.1, 0.15, 0.2, 0.3]:\n    maes = []\n    for tr, te in kf.split(range(n_s)):\n        pred = v28_core(\n            base[tr], target[tr], mask[tr], base[te],\n            anchor[tr], anchor[te], history[tr], history[te],\n            clock[tr], clock[te]\n        )\n        \n        # Train predictions (for residual)\n        train_pred = v28_core(\n            base[tr], target[tr], mask[tr], base[tr],\n            anchor[tr], anchor[tr], history[tr], history[tr],\n            clock[tr], clock[tr]\n        )\n        train_resid = train_pred - target[tr]\n        \n        # For each node, compute per-clock-bin median bias\n        # Use h=0 clock to bin samples (same for all nodes at same h)\n        # Actually clock is per-horizon, let's do per-horizon bins\n        \n        clock_bias = np.zeros((n_h, n_n, n_bins))\n        for h in range(n_h):\n            for n in range(n_n):\n                clock_vals = clock[tr, h, n]\n                bins = np.digitize(clock_vals, bin_edges[1:-1])\n                for b in range(n_bins):\n                    idx = (bins == b) & mask[tr, h, n]\n                    if idx.sum() >= 3:\n                        clock_bias[h, n, b] = np.median(train_resid[idx, h, n])\n        \n        # Apply correction\n        for h in range(n_h):\n            clock_vals = clock[te, h, 0]\n            bins_te = np.digitize(clock_vals, bin_edges[1:-1])\n            for n in range(n_n):\n                for s_idx, b in enumerate(bins_te):\n                    pred[s_idx, h, n] -= shrink_clk * clock_bias[h, n, b]\n        \n        pred = np.maximum(pred, 0.0)\n        maes.append(np.abs(pred[mask[te]] - target[te][mask[te]]).mean())\n    \n    print(f\\\"  shrink_clk={shrink_clk:.2f}: MAE={np.mean(maes):.4f}\\\")\n\nEOF\n\"","aggregated_output":"=== Idea: Per-node per-horizon ridge with just base+history (stronger regularization) ===\n\n=== Idea: Two-stage sample correction (boosting) ===\n  shrink2=0.10: MAE=14.2711\n  shrink2=0.15: MAE=14.2728\n  shrink2=0.20: MAE=14.2749\n  shrink2=0.30: MAE=14.2808\n\n=== Idea: Per-node clock-bin median bias ===\n  shrink_clk=0.05: MAE=14.2527\n  shrink_clk=0.10: MAE=14.2414\n  shrink_clk=0.15: MAE=14.2353\n  shrink_clk=0.20: MAE=14.2346\n  shrink_clk=0.30: MAE=14.2492\n","exit_code":0,"status"
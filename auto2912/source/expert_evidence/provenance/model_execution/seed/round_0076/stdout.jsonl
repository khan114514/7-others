{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/sh -lc \"python3 << 'EOF'\nimport numpy as np\nfrom sklearn.linear_model import Ridge, Lasso\nfrom sklearn.model_selection import KFold\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_targ = np.load('/workspace/public_assets/train_targets.npz')\ngraph = np.load('/workspace/public_assets/graph.npz')\n\nbase = train_feat['base'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\ntarget = train_targ['target'].astype(np.float64)\nadj = graph['adjacency'].astype(np.float64)\n\nn_s, n_h, n_n = base.shape\nmask = np.isfinite(target) & (target > 0)\n\n# ============= Current method replication for CV =============\ndef run_method(base, anchor, history, clock, target, mask, train_idx, test_idx):\n    \\\"\\\"\\\"Run current v26 pipeline on CV fold.\\\"\\\"\\\"\n    # Fit on train\n    base_tr, base_te = base[train_idx], base[test_idx]\n    anchor_tr, anchor_te = anchor[train_idx], anchor[test_idx]\n    history_tr, history_te = history[train_idx], history[test_idx]\n    clock_tr, clock_te = clock[train_idx], clock[test_idx]\n    target_tr = target[train_idx]\n    mask_tr = mask[train_idx]\n    \n    n_tr = len(train_idx)\n    n_te = len(test_idx)\n    \n    # Step 1: per-horizon anchor blending\n    anchor_h = np.zeros(n_h)\n    for h in range(n_h):\n        m = mask_tr[:, h, :]\n        best_mae = float('inf')\n        for w in np.linspace(0, 0.30, 31):\n            pred = (1-w)*base_tr[:,h,:][m] + w*anchor_tr[:,h,:][m]\n            mae = np.abs(pred - target_tr[:,h,:][m]).mean()\n            if mae < best_mae:\n                best_mae = mae\n                anchor_h[h] = w\n    \n    # Step 2: per-node-horizon anchor blending with shrinkage\n    pna_shrink = 0.3\n    anchor_nh = np.zeros((n_h, n_n))\n    for h in range(n_h):\n        for n in range(n_n):\n            m = mask_tr[:, h, n]\n            if m.sum() > 15:\n                best_mae = float('inf')\n                best_w = anchor_h[h]\n                for w in np.linspace(0, 0.40, 21):\n                    pred = (1-w)*base_tr[:,h,n][m] + w*anchor_tr[:,h,n][m]\n                    mae = np.abs(pred - target_tr[:,h,n][m]).mean()\n                    if mae < best_mae:\n                        best_mae = mae\n                        best_w = w\n                anchor_nh[h,n] = best_w\n            else:\n                anchor_nh[h,n] = anchor_h[h]\n    anchor_nh = pna_shrink * anchor_nh + (1-pna_shrink) * anchor_h[:, np.newaxis]\n    \n    blended = (1 - anchor_nh[np.newaxis,:,:]) * base_te + anchor_nh[np.newaxis,:,:] * anchor_te\n    \n    # Step 3: per-horizon median bias\n    h_bias = np.zeros(n_h)\n    for h in range(n_h):\n        m = mask_tr[:, h, :]\n        h_bias[h] = np.median(((1-anchor_nh[np.newaxis,:,:])*base_tr + anchor_nh[np.newaxis,:,:]*anchor_tr)[:,h,:][m] - target_tr[:,h,:][m])\n    corrected = blended - h_bias[np.newaxis,:,np.newaxis]\n    \n    # Baseline MAE after basic steps\n    mask_te = mask[test_idx]\n    target_te = target[test_idx]\n    base_mae = np.abs(base_te[mask_te] - target_te[mask_te]).mean()\n    basic_mae = np.abs(corrected[mask_te] - target_te[mask_te]).mean()\n    \n    return base_mae, basic_mae, corrected\n\n# 5-fold CV\nkf = KFold(n_splits=5, shuffle=True, random_state=42)\nbase_maes = []\nbasic_maes = []\n\nfor fold, (tr, te) in enumerate(kf.split(range(n_s))):\n    bm, bsm, _ = run_method(base, anchor, history, clock, target, mask, tr, te)\n    base_maes.append(bm)\n    basic_maes.append(bsm)\n    print(f\\\"Fold {fold}: base={bm:.4f}, basic={bsm:.4f}, improvement={bm-bsm:.4f}\\\")\n\nprint(f\\\"\\\\nMean base MAE: {np.mean(base_maes):.4f}\\\")\nprint(f\\\"Mean basic MAE: {np.mean(basic_maes):.4f}\\\")\nprint(f\\\"Mean improvement: {np.mean(base_maes)-np.mean(basic_maes):.4f}\\\")\nEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/sh -lc \"python3 << 'EOF'\nimport numpy as np\nfrom sklearn.linear_model import Ridge, Lasso\nfrom sklearn.model_selection import KFold\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_targ = np.load('/workspace/public_assets/train_targets.npz')\ngraph = np.load('/workspace/public_assets/graph.npz')\n\nbase = train_feat['base'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\ntarget = train_targ['target'].astype(np.float64)\nadj = graph['adjacency'].astype(np.float64)\n\nn_s, n_h, n_n = base.shape\nmask = np.isfinite(target) & (target > 0)\n\n# ============= Current method replication for CV =============\ndef run_method(base, anchor, history, clock, target, mask, train_idx, test_idx):\n    \\\"\\\"\\\"Run current v26 pipeline on CV fold.\\\"\\\"\\\"\n    # Fit on train\n    base_tr, base_te = base[train_idx], base[test_idx]\n    anchor_tr, anchor_te = anchor[train_idx], anchor[test_idx]\n    history_tr, history_te = history[train_idx], history[test_idx]\n    clock_tr, clock_te = clock[train_idx], clock[test_idx]\n    target_tr = target[train_idx]\n    mask_tr = mask[train_idx]\n    \n    n_tr = len(train_idx)\n    n_te = len(test_idx)\n    \n    # Step 1: per-horizon anchor blending\n    anchor_h = np.zeros(n_h)\n    for h in range(n_h):\n        m = mask_tr[:, h, :]\n        best_mae = float('inf')\n        for w in np.linspace(0, 0.30, 31):\n            pred = (1-w)*base_tr[:,h,:][m] + w*anchor_tr[:,h,:][m]\n            mae = np.abs(pred - target_tr[:,h,:][m]).mean()\n            if mae < best_mae:\n                best_mae = mae\n                anchor_h[h] = w\n    \n    # Step 2: per-node-horizon anchor blending with shrinkage\n    pna_shrink = 0.3\n    anchor_nh = np.zeros((n_h, n_n))\n    for h in range(n_h):\n        for n in range(n_n):\n            m = mask_tr[:, h, n]\n            if m.sum() > 15:\n                best_mae = float('inf')\n                best_w = anchor_h[h]\n                for w in np.linspace(0, 0.40, 21):\n                    pred = (1-w)*base_tr[:,h,n][m] + w*anchor_tr[:,h,n][m]\n                    mae = np.abs(pred - target_tr[:,h,n][m]).mean()\n                    if mae < best_mae:\n                        best_mae = mae\n                        best_w = w\n                anchor_nh[h,n] = best_w\n            else:\n                anchor_nh[h,n] = anchor_h[h]\n    anchor_nh = pna_shrink * anchor_nh + (1-pna_shrink) * anchor_h[:, np.newaxis]\n    \n    blended = (1 - anchor_nh[np.newaxis,:,:]) * base_te + anchor_nh[np.newaxis,:,:] * anchor_te\n    \n    # Step 3: per-horizon median bias\n    h_bias = np.zeros(n_h)\n    for h in range(n_h):\n        m = mask_tr[:, h, :]\n        h_bias[h] = np.median(((1-anchor_nh[np.newaxis,:,:])*base_tr + anchor_nh[np.newaxis,:,:]*anchor_tr)[:,h,:][m] - target_tr[:,h,:][m])\n    corrected = blended - h_bias[np.newaxis,:,np.newaxis]\n    \n    # Baseline MAE after basic steps\n    mask_te = mask[test_idx]\n    target_te = target[test_idx]\n    base_mae = np.abs(base_te[mask_te] - target_te[mask_te]).mean()\n    basic_mae = np.abs(corrected[mask_te] - target_te[mask_te]).mean()\n    \n    return base_mae, basic_mae, corrected\n\n# 5-fold CV\nkf = KFold(n_splits=5, shuffle=True, random_state=42)\nbase_maes = []\nbasic_maes = []\n\nfor fold, (tr, te) in enumerate(kf.split(range(n_s))):\n    bm, bsm, _ = run_method(base, anchor, history, clock, target, mask, tr, te)\n    base_maes.append(bm)\n    basic_maes.append(bsm)\n    print(f\\\"Fold {fold}: base={bm:.4f}, basic={bsm:.4f}, improvement={bm-bsm:.4f}\\\")\n\nprint(f\\\"\\\\nMean base MAE: {np.mean(base_maes):.4f}\\\")\nprint(f\\\"Mean basic MAE: {np.mean(basic_maes):.4f}\\\")\nprint(f\\\"Mean improvement: {np.mean(base_maes)-np.mean(basic_maes):.4f}\\\")\nEOF\n\"","aggregated_output":"Fold 0: base=15.4729, basic=15.0576, improvement=0.4153\nFold 1: base=15.2269, basic=14.7040, improvement=0.5229\nFold 2: base=15.9560, basic=15.4248, improvement=0.5311\nFold 3: base=15.0835, basic=14.5561, improvement=0.5274\nFold 4: base=13.0956, basic=12.4660, improvement=0.6296\n\nMean base MAE: 14.9670\nMean basic MAE: 14.4417\nMean improvement: 0.5253\n","exit_code":0,"status":"completed"}}

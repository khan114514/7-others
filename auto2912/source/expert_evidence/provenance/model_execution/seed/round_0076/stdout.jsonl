{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/sh -lc \"python3 << 'EOF'\nimport numpy as np\nfrom sklearn.linear_model import Ridge\nfrom sklearn.model_selection import KFold\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_targ = np.load('/workspace/public_assets/train_targets.npz')\ngraph = np.load('/workspace/public_assets/graph.npz')\n\nbase = train_feat['base'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\ntarget = train_targ['target'].astype(np.float64)\nadj = graph['adjacency'].astype(np.float64)\n\nn_s, n_h, n_n = base.shape\nmask = np.isfinite(target) & (target > 0)\n\n# Build graph Laplacian for smoothing\ndeg = adj.sum(axis=1)\n# Normalized adjacency for smoothing\nD_inv_sqrt = np.diag(1.0 / np.sqrt(np.maximum(deg, 1e-6)))\nadj_norm = D_inv_sqrt @ adj @ D_inv_sqrt\n\n# Test: does graph smoothing of per-node bias help?\n# First compute raw per-node bias\nnode_bias_raw = np.zeros(n_n)\nfor n in range(n_n):\n    m = mask[:, :, n]\n    if m.sum() > 5:\n        node_bias_raw[n] = np.median((base - target)[:, :, n][m])\n\n# Smooth it with graph\ndef smooth_graph(x, adj_norm, n_iter=3):\n    x = x.copy()\n    for _ in range(n_iter):\n        x = 0.7 * x + 0.3 * (adj_norm @ x)\n    return x\n\nnode_bias_smooth = smooth_graph(node_bias_raw, adj_norm, 3)\n\n# Compare raw vs smoothed node bias in CV\nprint(\\\"=== Graph-smoothed node bias vs raw node bias ===\\\")\nkf = KFold(n_splits=5, shuffle=True, random_state=42)\n\nbase_maes = []\nraw_maes = []\nsmooth_maes = []\n\nfor tr, te in kf.split(range(n_s)):\n    b_mae = np.abs(base[te][mask[te]] - target[te][mask[te]]).mean()\n    base_maes.append(b_mae)\n    \n    # Raw per-node bias from training\n    nb_raw = np.zeros(n_n)\n    for n in range(n_n):\n        m = mask[tr, :, n]\n        if m.sum() > 5:\n            nb_raw[n] = np.median((base[tr] - target[tr])[:, :, n][m])\n    \n    pred = base[te] - nb_raw[np.newaxis, np.newaxis, :]\n    r_mae = np.abs(pred[mask[te]] - target[te][mask[te]]).mean()\n    raw_maes.append(r_mae)\n    \n    # Smoothed per-node bias\n    nb_smooth = smooth_graph(nb_raw, adj_norm, 3)\n    pred = base[te] - nb_smooth[np.newaxis, np.newaxis, :]\n    s_mae = np.abs(pred[mask[te]] - target[te][mask[te]]).mean()\n    smooth_maes.append(s_mae)\n\nprint(f\\\"Base:  {np.mean(base_maes):.4f}\\\")\nprint(f\\\"Raw:   {np.mean(raw_maes):.4f}  (improvement: {np.mean(base_maes)-np.mean(raw_maes):.4f})\\\")\nprint(f\\\"Smooth:{np.mean(smooth_maes):.4f}  (improvement: {np.mean(base_maes)-np.mean(smooth_maes):.4f})\\\")\nprint()\n\n# Now test: clock-based bias patterns\n# Idea: bias varies by time of day\nprint(\\\"=== Clock-based bias patterns ===\\\")\n# Bin clock values and measure bias per bin per horizon\nclock_vals = clock[:, 0, 0]  # same across nodes at h=0\nprint(f\\\"Unique clock values: {len(np.unique(clock_vals))}\\\")\nprint(f\\\"Clock values range: {clock_vals.min():.3f} - {clock_vals.max():.3f}\\\")\n\n# Group by time-of-day bin and see if bias structure varies\nn_bins = 6\nbin_edges = np.linspace(0, 1, n_bins + 1)\nclock_bin = np.digitize(clock[:, 0, 0], bin_edges[1:-1])  # per sample\n\nfor b in range(n_bins):\n    idx = clock_bin == b\n    if idx.sum() == 0:\n        continue\n    m = mask[idx]\n    bias = (base[idx][m] - target[idx][m]).mean()\n    print(f\\\"  Bin {b} (n={idx.sum()}): mean_bias={bias:.3f}\\\")\n\nprint()\n\n# Let's check: what if we use clock features for sample-level correction\n# using a richer set than the current method\nprint(\\\"=== Richer sample-level features for bias correction ===\\\")\n\ndef build_sample_feats_v2(base, anchor, history, clock):\n    \\\"\\\"\\\"More features for per-sample bias prediction.\\\"\\\"\\\"\n    n_s, n_h, n_n = base.shape\n    feats_list = []\n    \n    # Base statistics\n    feats_list.append(base.mean(axis=2)[:, :, np.newaxis])\n    feats_list.append(base.std(axis=2)[:, :, np.newaxis])\n    feats_list.append(np.median(base, axis=2)[:, :, np.newaxis])\n    \n    # Anchor statistics\n    feats_list.append(anchor.mean(axis=2)[:, :, np.newaxis])\n    feats_list.append((base - anchor).mean(axis=2)[:, :, np.newaxis])\n    \n    # History - use all 12 steps summary\n    for i in range(12):\n        h_mean = history[:, i, :].mean(axis=1)\n        feats_list.append(np.tile(h_mean[:, np.newaxis, np.newaxis], (1, n_h, 1)))\n    \n    # History stats\n    hist_last = history[:, -1, :].mean(axis=1)\n    hist_mean = history.mean(axis=(1,2))\n    hist_trend = (history[:, -1, :] - history[:, 0, :]).mean(axis=1) / 12.0\n    hist_std = history.std(axis=(1,2))\n    feats_list.append(np.tile(hist_last[:, np.newaxis, np.newaxis], (1, n_h, 1)))\n    feats_list.append(np.tile(hist_mean[:, np.newaxis, np.newaxis], (1, n_h, 1)))\n    feats_list.append(np.tile(hist_trend[:, np.newaxis, np.newaxis], (1, n_h, 1)))\n    feats_list.append(np.tile(hist_std[:, np.newaxis, np.newaxis], (1, n_h, 1)))\n    \n    # Clock features (richer)\n    for k in [1, 2, 3, 4]:\n        feats_list.append(np.sin(2 * k * np.pi * clock[:, :, 0:1]))\n        feats_list.append(np.cos(2 * k * np.pi * clock[:, :, 0:1]))\n    \n    # Interaction: base * clock\n    feats_list.append(base.mean(axis=2, keepdims=True) * np.sin(2 * np.pi * clock[:, :, 0:1]))\n    feats_list.append(base.mean(axis=2, keepdims=True) * np.cos(2 * np.pi * clock[:, :, 0:1]))\n    \n    return np.concatenate(feats_list, axis=2)\n\n# Test with CV\nsample_feats_v2 = build_sample_feats_v2(base, anchor, history, clock)\nprint(f\\\"Sample features v2 shape: {sample_feats_v2.shape}\\\")\n\n# Compute per-sample mean bias\nsample_bias = np.zeros((n_s, n_h))\nfor s in range(n_s):\n    for h in range(n_h):\n        m = mask[s, h, :]\n        if m.sum() > 10:\n            sample_bias[s, h] = np.median(base[s, h, :][m] - target[s, h, :][m])\n\n# Per-horizon ridge regression for sample bias\nfor h in [0, 3, 6, 9, 11]:\n    base_mae_cv = []\n    ridge_mae_cv = []\n    for tr, te in kf.split(range(n_s)):\n        X_tr = sample_feats_v2[tr, h, :]\n        y_tr = sample_bias[tr, h]\n        X_te = sample_feats_v2[te, h, :]\n        \n        mu = X_tr.mean(axis=0)\n        sd = X_tr.std(axis=0)\n        sd[sd < 1e-6] = 1.0\n        X_tr_s = (X_tr - mu) / sd\n        X_te_s = (X_te - mu) / sd\n        \n        for alpha_r in [0.1, 1, 10, 100, 1000, 10000]:\n            model = Ridge(alpha=alpha_r, fit_intercept=True)\n            model.fit(X_tr_s, y_tr)\n            pred_bias = model.predict(X_te_s)\n            \n            # Apply to test: correct each sample at horizon h\n            pred = base[te, h, :] - pred_bias[:, np.newaxis]\n            m_te = mask[te, h, :]\n            mae = np.abs(pred[m_te] - target[te, h, :][m_te]).mean()\n            # store best\n        pass\n    \n    # Print just base for now\n    print(f\\\"  h={h}: sample_bias_std={sample_bias[:,h].std():.3f}\\\")\n\nEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

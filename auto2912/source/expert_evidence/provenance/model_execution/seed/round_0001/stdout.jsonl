{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 << 'EOF'\nimport numpy as np\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_targ = np.load('/workspace/public_assets/train_targets.npz')\ngraph = np.load('/workspace/public_assets/graph.npz')\n\nbase = train_feat['base']\nhistory = train_feat['history']\nanchor = train_feat['anchor']\nclock = train_feat['clock']\ntarget = train_targ['target']\nmask = np.isfinite(target) & (target > 0)\nadj = graph['adjacency']\n\nn_samples, n_horizons, n_nodes = base.shape\n\ndef loso_cv(correction_fn):\n    errors = []\n    for i in range(n_samples):\n        train_mask = np.ones(n_samples, dtype=bool)\n        train_mask[i] = False\n        corrected = correction_fn(base, target, mask, train_mask, i)\n        m_test = mask[i]\n        errors.append(np.abs(corrected - target[i])[m_test].mean())\n    return np.mean(errors)\n\n# === 1. Graph-smoothed per-node bias ===\ndef graph_smoothed_bias(base, target, mask, train_mask, test_idx):\n    # Compute per-node bias\n    node_bias = np.zeros(n_nodes)\n    for n in range(n_nodes):\n        m = mask[train_mask, :, n]\n        node_bias[n] = (base[train_mask, :, n][m] - target[train_mask, :, n][m]).mean()\n    \n    # Smooth with graph: bias_smoothed = (1-alpha)*bias + alpha*adj_avg\n    # Normalize adjacency\n    deg = adj.sum(axis=1, keepdims=True)\n    deg[deg == 0] = 1\n    adj_norm = adj / deg\n    \n    for alpha in [0.3, 0.5, 0.7]:\n        smooth_bias = node_bias.copy()\n        for _ in range(2):\n            smooth_bias = (1-alpha) * smooth_bias + alpha * (adj_norm @ smooth_bias)\n    \n    # Use alpha=0.5, 2 iterations\n    alpha = 0.5\n    smooth_bias = node_bias.copy()\n    for _ in range(2):\n        smooth_bias = (1-alpha) * smooth_bias + alpha * (adj_norm @ smooth_bias)\n    \n    return base[test_idx] - smooth_bias[np.newaxis, :]\n\nprint(f'Graph-smoothed node bias MAE: {loso_cv(graph_smoothed_bias):.4f}')\n\n# === 2. Clock-binned bias (time of day) ===\ndef clock_binned_bias(base, target, mask, train_mask, test_idx):\n    n_bins = 8\n    clock_vals = clock[train_mask]  # (n_train, 12, 170)\n    # clock is same per sample-horizon (same across nodes)\n    clock_h = clock[train_mask, :, 0]  # (n_train, 12)\n    \n    # Bin clock values\n    bins = np.linspace(0, 1, n_bins+1)\n    bin_idx = np.digitize(clock[test_idx, :, 0], bins[1:-1])  # (12,)\n    \n    # Compute per-bin bias\n    bin_bias = np.zeros(n_bins)\n    for b in range(n_bins):\n        # find all (sample, horizon) pairs in this bin\n        clock_all = clock[train_mask, :, 0].flatten()  # (n_train*12,)\n        bin_mask_all = np.digitize(clock_all, bins[1:-1]) == b\n        \n        base_flat = base[train_mask].reshape(-1, n_nodes)[bin_mask_all]\n        target_flat = target[train_mask].reshape(-1, n_nodes)[bin_mask_all]\n        mask_flat = mask[train_mask].reshape(-1, n_nodes)[bin_mask_all]\n        \n        if mask_flat.sum() > 0:\n            bin_bias[b] = (base_flat[mask_flat] - target_flat[mask_flat]).mean()\n    \n    bias_per_horizon = bin_bias[bin_idx]  # (12,)\n    return base[test_idx] - bias_per_horizon[:, np.newaxis]\n\nprint(f'Clock-binned bias (8 bins) MAE: {loso_cv(clock_binned_bias):.4f}')\n\n# === 3. Shrunken per-node bias (toward global mean) ===\ndef shrunken_node_bias(alpha):\n    def fn(base, target, mask, train_mask, test_idx):\n        global_bias = (base[train_mask][mask[train_mask]] - target[train_mask][mask[train_mask]]).mean()\n        node_bias = np.zeros(n_nodes)\n        for n in range(n_nodes):\n            m = mask[train_mask, :, n]\n            node_bias[n] = (base[train_mask, :, n][m] - target[train_mask, :, n][m]).mean()\n        shrunk = alpha * node_bias + (1 - alpha) * global_bias\n        return base[test_idx] - shrunk[np.newaxis, :]\n    return fn\n\nfor a in [0.3, 0.5, 0.7, 0.9, 1.0]:\n    print(f'Shrunken node bias (a={a}): {loso_cv(shrunken_node_bias(a)):.4f}')\n\n# === 4. Per-node multiplicative correction (shrunken) ===\ndef shrunken_node_mult(alpha):\n    def fn(base, target, mask, train_mask, test_idx):\n        global_ratio = target[train_mask][mask[train_mask]].mean() / base[train_mask][mask[train_mask]].mean()\n        node_ratio = np.ones(n_nodes)\n        for n in range(n_nodes):\n            m = mask[train_mask, :, n]\n            b = base[train_mask, :, n][m]\n            t = target[train_mask, :, n][m]\n            valid = b > 0.1\n            if valid.sum() > 0:\n                node_ratio[n] = np.median(t[valid] / b[valid])\n        shrunk = alpha * node_ratio + (1 - alpha) * global_ratio\n        return base[test_idx] * shrunk[np.newaxis, :]\n    return fn\n\nfor a in [0.3, 0.5, 0.7, 0.9, 1.0]:\n    print(f'Shrunken node mult (a={a}): {loso_cv(shrunken_node_mult(a)):.4f}')\n\nEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_targ = np.load('/workspace/public_assets/train_targets.npz')\n\nbase = train_feat['base']\nhistory = train_feat['history']\nanchor = train_feat['anchor']\nclock = train_feat['clock']\ntarget = train_targ['target']\nmask = np.isfinite(target) & (target > 0)\n\n# Per-node bias\nnode_bias = np.array([(base[:, :, i] - target[:, :, i])[mask[:, :, i]].mean() for i in range(170)])\nprint(f'Node bias range: {node_bias.min():.3f} to {node_bias.max():.3f}')\nprint(f'Node bias std: {node_bias.std():.3f}')\n\n# Simple per-node bias correction\ncorrected = base - node_bias[np.newaxis, np.newaxis, :]\nprint(f'Per-node bias corrected MAE: {np.abs(corrected - target)[mask].mean():.4f}')\n\n# Per-node per-horizon bias\nnode_horizon_bias = np.zeros((12, 170))\nfor h in range(12):\n    for n in range(170):\n        m = mask[:, h, n]\n        if m.sum() > 0:\n            node_horizon_bias[h, n] = (base[:, h, n] - target[:, h, n])[m].mean()\n\ncorrected2 = base - node_horizon_bias[np.newaxis, :, :]\nprint(f'Per-node-horizon bias corrected MAE: {np.abs(corrected2 - target)[mask].mean():.4f}')\n\n# Now let's try linear regression using features\n# Flatten: each (sample, horizon, node) is a sample\n# Features: base, last_history, avg_history, clock, anchor\nfrom sklearn.linear_model import Ridge\n\ndef make_features(base, history, anchor, clock):\n    n_s, n_h, n_n = base.shape\n    last_hist = history[:, -1, :][:, np.newaxis, :].repeat(n_h, axis=1)\n    avg_hist = history.mean(axis=1)[:, np.newaxis, :].repeat(n_h, axis=1)\n    std_hist = history.std(axis=1)[:, np.newaxis, :].repeat(n_h, axis=1)\n    # horizon index as feature\n    horizon_idx = np.arange(n_h)[np.newaxis, :, np.newaxis].repeat(n_s, axis=0).repeat(n_n, axis=2)\n    \n    feats = np.stack([\n        base.flatten(),\n        anchor.flatten(),\n        last_hist.flatten(),\n        avg_hist.flatten(),\n        std_hist.flatten(),\n        clock.flatten(),\n        horizon_idx.flatten(),\n        (base - anchor).flatten(),\n        (base - last_hist).flatten(),\n    ], axis=1)\n    return feats\n\nX_train = make_features(base, history, anchor, clock)\ny_train = target.flatten()\nm_flat = mask.flatten()\n\nX_train_valid = X_train[m_flat]\ny_train_valid = y_train[m_flat]\n\nprint(f'\\\\nTraining Ridge regression on {X_train_valid.shape[0]} samples...')\nmodel = Ridge(alpha=1.0)\nmodel.fit(X_train_valid, y_train_valid)\npred_train = model.predict(X_train_valid)\nmae_ridge = np.abs(pred_train - y_train_valid).mean()\nprint(f'Ridge train MAE: {mae_ridge:.4f}')\nprint(f'Coefficients: {model.coef_}')\nprint(f'Intercept: {model.intercept_}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

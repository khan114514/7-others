{"type":"item.started","item":{"id":"item_80","type":"command_execution","command":"/bin/sh -lc \"cat > /workspace/solution/method.py << 'EOF'\n\\\"\\\"\\\"Calibrated forecasting using shrunken per-node-horizon bias correction.\\\"\\\"\\\"\nimport numpy as np\n\n\ndef fit(features, targets, seed):\n    rng = np.random.RandomState(seed)\n    base = features['base'].astype(np.float64)\n    target = targets.astype(np.float64)\n    anchor = features['anchor'].astype(np.float64)\n    \n    n_samples, n_horizons, n_nodes = base.shape\n    mask = np.isfinite(target) & (target > 0)\n    \n    # Global per-horizon bias\n    bias_h = np.zeros(n_horizons, dtype=np.float64)\n    for h in range(n_horizons):\n        m = mask[:, h, :]\n        if m.sum() > 0:\n            bias_h[h] = (base[:, h, :][m] - target[:, h, :][m]).mean()\n    \n    # Per-node-horizon bias\n    bias_nh = np.zeros((n_horizons, n_nodes), dtype=np.float64)\n    for h in range(n_horizons):\n        for n in range(n_nodes):\n            m = mask[:, h, n]\n            if m.sum() > 0:\n                bias_nh[h, n] = (base[:, h, n][m] - target[:, h, n][m]).mean()\n            else:\n                bias_nh[h, n] = bias_h[h]\n    \n    # Shrink per-node-horizon bias toward per-horizon global\n    shrink_alpha = 0.3\n    shrunk_bias = shrink_alpha * bias_nh + (1.0 - shrink_alpha) * bias_h[:, np.newaxis]\n    \n    # Per-horizon anchor correction coefficient (grows with horizon)\n    anchor_scale = 0.03\n    anchor_coeffs = anchor_scale * np.linspace(0, 1, n_horizons)\n    \n    state = {\n        'method': 'shrunken_nh_bias_anchor',\n        'version': 1,\n        'shrunk_bias': shrunk_bias.astype(np.float32),\n        'anchor_coeffs': anchor_coeffs.astype(np.float32),\n    }\n    return state\n\n\ndef predict(state, features):\n    base = np.array(features['base'], dtype=np.float32, copy=True)\n    anchor = np.array(features['anchor'], dtype=np.float32, copy=True)\n    \n    bias = state['shrunk_bias']  # (12, 170)\n    anchor_coeffs = state['anchor_coeffs']  # (12,)\n    \n    # Apply bias correction\n    result = base - bias[np.newaxis, :, :]\n    \n    # Apply anchor correction\n    anchor_diff = anchor - base\n    result = result + anchor_coeffs[np.newaxis, :, np.newaxis] * anchor_diff\n    \n    # Ensure non-negative\n    result = np.maximum(result, 0.0)\n    \n    return result.astype(np.float32)\nEOF\necho \\\"fixed\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

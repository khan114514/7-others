{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_targ = np.load('/workspace/public_assets/train_targets.npz')\n\nbase = train_feat['base']      # (74, 12, 170)\nhistory = train_feat['history'] # (74, 12, 170)\nanchor = train_feat['anchor']   # (74, 12, 170)\nclock = train_feat['clock']     # (74, 12, 170)\ntarget = train_targ['target']   # (74, 12, 170)\n\nprint('=== Basic Stats ===')\nprint(f'base:    mean={base.mean():.3f}, std={base.std():.3f}, min={base.min():.3f}, max={base.max():.3f}')\nprint(f'target:  mean={target.mean():.3f}, std={target.std():.3f}, min={target.min():.3f}, max={target.max():.3f}')\nprint(f'history: mean={history.mean():.3f}, std={history.std():.3f}')\nprint(f'anchor:  mean={anchor.mean():.3f}, std={anchor.std():.3f}')\nprint(f'clock:   mean={clock.mean():.3f}, std={clock.std():.3f}, min={clock.min():.3f}, max={clock.max():.3f}')\n\n# Mask: finite targets > 0\nmask = np.isfinite(target) & (target > 0)\nprint(f'\\\\nValid target fraction: {mask.mean():.4f}')\n\n# Overall MAE of base forecast\nabs_err = np.abs(base - target)\nmae_base = abs_err[mask].mean()\nprint(f'Base forecast MAE (masked): {mae_base:.4f}')\n\n# Per-horizon MAE\nprint('\\\\n=== Per-horizon MAE ===')\nfor h in range(12):\n    m = mask[:, h, :]\n    err_h = abs_err[:, h, :]\n    print(f'  horizon {h}: {err_h[m].mean():.4f}')\n\n# Per-node MAE (top/bottom)\nnode_mae = np.array([abs_err[:, :, i][mask[:, :, i]].mean() for i in range(170)])\nprint(f'\\\\nNode MAE range: {node_mae.min():.3f} - {node_mae.max():.3f}, median={np.median(node_mae):.3f}')\n\n# Bias analysis\nbias = base - target\nprint(f'\\\\n=== Bias ===')\nprint(f'Mean bias: {bias[mask].mean():.4f}')\nprint(f'Median bias: {np.median(bias[mask]):.4f}')\n\n# Per-horizon bias\nprint('\\\\nPer-horizon bias:')\nfor h in range(12):\n    m = mask[:, h, :]\n    print(f'  horizon {h}: {bias[:, h, :][m].mean():.4f}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

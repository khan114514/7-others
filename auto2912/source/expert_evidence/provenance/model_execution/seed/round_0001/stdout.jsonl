{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np\nfrom sklearn.linear_model import Ridge\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_targ = np.load('/workspace/public_assets/train_targets.npz')\n\nbase = train_feat['base']\nhistory = train_feat['history']\nanchor = train_feat['anchor']\nclock = train_feat['clock']\ntarget = train_targ['target']\nmask = np.isfinite(target) & (target > 0)\n\n# Let's try leave-one-sample-out cross validation for per-node bias correction\n# to estimate generalization\nn_samples = base.shape[0]\nerrors_node_bias = []\nerrors_node_horizon_bias = []\nerrors_base = []\n\nfor i in range(n_samples):\n    train_mask = np.ones(n_samples, dtype=bool)\n    train_mask[i] = False\n    test_idx = i\n    \n    # Per-node bias on training\n    node_bias = np.zeros(170)\n    for n in range(170):\n        m = mask[train_mask, :, n]\n        node_bias[n] = (base[train_mask, :, n] - target[train_mask, :, n])[m].mean()\n    \n    corrected = base[test_idx] - node_bias[np.newaxis, :]\n    m_test = mask[test_idx]\n    errors_node_bias.append(np.abs(corrected - target[test_idx])[m_test].mean())\n    errors_base.append(np.abs(base[test_idx] - target[test_idx])[m_test].mean())\n\nprint(f'Base MAE (LOSO-CV): {np.mean(errors_base):.4f}')\nprint(f'Per-node bias MAE (LOSO-CV): {np.mean(errors_node_bias):.4f}')\n\n# Let's also look at multiplicative correction\n# target = alpha * base\nerrors_mult = []\nfor i in range(n_samples):\n    train_mask = np.ones(n_samples, dtype=bool)\n    train_mask[i] = False\n    test_idx = i\n    \n    alpha = np.zeros(170)\n    for n in range(170):\n        m = mask[train_mask, :, n]\n        b = base[train_mask, :, n][m]\n        t = target[train_mask, :, n][m]\n        # avoid division by zero\n        valid = b > 0.1\n        if valid.sum() > 0:\n            alpha[n] = np.median(t[valid] / b[valid])\n        else:\n            alpha[n] = 1.0\n    \n    corrected = base[test_idx] * alpha[np.newaxis, :]\n    m_test = mask[test_idx]\n    errors_mult.append(np.abs(corrected - target[test_idx])[m_test].mean())\n\nprint(f'Per-node mult (median ratio) MAE (LOSO-CV): {np.mean(errors_mult):.4f}')\n\n# Combined: bias + scaling?\nerrors_combined = []\nfor i in range(n_samples):\n    train_mask = np.ones(n_samples, dtype=bool)\n    train_mask[i] = False\n    test_idx = i\n    \n    # Fit per node: target = a * base + b\n    node_params = np.zeros((170, 2))\n    for n in range(170):\n        m = mask[train_mask, :, n]\n        b = base[train_mask, :, n][m]\n        t = target[train_mask, :, n][m]\n        if len(b) > 2:\n            # simple linear regression\n            a, b_intercept = np.polyfit(b, t, 1)\n            node_params[n] = [a, b_intercept]\n        else:\n            node_params[n] = [1.0, 0.0]\n    \n    corrected = base[test_idx] * node_params[:, 0][np.newaxis, :] + node_params[:, 1][np.newaxis, :]\n    m_test = mask[test_idx]\n    errors_combined.append(np.abs(corrected - target[test_idx])[m_test].mean())\n\nprint(f'Per-node linear fit MAE (LOSO-CV): {np.mean(errors_combined):.4f}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

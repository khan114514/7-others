{"type":"item.started","item":{"id":"item_113","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 << 'PYEOF'\nimport numpy as np\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_targ = np.load('/workspace/public_assets/train_targets.npz')\ngraph = np.load('/workspace/public_assets/graph.npz')\n\nbase = train_feat['base'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\ntarget = train_targ['target'].astype(np.float64)\nadj = graph['adjacency'].astype(np.float64)\nmask = np.isfinite(target) & (target > 0)\n\nn_samples, n_horizons, n_nodes = base.shape\n\ndef kfold_cv_fast(make_predictor, n_splits=5, seed=42):\n    rng = np.random.RandomState(seed)\n    indices = rng.permutation(n_samples)\n    fold_size = n_samples // n_splits\n    errors = []\n    for fold in range(n_splits):\n        test_start = fold * fold_size\n        test_end = test_start + fold_size if fold < n_splits-1 else n_samples\n        test_idx = indices[test_start:test_end]\n        train_idx = np.concatenate([indices[:test_start], indices[test_end:]])\n        \n        predictor = make_predictor(base[train_idx], history[train_idx], \n                                   anchor[train_idx], clock[train_idx],\n                                   target[train_idx], mask[train_idx])\n        \n        pred_all = predictor(base[test_idx], history[test_idx], \n                             anchor[test_idx], clock[test_idx])\n        \n        m_test = mask[test_idx]\n        errors.append(np.abs(pred_all - target[test_idx])[m_test].mean())\n    return np.mean(errors)\n\n# Baseline\ndef make_base():\n    def factory(*args):\n        return lambda b, h, a, c: b\n    return factory\n\nprint(f\\\"Baseline: {kfold_cv_fast(make_base()):.4f}\\\")\n\n# Method: Per-node linear regression (target = slope * base + intercept)\n# Shrunken toward global slope/intercept\ndef make_node_linear(shrink_slope, shrink_intercept):\n    def factory(b_tr, h_tr, a_tr, c_tr, t_tr, m_tr):\n        # Global parameters\n        b_flat = b_tr[m_tr]\n        t_flat = t_tr[m_tr]\n        global_slope = np.cov(b_flat, t_flat)[0, 1] / np.var(b_flat)\n        global_intercept = np.mean(t_flat) - global_slope * np.mean(b_flat)\n        \n        # Per-node parameters\n        node_slope = np.ones(n_nodes) * global_slope\n        node_intercept = np.zeros(n_nodes) * global_intercept\n        \n        for n in range(n_nodes):\n            m = m_tr[:, :, n]\n            b_n = b_tr[:, :, n][m]\n            t_n = t_tr[:, :, n][m]\n            if len(b_n) > 10:\n                var_b = np.var(b_n)\n                if var_b > 1e-6:\n                    s = np.cov(b_n, t_n)[0, 1] / var_b\n                    i = np.mean(t_n) - s * np.mean(b_n)\n                    node_slope[n] = s\n                    node_intercept[n] = i\n        \n        # Shrink\n        node_slope = shrink_slope * node_slope + (1 - shrink_slope) * global_slope\n        node_intercept = shrink_intercept * node_intercept + (1 - shrink_intercept) * global_intercept\n        \n        def predict(b, h, a, c):\n            return b * node_slope[np.newaxis, np.newaxis, :] + node_intercept[np.newaxis, np.newaxis, :]\n        return predict\n    return factory\n\nprint(\\\"\\\\n=== Per-node linear calibration ===\\\")\nbest_mae = float('inf')\nbest_cfg = None\nfor s_s in [0.1, 0.2, 0.3, 0.5, 0.7]:\n    for s_i in [0.1, 0.2, 0.3, 0.5, 0.7, 1.0]:\n        mae = kfold_cv_fast(make_node_linear(s_s, s_i))\n        if mae < best_mae:\n            best_mae = mae\n            best_cfg = (s_s, s_i)\n        print(f\\\"  shrink_s={s_s}, shrink_i={s_i}: {mae:.4f}\\\")\nprint(f\\\"Best: {best_cfg}, MAE={best_mae:.4f}\\\")\n\n# Method: Per-node-horizon bias + per-node slope (combined)\n# For each node: target_h = slope * base_h + bias_h (bias varies by horizon)\ndef make_node_lin_nh_bias(shrink_slope, shrink_nh_bias):\n    def factory(b_tr, h_tr, a_tr, c_tr, t_tr, m_tr):\n        # Global slope\n        b_flat = b_tr[m_tr]\n        t_flat = t_tr[m_tr]\n        global_slope = np.cov(b_flat, t_flat)[0, 1] / np.var(b_flat)\n        \n        # Per-node slope\n        node_slope = np.ones(n_nodes) * global_slope\n        for n in range(n_nodes):\n            m = m_tr[:, :, n]\n            b_n = b_tr[:, :, n][m]\n            t_n = t_tr[:, :, n][m]\n            if len(b_n) > 10:\n                var_b = np.var(b_n)\n                if var_b > 1e-6:\n                    node_slope[n] = np.cov(b_n, t_n)[0, 1] / var_b\n        \n        node_slope = shrink_slope * node_slope + (1 - shrink_slope) * global_slope\n        \n        # Apply slope to get scaled base\n        scaled_base = b_tr * node_slope[np.newaxis, np.newaxis, :]\n        \n        # Compute residual bias per node-horizon\n        bias_h = np.zeros(n_horizons)\n        for h in range(n_horizons):\n            m = m_tr[:, h, :]\n            bias_h[h] = (scaled_base[:, h, :][m] - t_tr[:, h, :][m]).mean()\n        \n        bias_nh = np.zeros((n_horizons, n_nodes))\n        for h in range(n_horizons):\n            for n in range(n_nodes):\n                m = m_tr[:, h, n]\n                if m.sum() > 0:\n                    bias_nh[h, n] = (scaled_base[:, h, n][m] - t_tr[:, h, n][m]).mean()\n                else:\n                    bias_nh[h, n] = bias_h[h]\n        \n        shrunk_bias = shrink_nh_bias * bias_nh + (1 - shrink_nh_bias) * bias_h[:, np.newaxis]\n        \n        def predict(b, h, a, c):\n            scaled = b * node_slope[np.newaxis, np.newaxis, :]\n            result = scaled - shrunk_bias[np.newaxis, :, :]\n            return np.maximum(result, 0)\n        return predict\n    return factory\n\nprint(\\\"\\\\n=== Per-node slope + NH bias ===\\\")\nfor s_s in [0.2, 0.3, 0.5]:\n    for s_b in [0.2, 0.3, 0.4]:\n        mae = kfold_cv_fast(make_node_lin_nh_bias(s_s, s_b))\n        print(f\\\"  s_slope={s_s}, s_nhbias={s_b}: {mae:.4f}\\\")\n\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_125","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 << 'PYEOF'\nimport numpy as np\nfrom sklearn.linear_model import Ridge\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_targ = np.load('/workspace/public_assets/train_targets.npz')\ngraph = np.load('/workspace/public_assets/graph.npz')\n\nbase = train_feat['base'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\ntarget = train_targ['target'].astype(np.float64)\nadj = graph['adjacency'].astype(np.float64)\nmask = np.isfinite(target) & (target > 0)\n\nn_samples, n_horizons, n_nodes = base.shape\n\n# Build global feature matrix\n# Features: base, anchor, last_history, avg_history, horizon_idx (one-hot), clock, node_idx (one-hot)\n# Total features: 4 continuous + 12 horizon + 170 node = 186 features\n# Training rows: 74 * 12 * 170 = 150,960 (but only 74 independent samples)\n\ndef build_features(base, history, anchor, clock):\n    n_s, n_h, n_n = base.shape\n    \n    # Continuous features\n    last_hist = history[:, -1, :][:, np.newaxis, :].repeat(n_h, axis=1)\n    avg_hist = history.mean(axis=1)[:, np.newaxis, :].repeat(n_h, axis=1)\n    \n    cont_feats = np.stack([\n        base,\n        anchor,\n        last_hist,\n        avg_hist,\n        clock,\n    ], axis=-1)  # (n_s, n_h, n_n, 5)\n    \n    # Horizon one-hot\n    h_idx = np.arange(n_h)[np.newaxis, :, np.newaxis, np.newaxis]\n    h_onehot = np.zeros((n_s, n_h, n_n, n_h))\n    np.put_along_axis(h_onehot, h_idx, 1.0, axis=3)\n    \n    # Node one-hot\n    n_idx = np.arange(n_n)[np.newaxis, np.newaxis, :, np.newaxis]\n    n_onehot = np.zeros((n_s, n_h, n_n, n_n))\n    np.put_along_axis(n_onehot, n_idx, 1.0, axis=3)\n    \n    # Base * horizon interaction (allows per-horizon base coefficient)\n    # Base * node interaction (allows per-node base coefficient)\n    # These would add too many features. Let's skip for now.\n    \n    all_feats = np.concatenate([cont_feats, h_onehot, n_onehot], axis=-1)\n    # Reshape to (n_s * n_h * n_n, n_features)\n    return all_feats.reshape(-1, all_feats.shape[-1])\n\n# Sample-level 5-fold CV (proper cross-validation by sample)\ndef sample_cv_ridge(alpha, n_splits=5, seed=42):\n    rng = np.random.RandomState(seed)\n    indices = rng.permutation(n_samples)\n    fold_size = n_samples // n_splits\n    errors = []\n    \n    for fold in range(n_splits):\n        test_start = fold * fold_size\n        test_end = test_start + fold_size if fold < n_splits-1 else n_samples\n        test_idx = indices[test_start:test_end]\n        train_idx = np.concatenate([indices[:test_start], indices[test_end:]])\n        \n        X_train = build_features(base[train_idx], history[train_idx], \n                                 anchor[train_idx], clock[train_idx])\n        y_train = target[train_idx].flatten()\n        m_train = mask[train_idx].flatten()\n        \n        model = Ridge(alpha=alpha)\n        model.fit(X_train[m_train], y_train[m_train])\n        \n        X_test = build_features(base[test_idx], history[test_idx],\n                                anchor[test_idx], clock[test_idx])\n        pred = model.predict(X_test).reshape(len(test_idx), n_horizons, n_nodes)\n        \n        m_test = mask[test_idx]\n        errors.append(np.abs(pred - target[test_idx])[m_test].mean())\n    \n    return np.mean(errors)\n\nprint(\\\"Global ridge regression with node+horizon one-hot (sample-level CV)...\\\")\nprint(f\\\"Features: 5 continuous + {n_horizons} horizon + {n_nodes} node = {5 + n_horizons + n_nodes}\\\")\n\nfor alpha in [1.0, 10.0, 100.0, 1000.0, 10000.0]:\n    mae = sample_cv_ridge(alpha)\n    print(f\\\"  alpha={alpha:>8.1f}: MAE={mae:.4f}\\\")\n\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

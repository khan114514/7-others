{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 << 'EOF'\nimport numpy as np\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_targ = np.load('/workspace/public_assets/train_targets.npz')\n\nbase = train_feat['base']\nhistory = train_feat['history']\nanchor = train_feat['anchor']\nclock = train_feat['clock']\ntarget = train_targ['target']\nmask = np.isfinite(target) & (target > 0)\n\nn_samples, n_horizons, n_nodes = base.shape\n\n# Quick 5-fold CV instead of LOSO for faster iteration\nfrom sklearn.model_selection import KFold\n\ndef kfold_cv(correction_fn, n_splits=5, seed=42):\n    kf = KFold(n_splits=n_splits, shuffle=True, random_state=seed)\n    errors = []\n    for train_idx, test_idx in kf:\n        train_mask = np.zeros(n_samples, dtype=bool)\n        train_mask[train_idx] = True\n        for i in test_idx:\n            corrected = correction_fn(base, target, mask, train_mask, i)\n            m_test = mask[i]\n            errors.append(np.abs(corrected - target[i])[m_test].mean())\n    return np.mean(errors)\n\n# Method: shrunken node-horizon bias + anchor mix (per-horizon alpha)\ndef combined_method(nh_alpha, anchor_alphas):\n    def fn(base, target, mask, train_mask, test_idx):\n        # per-horizon global bias\n        bias_h = np.zeros(n_horizons)\n        for h in range(n_horizons):\n            m = mask[train_mask, h, :]\n            bias_h[h] = (base[train_mask, h, :][m] - target[train_mask, h, :][m]).mean()\n        \n        # per-node-horizon bias\n        bias_nh = np.zeros((n_horizons, n_nodes))\n        for h in range(n_horizons):\n            for n in range(n_nodes):\n                m = mask[train_mask, h, n]\n                if m.sum() > 0:\n                    bias_nh[h, n] = (base[train_mask, h, n][m] - target[train_mask, h, n]).mean()\n                else:\n                    bias_nh[h, n] = bias_h[h]\n        \n        # shrink\n        shrunk_bias = nh_alpha * bias_nh + (1 - nh_alpha) * bias_h[:, np.newaxis]\n        \n        # base - bias\n        corrected = base[test_idx] - shrunk_bias\n        \n        # mix with anchor\n        anchor_test = anchor[test_idx]\n        for h in range(n_horizons):\n            a = anchor_alphas[h]\n            corrected[h] = (1 - a) * corrected[h] + a * anchor_test[h]\n        \n        return np.maximum(corrected, 0)\n    return fn\n\n# Baseline\ndef base_fn(base, target, mask, train_mask, test_idx):\n    return base[test_idx]\n\nprint(f'Baseline: {kfold_cv(base_fn):.4f}')\n\n# Try different configs\nbest_mae = float('inf')\nbest_cfg = None\nfor nh_a in [0.2, 0.3, 0.4, 0.5]:\n    for anchor_scale in [0.0, 0.02, 0.05, 0.08, 0.1]:\n        # anchor contribution grows linearly with horizon\n        anchor_alphas = anchor_scale * np.linspace(0, 1, n_horizons)\n        mae = kfold_cv(combined_method(nh_a, anchor_alphas))\n        if mae < best_mae:\n            best_mae = mae\n            best_cfg = (nh_a, anchor_scale)\n        print(f'  nh_a={nh_a}, anchor_scale={anchor_scale}: {mae:.4f}')\n\nprint(f'\\\\nBest: nh_alpha={best_cfg[0]}, anchor_scale={best_cfg[1]}, MAE={best_mae:.4f}')\n\nEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

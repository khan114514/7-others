{"type":"item.started","item":{"id":"item_122","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 << 'PYEOF'\nimport numpy as np\nfrom sklearn.isotonic import IsotonicRegression\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_targ = np.load('/workspace/public_assets/train_targets.npz')\n\nbase = train_feat['base'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\ntarget = train_targ['target'].astype(np.float64)\nmask = np.isfinite(target) & (target > 0)\n\nn_samples, n_horizons, n_nodes = base.shape\n\n# Quick test: per-node isotonic regression\n# For each node, fit isotonic regression on all (base, target) pairs across horizons\n# This maps forecast quantiles to observed quantiles\n\n# Use a single train/test split for speed\nrng = np.random.RandomState(42)\nperm = rng.permutation(n_samples)\nn_train = 60\ntrain_idx = perm[:n_train]\ntest_idx = perm[n_train:]\n\nbase_tr, base_te = base[train_idx], base[test_idx]\ntarget_tr, target_te = target[train_idx], target[test_idx]\nmask_tr, mask_te = mask[train_idx], mask[test_idx]\n\n# Baseline\nprint(f\\\"Baseline test MAE: {np.abs(base_te - target_te)[mask_te].mean():.4f}\\\")\n\n# Per-node bias correction\nnode_bias = np.zeros(n_nodes)\nfor n in range(n_nodes):\n    m = mask_tr[:, :, n]\n    node_bias[n] = (base_tr[:, :, n][m] - target_tr[:, :, n][m]).mean()\nbias_corrected = base_te - node_bias[np.newaxis, np.newaxis, :]\nprint(f\\\"Per-node bias test MAE: {np.abs(bias_corrected - target_te)[mask_te].mean():.4f}\\\")\n\n# Per-node isotonic regression\niso_corrected = np.zeros_like(base_te)\nfor n in range(n_nodes):\n    m = mask_tr[:, :, n]\n    b_n = base_tr[:, :, n][m]\n    t_n = target_tr[:, :, n][m]\n    \n    if len(b_n) > 20:\n        # Sort by base value\n        sort_idx = np.argsort(b_n)\n        b_sorted = b_n[sort_idx]\n        t_sorted = t_n[sort_idx]\n        \n        # Fit isotonic regression\n        iso = IsotonicRegression(out_of_bounds='clip', y_min=0)\n        iso.fit(b_sorted, t_sorted)\n        \n        # Apply to test\n        b_test = base_te[:, :, n].flatten()\n        iso_corrected[:, :, n] = iso.predict(b_test).reshape(base_te.shape[0], n_horizons)\n    else:\n        iso_corrected[:, :, n] = base_te[:, :, n]\n\nprint(f\\\"Per-node isotonic test MAE: {np.abs(iso_corrected - target_te)[mask_te].mean():.4f}\\\")\n\n# Per-node-horizon isotonic regression (more parameters, might overfit)\niso_nh_corrected = np.zeros_like(base_te)\nfor n in range(n_nodes):\n    for h in range(n_horizons):\n        m = mask_tr[:, h, n]\n        b_n = base_tr[:, h, n][m]\n        t_n = target_tr[:, h, n][m]\n        \n        if len(b_n) > 15:\n            iso = IsotonicRegression(out_of_bounds='clip', y_min=0)\n            iso.fit(b_n, t_n)\n            iso_nh_corrected[:, h, n] = iso.predict(base_te[:, h, n])\n        else:\n            iso_nh_corrected[:, h, n] = base_te[:, h, n] - node_bias[n]\n\nprint(f\\\"Per-node-horizon isotonic test MAE: {np.abs(iso_nh_corrected - target_te)[mask_te].mean():.4f}\\\")\n\n# Combined: bias correction + isotonic on residuals?\n# Or: blend isotonic with base forecast\nfor alpha in [0.3, 0.5, 0.7]:\n    blended = alpha * iso_corrected + (1 - alpha) * bias_corrected\n    print(f\\\"Blend (iso={alpha}, bias={1-alpha}): {np.abs(blended - target_te)[mask_te].mean():.4f}\\\")\n\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np\nfrom sklearn.linear_model import Ridge, HuberRegressor\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_targ = np.load('/workspace/public_assets/train_targets.npz')\n\nbase = train_feat['base']\nhistory = train_feat['history']\nanchor = train_feat['anchor']\nclock = train_feat['clock']\ntarget = train_targ['target']\nmask = np.isfinite(target) & (target > 0)\n\nn_samples, n_horizons, n_nodes = base.shape\n\n# LOSO-CV helper for flattened feature-based approach\ndef loso_cv_flat(predict_fn):\n    errors = []\n    for i in range(n_samples):\n        train_mask = np.ones(n_samples, dtype=bool)\n        train_mask[i] = False\n        \n        pred = predict_fn(base, history, anchor, clock, target, mask, train_mask, i)\n        m_test = mask[i]\n        errors.append(np.abs(pred - target[i])[m_test].mean())\n    return np.mean(errors)\n\n# Global Ridge with per-horizon node bias (many features but regularized)\ndef ridge_global_features(base, history, anchor, clock, target, mask, train_mask, test_idx):\n    n_h, n_n = base.shape[1], base.shape[2]\n    \n    def make_feats(base, history, anchor, clock, sample_mask=None):\n        n_s = base.shape[0]\n        last_hist = history[:, -1, :][:, np.newaxis, :].repeat(n_h, axis=1)\n        avg_hist = history.mean(axis=1)[:, np.newaxis, :].repeat(n_h, axis=1)\n        \n        feats_list = [\n            base.reshape(-1, 1),\n            anchor.reshape(-1, 1),\n            last_hist.reshape(-1, 1),\n            avg_hist.reshape(-1, 1),\n            clock.reshape(-1, 1),\n        ]\n        \n        # horizon one-hot\n        h_idx = np.arange(n_h)[np.newaxis, :, np.newaxis].repeat(n_s, axis=0).repeat(n_n, axis=2)\n        h_onehot = np.eye(n_h)[h_idx.flatten()]\n        feats_list.append(h_onehot)\n        \n        # node one-hot\n        n_idx = np.arange(n_n)[np.newaxis, np.newaxis, :].repeat(n_s, axis=0).repeat(n_h, axis=1)\n        n_onehot = np.eye(n_n)[n_idx.flatten()]\n        feats_list.append(n_onehot)\n        \n        return np.hstack(feats_list)\n    \n    X_train = make_feats(base[train_mask], history[train_mask], anchor[train_mask], clock[train_mask])\n    y_train = target[train_mask].flatten()\n    m_train = mask[train_mask].flatten()\n    \n    model = Ridge(alpha=100.0)\n    model.fit(X_train[m_train], y_train[m_train])\n    \n    X_test = make_feats(base[test_idx:test_idx+1], history[test_idx:test_idx+1], \n                        anchor[test_idx:test_idx+1], clock[test_idx:test_idx+1])\n    pred = model.predict(X_test).reshape(n_h, n_n)\n    return pred\n\nprint('Training global ridge with node+horizon one-hot...')\nmae = loso_cv_flat(ridge_global_features)\nprint(f'Global ridge + one-hot MAE: {mae:.4f}')\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

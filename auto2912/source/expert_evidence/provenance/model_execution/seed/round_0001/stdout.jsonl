{"type":"item.started","item":{"id":"item_107","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 << 'PYEOF'\nimport numpy as np\nfrom sklearn.linear_model import Ridge, HuberRegressor\nfrom sklearn.preprocessing import StandardScaler\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_targ = np.load('/workspace/public_assets/train_targets.npz')\ngraph = np.load('/workspace/public_assets/graph.npz')\n\nbase = train_feat['base'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\ntarget = train_targ['target'].astype(np.float64)\nadj = graph['adjacency'].astype(np.float64)\nmask = np.isfinite(target) & (target > 0)\n\nn_samples, n_horizons, n_nodes = base.shape\n\n# Per-node ridge regression: for each node, fit ridge regression\n# using base forecasts across all horizons as features, plus anchor, clock, history stats\ndef kfold_cv_per_node_ridge(alpha, n_splits=5, seed=42):\n    rng = np.random.RandomState(seed)\n    indices = rng.permutation(n_samples)\n    fold_size = n_samples // n_splits\n    errors = []\n    \n    for fold in range(n_splits):\n        test_start = fold * fold_size\n        test_end = test_start + fold_size if fold < n_splits-1 else n_samples\n        test_idx = indices[test_start:test_end]\n        train_idx = np.concatenate([indices[:test_start], indices[test_end:]])\n        \n        # For each node, fit a model\n        node_preds = np.zeros((len(test_idx), n_horizons, n_nodes))\n        \n        for n in range(n_nodes):\n            # Features per (sample, horizon): base_h, anchor_h, clock_h, horizon_idx\n            # We flatten sample*horizon for each node\n            n_train = len(train_idx)\n            X_train = np.zeros((n_train * n_horizons, 5))\n            y_train = np.zeros(n_train * n_horizons)\n            w_train = np.zeros(n_train * n_horizons)\n            \n            idx = 0\n            for s in range(n_train):\n                s_idx = train_idx[s]\n                for h in range(n_horizons):\n                    X_train[idx, 0] = base[s_idx, h, n]\n                    X_train[idx, 1] = anchor[s_idx, h, n]\n                    X_train[idx, 2] = clock[s_idx, h, n]\n                    X_train[idx, 3] = h\n                    X_train[idx, 4] = history[s_idx, -1, n]  # last observation\n                    y_train[idx] = target[s_idx, h, n]\n                    w_train[idx] = 1.0 if mask[s_idx, h, n] else 0.0\n                    idx += 1\n            \n            valid = w_train > 0\n            if valid.sum() < 10:\n                # Not enough data, just use base\n                for si, i in enumerate(test_idx):\n                    node_preds[si, :, n] = base[i, :, n]\n                continue\n            \n            model = Ridge(alpha=alpha)\n            model.fit(X_train[valid], y_train[valid])\n            \n            # Predict test\n            for si, i in enumerate(test_idx):\n                X_test = np.zeros((n_horizons, 5))\n                for h in range(n_horizons):\n                    X_test[h, 0] = base[i, h, n]\n                    X_test[h, 1] = anchor[i, h, n]\n                    X_test[h, 2] = clock[i, h, n]\n                    X_test[h, 3] = h\n                    X_test[h, 4] = history[i, -1, n]\n                node_preds[si, :, n] = model.predict(X_test)\n        \n        for si, i in enumerate(test_idx):\n            m = mask[i]\n            errors.append(np.abs(node_preds[si] - target[i])[m].mean())\n    \n    return np.mean(errors)\n\nprint(\\\"Per-node ridge regression CV...\\\")\nfor alpha in [0.1, 1.0, 10.0, 100.0, 1000.0]:\n    mae = kfold_cv_per_node_ridge(alpha)\n    print(f\\\"  alpha={alpha}: MAE={mae:.4f}\\\")\n\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.completed","item":{"id":"item_75","type":"command_execution","command":"/bin/sh -lc 'cat /opt/forecast-engine/grader.py'","aggregated_output":"\"\"\"Root verifier; method fitting and checkpoint loading run only as UID1000.\"\"\"\nimport argparse\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport resource\nimport stat\nimport shutil\nimport subprocess\nimport sys\nimport time\nimport uuid\n\nimport numpy as np\n\nASSETS=Path('/opt/verifier-assets')\nPUBLIC=Path('/workspace/public_assets')\nSEEDS=[17,29,43]\nTEMPORARY_DIRS=[]\n\nclass SourceFormatError(Exception):pass\n\ndef cleanup_owned_temporaries():\n    # Each entry is an exact verifier-created nonce; never sweep other tasks.\n    def reclaim(path):\n        info=path.lstat()\n        if not stat.S_ISDIR(info.st_mode):return\n        os.chown(path,0,0,follow_symlinks=False)\n        path.chmod(0o700)\n        for child in path.iterdir():\n            if stat.S_ISDIR(child.lstat().st_mode):reclaim(child)\n    for directory in TEMPORARY_DIRS:\n        if directory.exists():\n            reclaim(directory)\n            shutil.rmtree(directory)\n\n\ndef identity():\n    os.setgroups([])\n    os.setgid(1000)\n    os.setuid(1000)\n    resource.setrlimit(resource.RLIMIT_AS,(3*1024**3,3*1024**3))\n    resource.setrlimit(resource.RLIMIT_CPU,(180,180))\n    resource.setrlimit(resource.RLIMIT_FSIZE,(64*1024**2,64*1024**2))\n    resource.setrlimit(resource.RLIMIT_NOFILE,(128,128))\n    import ctypes\n    if ctypes.CDLL(None).prctl(38,1,0,0,0)!=0:\n        raise RuntimeError('Could not enforce no-new-privileges')\n\n\ndef digest(path):\n    return hashlib.sha256(Path(path).read_bytes()).hexdigest()\n\n\ndef source_hash(solution):\n    files=[]\n    for path in Path(solution).rglob('*'):\n        if path.is_symlink():raise ValueError('Source symlinks are forbidden')\n        if path.is_file() and path.suffix=='.py':\n            if path.stat().st_size>1024**2:raise SourceFormatError('Source
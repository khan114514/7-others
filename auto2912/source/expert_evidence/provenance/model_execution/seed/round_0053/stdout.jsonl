8\n  Hour 22: n=3, avg_resid=-0.557\n  Hour 23: n=3, avg_resid=3.077\n\nBase MAE: 14.9934\nSmoothed base MAE: 84.9143\nBest blend (w=0.00): MAE=14.9934\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python -c \\\"\nimport numpy as np\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntarget = np.load('/workspace/public_assets/train_targets.npz')['target'].astype(np.float64)\nbase = train_feat['base'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\ngraph = np.load('/workspace/public_assets/graph.npz')\nadj = graph['adjacency']\n\nmask = np.isfinite(target) & (target > 0)\nn_samples, n_horizons, n_nodes = base.shape\n\n# 1. Check if residual is related to base level (heteroscedasticity)\nresidual = base - target\nprint('Residual analysis vs base level:')\n# Bin by base level\nbase_flat = base[mask]\nres_flat = residual[mask]\nfor pct in [10, 25, 50, 75, 90]:\n    threshold = np.percentile(base_flat, pct)\n    in_bin = base_flat <= threshold\n    print(f'  Base <= {threshold:.1f} (p{pct}): n={in_bin.sum()}, mean_res={res_flat[in_bin].mean():.3f}, abs_res={np.abs(res_flat[in_bin]).mean():.3f}')\n\n# 2. Better cross-validation to understand what works\n# Leave-one-out or 5-fold CV\nfrom sklearn.model_selection import KFold\n\ndef simple_method(base, anchor, history, clock, target, mask, train_idx, test_idx):\n    # Current v25-like but simplified\n    n_tr = len(train_idx)\n    n_te = len(test_idx)\n    n_h, n_n = base.shape[1], base.shape[2]\n    \n    b_tr, a_tr, t_tr = base[train_idx], anchor[train_idx], target[train_idx]\n    b_te, a_te = base[test_idx], anchor[test_idx]\n    m_tr = mask[train_idx]\n    \n    # Per-horizon anchor weight\n    anchor_h = np.zeros(n_h)\n    for h in range(n_h):\n        m = m_tr[:, h, :]\n        best_mae = float('inf')\n        for w in np.linspace(0, 0.3, 31):\n            pred = (1-w)*b_tr[:,h,:][m] + w*a_tr[:,h,:][m]\n            mae = np.abs(pred - t_tr[:,h,:][m]).mean()\n            if mae < best_mae:\n                best_mae = mae\n                anchor_h[h] = w\n    \n    pred = (1-anchor_h[None,:,None])*b_te + anchor_h[None,:,None]*a_te\n    \n    # Per-horizon median bias\n    h_bias = np.zeros(n_h)\n    blended_tr = (1-anchor_h[None,:,None])*b_tr + anchor_h[None,:,None]*a_tr\n    for h in range(n_h):\n        m = m_tr[:, h, :]\n        h_bias[h] = np.median(blended_tr[:,h,:][m] - t_tr[:,h,:][m])\n    pred = pred - h_bias[None,:,None]\n    \n    return pred\n\nkf = KFold(n_splits=5, shuffle=True, random_state=42)\nmaes = []\nfor train_idx, test_idx in kf.split(np.arange(n_samples)):\n    pred = simple_method(base, anchor, history, clock, target, mask, train_idx, test_idx)\n    m = mask[test_idx]\n    mae = np.abs(pred[m] - target[test_idx][m]).mean()\n    maes.append(mae)\n\nprint(f'\\\\n5-fold CV MAE (simple method): {np.mean(maes):.4f} +/- {np.std(maes):.4f}')\nprint(f'Individual: {[f\\\\\\\"{m:.4f}\\\\\\\" for m in maes]}')\n\n# 3. Try adding a per-sample intercept based on history-base mismatch\n# The idea: base forecast is too high/low for the whole sample, and \n# history[-1] vs base[0] tells us about recent shift\ndef method_with_sample_correction(base, anchor, history, clock, target, mask, train_idx, test_idx):\n    n_h, n_n = base.shape[1], base.shape[2]\n    \n    b_tr, a_tr, h_tr, t_tr = base[train_idx], anchor[train_idx], history[train_idx], target[train_idx]\n    b_te, a_te, h_te = base[test_idx], anchor[test_idx], history[test_idx]\n    m_tr = mask[train_idx]\n    m_te = mask[test_idx]\n    \n    # Step 1: per-horizon anchor weight\n    anchor_h = np.zeros(n_h)\n    for h in range(n_h):\n        m = m_tr[:, h, :]\n        best_mae = float('inf')\n        for w in np.linspace(0, 0.3, 31):\n            pred = (1-w)*b_tr[:,h,:][m] + w*a_tr[:,h,:][m]\n            mae = np.abs(pred - t_tr[:,h,:][m]).mean()\n            if mae < best_mae:\n                best_mae = mae\n                anchor_h[h] = w\n    \n    blended_tr = (1-anchor_h[None,:,None])*b_tr + anchor_h[None,:,None]*a_tr\n    blended_te = (1-anchor_h[None,:,None])*b_te + anchor_h[None,:,None]*a_te\n    \n    # Step 2: per-horizon bias\n    h_bias = np.zeros(n_h)\n    for h in range(n_h):\n        m = m_tr[:, h, :]\n        h_bias[h] = np.median(blended_tr[:,h,:][m] - t_tr[:,h,:][m])\n    corrected_tr = blended_tr - h_bias[None,:,None]\n    corrected_te = blended_te - h_bias[None,:,None]\n    \n    # Step 3: per-sample bias from base-history gap\n    # Use mean residual per sample as function of (base_mean - hist_last_mean)\n    sample_base_tr = b_tr.mean(axis=(1,2))\n    sample_hist_tr = h_tr[:, -1, :].mean(axis=1)\n    sample_gap_tr = sample_base_tr - sample_hist_tr\n    \n    sample_resid_tr = np.zeros(len(train_idx))\n    for i in range(len(train_idx)):\n        mi = m_tr[i]\n        sample_resid_tr[i] = (corrected_tr[i] - t_tr[i])[mi].mean()\n    \n    # Fit linear model: sample_resid = alpha * sample_gap + beta\n    # Using robust fitting\n    from sklearn.linear_model import Ridge, HuberRegressor\n    X_tr = sample_gap_tr.reshape(-1, 1)\n    model = Ridge(alpha=1.0)\n    model.fit(X_tr, sample_resid_tr)\n    \n    # Apply to test\n    sample_base_te = b_te.mean(axis=(1,2))\n    sample_hist_te = h_te[:, -1, :].mean(axis=1)\n    sample_gap_te = sample_base_te - sample_hist_te\n    X_te = sample_gap_te.reshape(-1, 1)\n    pred_sample_bias = model.predict(X_te)\n    \n    corrected_te = corrected_te - pred_sample_bias[:, None, None] * 0.3  # shrink\n    \n    return corrected_te\n\nmaes2 = []\nfor train_idx, test_idx in kf.split(np.arange(n_samples)):\n    pred = method_with_sample_correction(base, anchor, history, clock, target, mask, train_idx, test_idx)\n    m = mask[test_idx]\n    mae = np.abs(pred[m] - target[test_idx][m]).mean()\n    maes2.append(mae)\n\nprint(f'5-fold CV MAE (w/ sample gap correction): {np.mean(maes2):.4f} +/- {np.std(maes2):.4f}')\nprint(f'Individual: {[f\\\\\\\"{m:.4f}\\\\\\\" for m in maes2]}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python -c \\\"\nimport numpy as np\nfrom sklearn.model_selection import KFold\nfrom sklearn.linear_model import Ridge, HuberRegressor\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntarget = np.load('/workspace/public_assets/train_targets.npz')['target'].astype(np.float64)\nbase = train_feat['base'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\ngraph = np.load('/workspace/public_assets/graph.npz')\nadj = graph['adjacency']\n\nmask = np.isfinite(target) & (target > 0)\nn_samples, n_horizons, n_nodes = base.shape\n\n# More comprehensive CV experiment\n# Let me build a proper feature set per (sample, horizon, node) and try Ridge on residual\n# Can we predict residual from: base, anchor, history features, clock features, node features?\n\ndef build_features_per_horizon(base, anchor, history, clock, h, n_nodes):\n    n_s = base.shape[0]\n    hist_last = history[:, -1, :]\n    hist_avg = history.mean(axis=1)\n    hist_trend = (history[:, -1, :] - history[:, 0, :]) / 12.0\n    \n    features = []\n    # Per-sample-node features\n    base_h = base[:, h, :]  # (n_s, n_n)\n    anchor_h = anchor[:, h, :]\n    clock_val = clock[:, h, 0]  # same for all nodes\n    \n    feat_list = []\n    for n in range(n_nodes):\n        row = np.column_stack([\n            base_h[:, n], anchor_h[:, n], hist_last[:, n], hist_avg[:, n], hist_trend[:, n],\n            np.full(n)\n        ])\n        feat_list.append(row)\n    \n    # Stack: (n_s * n_n, n_feat)\n    X = np.vstack(feat_list)\n    return X\n\n# Simpler approach: pool all samples per horizon, per-node features\ndef build_X(base, anchor, history, clock, h):\n    \\\\\\\"\\\\\\\"\\\\\\\"Build (sample*node, feature matrix for horizon h.\\\\\\\"\\\\\\\"\\\\\\\"\n    n_s = base.shape[0]\n    hist_last = history[:, -1, :]  # (n_s, n_n)\n    hist_avg = history.mean(axis=1)\n    hist_trend = (history[:, -1, :] - history[:, 0, :]) / 12.0\n    \n    clock_h = clock[:, h, 0]  # (n_s,)\n    \n    feats = []\n    for n in range(n_nodes):\n        # Features for this node across all samples\n        f = np.column_stack([\n            base[:, h, n],\n            anchor[:, h, n],\n            hist_last[:, n],\n            hist_avg[:, n],\n            hist_trend[:, n],\n            np.sin(2*np.pi*clock_h),\n            np.cos(2*np.pi*clock_h),\n            np.sin(2*np.pi*n/n_nodes),\n            np.cos(2*np.pi*n/n_nodes),\n            base[:, h, n] * np.sin(2*np.pi*clock_h),  # interaction\n            base[:, h, n] * np.cos(2*np.pi*clock_h),\n        ])\n        feats.append(f)\n    \n    X = np.vstack(feats)  # (n_s * n_n, n_feat)\n    return X\n\n# CV test on per-horizon Ridge model\nkf = KFold(n_splits=5, shuffle=True, random_state=42)\n\n# Baseline: just per-horizon anchor + bias\ndef baseline_mae_per_h = np.zeros(n_horizons)\nridge_mae_per_h = np.zeros(n_horizons)\n\nfor train_idx, test_idx in kf.split(np.arange(n_samples)):\n    n_tr = len(train_idx)\n    n_te = len(test_idx)\n    \n    for h in range(n_horizons):\n        m_tr = mask[train_idx][:, h, :].flatten()\n        m_te = mask[test_idx][:, h, :].flatten()\n        \n        # Baseline: per-horizon anchor weight + bias\n        # Find best anchor weight\n        best_mae = float('inf')\n        best_w = 0\n        b_tr_h = base[train_idx][:, h, :].flatten()\n        a_tr_h = anchor[train_idx][:, h, :].flatten()\n        t_tr_h = target[train_idx][:, h, :].flatten()\n        for w in np.linspace(0, 0.3, 31):\n            pred = (1-w)*b_tr_h[m_tr] + w*a_tr_h[m_tr]\n            mae = np.abs(pred - t_tr_h[m_tr]).mean()\n            if mae < best_mae:\n                best_mae = mae\n                best_w = w\n        \n        b_te_h = base[test_idx][:, h, :].flatten()\n        a_te_h = anchor[test_idx][:, h, :].flatten()\n        t_te_h = target[test_idx][:, h, :].flatten()\n        \n        baseline_pred = (1-best_w)*b_te_h[m_te] + best_w*a_te_h[m_te]\n        # add bias correction\n        bias = np.median((1-best_w)*b_tr_h[m_tr] + best_w*a_tr_h[m_tr] - t_tr_h[m_tr])\n        baseline_pred = baseline_pred - bias\n        baseline_mae_per_h[h] += np.abs(baseline_pred - t_te_h[m_te]).mean() / 5\n        \n        # Ridge model\n        X_tr = build_X(base[train_idx], anchor[train_idx], history[train_idx], clock[train_idx], h)\n        X_te = build_X(base[test_idx], anchor[test_idx], history[test_idx], clock[test_idx], h)\n        y_tr = target[train_idx][:, h, :].flatten()\n        \n        # Train ridge to predict target directly\n        mu = X_tr[m_tr].mean(axis=0)\n        sd = X_tr[m_tr].std(axis=0)\n        sd[sd < 1e-6] = 1\n        X_tr_s = (X_tr[m_tr] - mu) / sd\n        X_te_s = (X_te[m_te] - mu) / sd\n        \n        model = Ridge(alpha=10.0)\n        model.fit(X_tr_s, y_tr[m_tr])\n        ridge_pred = model.predict(X_te_s)\n        ridge_mae_per_h[h] += np.abs(ridge_pred - t_te_h[m_te]).mean() / 5\n\nprint('Per-horizon MAE:')\nprint(f'  Horizon  Baseline  Ridge')\nfor h in range(n_horizons):\n    print(f'  {h:2d}:     {baseline_mae_per_h[h]:7.3f}  {ridge_mae_per_h[h]:7.3f}')\n\nprint(f'\\\\nOverall baseline: {baseline_mae_per_h.mean():.4f}')\nprint(f'Overall ridge: {ridge_mae_per_h.mean():.4f}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

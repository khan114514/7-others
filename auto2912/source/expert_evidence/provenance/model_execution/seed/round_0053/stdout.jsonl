{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python -c \\\"\nimport numpy as np\nfrom sklearn.model_selection import KFold\nfrom sklearn.linear_model import Ridge\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntarget = np.load('/workspace/public_assets/train_targets.npz')['target'].astype(np.float64)\nbase = train_feat['base'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\n\nmask = np.isfinite(target) & (target > 0)\nn_samples, n_horizons, n_nodes = base.shape\n\ndef build_X(base, anchor, history, clock, h):\n    n_s = base.shape[0]\n    hist_last = history[:, -1, :]\n    hist_avg = history.mean(axis=1)\n    hist_trend = (history[:, -1, :] - history[:, 0, :]) / 12.0\n    clock_h = clock[:, h, 0]\n    \n    feats = []\n    for n in range(n_nodes):\n        node_ones = np.ones(n_s)\n        f = np.column_stack([\n            base[:, h, n],\n            anchor[:, h, n],\n            hist_last[:, n],\n            hist_avg[:, n],\n            hist_trend[:, n],\n            base[:, h, n] - anchor[:, h, n],  # base-anchor gap\n            base[:, h, n] - hist_last[:, n],  # base-history gap\n            np.sin(2*np.pi*clock_h),\n            np.cos(2*np.pi*clock_h),\n            node_ones * np.sin(2*np.pi*n/n_nodes),\n            node_ones * np.cos(2*np.pi*n/n_nodes),\n            base[:, h, n] * np.sin(2*np.pi*clock_h),\n            base[:, h, n] * np.cos(2*np.pi*clock_h),\n        ])\n        feats.append(f)\n    return np.vstack(feats)\n\n# Baseline: current v25-like approach (anchor blending + biases)\ndef baseline_predict(b_tr, a_tr, t_tr, m_tr, b_te, a_te):\n    n_h = b_tr.shape[1]\n    # Per-horizon anchor weight\n    anchor_h = np.zeros(n_h)\n    for h in range(n_h):\n        m = m_tr[:, h, :]\n        best_mae = float('inf')\n        for w in np.linspace(0, 0.3, 31):\n            pred = (1-w)*b_tr[:,h,:][m] + w*a_tr[:,h,:][m]\n            mae = np.abs(pred - t_tr[:,h,:][m]).mean()\n            if mae < best_mae:\n                best_mae = mae\n                anchor_h[h] = w\n    \n    blended = (1-anchor_h[None,:,None])*b_te + anchor_h[None,:,None]*a_te\n    \n    # Per-horizon median bias\n    blended_tr = (1-anchor_h[None,:,None])*b_tr + anchor_h[None,:,None]*a_tr\n    h_bias = np.zeros(n_h)\n    for h in range(n_h):\n        m = m_tr[:, h, :]\n        h_bias[h] = np.median(blended_tr[:,h,:][m] - t_tr[:,h,:][m])\n    \n    return blended - h_bias[None,:,None], anchor_h, h_bias\n\nkf = KFold(n_splits=5, shuffle=True, random_state=42)\n\nbaseline_maes = []\nridge_maes = []\n\nfor train_idx, test_idx in kf.split(np.arange(n_samples)):\n    b_tr, a_tr, h_tr, t_tr = base[train_idx], anchor[train_idx], history[train_idx], target[train_idx]\n    b_te, a_te, h_te, t_te = base[test_idx], anchor[test_idx], history[test_idx], target[test_idx]\n    m_tr = mask[train_idx]\n    m_te = mask[test_idx]\n    \n    # Baseline\n    baseline_pred, anchor_h, h_bias = baseline_predict(b_tr, a_tr, t_tr, m_tr, b_te, a_te)\n    mae = np.abs(baseline_pred[m_te] - t_te[m_te]).mean()\n    baseline_maes.append(mae)\n    \n    # Now add ridge residual correction per horizon\n    corrected = baseline_pred.copy()\n    blended_tr = (1-anchor_h[None,:,None])*b_tr + anchor_h[None,:,None]*a_tr\n    residual_tr = (blended_tr - h_bias[None,:,None]) - t_tr\n    \n    for h in range(n_horizons):\n        X_tr = build_X(b_tr, a_tr, h_tr, clock[train_idx], h)\n        X_te = build_X(b_te, a_te, h_te, clock[test_idx], h)\n        y_tr = residual_tr[:, h, :].flatten()\n        m_tr_h = m_tr[:, h, :].flatten()\n        m_te_h = m_te[:, h, :].flatten()\n        \n        if m_tr_h.sum() < 100:\n            continue\n        \n        mu = X_tr[m_tr_h].mean(axis=0)\n        sd = X_tr[m_tr_h].std(axis=0)\n        sd[sd < 1e-6] = 1\n        X_tr_s = (X_tr[m_tr_h] - mu) / sd\n        X_te_s = (X_te[m_te_h] - mu) / sd\n        \n        model = Ridge(alpha=100.0)\n        model.fit(X_tr_s, y_tr[m_tr_h])\n        ridge_pred = model.predict(X_te_s)\n        \n        # Shrink and apply\n        shrink = 0.1\n        corrected_flat = corrected[:, h, :].flatten()\n        corrected_flat[m_te_h] = corrected_flat[m_te_h] - shrink * ridge_pred\n        corrected[:, h, :] = corrected_flat.reshape(-1, n_nodes)\n    \n    mae_r = np.abs(corrected[m_te] - t_te[m_te]).mean()\n    ridge_maes.append(mae_r)\n\nprint(f'Baseline MAE: {np.mean(baseline_maes):.4f} +/- {np.std(baseline_maes):.4f}')\nprint(f'Ridge-corrected MAE: {np.mean(ridge_maes):.4f} +/- {np.std(ridge_maes):.4f}')\nprint(f'Baseline folds: {[f\\\\\\\"{m:.4f}\\\\\\\" for m in baseline_maes]}')\nprint(f'Ridge folds: {[f\\\\\\\"{m:.4f}\\\\\\\" for m in ridge_maes]}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

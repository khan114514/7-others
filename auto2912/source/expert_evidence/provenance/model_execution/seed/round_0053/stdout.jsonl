{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python -c \\\"\nimport numpy as np\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntarget = np.load('/workspace/public_assets/train_targets.npz')['target'].astype(np.float64)\nbase = train_feat['base'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\n\nmask = np.isfinite(target) & (target > 0)\n\n# Let's understand residual structure better\nresidual = base - target\n\n# 1. Is there per-sample bias? (all nodes biased same direction for a sample)\nsample_bias = np.zeros(74)\nfor i in range(74):\n    m = mask[i,:,:]\n    sample_bias[i] = residual[i,:,:][m].mean()\nprint(f'Sample bias: mean={sample_bias.mean():.3f}, std={sample_bias.std():.3f}')\nprint(f'  Range: [{sample_bias.min():.3f}, {sample_bias.max():.3f}]')\n\n# 2. Can base-anchor diff predict per-sample bias?\nba_diff = (base - anchor).mean(axis=(1,2))\nprint(f'\\\\nBase-anchor diff per sample: std={ba_diff.std():.3f}')\nprint(f'  Corr with sample bias: {np.corrcoef(sample_bias, ba_diff)[0,1]:.4f}')\n\n# 3. What about recent history? Does history predict residual?\nhist_last = history[:, -1, :].mean(axis=1)\nprint(f'History last per sample: std={hist_last.std():.3f}')\nprint(f'  Corr with sample bias: {np.corrcoef(sample_bias, hist_last)[0,1]:.4f}')\n\n# 4. Clock effect - is there time-of-day pattern in bias?\nclock_sh = clock[:, 0, 0]  # same for all nodes, first horizon\n# Average residual by time of day\nprint(f'\\\\nClock unique values: {np.unique(clock_sh).size}')\n# Bin by time of day\nfor hour_bin in range(24):\n    lo = hour_bin / 24.0\n    hi = (hour_bin + 1) / 24.0\n    in_bin = (clock_sh >= lo) & (clock_sh < hi)\n    if in_bin.sum() > 0:\n        avg_resid = sample_bias[in_bin].mean()\n        print(f'  Hour {hour_bin:2d}: n={in_bin.sum()}, avg_resid={avg_resid:.3f}')\n\n# 5. Graph smoothing - can neighbor average help?\ngraph = np.load('/workspace/public_assets/graph.npz')\nadj = graph['adjacency']\n# Normalize adjacency\ndeg = adj.sum(axis=1, keepdims=True)\ndeg[deg == 0] = 1\nadj_norm = adj / deg\n\n# Try: predict target as smoothed base \nbase_smoothed = np.zeros_like(base)\nfor i in range(74):\n    for h in range(12):\n        base_smoothed[i, h, :] = adj_norm @ base[i, h, :]\n\nmae_smooth = np.abs(base_smoothed[mask] - target[mask]).mean()\nmae_base = np.abs(base[mask] - target[mask]).mean()\nprint(f'\\\\nBase MAE: {mae_base:.4f}')\nprint(f'Smoothed base MAE: {mae_smooth:.4f}')\n\n# Blend base and smoothed base\nbest_mae = float('inf')\nbest_w = 0\nfor w in np.linspace(0, 1, 21):\n    pred = w * base_smoothed + (1-w) * base\n    mae = np.abs(pred[mask] - target[mask]).mean()\n    if mae < best_mae:\n        best_mae = mae\n        best_w = w\nprint(f'Best blend (w={best_w:.2f}): MAE={best_mae:.4f}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

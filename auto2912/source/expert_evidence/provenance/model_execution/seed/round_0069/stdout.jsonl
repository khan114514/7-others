{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 << 'PYEOF'\nimport numpy as np\nfrom sklearn.linear_model import Ridge\nfrom sklearn.model_selection import KFold\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_tgt = np.load('/workspace/public_assets/train_targets.npz')\n\nbase = train_feat['base'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\ntarget = train_tgt['target'].astype(np.float64)\n\nmask = np.isfinite(target) & (target > 0)\nn_samples, n_horizons, n_nodes = base.shape\nkf = KFold(n_splits=5, shuffle=True, random_state=42)\n\ndef v25_core(base_tr, anc_tr, tgt_tr, mask_tr):\n    \\\"\\\"\\\"Return per-horizon and per-node corrections (the stable core of v25).\\\"\\\"\\\"\n    ns, nh, nn = base_tr.shape\n    \n    # per-horizon anchor blending weights\n    anchor_h = np.zeros(nh)\n    for h in range(nh):\n        m = mask_tr[:, h, :]\n        best_mae = float('inf')\n        for w in np.linspace(0, 0.30, 31):\n            pred = (1-w)*base_tr[:, h, :][m] + w*anc_tr[:, h, :][m]\n            mae = np.abs(pred - tgt_tr[:, h, :][m]).mean()\n            if mae < best_mae:\n                best_mae = mae\n                anchor_h[h] = w\n    \n    pna_shrink = 0.2\n    anchor_nh = np.zeros((nh, nn))\n    for h in range(nh):\n        for n in range(nn):\n            m = mask_tr[:, h, n]\n            if m.sum() > 15:\n                best_mae = float('inf')\n                best_w = anchor_h[h]\n                for w in np.linspace(0, 0.40, 21):\n                    pred = (1-w)*base_tr[:, h, n][m] + w*anc_tr[:, h, n][m]\n                    mae = np.abs(pred - tgt_tr[:, h, n][m]).mean()\n                    if mae < best_mae:\n                        best_mae = mae\n                        best_w = w\n                anchor_nh[h, n] = best_w\n            else:\n                anchor_nh[h, n] = anchor_h[h]\n    anchor_nh = pna_shrink * anchor_nh + (1-pna_shrink) * anchor_h[:, None]\n    \n    blended = (1 - anchor_nh[None, :, :]) * base_tr + anchor_nh[None, :, :] * anc_tr\n    \n    # per-horizon median bias\n    h_bias = np.zeros(nh)\n    for h in range(nh):\n        m = mask_tr[:, h, :]\n        h_bias[h] = np.median(blended[:, h, :][m] - tgt_tr[:, h, :][m])\n    corrected = blended - h_bias[None, :, None]\n    residual = corrected - tgt_tr\n    \n    # per-node median bias\n    node_shrink = 0.4\n    node_bias = np.zeros(nn)\n    for n in range(nn):\n        m = mask_tr[:, :, n]\n        if m.sum() > 5:\n            node_bias[n] = np.median(residual[:, :, n][m])\n    node_bias = node_shrink * node_bias\n    corrected = corrected - node_bias[None, None, :]\n    residual = residual - node_bias[None, None, :]\n    \n    # per-node-horizon bias\n    pnh_shrink = 0.15\n    bias_nh = np.zeros((nh, nn))\n    for h in range(nh):\n        for n in range(nn):\n            m = mask_tr[:, h, n]\n            if m.sum() > 0:\n                raw = np.median(residual[:, h, n][m])\n                bias_nh[h, n] = pnh_shrink * raw\n    corrected = corrected - bias_nh[None, :, :]\n    residual = residual - bias_nh[None, :, :]\n    \n    # multiplicative per-node\n    mult_shrink = 0.5\n    mult_factor = np.ones(nn)\n    for n in range(nn):\n        m = mask_tr[:, :, n]\n        p = corrected[:, :, n][m]\n        tgt = tgt_tr[:, :, n][m]\n        if m.sum() > 20 and np.min(p) > 1:\n            ratios = tgt / p\n            mult_factor[n] = np.median(ratios)\n    mult_factor = 1.0 + mult_shrink * (mult_factor - 1.0)\n    corrected = corrected * mult_factor[None, None, :]\n    residual = residual * mult_factor[None, None, :]\n    \n    return corrected, residual, anchor_nh, h_bias, node_bias, bias_nh, mult_factor\n\ndef apply_v25(base_te, anc_te, anchor_nh, h_bias, node_bias, bias_nh, mult_factor):\n    result = (1 - anchor_nh[None, :, :]) * base_te + anchor_nh[None, :, :] * anc_te\n    result = result - h_bias[None, :, None]\n    result = result - node_bias[None, None, :]\n    result = result - bias_nh[None, :, :]\n    result = result * mult_factor[None, None, :]\n    return result\n\n# Base v25 CV\nmaes_v25 = []\nfor train_idx, test_idx in kf.split(range(n_samples)):\n    _, _, a_nh, hb, nb, bnh, mf = v25_core(base[train_idx], anchor[train_idx], target[train_idx], mask[train_idx])\n    pred = apply_v25(base[test_idx], anchor[test_idx], a_nh, hb, nb, bnh, mf)\n    pred = np.maximum(pred, 0)\n    te_mask = mask[test_idx]\n    mae = np.abs(pred[te_mask] - target[test_idx][te_mask]).mean()\n    maes_v25.append(mae)\nprint(f'v25 core (no sample-bias, no ridge): {np.mean(maes_v25):.4f}')\n\n# Now let's try: can we improve by adding a \\\"recent history\\\" based correction?\n# Idea: for each sample, the last history value tells us the current traffic state.\n# If base is much higher than history, it might be predicting a rise that won't happen.\n# Let's add a per-sample correction based on (base_h0 - hist_last) ratio.\n\nmaes_hist = []\nfor train_idx, test_idx in kf.split(range(n_samples)):\n    corrected_tr, residual_tr, a_nh, hb, nb, bnh, mf = v25_core(\n        base[train_idx], anchor[train_idx], target[train_idx], mask[train_idx])\n    pred = apply_v25(base[test_idx], anchor[test_idx], a_nh, hb, nb, bnh, mf)\n    \n    hist_tr = history[train_idx]\n    hist_te = history[test_idx]\n    \n    # Compute per-sample correction factor: \n    # residual ~ alpha * (base / hist_last - 1)\n    # For each horizon, fit ridge: residual_sample_h = a + b * (base_h_avg / hist_last_avg - 1)\n    \n    ns_tr = len(train_idx)\n    ns_te = len(test_idx)\n    \n    for h in range(n_horizons):\n        m = mask[train_idx][:, h, :]\n        # per-sample residual mean\n        sample_resid = np.zeros(ns_tr)\n        sample_base_ratio = np.zeros(ns_tr)\n        for i in range(ns_tr):\n            mi = m[i, :]\n            if mi.sum() > 0:\n                sample_resid[i] = residual_tr[i, h, :][mi].mean()\n                base_val = base[train_idx][i, h, :][mi].mean()\n                hist_val = hist_tr[i, -1, :][mi].mean()\n                sample_base_ratio[i] = base_val / max(hist_val, 1.0) - 1\n        \n        valid = np.isfinite(sample_resid) & (sample_resid \"'!= 0)\n        if valid.sum() < 20:\n            continue\n        \n        # Simple linear fit\n        x = sample_base_ratio[valid]\n        y = sample_resid[valid]\n        # with regularization (add small penalty on slope)\n        X = np.column_stack([np.ones(len(x)), x])\n        alpha = 5.0\n        coef = np.linalg.lstsq(X.T @ X + alpha * np.eye(2), X.T @ y, rcond=None)[0]\n        \n        # Apply to test\n        for i in range(ns_te):\n            base_val = base[test_idx][i, h, :].mean()\n            hist_val = hist_te[i, -1, :].mean()\n            ratio = base_val / max(hist_val, 1.0) - 1\n            corr = coef[0] + coef[1] * ratio\n            pred[i, h, :] = pred[i, h, :] - 0.3 * corr  # shrink\n    \n    pred = np.maximum(pred, 0)\n    te_mask = mask[test_idx]\n    mae = np.abs(pred[te_mask] - target[test_idx][te_mask]).mean()\n    maes_hist.append(mae)\nprint(f'\"'v25 + hist-ratio sample correction: {np.mean(maes_hist):.4f}')\n\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_tgt = np.load('/workspace/public_assets/train_targets.npz')\n\nbase = train_feat['base'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\ntarget = train_tgt['target'].astype(np.float64)\n\nmask = np.isfinite(target) & (target > 0)\nn_samples, n_horizons, n_nodes = base.shape\n\nprint('=== Per-horizon analysis ===')\nprint(f'{'Horizon':>7} {'Base MAE':>10} {'Anchor MAE':>10} {'Bias':>10} {'Base-Anch':>10}')\nfor h in range(n_horizons):\n    m = mask[:, h, :]\n    base_mae = np.abs(base[:, h, :][m] - target[:, h, :][m]).mean()\n    anchor_mae = np.abs(anchor[:, h, :][m] - target[:, h, :][m]).mean()\n    bias = (base[:, h, :][m] - target[:, h, :][m]).mean()\n    ba_diff = (base[:, h, :][m] - anchor[:, h, :][m]).mean()\n    print(f'{h:7d} {base_mae:10.3f} {anchor_mae:10.3f} {bias:10.3f} {ba_diff:10.3f}')\n\nprint()\nprint('=== Per-node stats (first 10 nodes) ===')\nprint(f'{'Node':>5} {'Base MAE':>10} {'Bias':>10} {'Target mean':>12}')\nfor n in range(10):\n    m = mask[:, :, n]\n    base_mae = np.abs(base[:, :, n][m] - target[:, :, n][m]).mean()\n    bias = (base[:, :, n][m] - target[:, :, n][m]).mean()\n    tmean = target[:, :, n][m].mean()\n    print(f'{n:5d} {base_mae:10.3f} {bias:10.3f} {tmean:12.2f}')\n\nprint()\n# Check clock structure\nprint(f'clock shape: {clock.shape}')\nprint(f'clock[:5, 0, 0] (first 5 samples, horizon 0, node 0): {clock[:5, 0, 0]}')\nprint(f'clock[0, :, 0] (first sample, all horizons, node 0): {clock[0, :, 0]}')\nprint(f'clock[0, 0, :5] (first sample, horizon 0, first 5 nodes): {clock[0, 0, :5]}')\n# Is clock same across nodes?\nprint(f'clock same across nodes: {np.allclose(clock[:, :, 0:1], clock[:, :, 1:2])}')\n\n# History structure\nprint()\nprint(f'history[:3, :, 0] (first 3 samples, all steps, node 0):')\nprint(history[:3, :, 0])\nprint(f'history last step vs base horizon 0 correlation (node 0): {np.corrcoef(history[:, -1, 0], base[:, 0, 0])[0,1]:.4f}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

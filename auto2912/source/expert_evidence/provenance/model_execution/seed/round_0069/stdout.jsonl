{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np\nfrom sklearn.linear_model import Ridge\nfrom sklearn.model_selection import KFold\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_tgt = np.load('/workspace/public_assets/train_targets.npz')\ngraph = np.load('/workspace/public_assets/graph.npz')\n\nbase = train_feat['base'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\ntarget = train_tgt['target'].astype(np.float64)\nadj = graph['adjacency'].astype(np.float64)\n\nmask = np.isfinite(target) & (target > 0)\nn_samples, n_horizons, n_nodes = base.shape\n\n# Let's explore: can we improve by graph-smoothing the per-node bias?\n# If nearby nodes have correlated biases, smoothing should help\n\n# First compute per-node bias (median residual)\nresidual = base - target\nnode_bias = np.zeros(n_nodes)\nfor n in range(n_nodes):\n    m = mask[:, :, n]\n    node_bias[n] = np.median(residual[:, :, n][m])\n\nprint('Node bias stats: mean={:.3f}, std={:.3f}, min={:.3f}, max={:.3f}'.format(\n    node_bias.mean(), node_bias.std(), node_bias.min(), node_bias.max()))\n\n# Check if adjacent nodes have similar biases\n# For each edge, compute |bias_i - bias_j|\nadj_binary = (adj > 0).astype(float)\ndiff_sum = 0\nedge_count = 0\nfor i in range(n_nodes):\n    for j in range(i+1, n_nodes):\n        if adj_binary[i, j] > 0:\n            diff_sum += abs(node_bias[i] - node_bias[j])\n            edge_count += 1\nprint(f'\\\\\\\\nEdges: {edge_count}')\nprint(f'Mean abs bias diff between neighbors: {diff_sum/edge_count:.3f}')\nprint(f'Mean abs bias diff (random pairs): {np.abs(node_bias[:,None] - node_bias[None,:]).mean():.3f}')\n\n# Neighbor bias is more similar than random - graph smoothing could help\n# Let's build a smoothed version\n# D\"'^-1 * A * bias  (average neighbor bias)\ndeg = adj.sum(axis=1, keepdims=True)\ndeg_safe = np.where(deg > 0, deg, 1.0)\nsmooth_bias = (adj @ node_bias[:, None]) / deg_safe\nsmooth_bias = smooth_bias.flatten()\n\nprint(f'\"'\\\\\\\\nSmoothed bias vs raw bias correlation: {np.corrcoef(node_bias, smooth_bias)[0,1]:.4f}')\n\n# What if we use a combination of raw and smoothed bias in CV?\nkf = KFold(n_splits=5, shuffle=True, random_state=42)\n\ndef simple_method(base_tr, anc_tr, tgt_tr, mask_tr, base_te, anc_te, use_graph=False, graph_weight=0.3):\n    nh, nn = base_tr.shape[1], base_tr.shape[2]\n    result = base_te.copy()\n    \n    # per-horizon median bias\n    h_bias = np.zeros(nh)\n    for h in range(nh):\n        m = mask_tr[:, h, :]\n        h_bias[h] = np.median(base_tr[:, h, :][m] - tgt_tr[:, h, :][m])\n    result = result - h_bias[None, :, None]\n    \n    # per-node bias\n    node_bias = np.zeros(nn)\n    for n in range(nn):\n        m = mask_tr[:, :, n]\n        if m.sum() > 5:\n            node_bias[n] = np.median((base_tr[:, :, n] - h_bias[:, None].T - tgt_tr[:, :, n])[m])\n    \n    if use_graph:\n        deg = adj.sum(axis=1, keepdims=True)\n        deg_safe = np.where(deg > 0, deg, 1.0)\n        smooth_bias = (adj @ node_bias[:, None]) / deg_safe\n        smooth_bias = smooth_bias.flatten()\n        node_bias = (1 - graph_weight) * node_bias + graph_weight * smooth_bias\n    \n    result = result - node_bias[None, None, :]\n    return np.maximum(result, 0)\n\nfor gw in [0, 0.1, 0.2, 0.3, 0.5, 0.7]:\n    maes = []\n    for train_idx, test_idx in kf.split(range(n_samples)):\n        pred = simple_method(\n            base[train_idx], anchor[train_idx], target[train_idx], mask[train_idx],\n            base[test_idx], anchor[test_idx],\n            use_graph=(gw > 0), graph_weight=gw\n        )\n        te_mask = mask[test_idx]\n        mae = np.abs(pred[te_mask] - target[test_idx][te_mask]).mean()\n        maes.append(mae)\n    print(f'Graph weight={gw:.1f}: CV MAE = {np.mean(maes):.4f}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

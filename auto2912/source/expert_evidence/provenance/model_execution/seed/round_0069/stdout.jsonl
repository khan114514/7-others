{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 << 'PYEOF'\nimport numpy as np\nfrom sklearn.linear_model import Ridge\nfrom sklearn.model_selection import KFold\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_tgt = np.load('/workspace/public_assets/train_targets.npz')\ngraph = np.load('/workspace/public_assets/graph.npz')\n\nbase = train_feat['base'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\ntarget = train_tgt['target'].astype(np.float64)\nadj = graph['adjacency'].astype(np.float64)\n\nmask = np.isfinite(target) & (target > 0)\nn_samples, n_horizons, n_nodes = base.shape\nkf = KFold(n_splits=5, shuffle=True, random_state=42)\n\n# Let's try a different approach: per-node gradient boosting / quantile approach\n# But we only have numpy/scipy/sklearn available\n# Actually sklearn has GradientBoostingRegressor but with 74*170 = ~12580 points per horizon\n# That might be overkill and slow. Let's try simpler things first.\n\n# Idea: What if we use ensemble of:\n# 1. v25 base method\n# 2. linear recalibration method\n# 3. ridge correction method\n# with weights optimized via CV\n\n# First let me check: per-node time-of-day pattern in residual\n# Clock encodes time of day. Maybe different nodes have different\n# bias patterns at different times of day.\n\n# Compute per-node, per-time-of-day residual\nresidual = base - target\nclk_vals = clock[:, 0, 0]  # start time of sample\n\n# For each node, compute residual bias as function of time of day\n# Use sin/cos of time since it's cyclic\n# Fit: residual_node = a * sin(2pi*t) + b * cos(2pi*t) + c\n\nprint('=== Per-node clock pattern in residuals ===')\nn_significant = 0\nfor n in range(n_nodes):\n    m = mask[:, :, n]\n    res = residual[:, :, n][m]\n    clk_per = np.repeat(clk_vals, n_horizons).reshape(n_samples, n_horizons)[:, :, None]\n    clk_flat = np.tile(clock[:, :, n], (1, 1)).reshape(-1)  # clock per horizon\n    # Actually let's just check average bias across all horizons per node\n    avg_res = np.zeros(n_samples)\n    for i in range(n_samples):\n        mi = m[i, :]\n        if mi.sum() > 0:\n            avg_res[i] = residual[i, :, n][mi].mean()\n    \n    # Fit clock sinusoid\n    valid = np.isfinite(avg_res) & (avg_res \"'!= 0)\n    if valid.sum() > 10:\n        t = clk_vals[valid]\n        y = avg_res[valid]\n        X = np.column_stack([np.sin(2*np.pi*t), np.cos(2*np.pi*t)])\n        coef = np.linalg.lstsq(X.T @ X + 0.1 * np.eye(2), X.T @ y, rcond=None)[0]\n        pred = X @ coef\n        r2 = 1 - np.sum((y - pred)**2) / np.sum((y - y.mean())**2)\n        if r2 > 0.1:\n            n_significant += 1\n\nprint(f'\"'Nodes with >10% variance explained by time-of-day: {n_significant}/{n_nodes}')\n\n# Let me add clock-based per-node features to ridge and see if it helps\ndef v25_core(base_tr, anc_tr, tgt_tr, mask_tr):\n    ns, nh, nn = base_tr.shape\n    anchor_h = np.zeros(nh)\n    for h in range(nh):\n        m = mask_tr[:, h, :]\n        best_mae = float('inf')\n        for w in np.linspace(0, 0.30, 31):\n            pred = (1-w)*base_tr[:, h, :][m] + w*anc_tr[:, h, :][m]\n            mae = np.abs(pred - tgt_tr[:, h, :][m]).mean()\n            if mae < best_mae:\n                best_mae = mae\n                anchor_h[h] = w\n    pna_shrink = 0.2\n    anchor_nh = np.zeros((nh, nn))\n    for h in range(nh):\n        for n in range(nn):\n            m = mask_tr[:, h, n]\n            if m.sum() > 15:\n                best_mae = float('inf')\n                best_w = anchor_h[h]\n                for w in np.linspace(0, 0.40, 21):\n                    pred = (1-w)*base_tr[:, h, n][m] + w*anc_tr[:, h, n][m]\n                    mae = np.abs(pred - tgt_tr[:, h, n][m]).mean()\n                    if mae < best_mae:\n                        best_mae = mae\n                        best_w = w\n                anchor_nh[h, n] = best_w\n            else:\n                anchor_nh[h, n] = anchor_h[h]\n    anchor_nh = pna_shrink * anchor_nh + (1-pna_shrink) * anchor_h[:, None]\n    blended = (1 - anchor_nh[None, :, :]) * base_tr + anchor_nh[None, :, :] * anc_tr\n    h_bias = np.zeros(nh)\n    for h in range(nh):\n        m = mask_tr[:, h, :]\n        h_bias[h] = np.median(blended[:, h, :][m] - tgt_tr[:, h, :][m])\n    corrected = blended - h_bias[None, :, None]\n    residual = corrected - tgt_tr\n    node_shrink = 0.4\n    node_bias = np.zeros(nn)\n    for n in range(nn):\n        m = mask_tr[:, :, n]\n        if m.sum() > 5:\n            node_bias[n] = np.median(residual[:, :, n][m])\n    node_bias = node_shrink * node_bias\n    corrected = corrected - node_bias[None, None, :]\n    residual = residual - node_bias[None, None, :]\n    pnh_shrink = 0.15\n    bias_nh = np.zeros((nh, nn))\n    for h in range(nh):\n        for n in range(nn):\n            m = mask_tr[:, h, n]\n            if m.sum() > 0:\n                raw = np.median(residual[:, h, n][m])\n                bias_nh[h, n] = pnh_shrink * raw\n    corrected = corrected - bias_nh[None, :, :]\n    residual = residual - bias_nh[None, :, :]\n    mult_shrink = 0.5\n    mult_factor = np.ones(nn)\n    for n in range(nn):\n        m = mask_tr[:, :, n]\n        p = corrected[:, :, n][m]\n        tgt = tgt_tr[:, :, n][m]\n        if m.sum() > 20 and np.min(p) > 1:\n            ratios = tgt / p\n            mult_factor[n] = np.median(ratios)\n    mult_factor = 1.0 + mult_shrink * (mult_factor - 1.0)\n    corrected = corrected * mult_factor[None, None, :]\n    residual = residual * mult_factor[None, None, :]\n    return corrected, residual, anchor_nh, h_bias, node_bias, bias_nh, mult_factor\n\ndef apply_v25(base_te, anc_te, anchor_nh, h_bias, node_bias, bias_nh, mult_factor):\n    result = (1 - anchor_nh[None, :, :]) * base_te + anchor_nh[None, :, :] * anc_te\n    result = result - h_bias[None, :, None]\n    result = result - node_bias[None, None, :]\n    result = result - bias_nh[None, :, :]\n    result = result * mult_factor[None, None, :]\n    return result\n\n# Enhanced ridge with node-clock interaction features\ndef ridge_corr_v2(base_tr, anc_tr, hist_tr, clk_tr, residual_tr, mask_tr,\n               base_te, anc_te, hist_te, clk_te, alpha=50.0, shrink=0.5):\n    ns_tr, nh, nn = base_tr.shape\n    ns_te = base_te.shape[0]\n    correction = np.zeros((ns_te, nh, nn))\n    \n    for h in range(nh):\n        hist_last_tr = hist_tr[:, -1, :]\n        hist_avg_tr = hist_tr.mean(axis=1)\n        hist_trend_tr = (hist_tr[:, -1, :] - hist_tr[:, 0, :]) / 12.0\n        hist_last_te = hist_te[:, -1, :]\n        hist_avg_te = hist_te.mean(axis=1)\n        hist_trend_te = (hist_te[:, -1, :] - hist_te[:, 0, :]) / 12.0\n        \n        clk_h_tr = clk_tr[:, h, 0]\n        clk_h_te = clk_te[:, h, 0]\n        \n        node_idx_tr = np.tile(np.arange(nn), (ns_tr, 1))\n        node_idx_te = np.tile(np.arange(nn), (ns_te, 1))\n        \n        # Node-clock interaction: sin(node_pos) * sin(clock), etc.\n        node_sin_tr = np.sin(2*np.pi*node_idx_tr.reshape(-1)/nn)\n        node_cos_tr = np.cos(2*np.pi*node_idx_tr.reshape(-1)/nn)\n        clk_sin_tr = np.repeat(np.sin(2*np.pi*clk_h_tr), nn)\n        clk_cos_tr = np.repeat(np.cos(2*np.pi*clk_h_tr), nn)\n        \n        node_sin_te = np.sin(2*np.pi*node_idx_te.reshape(-1)/nn)\n        node_cos_te = np.cos(2*np.pi*node_idx_te.reshape(-1)/nn)\n        clk_sin_te = np.repeat(np.sin(2*np.pi*clk_h_te), nn)\n        clk_cos_te = np.repeat(np.cos(2*np.pi*clk_h_te), nn)\n        \n        X_tr = np.column_stack([\n            base_tr[:, h, :].reshape(-1, 1),\n            anc_tr[:, h, :].reshape(-1, 1),\n            hist_last_tr.reshape(-1, 1),\n            hist_avg_tr.reshape(-1, 1),\n            hist_trend_tr.reshape(-1, 1),\n            clk_sin_tr.reshape(-1, 1),\n            clk_cos_tr.reshape(-1, 1),\n            node_sin_tr.reshape(-1, 1),\n            node_cos_tr.reshape(-1, 1),\n            (node_sin_tr * clk_sin_tr).reshape(-1, 1),\n            (node_sin_tr * clk_cos_tr).reshape(-1, 1),\n            (node_cos_tr * clk_sin_tr).reshape(-1, 1),\n            (node_cos_tr * clk_cos_tr).reshape(-1, 1),\n            np.sqrt(np.maximum(base_tr[:, h, :], 0)).reshape(-1, 1),\n        ])\n        \n        y_tr = residual_tr[:, h, :].reshape(-1)\n        m_flat = mask_tr[:, h, :].reshape(-1)\n        \n        X_valid = X_tr[m_flat]\n        y_valid = y_tr[m_flat]\n        if len(y_valid) < 100:\n            continue\n        \n        mu = X_valid.mean(axis=0)\n        sd = X_valid.std(axis=0)\n        sd[sd < 1e-6] = 1.0\n        Xs = (X_valid - mu) / sd\n        \n        model = Ridge(alpha=alpha, fit_intercept=True)\n        model.fit(Xs, y_valid)\n        \n        X_te = np.column_stack([\n            base_te[:, h, :].reshape(-1, 1),\n            anc_te[:, h, :].reshape(-1, 1),\n            hist_last_te.reshape(-1, 1),\n            hist_avg_te.reshape(-1, 1),\n            hist_trend_te.reshape(-1, 1),\n            clk_sin_te.reshape(-1, 1),\n            clk_cos_te.reshape(-1, 1),\n            node_sin_te.reshape(-1, 1),\n            node_cos_te.reshape(-1, 1),\n            (node_sin_te * clk_sin_te).reshape(-1, 1),\n            (node_sin_te * clk_cos_te).reshape(-1, 1),\n            (node_cos_te * clk_sin_te).reshape(-1, 1),\n            (node_cos_te * clk_cos_te).reshape(-1, 1),\n            np.sqrt(np.maximum(base_te[:, h, :], 0)).reshape(-1, 1),\n        ])\n        \n        Xs_te = (X_te - mu) / sd\n        pred_resid = model.predict(Xs_te).reshape(ns_te, nn)\n        correction[:, h, :] = shrink * pred_resid\n    \n    return correction\n\nprint()\nprint('v25 + ridge v2 (node-clock interactions):')\nfor alpha in [50, 100, 200]:\n    for shrink in [0.3, 0.5]:\n        maes = []\n        for train_idx, test_idx in kf.split(range(n_samples)):\n            corrected_tr, residual_tr, a_nh, hb, nb, bnh, mf = v25_core(\n                base[train_idx], anchor[train_idx], target[train_idx], mask[train_idx])\n            pred = apply_v25(base[test_idx], anchor[test_idx], a_nh, hb, nb, bnh, mf)\n            \n            corr = ridge_corr_v2(\n                base[train_idx], anchor[train_idx], history[train_idx], clock[train_idx],\n                residual_tr, mask[train_idx],\n                base[test_idx], anchor[test_idx], history[test_idx], clock[test_idx],\n                alpha=alpha, shrink=shrink)\n            pred = pred - corr\n            pred = np.maximum(pred, 0)\n            te_mask = mask[test_idx]\n            mae = np.abs(pred[te_mask] - target[test_idx][te_mask]).mean()\n            maes.append(mae)\n        print(f'  alpha={alpha:4d}, shrink={shrink:.2f}: CV MAE = {np.mean(maes):.4f}')\n\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

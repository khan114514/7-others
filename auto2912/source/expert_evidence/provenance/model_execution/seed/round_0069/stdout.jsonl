{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_tgt = np.load('/workspace/public_assets/train_targets.npz')\ngraph = np.load('/workspace/public_assets/graph.npz')\n\nbase = train_feat['base'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\ntarget = train_tgt['target'].astype(np.float64)\nadj = graph['adjacency'].astype(np.float64)\n\nmask = np.isfinite(target) & (target > 0)\nn_samples, n_horizons, n_nodes = base.shape\n\nprint('=== Graph analysis ===')\nprint(f'Adjacency shape: {adj.shape}')\nprint(f'Edges per node: mean={adj.sum(axis=1).mean():.1f}, min={adj.sum(axis=1).min():.0f}, max={adj.sum(axis=1).max():.0f}')\nprint(f'Symmetric: {np.allclose(adj, adj.T)}')\n# Check row sums\nrow_sums = adj.sum(axis=1)\nprint(f'Row sum stats: mean={row_sums.mean():.3f}, min={row_sums.min():.3f}, max={row_sums.max():.3f}')\n\nprint()\nprint('=== History-based correction analysis ===')\n# How much does history help explain residuals?\n# residual = base - target\nresidual = base - target\n\n# History last step vs base ratio\nhist_last = history[:, -1, :]  # (74, 170)\nbase_h0 = base[:, 0, :]  # (74, 170)\nratio_h0 = base_h0 / np.maximum(hist_last, 1e-6)\ntarget_h0 = target[:, 0, :]\ntgt_ratio_h0 = target_h0 / np.maximum(hist_last, 1e-6)\n\n# MAE if we use last history step for horizon 0\nm0 = mask[:, 0, :]\nprint(f'Hist-last MAE (h=0): {np.abs(hist_last[m0] - target_h0[m0]).mean():.3f}')\nprint(f'Base MAE (h=0): {np.abs(base_h0[m0] - target_h0[m0]).mean():.3f}')\n\n# What about blend of base and history for each horizon?\nprint()\nprint('Per-horizon: optimal blend of base and last history value')\nprint(f'{'H':>3} {'Base MAE':>10} {'Hist-only':>10} {'Opt w*':>8} {'Opt MAE':>10}')\nfor h in range(n_horizons):\n    m = mask[:, h, :]\n    b_mae = np.abs(base[:, h, :][m] - target[:, h, :][m]).mean()\n    h_mae = np.abs(hist_last[m] - target[:, h, :][m]).mean()\n    best_mae = float('inf')\n    best_w = 0\n    for w in np.linspace(0, 1, 101):\n        pred = w * base[:, h, :][m] + (1-w) * hist_last[m]\n        mae = np.abs(pred - target[:, h, :][m]).mean()\n        if mae < best_mae:\n            best_mae = mae\n            best_w = w\n    print(f'{h:3d} {b_mae:10.3f} {h_mae:10.3f} {best_w:8.3f} {best_mae:10.3f}')\n\nprint()\n# Clock-based correction\nprint('=== Clock analysis ===')\n# Is there a time-of-day pattern in the bias?\nclock_h0 = clock[:, 0, 0]  # time of day at start\nprint(f'Time of day range: {clock_h0.min():.3f} to {clock_h0.max():.3f}')\n# Bin by time of day\nn_bins = 8\nbins = np.linspace(0, 1, n_bins+1)\nbias_h = (base - target).mean(axis=(1,2))  # per-sample average bias\nfor i in range(n_bins):\n    in_bin = (clock_h0 >= bins[i]) & (clock_h0 < bins[i+1])\n    if in_bin.sum() > 0:\n        print(f'  Bin [{bins[i]:.2f}-{bins[i+1]:.2f}]: n={in_bin.sum()}, avg bias={bias_h[in_bin].mean():.3f}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

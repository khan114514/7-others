   result = result - h_bias[None, :, None]\n    result = result - node_bias[None, None, :]\n    result = result - bias_nh[None, :, :]\n    result = result * mult_factor[None, None, :]\n    return result\n\n# Enhanced ridge with node-clock interaction features\ndef ridge_corr_v2(base_tr, anc_tr, hist_tr, clk_tr, residual_tr, mask_tr,\n               base_te, anc_te, hist_te, clk_te, alpha=50.0, shrink=0.5):\n    ns_tr, nh, nn = base_tr.shape\n    ns_te = base_te.shape[0]\n    correction = np.zeros((ns_te, nh, nn))\n    \n    for h in range(nh):\n        hist_last_tr = hist_tr[:, -1, :]\n        hist_avg_tr = hist_tr.mean(axis=1)\n        hist_trend_tr = (hist_tr[:, -1, :] - hist_tr[:, 0, :]) / 12.0\n        hist_last_te = hist_te[:, -1, :]\n        hist_avg_te = hist_te.mean(axis=1)\n        hist_trend_te = (hist_te[:, -1, :] - hist_te[:, 0, :]) / 12.0\n        \n        clk_h_tr = clk_tr[:, h, 0]\n        clk_h_te = clk_te[:, h, 0]\n        \n        node_idx_tr = np.tile(np.arange(nn), (ns_tr, 1))\n        node_idx_te = np.tile(np.arange(nn), (ns_te, 1))\n        \n        # Node-clock interaction: sin(node_pos) * sin(clock), etc.\n        node_sin_tr = np.sin(2*np.pi*node_idx_tr.reshape(-1)/nn)\n        node_cos_tr = np.cos(2*np.pi*node_idx_tr.reshape(-1)/nn)\n        clk_sin_tr = np.repeat(np.sin(2*np.pi*clk_h_tr), nn)\n        clk_cos_tr = np.repeat(np.cos(2*np.pi*clk_h_tr), nn)\n        \n        node_sin_te = np.sin(2*np.pi*node_idx_te.reshape(-1)/nn)\n        node_cos_te = np.cos(2*np.pi*node_idx_te.reshape(-1)/nn)\n        clk_sin_te = np.repeat(np.sin(2*np.pi*clk_h_te), nn)\n        clk_cos_te = np.repeat(np.cos(2*np.pi*clk_h_te), nn)\n        \n        X_tr = np.column_stack([\n            base_tr[:, h, :].reshape(-1, 1),\n            anc_tr[:, h, :].reshape(-1, 1),\n            hist_last_tr.reshape(-1, 1),\n            hist_avg_tr.reshape(-1, 1),\n            hist_trend_tr.reshape(-1, 1),\n            clk_sin_tr.reshape(-1, 1),\n            clk_cos_tr.reshape(-1, 1),\n            node_sin_tr.reshape(-1, 1),\n            node_cos_tr.reshape(-1, 1),\n            (node_sin_tr * clk_sin_tr).reshape(-1, 1),\n            (node_sin_tr * clk_cos_tr).reshape(-1, 1),\n            (node_cos_tr * clk_sin_tr).reshape(-1, 1),\n            (node_cos_tr * clk_cos_tr).reshape(-1, 1),\n            np.sqrt(np.maximum(base_tr[:, h, :], 0)).reshape(-1, 1),\n        ])\n        \n        y_tr = residual_tr[:, h, :].reshape(-1)\n        m_flat = mask_tr[:, h, :].reshape(-1)\n        \n        X_valid = X_tr[m_flat]\n        y_valid = y_tr[m_flat]\n        if len(y_valid) < 100:\n            continue\n        \n        mu = X_valid.mean(axis=0)\n        sd = X_valid.std(axis=0)\n        sd[sd < 1e-6] = 1.0\n        Xs = (X_valid - mu) / sd\n        \n        model = Ridge(alpha=alpha, fit_intercept=True)\n        model.fit(Xs, y_valid)\n        \n        X_te = np.column_stack([\n            base_te[:, h, :].reshape(-1, 1),\n            anc_te[:, h, :].reshape(-1, 1),\n            hist_last_te.reshape(-1, 1),\n            hist_avg_te.reshape(-1, 1),\n            hist_trend_te.reshape(-1, 1),\n            clk_sin_te.reshape(-1, 1),\n            clk_cos_te.reshape(-1, 1),\n            node_sin_te.reshape(-1, 1),\n            node_cos_te.reshape(-1, 1),\n            (node_sin_te * clk_sin_te).reshape(-1, 1),\n            (node_sin_te * clk_cos_te).reshape(-1, 1),\n            (node_cos_te * clk_sin_te).reshape(-1, 1),\n            (node_cos_te * clk_cos_te).reshape(-1, 1),\n            np.sqrt(np.maximum(base_te[:, h, :], 0)).reshape(-1, 1),\n        ])\n        \n        Xs_te = (X_te - mu) / sd\n        pred_resid = model.predict(Xs_te).reshape(ns_te, nn)\n        correction[:, h, :] = shrink * pred_resid\n    \n    return correction\n\nprint()\nprint('v25 + ridge v2 (node-clock interactions):')\nfor alpha in [50, 100, 200]:\n    for shrink in [0.3, 0.5]:\n        maes = []\n        for train_idx, test_idx in kf.split(range(n_samples)):\n            corrected_tr, residual_tr, a_nh, hb, nb, bnh, mf = v25_core(\n                base[train_idx], anchor[train_idx], target[train_idx], mask[train_idx])\n            pred = apply_v25(base[test_idx], anchor[test_idx], a_nh, hb, nb, bnh, mf)\n            \n            corr = ridge_corr_v2(\n                base[train_idx], anchor[train_idx], history[train_idx], clock[train_idx],\n                residual_tr, mask[train_idx],\n                base[test_idx], anchor[test_idx], history[test_idx], clock[test_idx],\n                alpha=alpha, shrink=shrink)\n            pred = pred - corr\n            pred = np.maximum(pred, 0)\n            te_mask = mask[test_idx]\n            mae = np.abs(pred[te_mask] - target[test_idx][te_mask]).mean()\n            maes.append(mae)\n        print(f'  alpha={alpha:4d}, shrink={shrink:.2f}: CV MAE = {np.mean(maes):.4f}')\n\nPYEOF\n\"","aggregated_output":"=== Per-node clock pattern in residuals ===\nNodes with >10% variance explained by time-of-day: 6/170\n\nv25 + ridge v2 (node-clock interactions):\n  alpha=  50, shrink=0.30: CV MAE = 14.3445\n  alpha=  50, shrink=0.50: CV MAE = 14.3404\n  alpha= 100, shrink=0.30: CV MAE = 14.3462\n  alpha= 100, shrink=0.50: CV MAE = 14.3421\n  alpha= 200, shrink=0.30: CV MAE = 14.3487\n  alpha= 200, shrink=0.50: CV MAE = 14.3449\n","exit_code":0,"status":"completed"}}

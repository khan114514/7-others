 dev\nprint('Base-anchor difference:')\nba_tr = base - anchor\nba_dv = base_dev - anchor_dev\nprint(f'  train: mean={ba_tr.mean():.3f}, std={ba_tr.std():.3f}')\nprint(f'  dev:   mean={ba_dv.mean():.3f}, std={ba_dv.std():.3f}')\n\\\"\n\"","aggregated_output":"=== Feature distribution comparison ===\nbase           : train mean=227.09, dev mean=230.62\n                 train std=144.58,  dev std=147.51\n                 train median=213.55, dev median=217.03\nanchor         : train mean=223.61, dev mean=232.03\n                 train std=138.07,  dev std=142.42\n                 train median=210.20, dev median=221.00\nhistory_last   : train mean=229.45, dev mean=231.42\n                 train std=146.22,  dev std=147.48\n                 train median=213.00, dev median=216.00\nhistory_avg    : train mean=225.69, dev mean=232.27\n                 train std=143.19,  dev std=146.25\n                 train median=211.33, dev median=218.79\n\nClock (time-of-day) distribution:\n  train: n=74, range=[0.028, 0.986]\n  dev:   n=148, range=[0.010, 0.969]\n  train bins: [ 9 10 10  9  9  9  9  9]\n  dev bins: [18 18 18 20 20 18 18 18]\n\nBase-anchor difference:\n  train: mean=3.484, std=32.999\n  dev:   mean=-1.414, std=43.034\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np\nfrom sklearn.model_selection import KFold\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_tgt = np.load('/workspace/public_assets/train_targets.npz')\ngraph = np.load('/workspace/public_assets/graph.npz')\n\nbase = train_feat['base'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\ntarget = train_tgt['target'].astype(np.float64)\nadj = graph['adjacency'].astype(np.float64)\n\nmask = np.isfinite(target) & (target > 0)\nn_samples, n_horizons, n_nodes = base.shape\n\nkf = KFold(n_splits=5, shuffle=True, random_state=42)\n\n# Key observation: base-anchor diff is very different in train vs dev\n# train: +3.48, dev: -1.41\n# This means per-sample bias correction based on base-anchor diff could be dangerous\n# if it's not robust.\n\n# Let's think about what's most transferable:\n# 1. Per-node bias corrections (if nodes have consistent bias) - likely transferable\n# 2. Per-horizon bias - likely transferable  \n# 3. Multiplicative per-node - likely transferable\n# 4. Sample-level corrections (base-anchor diff) - RISKY because distribution shifts\n\n# Let's check: what does the current v25 dev MAE look like?\n# We got 15.194 on dev. CV on train gives ~14.38\n# Gap is ~0.8 MAE. Part of this is just harder samples, part may be overfitting.\n\n# Let's try something fundamentally different: \n# Quantile regression / isotonic style calibration per node\n# OR: ensemble of multiple correction strategies with CV-based weights\n\n# Actually, let me try: can we add graph-smoothed per-node features to ridge?\n# And try more sophisticated feature engineering\n\n# Also: let me check if we're overfitting on per-sample corrections\n# by checking the contribution of each step\n\ndef v25_decompose(base_tr, anc_tr, hist_tr, clk_tr, tgt_tr, mask_tr,\n                   base_te, anc_te, hist_te, clk_te):\n    '''Returns MAE after each step'''\n    ns_tr, nh, nn = base_tr.shape\n    \n    results = {}\n    \n    # Step 0: raw base\n    te_mask = mask_tr[:0]  # placeholder\n    \n    # Step 1: per-horizon anchor blending\n    anchor_h = np.zeros(nh)\n    for h in range(nh):\n        m = mask_tr[:, h, :]\n        best_mae = float('inf')\n        for w in np.linspace(0, 0.30, 31):\n            pred = (1-w)*base_tr[:, h, :][m] + w*anc_tr[:, h, :][m]\n            mae = np.abs(pred - tgt_tr[:, h, :][m]).mean()\n            if mae < best_mae:\n                best_mae = mae\n                anchor_h[h] = w\n    \n    pna_shrink = 0.2\n    anchor_nh = np.zeros((nh, nn))\n    for h in range(nh):\n        for n in range(nn):\n            m = mask_tr[:, h, n]\n            if m.sum() > 15:\n                best_mae = float('inf')\n                best_w = anchor_h[h]\n                for w in np.linspace(0, 0.40, 21):\n                    pred = (1-w)*base_tr[:, h, n][m] + w*anc_tr[:, h, n][m]\n                    mae = np.abs(pred - tgt_tr[:, h, n][m]).mean()\n                    if mae < best_mae:\n                        best_mae = mae\n                        best_w = w\n                anchor_nh[h, n] = best_w\n            else:\n                anchor_nh[h, n] = anchor_h[h]\n    anchor_nh = pna_shrink * anchor_nh + (1-pna_shrink) * anchor_h[:, None]\n    \n    result = (1 - anchor_nh[None, :, :]) * base_te + anchor_nh[None, :, :] * anc_te\n    result_tr = (1 - anchor_nh[None, :, :]) * base_tr + anchor_nh[None, :, :] * anc_tr\n    \n    # Step 3: per-horizon median bias\n    h_bias = np.zeros(nh)\n    for h in range(nh):\n        m = mask_tr[:, h, :]\n        h_bias[h] = np.median(result_tr[:, h, :][m] - tgt_tr[:, h, :][m])\n    result = result - h_bias[None, :, None]\n    result_tr = result_tr - h_bias[None, :, None]\n    \n    # Step 4: per-node bias\n    node_shrink = 0.4\n    node_bias = np.zeros(nn)\n    residual_tr = result_tr - tgt_tr\n    for n in range(nn):\n        m = mask_tr[:, :, n]\n        if m.sum() > 5:\n            node_bias[n] = np.median(residual_tr[:, :, n][m])\n    node_bias = node_shrink * node_bias\n    result = result - node_bias[None, None, :]\n    result_tr = result_tr - node_bias[None, None, :]\n    residual_tr = residual_tr - node_bias[None, None, :]\n    \n    # Step 5: per-node-horizon bias\n    pnh_shrink = 0.15\n    bias_nh = np.zeros((nh, nn))\n    for h in range(nh):\n        for n in range(nn):\n            m = mask_tr[:, h, n]\n            if m.sum() > 0:\n                raw = np.median(residual_tr[:, h, n][m])\n                bias_nh[h, n] = pnh_shrink * raw\n    result = result - bias_nh[None, :, :]\n    result_tr = result_tr - bias_nh[None, :, :]\n    residual_tr = residual_tr - bias_nh[None, :, :]\n    \n    # Step 6: multiplicative\n    mult_shrink = 0.5\n    mult_factor = np.ones(nn)\n    for n in range(nn):\n        m = mask_tr[:, :, n]\n        p = result_tr[:, :, n][m]\n        tgt = tgt_tr[:, :, n][m]\n        if m.sum() > 20 and np.min(p) > 1:\n            ratios = tgt / p\n            mult_factor[n] = np.median(ratios)\n    mult_factor = 1.0 + mult_shrink * (mult_factor - 1.0)\n    result = result * mult_factor[None, None, :]\n    result_tr = result_tr * mult_factor[None, None, :]\n    residual_tr = residual_tr * mult_factor[None, None, :]\n    \n    return np.maximum(result, 0), result_tr, residual_tr\n\n# Now let's try a new idea: \n# Instead of median-based corrections, use per-node-horizon \n# linear recalibration: target = a * base + b\n# with heavy shrinkage toward the global model\n\ndef linear_recalibrate(base_tr, anc_tr, hist_tr, clk_tr, tgt_tr, mask_tr,\n                        base_te, anc_te, hist_te, clk_te,\n                        nh_slope=0.3, nn_slope=0.2, nh_intercept=0.3, nn_intercept=0.2):\n    '''Per-node-horizon linear recalibration with shrinkage'''\n    ns_tr, nh, nn = base_tr.shape\n    \n    # Global per-horizon linear model\n    h_slope = np.ones(nh)\n    h_intercept = np.zeros(nh)\n    for h in range(nh):\n        m = mask_tr[:, h, :]\n        x = base_tr[:, h, :][m]\n        y = tgt_tr[:, h, :][m]\n        # fit y = a*x + b\n        a, b = np.polyfit(x, y, 1)\n        h_slope[h] = a\n        h_intercept[h] = b\n    \n    # Per-node-horizon linear model, shrunken toward global\n    nh_slopes = np.zeros((nh, nn))\n    nh_intercepts = np.zeros((nh, nn))\n    \n    for h in range(nh):\n        for n in range(nn):\n            m = mask_tr[:, h, n]\n            if m.sum() > 10:\n                x = base_tr[:, h, n][m]\n                y = tgt_tr[:, h, n][m]\n                if x.std() > 1e-3:\n                    a, b = np.polyfit(x, y, 1)\n                    # Check if slope is reasonable\n                    if 0 < a < 3:\n                        nh_slopes[h, n] = a\n                        nh_intercepts[h, n] = b\n                    else:\n                        nh_slopes[h, n] = h_slope[h]\n                        nh_intercepts[h, n] = h_intercept[h]\n                else:\n                    nh_slopes[h, n] = h_slope[h]\n                    nh_intercepts[h, n] = h_intercept[h]\n            else:\n                nh_slopes[h, n] = h_slope[h]\n                nh_intercepts[h, n] = h_intercept[h]\n    \n    # Shrink toward global\n    slopes = nh_slope * nh_slopes + (1-nh_slope) * h_slope[:, None]\n    intercepts = nh_intercept * nh_intercepts + (1-nh_intercept) * h_intercept[:, None]\n    \n    # Apply\n    result = slopes[None, :, :] * base_te + intercepts[None, :, :]\n    return np.maximum(result, 0)\n\nprint('Linear recalibration (varying shrinkage):')\nfor ns in [0.0, 0.05, 0.1, 0.2, 0.3, 0.5]:\n    for ni in [0.0, 0.05, 0.1, 0.2, 0.3]:\n        maes = []\n        for train_idx, test_idx in kf.split(range(n_samples)):\n            pred = linear_recalibrate(\n                base[train_idx], anchor[train_idx], history[train_idx], clock[train_idx],\n                target[train_idx], mask[train_idx],\n                base[test_idx], anchor[test_idx], history[test_idx], clock[test_idx],\n                nh_slope=ns, nn_slope=0.0, nh_intercept=ni, nn_intercept=0.0\n            )\n            te_mask = mask[test_idx]\n            mae = np.abs(pred[te_mask] - target[test_idx][te_mask]).mean()\n            maes.append(mae)\n        if ns == 0.2 and ni == 0.3:  # highlight interesting\n            print(f'  slope_shrink={ns:.2f}, intercept_shrink={ni:.2f}: CV MAE = {np.mean(maes):.4f} ***')\n        else:\n            print(f'  slope_shrink={ns:.2f}, intercept_shrink={ni:.2f}: CV MAE = {np.mean(maes):.4f}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

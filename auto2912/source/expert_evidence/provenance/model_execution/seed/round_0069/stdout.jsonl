shape(-1, 1),\n            (base_te[:, h, :] * anc_te[:, h, :]).reshape(-1, 1),\n            np.sqrt(np.maximum(base_te[:, h, :], 0)).reshape(-1, 1),\n        ])\n        Xs_te = (X_te - mu) / sd\n        pred_bias = model.predict(Xs_te).reshape(ns_te, nn)\n        \n        # Correct: result = base - predicted_bias\n        result[:, h, :] = base_te[:, h, :] - pred_bias\n    \n    return np.maximum(result, 0.0)\n\nprint('\"'Testing ridge regression with different alphas:')\nfor alpha in [1.0, 10.0, 50.0, 100.0, 500.0, 1000.0]:\n    maes = []\n    for train_idx, test_idx in kf.split(range(n_samples)):\n        pred = ridge_method(\n            base[train_idx], anchor[train_idx], history[train_idx], clock[train_idx],\n            target[train_idx], mask[train_idx],\n            base[test_idx], anchor[test_idx], history[test_idx], clock[test_idx],\n            ridge_alpha=alpha\n        )\n        te_mask = mask[test_idx]\n        mae = np.abs(pred[te_mask] - target[test_idx][te_mask]).mean()\n        maes.append(mae)\n    print(f'  alpha={alpha:8.1f}: CV MAE = {np.mean(maes):.4f} (std={np.std(maes):.4f})')\n\\\"\n\"","aggregated_output":"Testing ridge regression with different alphas:\n  alpha=     1.0: CV MAE = 14.6768 (std=1.0749)\n  alpha=    10.0: CV MAE = 14.6726 (std=1.0744)\n  alpha=    50.0: CV MAE = 14.6658 (std=1.0739)\n  alpha=   100.0: CV MAE = 14.6662 (std=1.0727)\n  alpha=   500.0: CV MAE = 14.7067 (std=1.0625)\n  alpha=  1000.0: CV MAE = 14.7419 (std=1.0551)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np\nfrom sklearn.linear_model import Ridge\nfrom sklearn.model_selection import KFold\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_tgt = np.load('/workspace/public_assets/train_targets.npz')\ngraph = np.load('/workspace/public_assets/graph.npz')\n\nbase = train_feat['base'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\ntarget = train_tgt['target'].astype(np.float64)\nadj = graph['adjacency'].astype(np.float64)\n\nmask = np.isfinite(target) & (target > 0)\nn_samples, n_horizons, n_nodes = base.shape\n\nkf = KFold(n_splits=5, shuffle=True, random_state=42)\n\n# Let's try combining v25-style corrections with ridge residual correction\n# First replicate v25 more carefully, then add ridge on top\n\ndef v25_method(base_tr, anc_tr, hist_tr, clk_tr, tgt_tr, mask_tr,\n               base_te, anc_te, hist_te, clk_te):\n    ns_tr, nh, nn = base_tr.shape\n    ns_te = base_te.shape[0]\n    \n    # Step 1: per-horizon anchor blending\n    anchor_h = np.zeros(nh)\n    for h in range(nh):\n        m = mask_tr[:, h, :]\n        best_mae = float('inf')\n        for w in np.linspace(0, 0.30, 31):\n            pred = (1-w)*base_tr[:, h, :][m] + w*anc_tr[:, h, :][m]\n            mae = np.abs(pred - tgt_tr[:, h, :][m]).mean()\n            if mae < best_mae:\n                best_mae = mae\n                anchor_h[h] = w\n    \n    # Step 2: per-node-horizon anchor blending\n    pna_shrink = 0.2\n    anchor_nh = np.zeros((nh, nn))\n    for h in range(nh):\n        for n in range(nn):\n            m = mask_tr[:, h, n]\n            if m.sum() > 15:\n                best_mae = float('inf')\n                best_w = anchor_h[h]\n                for w in np.linspace(0, 0.40, 21):\n                    pred = (1-w)*base_tr[:, h, n][m] + w*anc_tr[:, h, n][m]\n                    mae = np.abs(pred - tgt_tr[:, h, n][m]).mean()\n                    if mae < best_mae:\n                        best_mae = mae\n                        best_w = w\n                anchor_nh[h, n] = best_w\n            else:\n                anchor_nh[h, n] = anchor_h[h]\n    anchor_nh = pna_shrink * anchor_nh + (1-pna_shrink) * anchor_h[:, None]\n    \n    # Blend\n    blended_tr = (1 - anchor_nh[None, :, :]) * base_tr + anchor_nh[None, :, :] * anc_tr\n    blended_te = (1 - anchor_nh[None, :, :]) * base_te + anchor_nh[None, :, :] * anc_te\n    \n    # Step 3: per-horizon median bias\n    h_bias = np.zeros(nh)\n    for h in range(nh):\n        m = mask_tr[:, h, :]\n        h_bias[h] = np.median(blended_tr[:, h, :][m] - tgt_tr[:, h, :][m])\n    \n    corrected_tr = blended_tr - h_bias[None, :, None]\n    corrected_te = blended_te - h_bias[None, :, None]\n    residual = corrected_tr - tgt_tr\n    \n    # Step 4: per-node median bias (shrink 0.4)\n    node_shrink = 0.4\n    node_bias = np.zeros(nn)\n    for n in range(nn):\n        m = mask_tr[:, :, n]\n        if m.sum() > 5:\n            node_bias[n] = np.median(residual[:, :, n][m])\n    node_bias = node_shrink * node_bias\n    corrected_tr = corrected_tr - node_bias[None, None, :]\n    corrected_te = corrected_te - node_bias[None, None, :]\n    residual = residual - node_bias[None, None, :]\n    \n    # Step 5: per-node-horizon median bias (shrink 0.15)\n    pnh_shrink = 0.15\n    bias_nh = np.zeros((nh, nn))\n    for h in range(nh):\n        for n in range(nn):\n            m = mask_tr[:, h, n]\n            if m.sum() > 0:\n                raw = np.median(residual[:, h, n][m])\n                bias_nh[h, n] = pnh_shrink * raw\n    corrected_tr = corrected_tr - bias_nh[None, :, :]\n    corrected_te = corrected_te - bias_nh[None, :, :]\n    residual = residual - bias_nh[None, :, :]\n    \n    # Step 6: multiplicative per-node\n    mult_shrink = 0.5\n    mult_factor = np.ones(nn)\n    for n in range(nn):\n        m = mask_tr[:, :, n]\n        p = corrected_tr[:, :, n][m]\n        tgt = tgt_tr[:, :, n][m]\n        if m.sum() > 20 and np.min(p) > 1:\n            ratios = tgt / p\n            mult_factor[n] = np.median(ratios)\n    mult_factor = 1.0 + mult_shrink * (mult_factor - 1.0)\n    corrected_tr = corrected_tr * mult_factor[None, None, :]\n    corrected_te = corrected_te * mult_factor[None, None, :]\n    residual = residual * mult_factor[None, None, :]\n    \n    return corrected_tr, corrected_te, residual\n\n# Now let's test v25 + ridge correction\nprint('v25 + ridge residual correction:')\nfor alpha in [10, 50, 100, 500, 1000]:\n    for shrink in [0.1, 0.3, 0.5, 1.0]:\n        maes = []\n        for train_idx, test_idx in kf.split(range(n_samples)):\n            corrected_tr, corrected_te, residual_tr = v25_method(\n                base[train_idx], anchor[train_idx], history[train_idx], clock[train_idx],\n                target[train_idx], mask[train_idx],\n                base[test_idx], anchor[test_idx], history[test_idx], clock[test_idx]\n            )\n            \n            hist_tr = history[train_idx]\n            hist_te = history[test_idx]\n            clk_tr = clock[train_idx]\n            clk_te = clock[test_idx]\n            \n            ns_te = corrected_te.shape[0]\n            nh = n_horizons\n            nn = n_nodes\n            \n            for h in range(nh):\n                hist_last_tr = hist_tr[:, -1, :]\n                hist_avg_tr = hist_tr.mean(axis=1)\n                hist_trend_tr = (hist_tr[:, -1, :] - hist_tr[:, 0, :]) / 12.0\n                hist_last_te = hist_te[:, -1, :]\n                hist_avg_te = hist_te.mean(axis=1)\n                hist_trend_te = (hist_te[:, -1, :] - hist_te[:, 0, :]) / 12.0\n                \n                clk_h_tr = clk_tr[:, h, 0]\n                clk_h_te = clk_te[:, h, 0]\n                \n                node_idx_tr = np.tile(np.arange(nn), (len(train_idx), 1))\n                node_idx_te = np.tile(np.arange(nn), (ns_te, 1))\n                \n                X_tr = np.column_stack([\n                    corrected_tr[:, h, :].reshape(-1, 1),\n                    anchor[train_idx][:, h, :].reshape(-1, 1),\n                    hist_last_tr.reshape(-1, 1),\n                    hist_avg_tr.reshape(-1, 1),\n                    hist_trend_tr.reshape(-1, 1),\n                    np.sin(2*np.pi*np.repeat(clk_h_tr, nn)).reshape(-1,1),\n                    np.cos(2*np.pi*np.repeat(clk_h_tr, nn)).reshape(-1,1),\n                    np.sin(2*np.pi*node_idx_tr.reshape(-1)/nn).reshape(-1,1),\n                    np.cos(2*np.pi*node_idx_tr.reshape(-1)/nn).reshape(-1,1),\n                ])\n                \n                y_tr = residual_tr[:, h, :].reshape(-1)\n                m_flat = mask[train_idx][:, h, :].reshape(-1)\n                \n                X_valid = X_tr[m_flat]\n                y_valid = y_tr[m_flat]\n                \n                if len(y_valid) < 100:\n                    continue\n                \n                mu = X_valid.mean(axis=0)\n                sd = X_valid.std(axis=0)\n                sd[sd < 1e-6] = 1.0\n                Xs = (X_valid - mu) / sd\n                \n                model = Ridge(alpha=alpha, fit_intercept=True)\n                model.fit(Xs, y_valid)\n                \n                X_te = np.column_stack([\n                    corrected_te[:, h, :].reshape(-1, 1),\n                    anchor[test_idx][:, h, :].reshape(-1, 1),\n                    hist_last_te.reshape(-1, 1),\n                    hist_avg_te.reshape(-1, 1),\n                    hist_trend_te.reshape(-1, 1),\n                    np.sin(2*np.pi*np.repeat(clk_h_te, nn)).reshape(-1,1),\n                    np.cos(2*np.pi*np.repeat(clk_h_te, nn)).reshape(-1,1),\n                    np.sin(2*np.pi*node_idx_te.reshape(-1)/nn).reshape(-1,1),\n                    np.cos(2*np.pi*node_idx_te.reshape(-1)/nn).reshape(-1,1),\n                ])\n                Xs_te = (X_te - mu) / sd\n                pred_resid = model.predict(Xs_te).reshape(ns_te, nn)\n                corrected_te[:, h, :] = corrected_te[:, h, :] - shrink * pred_resid\n            \n            te_mask = mask[test_idx]\n            result = np.maximum(corrected_te, 0)\n            mae = np.abs(result[te_mask] - target[test_idx][te_mask]).mean()\n            maes.append(mae)\n        print(f'  alpha={alpha:5d}, shrink={shrink:.2f}: CV MAE = {np.mean(maes):.4f}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np\nfrom sklearn.model_selection import KFold\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_tgt = np.load('/workspace/public_assets/train_targets.npz')\n\nbase = train_feat['base'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\ntarget = train_tgt['target'].astype(np.float64)\n\nmask = np.isfinite(target) & (target > 0)\nn_samples, n_horizons, n_nodes = base.shape\n\n# Quick test: per-horizon linear recalibration (just global per horizon)\nkf = KFold(n_splits=5, shuffle=True, random_state=42)\n\n# Just per-horizon linear fit (y = a*base + b)\nmaes = []\nfor train_idx, test_idx in kf.split(range(n_samples)):\n    result = base[test_idx].copy()\n    for h in range(n_horizons):\n        m = mask[train_idx][:, h, :]\n        x = base[train_idx][:, h, :][m]\n        y = target[train_idx][:, h, :][m]\n        a, b = np.polyfit(x, y, 1)\n        result[:, h, :] = a * result[:, h, :] + b\n    result = np.maximum(result, 0)\n    te_mask = mask[test_idx]\n    mae = np.abs(result[te_mask] - target[test_idx][te_mask]).mean()\n    maes.append(mae)\nprint(f'Per-horizon linear recalibration: {np.mean(maes):.4f}')\n\n# per-node linear recalibration with shrinkage\nfor shrink in [0.1, 0.3, 0.5, 0.7, 0.9]:\n    maes = []\n    for train_idx, test_idx in kf.split(range(n_samples)):\n        # Global per-horizon\n        h_slope = np.ones(n_horizons)\n        h_intercept = np.zeros(n_horizons)\n        for h in range(n_horizons):\n            m = mask[train_idx][:, h, :]\n            x = base[train_idx][:, h, :][m]\n            y = target[train_idx][:, h, :][m]\n            a, b = np.polyfit(x, y, 1)\n            h_slope[h] = a\n            h_intercept[h] = b\n        \n        # Per-node per-horizon\n        node_h_slope = np.zeros((n_horizons, n_nodes))\n        node_h_intercept = np.zeros((n_horizons, n_nodes))\n        for h in range(n_horizons):\n            for n in range(n_nodes):\n                m = mask[train_idx][:, h, n]\n                if m.sum() > 10:\n                    x = base[train_idx][:, h, n][m]\n                    y = target[train_idx][:, h, n][m]\n                    if x.std() > 1e-3:\n                        a, b = np.polyfit(x, y, 1)\n                        if 0.3 < a < 2.0:\n                            node_h_slope[h, n] = a\n                            node_h_intercept[h, n] = b\n                        else:\n                            node_h_slope[h, n] = h_slope[h]\n                            node_h_intercept[h, n] = h_intercept[h]\n                    else:\n                        node_h_slope[h, n] = h_slope[h]\n                        node_h_intercept[h, n] = h_intercept[h]\n                else:\n                    node_h_slope[h, n] = h_slope[h]\n                    node_h_intercept[h, n] = h_intercept[h]\n        \n        # Shrink toward global\n        slopes = shrink * node_h_slope + (1-shrink) * h_slope[:, None]\n        intercepts = shrink * node_h_intercept + (1-shrink) * h_intercept[:, None]\n        \n        result = slopes[None, :, :] * base[test_idx] + intercepts[None, :, :]\n        result = np.maximum(result, 0)\n        te_mask = mask[test_idx]\n        mae = np.abs(result[te_mask] - target[test_idx][te_mask]).mean()\n        maes.append(mae)\n    print(f'Per-node-hor linear (shrink={shrink:.1f}): {np.mean(maes):.4f}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np\nfrom sklearn.linear_model import Ridge, Lasso\nfrom sklearn.model_selection import KFold\n\ntrain_feat = np.load('/workspace/public_assets/train_features.npz')\ntrain_tgt = np.load('/workspace/public_assets/train_targets.npz')\n\nbase = train_feat['base'].astype(np.float64)\nanchor = train_feat['anchor'].astype(np.float64)\nhistory = train_feat['history'].astype(np.float64)\nclock = train_feat['clock'].astype(np.float64)\ntarget = train_tgt['target'].astype(np.float64)\n\nmask = np.isfinite(target) & (target > 0)\nn_samples, n_horizons, n_nodes = base.shape\n\n# Cross-validation to understand what improvements are real\n# Build a simple CV framework\nrng = np.random.RandomState(42)\nkf = KFold(n_splits=5, shuffle=True, random_state=42)\n\n# Test 1: Current method (v25) - replicate and check CV performance\n# Let's implement a simplified version in CV\n\ndef method_v25_fit_predict(train_base, train_anchor, train_hist, train_clock, train_tgt, train_mask,\n                           test_base, test_anchor, test_hist, test_clock):\n    ns_tr, nh, nn = train_base.shape\n    result = test_base.copy()\n    \n    # Step 1: per-horizon anchor blending\n    anchor_h = np.zeros(nh)\n    for h in range(nh):\n        m = train_mask[:, h, :]\n        best_mae = float('inf')\n        for w in np.linspace(0, 0.30, 31):\n            pred = (1-w)*train_base[:, h, :][m] + w*train_anchor[:, h, :][m]\n            mae = np.abs(pred - train_tgt[:, h, :][m]).mean()\n            if mae < best_mae:\n                best_mae = mae\n                anchor_h[h] = w\n    \n    # Step 2: per-node-horizon anchor blending (shrunken)\n    pna_shrink = 0.2\n    anchor_nh = np.zeros((nh, nn))\n    for h in range(nh):\n        for n in range(nn):\n            m = train_mask[:, h, n]\n            if m.sum() > 15:\n                best_mae = float('inf')\n                best_w = anchor_h[h]\n                for w in np.linspace(0, 0.40, 21):\n                    pred = (1-w)*train_base[:, h, n][m] + w*train_anchor[:, h, n][m]\n                    mae = np.abs(pred - train_tgt[:, h, n][m]).mean()\n                    if mae < best_mae:\n                        best_mae = mae\n                        best_w = w\n                anchor_nh[h, n] = best_w\n            else:\n                anchor_nh[h, n] = anchor_h[h]\n    anchor_nh = pna_shrink * anchor_nh + (1-pna_shrink) * anchor_h[:, np.newaxis]\n    \n    blended = (1 - anchor_nh[np.newaxis, :, :]) * test_base + anchor_nh[np.newaxis, :, :] * test_anchor\n    \n    # Step 3: per-horizon median bias\n    h_bias = np.zeros(nh)\n    for h in range(nh):\n        m = train_mask[:, h, :]\n        train_blended = (1 - anchor_nh[h, :]) * train_base[:, h, :] + anchor_nh[h, :] * train_anchor[:, h, :]\n        h_bias[h] = np.median(train_blended[m] - train_tgt[:, h, :][m])\n    \n    corrected = blended - h_bias[np.newaxis, :, np.newaxis]\n    \n    # Compute training residual\n    train_blended = (1 - anchor_nh[np.newaxis, :, :]) * train_base + anchor_nh[np.newaxis, :, :] * train_anchor\n    train_corrected = train_blended - h_bias[np.newaxis, :, np.newaxis]\n    residual = train_corrected - train_tgt\n    \n    # Step 4: per-node median bias (shrink 0.4)\n    node_shrink = 0.4\n    node_bias = np.zeros(nn)\n    for n in range(nn):\n        m = train_mask[:, :, n]\n        if m.sum() > 5:\n            node_bias[n] = np.median(residual[:, :, n][m])\n    node_bias = node_shrink * node_bias\n    corrected = corrected - node_bias[np.newaxis, np.newaxis, :]\n    residual = residual - node_bias[np.newaxis, np.newaxis, :]\n    \n    # Step 5: per-node-horizon median bias (shrink 0.15)\n    pnh_shrink = 0.15\n    bias_nh = np.zeros((nh, nn))\n    for h in range(nh):\n        for n in range(nn):\n            m = train_mask[:, h, n]\n            if m.sum() > 0:\n                raw = np.median(residual[:, h, n][m])\n                bias_nh[h, n] = pnh_shrink * raw\n    corrected = corrected - bias_nh[np.newaxis, :, :]\n    residual = residual - bias_nh[np.newaxis, :, :]\n    \n    # Step 6: multiplicative per-node\n    mult_shrink = 0.5\n    mult_factor = np.ones(nn)\n    for n in range(nn):\n        m = train_mask[:, :, n]\n        p = train_corrected[:, :, n][m] - node_bias[n] - bias_nh[:, n].mean()\n        tgt = train_tgt[:, :, n][m]\n        if m.sum() > 20 and np.min(p) > 1:\n            ratios = tgt / p\n            mult_factor[n] = np.median(ratios)\n    mult_factor = 1.0 + mult_shrink * (mult_factor - 1.0)\n    corrected = corrected * mult_factor[np.newaxis, np.newaxis, :]\n    \n    return np.maximum(corrected, 0.0)\n\n# 5-fold CV\nmae_scores = []\nbaseline_scores = []\nfor fold, (train_idx, test_idx) in enumerate(kf.split(range(n_samples))):\n    tr_mask = mask[train_idx]\n    te_mask = mask[test_idx]\n    \n    pred = method_v25_fit_predict(\n        base[train_idx], anchor[train_idx], history[train_idx], clock[train_idx], target[train_idx], tr_mask,\n        base[test_idx], anchor[test_idx], history[test_idx], clock[test_idx]\n    )\n    \n    mae = np.abs(pred[te_mask] - target[test_idx][te_mask]).mean()\n    base_mae = np.abs(base[test_idx][te_mask] - target[test_idx][te_mask]).mean()\n    mae_scores.append(mae)\n    baseline_scores.append(base_mae)\n    print(f'Fold {fold}: base={base_mae:.4f}, v25={mae:.4f}, improvement={base_mae-mae:.4f}')\n\nprint(f'\\\\\\\\nMean base MAE: {np.mean(baseline_scores):.4f}')\nprint(f'Mean v25 MAE: {np.mean(mae_scores):.4f}')\nprint(f'Mean improvement: {np.mean(baseline_scores) - np.mean(mae_scores):.4f}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

 h, n][m]\n                    mae = np.abs(pred - tgt_tr[:, h, n][m]).mean()\n                    if mae < best_mae:\n                        best_mae = mae\n                        best_w = w\n                anchor_nh[h, n] = best_w\n            else:\n                anchor_nh[h, n] = anchor_h[h]\n    anchor_nh = pna_shrink * anchor_nh + (1 - pna_shrink) * anchor_h[:, np.newaxis]\n    blended = (1 - anchor_nh[np.newaxis, :, :]) * base_tr + anchor_nh[np.newaxis, :, :] * anchor_tr\n\n    # Step 3: Per-horizon median bias\n    h_bias = np.zeros(n_horizons)\n    for h in range(n_horizons):\n        m = mask_tr[:, h, :]\n        h_bias[h] = np.median(blended[:, h, :][m] - tgt_tr[:, h, :][m])\n    corrected = blended - h_bias[np.newaxis, :, np.newaxis]\n    residual = corrected - tgt_tr\n\n    # Step 4: Per-node median bias\n    node_shrink = 0.4\n    node_bias = np.zeros(n_nodes)\n    for n in range(n_nodes):\n        m = mask_tr[:, :, n]\n        if m.sum() > 5:\n            node_bias[n] = np.median(residual[:, :, n][m])\n    node_bias = node_shrink * node_bias\n    corrected = corrected - node_bias[np.newaxis, np.newaxis, :]\n    residual = corrected - tgt_tr\n\n    # NEW: Time-of-day per-horizon median bias\n    hours = ((clk_tr[:, 0, 0] * 24).round().astype(int) - 1) % 24  # 0-23\n    tod_bias = np.zeros((24, n_horizons))\n    for hr in range(24):\n        sm = hours == hr\n        if sm.sum() > 0:\n            for h in range(n_horizons):\n                m = mask_tr[sm, h, :]\n                if m.sum() > 0:\n                    tod_bias[hr, h] = np.median(residual[sm, h, :][m])\n    tod_bias = tod_shrink_val * tod_bias\n    for i in range(n_tr):\n        hr = hours[i]\n        corrected[i] = corrected[i] - tod_bias[hr, :, np.newaxis]\n        residual[i] = residual[i] - tod_bias[hr, :, np.newaxis]\n\n    # Step 5: Per-node-horizon median bias\n    pnh_bias_shrink = 0.15\n    bias_nh = np.zeros((n_horizons, n_nodes))\n    for h in range(n_horizons):\n        for n in range(n_nodes):\n            m = mask_tr[:, h, n]\n            if m.sum() > 0:\n                raw = np.median(residual[:, h, n][m])\n                bias_nh[h, n] = pnh_bias_shrink * raw\n    corrected = corrected - bias_nh[np.newaxis, :, :]\n    residual = corrected - tgt_tr\n\n    # Step 6: Multiplicative per-node correction\n    mult_shrink = 0.5\n    mult_factor = np.ones(n_nodes)\n    for n in range(n_nodes):\n        m = mask_tr[:, :, n]\n        p = corrected[:, :, n][m]\n        tgt_n = tgt_tr[:, :, n][m]\n        if m.sum() > 20 and np.min(p) > 1:\n            ratios = tgt_n / p\n            mult_factor[n] = np.median(ratios)\n    mult_factor = 1.0 + mult_shrink * (mult_factor - 1.0)\n    corrected = corrected * mult_factor[np.newaxis, np.newaxis, :]\n    residual = residual * mult_factor[np.newaxis, np.newaxis, :]\n\n    # Per-sample bias via base-anchor diff\n    sample_shrink = 0.2\n    sample_slope = np.zeros(n_horizons)\n    sample_intercept = np.zeros(n_horizons)\n    sample_ba_diff = np.zeros((n_tr, n_horizons))\n    sample_resid = np.zeros((n_tr, n_horizons))\n    for h in range(n_horizons):\n        for i in range(n_tr):\n            mi = mask_tr[i, h, :]\n            if mi.sum() > 0:\n                sample_ba_diff[i, h] = (base_tr[i, h, :][mi] - anchor_tr[i, h, :][mi]).mean()\n                sample_resid[i, h] = residual[i, h, :][mi].mean()\n    sample_alpha = 10.0\n    for h in range(n_horizons):\n        valid = np.isfinite(sample_resid[:, h]) & np.isfinite(sample_ba_diff[:, h])\n        if valid.sum() < 10:\n            continue\n        x = sample_ba_diff[valid, h]\n        y = sample_resid[valid, h]\n        X = np.column_stack([np.ones(len(x)), x])\n        coef = np.linalg.lstsq(X.T @ X + sample_alpha * np.eye(2), X.T @ y, rcond=None)[0]\n        sample_intercept[h] = coef[0]\n        sample_slope[h] = coef[1]\n    sample_bias_tr = sample_intercept[np.newaxis, :] + sample_ba_diff * sample_slope[np.newaxis, :]\n    corrected = corrected - sample_shrink * sample_bias_tr[:, :, np.newaxis]\n    residual = residual - sample_shrink * sample_bias_tr[:, :, np.newaxis]\n\n    # Ridge correction with enhanced features\n    ridge_models = []\n    hist_last_tr = hist_tr[:, -1, :]\n    hist_avg_tr = hist_tr.mean(axis=1)\n    hist_trend_tr = (hist_tr[:, -1, :] - hist_tr[:, 0, :]) / 12.0\n    hist_std_tr = hist_tr.std(axis=1)\n\n    # Graph-smoothed base\n    base_smooth_tr = np.zeros_like(base_tr)\n    for s in range(n_tr):\n        for h in range(n_horizons):\n            base_smooth_tr[s, h, :] = adj @ base_tr[s, h, :]\n\n    for h in range(n_horizons):\n        m = mask_tr[:, h, :]\n        y = residual[:, h, :][m].flatten()\n        if len(y) < 100:\n            ridge_models.append(None)\n            continue\n        node_idx_flat = np.tile(np.arange(n_nodes), (n_tr, 1)).reshape(-1, 1)\n        hour_flat = np.repeat(clk_tr[:, h, 0], n_nodes).reshape(-1, 1)\n        X = np.hstack([\n            base_tr[:, h, :].reshape(-1, 1),\n            anchor_tr[:, h, :].reshape(-1, 1),\n            base_smooth_tr[:, h, :].reshape(-1, 1),\n            hist_last_tr.reshape(-1, 1),\n            hist_avg_tr.reshape(-1, 1),\n            hist_trend_tr.reshape(-1, 1),\n            hist_std_tr.reshape(-1, 1),\n            np.sin(2 * np.pi * hour_flat),\n            np.cos(2 * np.pi * hour_flat),\n            np.sin(4 * np.pi * hour_flat),\n            np.cos(4 * np.pi * hour_flat),\n            np.sin(2 * np.pi * node_idx_flat / n_nodes),\n            np.cos(2 * np.pi * node_idx_flat / n_nodes),\n            (base_tr[:, h, :] - anchor_tr[:, h, :]).reshape(-1, 1),\n        ])\n        X_valid = X[m.flatten()]\n        mu = X_valid.mean(axis=0)\n        sd = X_valid.std(axis=0)\n        sd[sd < 1e-6] = 1.0\n        Xs = (X_valid - mu) / sd\n        model = Ridge(alpha=ridge_alpha_val, fit_intercept=True)\n        model.fit(Xs, y)\n        ridge_models.append({'coef': model.coef_, 'intercept': model.intercept_, 'mu': mu, 'sd': sd})\n\n    return {\n        'anchor_nh': anchor_nh, 'h_bias': h_bias, 'node_bias': node_bias,\n        'tod_bias': tod_bias, 'bias_nh': bias_nh, 'mult_factor': mult_factor,\n        'sample_slope': sample_slope, 'sample_intercept': sample_intercept,\n        'sample_shrink': sample_shrink, 'ridge_shrink': ridge_shrink_val,\n        'ridge_models': ridge_models,\n    }\n\ndef predict_v26(state, base_te, anchor_te, hist_te, clk_te):\n    n_te = base_te.shape[0]\n    anchor_nh = state['anchor_nh']; h_bias = state['h_bias']; node_bias = state['node_bias']\n    tod_bias = state['tod_bias']; bias_nh = state['bias_nh']; mult_factor = state['mult_factor']\n    sample_slope = state['sample_slope']; sample_intercept = state['sample_intercept']\n    sample_shrink = state['sample_shrink']; ridge_shrink = state['ridge_shrink']\n    ridge_models = state['ridge_models']\n\n    result = (1 - anchor_nh[np.newaxis, :, :]) * base_te + anchor_nh[np.newaxis, :, :] * anchor_te\n    result = result - h_bias[np.newaxis, :, np.newaxis]\n    result = result - node_bias[np.newaxis, np.newaxis, :]\n\n    hours_te = ((clk_te[:, 0, 0] * 24).round().astype(int) - 1) % 24\n    for i in range(n_te):\n        hr = hours_te[i]\n        result[i] = result[i] - tod_bias[hr, :, np.newaxis]\n\n    result = result - bias_nh[np.newaxis, :, :]\n    result = result * mult_factor[np.newaxis, np.newaxis, :]\n\n    sample_ba_diff_te = np.zeros((n_te, n_horizons))\n    for h in range(n_horizons):\n        sample_ba_diff_te[:, h] = (base_te[:, h, :] - anchor_te[:, h, :]).mean(axis=1)\n    pred_sample_bias = sample_intercept[np.newaxis, :] + sample_ba_diff_te * sample_slope[np.newaxis, :]\n    result = result - sample_shrink * pred_sample_bias[:, :, np.newaxis]\n\n    hist_last_te = hist_te[:, -1, :]\n    hist_avg_te = hist_te.mean(axis=1)\n    hist_trend_te = (hist_te[:, -1, :] - hist_te[:, 0, :]) / 12.0\n    hist_std_te = hist_te.std(axis=1)\n\n    base_smooth_te = np.zeros_like(base_te)\n    for s in range(n_te):\n        for h in range(n_horizons):\n            base_smooth_te[s, h, :] = adj @ base_te[s, h, :]\n\n    for h in range(n_horizons):\n        if ridge_models[h] is not None:\n            rm = ridge_models[h]\n            coef = rm['coef']; intercept = rm['intercept']; mu = rm['mu']; sd = rm['sd']\n            node_idx_flat = np.tile(np.arange(n_nodes), (n_te, 1)).reshape(-1, 1)\n            hour_flat = np.repeat(clk_te[:, h, 0], n_nodes).reshape(-1, 1)\n            X = np.hstack([\n                base_te[:, h, :].reshape(-1, 1),\n                anchor_te[:, h, :].reshape(-1, 1),\n                base_smooth_te[:, h, :].reshape(-1, 1),\n                hist_last_te.reshape(-1, 1),\n                hist_avg_te.reshape(-1, 1),\n                hist_trend_te.reshape(-1, 1),\n                hist_std_te.reshape(-1, 1),\n                np.sin(2 * np.pi * hour_flat),\n                np.cos(2 * np.pi * hour_flat),\n                np.sin(4 * np.pi * hour_flat),\n                np.cos(4 * np.pi * hour_flat),\n                np.sin(2 * np.pi * node_idx_flat / n_nodes),\n                np.cos(2 * np.pi * node_idx_flat / n_nodes),\n                (base_te[:, h, :] - anchor_te[:, h, :]).reshape(-1, 1),\n            ])\n            Xs = (X - mu) / sd\n            correction = ridge_shrink * (Xs @ coef + intercept)\n            result[:, h, :] = result[:, h, :] - correction.reshape(n_te, n_nodes)\n\n    result = np.maximum(result, 0.0)\n    return result\n\n# CV test for various configurations\nconfigs = [\n    ('v25 baseline', 0.0, 100.0, 0.3),\n    ('v26 tod=0.2', 0.2, 100.0, 0.3),\n    ('v26 tod=0.3', 0.3, 100.0, 0.3),\n    ('v26 tod=0.4', 0.4, 100.0, 0.3),\n    ('v26 tod=0.5', 0.5, 100.0, 0.3),\n]\n\nfor name, tod_val, ra, rs in configs:\n    cv_maes = []\n    for i in range(5):\n        test_idx = folds[i]\n        train_idx = np.concatenate([folds[j] for j in range(5) if j \"'!= i])\n        state = fit_v26(base[train_idx], targets[train_idx], anchor[train_idx],\n                        history[train_idx], clock[train_idx], mask[train_idx],\n                        tod_shrink_val=tod_val, ridge_alpha_val=ra, ridge_shrink_val=rs)\n        pred = predict_v26(state, base[test_idx], anchor[test_idx], history[test_idx], clock[test_idx])\n        m = mask[test_idx]\n        mae = np.abs(pred[m] - targets[test_idx][m]).mean()\n        cv_maes.append(mae)\n    print(f'\"'{name}: CV MAE = {np.mean(cv_maes):.4f} +/- {np.std(cv_maes):.4f}')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

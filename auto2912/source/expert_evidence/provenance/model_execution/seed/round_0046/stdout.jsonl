{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python -c \\\"\nimport numpy as np\nfeat = np.load('/workspace/public_assets/train_features.npz')\ntgt = np.load('/workspace/public_assets/train_targets.npz')\ntargets = tgt['arr_0'] if 'arr_0' in tgt.files else tgt[tgt.files[0]]\nbase = feat['base'].astype(np.float64)\nanchor = feat['anchor'].astype(np.float64)\nhistory = feat['history'].astype(np.float64)\nclock = feat['clock'].astype(np.float64)\ng = np.load('/workspace/public_assets/graph.npz')\nadj = g['adjacency'].astype(np.float64)\n\nmask = np.isfinite(targets) & (targets > 0)\nn_samples, n_horizons, n_nodes = base.shape\n\n# Let's look at the graph more carefully - it's very sparse\n# How many neighbors per node?\ndegrees = (adj > 0).sum(axis=1)\nprint('Neighbor count stats:')\nprint('  min:', degrees.min(), 'max:', degrees.max(), 'mean:', degrees.mean())\nprint('  nodes with 0 neighbors:', (degrees == 0).sum())\nprint('  nodes with 1 neighbor:', (degrees == 1).sum())\nprint('  nodes with 2+ neighbors:', (degrees >= 2).sum())\n\n# Let's build a graph-smoothed version of base forecast\n# and see if it helps predict targets\nD = np.diag(1.0 / (degrees + 1e-10))\nA_norm = D @ adj  # row-normalized\n\n# Graph smoothing of base forecasts\nbase_smooth = np.zeros_like(base)\nfor s in range(n_samples):\n    for h in range(n_horizons):\n        base_smooth[s, h, :] = adj @ base[s, h, :]  # weighted sum of neighbors\n\nprint()\nprint('Graph-smoothed base correlation with error:')\nerrors = base - targets\nfor h in range(n_horizons):\n    m = mask[:, h, :]\n    corr = np.corrcoef(errors[:, h, :][m], base_smooth[:, h, :][m])[0,1]\n    print(f'  H{h:02d}: corr(err, graph_smooth_base) = {corr:.3f}')\n\n# Also try: residual of base vs target, correlated with neighbor's base-target gap\n# Neighbor bias = average of (base_neighbor - target_neighbor)\ntarget_smooth = np.zeros_like(targets)\nfor s in range(n_samples):\n    for h in range(n_horizons):\n        target_smooth[s, h, :] = adj @ targets[s, h, :]\n\n# What about using graph for spatial bias transfer?\nprint()\n# Check if node bias is spatially correlated\nnode_bias = np.zeros(n_nodes)\nfor n in range(n_nodes):\n    m = mask[:, :, n]\n    node_bias[n] = np.median((base - targets)[:, :, n][m])\n\n# Smooth node bias\nnode_bias_smooth = adj @ node_bias\ncorr_spatial = np.corrcoef(node_bias, node_bias_smooth)[0]\nprint(f'Spatial autocorrelation of node bias: {corr_spatial[1]:.3f}')\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

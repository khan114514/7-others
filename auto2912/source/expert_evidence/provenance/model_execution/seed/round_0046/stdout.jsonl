{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python -c \\\"\nimport numpy as np\nfeat = np.load('/workspace/public_assets/train_features.npz')\ntgt = np.load('/workspace/public_assets/train_targets.npz')\ntargets = tgt['arr_0'] if 'arr_0' in tgt.files else tgt[tgt.files[0]]\nbase = feat['base'].astype(np.float64)\nanchor = feat['anchor'].astype(np.float64)\nhistory = feat['history'].astype(np.float64)\nclock = feat['clock'].astype(np.float64)\n\nmask = np.isfinite(targets) & (targets > 0)\n\n# Cross-validation: 5-fold on current v25 approach to understand generalization\nfrom sklearn.linear_model import Ridge\n\ndef fit_v25_cv(base_tr, target_tr, anchor_tr, history_tr, clock_tr, seed, mask_tr):\n    n_samples, n_horizons, n_nodes = base_tr.shape\n\n    anchor_h = np.zeros(n_horizons)\n    for h in range(n_horizons):\n        m = mask_tr[:, h, :]\n        best_mae = float('inf')\n        for w in np.linspace(0, 0.30, 31):\n            pred = (1 - w) * base_tr[:, h, :][m] + w * anchor_tr[:, h, :][m]\n            mae = np.abs(pred - target_tr[:, h, :][m]).mean()\n            if mae < best_mae:\n                best_mae = mae\n                anchor_h[h] = w\n\n    pna_shrink = 0.2\n    anchor_nh = np.zeros((n_horizons, n_nodes))\n    for h in range(n_horizons):\n        for n in range(n_nodes):\n            m = mask_tr[:, h, n]\n            if m.sum() > 15:\n                best_mae = float('inf')\n                best_w = anchor_h[h]\n                for w in np.linspace(0, 0.40, 21):\n                    pred = (1 - w) * base_tr[:, h, n][m] + w * anchor_tr[:, h, n][m]\n                    mae = np.abs(pred - target_tr[:, h, n][m]).mean()\n                    if mae < best_mae:\n                        best_mae = mae\n                        best_w = w\n                anchor_nh[h, n] = best_w\n            else:\n                anchor_nh[h, n] = anchor_h[h]\n\n    anchor_nh = pna_shrink * anchor_nh + (1 - pna_shrink) * anchor_h[:, np.newaxis]\n    blended = (1 - anchor_nh[np.newaxis, :, :]) * base_tr + anchor_nh[np.newaxis, :, :] * anchor_tr\n\n    h_bias = np.zeros(n_horizons)\n    for h in range(n_horizons):\n        m = mask_tr[:, h, :]\n        h_bias[h] = np.median(blended[:, h, :][m] - target_tr[:, h, :][m])\n\n    corrected = blended - h_bias[np.newaxis, :, np.newaxis]\n    residual = corrected - target_tr\n\n    node_shrink = 0.4\n    node_bias = np.zeros(n_nodes)\n    for n in range(n_nodes):\n        m = mask_tr[:, :, n]\n        if m.sum() > 5:\n            node_bias[n] = np.median(residual[:, :, n][m])\n    node_bias = node_shrink * node_bias\n    corrected = corrected - node_bias[np.newaxis, np.newaxis, :]\n    residual = corrected - target_tr\n\n    pnh_bias_shrink = 0.15\n    bias_nh = np.zeros((n_horizons, n_nodes))\n    for h in range(n_horizons):\n        for n in range(n_nodes):\n            m = mask_tr[:, h, n]\n            if m.sum() > 0:\n                raw = np.median(residual[:, h, n][m])\n                bias_nh[h, n] = pnh_bias_shrink * raw\n    corrected = corrected - bias_nh[np.newaxis, :, :]\n    residual = corrected - target_tr\n\n    mult_shrink = 0.5\n    mult_factor = np.ones(n_nodes)\n    for n in range(n_nodes):\n        m = mask_tr[:, :, n]\n        p = corrected[:, :, n][m]\n        tgt_n = target_tr[:, :, n][m]\n        if m.sum() > 20 and np.min(p) > 1:\n            ratios = tgt_n / p\n            mult_factor[n] = np.median(ratios)\n    mult_factor = 1.0 + mult_shrink * (mult_factor - 1.0)\n    corrected = corrected * mult_factor[np.newaxis, np.newaxis, :]\n    residual = residual * mult_factor[np.newaxis, np.newaxis, :]\n\n    sample_shrink = 0.2\n    sample_slope = np.zeros(n_horizons)\n    sample_intercept = np.zeros(n_horizons)\n    sample_ba_diff = np.zeros((n_samples, n_horizons))\n    sample_resid = np.zeros((n_samples, n_horizons))\n    for h in range(n_horizons):\n        for i in range(n_samples):\n            mi = mask_tr[i, h, :]\n            if mi.sum() > 0:\n                sample_ba_diff[i, h] = (base_tr[i, h, :][mi] - anchor_tr[i, h, :][mi]).mean()\n                sample_resid[i, h] = residual[i, h, :][mi].mean()\n    sample_alpha = 10.0\n    for h in range(n_horizons):\n        valid = np.isfinite(sample_resid[:, h]) & np.isfinite(sample_ba_diff[:, h])\n        if valid.sum() < 10:\n            continue\n        x = sample_ba_diff[valid, h]\n        y = sample_resid[valid, h]\n        X = np.column_stack([np.ones(len(x)), x])\n        coef = np.linalg.lstsq(X.T @ X + sample_alpha * np.eye(2), X.T @ y, rcond=None)[0]\n        sample_intercept[h] = coef[0]\n        sample_slope[h] = coef[1]\n\n    ridge_shrink = 0.3\n    ridge_alpha = 100.0\n    ridge_models = []\n    hist_last = history_tr[:, -1, :]\n    hist_avg = history_tr.mean(axis=1)\n    hist_trend = (history_tr[:, -1, :] - history_tr[:, 0, :]) / 12.0\n\n    for h in range(n_horizons):\n        m = mask_tr[:, h, :]\n        y = residual[:, h, :][m].flatten()\n        if len(y) < 100:\n            ridge_models.append(None)\n            continue\n        node_idx_flat = np.tile(np.arange(n_nodes), (n_samples, 1)).reshape(-1, 1)\n        X = np.hstack([\n            base_tr[:, h, :].reshape(-1, 1),\n            anchor_tr[:, h, :].reshape(-1, 1),\n            hist_last.reshape(-1, 1),\n            hist_avg.reshape(-1, 1),\n            hist_trend.reshape(-1, 1),\n            np.sin(2 * np.pi * np.repeat(clock_tr[:, h, 0], n_nodes)).reshape(-1, 1),\n            np.cos(2 * np.pi * np.repeat(clock_tr[:, h, 0], n_nodes)).reshape(-1, 1),\n            np.sin(2 * np.pi * node_idx_flat / n_nodes),\n            np.cos(2 * np.pi * node_idx_flat / n_nodes),\n        ])\n        X_valid = X[m.flatten()]\n        mu = X_valid.mean(axis=0)\n        sd = X_valid.std(axis=0)\n        sd[sd < 1e-6] = 1.0\n        Xs = (X_valid - mu) / sd\n        model = Ridge(alpha=ridge_alpha, fit_intercept=True)\n        model.fit(Xs, y)\n        ridge_models.append({'coef': model.coef_, 'intercept': model.intercept_, 'mu': mu, 'sd': sd})\n\n    return anchor_nh, h_bias, node_bias, bias_nh, mult_factor, sample_slope, sample_intercept, sample_shrink, ridge_shrink, ridge_models\n\ndef predict_v25(params, base_te, anchor_te, history_te, clock_te):\n    anchor_nh, h_bias, node_bias, bias_nh, mult_factor, sample_slope, sample_intercept, sample_shrink, ridge_shrink, ridge_models = params\n    n_samples, n_horizons, n_nodes = base_te.shape\n\n    result = (1 - anchor_nh[np.newaxis, :, :]) * base_te + anchor_nh[np.newaxis, :, :] * anchor_te\n    result = result - h_bias[np.newaxis, :, np.newaxis]\n    result = result - node_bias[np.newaxis, np.newaxis, :]\n    result = result - bias_nh[np.newaxis, :, :]\n    result = result * mult_factor[np.newaxis, np.newaxis, :]\n\n    sample_ba_diff = np.zeros((n_samples, n_horizons))\n    for h in range(n_horizons):\n        sample_ba_diff[:, h] = (base_te[:, h, :] - anchor_te[:, h, :]).mean(axis=1)\n    pred_sample_bias = sample_intercept[np.newaxis, :] + sample_ba_diff * sample_slope[np.newaxis, :]\n    result = result - sample_shrink * pred_sample_bias[:, :, np.newaxis]\n\n    hist_last = history_te[:, -1, :]\n    hist_avg = history_te.mean(axis=1)\n    hist_trend = (history_te[:, -1, :] - history_te[:, 0, :]) / 12.0\n    for h in range(n_horizons):\n        if ridge_models[h] is not None:\n            rm = ridge_models[h]\n            coef = rm['coef']; intercept = rm['intercept']; mu = rm['mu']; sd = rm['sd']\n            node_idx_flat = np.tile(np.arange(n_nodes), (n_samples, 1)).reshape(-1, 1)\n            X = np.hstack([\n                base_te[:, h, :].reshape(-1, 1),\n                anchor_te[:, h, :].reshape(-1, 1),\n                hist_last.reshape(-1, 1),\n                hist_avg.reshape(-1, 1),\n                hist_trend.reshape(-1, 1),\n                np.sin(2 * np.pi * np.repeat(clock_te[:, h, 0], n_nodes)).reshape(-1, 1),\n                np.cos(2 * np.pi * np.repeat(clock_te[:, h, 0], n_nodes)).reshape(-1, 1),\n                np.sin(2 * np.pi * node_idx_flat / n_nodes),\n                np.cos(2 * np.pi * node_idx_flat / n_nodes),\n            ])\n            Xs = (X - mu) / sd\n            correction = ridge_shrink * (Xs @ coef + intercept)\n            result[:, h, :] = result[:, h, :] - correction.reshape(n_samples, n_nodes)\n    result = np.maximum(result, 0.0)\n    return result\n\nn_samples = base.shape[0]\nrng = np.random.RandomState(42)\nindices = np.arange(n_samples)\nrng.shuffle(indices)\nfolds = np.array_split(indices, 5)\n\ncv_maes = []\nfor i in range(5):\n    test_idx = folds[i]\n    train_idx = np.concatenate([folds[j] for j in range(5) if j \"'!= i])\n    params = fit_v25_cv(base[train_idx], targets[train_idx], anchor[train_idx], history[train_idx], clock[train_idx], 17, mask[train_idx])\n    pred = predict_v25(params, base[test_idx], anchor[test_idx], history[test_idx], clock[test_idx])\n    m = mask[test_idx]\n    mae = np.abs(pred[m] - targets[test_idx][m]).mean()\n    cv_maes.append(mae)\n    print(f'\"'Fold {i}: MAE = {mae:.4f}')\nprint(f'Mean CV MAE: {np.mean(cv_maes):.4f} +/- {np.std(cv_maes):.4f}')\nprint(f'Baseline (identity) CV: {np.abs(base[mask] - targets[mask]).mean():.4f}')\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

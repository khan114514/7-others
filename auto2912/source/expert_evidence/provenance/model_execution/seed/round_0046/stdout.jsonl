{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python << 'PYEOF'\nimport numpy as np\nfrom sklearn.linear_model import Ridge, HuberRegressor\nfrom sklearn.preprocessing import StandardScaler\n\nfeat = np.load('/workspace/public_assets/train_features.npz')\ntgt = np.load('/workspace/public_assets/train_targets.npz')\ntargets = tgt['arr_0'] if 'arr_0' in tgt.files else tgt[tgt.files[0]]\nbase = feat['base'].astype(np.float64)\nanchor = feat['anchor'].astype(np.float64)\nhistory = feat['history'].astype(np.float64)\nclock = feat['clock'].astype(np.float64)\ng = np.load('/workspace/public_assets/graph.npz')\nadj = g['adjacency'].astype(np.float64)\n\nmask = np.isfinite(targets) & (targets > 0)\nn_samples, n_horizons, n_nodes = base.shape\n\nrng = np.random.RandomState(42)\nindices = np.arange(n_samples)\nrng.shuffle(indices)\nfolds = np.array_split(indices, 5)\n\n# Approach: Per-node ridge regression on the full residual after bias corrections\n# Each node gets its own model (170 nodes x 12 horizons)\n# With only 74 samples per node, we need strong regularization\n\ndef compute_residual_after_steps(base_tr, tgt_tr, anchor_tr, mask_tr):\n    \\\"\\\"\\\"Apply steps 1-6b from v25 and return corrected + residual.\\\"\\\"\\\"\n    n_tr = base_tr.shape[0]\n    \n    anchor_h = np.zeros(n_horizons)\n    for h in range(n_horizons):\n        m = mask_tr[:, h, :]\n        best_mae = float('inf')\n        for w in np.linspace(0, 0.30, 31):\n            pred = (1 - w) * base_tr[:, h, :][m] + w * anchor_tr[:, h, :][m]\n            mae = np.abs(pred - tgt_tr[:, h, :][m]).mean()\n            if mae < best_mae:\n                best_mae = mae\n                anchor_h[h] = w\n\n    pna_shrink = 0.2\n    anchor_nh = np.zeros((n_horizons, n_nodes))\n    for h in range(n_horizons):\n        for n in range(n_nodes):\n            m = mask_tr[:, h, n]\n            if m.sum() > 15:\n                best_mae = float('inf')\n                best_w = anchor_h[h]\n                for w in np.linspace(0, 0.40, 21):\n                    pred = (1 - w) * base_tr[:, h, n][m] + w * anchor_tr[:, h, n][m]\n                    mae = np.abs(pred - tgt_tr[:, h, n][m]).mean()\n                    if mae < best_mae:\n                        best_mae = mae\n                        best_w = w\n                anchor_nh[h, n] = best_w\n            else:\n                anchor_nh[h, n] = anchor_h[h]\n    anchor_nh = pna_shrink * anchor_nh + (1 - pna_shrink) * anchor_h[:, np.newaxis]\n    blended = (1 - anchor_nh[np.newaxis, :, :]) * base_tr + anchor_nh[np.newaxis, :, :] * anchor_tr\n\n    h_bias = np.zeros(n_horizons)\n    for h in range(n_horizons):\n        m = mask_tr[:, h, :]\n        h_bias[h] = np.median(blended[:, h, :][m] - tgt_tr[:, h, :][m])\n    corrected = blended - h_bias[np.newaxis, :, np.newaxis]\n    residual = corrected - tgt_tr\n\n    node_shrink = 0.4\n    node_bias = np.zeros(n_nodes)\n    for n in range(n_nodes):\n        m = mask_tr[:, :, n]\n        if m.sum() > 5:\n            node_bias[n] = np.median(residual[:, :, n][m])\n    node_bias = node_shrink * node_bias\n    corrected = corrected - node_bias[np.newaxis, np.newaxis, :]\n    residual = corrected - tgt_tr\n\n    pnh_bias_shrink = 0.15\n    bias_nh = np.zeros((n_horizons, n_nodes))\n    for h in range(n_horizons):\n        for n in range(n_nodes):\n            m = mask_tr[:, h, n]\n            if m.sum() > 0:\n                raw = np.median(residual[:, h, n][m])\n                bias_nh[h, n] = pnh_bias_shrink * raw\n    corrected = corrected - bias_nh[np.newaxis, :, :]\n    residual = corrected - tgt_tr\n\n    mult_shrink = 0.5\n    mult_factor = np.ones(n_nodes)\n    for n in range(n_nodes):\n        m = mask_tr[:, :, n]\n        p = corrected[:, :, n][m]\n        tgt_n = tgt_tr[:, :, n][m]\n        if m.sum() > 20 and np.min(p) > 1:\n            ratios = tgt_n / p\n            mult_factor[n] = np.median(ratios)\n    mult_factor = 1.0 + mult_shrink * (mult_factor - 1.0)\n    corrected = corrected * mult_factor[np.newaxis, np.newaxis, :]\n    residual = residual * mult_factor[np.newaxis, np.newaxis, :]\n\n    sample_shrink = 0.2\n    sample_slope = np.zeros(n_horizons)\n    sample_intercept = np.zeros(n_horizons)\n    sample_ba_diff = np.zeros((n_tr, n_horizons))\n    sample_resid = np.zeros((n_tr, n_horizons))\n    for h in range(n_horizons):\n        for i in range(n_tr):\n            mi = mask_tr[i, h, :]\n            if mi.sum() > 0:\n                sample_ba_diff[i, h] = (base_tr[i, h, :][mi] - anchor_tr[i, h, :][mi]).mean()\n                sample_resid[i, h] = residual[i, h, :][mi].mean()\n    sample_alpha = 10.0\n    for h in range(n_horizons):\n        valid = np.isfinite(sample_resid[:, h]) & np.isfinite(sample_ba_diff[:, h])\n        if valid.sum() < 10:\n            continue\n        x = sample_ba_diff[valid, h]\n        y = sample_resid[valid, h]\n        X = np.column_stack([np.ones(len(x)), x])\n        coef = np.linalg.lstsq(X.T @ X + sample_alpha * np.eye(2), X.T @ y, rcond=None)[0]\n        sample_intercept[h] = coef[0]\n        sample_slope[h] = coef[1]\n    sample_bias_tr = sample_intercept[np.newaxis, :] + sample_ba_diff * sample_slope[np.newaxis, :]\n    corrected = corrected - sample_shrink * sample_bias_tr[:, :, np.newaxis]\n    residual = residual - sample_shrink * sample_bias_tr[:, :, np.newaxis]\n\n    return corrected, residual, anchor_nh, h_bias, node_bias, bias_nh, mult_factor, sample_slope, sample_intercept, sample_shrink\n\ndef apply_corrections_to_test(base_te, anchor_te, params):\n    anchor_nh, h_bias, node_bias, bias_nh, mult_factor, sample_slope, sample_intercept, sample_shrink = params\n    n_te = base_te.shape[0]\n    \n    result = (1 - anchor_nh[np.newaxis, :, :]) * base_te + anchor_nh[np.newaxis, :, :] * anchor_te\n    result = result - h_bias[np.newaxis, :, np.newaxis]\n    result = result - node_bias[np.newaxis, np.newaxis, :]\n    result = result - bias_nh[np.newaxis, :, :]\n    result = result * mult_factor[np.newaxis, np.newaxis, :]\n    \n    sample_ba_diff_te = np.zeros((n_te, n_horizons))\n    for h in range(n_horizons):\n        sample_ba_diff_te[:, h] = (base_te[:, h, :] - anchor_te[:, h, :]).mean(axis=1)\n    pred_sample_bias = sample_intercept[np.newaxis, :] + sample_ba_diff_te * sample_slope[np.newaxis, :]\n    result = result - sample_shrink * pred_sample_bias[:, :, np.newaxis]\n    return result\n\n# Test: Per-node per-horizon linear correction using base value as feature\n# (i.e. node-specific multiplicative + additive correction via regression)\nprint(\\\"Testing per-node ridge regression on residual:\\\")\nfor alpha in [1.0, 10.0, 100.0]:\n    cv_maes = []\n    for i in range(5):\n        test_idx = folds[i]\n        train_idx = np.concatenate([folds[j] for j in range(5) if j \"'!= i])\n        \n        corrected_tr, residual_tr, anchor_nh, h_bias, node_bias, bias_nh, mult_factor, sample_slope, sample_intercept, sample_shrink = '\"\\\\\n            compute_residual_after_steps(base[train_idx], targets[train_idx], anchor[train_idx], mask[train_idx])\n        \n        params = (anchor_nh, h_bias, node_bias, bias_nh, mult_factor, sample_slope, sample_intercept, sample_shrink)\n        \n        # Fit per-node ridge: residual ~ base (per horizon)\n        node_correction = np.zeros((n_horizons, n_nodes, 2))  # slope, intercept\n        for h in range(n_horizons):\n            for n in range(n_nodes):\n                m = mask[train_idx][:, h, n]\n                if m.sum() > 10:\n                    x = corrected_tr[:, h, n][m].reshape(-1, 1)\n                    y = residual_tr[:, h, n][m]\n                    mu_x = x.mean()\n                    sd_x = x.std() + 1e-6\n                    xs = (x - mu_x) / sd_x\n                    # ridge with intercept\n                    model = Ridge(alpha=alpha, fit_intercept=True)\n                    model.fit(xs, y)\n                    node_correction[h, n, 0] = model.coef_[0] / sd_x\n                    node_correction[h, n, 1] = model.intercept_ - model.coef_[0] * mu_x / sd_x\n        \n        # Shrink toward zero\n        shrink = 0.3\n        node_correction *= shrink\n        \n        # Apply to test\n        result = apply_corrections_to_test(base[test_idx], anchor[test_idx], params)\n        for h in range(n_horizons):\n            for n in range(n_nodes):\n                result[:, h, n] = result[:, h, n] - (node_correction[h, n, 0] * result[:, h, n] + node_correction[h, n, 1])\n        \n        result = np.maximum(result, 0.0)\n        m = mask[test_idx]\n        mae = np.abs(result[m] - targets[test_idx][m]).mean()\n        cv_maes.append(mae)\n    print(f'  alpha={alpha:6.1f}: CV MAE = {np.mean(cv_maes):.4f} +/- {np.std(cv_maes):.4f}')\n\n# v25 baseline for reference\nprint()\nprint(\\\"v25 baseline (pooled ridge):\\\")\n# (recompute quickly - we know ~14.33)\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

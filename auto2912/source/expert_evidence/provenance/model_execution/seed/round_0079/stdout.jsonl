{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/sh -lc \"python3 << 'PYEOF'\nimport numpy as np\nfrom sklearn.linear_model import Ridge\n\ntrain_f = np.load('/workspace/public_assets/train_features.npz')\ntrain_t = np.load('/workspace/public_assets/train_targets.npz')\ngraph = np.load('/workspace/public_assets/graph.npz')\nbase = train_f['base'].astype(np.float64)\ntarget = train_t['target'].astype(np.float64)\nanchor = train_f['anchor'].astype(np.float64)\nhistory = train_f['history'].astype(np.float64)\nclock = train_f['clock'].astype(np.float64)\nadj = graph['adjacency'].astype(np.float64)\n\nn_s, n_h, n_n = base.shape\nmask = np.isfinite(target) & (target > 0)\n\nrng = np.random.RandomState(42)\nidx = np.arange(n_s)\nrng.shuffle(idx)\nk = 5\nfold_size = n_s // k\n\nresults = []\nfor fold in range(k):\n    val_idx = idx[fold*fold_size:(fold+1)*fold_size]\n    tr_idx = np.setdiff1d(idx, val_idx)\n    \n    tr_mask = mask[tr_idx]\n    val_mask = mask[val_idx]\n    tr_base = base[tr_idx]\n    val_base = base[val_idx]\n    tr_target = target[tr_idx]\n    val_target = target[val_idx]\n    tr_anchor = anchor[tr_idx]\n    val_anchor = anchor[val_idx]\n    tr_history = history[tr_idx]\n    val_history = history[val_idx]\n    tr_clock = clock[tr_idx]\n    val_clock = clock[val_idx]\n    \n    base_mae = np.abs(val_base - val_target)[val_mask].mean()\n    \n    # Per-horizon bias\n    h_bias = np.zeros(n_h)\n    for h in range(n_h):\n        m = tr_mask[:, h, :]\n        h_bias[h] = (tr_base[:, h, :] - tr_target[:, h, :])[m].mean()\n    \n    # Per-node bias\n    node_bias = np.zeros(n_n)\n    for n in range(n_n):\n        m = tr_mask[:, :, n]\n        node_bias[n] = (tr_base[:, :, n] - tr_target[:, :, n])[m].mean()\n    \n    # Per-node-horizon bias\n    bias_nh = np.zeros((n_h, n_n))\n    for h in range(n_h):\n        for n in range(n_n):\n            m = tr_mask[:, h, n]\n            if m.sum() > 0:\n                bias_nh[h, n] = (tr_base[:, h, n] - tr_target[:, h, n])[m].mean()\n    \n    # Best alpha per fold\n    best_mae = 999\n    best_alpha = 0\n    for a in np.linspace(0.05, 0.95, 19):\n        shrunk = a * bias_nh + (1-a) * (h_bias[:, np.newaxis])\n        vp = val_base - shrunk[np.newaxis, :, :]\n        mae = np.abs(vp - val_target)[val_mask].mean()\n        if mae < best_mae:\n            best_mae = mae\n            best_alpha = a\n    \n    # Anchor blending\n    best_anchor_mae = 999\n    best_anchor_a = 0\n    for a in np.linspace(0, 0.5, 21):\n        vp = (1-a) * val_base + a * val_anchor - h_bias[np.newaxis, :, np.newaxis]\n        mae = np.abs(vp - val_target)[val_mask].mean()\n        if mae < best_anchor_mae:\n            best_anchor_mae = mae\n            best_anchor_a = a\n    \n    # Per-node-horizon anchor blending\n    anchor_nh = np.zeros((n_h, n_n))\n    for h in range(n_h):\n        for n in range(n_n):\n            m = tr_mask[:, h, n]\n            if m.sum() > 5:\n                b = tr_base[:, h, n][m]\n                a_vals = tr_anchor[:, h, n][m]\n                t = tr_target[:, h, n][m]\n                err_base = np.abs(b - t).mean()\n                err_anchor = np.abs(a_vals - t).mean()\n                if err_anchor < err_base:\n                    anchor_nh[h, n] = 0.3\n    \n    results.append((base_mae, best_mae, best_alpha, best_anchor_mae, best_anchor_a))\n\nprint(\\\"Fold  BaseMAE  BiasShrinkMAE  BestAlpha  AnchorBlendMAE  BestAnchorA\\\")\nfor i, r in enumerate(results):\n    print(f\\\"  {i}   {r[0]:.4f}    {r[1]:.4f}       {r[2]:.2f}        {r[3]:.4f}        {r[4]:.3f}\\\")\n\navg_base = np.mean([r[0] for r in results])\navg_bias = np.mean([r[1] for r in results])\navg_anchor = np.mean([r[3] for r in results])\nprint(f\\\"\\\\nAvg:  {avg_base:.4f}    {avg_bias:.4f}                  {avg_anchor:.4f}\\\")\nprint(f\\\"Improvement from bias: {avg_base - avg_bias:.4f}\\\")\nprint(f\\\"Improvement from anchor blend: {avg_base - avg_anchor:.4f}\\\")\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

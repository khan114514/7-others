{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/sh -lc \"python3 << 'PYEOF'\nimport numpy as np\nfrom sklearn.linear_model import Ridge\n\ntrain_f = np.load('/workspace/public_assets/train_features.npz')\ntrain_t = np.load('/workspace/public_assets/train_targets.npz')\nbase = train_f['base'].astype(np.float64)\ntarget = train_t['target'].astype(np.float64)\nanchor = train_f['anchor'].astype(np.float64)\nhistory = train_f['history'].astype(np.float64)\nclock = train_f['clock'].astype(np.float64)\n\nn_s, n_h, n_n = base.shape\nmask = np.isfinite(target) & (target > 0)\n\nrng = np.random.RandomState(42)\nidx = np.arange(n_s)\nrng.shuffle(idx)\nk = 5\nfold_size = n_s // k\n\ndef build_sample_feats(base, anchor, history, clock):\n    n_s, n_h, n_n = base.shape\n    feats_list = []\n    feats_list.append(base.mean(axis=2, keepdims=True))\n    feats_list.append(base.std(axis=2, keepdims=True))\n    feats_list.append(np.median(base, axis=2, keepdims=True))\n    feats_list.append(anchor.mean(axis=2, keepdims=True))\n    feats_list.append((base - anchor).mean(axis=2, keepdims=True))\n    hist_last_mean = history[:, -1, :].mean(axis=1)\n    hist_mean = history.mean(axis=(1, 2))\n    hist_trend_mean = (history[:, -1, :] - history[:, 0, :]).mean(axis=1) / 12.0\n    hist_std = history.std(axis=(1, 2))\n    for feat_val in [hist_last_mean, hist_mean, hist_trend_mean, hist_std]:\n        feats_list.append(np.tile(feat_val[:, np.newaxis, np.newaxis], (1, n_h, 1)))\n    for i in range(12):\n        h_mean = history[:, i, :].mean(axis=1)\n        feats_list.append(np.tile(h_mean[:, np.newaxis, np.newaxis], (1, n_h, 1)))\n    for kk in range(1, 5):\n        feats_list.append(np.sin(2 * kk * np.pi * clock[:, :, 0:1]))\n        feats_list.append(np.cos(2 * kk * np.pi * clock[:, :, 0:1]))\n    bm = base.mean(axis=2, keepdims=True)\n    feats_list.append(bm * np.sin(2 * np.pi * clock[:, :, 0:1]))\n    feats_list.append(bm * np.cos(2 * np.pi * clock[:, :, 0:1]))\n    return np.concatenate(feats_list, axis=2)\n\ndef build_node_feats(base_h, anchor_h, hist_last, hist_avg, hist_trend, clock_h, n_nodes, n_s):\n    node_idx = np.tile(np.arange(n_nodes), (n_s, 1)).reshape(-1, 1)\n    clock_rep = np.repeat(clock_h, n_nodes).reshape(-1, 1)\n    base_flat = base_h.reshape(-1, 1)\n    hist_flat = hist_last.reshape(-1, 1)\n    X = np.hstack([\n        base_flat,\n        anchor_h.reshape(-1, 1),\n        (base_h - anchor_h).reshape(-1, 1),\n        hist_last.reshape(-1, 1),\n        hist_avg.reshape(-1, 1),\n        hist_trend.reshape(-1, 1),\n        (hist_last - base_h).reshape(-1, 1),\n        (hist_last - anchor_h).reshape(-1, 1),\n        np.sin(2 * np.pi * clock_rep),\n        np.cos(2 * np.pi * clock_rep),\n        np.sin(4 * np.pi * clock_rep),\n        np.cos(4 * np.pi * clock_rep),\n        np.sin(6 * np.pi * clock_rep),\n        np.cos(6 * np.pi * clock_rep),\n        np.sin(2 * np.pi * node_idx / n_nodes),\n        np.cos(2 * np.pi * node_idx / n_nodes),\n        np.sin(4 * np.pi * node_idx / n_nodes),\n        np.cos(4 * np.pi * node_idx / n_nodes),\n        base_flat * np.sin(2 * np.pi * clock_rep),\n        base_flat * np.cos(2 * np.pi * clock_rep),\n        base_flat * np.sin(4 * np.pi * clock_rep),\n        base_flat * np.cos(4 * np.pi * clock_rep),\n        hist_flat * np.sin(2 * np.pi * clock_rep),\n        hist_flat * np.cos(2 * np.pi * clock_rep),\n    ])\n    return X\n\ndef run_pipeline(tr_idx, val_idx, anchor_mode='per_horizon', anchor_shrink=0.5,\n                node_bias_shrink=0.5, nh_bias_shrink=0.3,\n                sample_alpha=10.0, sample_shrink=0.4,\n                ridge_alpha=100.0, ridge_shrink=0.3):\n    \n    tr_mask = mask[tr_idx]\n    val_mask = mask[val_idx]\n    tr_base = base[tr_idx]\n    val_base = base[val_idx]\n    tr_target = target[tr_idx]\n    val_target = target[val_idx]\n    tr_anchor = anchor[tr_idx]\n    val_anchor = anchor[val_idx]\n    tr_history = history[tr_idx]\n    val_history = history[val_idx]\n    tr_clock = clock[tr_idx]\n    val_clock = clock[val_idx]\n    \n    # 1. Anchor blending\n    if anchor_mode == 'per_horizon':\n        anchor_w = np.zeros(n_h)\n        for h in range(n_h):\n            m = tr_mask[:, h, :]\n            b = tr_base[:, h, :][m]\n            a = tr_anchor[:, h, :][m]\n            t = tr_target[:, h, :][m]\n            best_w = 0\n            best_mae = np.abs(b - t).mean()\n            for w in np.linspace(0, 0.5, 21):\n                mae = np.abs((1-w)*b + w*a - t).mean()\n                if mae < best_mae:\n                    best_mae = mae\n                    best_w = w\n            anchor_w[h] = best_w\n        tr_corrected = (1 - anchor_w[:, np.newaxis]) * tr_base + anchor_w[:, np.newaxis] * tr_anchor\n        val_corrected = (1 - anchor_w[:, np.newaxis]) * val_base + anchor_w[:, np.newaxis] * val_anchor\n    elif anchor_mode == 'per_node_horizon':\n        anchor_nh = np.zeros((n_h, n_n))\n        for h in range(n_h):\n            for n in range(n_n):\n                m = tr_mask[:, h, n]\n                if m.sum() > 5:\n                    b = tr_base[:, h, n][m]\n                    a = tr_anchor[:, h, n][m]\n                    t = tr_target[:, h, n][m]\n                    best_w = 0\n                    best_mae = np.abs(b - t).mean()\n                    for w in np.linspace(0, 0.5, 11):\n                        mae = np.abs((1-w)*b + w*a - t).mean()\n                        if mae < best_mae:\n                            best_mae = mae\n                            best_w = w\n                    anchor_nh[h, n] = best_w\n        # Shrink toward per-horizon\n        h_avg = anchor_nh.mean(axis=1)\n        anchor_nh = anchor_shrink * anchor_nh + (1-anchor_shrink) * h_avg[:, np.newaxis]\n        tr_corrected = (1 - anchor_nh[np.newaxis, :, :]) * tr_base + anchor_nh[np.newaxis, :, :] * tr_anchor\n        val_corrected = (1 - anchor_nh[np.newaxis, :, :]) * val_base + anchor_nh[np.newaxis, :, :] * val_anchor\n    else:\n        tr_corrected = tr_base.copy()\n        val_corrected = val_base.copy()\n    \n    # 2. Per-horizon bias\n    h_bias = np.zeros(n_h)\n    for h in range(n_h):\n        m = tr_mask[:, h, :]\n        h_bias[h] = (tr_corrected[:, h, :] - tr_target[:, h, :])[m].mean()\n    tr_corrected = tr_corrected - h_bias[np.newaxis, :, np.newaxis]\n    val_corrected = val_corrected - h_bias[np.newaxis, :, np.newaxis]\n    \n    # 3. Per-node bias\n    node_bias_raw = np.zeros(n_n)\n    for n in range(n_n):\n        m = tr_mask[:, :, n]\n        node_bias_raw[n] = (tr_corrected[:, :, n] - tr_target[:, :, n])[m].mean()\n    node_bias = node_bias_shrink * node_bias_raw\n    tr_corrected = tr_corrected - node_bias[np.newaxis, np.newaxis, :]\n    val_corrected = val_corrected - node_bias[np.newaxis, np.newaxis, :]\n    \n    # 4. Per-node-horizon bias\n    bias_nh_raw = np.zeros((n_h, n_n))\n    for h in range(n_h):\n        for n in range(n_n):\n            m = tr_mask[:, h, n]\n            if m.sum() > 0:\n                bias_nh_raw[h, n] = (tr_corrected[:, h, n] - tr_target[:, h, n])[m].mean()\n    bias_nh = nh_bias_shrink * bias_nh_raw\n    tr_corrected = tr_corrected - bias_nh[np.newaxis, :, :]\n    val_corrected = val_corrected - bias_nh[np.newaxis, :, :]\n    \n    residual = tr_corrected - tr_target\n    \n    # 5. Sample-level ridge correction\n    tr_sample_feat = build_sample_feats(tr_base, tr_anchor, tr_history, tr_clock)\n    val_sample_feat = build_sample_feats(val_base, val_anchor, val_history, val_clock)\n    \n    tr_sample_bias = np.zeros((len(tr_idx), n_h))\n    val_sample_bias = np.zeros((len(val_idx), n_h))\n    \n    for h in range(n_h):\n        y = residual[:, h, :].mean(axis=1)\n        X = tr_sample_feat[:, h, :]\n        mu = X.mean(axis=0)\n        sd = X.std(axis=0)\n        sd[sd < 1e-6] = 1.0\n        Xs = (X - mu) / sd\n        model = Ridge(alpha=sample_alpha, fit_intercept=True)\n        model.fit(Xs, y)\n        tr_sample_bias[:, h] = model.predict(Xs)\n        X_val = (val_sample_feat[:, h, :] - mu) / sd\n        val_sample_bias[:, h] = model.predict(X_val)\n    \n    tr_corrected = tr_corrected - sample_shrink * tr_sample_bias[:, :, np.newaxis]\n    val_corrected = val_corrected - sample_shrink * val_sample_bias[:, :, np.newaxis]\n    residual = tr_corrected - tr_target\n    \n    # 6. Node-level ridge correction\n    hist_last_tr = tr_history[:, -1, :]\n    hist_avg_tr = tr_history.mean(axis=1)\n    hist_trend_tr = (tr_history[:, -1, :] - tr_history[:, 0, :]) / 12.0\n    hist_last_val = val_history[:, -1, :]\n    hist_avg_val = val_history.mean(axis=1)\n    hist_trend_val = (val_history[:, -1, :] - val_history[:, 0, :]) / 12.0\n    \n    val_ridge_corr = np.zeros_like(val_corrected)\n    for h in range(n_h):\n        m = tr_mask[:, h, :]\n        y = residual[:, h, :][m].flatten()\n        if len(y) < 100:\n            continue\n        X_tr = build_node_feats(tr_base[:, h, :], tr_anchor[:, h, :], hist_last_tr, hist_avg_tr, hist_trend_tr,\n                                tr_clock[:, h, 0], n_n, len(tr_idx))\n        X_tr_valid = X_tr[m.flatten()]\n        mu = X_tr_valid.mean(axis=0)\n        sd = X_tr_valid.std(axis=0)\n        sd[sd < 1e-6] = 1.0\n        Xs = (X_tr_valid - mu) / sd\n        model = Ridge(alpha=ridge_alpha, fit_intercept=True)\n        model.fit(Xs, y)\n        X_val = build_node_feats(val_base[:, h, :], val_anchor[:, h, :], hist_last_val, hist_avg_val, hist_trend_val,\n                                 val_clock[:, h, 0], n_n, len(val_idx))\n        Xvs = (X_val - mu) / sd\n        correction = ridge_shrink * model.predict(Xvs)\n        val_ridge_corr[:, h, :] = correction.reshape(len(val_idx), n_nodes)\n    \n    val_corrected = val_corrected - val_ridge_corr\n    val_mae = np.abs(val_corrected - val_target)[val_mask].mean()\n    return val_mae\n\n# Test different configurations\nconfigs = [\n    (\\\"baseline (no corrections),\n    (\\\"per_horizon_anchor only', 'per_horizon', 0.5, 0.5, 0.3, 10, 0.4, 100, 0.3),\n    (\\\"per_node_horizon_anchor (shrink=0.2)', 'per_node_horizon', 0.2, 0.5, 0.3, 10, 0.4, 100, 0.3),\n    (\\\"per_node_horizon_anchor (shrink=0.4)', 'per_node_horizon', 0.4, 0.5, 0.3, 10, 0.4, 100, 0.3),\n    (\\\"no_anchor + sample only + ridge only', 'per_horizon', 0.5, 0.0, 0.0, 10, 0.4, 100, 0.3),\n]\n\nWait, let me format this properly. Let me try key variations:\nprint(\\\"Testing anchor mode    | Val MAE  Fold0  Fold1  Fold2  Fold3  Fold4  Avg\\\")\nfor name, am, ashr, nbs, nhbs, sa, ss, ra, rs in [\n    (\\\"baseline', 'none', 0, 0, 0, 0, 0, 0, 0),\n    (\\\"bias only', 'none', 0, 0.5, 0.3, 0, 0, 0, 0),\n    (\\\"bias+sample_ridge', 'none', 0, 0.5, 0.3, 10, 0.4, 100, 0.3),\n    (\\\"h_anchor+bias+both_ridge', 'per_horizon', 0, 0.5, 0.3, 10, 0.4, 100, 0.3),\n    (\\\"nh_anchor_0.2+bias+both_ridge', 'per_node_horizon', 0.2, 0.5, 0.3, 10, 0.4, 100, 0.3),\n    (\\\"nh_anchor_0.4+bias+both_ridge', 'per_node_horizon', 0.4, 0.5, 0.3, 10, 0.4, 100, 0.3),\n]:\n    fold_maes = []\n    for fold in range(k):\n        val_idx = idx[fold*fold_size:(fold+1)*fold_size]\n        tr_idx = np.setdiff1d(idx, val_idx)\n        mae = run_pipeline(tr_idx, val_idx, am, ashr, nbs, nhbs, sa, ss, ra, rs)\n        fold_maes.append(mae)\n    avg = np.mean(fold_maes)\n    print(f\\\"{name:35s} {fold_maes[0]:.3f} {fold_maes[1]:.3f} {fold_maes[2]:.3f} {fold_maes[3]:.3f} {fold_maes[4]:.3f} {avg:.3f}\\\")\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

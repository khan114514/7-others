py()\n        val_corrected = val_base.copy()\n    \n    h_bias = np.zeros(n_h)\n    for h in range(n_h):\n        m = tr_mask[:, h, :]\n        h_bias[h] = (tr_corrected[:, h, :] - tr_target[:, h, :])[m].mean()\n    tr_corrected = tr_corrected - h_bias[np.newaxis, :, np.newaxis]\n    val_corrected = val_corrected - h_bias[np.newaxis, :, np.newaxis]\n    \n    node_bias_raw = np.zeros(n_n)\n    for n in range(n_n):\n        m = tr_mask[:, :, n]\n        node_bias_raw[n] = (tr_corrected[:, :, n] - tr_target[:, :, n])[m].mean()\n    node_bias = node_bias_shrink * node_bias_raw\n    tr_corrected = tr_corrected - node_bias[np.newaxis, np.newaxis, :]\n    val_corrected = val_corrected - node_bias[np.newaxis, np.newaxis, :]\n    \n    bias_nh_raw = np.zeros((n_h, n_n))\n    for h in range(n_h):\n        for n in range(n_n):\n            m = tr_mask[:, h, n]\n            if m.sum() > 0:\n                bias_nh_raw[h, n] = (tr_corrected[:, h, n] - tr_target[:, h, n])[m].mean()\n    bias_nh = nh_bias_shrink * bias_nh_raw\n    tr_corrected = tr_corrected - bias_nh[np.newaxis, :, :]\n    val_corrected = val_corrected - bias_nh[np.newaxis, :, :]\n    \n    residual = tr_corrected - tr_target\n    \n    tr_sample_feat = build_sample_feats(tr_base, tr_anchor, tr_history, tr_clock)\n    val_sample_feat = build_sample_feats(val_base, val_anchor, val_history, val_clock)\n    \n    tr_sample_bias = np.zeros((len(tr_idx), n_h))\n    val_sample_bias = np.zeros((len(val_idx), n_h))\n    \n    for h in range(n_h):\n        y = residual[:, h, :].mean(axis=1)\n        X = tr_sample_feat[:, h, :]\n        mu = X.mean(axis=0)\n        sd = X.std(axis=0)\n        sd[sd < 1e-6] = 1.0\n        Xs = (X - mu) / sd\n        model = Ridge(alpha=sample_alpha, fit_intercept=True)\n        model.fit(Xs, y)\n        tr_sample_bias[:, h] = model.predict(Xs)\n        X_val = (val_sample_feat[:, h, :] - mu) / sd\n        val_sample_bias[:, h] = model.predict(X_val)\n    \n    tr_corrected = tr_corrected - sample_shrink * tr_sample_bias[:, :, np.newaxis]\n    val_corrected = val_corrected - sample_shrink * val_sample_bias[:, :, np.newaxis]\n    residual = tr_corrected - tr_target\n    \n    hist_last_tr = tr_history[:, -1, :]\n    hist_avg_tr = tr_history.mean(axis=1)\n    hist_trend_tr = (tr_history[:, -1, :] - tr_history[:, 0, :]) / 12.0\n    hist_last_val = val_history[:, -1, :]\n    hist_avg_val = val_history.mean(axis=1)\n    hist_trend_val = (val_history[:, -1, :] - val_history[:, 0, :]) / 12.0\n    \n    val_ridge_corr = np.zeros_like(val_corrected)\n    for h in range(n_h):\n        m = tr_mask[:, h, :]\n        y = residual[:, h, :][m].flatten()\n        if len(y) < 100:\n            continue\n        X_tr = build_node_feats(tr_base[:, h, :], tr_anchor[:, h, :], hist_last_tr, hist_avg_tr, hist_trend_tr,\n                                tr_clock[:, h, 0], n_n, len(tr_idx))\n        X_tr_valid = X_tr[m.flatten()]\n        mu = X_tr_valid.mean(axis=0)\n        sd = X_tr_valid.std(axis=0)\n        sd[sd < 1e-6] = 1.0\n        Xs = (X_tr_valid - mu) / sd\n        model = Ridge(alpha=ridge_alpha, fit_intercept=True)\n        model.fit(Xs, y)\n        X_val = build_node_feats(val_base[:, h, :], val_anchor[:, h, :], hist_last_val, hist_avg_val, hist_trend_val,\n                                 val_clock[:, h, 0], n_n, len(val_idx))\n        Xvs = (X_val - mu) / sd\n        correction = ridge_shrink * model.predict(Xvs)\n        val_ridge_corr[:, h, :] = correction.reshape(len(val_idx), n_n)\n    \n    val_corrected = val_corrected - val_ridge_corr\n    val_mae = np.abs(val_corrected - val_target)[val_mask].mean()\n    return val_mae\n\nconfigs = [\n    (\\\"baseline (raw base)\\\", 'none', 0, 0, 0, 0, 0, 0, 0),\n    (\\\"bias only (h+node+nh)\\\", 'none', 0, 0.5, 0.3, 0, 0, 0, 0),\n    (\\\"bias + sample_ridge\\\", 'none', 0, 0.5, 0.3, 10, 0.4, 0, 0),\n    (\\\"bias + node_ridge\\\", 'none', 0, 0.5, 0.3, 0, 0, 100, 0.3),\n    (\\\"bias + both_ridge\\\", 'none', 0, 0.5, 0.3, 10, 0.4, 100, 0.3),\n    (\\\"h_anchor + bias + both_ridge\\\", 'per_horizon', 0, 0.5, 0.3, 10, 0.4, 100, 0.3),\n    (\\\"nh_anchor s=0.2 + bias + both\\\", 'per_node_horizon', 0.2, 0.5, 0.3, 10, 0.4, 100, 0.3),\n    (\\\"nh_anchor s=0.4 + bias + both\\\", 'per_node_horizon', 0.4, 0.5, 0.3, 10, 0.4, 100, 0.3),\n]\n\nprint(f\\\"{'Config':35s}  {'F0':>6s} {'F1':>6s} {'F2':>6s} {'F3':>6s} {'F4':>6s} {'Avg':>6s}\\\")\nfor name, am, ashr, nbs, nhbs, sa, ss, ra, rs in configs:\n    fold_maes = []\n    for fold in range(k):\n        val_idx = idx[fold*fold_size:(fold+1)*fold_size]\n        tr_idx = np.setdiff1d(idx, val_idx)\n        mae = run_pipeline(tr_idx, val_idx, am, ashr, nbs, nhbs, sa, ss, ra, rs)\n        fold_maes.append(mae)\n    avg = np.mean(fold_maes)\n    print(f\\\"{name:35s}  {fold_maes[0]:6.3f} {fold_maes[1]:6.3f} {fold_maes[2]:6.3f} {fold_maes[3]:6.3f} {fold_maes[4]:6.3f} {avg:6.3f}\\\")\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

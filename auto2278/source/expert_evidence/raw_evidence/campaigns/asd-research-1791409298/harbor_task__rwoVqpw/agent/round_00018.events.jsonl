trize*alpha\n# Same number of ops.\n#\n# Let me try yet another approach:\n# Compute p0 and p1 together by batching the softmax?\n# If we concatenate logits and p1_logits along a new dim... no, softmax is per-row.\n#\n# Actually here's a better idea:\n# What if we reshape logits to 2D once, and do all operations in 2D?\n# logits_2d: (BHL, L)\n# p0 = softmax(logits_2d)\n# p1_logits_2d = a_p * logits_2d + a_m * (logits reshaped to (B,H,L,L) then transpose then reshape)\n# The problem is the transpose - we need A\"'^T which requires 4D view.\n# \n# Hmm. Let me just test a few incremental optimizations and find the best combination.\n#\n# Let me try: \n# 1. G_full with p0G/p1G cross-term approach (call this v2)\n# 2. See if there'\"'s a consistent win across sizes\n\ndef benchmark_method(method, x, wq, wk, wv, alpha, beta, n=30):\n    for _ in range(3):\n        method(x, wq, wk, wv, alpha, beta)\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        method(x, wq, wk, wv, alpha, beta)\n    return (time.process_time_ns() - t0) / n\n\ndef current_best(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BHL = B * H * L\n    xr = x.reshape(B * L, C)\n    \n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    \n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    \n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1_logits = logits.mul(a_p)\n        p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n        p1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n        p_mix = torch.lerp(p0, p1, beta)\n        \n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        p1G = p1 @ G_exp\n        norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n        y = (p_mix @ v).mul_(ratio)\n    \n    return y.transpose(1, 2).flatten(2).contiguous()\n\ndef opt_v2(x, wq, wk, wv, alpha, beta):\n    \\\"\\\"\\\"G_full + p0G/p1G cross-term + direct 4D softmax\\\"\\\"\\\"\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BHL = B * H * L\n    xr = x.reshape(B * L, C)\n    \n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    \n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    \n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1_logits = logits.mul(a_p)\n        p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n        p1 = p1_logits.softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        \n        G = x @ x.transpose(-1, -2)\n        G_full = G.unsqueeze(1).expand(B, H, L, L).contiguous()\n        p0G = p0 @ G_full\n        p1G = p1 @ G_full\n        \n        norm0_sq = (p0G * p0).sum(dim=-1, keepdim=True)\n        norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n        cross = (p0G * p1).sum(dim=-1, keepdim=True)\n        \n        a0 = 1.0 - beta\n        normm_sq = a0*a0*norm0_sq + beta*beta*norm1_sq + 2*a0*beta*cross\n        \n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n        y = (p_mix @ v).mul_(ratio)\n    \n    return y.transpose(1, 2).flatten(2).contiguous()\n\ncases = [\n    (1, 64, 512, 8, 64, 1.05, 5.0),\n    (1, 128, 640, 10, 64, 1.1, 4.0),\n    (1, 128, 1280, 20, 64, 1.15, 3.0),\n    (1, 256, 1280, 20, 64, 1.05, 7.5),\n    (1, 256, 640, 10, 64, 1.2, 5.0),\n    (2, 128, 512, 8, 64, 1.0, 5.0),\n]\n\n# Run multiple times for stability\ng = torch.Generator().manual_seed(17)\nresults_curr = []\nresults_opt = []\nfor b, l, c, h, d, alpha, beta in cases:\n    x = torch.randn(b, l, c, generator=g)\n    wq = torch.randn(h, d, c, generator=g) / math.sqrt(c)\n    wk = torch.randn(h, d, c, generator=g) / math.sqrt(c)\n    wv = torch.randn(h, d, c, generator=g) / math.sqrt(c)\n    \n    y0 = current_best(x, wq, wk, wv, alpha, beta)\n    y1 = opt_v2(x, wq, wk, wv, alpha, beta)\n    diff = (y0 - y1).abs().max()\n    \n    n = 100 if l <= 128 else 40\n    # Take the minimum of 3 runs to reduce noise\n    times_curr = []\n    times_opt = []\n    for _ in range(3):\n        times_curr.append(benchmark_method(current_best, x, wq, wk, wv, alpha, beta, n=n))\n        times_opt.append(benchmark_method(opt_v2, x, wq, wk, wv, alpha, beta, n=n))\n    t0 = min(times_curr)\n    t1 = min(times_opt)\n    \n    print(f'B={b:1d} L={l:3d} C={c:4d} H={h:2d}: curr={t0/1e6:7.3f}ms opt={t1/1e6:7.3f}ms spd={t0/t1:1.3f}x diff={diff:.2e}')\n    results_curr.append(t0)\n    results_opt.append(t1)\n\navg_curr = sum(results_curr) / len(results_curr)\navg_opt = sum(results_opt) / len(results_opt)\nprint(f'\\\\nArithmetic mean: curr={avg_curr/1e6:.3f}ms opt={avg_opt/1e6:.3f}ms ratio={avg_curr/avg_opt:.3f}x')\nPYEOF\n\"","aggregated_output":"B=1 L= 64 C= 512 H= 8: curr=  3.782ms opt=  3.764ms spd=1.005x diff=4.29e-06\nB=1 L=128 C= 640 H=10: curr= 10.634ms opt= 10.689ms spd=0.995x diff=4.53e-06\nB=1 L=128 C=1280 H=20: curr= 34.006ms opt= 35.910ms spd=0.947x diff=1.97e-06\nB=1 L=256 C=1280 H=20: curr=101.649ms opt=103.032ms spd=0.987x diff=8.23e-06\nB=1 L=256 C= 640 H=10: curr= 41.141ms opt= 37.032ms spd=1.111x diff=2.26e-06\nB=2 L=128 C= 512 H= 8: curr=  9.480ms opt=  9.303ms spd=1.019x diff=0.00e+00\n\nArithmetic mean: curr=33.449ms opt=33.288ms ratio=1.005x\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 << 'PYEOF'\nimport torch, time, math\ntorch.set_num_threads(1)\n\n# Let me try a different direction: what about using addmm or explicit 2D for projections?\n# Also: can we avoid the permute by changing the weight layout?\n\nb, h, l, c, d = 1, 20, 256, 1280, 64\nx = torch.randn(b, l, c)\nw = torch.randn(h, d, c) / math.sqrt(c)\nxr = x.reshape(b*l, c)\nHD = h*d\n\n# Current approach: (BL, C) @ (HD, C).T -> (BL, HD) -> reshape (B, L, H, D) -> permute -> (B, H, L, D)\nfor _ in range(3):\n    y = (xr @ w.reshape(HD, c).T).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\nt0 = time.process_time_ns()\nfor _ in range(50):\n    y = (xr @ w.reshape(HD, c).T).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\nt0 = (time.process_time_ns() - t0) / 50\n\n# Alternative: reshape weight to (H, D, C), then do per-head matmuls via bmm?\n# No, that's slower.\n# \n# Alternative: compute q as (H*D, C) @ (C, B*L) = (H*D, B*L), then reshape.\n# Same thing, just transposed.\n#\n# Alternative: use einsum with different path\nfor _ in range(3):\n    y2 = torch.einsum('blc,hdc->bhld', x, w)\nt1 = time.process_time_ns()\nfor _ in range(50):\n    y2 = torch.einsum('blc,hdc->bhld', x, w)\nt1 = (time.process_time_ns() - t1) / 50\n\n# Alternative: what if we reshape weight to (H, C, D) and do something different?\nw_t = w.permute(0, 2, 1).contiguous()  # (H, C, D)\n# Then: x (B, L, C) times w_t (H, C, D) -> (B, H, L, D)\n# We could do: for h_i in range(H): q[:,h_i,:,:] = x @ w_t[h_i]\n# That's H matmuls of (B*L, C) @ (C, D) = (B*L, D)\nfor _ in range(3):\n    outs = []\n    for hi in range(h):\n        outs.append(xr @ w_t[hi])\n    y3 = torch.stack(outs, dim=1).reshape(b, h, l, d)\nt2 = time.process_time_ns()\nfor _ in range(50):\n    outs = []\n    for hi in range(h):\n        outs.append(xr @ w_t[hi])\n    y3 = torch.stack(outs, dim=1).reshape(b, h, l, d)\nt2 = (time.process_time_ns() - t2) / 50\n\n# Alternative: batch matmul approach with x expanded\n# x_exp: (H, B*L, C), w_exp: (H, C, D) -> bmm -> (H, B*L, D)\nx_exp = xr.unsqueeze(0).expand(h, b*l, c).contiguous()\nw_2d = w.reshape(h*d, c)\nw_hcd = w  # (H, D, C), we need (H, C, D) for bmm\nw_hcd_t = w.transpose(-1, -2).contiguous()  # (H, C, D)\nfor _ in range(3):\n    y4 = torch.bmm(x_exp, w_hcd_t).permute(1, 0, 2).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\nt3 = time.process_time_ns()\nfor _ in range(50):\n    y4 = torch.bmm(x_exp, w_hcd_t).permute(1, 0, 2).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\nt3 = (time.process_time_ns() - t3) / 50\n\nprint(f'Current (2D matmul + permute): {t0/1e6:.3f}ms')\nprint(f'Einsum bhld:                 {t1/1e6:.3f}ms')\nprint(f'Per-head loop:               {t2/1e6:.3f}ms')\nprint(f'bmm (H batches):             {t3/1e6:.3f}ms')\nprint(f'Correctness (0 vs 1): {(y - y2).abs().max():.2e}')\nprint(f'Correctness (0 vs 3): {(y - y4).abs().max():.2e}')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

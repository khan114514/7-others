{"type":"item.started","item":{"id":"item_96","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 << 'PYEOF'\nimport torch, time, math\ntorch.set_num_threads(1)\n\n# torch.mm is fastest\"'! It'\"'s faster than @ operator for 2D tensors.\n# Let me verify this across all sizes.\n\ndef bench_proj(b, l, c, h, d):\n    x = torch.randn(b, l, c)\n    w = torch.randn(h, d, c) / math.sqrt(c)\n    xr = x.reshape(b*l, c)\n    HD = h*d\n    w2d = w.reshape(HD, c)\n    \n    for _ in range(5):\n        y1 = xr @ w2d.T\n    t0 = time.process_time_ns()\n    for _ in range(200):\n        y1 = xr @ w2d.T\n    t0 = (time.process_time_ns() - t0) / 200\n    \n    for _ in range(5):\n        y2 = torch.mm(xr, w2d.T)\n    t1 = time.process_time_ns()\n    for _ in range(200):\n        y2 = torch.mm(xr, w2d.T)\n    t1 = (time.process_time_ns() - t1) / 200\n    \n    print(f'B*L={b*l:4d} C={c:4d} H*D={HD:4d}: @={t0/1e6:.3f}ms mm={t1/1e6:.3f}ms ratio={t0/t1:.3f}x')\n\nfor b, l, c, h, d in [(1, 64, 512, 8, 64), (1, 128, 640, 10, 64), (1, 128, 1280, 20, 64),\n                       (1, 256, 1280, 20, 64), (1, 256, 640, 10, 64), (2, 128, 512, 8, 64)]:\n    bench_proj(b, l, c, h, d)\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

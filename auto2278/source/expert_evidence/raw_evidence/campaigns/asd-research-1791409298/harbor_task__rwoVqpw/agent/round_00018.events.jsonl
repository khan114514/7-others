{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/sh -lc 'cd /workspace && python3 -c \"\nimport torch, time, math\ntorch.set_num_threads(1)\n\n# Compare: compute p_mix first then one p_mix@G vs computing p0@G and p1@G separately\n# p_mix = (1-beta)*p0 + beta*p1\n# We need norm of (p_mix @ x) and norm of (p1 @ x)\n# Option A: compute p1@G and p_mix@G (current)\n# Option B: compute p0@G and p1@G, then derive p_mix@G via linearity\n\nb, h, l, c = 1, 20, 256, 1280\nx = torch.randn(b, l, c)\np0 = torch.randn(b, h, l, l).softmax(dim=-1)\np1 = torch.randn(b, h, l, l).softmax(dim=-1)\nbeta = 3.0\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\n\n# Option A: p1@G and p_mix@G\np_mix = torch.lerp(p0, p1, beta)\nfor _ in range(5):\n    p1G = p1 @ G_exp\n    norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\nt0 = time.process_time_ns()\nfor _ in range(20):\n    p1G = p1 @ G_exp\n    norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\nt0 = (time.process_time_ns() - t0) / 20\n\n# Option B: p0@G and p1@G, derive p_mix@G = (1-b)*p0@G + b*p1@G\n# Also normm_sq = ||p_mix @ x||''^2 = (p_mix @ G) * p_mix summed\n# But if we have p0G and p1G: pmG = (1-b)*p0G + b*p1G\nfor _ in range(5):\n    p0G = p0 @ G_exp\n    p1G = p1 @ G_exp\n    norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n    pmG = torch.lerp(p0G, p1G, beta)\n    # But normm_sq = (pmG * p_mix).sum() ... we still need p_mix for this\n    # Actually we can use: ||(1-b)*p0@x + b*p1@x||''^2 = (1-b)''^2*||p0@x||''^2 + b''^2*||p1@x||''^2 + 2*(1-b)*b*(p0@x dot p1@x)\n    # And cross = (p0@x) dot (p1@x) = (p0 @ G * p1).sum(-1) = (p0G * p1).sum(-1) -- WRONG\n    # Actually: (p0 @ x) dot (p1 @ x) over C dims = sum_c (sum_j p0_j x_jc)(sum_k p1_k x_kc)\n    # = sum_j sum_k p0_j p1_k sum_c x_jc x_kc = sum_j sum_k p0_j p1_k G_jk = (p0 @ G * p1).sum(-1)\n    norm0_sq = (p0G * p0).sum(dim=-1, keepdim=True)\n    cross = (p0G * p1).sum(dim=-1, keepdim=True)  # wait, is this right?\n    norm1_sq_b = (p1G * p1).sum(dim=-1, keepdim=True)\n    a0 = 1.0 - beta\n    normm_sq_b = a0*a0*norm0_sq + beta*beta*norm1_sq_b + 2*a0*beta*cross\n    norm1_b = norm1_sq_b.sqrt_().clamp_min_(1e-6)\n    normm_b = normm_sq_b.sqrt_().clamp_min_(1e-6)\n    ratio_b = norm1_b.div_(normm_b).clamp_(0.25, 4.0)\nt1 = time.process_time_ns()\nfor _ in range(20):\n    p0G = p0 @ G_exp\n    p1G = p1 @ G_exp\n    norm0_sq = (p0G * p0).sum(dim=-1, keepdim=True)\n    cross = (p0G * p1).sum(dim=-1, keepdim=True)\n    norm1_sq_b = (p1G * p1).sum(dim=-1, keepdim=True)\n    a0 = 1.0 - beta\n    normm_sq_b = a0*a0*norm0_sq + beta*beta*norm1_sq_b + 2*a0*beta*cross\n    norm1_b = norm1_sq_b.sqrt_().clamp_min_(1e-6)\n    normm_b = normm_sq_b.sqrt_().clamp_min_(1e-6)\n    ratio_b = norm1_b.div_(normm_b).clamp_(0.25, 4.0)\nt1 = (time.process_time_ns() - t1) / 20\n\nprint(f'\"'  Option A (current): {t0/1e6:.3f}ms')\nprint(f'  Option B (p0G+p1G+cross): {t1/1e6:.3f}ms')\n\n# Verify numerical correctness\n# Option A reference\np1G_ref = p1 @ G_exp\nnorm1_sq_ref = (p1G_ref * p1).sum(dim=-1, keepdim=True)\npmG_ref = p_mix @ G_exp\nnormm_sq_ref = (pmG_ref * p_mix).sum(dim=-1, keepdim=True)\nnorm1_ref = norm1_sq_ref.sqrt().clamp_min(1e-6)\nnormm_ref = normm_sq_ref.sqrt().clamp_min(1e-6)\nratio_ref = (norm1_ref / normm_ref).clamp(0.25, 4.0)\n\nprint(f'  Option A vs B ratio max diff: {(ratio_ref - ratio_b).abs().max():.6e}')\nprint(f'  Option A vs B norm1 max diff: {(norm1_ref - norm1_b).abs().max():.6e}')\nprint(f'  Option A vs B normm max diff: {(normm_ref - normm_b).abs().max():.6e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

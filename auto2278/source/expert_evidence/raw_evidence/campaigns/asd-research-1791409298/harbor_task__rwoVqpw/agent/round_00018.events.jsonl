{"type":"item.started","item":{"id":"item_74","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 << 'PYEOF'\nimport torch, time, math\ntorch.set_num_threads(1)\n\n# Stacked gram shows promise: 10.6% mean speedup across cases\"'!\n# But it'\"'s slower for small cases (L=64, L=128 small C).\n# Let me investigate: for which sizes is stacking better?\n# It depends on whether the overhead of cat+slice is worth the reduced dispatch.\n\ndef bench_stacked(b, h, l, c):\n    p1 = torch.randn(b, h, l, l).softmax(dim=-1)\n    p_mix = torch.randn(b, h, l, l).softmax(dim=-1)\n    G = torch.randn(b, l, l)\n    G_exp = G.unsqueeze(1)\n    \n    for _ in range(5):\n        y1 = p1 @ G_exp\n        y2 = p_mix @ G_exp\n    t0 = time.process_time_ns()\n    for _ in range(100):\n        y1 = p1 @ G_exp\n        y2 = p_mix @ G_exp\n    t0 = (time.process_time_ns() - t0) / 100\n    \n    for _ in range(5):\n        ps = torch.cat([p1, p_mix], dim=1)\n        ys = ps @ G_exp\n        y1b = ys[:, :h]\n        y2b = ys[:, h:]\n    t1 = time.process_time_ns()\n    for _ in range(100):\n        ps = torch.cat([p1, p_mix], dim=1)\n        ys = ps @ G_exp\n        y1b = ys[:, :h]\n        y2b = ys[:, h:]\n    t1 = (time.process_time_ns() - t1) / 100\n    \n    return t0, t1, t0/t1\n\nprint(\\\"Stacked vs separate gram matmul:\\\")\nfor b, h, l, c in [(1, 8, 64, 512), (1, 10, 128, 640), (1, 20, 128, 1280), \n                    (1, 20, 256, 1280), (1, 10, 256, 640), (2, 8, 128, 512)]:\n    t0, t1, spd = bench_stacked(b, h, l, c)\n    print(f'  B={b} H={h:2d} L={l:3d} C={c:4d}: sep={t0/1e6:7.3f}ms stk={t1/1e6:7.3f}ms spd={spd:.3f}x')\n\n# The key question: what determines the benefit?\n# Benefit: single dispatch, better cache utilization\n# Cost: cat + slice overhead\n# For larger H*L products, benefit outweighs cost.\nprint(\\\"\\\\nStacked gram helps when H*L is large enough to amortize cat overhead.\\\")\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_74","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 << 'PYEOF'\nimport torch, time, math\ntorch.set_num_threads(1)\n\n# Stacked gram shows promise: 10.6% mean speedup across cases\"'!\n# But it'\"'s slower for small cases (L=64, L=128 small C).\n# Let me investigate: for which sizes is stacking better?\n# It depends on whether the overhead of cat+slice is worth the reduced dispatch.\n\ndef bench_stacked(b, h, l, c):\n    p1 = torch.randn(b, h, l, l).softmax(dim=-1)\n    p_mix = torch.randn(b, h, l, l).softmax(dim=-1)\n    G = torch.randn(b, l, l)\n    G_exp = G.unsqueeze(1)\n    \n    for _ in range(5):\n        y1 = p1 @ G_exp\n        y2 = p_mix @ G_exp\n    t0 = time.process_time_ns()\n    for _ in range(100):\n        y1 = p1 @ G_exp\n        y2 = p_mix @ G_exp\n    t0 = (time.process_time_ns() - t0) / 100\n    \n    for _ in range(5):\n        ps = torch.cat([p1, p_mix], dim=1)\n        ys = ps @ G_exp\n        y1b = ys[:, :h]\n        y2b = ys[:, h:]\n    t1 = time.process_time_ns()\n    for _ in range(100):\n        ps = torch.cat([p1, p_mix], dim=1)\n        ys = ps @ G_exp\n        y1b = ys[:, :h]\n        y2b = ys[:, h:]\n    t1 = (time.process_time_ns() - t1) / 100\n    \n    return t0, t1, t0/t1\n\nprint(\\\"Stacked vs separate gram matmul:\\\")\nfor b, h, l, c in [(1, 8, 64, 512), (1, 10, 128, 640), (1, 20, 128, 1280), \n                    (1, 20, 256, 1280), (1, 10, 256, 640), (2, 8, 128, 512)]:\n    t0, t1, spd = bench_stacked(b, h, l, c)\n    print(f'  B={b} H={h:2d} L={l:3d} C={c:4d}: sep={t0/1e6:7.3f}ms stk={t1/1e6:7.3f}ms spd={spd:.3f}x')\n\n# The key question: what determines the benefit?\n# Benefit: single dispatch, better cache utilization\n# Cost: cat + slice overhead\n# For larger H*L products, benefit outweighs cost.\nprint(\\\"\\\\nStacked gram helps when H*L is large enough to amortize cat overhead.\\\")\nPYEOF\n\"","aggregated_output":"Stacked vs separate gram matmul:\n  B=1 H= 8 L= 64 C= 512: sep=  0.494ms stk=  0.311ms spd=1.588x\n  B=1 H=10 L=128 C= 640: sep=  2.125ms stk=  2.335ms spd=0.910x\n  B=1 H=20 L=128 C=1280: sep=  3.928ms stk=  8.656ms spd=0.454x\n  B=1 H=20 L=256 C=1280: sep= 32.228ms stk= 31.394ms spd=1.027x\n  B=1 H=10 L=256 C= 640: sep= 11.372ms stk= 12.810ms spd=0.888x\n  B=2 H= 8 L=128 C= 512: sep=  2.972ms stk=  3.928ms spd=0.757x\n\nStacked gram helps when H*L is large enough to amortize cat overhead.\n","exit_code":0,"status":"completed"}}

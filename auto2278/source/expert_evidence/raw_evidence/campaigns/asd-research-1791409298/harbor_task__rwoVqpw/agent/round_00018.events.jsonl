{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\ntorch.set_num_threads(1)\n\n# Test: is F.linear faster than manual matmul+transpose?\nimport torch.nn.functional as F\n\nb, l, c, h, d = 1, 256, 1280, 20, 64\nx = torch.randn(b, l, c)\nw = torch.randn(h, d, c) / math.sqrt(c)\nxr = x.reshape(b*l, c)\nHD = h*d\n\n# Method 1: reshape + matmul (current)\nfor _ in range(3):\n    y1 = (xr @ w.reshape(HD, c).T).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\nt0 = time.process_time_ns()\nfor _ in range(20):\n    y1 = (xr @ w.reshape(HD, c).T).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\nt1 = (time.process_time_ns() - t0) / 20\n\n# Method 2: F.linear\nw2d = w.reshape(HD, c)\nfor _ in range(3):\n    y2 = F.linear(xr, w2d).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\nt0 = time.process_time_ns()\nfor _ in range(20):\n    y2 = F.linear(xr, w2d).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\nt2 = (time.process_time_ns() - t0) / 20\n\n# Method 3: einsum (starter approach)\nfor _ in range(3):\n    y3 = torch.einsum('blc,hdc->bhld', x, w)\nt0 = time.process_time_ns()\nfor _ in range(20):\n    y3 = torch.einsum('blc,hdc->bhld', x, w)\nt3 = (time.process_time_ns() - t0) / 20\n\n# Method 4: bmm approach - reshape x to (B*H, L, C) ? No, can't easily\n# Method 5: permute first then reshape + matmul\nfor _ in range(3):\n    y5 = xr @ w.reshape(HD, c).T\nt0 = time.process_time_ns()\nfor _ in range(20):\n    y5 = xr @ w.reshape(HD, c).T\nt5 = (time.process_time_ns() - t0) / 20\n# Just the 2D matmul cost\n\nprint(f'  matmul+permute+contiguous: {t1/1e6:.3f}ms')\nprint(f'  F.linear+permute+contiguous: {t2/1e6:.3f}ms')\nprint(f'  einsum: {t3/1e6:.3f}ms')\nprint(f'  just 2D matmul: {t5/1e6:.3f}ms')\nprint(f'  overhead of permute+contiguous: {(t1-t5)/1e6:.3f}ms')\nprint()\n\n# Verify correctness\nprint(f'  max diff 1 vs 2: {(y1-y2).abs().max():.2e}')\nprint(f'  max diff 1 vs 3: {(y1-y3).abs().max():.2e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

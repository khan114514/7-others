{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\ntorch.set_num_threads(1)\n\nb, h, l, c, d = 1, 20, 256, 1280, 64\nx = torch.randn(b, l, c)\np0 = torch.randn(b, h, l, l).softmax(dim=-1)\np1 = torch.randn(b, h, l, l).softmax(dim=-1)\nv = torch.randn(b, h, l, d)\nbeta = 3.0\n\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\n\n# Method 1: current - 4D broadcast matmul\nfor _ in range(5):\n    pm = torch.lerp(p0, p1, beta)\n    p1G = p1 @ G_exp\n    pmG = pm @ G_exp\n    n1 = (p1G * p1).sum(-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    nm = (pmG * pm).sum(-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    r = n1.div_(nm).clamp_(0.25, 4.0)\nt0 = time.process_time_ns()\nfor _ in range(30):\n    pm = torch.lerp(p0, p1, beta)\n    p1G = p1 @ G_exp\n    pmG = pm @ G_exp\n    n1 = (p1G * p1).sum(-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    nm = (pmG * pm).sum(-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    r = n1.div_(nm).clamp_(0.25, 4.0)\nt0 = (time.process_time_ns() - t0) / 30\n\n# Method 2: reshape to 3D, bmm\np0_3d = p0.reshape(b*h, l, l).contiguous()\np1_3d = p1.reshape(b*h, l, l).contiguous()\nG_3d = G.expand(b*h, l, l).contiguous()\nfor _ in range(5):\n    pm = torch.lerp(p0_3d, p1_3d, beta)\n    p1G = torch.bmm(p1_3d, G_3d)\n    pmG = torch.bmm(pm, G_3d)\n    n1 = (p1G * p1_3d).sum(-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    nm = (pmG * pm).sum(-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    r = n1.div_(nm).clamp_(0.25, 4.0)\nt1 = time.process_time_ns()\nfor _ in range(30):\n    pm = torch.lerp(p0_3d, p1_3d, beta)\n    p1G = torch.bmm(p1_3d, G_3d)\n    pmG = torch.bmm(pm, G_3d)\n    n1 = (p1G * p1_3d).sum(-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    nm = (pmG * pm).sum(-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    r = n1.div_(nm).clamp_(0.25, 4.0)\nt1 = (time.process_time_ns() - t1) / 30\n\n# Method 3: 4D with pre-expanded G\nG_full = G.expand(b, h, l, l).contiguous()\nfor _ in range(5):\n    pm = torch.lerp(p0, p1, beta)\n    p1G = p1 @ G_full\n    pmG = pm @ G_full\n    n1 = (p1G * p1).sum(-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    nm = (pmG * pm).sum(-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    r = n1.div_(nm).clamp_(0.25, 4.0)\nt2 = time.process_time_ns()\nfor _ in range(30):\n    pm = torch.lerp(p0, p1, beta)\n    p1G = p1 @ G_full\n    pmG = pm @ G_full\n    n1 = (p1G * p1).sum(-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    nm = (pmG * pm).sum(-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    r = n1.div_(nm).clamp_(0.25, 4.0)\nt2 = (time.process_time_ns() - t2) / 30\n\n# Method 4: einsum for p@G\nfor _ in range(5):\n    pm = torch.lerp(p0, p1, beta)\n    p1G = torch.einsum('bhij,bjk->bhik', p1, G.squeeze(0))\n    pmG = torch.einsum('bhij,bjk->bhik', pm, G.squeeze(0))\n    n1 = (p1G * p1).sum(-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    nm = (pmG * pm).sum(-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    r = n1.div_(nm).clamp_(0.25, 4.0)\nt3 = time.process_time_ns()\nfor _ in range(30):\n    pm = torch.lerp(p0, p1, beta)\n    p1G = torch.einsum('bhij,bjk->bhik', p1, G.squeeze(0))\n    pmG = torch.einsum('bhij,bjk->bhik', pm, G.squeeze(0))\n    n1 = (p1G * p1).sum(-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    nm = (pmG * pm).sum(-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    r = n1.div_(nm).clamp_(0.25, 4.0)\nt3 = (time.process_time_ns() - t3) / 30\n\nprint(f'  4D broadcast @:    {t0/1e6:.3f}ms')\nprint(f'  3D bmm (reshaped): {t1/1e6:.3f}ms')\nprint(f'  4D full @:         {t2/1e6:.3f}ms')\nprint(f'  einsum:            {t3/1e6:.3f}ms')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/sh -lc 'cd /workspace && python3 -c \"\nimport torch, time, math\ntorch.set_num_threads(1)\n\n# 4D full @ is faster! The broadcast in 4D hurts. Let me check for all sizes.\nfor b, h, l, c in [(1, 8, 64, 512), (1, 20, 128, 1280), (1, 20, 256, 1280), (2, 8, 128, 512)]:\n    x = torch.randn(b, l, c)\n    p1 = torch.randn(b, h, l, l).softmax(dim=-1)\n    G = x @ x.transpose(-1, -2)\n    \n    G_exp = G.unsqueeze(1)\n    G_full = G.expand(b, h, l, l).contiguous()\n    \n    for _ in range(5):\n        y = p1 @ G_exp\n    t0 = time.process_time_ns()\n    for _ in range(50):\n        y = p1 @ G_exp\n    t0 = (time.process_time_ns() - t0) / 50\n    \n    for _ in range(5):\n        y = p1 @ G_full\n    t1 = time.process_time_ns()\n    for _ in range(50):\n        y = p1 @ G_full\n    t1 = (time.process_time_ns() - t1) / 50\n    \n    # Also: what about G expanded but not contiguous?\n    G_expand = G.unsqueeze(1).expand(b, h, l, l)\n    for _ in range(5):\n        y = p1 @ G_expand\n    t2 = time.process_time_ns()\n    for _ in range(50):\n        y = p1 @ G_expand\n    t2 = (time.process_time_ns() - t2) / 50\n    \n    print(f'\"'B={b} H={h} L={l} C={c}: broadcast={t0/1e6:.3f}ms  full_contig={t1/1e6:.3f}ms  expand_nc={t2/1e6:.3f}ms')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

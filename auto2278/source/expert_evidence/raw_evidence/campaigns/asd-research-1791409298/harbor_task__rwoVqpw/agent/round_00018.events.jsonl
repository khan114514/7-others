{"type":"item.started","item":{"id":"item_88","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 << 'PYEOF'\nimport torch, math, sys\nsys.path.insert(0, '/workspace/solution')\nfrom method import attention\n\ng = torch.Generator().manual_seed(42)\ncases = [\n    (1, 64, 512, 8, 64, 1.05, 5.0),\n    (1, 128, 640, 10, 64, 1.1, 4.0),\n    (1, 128, 1280, 20, 64, 1.15, 3.0),\n    (1, 256, 1280, 20, 64, 1.05, 7.5),\n    (1, 256, 640, 10, 64, 1.2, 5.0),\n    (2, 128, 512, 8, 64, 1.0, 5.0),\n]\n\ndef oracle(x, wq, wk, wv, alpha, beta):\n    q = torch.einsum(\\\"blc,hdc->bhld\\\", x, wq)\n    k = torch.einsum(\\\"blc,hdc->bhld\\\", x, wk)\n    logits = q @ k.transpose(-1, -2) / math.sqrt(wq.shape[1])\n    p0 = logits.softmax(-1)\n    p1 = (.5 * (1 + alpha) * logits + .5 * (1 - alpha) * logits.transpose(-1, -2)).softmax(-1)\n    base, modified = p0 @ x.unsqueeze(1), p1 @ x.unsqueeze(1)\n    mix = base + beta * (modified - base)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / mix.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    return torch.einsum(\\\"bhlc,hdc->bhld\\\", mix * ratio, wv).transpose(1, 2).flatten(2).contiguous()\n\nall_ok = True\nfor b, l, c, h, d, alpha, beta in cases:\n    x = torch.randn(b, l, c, generator=g)\n    wq = torch.randn(h, d, c, generator=g) / math.sqrt(c)\n    wk = torch.randn(h, d, c, generator=g) / math.sqrt(c)\n    wv = torch.randn(h, d, c, generator=g) / math.sqrt(c)\n    expected = oracle(x, wq, wk, wv, alpha, beta)\n    actual = attention(x, wq, wk, wv, alpha, beta)\n    max_err = (actual - expected).abs().max()\n    tol = 3e-5 + 3e-4 * expected.abs()\n    passed = ((actual - expected).abs() <= tol).all().item()\n    all_ok = all_ok and passed\n    print(f'B={b} L={l} C={c} H={h} alpha={alpha}: max_err={max_err:.6e}, passed={passed}')\n\nprint(f'All passed: {all_ok}')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

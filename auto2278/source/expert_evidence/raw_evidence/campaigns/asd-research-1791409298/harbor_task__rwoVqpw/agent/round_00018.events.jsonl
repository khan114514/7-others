{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\ntorch.set_num_threads(1)\n\n# Test softmax alternatives\nb, h, l, d = 1, 20, 256, 64\nlogits = torch.randn(b, h, l, l)\nBHL = b * h * l\n\n# Current: view + softmax + view\nfor _ in range(5):\n    p0 = logits.view(BHL, l).softmax(dim=-1).view(b, h, l, l)\nt0 = time.process_time_ns()\nfor _ in range(30):\n    p0 = logits.view(BHL, l).softmax(dim=-1).view(b, h, l, l)\nt0 = (time.process_time_ns() - t0) / 30\n\n# Direct 4D softmax\nfor _ in range(5):\n    p1 = logits.softmax(dim=-1)\nt1 = time.process_time_ns()\nfor _ in range(30):\n    p1 = logits.softmax(dim=-1)\nt1 = (time.process_time_ns() - t1) / 30\n\n# contiguous + view + softmax + view\nlogits_c = logits.contiguous()\nfor _ in range(5):\n    p2 = logits_c.view(BHL, l).softmax(dim=-1).view(b, h, l, l)\nt2 = time.process_time_ns()\nfor _ in range(30):\n    p2 = logits_c.view(BHL, l).softmax(dim=-1).view(b, h, l, l)\nt2 = (time.process_time_ns() - t2) / 30\n\nprint(f'  view+softmax+view (non-contig): {t0/1e6:.3f}ms')\nprint(f'  direct 4D softmax: {t1/1e6:.3f}ms')\nprint(f'  contiguous+view+softmax+view: {t2/1e6:.3f}ms')\nprint()\n\n# Test norm computation alternatives\n# Current: Gram matrix approach\nx = torch.randn(b, l, 1280)\np = torch.randn(b, h, l, l).softmax(dim=-1)\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\n\nfor _ in range(5):\n    pG = p @ G_exp\n    norm_sq = (pG * p).sum(dim=-1, keepdim=True)\n    norm = norm_sq.sqrt_().clamp_min_(1e-6)\nt3 = time.process_time_ns()\nfor _ in range(20):\n    pG = p @ G_exp\n    norm_sq = (pG * p).sum(dim=-1, keepdim=True)\n    norm = norm_sq.sqrt_().clamp_min_(1e-6)\nt3 = (time.process_time_ns() - t3) / 20\n\n# Alternative: compute p@x directly then norm\nfor _ in range(5):\n    px = p @ x.unsqueeze(1)\n    norm2 = px.norm(dim=-1, keepdim=True).clamp_min_(1e-6)\nt4 = time.process_time_ns()\nfor _ in range(20):\n    px = p @ x.unsqueeze(1)\n    norm2 = px.norm(dim=-1, keepdim=True).clamp_min_(1e-6)\nt4 = (time.process_time_ns() - t4) / 20\n\n# Alternative: compute norm from p@G without separate pG\n# Just the matmul cost\nfor _ in range(5):\n    pG2 = p @ G_exp\nt5 = time.process_time_ns()\nfor _ in range(20):\n    pG2 = p @ G_exp\nt5 = (time.process_time_ns() - t5) / 20\n\nprint(f'  Gram-based norm (2 matmuls): {t3/1e6:.3f}ms')\nprint(f'  p@x + norm (1 matmul + norm): {t4/1e6:.3f}ms')\nprint(f'  just p@G matmul: {t5/1e6:.3f}ms')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

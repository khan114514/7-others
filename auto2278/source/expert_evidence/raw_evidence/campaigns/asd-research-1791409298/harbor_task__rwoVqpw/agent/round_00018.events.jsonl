{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 << 'PYEOF'\nimport torch, time, math\ntorch.set_num_threads(1)\n\n# Let me try a different approach:\n# Instead of gram-matrix for norms, compute norms using a different decomposition.\n# \n# Idea: We need ||p @ x||. x has shape (B, L, C).\n# If C is much larger than L, Gram is better (L\"'^3 vs L''^2*C).\n# If L is larger, p@x directly is better.\n# In all our cases, C > L but not by huge margins.\n#\n# Wait, actually we have the case where:\n# - Gram approach: B * H * L''^3 (for p@G) + B * L''^2 * C (for G)\n# - Direct approach: B * H * L''^2 * C (for p@x)\n#\n# Gram is better when: H*L''^3 + L''^2*C < H*L''^2*C => H*L + C < H*C => C*(H-1) > H*L\n# For H=20, L=256, C=1280: 1280*19 = 24320 > 20*256 = 5120. Yes, gram better.\n# For H=8, L=64, C=512: 512*7 = 3584 > 8*64 = 512. Yes, gram better.\n#\n# So gram is always better here.\n#\n# Let me try another approach to optimize the gram computation.\n# What if we use a different matmul layout for the gram multiply?\n# p shape: (B, H, L, L), G shape: (B, 1, L, L)\n# We want p @ G shape: (B, H, L, L)\n#\n# In the 4D broadcast case, does PyTorch do H separate (L, L) @ (L, L) matmuls?\n# Let me check.\n\nb, h, l = 1, 20, 256\np = torch.randn(b, h, l, l)\nG = torch.randn(b, 1, l, l)\n\n# Method 1: 4D broadcast\nfor _ in range(5):\n    y = p @ G\nt0 = time.process_time_ns()\nfor _ in range(100):\n    y = p @ G\nt0 = (time.process_time_ns() - t0) / 100\n\n# Method 2: reshape to 3D, bmm\np_3d = p.view(b*h, l, l)\nG_3d = G.expand(b, h, l, l).reshape(b*h, l, l)\nfor _ in range(5):\n    y2 = torch.bmm(p_3d, G_3d)\nt1 = time.process_time_ns()\nfor _ in range(100):\n    y2 = torch.bmm(p_3d, G_3d)\nt1 = (time.process_time_ns() - t1) / 100\n\n# Method 3: reshape p to (H*B*L, L), G to (L, L), do one big matmul\np_2d = p.reshape(b*h*l, l)\nG_2d = G.squeeze()  # (L, L)\nfor _ in range(5):\n    y3 = p_2d @ G_2d\nt2 = time.process_time_ns()\nfor _ in range(100):\n    y3 = p_2d @ G_2d\nt2 = (time.process_time_ns() - t2) / 100\n\nprint(f'\"'4D broadcast @:  {t0/1e6:.3f}ms')\nprint(f'3D bmm:          {t1/1e6:.3f}ms')\nprint(f'2D big matmul:   {t2/1e6:.3f}ms')\nprint(f'Correct 1 vs 2: {(y - y2.view(b, h, l, l)).abs().max():.2e}')\nprint(f'Correct 1 vs 3: {(y - y3.view(b, h, l, l)).abs().max():.2e}')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

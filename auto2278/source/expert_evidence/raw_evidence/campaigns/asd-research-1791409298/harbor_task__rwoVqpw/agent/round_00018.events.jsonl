{"type":"item.started","item":{"id":"item_55","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 << 'PYEOF'\nimport torch, math\ntorch.set_num_threads(1)\n\n# Let me try the following optimization: fuse the ratio computation more efficiently,\n# and also try computing norms without the gram approach but using x @ x.T instead of G.\n# Actually let me also try: compute u1_norm\"'^2 differently.\n#\n# Another thought: we have v = x @ wv''^T, which is computed anyway.\n# We also need gram of x.\n#\n# What if we compute: u1 = p1 @ v (in v-space), but we need u1_norm in x-space?\n# No, u1 is in x-space.\n#\n# Let me try yet another approach: \n# u1_norm_sq = diag(p1 @ G @ p1''^T) per head per token\n# = sum_j sum_k p1_j * p1_k * G_jk\n# \n# Since G = x @ x''^T\n# u1_norm_sq = ||p1 @ x||''^2 = (p1 @ x) dot (p1 @ x)\n# = sum_d (sum_j p1_j x_j) dot (sum_k p1_k x_k)\n# = sum_d sum_j sum_k p1_j p1_k x_j . x_k\n# = sum_j sum_k p1_j p1_k (x_j . x_k)\n# = sum_j sum_k p1_j p1_k G_jk\n#\n# This is quadratic in L''^2 operations per row, which is what gram provides efficiently.\n#\n# OK, I think the current approach is close to optimal for the exact computation.\n# Let me just try to get a few more micro-optimizations and then run the full eval.\n#\n# Let me try: pre-compute G differently.\n# Also try: use torch.sum with dtype optimization.\n# Also try: use in-place operations more aggressively.\n\nb, h, l, c, d = 1, 20, 256, 1280, 64\np = torch.randn(b, h, l, l).softmax(dim=-1)\nG = torch.randn(b, l, l)\nG_exp = G.unsqueeze(1)\n\n# Method 1: current\nfor _ in range(5):\n    pG = p @ G_exp\n    norm_sq = (pG * p).sum(dim=-1, keepdim=True)\n    n = norm_sq.sqrt_().clamp_min_(1e-6)\n\nimport time\nt0 = time.process_time_ns()\nfor _ in range(100):\n    pG = p @ G_exp\n    norm_sq = (pG * p).sum(dim=-1, keepdim=True)\n    n = norm_sq.sqrt_().clamp_min_(1e-6)\nt0 = (time.process_time_ns() - t0) / 100\n\n# Method 2: einsum\nfor _ in range(5):\n    norm_sq2 = torch.einsum('\"'bhij,bik,bhk->bhi', p, G, p)\n    n2 = norm_sq2.unsqueeze(-1).sqrt_().clamp_min_(1e-6)\nt1 = time.process_time_ns()\nfor _ in range(100):\n    norm_sq2 = torch.einsum('bhij,bik,bhk->bhi', p, G, p)\n    n2 = norm_sq2.unsqueeze(-1).sqrt_().clamp_min_(1e-6)\nt1 = (time.process_time_ns() - t1) / 100\n\nprint(f'Method 1 (p@G + mul + sum): {t0/1e6:.3f}ms')\nprint(f'Method 2 (einsum quadratic): {t1/1e6:.3f}ms')\nprint(f'Correctness: {(n - n2).abs().max():.2e}')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

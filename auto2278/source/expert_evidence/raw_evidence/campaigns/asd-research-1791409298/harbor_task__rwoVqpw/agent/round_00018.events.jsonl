{"type":"item.started","item":{"id":"item_93","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 << 'PYEOF'\nimport torch, time, math\ntorch.set_num_threads(1)\n\nb, h, l, c, d = 1, 20, 256, 1280, 64\nx = torch.randn(b, l, c)\nwq = torch.randn(h, d, c) / math.sqrt(c)\nwk = torch.randn(h, d, c) / math.sqrt(c)\nwv = torch.randn(h, d, c) / math.sqrt(c)\nxr = x.reshape(b*l, c)\nHD = h*d\n\n# Current projection style\nfor _ in range(5):\n    q = (xr @ wq.reshape(HD, c).T).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\nt0 = time.process_time_ns()\nfor _ in range(100):\n    q = (xr @ wq.reshape(HD, c).T).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\nt0 = (time.process_time_ns() - t0) / 100\n\n# Pre-transposed weight\nwq_t = wq.reshape(HD, c).T.contiguous()  # (C, HD)\nfor _ in range(5):\n    q = (xr @ wq_t).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\nt1 = time.process_time_ns()\nfor _ in range(100):\n    q = (xr @ wq_t).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\nt1 = (time.process_time_ns() - t1) / 100\n\n# F.linear\nimport torch.nn.functional as F\nwq_2d = wq.reshape(HD, c)\nfor _ in range(5):\n    q = F.linear(xr, wq_2d).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\nt2 = time.process_time_ns()\nfor _ in range(100):\n    q = F.linear(xr, wq_2d).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\nt2 = (time.process_time_ns() - t2) / 100\n\nprint(f'Current (reshape .T): {t0/1e6:.3f}ms')\nprint(f'Pre-transposed:      {t1/1e6:.3f}ms')\nprint(f'F.linear:            {t2/1e6:.3f}ms')\n\n# Also try: compute q,k,v with one big matmul (no bias)\nw_all = torch.cat([wq.reshape(HD, c), wk.reshape(HD, c), wv.reshape(HD, c)], dim=0)\nfor _ in range(5):\n    out = xr @ w_all.T\n    q2 = out[:, :HD].reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\n    k2 = out[:, HD:2*HD].reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\n    v2 = out[:, 2*HD:].reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\nt3 = time.process_time_ns()\nfor _ in range(100):\n    out = xr @ w_all.T\n    q2 = out[:, :HD].reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\n    k2 = out[:, HD:2*HD].reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\n    v2 = out[:, 2*HD:].reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\nt3 = (time.process_time_ns() - t3) / 100\n\n# 3 separate matmuls total\nt_separate = 0\nfor _ in range(5):\n    q3 = (xr @ wq.reshape(HD, c).T).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\n    k3 = (xr @ wk.reshape(HD, c).T).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\n    v3 = (xr @ wv.reshape(HD, c).T).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\nt4 = time.process_time_ns()\nfor _ in range(100):\n    q3 = (xr @ wq.reshape(HD, c).T).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\n    k3 = (xr @ wk.reshape(HD, c).T).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\n    v3 = (xr @ wv.reshape(HD, c).T).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\nt4 = (time.process_time_ns() - t4) / 100\n\nprint(f'Combined matmul:     {t3/1e6:.3f}ms')\nprint(f'3 separate matmuls:  {t4/1e6:.3f}ms')\nprint(f'Ratio: {t4/t3:.3f}x')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

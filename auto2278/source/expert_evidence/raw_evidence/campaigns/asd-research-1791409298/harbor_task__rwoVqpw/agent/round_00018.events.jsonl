{"type":"item.started","item":{"id":"item_52","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 << 'PYEOF'\nimport torch, time, math\ntorch.set_num_threads(1)\n\n# Let me try a completely different optimization:\n# Compute logits and p0 softmax in 2D (BHL, L) space for better cache behavior.\n# Also try to avoid 4D matmul for logits by using bmm or 2D matmul.\n#\n# Actually: q @ k.T where q is (B, H, L, D) and k is (B, H, L, D)\n# = q_3d @ k_3d.transpose where q_3d = (B*H, L, D)\n# This is a batched matmul with batch size B*H.\n# \n# Let me benchmark logits computation approaches.\n\nb, h, l, d = 1, 20, 256, 64\nq = torch.randn(b, h, l, d)\nk = torch.randn(b, h, l, d)\n\n# 4D matmul\nfor _ in range(5):\n    logits = q @ k.transpose(-1, -2)\nt0 = time.process_time_ns()\nfor _ in range(200):\n    logits = q @ k.transpose(-1, -2)\nt0 = (time.process_time_ns() - t0) / 200\n\n# 3D bmm\nq3 = q.view(b*h, l, d)\nk3 = k.view(b*h, l, d)\nfor _ in range(5):\n    logits = torch.bmm(q3, k3.transpose(-1, -2))\nt1 = time.process_time_ns()\nfor _ in range(200):\n    logits = torch.bmm(q3, k3.transpose(-1, -2))\nt1 = (time.process_time_ns() - t1) / 200\n\nprint(f'4D matmul: {t0/1e6:.3f}ms')\nprint(f'3D bmm:    {t1/1e6:.3f}ms')\n\n# Now let me check p @ v performance\nv = torch.randn(b, h, l, d)\np = torch.randn(b, h, l, l).softmax(dim=-1)\n\nfor _ in range(5):\n    y = p @ v\nt2 = time.process_time_ns()\nfor _ in range(200):\n    y = p @ v\nt2 = (time.process_time_ns() - t2) / 200\n\np3 = p.view(b*h, l, l)\nv3 = v.view(b*h, l, d)\nfor _ in range(5):\n    y = torch.bmm(p3, v3)\nt3 = time.process_time_ns()\nfor _ in range(200):\n    y = torch.bmm(p3, v3)\nt3 = (time.process_time_ns() - t3) / 200\n\nprint(f'p@v 4D: {t2/1e6:.3f}ms')\nprint(f'p@v 3D: {t3/1e6:.3f}ms')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_52","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 << 'PYEOF'\nimport torch, time, math\ntorch.set_num_threads(1)\n\n# Let me try a completely different optimization:\n# Compute logits and p0 softmax in 2D (BHL, L) space for better cache behavior.\n# Also try to avoid 4D matmul for logits by using bmm or 2D matmul.\n#\n# Actually: q @ k.T where q is (B, H, L, D) and k is (B, H, L, D)\n# = q_3d @ k_3d.transpose where q_3d = (B*H, L, D)\n# This is a batched matmul with batch size B*H.\n# \n# Let me benchmark logits computation approaches.\n\nb, h, l, d = 1, 20, 256, 64\nq = torch.randn(b, h, l, d)\nk = torch.randn(b, h, l, d)\n\n# 4D matmul\nfor _ in range(5):\n    logits = q @ k.transpose(-1, -2)\nt0 = time.process_time_ns()\nfor _ in range(200):\n    logits = q @ k.transpose(-1, -2)\nt0 = (time.process_time_ns() - t0) / 200\n\n# 3D bmm\nq3 = q.view(b*h, l, d)\nk3 = k.view(b*h, l, d)\nfor _ in range(5):\n    logits = torch.bmm(q3, k3.transpose(-1, -2))\nt1 = time.process_time_ns()\nfor _ in range(200):\n    logits = torch.bmm(q3, k3.transpose(-1, -2))\nt1 = (time.process_time_ns() - t1) / 200\n\nprint(f'4D matmul: {t0/1e6:.3f}ms')\nprint(f'3D bmm:    {t1/1e6:.3f}ms')\n\n# Now let me check p @ v performance\nv = torch.randn(b, h, l, d)\np = torch.randn(b, h, l, l).softmax(dim=-1)\n\nfor _ in range(5):\n    y = p @ v\nt2 = time.process_time_ns()\nfor _ in range(200):\n    y = p @ v\nt2 = (time.process_time_ns() - t2) / 200\n\np3 = p.view(b*h, l, l)\nv3 = v.view(b*h, l, d)\nfor _ in range(5):\n    y = torch.bmm(p3, v3)\nt3 = time.process_time_ns()\nfor _ in range(200):\n    y = torch.bmm(p3, v3)\nt3 = (time.process_time_ns() - t3) / 200\n\nprint(f'p@v 4D: {t2/1e6:.3f}ms')\nprint(f'p@v 3D: {t3/1e6:.3f}ms')\nPYEOF\n\"","aggregated_output":"4D matmul: 3.726ms\n3D bmm:    3.090ms\np@v 4D: 3.099ms\np@v 3D: 3.132ms\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 << 'PYEOF'\nimport torch, time, math\ntorch.set_num_threads(1)\n\n# 3D bmm for logits is faster\"'! Let me build a more comprehensive optimization.\n# \n# Key optimizations to try:\n# 1. 3D view for logits computation (bmm)\n# 2. 2D view for softmax (already done)\n# 3. Keep gram as 4D broadcast (fastest)\n# 4. Cross-term norm approach with p0G + p1G\n# \n# Let me build a complete optimized version and test it end-to-end.\n\ndef benchmark_method(method, x, wq, wk, wv, alpha, beta, n=30):\n    for _ in range(3):\n        method(x, wq, wk, wv, alpha, beta)\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        method(x, wq, wk, wv, alpha, beta)\n    return (time.process_time_ns() - t0) / n\n\ndef current_best(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BHL = B * H * L\n    xr = x.reshape(B * L, C)\n    \n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    \n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    \n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1_logits = logits.mul(a_p)\n        p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n        p1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n        p_mix = torch.lerp(p0, p1, beta)\n        \n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        p1G = p1 @ G_exp\n        norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n        y = (p_mix @ v).mul_(ratio)\n    \n    return y.transpose(1, 2).flatten(2).contiguous()\n\ndef opt_v3(x, wq, wk, wv, alpha, beta):\n    \"\"\"3D bmm for logits + 2D softmax + cross-term norms + 4D gram\"\"\"\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BH = B * H\n    BHL = BH * L\n    xr = x.reshape(B * L, C)\n    \n    q_4d = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k_4d = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v_4d = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    \n    # 3D views for bmm\n    q = q_4d.view(BH, L, D)\n    k = k_4d.view(BH, L, D)\n    v = v_4d.view(BH, L, D)\n    \n    # logits via bmm\n    logits = torch.bmm(q, k.transpose(-1, -2))\n    logits.mul_(inv_sqrt_d)\n    \n    # softmax via 2D view\n    p0_2d = logits.view(BHL, L).softmax(dim=-1)\n    p0_4d = p0_2d.view(B, H, L, L)\n    \n    if alpha == 1.0:\n        y = torch.bmm(p0_2d.view(BH, L, L), v)\n        return y.view(B, H, L, D).transpose(1, 2).flatten(2).contiguous()\n    \n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1_2d = p1_logits.view(BHL, L).softmax(dim=-1)\n    p1_4d = p1_2d.view(B, H, L, L)\n    \n    p_mix_4d = torch.lerp(p0_4d, p1_4d, beta)\n    \n    # Gram norms\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    \n    # Compute p0@G and p1@G, derive norm_mix from cross-term\n    p0G = p0_4d @ G_exp\n    p1G = p1_4d @ G_exp\n    \n    norm0_sq = (p0G * p0_4d).sum(dim=-1, keepdim=True)\n    norm1_sq = (p1G * p1_4d).sum(dim=-1, keepdim=True)\n    cross = (p0G * p1_4d).sum(dim=-1, keepdim=True)\n    \n    a0 = 1.0 - beta\n    normm_sq = a0*a0*norm0_sq + beta*beta*norm1_sq + 2*a0*beta*cross\n    \n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    \n    y = (p_mix_4d @ v_4d).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ncases = [\n    (1, 64, 512, 8, 64, 1.05, 5.0),\n    (1, 128, 640, 10, 64, 1.1, 4.0),\n    (1, 128, 1280, 20, 64, 1.15, 3.0),\n    (1, 256, 1280, 20, 64, 1.05, 7.5),\n    (1, 256, 640, 10, 64, 1.2, 5.0),\n    (2, 128, 512, 8, 64, 1.0, 5.0),\n]\n\ng = torch.Generator().manual_seed(17)\nresults = []\nfor b, l, c, h, d, alpha, beta in cases:\n    x = torch.randn(b, l, c, generator=g)\n    wq = torch.randn(h, d, c, generator=g) / math.sqrt(c)\n    wk = torch.randn(h, d, c, generator=g) / math.sqrt(c)\n    wv = torch.randn(h, d, c, generator=g) / math.sqrt(c)\n    \n    y0 = current_best(x, wq, wk, wv, alpha, beta)\n    y1 = opt_v3(x, wq, wk, wv, alpha, beta)\n    diff = (y0 - y1).abs().max()\n    \n    n = 60 if l <= 128 else 25\n    t0 = benchmark_method(current_best, x, wq, wk, wv, alpha, beta, n=n)\n    t1 = benchmark_method(opt_v3, x, wq, wk, wv, alpha, beta, n=n)\n    \n    print(f'\"'B={b:1d} L={l:3d} C={c:4d} H={h:2d}: curr={t0/1e6:7.3f}ms opt={t1/1e6:7.3f}ms spd={t0/t1:1.3f}x diff={diff:.2e}')\n    results.append((t0, t1))\n\navg_curr = sum(r[0] for r in results) / len(results)\navg_opt = sum(r[1] for r in results) / len(results)\nprint(f'\\\\nMean ratio: {avg_curr/avg_opt:.3f}x')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

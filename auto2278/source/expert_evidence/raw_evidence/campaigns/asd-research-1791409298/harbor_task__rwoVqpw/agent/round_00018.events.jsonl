{"type":"item.started","item":{"id":"item_72","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 << 'PYEOF'\nimport torch, time, math\ntorch.set_num_threads(1)\n\n# Let me try something completely different: compute the norm ratio more efficiently.\n# \n# r = ||p1 @ x|| / ||p_mix @ x||\n# p_mix = (1-b)*p0 + b*p1\n# So: r = ||p1 @ x|| / ||((1-b)*p0 + b*p1) @ x||\n#     = ||p1 @ x|| / ||(1-b)*(p0 @ x) + b*(p1 @ x)||\n#\n# Let u0 = p0 @ x, u1 = p1 @ x (both in C-space).\n# r = ||u1|| / ||(1-b)*u0 + b*u1||\n#\n# If we can find a way to compute this ratio without the full Gram matrix...\n# We need norms and a dot product.\n# \n# What if we use the projections we already have (q, k, v)?\n# q[k] = x @ wq[k]\"'^T etc.\n# These are H*D dimensional projections of x.\n# \n# But the norm is in the original C space, not projected.\n# Unless we use some property of wq/wk/wv... they'\"'re arbitrary.\n#\n# Idea: use Q and K to estimate ||p @ x||? \n# Q = x @ Wq\"'^T, K = x @ Wk''^T\n# p = softmax(Q @ K''^T / sqrt(D))\n# \n# No, this doesn'\"'t give us direct access to x-space norms.\n#\n# Let me try another approach: what if we compute G = x @ x\"'^T more efficiently?\n# For B=1, L=256, C=1280: G is 256x256, costs 256''^2*1280 = 84M FLOPs.\n# That'\"'s not huge.\n#\n# Actually, let me try computing u1 and m in a more clever way.\n# What if we only need a FEW dimensions of x to estimate the norm ratio?\n# But we need exact (to tolerance) computation.\n#\n# Wait - what if x has a lot of structure we can exploit?\n# Let me check the input generation: x = torch.randn(...) * input_scale\n# x is random Gaussian. No special structure.\n#\n# OK let me try one more thing: compute both gram matmuls in a single batched call.\n# If we stack p1 and p_mix along a new batch dimension...\n\nb, h, l, c = 1, 20, 256, 1280\np1 = torch.randn(b, h, l, l).softmax(dim=-1)\np_mix = torch.randn(b, h, l, l).softmax(dim=-1)\nG = torch.randn(b, l, l)\nG_exp = G.unsqueeze(1)\n\n# Method 1: separate\nfor _ in range(5):\n    y1 = p1 @ G_exp\n    y2 = p_mix @ G_exp\nt0 = time.process_time_ns()\nfor _ in range(100):\n    y1 = p1 @ G_exp\n    y2 = p_mix @ G_exp\nt0 = (time.process_time_ns() - t0) / 100\n\n# Method 2: stacked\np_stack = torch.cat([p1, p_mix], dim=1)  # (B, 2H, L, L)\nfor _ in range(5):\n    y_stack = p_stack @ G_exp\n    y1b = y_stack[:, :h]\n    y2b = y_stack[:, h:]\nt1 = time.process_time_ns()\nfor _ in range(100):\n    y_stack = p_stack @ G_exp\n    y1b = y_stack[:, :h]\n    y2b = y_stack[:, h:]\nt1 = (time.process_time_ns() - t1) / 100\n\nprint(f'Separate: {t0/1e6:.3f}ms')\nprint(f'Stacked:  {t1/1e6:.3f}ms')\nprint(f'Correct: {(y1 - y1b).abs().max():.2e}, {(y2 - y2b).abs().max():.2e}')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\ntorch.set_num_threads(1)\n\n# Interesting - logits from q@k.T is contiguous (expected for matmul output).\n# 4D direct softmax is slightly faster on contiguous 4D than view approach.\n# Let me try yet another approach: manually compute softmax for better cache locality?\n# Probably not - PyTorch's is already optimized.\n#\n# Let me now try to put together the best optimizations and test end-to-end.\n# Key optimizations to try:\n# 1. Pre-expanded G (G_full) for gram matmuls - ~3%\n# 2. p0G + p1G with cross-term for norm_mix (instead of p1G + pmG) \n# 3. Direct 4D softmax (slight improvement or same)\n# 4. In-place operations where safe\n\nb, h, l, c, d = 1, 20, 256, 1280, 64\nx = torch.randn(b, l, c)\nwq = torch.randn(h, d, c) / math.sqrt(c)\nwk = torch.randn(h, d, c) / math.sqrt(c)\nwv = torch.randn(h, d, c) / math.sqrt(c)\nalpha, beta = 1.1, 3.0\ninv_sqrt_d = 1.0 / math.sqrt(d)\nHD = h * d\nBHL = b * h * l\nxr = x.reshape(b * l, c)\nwqr = wq.reshape(HD, c)\nwkr = wk.reshape(HD, c)\nwvr = wv.reshape(HD, c)\n\ndef baseline():\n    q = (xr @ wqr.T).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wkr.T).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wvr.T).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.view(BHL, l).softmax(dim=-1).view(b, h, l, l)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.view(BHL, l).softmax(dim=-1).view(b, h, l, l)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    p1G = p1 @ G_exp\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ndef optimized():\n    q = (xr @ wqr.T).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wkr.T).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wvr.T).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\n    \n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    \n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    \n    p_mix = torch.lerp(p0, p1, beta)\n    \n    # Pre-expanded G\n    G = x @ x.transpose(-1, -2)\n    G_full = G.unsqueeze(1).expand(b, h, l, l).contiguous()\n    \n    p0G = p0 @ G_full\n    p1G = p1 @ G_full\n    \n    norm0_sq = (p0G * p0).sum(dim=-1, keepdim=True)\n    norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n    cross = (p0G * p1).sum(dim=-1, keepdim=True)\n    \n    a0 = 1.0 - beta\n    normm_sq = a0*a0*norm0_sq + beta*beta*norm1_sq + 2*a0*beta*cross\n    \n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    \n    y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ny0 = baseline()\ny1 = optimized()\nprint(f'Diff: {(y0-y1).abs().max():.6e}')\n\nfor _ in range(5):\n    baseline()\n    optimized()\n\nt0 = time.process_time_ns()\nfor _ in range(30):\n    baseline()\nt0 = (time.process_time_ns() - t0) / 30\n\nt1 = time.process_time_ns()\nfor _ in range(30):\n    optimized()\nt1 = (time.process_time_ns() - t1) / 30\n\nprint(f'Baseline: {t0/1e6:.3f}ms')\nprint(f'Optimized: {t1/1e6:.3f}ms')\nprint(f'Speedup: {t0/t1:.3f}x')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

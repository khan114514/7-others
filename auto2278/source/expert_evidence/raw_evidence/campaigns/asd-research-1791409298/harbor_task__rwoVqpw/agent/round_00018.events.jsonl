{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/sh -lc 'cd /workspace && python3 -c \"\nimport torch, time, math\ntorch.set_num_threads(1)\n\n# Interesting - 4D direct softmax is actually slightly faster than view+softmax+view!\n# That contradicts my earlier measurement. Let me re-test more carefully.\n\nb, h, l = 1, 20, 256\nBHL = b * h * l\n\n# Non-contiguous 4D (like logits from q @ k.T where q is contiguous 4D)\n# Let'\"'s make a non-contiguous 4D tensor\nq = torch.randn(b, h, l, 64)\nk = torch.randn(b, h, l, 64)\nlogits_nc = q @ k.transpose(-1, -2)  # This is contiguous? Let me check.\nprint(f'logits is contiguous: {logits_nc.is_contiguous()}')\n\n# Make truly non-contiguous\nlogits_nc2 = logits_nc.permute(0, 1, 3, 2).permute(0, 1, 3, 2)\nprint(f'logits_nc2 contiguous: {logits_nc2.is_contiguous()}')\n\nfor _ in range(5):\n    p0 = logits_nc.view(BHL, l).softmax(dim=-1).view(b, h, l, l)\nt0 = time.process_time_ns()\nfor _ in range(100):\n    p0 = logits_nc.view(BHL, l).softmax(dim=-1).view(b, h, l, l)\nt0 = (time.process_time_ns() - t0) / 100\n\nfor _ in range(5):\n    p1 = logits_nc.softmax(dim=-1)\nt1 = time.process_time_ns()\nfor _ in range(100):\n    p1 = logits_nc.softmax(dim=-1)\nt1 = (time.process_time_ns() - t1) / 100\n\nprint(f'Contiguous logits:')\nprint(f'  view+softmax+view: {t0/1e6:.3f}ms')\nprint(f'  4D softmax direct: {t1/1e6:.3f}ms')\n\n# Now with non-contiguous\nfor _ in range(5):\n    p0 = logits_nc2.view(BHL, l).softmax(dim=-1).view(b, h, l, l)\nt0 = time.process_time_ns()\nfor _ in range(100):\n    p0 = logits_nc2.view(BHL, l).softmax(dim=-1).view(b, h, l, l)\nt0 = (time.process_time_ns() - t0) / 100\n\nfor _ in range(5):\n    p1 = logits_nc2.softmax(dim=-1)\nt1 = time.process_time_ns()\nfor _ in range(100):\n    p1 = logits_nc2.softmax(dim=-1)\nt1 = (time.process_time_ns() - t1) / 100\n\nprint(f'Non-contiguous logits:')\nprint(f'  view+softmax+view: {t0/1e6:.3f}ms')\nprint(f'  4D softmax direct: {t1/1e6:.3f}ms')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

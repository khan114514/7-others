{"type":"item.started","item":{"id":"item_76","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 << 'PYEOF'\nimport torch, time, math\ntorch.set_num_threads(1)\n\nb, h, l, d = 1, 20, 256, 64\nq = torch.randn(b, h, l, d)\nk = torch.randn(b, h, l, d)\nv = torch.randn(b, h, l, d)\n\n# Current method: manual logits + softmax + matmul\nfor _ in range(5):\n    logits = q @ k.transpose(-1, -2) / math.sqrt(d)\n    p = logits.softmax(dim=-1)\n    y = p @ v\nt0 = time.process_time_ns()\nfor _ in range(100):\n    logits = q @ k.transpose(-1, -2) / math.sqrt(d)\n    p = logits.softmax(dim=-1)\n    y = p @ v\nt0 = (time.process_time_ns() - t0) / 100\n\n# SDPA\nfor _ in range(5):\n    y2 = torch.nn.functional.scaled_dot_product_attention(q, k, v)\nt1 = time.process_time_ns()\nfor _ in range(100):\n    y2 = torch.nn.functional.scaled_dot_product_attention(q, k, v)\nt1 = (time.process_time_ns() - t1) / 100\n\nprint(f'Manual: {t0/1e6:.3f}ms')\nprint(f'SDPA:   {t1/1e6:.3f}ms')\nprint(f'Ratio: {t0/t1:.3f}x')\nprint(f'Correct: {(y - y2).abs().max():.2e}')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_76","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 << 'PYEOF'\nimport torch, time, math\ntorch.set_num_threads(1)\n\nb, h, l, d = 1, 20, 256, 64\nq = torch.randn(b, h, l, d)\nk = torch.randn(b, h, l, d)\nv = torch.randn(b, h, l, d)\n\n# Current method: manual logits + softmax + matmul\nfor _ in range(5):\n    logits = q @ k.transpose(-1, -2) / math.sqrt(d)\n    p = logits.softmax(dim=-1)\n    y = p @ v\nt0 = time.process_time_ns()\nfor _ in range(100):\n    logits = q @ k.transpose(-1, -2) / math.sqrt(d)\n    p = logits.softmax(dim=-1)\n    y = p @ v\nt0 = (time.process_time_ns() - t0) / 100\n\n# SDPA\nfor _ in range(5):\n    y2 = torch.nn.functional.scaled_dot_product_attention(q, k, v)\nt1 = time.process_time_ns()\nfor _ in range(100):\n    y2 = torch.nn.functional.scaled_dot_product_attention(q, k, v)\nt1 = (time.process_time_ns() - t1) / 100\n\nprint(f'Manual: {t0/1e6:.3f}ms')\nprint(f'SDPA:   {t1/1e6:.3f}ms')\nprint(f'Ratio: {t0/t1:.3f}x')\nprint(f'Correct: {(y - y2).abs().max():.2e}')\nPYEOF\n\"","aggregated_output":"Manual: 16.262ms\nSDPA:   15.264ms\nRatio: 1.065x\nCorrect: 1.07e-06\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_77","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 << 'PYEOF'\nimport torch, time, math\ntorch.set_num_threads(1)\n\n# SDPA is 6.5% faster for p0 computation. But we need p0 explicitly for the p_mix formula.\n# Can we get p0 from SDPA? No, SDPA returns the output, not attention weights.\n# We need p0 and p1 explicitly for p_mix and for norm computation.\n#\n# But wait: for the alpha=1.0 case, p1 = p0 and we just need p0 @ v. SDPA helps there.\n# For alpha \"'!= 1.0, we need both p0 and p1 explicitly.\n#\n# Actually, can we compute p_mix @ v differently?\n# p_mix = (1-beta)*p0 + beta*p1\n# p_mix @ v = (1-beta)*(p0 @ v) + beta*(p1 @ v)\n# \n# We could compute p0@v and p1@v using SDPA for both... \n# but SDPA only saves ~6% and we'\"'d still need p0 and p1 for gram norms.\n#\n# Unless: we can compute norms WITHOUT p0 and p1 explicitly?\n# No, we need p@G which requires p explicitly.\n#\n# Let me try another approach: use SDPA for the alpha=1.0 fast path.\n\ndef benchmark_method(method, x, wq, wk, wv, alpha, beta, n=30):\n    for _ in range(3):\n        method(x, wq, wk, wv, alpha, beta)\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        method(x, wq, wk, wv, alpha, beta)\n    return (time.process_time_ns() - t0) / n\n\ndef current_best(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BHL = B * H * L\n    xr = x.reshape(B * L, C)\n    \n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    \n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    \n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1_logits = logits.mul(a_p)\n        p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n        p1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n        p_mix = torch.lerp(p0, p1, beta)\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        p1G = p1 @ G_exp\n        norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n        y = (p_mix @ v).mul_(ratio)\n    \n    return y.transpose(1, 2).flatten(2).contiguous()\n\ndef opt_sdpa_fastpath(x, wq, wk, wv, alpha, beta):\n    \\\"\\\"\\\"Use SDPA for alpha=1.0 fast path.\\\"\\\"\\\"\n    import torch.nn.functional as F\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BHL = B * H * L\n    xr = x.reshape(B * L, C)\n    \n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    \n    if alpha == 1.0:\n        y = F.scaled_dot_product_attention(q, k, v, scale=inv_sqrt_d)\n    else:\n        logits = q @ k.transpose(-1, -2)\n        logits.mul_(inv_sqrt_d)\n        p0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1_logits = logits.mul(a_p)\n        p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n        p1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n        p_mix = torch.lerp(p0, p1, beta)\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        p1G = p1 @ G_exp\n        norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n        y = (p_mix @ v).mul_(ratio)\n    \n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Test alpha=1.0 case\ng = torch.Generator().manual_seed(17)\nb, l, c, h, d = 2, 128, 512, 8, 64\nx = torch.randn(b, l, c, generator=g)\nwq = torch.randn(h, d, c, generator=g) / math.sqrt(c)\nwk = torch.randn(h, d, c, generator=g) / math.sqrt(c)\nwv = torch.randn(h, d, c, generator=g) / math.sqrt(c)\n\ny0 = current_best(x, wq, wk, wv, 1.0, 5.0)\ny1 = opt_sdpa_fastpath(x, wq, wk, wv, 1.0, 5.0)\nprint(f'alpha=1.0 diff: {(y0-y1).abs().max():.2e}')\n\nt0 = benchmark_method(current_best, x, wq, wk, wv, 1.0, 5.0, n=100)\nt1 = benchmark_method(opt_sdpa_fastpath, x, wq, wk, wv, 1.0, 5.0, n=100)\nprint(f'alpha=1.0: base={t0/1e6:.3f}ms sdpa={t1/1e6:.3f}ms speedup={t0/t1:.3f}x')\n\n# But wait: F is torch.nn.functional. Is that allowed by the source guard?\n# The source guard checks imports - we'd need to import torch.nn.functional.\n# Let me check if that's allowed.\nimport ast\ntree = ast.parse(\\\"import torch.nn.functional\\\")\nfor node in ast.walk(tree):\n    if isinstance(node, (ast.Import, ast.ImportFrom)):\n        if isinstance(node, ast.ImportFrom):\n            print(f\\\"Import from: {node.module}\\\")\n        else:\n            for n in node.names:\n                parts = n.name.split(\\\".\\\")\n                print(f\\\"Import: {n.name}, first: {parts[0]}\\\")\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

me.process_time_ns() - t2) / 50\n\n# Alternative: batch matmul approach with x expanded\n# x_exp: (H, B*L, C), w_exp: (H, C, D) -> bmm -> (H, B*L, D)\nx_exp = xr.unsqueeze(0).expand(h, b*l, c).contiguous()\nw_2d = w.reshape(h*d, c)\nw_hcd = w  # (H, D, C), we need (H, C, D) for bmm\nw_hcd_t = w.transpose(-1, -2).contiguous()  # (H, C, D)\nfor _ in range(3):\n    y4 = torch.bmm(x_exp, w_hcd_t).permute(1, 0, 2).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\nt3 = time.process_time_ns()\nfor _ in range(50):\n    y4 = torch.bmm(x_exp, w_hcd_t).permute(1, 0, 2).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\nt3 = (time.process_time_ns() - t3) / 50\n\nprint(f'Current (2D matmul + permute): {t0/1e6:.3f}ms')\nprint(f'Einsum bhld:                 {t1/1e6:.3f}ms')\nprint(f'Per-head loop:               {t2/1e6:.3f}ms')\nprint(f'bmm (H batches):             {t3/1e6:.3f}ms')\nprint(f'Correctness (0 vs 1): {(y - y2).abs().max():.2e}')\nprint(f'Correctness (0 vs 3): {(y - y4).abs().max():.2e}')\nPYEOF\n\"","aggregated_output":"Current (2D matmul + permute): 16.931ms\nEinsum bhld:                 22.750ms\nPer-head loop:               16.555ms\nbmm (H batches):             23.425ms\nCorrectness (0 vs 1): 0.00e+00\nCorrectness (0 vs 3): 0.00e+00\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 << 'PYEOF'\nimport torch, time, math\ntorch.set_num_threads(1)\n\n# Per-head loop is slightly faster\"'! Let me investigate more.\n# For H=20, doing 20 separate matmuls vs 1 big one.\n# BLAS level-3 efficiency might be similar for these sizes.\n\nb, h, l, c, d = 1, 20, 256, 1280, 64\nx = torch.randn(b, l, c)\nw = torch.randn(h, d, c) / math.sqrt(c)\nxr = x.reshape(b*l, c)\nHD = h*d\n\n# Current: one big matmul\nw2d = w.reshape(HD, c).T.contiguous()  # (C, HD)\nfor _ in range(3):\n    y = xr @ w2d\n    y_out = y.reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\nt0 = time.process_time_ns()\nfor _ in range(100):\n    y = xr @ w2d\n    y_out = y.reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\nt0 = (time.process_time_ns() - t0) / 100\n\n# Per-head with pre-transposed weights\nw_pre = w.transpose(-1, -2).contiguous()  # (H, C, D)\nouts = [torch.empty(b*l, d) for _ in range(h)]\nfor _ in range(3):\n    for hi in range(h):\n        torch.mm(xr, w_pre[hi], out=outs[hi])\n    y2 = torch.stack(outs, dim=1).view(b, l, h, d).permute(0, 2, 1, 3).contiguous()\nt1 = time.process_time_ns()\nfor _ in range(100):\n    for hi in range(h):\n        torch.mm(xr, w_pre[hi], out=outs[hi])\n    y2 = torch.stack(outs, dim=1).view(b, l, h, d).permute(0, 2, 1, 3).contiguous()\nt1 = (time.process_time_ns() - t1) / 100\n\n# Per-head, no stack (direct output buffer)\nout_buf = torch.empty(b, h, l, d)\nout_2d = out_buf.view(h, b*l, d)  # (H, B*L, D)\nfor _ in range(3):\n    for hi in range(h):\n        out_2d[hi] = xr @ w_pre[hi]\nt2 = time.process_time_ns()\nfor _ in range(100):\n    for hi in range(h):\n        out_2d[hi] = xr @ w_pre[hi]\nt2 = (time.process_time_ns() - t2) / 100\n\nprint(f'\"'Big matmul + permute: {t0/1e6:.3f}ms')\nprint(f'Per-head + stack:     {t1/1e6:.3f}ms')\nprint(f'Per-head + buf write: {t2/1e6:.3f}ms')\nprint(f'Diff 0 vs 2: {(y_out - out_buf).abs().max():.2e}')\n\n# But wait - per-head requires Python loop overhead. Let me check for smaller H.\nfor h_val in [4, 8, 10, 16, 20, 32]:\n    w_h = torch.randn(h_val, d, c) / math.sqrt(c)\n    w_h_pre = w_h.transpose(-1, -2).contiguous()\n    w_h_2d = w_h.reshape(h_val*d, c).T.contiguous()\n    \n    t_a = time.process_time_ns()\n    for _ in range(100):\n        y = xr @ w_h_2d\n        y_out = y.reshape(b, l, h_val, d).permute(0, 2, 1, 3).contiguous()\n    t_a = (time.process_time_ns() - t_a) / 100\n    \n    t_b = time.process_time_ns()\n    for _ in range(100):\n        out = torch.empty(b, h_val, l, d)\n        out_v = out.view(h_val, b*l, d)\n        for hi in range(h_val):\n            out_v[hi] = xr @ w_h_pre[hi]\n    t_b = (time.process_time_ns() - t_b) / 100\n    \n    print(f'H={h_val:2d}: big={t_a/1e6:6.3f}ms per-head={t_b/1e6:6.3f}ms ratio={t_a/t_b:.3f}')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

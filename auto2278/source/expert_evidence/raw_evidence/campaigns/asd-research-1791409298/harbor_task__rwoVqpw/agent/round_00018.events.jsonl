{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\ntorch.set_num_threads(1)\n\nb, h, l, c, d = 1, 20, 256, 1280, 64\nx = torch.randn(b, l, c)\nwq = torch.randn(h, d, c) / math.sqrt(c)\nwk = torch.randn(h, d, c) / math.sqrt(c)\nwv = torch.randn(h, d, c) / math.sqrt(c)\nalpha, beta = 1.1, 3.0\ninv_sqrt_d = 1.0 / math.sqrt(d)\nHD = h * d\nBHL = b * h * l\nxr = x.reshape(b * l, c)\nwqr = wq.reshape(HD, c)\nwkr = wk.reshape(HD, c)\nwvr = wv.reshape(HD, c)\n\ndef current_best():\n    q = (xr @ wqr.T).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wkr.T).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wvr.T).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.view(BHL, l).softmax(dim=-1).view(b, h, l, l)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.view(BHL, l).softmax(dim=-1).view(b, h, l, l)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    p1G = p1 @ G_exp\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ndef v2_3d_approach():\n    # q shape after proj: (B*L, H*D) -> reshape to (B, L, H, D) -> permute -> (B, H, L, D)\n    q_4d = (xr @ wqr.T).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\n    k_4d = (xr @ wkr.T).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\n    v_4d = (xr @ wvr.T).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\n    \n    # Reshape to 3D for bmm\n    q = q_4d.view(BHL, l, d)\n    k = k_4d.view(BHL, l, d)\n    v = v_4d.view(BHL, l, d)\n    \n    logits = torch.bmm(q, k.transpose(-1, -2))\n    logits.mul_(inv_sqrt_d)\n    \n    p0 = logits.softmax(dim=-1)\n    \n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    \n    p_mix = torch.lerp(p0, p1, beta)\n    \n    # Gram in 3D: G is (B, L, L), expand to (B*H, L, L)\n    G = x @ x.transpose(-1, -2)  # (B, L, L)\n    G_bmm = G.unsqueeze(1).expand(b, h, l, l).reshape(BHL, l, l).contiguous()\n    \n    p0G = torch.bmm(p0, G_bmm)\n    p1G = torch.bmm(p1, G_bmm)\n    \n    norm0_sq = (p0G * p0).sum(dim=-1, keepdim=True)\n    norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n    cross = (p0G * p1).sum(dim=-1, keepdim=True)\n    \n    a0 = 1.0 - beta\n    normm_sq = a0*a0*norm0_sq + beta*beta*norm1_sq + 2*a0*beta*cross\n    \n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    \n    y = torch.bmm(p_mix, v).mul_(ratio)\n    return y.view(b, h, l, d).transpose(1, 2).flatten(2).contiguous()\n\n# Verify\ny0 = current_best()\ny2 = v2_3d_approach()\nprint(f'3D approach diff: {(y0-y2).abs().max():.6e}')\n\n# Benchmark\nimport time\nfor _ in range(3):\n    current_best()\n    v2_3d_approach()\n\nt0 = time.process_time_ns()\nfor _ in range(20):\n    current_best()\nt0 = (time.process_time_ns() - t0) / 20\n\nt2 = time.process_time_ns()\nfor _ in range(20):\n    v2_3d_approach()\nt2 = (time.process_time_ns() - t2) / 20\n\nprint(f'Current best: {t0/1e6:.3f}ms')\nprint(f'3D approach:  {t2/1e6:.3f}ms')\nprint(f'Speedup: {t0/t2:.3f}x')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

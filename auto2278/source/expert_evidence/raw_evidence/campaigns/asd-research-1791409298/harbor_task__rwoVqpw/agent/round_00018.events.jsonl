{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/sh -lc 'cd /workspace && python3 -c \"\nimport torch, time, math\ntorch.set_num_threads(1)\n\n# What if we skip the gram matrix entirely and compute u0, u1 norms more efficiently?\n# We need: norm(u1) and norm(u_mix)\n# u0 = p0 @ x, u1 = p1 @ x, u_mix = (1-b)*u0 + b*u1\n# norm_mix''^2 = (1-b)''^2 * norm0''^2 + b''^2 * norm1''^2 + 2*(1-b)*b * (u0 dot u1)\n# \n# If we have p0@G and p1@G, we can get:\n#   norm0''^2[i] = (p0@G)[i] dot p0[i]  = sum_j (p0@G)[i,j] * p0[i,j]\n#   norm1''^2[i] = (p1@G)[i] dot p1[i]\n#   cross[i] = (p0@G)[i] dot p1[i]\n# \n# But we still need 2 matmuls (p0@G and p1@G).\n# \n# Alternative: what about computing norms directly from the 2D matmul result?\n# We have logits already. Can we get norms from q,k?\n# ||p @ x||''^2 is not directly computable from q,k without the full p@G or p@x.\n#\n# Let me think about what else we can optimize.\n# \n# Idea: fuse p0 softmax with the logits scaling? logits.mul_ already done in-place.\n#\n# Idea: Can we compute p1_logits more efficiently? \n# p1_logits = a_p * A + a_m * A''^T = 0.5*(1+a)*A + 0.5*(1-a)*A''^T\n# = 0.5*(A + A''^T) + 0.5*a*(A - A''^T)\n# = symmetrized + a * anti-symmetrized\n# Not sure if that helps.\n#\n# Idea: Can we reuse p0 memory for p1 to avoid allocation?\n#\n# Idea: What if we use torch.float32 but compute softmax with better numerical stability?\n# Already using standard softmax.\n#\n# Let me try: combined matmul approach where we do all projections in one big matmul\nb, h, l, c, d = 1, 20, 256, 1280, 64\nx = torch.randn(b, l, c)\nwq = torch.randn(h, d, c) / math.sqrt(c)\nwk = torch.randn(h, d, c) / math.sqrt(c)\nwv = torch.randn(h, d, c) / math.sqrt(c)\n\nxr = x.reshape(b*l, c)\nwq2d = wq.reshape(h*d, c)\nwk2d = wk.reshape(h*d, c)\nwv2d = wv.reshape(h*d, c)\n\n# Separate projections\nfor _ in range(3):\n    q = xr @ wq2d.T\n    k = xr @ wk2d.T\n    v = xr @ wv2d.T\nt0 = time.process_time_ns()\nfor _ in range(30):\n    q = xr @ wq2d.T\n    k = xr @ wk2d.T\n    v = xr @ wv2d.T\nt0 = (time.process_time_ns() - t0) / 30\n\n# Combined: stack weights and do one big matmul\nw_all = torch.cat([wq2d, wk2d, wv2d], dim=0)  # (3*H*D, C)\nfor _ in range(3):\n    out = xr @ w_all.T\n    qc = out[:, :h*d]\n    kc = out[:, h*d:2*h*d]\n    vc = out[:, 2*h*d:]\nt1 = time.process_time_ns()\nfor _ in range(30):\n    out = xr @ w_all.T\n    qc = out[:, :h*d]\n    kc = out[:, h*d:2*h*d]\n    vc = out[:, 2*h*d:]\nt1 = (time.process_time_ns() - t1) / 30\n\nprint(f'\"'Separate projections: {t0/1e6:.3f}ms')\nprint(f'Combined projection:  {t1/1e6:.3f}ms')\nprint(f'Speedup: {t0/t1:.3f}x')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

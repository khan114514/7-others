{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 << 'PYEOF'\nimport torch, time, math\ntorch.set_num_threads(1)\n\n# 4D broadcast is fastest for gram matmul\"'! Good to know.\n# So the current approach with G_exp (broadcast) is already best.\n#\n# Let me now focus on optimizing the softmax more carefully,\n# and also see if we can fuse some operations.\n#\n# Let me try: compute both p0 and p1 logits from the same q,k, then softmax both together.\n# Also, let me try to see if there'\"'s a way to avoid computing the full q*k\"'^T matrix.\n#\n# Actually, let me try something different: the FlashAttention-style approach?\n# No, we can'\"'t implement custom CUDA kernels, and on CPU it's different.\n#\n# Let me look at the overall picture more carefully.\n# For the biggest case (B=1, L=256, C=1280, H=20, D=64):\n# Total: ~100ms\n# - Projections: ~50ms (q, k, v)\n# - Gram norms: ~28ms  \n# - Softmax: ~18ms (both p0 and p1)\n# - Everything else: ~4ms\n#\n# Let me see if we can save on projections by computing q and k together\n# (since both need x @ w\"'^T, we could concat wq and wk).\n# \n# Earlier test showed combined projection was slightly slower, but let me \n# also account for the permute overhead savings.\n\nb, h, l, c, d = 1, 20, 256, 1280, 64\nx = torch.randn(b, l, c)\nwq = torch.randn(h, d, c) / math.sqrt(c)\nwk = torch.randn(h, d, c) / math.sqrt(c)\nwv = torch.randn(h, d, c) / math.sqrt(c)\nxr = x.reshape(b*l, c)\nHD = h*d\n\n# Separate q and k projections + permute\nwq2d = wq.reshape(HD, c)\nwk2d = wk.reshape(HD, c)\nfor _ in range(5):\n    q = (xr @ wq2d.T).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk2d.T).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\nt0 = time.process_time_ns()\nfor _ in range(50):\n    q = (xr @ wq2d.T).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk2d.T).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\nt0 = (time.process_time_ns() - t0) / 50\n\n# Combined qk projection + split + permute\nwqk = torch.cat([wq2d, wk2d], dim=0)  # (2*HD, C)\nfor _ in range(5):\n    qk = xr @ wqk.T  # (B*L, 2*H*D)\n    qk_4d = qk.reshape(b, l, h, 2*d)\n    q_4d = qk_4d[..., :d].permute(0, 2, 1, 3).contiguous()\n    k_4d = qk_4d[..., d:].permute(0, 2, 1, 3).contiguous()\nt1 = time.process_time_ns()\nfor _ in range(50):\n    qk = xr @ wqk.T\n    qk_4d = qk.reshape(b, l, h, 2*d)\n    q_4d = qk_4d[..., :d].permute(0, 2, 1, 3).contiguous()\n    k_4d = qk_4d[..., d:].permute(0, 2, 1, 3).contiguous()\nt1 = (time.process_time_ns() - t1) / 50\n\nprint(f'\"'Separate q,k: {t0/1e6:.3f}ms')\nprint(f'Combined qk:  {t1/1e6:.3f}ms')\nprint(f'Ratio: {t0/t1:.3f}')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

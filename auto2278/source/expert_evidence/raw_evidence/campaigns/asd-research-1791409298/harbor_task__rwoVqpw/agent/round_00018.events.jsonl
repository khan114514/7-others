{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/sh -lc 'cd /workspace && python3 -c \"\nimport torch, time, math\ntorch.set_num_threads(1)\n\n# Benchmark components of current method\ndef profile_case(b, l, c, h, d):\n    x = torch.randn(b, l, c)\n    wq = torch.randn(h, d, c) / math.sqrt(c)\n    wk = torch.randn(h, d, c) / math.sqrt(c)\n    wv = torch.randn(h, d, c) / math.sqrt(c)\n    alpha, beta = 1.1, 3.0\n    inv_sqrt_d = 1.0 / math.sqrt(d)\n    HD = h * d\n    BHL = b * h * l\n    xr = x.reshape(b * l, c)\n    \n    # Warmup\n    for _ in range(3):\n        q = (xr @ wq.reshape(HD, c).T).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\n    \n    # Projection q\n    t0 = time.process_time_ns()\n    for _ in range(10):\n        q = (xr @ wq.reshape(HD, c).T).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\n    t_q = (time.process_time_ns() - t0) / 10\n    \n    # Projection k\n    t0 = time.process_time_ns()\n    for _ in range(10):\n        k = (xr @ wk.reshape(HD, c).T).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\n    t_k = (time.process_time_ns() - t0) / 10\n    \n    # Projection v\n    t0 = time.process_time_ns()\n    for _ in range(10):\n        v = (xr @ wv.reshape(HD, c).T).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\n    t_v = (time.process_time_ns() - t0) / 10\n    \n    q = (xr @ wq.reshape(HD, c).T).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, c).T).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, c).T).reshape(b, l, h, d).permute(0, 2, 1, 3).contiguous()\n    \n    # logits = q @ k''^T\n    t0 = time.process_time_ns()\n    for _ in range(10):\n        logits = q @ k.transpose(-1, -2)\n        logits.mul_(inv_sqrt_d)\n    t_logits = (time.process_time_ns() - t0) / 10\n    \n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    \n    # p0 softmax\n    t0 = time.process_time_ns()\n    for _ in range(10):\n        p0 = logits.view(BHL, l).softmax(dim=-1).view(b, h, l, l)\n    t_p0 = (time.process_time_ns() - t0) / 10\n    \n    # p1 softmax  \n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    t0 = time.process_time_ns()\n    for _ in range(10):\n        p1_logits = logits.mul(a_p)\n        p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n        p1 = p1_logits.view(BHL, l).softmax(dim=-1).view(b, h, l, l)\n    t_p1 = (time.process_time_ns() - t0) / 10\n    \n    p0 = logits.view(BHL, l).softmax(dim=-1).view(b, h, l, l)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.view(BHL, l).softmax(dim=-1).view(b, h, l, l)\n    \n    # p_mix\n    t0 = time.process_time_ns()\n    for _ in range(10):\n        p_mix = torch.lerp(p0, p1, beta)\n    t_pmix = (time.process_time_ns() - t0) / 10\n    \n    p_mix = torch.lerp(p0, p1, beta)\n    \n    # Gram + norms\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    t0 = time.process_time_ns()\n    for _ in range(10):\n        p1G = p1 @ G_exp\n        norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    t_norm = (time.process_time_ns() - t0) / 10\n    \n    # p_mix @ v\n    t0 = time.process_time_ns()\n    for _ in range(10):\n        y = (p_mix @ v)\n    t_pv = (time.process_time_ns() - t0) / 10\n    \n    total = t_q + t_k + t_v + t_logits + t_p0 + t_p1 + t_pmix + t_norm + t_pv\n    print(f'\"'Case B={b} L={l} C={c} H={h} D={d}')\n    print(f'  q_proj:   {t_q/1e6:.2f}ms ({t_q/total*100:.1f}%)')\n    print(f'  k_proj:   {t_k/1e6:.2f}ms ({t_k/total*100:.1f}%)')\n    print(f'  v_proj:   {t_v/1e6:.2f}ms ({t_v/total*100:.1f}%)')\n    print(f'  logits:   {t_logits/1e6:.2f}ms ({t_logits/total*100:.1f}%)')\n    print(f'  p0_softmax: {t_p0/1e6:.2f}ms ({t_p0/total*100:.1f}%)')\n    print(f'  p1_softmax: {t_p1/1e6:.2f}ms ({t_p1/total*100:.1f}%)')\n    print(f'  p_mix:    {t_pmix/1e6:.2f}ms ({t_pmix/total*100:.1f}%)')\n    print(f'  norm+gram:{t_norm/1e6:.2f}ms ({t_norm/total*100:.1f}%)')\n    print(f'  p_mix@v:  {t_pv/1e6:.2f}ms ({t_pv/total*100:.1f}%)')\n    print(f'  TOTAL:    {total/1e6:.2f}ms')\n    print()\n\nprofile_case(1, 64, 512, 8, 64)\nprofile_case(1, 256, 1280, 20, 64)\nprofile_case(2, 128, 512, 8, 64)\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_94","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 << 'PYEOF'\nimport torch, time, math\ntorch.set_num_threads(1)\n\n# F.linear is much faster\"'! Let me benchmark full end-to-end with F.linear.\n\nb, h, l, c, d = 1, 20, 256, 1280, 64\n\nimport torch.nn.functional as F\n\ndef benchmark_method(method, x, wq, wk, wv, alpha, beta, n=30):\n    for _ in range(3):\n        method(x, wq, wk, wv, alpha, beta)\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        method(x, wq, wk, wv, alpha, beta)\n    return (time.process_time_ns() - t0) / n\n\ndef current_best(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BHL = B * H * L\n    xr = x.reshape(B * L, C)\n    \n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    \n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    \n    if alpha == 1.0:\n        y = F.scaled_dot_product_attention(q, k, v, scale=inv_sqrt_d)\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1_logits = logits.mul(a_p)\n        p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n        p1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n        p_mix = torch.lerp(p0, p1, beta)\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        p1G = p1 @ G_exp\n        norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n        y = (p_mix @ v).mul_(ratio)\n    \n    return y.transpose(1, 2).flatten(2).contiguous()\n\ndef opt_flinear(x, wq, wk, wv, alpha, beta):\n    \"\"\"Use F.linear for all three projections.\"\"\"\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BHL = B * H * L\n    xr = x.reshape(B * L, C)\n    wq2d = wq.reshape(HD, C)\n    wk2d = wk.reshape(HD, C)\n    wv2d = wv.reshape(HD, C)\n    \n    q = F.linear(xr, wq2d).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = F.linear(xr, wk2d).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = F.linear(xr, wv2d).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    \n    if alpha == 1.0:\n        y = F.scaled_dot_product_attention(q, k, v, scale=inv_sqrt_d)\n    else:\n        logits = q @ k.transpose(-1, -2)\n        logits.mul_(inv_sqrt_d)\n        p0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1_logits = logits.mul(a_p)\n        p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n        p1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n        p_mix = torch.lerp(p0, p1, beta)\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        p1G = p1 @ G_exp\n        norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n        y = (p_mix @ v).mul_(ratio)\n    \n    return y.transpose(1, 2).flatten(2).contiguous()\n\ncases = [\n    (1, 64, 512, 8, 64, 1.05, 5.0),\n    (1, 128, 640, 10, 64, 1.1, 4.0),\n    (1, 128, 1280, 20, 64, 1.15, 3.0),\n    (1, 256, 1280, 20, 64, 1.05, 7.5),\n    (1, 256, 640, 10, 64, 1.2, 5.0),\n    (2, 128, 512, 8, 64, 1.0, 5.0),\n]\n\ng = torch.Generator().manual_seed(17)\nresults = []\nfor b, l, c, h, d, alpha, beta in cases:\n    x = torch.randn(b, l, c, generator=g)\n    wq = torch.randn(h, d, c, generator=g) / math.sqrt(c)\n    wk = torch.randn(h, d, c, generator=g) / math.sqrt(c)\n    wv = torch.randn(h, d, c, generator=g) / math.sqrt(c)\n    \n    y0 = current_best(x, wq, wk, wv, alpha, beta)\n    y1 = opt_flinear(x, wq, wk, wv, alpha, beta)\n    diff = (y0 - y1).abs().max()\n    \n    n = 60 if l <= 128 else 20\n    t0 = benchmark_method(current_best, x, wq, wk, wv, alpha, beta, n=n)\n    t1 = benchmark_method(opt_flinear, x, wq, wk, wv, alpha, beta, n=n)\n    \n    print(f'\"'B={b:1d} L={l:3d} C={c:4d} H={h:2d}: base={t0/1e6:7.3f}ms opt={t1/1e6:7.3f}ms spd={t0/t1:1.3f}x diff={diff:.2e}')\n    results.append((t0, t1))\n\navg_curr = sum(r[0] for r in results) / len(results)\navg_opt = sum(r[1] for r in results) / len(results)\nprint(f'\\\\nMean ratio: {avg_curr/avg_opt:.3f}x')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_94","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 << 'PYEOF'\nimport torch, time, math\ntorch.set_num_threads(1)\n\n# F.linear is much faster\"'! Let me benchmark full end-to-end with F.linear.\n\nb, h, l, c, d = 1, 20, 256, 1280, 64\n\nimport torch.nn.functional as F\n\ndef benchmark_method(method, x, wq, wk, wv, alpha, beta, n=30):\n    for _ in range(3):\n        method(x, wq, wk, wv, alpha, beta)\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        method(x, wq, wk, wv, alpha, beta)\n    return (time.process_time_ns() - t0) / n\n\ndef current_best(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BHL = B * H * L\n    xr = x.reshape(B * L, C)\n    \n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    \n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    \n    if alpha == 1.0:\n        y = F.scaled_dot_product_attention(q, k, v, scale=inv_sqrt_d)\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1_logits = logits.mul(a_p)\n        p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n        p1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n        p_mix = torch.lerp(p0, p1, beta)\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        p1G = p1 @ G_exp\n        norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n        y = (p_mix @ v).mul_(ratio)\n    \n    return y.transpose(1, 2).flatten(2).contiguous()\n\ndef opt_flinear(x, wq, wk, wv, alpha, beta):\n    \"\"\"Use F.linear for all three projections.\"\"\"\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BHL = B * H * L\n    xr = x.reshape(B * L, C)\n    wq2d = wq.reshape(HD, C)\n    wk2d = wk.reshape(HD, C)\n    wv2d = wv.reshape(HD, C)\n    \n    q = F.linear(xr, wq2d).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = F.linear(xr, wk2d).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = F.linear(xr, wv2d).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    \n    if alpha == 1.0:\n        y = F.scaled_dot_product_attention(q, k, v, scale=inv_sqrt_d)\n    else:\n        logits = q @ k.transpose(-1, -2)\n        logits.mul_(inv_sqrt_d)\n        p0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1_logits = logits.mul(a_p)\n        p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n        p1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n        p_mix = torch.lerp(p0, p1, beta)\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        p1G = p1 @ G_exp\n        norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n        y = (p_mix @ v).mul_(ratio)\n    \n    return y.transpose(1, 2).flatten(2).contiguous()\n\ncases = [\n    (1, 64, 512, 8, 64, 1.05, 5.0),\n    (1, 128, 640, 10, 64, 1.1, 4.0),\n    (1, 128, 1280, 20, 64, 1.15, 3.0),\n    (1, 256, 1280, 20, 64, 1.05, 7.5),\n    (1, 256, 640, 10, 64, 1.2, 5.0),\n    (2, 128, 512, 8, 64, 1.0, 5.0),\n]\n\ng = torch.Generator().manual_seed(17)\nresults = []\nfor b, l, c, h, d, alpha, beta in cases:\n    x = torch.randn(b, l, c, generator=g)\n    wq = torch.randn(h, d, c, generator=g) / math.sqrt(c)\n    wk = torch.randn(h, d, c, generator=g) / math.sqrt(c)\n    wv = torch.randn(h, d, c, generator=g) / math.sqrt(c)\n    \n    y0 = current_best(x, wq, wk, wv, alpha, beta)\n    y1 = opt_flinear(x, wq, wk, wv, alpha, beta)\n    diff = (y0 - y1).abs().max()\n    \n    n = 60 if l <= 128 else 20\n    t0 = benchmark_method(current_best, x, wq, wk, wv, alpha, beta, n=n)\n    t1 = benchmark_method(opt_flinear, x, wq, wk, wv, alpha, beta, n=n)\n    \n    print(f'\"'B={b:1d} L={l:3d} C={c:4d} H={h:2d}: base={t0/1e6:7.3f}ms opt={t1/1e6:7.3f}ms spd={t0/t1:1.3f}x diff={diff:.2e}')\n    results.append((t0, t1))\n\navg_curr = sum(r[0] for r in results) / len(results)\navg_opt = sum(r[1] for r in results) / len(results)\nprint(f'\\\\nMean ratio: {avg_curr/avg_opt:.3f}x')\nPYEOF\n\"","aggregated_output":"B=1 L= 64 C= 512 H= 8: base=  5.458ms opt= 12.216ms spd=0.447x diff=0.00e+00\nB=1 L=128 C= 640 H=10: base= 18.123ms opt= 17.505ms spd=1.035x diff=0.00e+00\nB=1 L=128 C=1280 H=20: base= 47.932ms opt= 43.778ms spd=1.095x diff=0.00e+00\nB=1 L=256 C=1280 H=20: base=128.374ms opt=106.088ms spd=1.210x diff=0.00e+00\nB=1 L=256 C= 640 H=10: base= 43.365ms opt= 56.888ms spd=0.762x diff=0.00e+00\nB=2 L=128 C= 512 H= 8: base= 15.925ms opt= 13.890ms spd=1.146x diff=0.00e+00\n\nMean ratio: 1.035x\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_95","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 << 'PYEOF'\nimport torch, time, math\ntorch.set_num_threads(1)\nimport torch.nn.functional as F\n\n# F.linear is very inconsistent across sizes.\n# Let me try: choose projection strategy based on size.\n# But also: the \\\"base\\\" measurement here includes SDPA for alpha=1.0 case.\n# Let me do a clean comparison for the non-alpha=1.0 case.\n\nb, h, l, c, d = 1, 20, 256, 1280, 64\nx = torch.randn(b, l, c)\nw = torch.randn(h, d, c) / math.sqrt(c)\nxr = x.reshape(b*l, c)\nHD = h*d\nw2d = w.reshape(HD, c)\n\n# Method 1: xr @ w2d.T\nfor _ in range(5):\n    y = xr @ w2d.T\nt0 = time.process_time_ns()\nfor _ in range(200):\n    y = xr @ w2d.T\nt0 = (time.process_time_ns() - t0) / 200\n\n# Method 2: F.linear\nfor _ in range(5):\n    y = F.linear(xr, w2d)\nt1 = time.process_time_ns()\nfor _ in range(200):\n    y = F.linear(xr, w2d)\nt1 = (time.process_time_ns() - t1) / 200\n\n# Method 3: torch.addmm style\nbias = torch.zeros(HD)\nfor _ in range(5):\n    y = torch.addmm(bias, xr, w2d.T)\nt2 = time.process_time_ns()\nfor _ in range(200):\n    y = torch.addmm(bias, xr, w2d.T)\nt2 = (time.process_time_ns() - t2) / 200\n\n# Method 4: torch.mm\nfor _ in range(5):\n    y = torch.mm(xr, w2d.T)\nt3 = time.process_time_ns()\nfor _ in range(200):\n    y = torch.mm(xr, w2d.T)\nt3 = (time.process_time_ns() - t3) / 200\n\nprint(f'Method 1 (@):    {t0/1e6:.3f}ms')\nprint(f'Method 2 (linear): {t1/1e6:.3f}ms')\nprint(f'Method 3 (addmm): {t2/1e6:.3f}ms')\nprint(f'Method 4 (mm):    {t3/1e6:.3f}ms')\nprint(f'Input: ({b*l}, {c}) @ ({c}, {HD})')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

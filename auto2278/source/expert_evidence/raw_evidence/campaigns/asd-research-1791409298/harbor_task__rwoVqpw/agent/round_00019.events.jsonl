{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 2, 256, 1280, 20, 64\nalpha, beta = 1.05, 5.0\n\ng = torch.Generator().manual_seed(17)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwv = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n\ninv_sqrt_d = 1.0 / math.sqrt(D)\nHD = H * D\nBHL = B * H * L\nxr = x.reshape(B * L, C)\n\ndef time_op(name, fn, n=11):\n    # warmup\n    fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    print(f'{name}: {(t1-t0)/n/1e6:.2f} ms')\n\n# Project q\ntime_op('q projection', lambda: (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous())\ntime_op('k projection', lambda: (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous())\ntime_op('v projection', lambda: (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous())\n\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nv = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\ntime_op('logits (q@k.T)', lambda: q @ k.transpose(-1, -2))\nlogits = q @ k.transpose(-1, -2)\nlogits.mul_(inv_sqrt_d)\n\ntime_op('p0 softmax (4D)', lambda: logits.softmax(dim=-1))\ntime_op('p0 softmax (2D view)', lambda: logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L))\np0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n\na_p = 0.5 * (1.0 + alpha)\na_m = 0.5 * (1.0 - alpha)\np1_logits = logits.mul(a_p)\np1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n\ntime_op('p1 softmax (2D view)', lambda: p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L))\np1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n\ntime_op('lerp p_mix', lambda: torch.lerp(p0, p1, beta))\np_mix = torch.lerp(p0, p1, beta)\n\n# Gram approach\ntime_op('G = x@x.T', lambda: x @ x.transpose(-1, -2))\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\n\ntime_op('p1 @ G_exp', lambda: p1 @ G_exp)\np1G = p1 @ G_exp\ntime_op('norm1_sq (p1G*p1 sum)', lambda: (p1G * p1).sum(dim=-1, keepdim=True))\n\ntime_op('p_mix @ G_exp', lambda: p_mix @ G_exp)\npmG = p_mix @ G_exp\ntime_op('normm_sq', lambda: (pmG * p_mix).sum(dim=-1, keepdim=True))\n\ntime_op('p_mix @ v', lambda: p_mix @ v)\npv = p_mix @ v\n\ntime_op('output transpose/flatten', lambda: pv.transpose(1, 2).flatten(2).contiguous())\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

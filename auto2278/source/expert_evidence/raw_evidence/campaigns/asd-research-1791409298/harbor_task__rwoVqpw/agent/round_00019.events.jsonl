{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\nimport torch.nn.functional as F\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 2, 256, 1280, 20, 64\nalpha, beta = 1.05, 5.0\ng = torch.Generator().manual_seed(17)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwv = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n\nHD = H * D\nBHL = B * H * L\ninv_sqrt_d = 1.0 / math.sqrt(D)\nBH = B * H\n\ndef time_it(fn, n=20):\n    fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    return (t1 - t0) / n / 1e6\n\n# Let me try F.linear for ALL 3 projections at once by concatenating weights\n# This is 1 big matmul vs 3 small ones\nw_all = torch.cat([wq.reshape(HD, C), wk.reshape(HD, C), wv.reshape(HD, C)], dim=0)\nxr = x.reshape(B * L, C)\n\ndef triple_proj_separate():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    return q, k, v\n\ndef triple_proj_combined():\n    out = xr @ w_all.T  # (B*L, 3*HD)\n    q = out[:, :HD].reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = out[:, HD:2*HD].reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = out[:, 2*HD:].reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    return q, k, v\n\ndef triple_proj_flinear():\n    out = F.linear(x, w_all)  # (B, L, 3*HD)\n    q = out[:, :, :HD].reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = out[:, :, HD:2*HD].reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = out[:, :, 2*HD:].reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    return q, k, v\n\nt_sep = time_it(triple_proj_separate)\nt_comb = time_it(triple_proj_combined)\nt_flin = time_it(triple_proj_flinear)\nprint(f'Separate projections: {t_sep:.2f} ms')\nprint(f'Combined (1 matmul):  {t_comb:.2f} ms')\nprint(f'F.linear combined:    {t_flin:.2f} ms')\n\n# Hmm wait earlier combined was slower... let me check again.\n# The issue might be memory layout.\n\n# Let me also try: compute q and k together since they're both used for logits\n# And v separately\nw_qk = torch.cat([wq.reshape(HD, C), wk.reshape(HD, C)], dim=0)\ndef qk_combined():\n    out = xr @ w_qk.T\n    q = out[:, :HD].reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = out[:, HD:].reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    return q, k\n\nt_qk = time_it(qk_combined)\nprint(f'Q+K combined: {t_qk:.2f} ms')\n\n# v alone\ndef v_only():\n    return (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\nt_v = time_it(v_only)\nprint(f'V only: {t_v:.2f} ms')\nprint(f'Q+K+V total (combined qk): {t_qk + t_v:.2f} ms')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

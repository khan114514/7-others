(BHL, L).softmax(dim=-1).view(B, H, L, L)\n\ntime_op('lerp p_mix', lambda: torch.lerp(p0, p1, beta))\np_mix = torch.lerp(p0, p1, beta)\n\n# Gram approach\ntime_op('G = x@x.T', lambda: x @ x.transpose(-1, -2))\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\n\ntime_op('p1 @ G_exp', lambda: p1 @ G_exp)\np1G = p1 @ G_exp\ntime_op('norm1_sq (p1G*p1 sum)', lambda: (p1G * p1).sum(dim=-1, keepdim=True))\n\ntime_op('p_mix @ G_exp', lambda: p_mix @ G_exp)\npmG = p_mix @ G_exp\ntime_op('normm_sq', lambda: (pmG * p_mix).sum(dim=-1, keepdim=True))\n\ntime_op('p_mix @ v', lambda: p_mix @ v)\npv = p_mix @ v\n\ntime_op('output transpose/flatten', lambda: pv.transpose(1, 2).flatten(2).contiguous())\n\\\"\n\"","aggregated_output":"q projection: 28.10 ms\nk projection: 27.99 ms\nv projection: 28.90 ms\nlogits (q@k.T): 7.78 ms\np0 softmax (4D): 14.28 ms\np0 softmax (2D view): 10.49 ms\np1 softmax (2D view): 14.96 ms\nlerp p_mix: 0.67 ms\nG = x@x.T: 7.75 ms\np1 @ G_exp: 26.59 ms\nnorm1_sq (p1G*p1 sum): 0.85 ms\np_mix @ G_exp: 25.37 ms\nnormm_sq: 1.25 ms\np_mix @ v: 7.02 ms\noutput transpose/flatten: 0.19 ms\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 2, 256, 1280, 20, 64\nalpha, beta = 1.05, 5.0\n\ng = torch.Generator().manual_seed(17)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwv = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n\n# Current approach (Gram) needs 2 matmuls: p1@G and pmix@G\n# But we could compute norm directly from p@x if we're already computing p@x for u0, u1\n\n# The starter computes u0 = p0@x, u1 = p1@x (in C-space, not D-space)\n# Then it computes modified = p1 @ x (to get norm)\n# And the final output needs (mix * ratio) @ wv\"'^T\n\n# Current v-space approach: projects to v first (v = x @ wv''^T)\n# Then p_mix @ v gives output directly\n# But norms need Gram approach\n\n# What if we do: compute norms in C-space with just p1@x (single matmul), \n# and do output via v-space?\n# Actually we need norms of u1 and m (= u0 + beta*(u1-u0))\n# u0 = p0@x, u1 = p1@x\n# We could compute p1@x (BHL*C ops) for u1 norm\n# And derive m norm from u0, u1, and cross term <u0, u1>\n\n# u0 = p0@x, u1 = p1@x\n# ||u0||''^2 = sum over rows of u0''^2 (cheap, just u0.pow(2).sum(-1))\n# ||u1||''^2 = u1.pow(2).sum(-1) (cheap)\n# <u0, u1> = (u0 * u1).sum(-1) (cheap)\n# ||m||''^2 = ||u0 + beta*(u1-u0)||''^2 = ||(1-beta)*u0 + beta*u1||''^2\n# = (1-beta)''^2*||u0||''^2 + beta''^2*||u1||''^2 + 2*(1-beta)*beta*<u0, u1>\n\n# So if we have u0 and u1 in C-space, we can compute all norms cheaply.\n# But we don'\"'t need u0 and u1 in C-space for the output.\n# We DO need p_mix @ v in D-space for output.\n\n# Cost comparison for the non-alpha path:\n# Current approach (v-space + Gram):\n#   - q, k, v projections: 3 * B*L*C * H*D (through BLAS)\n#   - q@k\"'^T: B*H*L*L*D\n#   - softmax x2: 2*BHL*L\n#   - p1@G: B*H*L*L*L\n#   - pmix@G: B*H*L*L*L\n#   - pmix@v: B*H*L*L*D\n\n# Alternative (C-space norms + v-space output):\n#   - q, k, v projections: 3 * B*L*C * H*D\n#   - q@k''^T: B*H*L*L*D\n#   - softmax x2: 2*BHL*L\n#   - p1@x (for u1): B*H*L*L*C\n#   - p0@x (for u0): B*H*L*L*C\n#   - pmix@v: B*H*L*L*D\n\n# Which is better? 2*BHL*L''^2 (Gram) vs 2*BHL*C (C-space)\n# For B=2,H=20,L=256,C=1280: 2*2*20*256*256*256 = 1.34B vs 2*2*20*256*256*1280 = 6.71B\n# So Gram is 5x fewer ops... but measured differently?\n\n# Wait let me actually time p1 @ x.unsqueeze(1)\nx_exp = x.unsqueeze(1)  # (B,1,L,C)\n\n# Create dummy p1\np1 = torch.randn(B, H, L, L)\np1 = p1.softmax(dim=-1)\n\ndef time_op(name, fn, n=11):\n    fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    print(f'\"'{name}: {(t1-t0)/n/1e6:.2f} ms')\n\ntime_op('p1 @ x (C-space)', lambda: p1 @ x_exp)\ntime_op('p0 @ x (C-space)', lambda: p1 @ x_exp)  # same cost\n\n# Gram approach\nG = x @ x.transpose(-1, -2)  # (B, L, L)\nG_exp = G.unsqueeze(1)\ntime_op('p1 @ G (Gram)', lambda: p1 @ G_exp)\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

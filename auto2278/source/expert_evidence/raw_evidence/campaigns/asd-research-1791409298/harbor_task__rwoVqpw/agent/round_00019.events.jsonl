{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 2, 256, 1280, 20, 64\nalpha, beta = 1.05, 5.0\ng = torch.Generator().manual_seed(17)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwv = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n\nHD = H * D\nBHL = B * H * L\ninv_sqrt_d = 1.0 / math.sqrt(D)\n\ndef time_it(fn, n=20):\n    fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    return (t1 - t0) / n / 1e6\n\n# Setup\nxr = x.reshape(B * L, C)\nwqr = wq.reshape(HD, C)\nwkr = wk.reshape(HD, C)\nwvr = wv.reshape(HD, C)\nq = (xr @ wqr.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wkr.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\nlogits = q @ k.transpose(-1, -2)\nlogits.mul_(inv_sqrt_d)\n\n# Two separate softmaxes\na_p = 0.5 * (1 + alpha)\na_m = 0.5 * (1 - alpha)\np1_logits = logits.mul(a_p)\np1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n\ndef two_separate_softmax():\n    p0 = logits.view(BHL, L).softmax(dim=-1)\n    p1 = p1_logits.view(BHL, L).softmax(dim=-1)\n    return p0, p1\n\ndef fused_softmax():\n    stacked = torch.cat([logits.view(BHL, L), p1_logits.view(BHL, L)], dim=0)\n    s = stacked.softmax(dim=-1)\n    return s[:BHL], s[BHL:]\n\nt_sep = time_it(two_separate_softmax)\nt_fused = time_it(fused_softmax)\nprint(f'Separate softmaxes: {t_sep:.2f} ms')\nprint(f'Fused softmax:      {t_fused:.2f} ms')\nprint(f'Speedup: {t_sep/t_fused:.3f}x')\n\n# Verify\np0a, p1a = two_separate_softmax()\np0b, p1b = fused_softmax()\nprint(f'p0 diff: {(p0a - p0b).abs().max():.2e}')\nprint(f'p1 diff: {(p1a - p1b).abs().max():.2e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

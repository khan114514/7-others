ftmax(dim=-1)\nG = torch.randn(B, L, L)\nG_exp = G.unsqueeze(1)\n\ntime_op('p @ G_exp (4D broadcast)', lambda: p @ G_exp)\n\n# Alternative: reshape p to (B*H, L, L), expand G to (B*H, L, L)\np_2d = p.reshape(B*H, L, L)\nG_expand = G.unsqueeze(1).expand(B, H, L, L).reshape(B*H, L, L)\ntime_op('p@G (reshaped 3D bmm)', lambda: torch.bmm(p_2d, G_expand))\ntime_op('p@G (reshaped 3D @)', lambda: p_2d @ G_expand)\n\n# Another idea: use einsum 'bhij,bjk->bhik'\ntime_op('p@G (einsum)', lambda: torch.einsum('bhij,bjk->bhik', p, G))\n\n# What about using the existing logits structure?\n# No, G is x@x.T which is different from logits.\n\\\"\n\"","aggregated_output":"p @ G_exp (4D broadcast): 27.28 ms\np@G (reshaped 3D bmm): 24.33 ms\np@G (reshaped 3D @): 24.65 ms\np@G (einsum): 24.83 ms\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 2, 256, 1280, 20, 64\ng = torch.Generator().manual_seed(17)\n\ndef time_op(name, fn, n=11):\n    fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    print(f'{name}: {(t1-t0)/n/1e6:.2f} ms')\n\n# Can we avoid one p@G? We need ||u1|| and ||m||.\n# m = u0 + beta*(u1-u0) = (1-b)*u0 + b*u1\n# ||m||\"'^2 = (1-b)''^2*||u0||''^2 + b''^2*||u1||''^2 + 2*b*(1-b)*<u0,u1>\n# We need <u0, u1> = (p0@x) dot (p1@x) per token.\n# = (p0 @ G) dot p1 per row = sum_j (p0 @ G)[i,j] * p1[i,j]\n# That'\"'s (p0 @ G) * p1 summed over last dim.\n# Still needs p0@G which is another matmul. No win.\n\n# Wait, what about this?\n# We compute pmix@G for ||m||. We need ||u1|| too.\n# ||u1|| = ||p1 @ x||, but p1 is independent of pmix.\n# Still need 2 matmuls (p1@G and pmix@G).\n\n# What if we compute norms differently?\n# u0 = p0 @ x. u0 has shape (B, H, L, C). \n# norm(u0, dim=-1) is cheap to compute once we have u0.\n# But computing u0 = p0 @ x is expensive (B*H*L*L*C ops).\n# Gram is cheaper (B*H*L*L*L ops when L < C, which it always is here).\n\n# Since L=256 and C=512-1280, L < C, so Gram is always cheaper.\n# Case with L=64, C=1280: 64 << 1280, huge win for Gram.\n\n# Let me try another approach: fused p@G + dot product for norm computation.\n# But we can't do fused ops easily in PyTorch.\n\n# Let me try: what if we combine both p1 and pmix into one batched matmul?\np1 = torch.randn(B, H, L, L)\np1 = p1.softmax(dim=-1)\npmix = torch.randn(B, H, L, L)\npmix = pmix.softmax(dim=-1)\nG = torch.randn(B, L, L)\n\n# Stack into (B, 2*H, L, L) and do one matmul\np_stacked = torch.cat([p1, pmix], dim=1)  # (B, 2H, L, L)\nG_exp = G.unsqueeze(1)  # (B, 1, L, L)\ntime_op('stacked p@G (one matmul)', lambda: p_stacked @ G_exp)\n\n# Separate\ntime_op('separate p1@G + pmix@G', lambda: (p1 @ G_exp, pmix @ G_exp))\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

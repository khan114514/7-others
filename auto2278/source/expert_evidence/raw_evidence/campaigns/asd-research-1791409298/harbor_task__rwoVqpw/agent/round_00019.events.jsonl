{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 2, 256, 1280, 20, 64\nalpha, beta = 1.05, 5.0\ng = torch.Generator().manual_seed(17)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n\nHD = H * D\nBHL = B * H * L\nBH = B * H\nxr = x.reshape(B * L, C)\nwqr = wq.reshape(HD, C)\n\ndef time_it(fn, n=20):\n    fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    return (t1 - t0) / n / 1e6\n\n# The negative overhead suggests caching effects. Let me be more careful.\nimport random\n\n# Warm up everything\nfor _ in range(5):\n    _ = xr @ wqr.T\n    torch.manual_seed(42)\n\n# Measure each separately with fresh memory\ndef measure_matmul_only():\n    w = torch.randn_like(wqr)\n    for _ in range(5):\n        _ = xr @ w.T\n    t0 = time.process_time_ns()\n    for _ in range(10):\n        _ = xr @ w.T\n    t1 = time.process_time_ns()\n    return (t1 - t0) / 10 / 1e6\n\ndef measure_full_pipeline():\n    w = torch.randn_like(wqr)\n    for _ in range(5):\n        _ = (xr @ w.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    t0 = time.process_time_ns()\n    for _ in range(10):\n        _ = (xr @ w.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    t1 = time.process_time_ns()\n    return (t1 - t0) / 10 / 1e6\n\n# Multiple runs\nfor i in range(3):\n    t1 = measure_matmul_only()\n    t2 = measure_full_pipeline()\n    print(f'Run {i}: matmul={t1:.2f}ms, full={t2:.2f}ms, diff={t2-t1:.2f}ms')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

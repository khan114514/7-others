{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 2, 256, 1280, 20, 64\nalpha, beta = 1.05, 5.0\ng = torch.Generator().manual_seed(17)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwv = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n\nHD = H * D\nBHL = B * H * L\ninv_sqrt_d = 1.0 / math.sqrt(D)\nBH = B * H\n\ndef time_it(fn, n=30):\n    fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    return (t1 - t0) / n / 1e6\n\nxr = x.reshape(B * L, C)\nwqr = wq.reshape(HD, C)\nwkr = wk.reshape(HD, C)\nwvr = wv.reshape(HD, C)\n\n# Measure permute cost\nt_matmul = time_it(lambda: xr @ wqr.T)\nt_with_perm = time_it(lambda: (xr @ wqr.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous())\nprint(f'Q: matmul={t_matmul:.2f}ms, total={t_with_perm:.2f}ms, overhead={t_with_perm - t_matmul:.2f}ms')\n\n# Can we avoid permuting v? p_mix @ v with v in (B, L, H, D) layout\np_mix = torch.randn(B, H, L, L).softmax(dim=-1)\nv_bhld = (xr @ wvr.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()  # (B, H, L, D)\nv_blhd = (xr @ wvr.T).reshape(B, L, H, D)  # (B, L, H, D) non-contiguous?\n\nt_pv_bhld = time_it(lambda: p_mix @ v_bhld)\nt_einsum = time_it(lambda: torch.einsum('bhij,bjhd->bhid', p_mix, v_blhd))\nprint(f'p@v (BHLD): {t_pv_bhld:.2f} ms')\nprint(f'einsum (BLHD): {t_einsum:.2f} ms')\n\n# What about working entirely in (B*H, L, D) layout?\nq_3d = torch.randn(BH, L, D)\nk_3d = torch.randn(BH, L, D)\nv_3d = torch.randn(BH, L, D)\n\n# Build q_3d from projection without permute\n# (B*L, HD) -> reshape to (B, L, H, D) -> need to get to (B*H, L, D)\n# This requires moving H from dim 2 to dim 0\n\n# Alternative approach: \n# q = (B*L, HD) = (B*L, H*D)\n# We want (B*H, L, D)\n# reshape(B, L, H, D) -> permute(0,2,1,3) -> reshape(BH, L, D)\n# This still needs the permute.\n\n# Let me check: is the permute really a big cost?\nt_reshape_only = time_it(lambda: (xr @ wqr.T).reshape(B, L, H, D))\nprint(f'Matmul + reshape (no perm): {t_reshape_only:.2f} ms')\nprint(f'Permute+contig overhead: {t_with_perm - t_reshape_only:.2f} ms')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

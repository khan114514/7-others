{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 2, 256, 1280, 20, 64\nalpha, beta = 1.05, 5.0\ng = torch.Generator().manual_seed(17)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwv = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n\nHD = H * D\nBHL = B * H * L\ninv_sqrt_d = 1.0 / math.sqrt(D)\n\ndef time_op(name, fn, n=11):\n    fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    print(f'{name}: {(t1-t0)/n/1e6:.2f} ms')\n\n# Additional optimizations to try:\n# 1. Fused p0 output with pmix@v (alpha=1 shortcut already handled)\n# 2. In-place operations on logits (avoid copying)\n# 3. Avoid contiguous() calls where possible\n\n# Let's test the new solution with more tweaks\ndef v2_solution():\n    xr = x.reshape(B * L, C)\n    wqr = wq.reshape(HD, C)\n    wkr = wk.reshape(HD, C)\n    wvr = wv.reshape(HD, C)\n    # Project all at once\n    q_out = xr @ wqr.T\n    k_out = xr @ wkr.T\n    v_out = xr @ wvr.T\n    q = q_out.reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = k_out.reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = v_out.reshape(B, L, H, D).permute(0, 2, 1, 3)\n    \n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    \n    p0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    \n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    \n    p1_logits = logits.clone().mul_(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    \n    p_mix = torch.lerp(p0, p1, beta)\n    \n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    \n    p_stacked = torch.cat([p1, p_mix], dim=1)\n    pG_stacked = p_stacked @ G_exp\n    p1G = pG_stacked[:, :H]\n    pmG = pG_stacked[:, H:]\n    \n    norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n    normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n    ratio = (norm1_sq.sqrt_().clamp_min_(1e-6) / normm_sq.sqrt_().clamp_min_(1e-6)).clamp_(0.25, 4.0)\n    \n    y = (p_mix @ v) * ratio\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ndef v1_solution():\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    p_stacked = torch.cat([p1, p_mix], dim=1)\n    pG_stacked = p_stacked @ G_exp\n    p1G = pG_stacked[:, :H]\n    pmG = pG_stacked[:, H:]\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ntime_op('v1 (stacked pG)', v1_solution)\ntime_op('v2 (fewer contiguous)', v2_solution)\n\ny1 = v1_solution()\ny2 = v2_solution()\nprint(f'Max error: {(y1 - y2).abs().max():.2e}')\n\n# Let's also check the alpha=1.0 fast path\nprint()\nprint('--- alpha=1.0 fast path ---')\nalpha1 = 1.0\ndef alpha1_solution():\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    y = p0 @ v\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Current fast path\nalpha1_curr = alpha1_solution()\ntime_op('alpha=1 fast path', alpha1_solution)\n\n# Can we use F.scaled_dot_product_attention?\nimport torch.nn.functional as F\ndef sdpa_solution():\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    y = F.scaled_dot_product_attention(q, k, v, scale=inv_sqrt_d)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ny_sdpa = sdpa_solution()\ntime_op('sdpa fast path', sdpa_solution)\nprint(f'SDPA vs manual max error: {(alpha1_curr - y_sdpa).abs().max():.2e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

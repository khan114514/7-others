{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\nimport torch.nn.functional as F\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 2, 256, 1280, 20, 64\nalpha, beta = 1.05, 5.0\ng = torch.Generator().manual_seed(17)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwv = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n\nHD = H * D\nBHL = B * H * L\ninv_sqrt_d = 1.0 / math.sqrt(D)\n\ndef time_op(name, fn, n=11):\n    fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    print(f'{name}: {(t1-t0)/n/1e6:.2f} ms')\n\n# Try another idea: can we compute G as float64 for precision? No, that would be slower.\n# What about using torch.baddbmm for p1_logits?\n\nlogits = torch.randn(B, H, L, L)\n\ndef p1_logits_way1():\n    pl = logits.mul(a_p)\n    pl.add_(logits.transpose(-1, -2), alpha=a_m)\n    return pl\n\ndef p1_logits_way2():\n    pl = a_p * logits + a_m * logits.transpose(-1, -2)\n    return pl\n\na_p = 0.5 * (1 + alpha)\na_m = 0.5 * (1 - alpha)\n\ntime_op('p1_logits way1 (mul+add_)', p1_logits_way1)\ntime_op('p1_logits way2 (direct)', p1_logits_way2)\n\n# Let me also try: do we need p0 in the alpha\"'!=1 path?\n# Yes, for p_mix = lerp(p0, p1, beta)\n# But we only need it for lerp... we could avoid p0 materialization.\n# Actually no, lerp needs it.\n\n# What if we compute p_mix directly from p0 formula?\n# p_mix = (1-beta)*p0 + beta*p1\n# p0 = softmax(A), p1 = softmax(a_p*A + a_m*A''^T)\n# No closed form.\n\n# Idea: compute both softmaxes in 2D-view but concatenated\n# Stack logits and p1_logits into (2*BHL, L) and do one softmax?\n# No, they'\"'re different matrices.\n\n# Biggest remaining cost: projections (3x ~28ms = ~84ms out of ~214ms = 39%)\n# Can we reduce projection cost? Not really, they're fundamental.\n# Unless we can avoid one of them.\n\n# Wait: do we need all three projections in the alpha\"'!=1 case?\n# q, k for logits -> yes\n# v for output -> yes\n# All three needed.\n\n# Let me check the smaller cases too\nfor case in [(1, 64, 512, 8, 64), (1, 128, 640, 10, 64), (2, 128, 512, 8, 64)]:\n    B2, L2, C2, H2, D2 = case\n    g2 = torch.Generator().manual_seed(42)\n    x2 = torch.randn(B2, L2, C2, generator=g2)\n    wq2 = torch.randn(H2, D2, C2, generator=g2) / math.sqrt(C2)\n    wk2 = torch.randn(H2, D2, C2, generator=g2) / math.sqrt(C2)\n    wv2 = torch.randn(H2, D2, C2, generator=g2) / math.sqrt(C2)\n    \n    HD2 = H2 * D2\n    BHL2 = B2 * H2 * L2\n    isd = 1.0 / math.sqrt(D2)\n    \n    def solve_vstacked():\n        xr2 = x2.reshape(B2 * L2, C2)\n        q2 = (xr2 @ wq2.reshape(HD2, C2).T).reshape(B2, L2, H2, D2).permute(0, 2, 1, 3).contiguous()\n        k2 = (xr2 @ wk2.reshape(HD2, C2).T).reshape(B2, L2, H2, D2).permute(0, 2, 1, 3).contiguous()\n        v2 = (xr2 @ wv2.reshape(HD2, C2).T).reshape(B2, L2, H2, D2).permute(0, 2, 1, 3).contiguous()\n        lg = q2 @ k2.transpose(-1, -2)\n        lg.mul_(isd)\n        p0_2 = lg.view(BHL2, L2).softmax(dim=-1).view(B2, H2, L2, L2)\n        if alpha == 1.0:\n            y2 = p0_2 @ v2\n        else:\n            ap2 = 0.5 * (1.0 + alpha)\n            am2 = 0.5 * (1.0 - alpha)\n            pl_lg = lg.mul(ap2)\n            pl_lg.add_(lg.transpose(-1, -2), alpha=am2)\n            p1_2 = pl_lg.view(BHL2, L2).softmax(dim=-1).view(B2, H2, L2, L2)\n            pmix_2 = torch.lerp(p0_2, p1_2, beta)\n            G2 = x2 @ x2.transpose(-1, -2)\n            p_stack2 = torch.cat([p1_2, pmix_2], dim=1)\n            pG2 = p_stack2 @ G2.unsqueeze(1)\n            n1sq2 = (pG2[:, :H2] * p1_2).sum(dim=-1, keepdim=True)\n            nmsq2 = (pG2[:, H2:] * pmix_2).sum(dim=-1, keepdim=True)\n            ratio2 = (n1sq2.sqrt_().clamp_min_(1e-6) / nmsq2.sqrt_().clamp_min_(1e-6)).clamp_(0.25, 4.0)\n            y2 = (pmix_2 @ v2).mul_(ratio2)\n        return y2.transpose(1, 2).flatten(2).contiguous()\n    \n    n = 20\n    solve_vstacked()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        solve_vstacked()\n    t1 = time.process_time_ns()\n    print(f'\"'Case {case}: {(t1-t0)/n/1e6:.2f} ms')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

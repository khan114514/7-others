{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 2, 256, 1280, 20, 64\nalpha, beta = 1.05, 5.0\ng = torch.Generator().manual_seed(17)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwv = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n\nHD = H * D\nBHL = B * H * L\ninv_sqrt_d = 1.0 / math.sqrt(D)\n\ndef time_op(name, fn, n=20):\n    fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    print(f'{name}: {(t1-t0)/n/1e6:.2f} ms')\n\n# Setup\nxr = x.reshape(B * L, C)\nwqr = wq.reshape(HD, C)\nwkr = wk.reshape(HD, C)\nwvr = wv.reshape(HD, C)\n\n# === Test 1: Projection variations ===\nprint('=== Projections ===')\ntime_op('separate q (matmul+permute+contig)', \n        lambda: (xr @ wqr.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous())\n\n# What if we precompute the reshaped weights? Not possible per-call, but what about F.linear?\nimport torch.nn.functional as F\ntime_op('F.linear + reshape', \n        lambda: F.linear(x, wqr).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous())\n\n# Try: do projections and then compute q@k\"'^T in the 2D layout\n# q shape (B*L, H*D) -> need to compute q_i * k_j for each head\n# This is tricky because q@k''^T is per-head.\n\n# === Test 2: logits computation ===\nprint()\nprint('\"'=== Logits ===')\nq = (xr @ wqr.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wkr.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nv = (xr @ wvr.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\ntime_op('q @ k.transpose(-1,-2)', lambda: q @ k.transpose(-1, -2))\n\n# Try batched 3D matmul\nq_3d = q.reshape(B*H, L, D)\nk_3d = k.reshape(B*H, L, D)\ntime_op('3D bmm q @ k.transpose', lambda: torch.bmm(q_3d, k_3d.transpose(-1, -2)))\n\nlogits = q @ k.transpose(-1, -2)\nlogits.mul_(inv_sqrt_d)\n\n# === Test 3: Softmax variations ===\nprint()\nprint('=== Softmax ===')\ntime_op('4D softmax', lambda: logits.softmax(dim=-1))\ntime_op('2D view softmax', lambda: logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L))\nlogits_3d = logits.reshape(B*H, L, L)\ntime_op('3D view softmax', lambda: logits_3d.softmax(dim=-1).view(B, H, L, L))\n\np0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n\n# === Test 4: p1_logits computation ===\nprint()\nprint('=== p1_logits ===')\na_p = 0.5 * (1 + alpha)\na_m = 0.5 * (1 - alpha)\n\ntime_op('mul + add_', lambda: logits.mul(a_p).add_(logits.transpose(-1, -2), alpha=a_m))\ntime_op('clone().mul_().add_()', lambda: logits.clone().mul_(a_p).add_(logits.transpose(-1, -2), alpha=a_m))\n\np1_logits = logits.mul(a_p)\np1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\np1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n\n# === Test 5: p_mix ===\nprint()\nprint('=== p_mix ===')\ntime_op('lerp', lambda: torch.lerp(p0, p1, beta))\ntime_op('(1-b)*p0 + b*p1', lambda: (1-beta)*p0 + beta*p1)\np_mix = torch.lerp(p0, p1, beta)\n\n# === Test 6: Gram + norms ===\nprint()\nprint('=== Gram norms ===')\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\n\ntime_op('p1 @ G_exp (4D)', lambda: p1 @ G_exp)\n\n# 3D batched version\np1_3d = p1.reshape(B*H, L, L)\nG_b = G.unsqueeze(1).expand(B, H, L, L).reshape(B*H, L, L)\ntime_op('3D bmm p1@G', lambda: torch.bmm(p1_3d, G_b))\ntime_op('3D matmul p1@G', lambda: p1_3d @ G_b)\n\n# Try: einsum\ntime_op('einsum bhi,bij->bhj', lambda: torch.einsum('bhij,bjk->bhik', p1, G))\n\n# Norm computation\np1G = p1 @ G_exp\ntime_op('p1G * p1 sum (in-place)', lambda: p1G.mul(p1).sum(dim=-1, keepdim=True))\ntime_op('(p1G * p1).sum', lambda: (p1G * p1).sum(dim=-1, keepdim=True))\n\n# === Test 7: p_mix @ v ===\nprint()\nprint('=== Output ===')\ntime_op('p_mix @ v', lambda: p_mix @ v)\npv = p_mix @ v\ntime_op('pv.transpose.flatten.contig', lambda: pv.transpose(1, 2).flatten(2).contiguous())\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

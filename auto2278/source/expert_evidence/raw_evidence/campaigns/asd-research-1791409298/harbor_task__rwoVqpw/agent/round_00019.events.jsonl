atten.contig', lambda: pv.transpose(1, 2).flatten(2).contiguous())\n\\\"\n\"","aggregated_output":"=== Projections ===\nseparate q (matmul+permute+contig): 33.73 ms\nF.linear + reshape: 31.23 ms\n\n=== Logits ===\nq @ k.transpose(-1,-2): 8.32 ms\n3D bmm q @ k.transpose: 6.63 ms\n\n=== Softmax ===\n4D softmax: 12.40 ms\n2D view softmax: 11.56 ms\n3D view softmax: 11.94 ms\n\n=== p1_logits ===\nmul + add_: 6.35 ms\nclone().mul_().add_(): 5.67 ms\n\n=== p_mix ===\nlerp: 0.72 ms\n(1-b)*p0 + b*p1: 4.01 ms\n\n=== Gram norms ===\np1 @ G_exp (4D): 25.25 ms\n3D bmm p1@G: 25.54 ms\n3D matmul p1@G: 25.45 ms\neinsum bhi,bij->bhj: 25.02 ms\np1G * p1 sum (in-place): 1.15 ms\n(p1G * p1).sum: 1.07 ms\n\n=== Output ===\np_mix @ v: 5.94 ms\npv.transpose.flatten.contig: 0.19 ms\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\nimport torch.nn.functional as F\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 2, 256, 1280, 20, 64\nalpha, beta = 1.05, 5.0\ng = torch.Generator().manual_seed(17)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwv = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n\nHD = H * D\nBHL = B * H * L\ninv_sqrt_d = 1.0 / math.sqrt(D)\nBH = B * H\n\n# Build an optimized version with all the small wins:\n# 1. F.linear for projections (31ms vs 34ms each, ~9% each)\n# 2. 3D bmm for logits (6.6ms vs 8.3ms, ~20%)\n# 3. clone().mul_().add_() for p1_logits (5.7ms vs 6.4ms, ~11%)\n# 4. 2D view softmax (already done)\n\ndef time_it(fn, n=20):\n    fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    return (t1 - t0) / n / 1e6\n\n# Baseline (current best)\ndef baseline():\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    p1G = p1 @ G_exp\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Optimized v2\ndef optimized_v2():\n    wqr = wq.reshape(HD, C)\n    wkr = wk.reshape(HD, C)\n    wvr = wv.reshape(HD, C)\n    \n    q = F.linear(x, wqr).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = F.linear(x, wkr).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = F.linear(x, wvr).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    \n    q_3d = q.reshape(BH, L, D)\n    k_3d = k.reshape(BH, L, D)\n    logits = torch.bmm(q_3d, k_3d.transpose(-1, -2)).view(B, H, L, L)\n    logits.mul_(inv_sqrt_d)\n    \n    p0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    \n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.clone().mul_(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    \n    p_mix = torch.lerp(p0, p1, beta)\n    \n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    p1G = p1 @ G_exp\n    norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n    ratio = (norm1_sq.sqrt_().clamp_min_(1e-6) / normm_sq.sqrt_().clamp_min_(1e-6)).clamp_(0.25, 4.0)\n    \n    y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\nt_baseline = time_it(baseline)\nt_v2 = time_it(optimized_v2)\nprint(f'Baseline: {t_baseline:.2f} ms')\nprint(f'V2:       {t_v2:.2f} ms')\nprint(f'Speedup:  {t_baseline/t_v2:.3f}x')\n\n# Verify correctness\ny_base = baseline()\ny_v2 = optimized_v2()\nprint(f'Max diff: {(y_base - y_v2).abs().max():.2e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

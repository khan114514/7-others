h('einsum bqhd,bkhd->bqhk', lambda: torch.einsum('bqhd,bkhd->bqhk', q_blhd, k_blhd))\nlogits_blhl = torch.einsum('bqhd,bkhd->bqhk', q_blhd, k_blhd)\nprint(f'logits_blhl shape: {logits_blhl.shape}, contiguous: {logits_blhl.is_contiguous()}')\n\n# softmax along last dim (k)\nbench('softmax BLHL', lambda: logits_blhl.softmax(dim=-1))\n\n# p @ v in BLHD\np_blhl = logits_blhl.softmax(dim=-1)\nbench('einsum blhk,bkhd->blhd (p@v)', lambda: torch.einsum('blhk,bkhd->blhd', p_blhl, v_blhd))\n\\\"\n\"","aggregated_output":"q_blhd contiguous: True\nq_bhld contiguous: True\nq_bhld @ k_bhld.T: 2.933 ms\neinsum blhd,bkhd->bhlk: 4.160 ms\neinsum output contiguous: True\nmatmul output contiguous: True\neinsum == matmul: 0.00e+00\n\np @ v_bhld: 3.295 ms\neinsum bhlk,bkhd->blhd: 2.943 ms\n\neinsum bqhd,bkhd->bqhk: 4.038 ms\nlogits_blhl shape: torch.Size([1, 256, 20, 256]), contiguous: False\nsoftmax BLHL: 14.163 ms\neinsum blhk,bkhd->blhd (p@v): 3.274 ms\n","exit_code":0,"status":"completed"}}

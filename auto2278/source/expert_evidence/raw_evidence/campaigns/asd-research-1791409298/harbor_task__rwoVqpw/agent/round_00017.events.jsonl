{"type":"item.started","item":{"id":"item_65","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch\nimport time\nimport math\nimport importlib.util\n\ntorch.set_num_threads(1)\n\n# Benchmark full optimized version across all cases\ncases = [\n    (1, 64, 512, 8, 64, 1.05, 5.0),\n    (1, 128, 640, 10, 64, 1.1, 4.0),\n    (1, 128, 1280, 20, 64, 1.15, 3.0),\n    (1, 256, 1280, 20, 64, 1.05, 7.5),\n    (1, 256, 640, 10, 64, 1.2, 5.0),\n    (2, 128, 512, 8, 64, 1.0, 5.0),\n]\n\n# Reference oracle\nspec = importlib.util.spec_from_file_location('ref', '/workspace/environment/starter/method.py')\nref = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(ref)\n\n# Optimized version\ndef attention_opt(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BH = B * H\n    BHL = BH * L\n    xr = x.reshape(B * L, C)\n\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n\n    p0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1_logits = logits.mul(a_p)\n        p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n        p1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n\n        p_mix = torch.lerp(p0, p1, beta)\n\n        G = x @ x.transpose(-1, -2)\n        G_3d = G.expand(BH, L, L)\n\n        p1_3d = p1.reshape(BH, L, L)\n        pm_3d = p_mix.reshape(BH, L, L)\n\n        p1G = torch.bmm(p1_3d, G_3d).reshape(B, H, L, L)\n        pmG = torch.bmm(pm_3d, G_3d).reshape(B, H, L, L)\n\n        norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n        normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n\n        y = (p_mix @ v).mul_(ratio)\n\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Check correctness\nall_ok = True\nfor i, (B, L, C, H, D, alpha, beta) in enumerate(cases):\n    g = torch.Generator().manual_seed(17 * 1009 + i)\n    x = torch.randn(B, L, C, generator=g)\n    wq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n    wk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n    wv = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n    \n    exp = ref.attention(x, wq, wk, wv, alpha, beta)\n    act = attention_opt(x, wq, wk, wv, alpha, beta)\n    \n    diff = (act - exp).abs()\n    tol = 3e-5 + 3e-4 * exp.abs()\n    passed = (diff <= tol).all().item()\n    all_ok = all_ok and passed\n    print(f'Case {i+1}: max_abs={diff.max():.2e}, passed={passed}')\n\nprint(f'All correct: {all_ok}')\nprint()\n\n# Benchmark\nprint('Benchmark (median of 7):')\nfor i, (B, L, C, H, D, alpha, beta) in enumerate(cases):\n    g = torch.Generator().manual_seed(42 + i)\n    x = torch.randn(B, L, C, generator=g)\n    wq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n    wk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n    wv = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n    \n    times = []\n    for _ in range(7):\n        t0 = time.process_time_ns()\n        attention_opt(x, wq, wk, wv, alpha, beta)\n        t1 = time.process_time_ns()\n        times.append((t1 - t0) / 1e6)\n    times.sort()\n    median = times[3]\n    print(f'  Case {i+1}: {median:.2f} ms')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

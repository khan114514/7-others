{"type":"item.started","item":{"id":"item_58","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch\nimport time\nimport math\n\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nHD = H * D\ninv_sqrt_d = 1.0 / math.sqrt(D)\n\nx = torch.randn(B, L, C)\nxr = x.reshape(B*L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\ndef bench(name, fn, n=15):\n    fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    print(f'{name}: {(t1-t0)/n/1e6:.3f} ms')\n\n# Let's get the shape right\n# wq shape: (H, D, C), reshape to (HD, C) where HD = H*D\n# First head: wq[0] = (D, C), second head: wq[1] = (D, C), etc.\n# wq.reshape(HD, C) has rows: h0d0, h0d1, ..., h0d(D-1), h1d0, ..., h(H-1)d(D-1)\n# \n# Fused weight: [wq_row0, wq_row1, ..., wq_row(HD-1), wk_row0, ..., wk_row(HD-1), wv_row0, ..., wv_row(HD-1)]\n# Output of xr @ w_all.T: (B*L, 3*HD)\n# Each row (token): q_h0d0, ..., q_h0d(D-1), q_h1d0, ..., q_h(H-1)d(D-1), k_h0..., v_h0...\n#\n# To get (B, L, H, D) per projection:\n# reshape (B*L, 3*HD) -> (B, L, 3, H, D) -> (3, B, H, L, D)\n# Wait: (B, L, 3, H, D) -> last dim D, then H, then 3, then L, then B\n# So we need (3, B, H, L, D) with 3 varying slowest...\n# Let's just verify the reshape path:\n\n# Separate (correct):\nq_sep = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\n# Fused approach:\nw_all = torch.cat([wq.reshape(HD, C), wk.reshape(HD, C), wv.reshape(HD, C)], dim=0)\nout = xr @ w_all.T  # (B*L, 3*HD)\n# Order of columns: q_h0d0..q_h0d(D-1), q_h1d0..., ..., q_h(H-1)d(D-1), k_h0..., v_h0...\n# Reshape to (B, L, 3, H, D) - let's check if this is correct\nout_reshaped = out.reshape(B, L, 3, H, D)\nq_fused_blhd = out_reshaped[:, :, 0, :, :]  # (B, L, H, D)\nq_fused_bhld = q_fused_blhd.permute(0, 2, 1, 3).contiguous()\nprint(f'q match: {(q_sep - q_fused_bhld).abs().max():.2e}')\n# Good, that was the mistake before - I used wrong reshape order.\n\n# Now time it\ndef fused_three_v2():\n    out = xr @ w_all.T  # (B*L, 3*HD)\n    out = out.reshape(B, L, 3, H, D).permute(2, 0, 3, 1, 4)  # (3, B, H, L, D)\n    # out is not contiguous, accessing slices will be slow\n    # Let's just contiguous each slice\n    q = out[0].contiguous()\n    k = out[1].contiguous()\n    v = out[2].contiguous()\n    return q, k, v\n\ndef three_separate():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    return q, k, v\n\nbench('3 separate projs', three_separate)\nbench('fused 3 projs v2', fused_three_v2)\n\nq3, k3, v3 = fused_three_v2()\nprint(f'q match: {(q_sep - q3).abs().max():.2e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

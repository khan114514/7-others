=True)\n            pmG = p_mix @ G_exp\n            normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n            norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n            normm = normm_sq.sqrt_().clamp_min_(1e-6)\n            ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n            y = (p_mix @ v).mul_(ratio)\n        return y.transpose(1, 2).flatten(2).contiguous()\n    \n    total = bench(full, n=5)\n    print(f'Case {i+1} (B={B},L={L},C={C},H={H},D={D},alpha={alpha}): {total:.2f} ms')\n\\\"\n\"","aggregated_output":"Case 1 (B=1,L=64,C=512,H=8,D=64,alpha=1.05): 3.87 ms\nCase 2 (B=1,L=128,C=640,H=10,D=64,alpha=1.1): 11.58 ms\nCase 3 (B=1,L=128,C=1280,H=20,D=64,alpha=1.15): 32.80 ms\nCase 4 (B=1,L=256,C=1280,H=20,D=64,alpha=1.05): 116.89 ms\nCase 5 (B=1,L=256,C=640,H=10,D=64,alpha=1.2): 39.26 ms\nCase 6 (B=2,L=128,C=512,H=8,D=64,alpha=1.0): 9.40 ms\n","exit_code":0,"status":"completed"}}

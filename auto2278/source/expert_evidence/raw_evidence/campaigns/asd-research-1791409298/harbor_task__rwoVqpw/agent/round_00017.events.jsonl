{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch\nimport time\nimport math\n\ntorch.set_num_threads(1)\n\n# Case 4 (largest): B=1, L=256, C=1280, H=20, D=64\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\n\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\ndef current_solution(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    xr = x.reshape(B * L, C)\n\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1_logits = logits.mul(a_p)\n        p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n        p1 = p1_logits.softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n\n        p1G = p1 @ G_exp\n        norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n\n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n\n        y = (p_mix @ v).mul_(ratio)\n\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Time full function\ndef bench(name, fn, n=10):\n    fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    print(f'{name}: {(t1-t0)/n/1e6:.2f} ms')\n\nbench('full current solution', lambda: current_solution(x, wq, wk, wv, alpha, beta))\n\n# Now let's profile each step\nB, L, C = x.shape\nH, D = wq.shape[0], wq.shape[1]\ninv_sqrt_d = 1.0 / math.sqrt(D)\nHD = H * D\nxr = x.reshape(B * L, C)\n\n# warmup\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nv = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nlogits = q @ k.transpose(-1, -2)\nlogits.mul_(inv_sqrt_d)\np0 = logits.softmax(dim=-1)\na_p = 0.5 * (1.0 + alpha)\na_m = 0.5 * (1.0 - alpha)\np1_logits = logits.mul(a_p)\np1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\np1 = p1_logits.softmax(dim=-1)\np_mix = torch.lerp(p0, p1, beta)\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\n\nprint()\nprint('Step breakdown:')\nbench('  3 projections', lambda: [\n    (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous(),\n    (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous(),\n    (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous(),\n])\nbench('  q@k\"'^T + scale'\"', lambda: (q @ k.transpose(-1, -2)).mul_(inv_sqrt_d))\nbench('  p0 softmax', lambda: logits.softmax(dim=-1))\nbench('  p1_logits compute', lambda: logits.mul(a_p).add_(logits.transpose(-1, -2), alpha=a_m))\nbench('  p1 softmax', lambda: p1_logits.softmax(dim=-1))\nbench('  p_mix lerp', lambda: torch.lerp(p0, p1, beta))\nbench('  Gram + p@G*2 + norms', lambda: None)  # combined\nbench('  Gram compute', lambda: x @ x.transpose(-1, -2))\nbench('  p1@G + norm', lambda: (p1 @ G_exp).mul_(p1).sum(dim=-1, keepdim=True))\nbench('  pmix@G + norm', lambda: (p_mix @ G_exp).mul_(p_mix).sum(dim=-1, keepdim=True))\nbench('  ratio + clamp', lambda: norm1_sq.sqrt_().clamp_min_(1e-6).div_(normm_sq.sqrt_().clamp_min_(1e-6)).clamp_(0.25, 4.0))\nbench('  pmix@v * ratio', lambda: (p_mix @ v).mul_(ratio))\nbench('  output transpose+flatten', lambda: y.transpose(1, 2).flatten(2).contiguous())\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch\nimport time\nimport math\n\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nHD = H * D\ninv_sqrt_d = 1.0 / math.sqrt(D)\nalpha, beta = 1.05, 7.5\na_p = 0.5 * (1 + alpha)\na_m = 0.5 * (1 - alpha)\n\nx = torch.randn(B, L, C)\nxr = x.reshape(B*L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\ndef bench(name, fn, n=15):\n    fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    print(f'{name}: {(t1-t0)/n/1e6:.3f} ms')\n\n# Setup\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nv = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nlogits = q @ k.transpose(-1, -2)\nlogits.mul_(inv_sqrt_d)\np0 = logits.view(-1, L).softmax(dim=-1).view(B, H, L, L)\np1_logits = logits.mul(a_p)\np1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\np1 = p1_logits.view(-1, L).softmax(dim=-1).view(B, H, L, L)\np_mix = torch.lerp(p0, p1, beta)\n\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\n\n# === IDEA: Can we do p1@G and pmix@G more efficiently? ===\n# Both are (B, H, L, L) @ (B, 1, L, L) broadcasting matmul\n# What if we compute them together? \n# Actually, what about: compute p_mix @ G as (1-beta)*(p0@G) + beta*(p1@G)?\n# Then we'd need p0@G too. Still 2 matmuls. No saving.\n\n# === IDEA: Can we replace p_mix @ v with a combination? ===\n# p_mix @ v = (1-beta)*(p0@v) + beta*(p1@v)\n# Same number of p@v matmuls. No.\n\n# === IDEA: What if we fuse the ratio multiplication into something? ===\n# (p_mix @ v) * ratio = ?\n# ratio is (B,H,L,1), p_mix@v is (B,H,L,D)\n# This is just a broadcast multiply, already very fast.\n\n# === IDEA: Can we compute both p1@G and pmix@G in one batched matmul? ===\n# Stack them: [p1; p_mix] @ G -> then split\nstacked = torch.empty(2*B, H, L, L)\n# Actually this is more memory and still same FLOPs.\n\n# === IDEA: Use torch.baddbmm or similar fused ops? ===\n# p_mix @ G is just bmm. Not much to fuse.\n\n# Let's check the output projection cost\n# y.transpose(1,2).flatten(2).contiguous()\ny = (p_mix @ v)\nbench('output transpose+flatten+contig', lambda: y.transpose(1, 2).flatten(2).contiguous())\n\n# What about: y.permute(0,2,1,3).reshape(B, L, H*D).contiguous()\nbench('output permute+reshape+contig', lambda: y.permute(0, 2, 1, 3).reshape(B, L, H*D).contiguous())\n\n# What if we just use transpose and reshape?\n# y is B,H,L,D contiguous -> transpose(1,2) -> B,L,H,D (non-contig) -> flatten(2) -> B,L,HD\nbench('output transpose+flatten', lambda: y.transpose(1, 2).flatten(2))\n# Hmm, flatten might force contiguous anyway\n\nprint()\n# === Let's check if v-space output projection can be optimized ===\n# Currently: y = (p_mix @ v) * ratio, then transpose+flatten\n# v was computed as x @ wv\"'^T (v-space)\n# What if we don'\"'t compute v at all, and instead do (p_mix @ x) @ wv\"'^T at the end?\n# That would be: pmix@x (B,H,L,C) then @ wv''^T (B,H,L,D)\n# Cost: pmix@x: B*H*L*L*C = 1.68B + pmix@x @ wv''^T: B*H*L*C*D = 840M\n# Total: 2.52B\n# Current: v proj: B*L*C*H*D = 420M + pmix@v: B*H*L*L*D = 168M = 588M\n# v-space is way better.\n\n# === NEW IDEA: Can we precompute q and k together? ===\n# q = x @ wq''^T, k = x @ wk''^T\n# If we stack wq and wk: [wq; wk] -> x @ [wq; wk]''^T = [q; k]\n# Then split into q and k.\nwqk = torch.cat([wq.reshape(HD, C), wk.reshape(HD, C)], dim=0)\nbench('\"'separate q,k projs', lambda: [\n    (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous(),\n    (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous(),\n])\nbench('fused qk proj', lambda: \n    (xr @ wqk.T).reshape(B, L, 2, H, D).permute(2, 0, 3, 1, 4)\n)\n\n# Let me check what the fused version gives\nfused = (xr @ wqk.T).reshape(B, L, 2, H, D).permute(2, 0, 3, 1, 4)\nprint(f'fused shape: {fused.shape}, contiguous: {fused.is_contiguous()}')\nq_fused = fused[0].contiguous()\nk_fused = fused[1].contiguous()\nprint(f'match q: {(q - q_fused).abs().max():.2e}')\nprint(f'match k: {(k - k_fused).abs().max():.2e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch\nimport time\nimport math\n\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nHD = H * D\ninv_sqrt_d = 1.0 / math.sqrt(D)\nalpha, beta = 1.05, 7.5\na_p = 0.5 * (1 + alpha)\na_m = 0.5 * (1 - alpha)\n\nx = torch.randn(B, L, C)\nxr = x.reshape(B*L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\ndef bench(name, fn, n=15):\n    fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    print(f'{name}: {(t1-t0)/n/1e6:.3f} ms')\n\n# Setup\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nv = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nlogits = q @ k.transpose(-1, -2)\nlogits.mul_(inv_sqrt_d)\np0 = logits.view(-1, L).softmax(dim=-1).view(B, H, L, L)\np1_logits = logits.mul(a_p)\np1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\np1 = p1_logits.view(-1, L).softmax(dim=-1).view(B, H, L, L)\np_mix = torch.lerp(p0, p1, beta)\n\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\n\n# === IDEA: Can we do p1@G and pmix@G more efficiently? ===\n# Both are (B, H, L, L) @ (B, 1, L, L) broadcasting matmul\n# What if we compute them together? \n# Actually, what about: compute p_mix @ G as (1-beta)*(p0@G) + beta*(p1@G)?\n# Then we'd need p0@G too. Still 2 matmuls. No saving.\n\n# === IDEA: Can we replace p_mix @ v with a combination? ===\n# p_mix @ v = (1-beta)*(p0@v) + beta*(p1@v)\n# Same number of p@v matmuls. No.\n\n# === IDEA: What if we fuse the ratio multiplication into something? ===\n# (p_mix @ v) * ratio = ?\n# ratio is (B,H,L,1), p_mix@v is (B,H,L,D)\n# This is just a broadcast multiply, already very fast.\n\n# === IDEA: Can we compute both p1@G and pmix@G in one batched matmul? ===\n# Stack them: [p1; p_mix] @ G -> then split\nstacked = torch.empty(2*B, H, L, L)\n# Actually this is more memory and still same FLOPs.\n\n# === IDEA: Use torch.baddbmm or similar fused ops? ===\n# p_mix @ G is just bmm. Not much to fuse.\n\n# Let's check the output projection cost\n# y.transpose(1,2).flatten(2).contiguous()\ny = (p_mix @ v)\nbench('output transpose+flatten+contig', lambda: y.transpose(1, 2).flatten(2).contiguous())\n\n# What about: y.permute(0,2,1,3).reshape(B, L, H*D).contiguous()\nbench('output permute+reshape+contig', lambda: y.permute(0, 2, 1, 3).reshape(B, L, H*D).contiguous())\n\n# What if we just use transpose and reshape?\n# y is B,H,L,D contiguous -> transpose(1,2) -> B,L,H,D (non-contig) -> flatten(2) -> B,L,HD\nbench('output transpose+flatten', lambda: y.transpose(1, 2).flatten(2))\n# Hmm, flatten might force contiguous anyway\n\nprint()\n# === Let's check if v-space output projection can be optimized ===\n# Currently: y = (p_mix @ v) * ratio, then transpose+flatten\n# v was computed as x @ wv\"'^T (v-space)\n# What if we don'\"'t compute v at all, and instead do (p_mix @ x) @ wv\"'^T at the end?\n# That would be: pmix@x (B,H,L,C) then @ wv''^T (B,H,L,D)\n# Cost: pmix@x: B*H*L*L*C = 1.68B + pmix@x @ wv''^T: B*H*L*C*D = 840M\n# Total: 2.52B\n# Current: v proj: B*L*C*H*D = 420M + pmix@v: B*H*L*L*D = 168M = 588M\n# v-space is way better.\n\n# === NEW IDEA: Can we precompute q and k together? ===\n# q = x @ wq''^T, k = x @ wk''^T\n# If we stack wq and wk: [wq; wk] -> x @ [wq; wk]''^T = [q; k]\n# Then split into q and k.\nwqk = torch.cat([wq.reshape(HD, C), wk.reshape(HD, C)], dim=0)\nbench('\"'separate q,k projs', lambda: [\n    (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous(),\n    (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous(),\n])\nbench('fused qk proj', lambda: \n    (xr @ wqk.T).reshape(B, L, 2, H, D).permute(2, 0, 3, 1, 4)\n)\n\n# Let me check what the fused version gives\nfused = (xr @ wqk.T).reshape(B, L, 2, H, D).permute(2, 0, 3, 1, 4)\nprint(f'fused shape: {fused.shape}, contiguous: {fused.is_contiguous()}')\nq_fused = fused[0].contiguous()\nk_fused = fused[1].contiguous()\nprint(f'match q: {(q - q_fused).abs().max():.2e}')\nprint(f'match k: {(k - k_fused).abs().max():.2e}')\n\\\"\n\"","aggregated_output":"output transpose+flatten+contig: 0.088 ms\noutput permute+reshape+contig: 0.088 ms\noutput transpose+flatten: 0.093 ms\n\nseparate q,k projs: 35.591 ms\nfused qk proj: 35.946 ms\nfused shape: torch.Size([2, 1, 20, 256, 64]), contiguous: False\nmatch q: 0.00e+00\nmatch k: 0.00e+00\n","exit_code":0,"status":"completed"}}

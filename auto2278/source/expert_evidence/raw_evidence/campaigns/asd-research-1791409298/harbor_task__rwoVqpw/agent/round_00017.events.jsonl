{"type":"item.started","item":{"id":"item_59","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch\nimport time\nimport math\n\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nHD = H * D\n\nx = torch.randn(B, L, C)\nxr = x.reshape(B*L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\ndef bench(name, fn, n=15):\n    fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    print(f'{name}: {(t1-t0)/n/1e6:.3f} ms')\n\n# The fused proj + permute is slow because of the 5D permute.\n# Let's try: fuse the matmul, but reshape to (B, H, L, D) differently.\nw_all = torch.cat([wq.reshape(HD, C), wk.reshape(HD, C), wv.reshape(HD, C)], dim=0)\n\n# Path: out (B*L, 3*HD) -> reshape (B, L, 3*H*D) -> ?\n# We want (B, 3*H, L, D) or (3*B, H, L, D)\n# Actually, if we want to avoid big permutations, what about:\n# out (B*L, 3*HD) -> (B, L, 3*H, D) -> permute(0,2,1,3) -> (B, 3H, L, D) contiguous\n# Then q = out[:, :H, :, :], k = out[:, H:2H, :, :], v = out[:, 2H:, :, :]\n# This saves 2 extra matmuls and reduces permute cost?\n\ndef fused_v3():\n    out = xr @ w_all.T  # (B*L, 3*HD)\n    out = out.reshape(B, L, 3*H, D).permute(0, 2, 1, 3).contiguous()\n    q = out[:, :H, :, :]\n    k = out[:, H:2*H, :, :]\n    v = out[:, 2*H:, :, :]\n    return q, k, v\n\ndef three_separate():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    return q, k, v\n\nbench('3 separate projs', three_separate)\nbench('fused v3 (3H heads)', fused_v3)\n\nq1, k1, v1 = three_separate()\nq2, k2, v2 = fused_v3()\nprint(f'q contiguous: {q2.is_contiguous()}, match: {(q1-q2).abs().max():.2e}')\nprint(f'k contiguous: {k2.is_contiguous()}, match: {(k1-
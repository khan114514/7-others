{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch\nimport math\nimport sys\nsys.path.insert(0, '/workspace/solution')\nfrom method import attention as candidate\n\nsys.path.insert(0, '/workspace/environment/starter')\n# rename\nimport importlib\nstarter_spec = importlib.util.spec_from_file_location('starter', '/workspace/environment/starter/method.py')\nstarter_mod = importlib.util.module_from_spec(starter_spec)\nstarter_spec.loader.exec_module(starter_mod)\noracle = starter_mod.attention\n\n# Test all cases\ncases = [\n    (1, 64, 512, 8, 64, 1.05, 5.0),\n    (1, 128, 640, 10, 64, 1.1, 4.0),\n    (1, 128, 1280, 20, 64, 1.15, 3.0),\n    (1, 256, 1280, 20, 64, 1.05, 7.5),\n    (1, 256, 640, 10, 64, 1.2, 5.0),\n    (2, 128, 512, 8, 64, 1.0, 5.0),\n]\n\ntorch.set_num_threads(1)\nfor i, (B, L, C, H, D, alpha, beta) in enumerate(cases):\n    g = torch.Generator().manual_seed(42)\n    x = torch.randn(B, L, C, generator=g)\n    wq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n    wk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n    wv = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n    \n    exp = oracle(x, wq, wk, wv, alpha, beta)\n    act = candidate(x, wq, wk, wv, alpha, beta)\n    \n    diff = (act - exp).abs()\n    max_abs = diff.max().item()\n    rel = diff / exp.abs().clamp_min(1e-8)\n    max_rel = rel.max().item()\n    \n    atol = 3e-5\n    rtol = 3e-4\n    passed = max_abs <= atol + rtol * exp.abs().max().item()\n    print(f'Case {i+1}: max_abs={max_abs:.2e}, max_rel={max_rel:.2e}, shape={act.shape}, passed={passed}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

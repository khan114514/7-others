{"type":"item.started","item":{"id":"item_86","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math, importlib.util\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nspec = importlib.util.spec_from_file_location('cand', '/workspace/solution/method.py')\ncand = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(cand)\n\nspec2 = importlib.util.spec_from_file_location('ref', '/workspace/environment/starter/method.py')\nref = importlib.util.module_from_spec(spec2)\nspec2.loader.exec_module(ref)\n\ncases = [(1,64,512,8,64,1.05,5.0),(1,128,640,10,64,1.1,4.0),(1,128,1280,20,64,1.15,3.0),\n         (1,256,1280,20,64,1.05,7.5),(1,256,640,10,64,1.2,5.0),(2,128,512,8,64,1.0,5.0)]\nfor i,(B,L,C,H,D,alpha,beta) in enumerate(cases):\n    g = torch.Generator().manual_seed(17*1009+i)\n    x = torch.randn(B,L,C,generator=g)\n    wq = torch.randn(H,D,C,generator=g)/math.sqrt(C)\n    wk = torch.randn(H,D,C,generator=g)/math.sqrt(C)\n    wv = torch.randn(H,D,C,generator=g)/math.sqrt(C)\n    exp = ref.attention(x,wq,wk,wv,alpha,beta)\n    act = cand.attention(x,wq,wk,wv,alpha,beta)\n    diff=(act-exp).abs(); tol=3e-5+3e-4*exp.abs()\n    print(f'Case {i+1}: max_abs={diff.max():.2e}, passed={(diff<=tol).all().item()}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_54","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch\nimport time\nimport math\n\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nHD = H * D\ninv_sqrt_d = 1.0 / math.sqrt(D)\nalpha, beta = 1.05, 7.5\na_p = 0.5 * (1 + alpha)\na_m = 0.5 * (1 - alpha)\n\nx = torch.randn(B, L, C)\nxr = x.reshape(B*L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\ndef bench(name, fn, n=15):\n    fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    print(f'{name}: {(t1-t0)/n/1e6:.3f} ms')\n\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nv = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\nlogits = q @ k.transpose(-1, -2)\nlogits.mul_(inv_sqrt_d)\np0 = logits.view(-1, L).softmax(dim=-1).view(B, H, L, L)\np1_logits = logits.mul(a_p)\np1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\np1 = p1_logits.view(-1, L).softmax(dim=-1).view(B, H, L, L)\np_mix = torch.lerp(p0, p1, beta)\n\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\n\n# === IDEA: Stack p1 and p_mix, do one matmul with expanded G ===\np_stack = torch.cat([p1, p_mix], dim=0)  # (2B, H, L, L)\nG_stack = G.expand(2*B, L, L).unsqueeze(1)  # (2B, 1, L, L)\n\ndef stacked_patG():\n    out = p_stack @ G_stack\n    return out[:B], out[B:]\n\ndef separate_patG():\n    return p1 @ G_exp, p_mix @ G_exp\n\nbench('separate p@G', separate_patG)\nbench('stacked p@G', stacked_patG)\n\n# Verify\na1, b1 = separate_patG()\na2, b2 = stacked_patG()\nprint(f'p1G match: {(a1-a2).abs().max():.2e}')\nprint(f'pmG match: {(b1-b2).abs().max():.2e}')\n\nprint()\n# === IDEA: Fuse both projections (q & k) into one matmul ===\nwqk = torch.cat([wq.reshape(HD, C), wk.reshape(HD, C)], dim=0)  # (2*HD, C)\n\ndef separate_qk():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    return q, k\n\ndef fused_qk():\n    out = xr @ wqk.T  # (B*L, 2*HD)\n    out = out.reshape(B, L, 2, H, D).permute(2, 0, 3, 1, 4).contiguous()\n    return out[0], out[1]\n\nbench('separate qk proj', separate_qk)\nbench('fused qk proj', fused_qk)\n\nq1, k1 = separate_qk()\nq2, k2 = fused_qk()\nprint(f'q match: {(q1-q2).abs().max():.2e}')\nprint(f'k match: {(k1-k2).abs().max():.2e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_63","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch\nimport time\nimport math\n\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nHD = H * D\ninv_sqrt_d = 1.0 / math.sqrt(D)\nalpha, beta = 1.05, 7.5\na_p = 0.5 * (1 + alpha)\na_m = 0.5 * (1 - alpha)\n\nx = torch.randn(B, L, C)\nxr = x.reshape(B*L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\ndef bench(name, fn, n=15):\n    fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    print(f'{name}: {(t1-t0)/n/1e6:.3f} ms')\n\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nv = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nlogits = q @ k.transpose(-1, -2)\nlogits.mul_(inv_sqrt_d)\np0 = logits.view(-1, L).softmax(dim=-1).view(B, H, L, L)\np1_logits = logits.mul(a_p)\np1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\np1 = p1_logits.view(-1, L).softmax(dim=-1).view(B, H, L, L)\np_mix = torch.lerp(p0, p1, beta)\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\n\n# Method 1: separate 4D broadcast (current)\ndef method1():\n    p1G = p1 @ G_exp\n    pmG = p_mix @ G_exp\n    return p1G, pmG\n\n# Method 2: cat + expand (stacked)\ndef method2():\n    p_stack = torch.cat([p1, p_mix], dim=0)  # (2B, H, L, L)\n    G_stack = G.expand(2*B, 1, L, L)  # (2B, 1, L, L) \n    pG_stack = p_stack @ G_stack\n    return pG_stack[:B], pG_stack[B:]\n\n# Method 3: cat on dim=2 (along L dim? no, that doesn't make sense for matmul)\n# Let's try stacking along a new dim\ndef method3():\n    # Both p1 and pmix are (B, H, L, L)\n    # Stack as (B, H, 2, L, L) - no, that breaks matmul\n    # Actually we can stack as (B, H*2, L, L) if we treat heads differently\n    # No, each p needs to multiply G independently.\n    pass\n\n# Method 4: use bmm with 3D tensors\ndef method4():\n    p1_3d = p1.reshape(B*H, L, L)\n    pm_3d = p_mix.reshape(B*H, L, L)\n    G_3d = G.expand(B*H, L, L)\n    p1G = torch.bmm(p1_3d, G_3d).reshape(B, H, L, L)\n    pmG = torch.bmm(pm_3d, G_3d).reshape(B, H, L, L)\n    return p1G, pmG\n\n# Method 5: stack both into (2*B*H, L, L) for bmm\ndef method5():\n    p_stacked = torch.cat([p1.reshape(B*H, L, L), p_mix.reshape(B*H, L, L)], dim=0)  # (2*B*H, L, L)\n    G_stacked = G.expand(2*B*H, L, L).contiguous()\n    out = torch.bmm(p_stacked, G_stacked)\n    return out[:B*H].reshape(B, H, L, L), out[B*H:].reshape(B, H, L, L)\n\nbench('method1 (separate 4D)', method1)\nbench('method2 (cat 2B 4D)', method2)\nbench('method4 (separate bmm)', method4)\nbench('method5 (stacked bmm)', method5)\n\n# Verify\na1, b1 = method1()\na2, b2 = method2()\na4, b4 = method4()\na5, b5 = method5()\nprint(f'method2 match: {(a1-a2).abs().max():.2e}, {(b1-b2).abs().max():.2e}')\nprint(f'method4 match: {(a1-a4).abs().max():.2e}, {(b1-b4).abs().max():.2e}')\nprint(f'method5 match: {(a1-a5).abs().max():.2e}, {(b1-b5).abs().max():.2e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

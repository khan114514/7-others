{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch\nimport time\nimport math\n\ntorch.set_num_threads(1)\n\n# Let me implement and test a v2 with the best ideas combined\n# Key ideas:\n# 1. 2D softmax via view/reshape \n# 2. Fuse p1_logits computation more efficiently\n# 3. Optimize the final output layout\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nHD = H * D\ninv_sqrt_d = 1.0 / math.sqrt(D)\nalpha, beta = 1.05, 7.5\na_p = 0.5 * (1 + alpha)\na_m = 0.5 * (1 - alpha)\n\nx = torch.randn(B, L, C)\nxr = x.reshape(B*L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\ndef bench(name, fn, n=10):\n    fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    print(f'{name}: {(t1-t0)/n/1e6:.3f} ms')\n\n# Reference (current solution)\ndef ref():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        p1_logits = logits.mul(a_p)\n        p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n        p1 = p1_logits.softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        p1G = p1 @ G_exp\n        norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n        y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Optimized v2\ndef opt_v2():\n    # Projections to BHLD\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    \n    # Attention logits\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    \n    if alpha == 1.0:\n        BHL = B * H * L\n        p0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n        y = p0 @ v\n    else:\n        BHL = B * H * L\n        # 2D softmax is faster\n        p0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n        \n        # p1 logits\n        # p1_logits = a_p * logits + a_m * logits\"'^T\n        p1_logits = logits.mul(a_p)\n        p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n        p1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n        \n        p_mix = torch.lerp(p0, p1, beta)\n        \n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        \n        p1G = p1 @ G_exp\n        norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n        y = (p_mix @ v).mul_(ratio)\n    \n    return y.transpose(1, 2).flatten(2).contiguous()\n\nbench('\"'reference', ref)\nbench('opt_v2 (2D softmax)', opt_v2)\n\ny_ref = ref()\ny_opt = opt_v2()\nprint(f'diff: {(y_ref - y_opt).abs().max():.2e}')\nprint()\n\n# Let me also try: compute p_mix @ v and ratio more efficiently\n# Can we compute ratio before p_mix @ v and fuse?\n# ratio is (B,H,L,1), p_mix @ v is (B,H,L,D)\n# (p_mix @ v) * ratio is just a broadcast multiply. Very cheap already.\n\n# Let me try: what if we compute p_mix @ v before the p@G stuff, \n# to overlap memory patterns? Probably not helpful in single-thread.\n\n# Let me think about a completely different structure.\n# What if we compute everything in BLHD layout (no permute of projections)?\n# \n# q: (B,L,H,D), k: (B,L,H,D), v: (B,L,H,D)\n# logits = einsum('bqhd,bkhd->bhlqk'... no)\n# Actually: for each head, q_h @ k_h\"'^T -> (B, L, L)\n# All heads: (B, H, L, L)\n# \n# einsum('\"'bqhd,bkhd->bhlk', q, k) gives (B,H,L,L)\n# But einsum is slower than matmul with BHLD layout.\n\n# What if we transpose q and k differently for the matmul?\n# q_blhd: (B, L, H, D) -> transpose(1,2) -> (B, H, L, D) [non-contiguous]\n# then @ k.transpose(1,2).transpose(-1,-2)\n# This is basically what we already do, just without .contiguous()\n# We saw non-contiguous q@k\"'^T is slower.\n\nprint('\"'Let me check the alpha=1.0 shortcut...')\n# Case 6 has alpha=1.0. Let's see how much we save.\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

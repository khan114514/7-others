{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch\nimport time\nimport math\n\ntorch.set_num_threads(1)\n\n# Case 4: biggest and most interesting\nB, L, C, H, D = 1, 256, 1280, 20, 64\nHD = H * D\n\nx = torch.randn(B, L, C)\nxr = x.reshape(B*L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\ndef bench(name, fn, n=20):\n    fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    print(f'{name}: {(t1-t0)/n/1e6:.3f} ms')\n\n# Current: 3 separate matmuls\ndef three_projs():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    return q, k, v\n\nbench('3 separate projs', three_projs)\n\n# Fused: one big matmul\nw_all = torch.cat([wq.reshape(HD, C), wk.reshape(HD, C), wv.reshape(HD, C)], dim=0)\ndef fused_proj():\n    out = xr @ w_all.T  # (B*L, 3*HD)\n    out = out.reshape(B, L, 3, H, D).permute(2, 0, 3, 1, 4).contiguous()\n    return out[0], out[1], out[2]\n\nbench('fused proj + reshape', fused_proj)\n\n# Fused proj with different reshape order\ndef fused_proj2():\n    out = xr @ w_all.T  # (B*L, 3*HD)\n    qkv = out.reshape(B, L, 3, H, D).permute(2, 0, 3, 1, 4)\n    return qkv[0].contiguous(), qkv[1].contiguous(), qkv[2].contiguous()\n\nbench('fused proj v2', fused_proj2)\n\n# What if we don't need contiguous?\n# Let's check if q@k\"'^T works with non-contiguous\nq_nc = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\nk_nc = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\nprint(f'\"'q_nc contiguous: {q_nc.is_contiguous()}')\nbench('q@k\"'^T non-contiguous'\"', lambda: q_nc @ k_nc.transpose(-1, -2))\n\nq_c = q_nc.contiguous()\nk_c = k_nc.contiguous()\nbench('q@k\"'^T contiguous'\"', lambda: q_c @ k_c.transpose(-1, -2))\n\nprint()\n# What about softmax with non-contiguous input?\nlogits_c = q_c @ k_c.transpose(-1, -2)\nlogits_nc = q_nc @ k_nc.transpose(-1, -2)\nprint(f'logits from contiguous: {logits_c.is_contiguous()}')\nprint(f'logits from non-contiguous: {logits_nc.is_contiguous()}')\nbench('softmax contiguous logits', lambda: logits_c.softmax(dim=-1))\nbench('softmax non-contiguous logits', lambda: logits_nc.softmax(dim=-1))\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

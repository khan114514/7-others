{"type":"item.started","item":{"id":"item_79","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch\nimport time\nimport math\n\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nHD = H * D\ninv_sqrt_d = 1.0 / math.sqrt(D)\nalpha, beta = 1.05, 7.5\na_p = 0.5 * (1 + alpha)\na_m = 0.5 * (1 - alpha)\n\nx = torch.randn(B, L, C)\nxr = x.reshape(B*L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\ndef bench(name, fn, n=10):\n    fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    print(f'{name}: {(t1-t0)/n/1e6:.2f} ms')\n\n# Let me check: what's the cost of all the reshaping, viewing, permuting?\n# Let's count the number of tensor allocations\n\n# Current approach (4D p@G with 2D softmax):\ndef current():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    BHL = B * H * L\n    p0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    p1G = p1 @ G_exp\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Let's try computing p_mix @ v first (smaller matmul D vs L), then norms\n# Might help with cache/ALU overlap\ndef alt_order():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    BHL = B * H * L\n    p0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    p_mix = torch.lerp(p0, p1, beta)\n    \n    # Compute pmix@v first (D=64, small)\n    pmv = p_mix @ v\n    \n    # Then compute norms (L=256, bigger)\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    p1G = p1 @ G_exp\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    y = pmv.mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\nbench('current', current)\nbench('alt order (pmv first)', alt_order)\n\ny1 = current()\ny2 = alt_order()\nprint(f'match: {(y1-y2).abs().max():.2e}')\n\nprint()\n\n# Let me check: can we compute G before the attention stuff?\n# G = x @ x\"'^T doesn'\"'t depend on attention at all.\n# But it's a small computation (3.6ms) and probably doesn't matter much.\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

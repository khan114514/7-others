{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch\nimport time\nimport math\n\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nHD = H * D\ninv_sqrt_d = 1.0 / math.sqrt(D)\n\nx = torch.randn(B, L, C)\nxr = x.reshape(B*L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\ndef bench(name, fn, n=20):\n    fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    print(f'{name}: {(t1-t0)/n/1e6:.3f} ms')\n\n# === IDEA: Compute projections to output (B, H, L, D) without explicit permute ===\n# What if we use view-as with stride tricks?\n# Actually, let's try computing directly in the right layout\n\n# Current: (B*L, C) @ (C, H*D) -> (B*L, H*D) \n# -> reshape (B, L, H, D) -> permute (0,2,1,3) -> contiguous (B, H, L, D)\n# \n# Alternative: Can we arrange the weight matrix so that matmul gives BH LD directly?\n# (B*L, C) @ (C, H*D) gives row-major (B*L) x (H*D)\n# That is, rows vary fastest in L, columns vary fastest in D\n# BH LD layout would have rows vary fastest in L too (within each head)\n# Actually no, BH LD contiguous means: memory order is B->H->L->D (D varies fastest)\n# BLHD contiguous means: memory order is B->L->H->D (D varies fastest)\n# \n# The output of (B*L, C) @ (C, H*D) is (B*L, H*D) = reshaped to (B, L, H, D)\n# This IS BLHD contiguous. We want BH LD. So we need to transpose H and L dims.\n# No way around that.\n\n# === IDEA: Can we skip contiguous for q and k? ===\n# q@k\"'^T produces contiguous output anyway.\nq_nc = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\nk_nc = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\nv_nc = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n\nq_c = q_nc.contiguous()\nk_c = k_nc.contiguous()\nv_c = v_nc.contiguous()\n\nprint(f'\"'q_nc contiguous: {q_nc.is_contiguous()}')\nprint(f'q stride: {q_nc.stride()}')\n\nbench('q@k\"'^T non-contig'\"', lambda: q_nc @ k_nc.transpose(-1, -2))\nbench('q@k\"'^T contiguous'\"', lambda: q_c @ k_c.transpose(-1, -2))\n\n# What about p @ v?\np = torch.randn(B, H, L, L)\nbench('p @ v_nc', lambda: p @ v_nc)\nbench('p @ v_c', lambda: p @ v_c)\n\nprint()\n\n# === IDEA: Fuse softmax reshape trick into the pipeline ===\nlogits = q_c @ k_c.transpose(-1, -2)\nlogits.mul_(inv_sqrt_d)\n\ndef fast_softmax(x):\n    s = x.shape\n    return x.reshape(-1, s[-1]).softmax(dim=-1).reshape(s)\n\nbench('native softmax (4D)', lambda: logits.softmax(dim=-1))\nbench('fast softmax (2D reshape)', lambda: fast_softmax(logits))\n\n# Output of fast_softmax is contiguous?\nout = fast_softmax(logits)\nprint(f'fast_softmax output contiguous: {out.is_contiguous()}')\n\nprint()\n\n# === IDEA: p_mix computed as lerp, does it need contiguous for p@G and p@v? ===\np0 = logits.softmax(dim=-1)\np1_logits = logits * 0.5 * (1 + 1.05) + logits.transpose(-1, -2) * 0.5 * (1 - 1.05)\np1 = p1_logits.softmax(dim=-1)\n\np_mix_lerp = torch.lerp(p0, p1, 7.5)\np_mix_add = (1 - 7.5) * p0 + 7.5 * p1\n\nbench('lerp', lambda: torch.lerp(p0, p1, 7.5))\nbench('add (1-b)*p0 + b*p1', lambda: (1 - 7.5) * p0 + 7.5 * p1)\n\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\n\nbench('p_mix_lerp @ G', lambda: p_mix_lerp @ G_exp)\nbench('p_mix_add @ G', lambda: p_mix_add @ G_exp)\nbench('p_mix_lerp.contiguous() @ G', lambda: p_mix_lerp.contiguous() @ G_exp)\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch\nimport time\nimport math\n\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nHD = H * D\ninv_sqrt_d = 1.0 / math.sqrt(D)\n\nx = torch.randn(B, L, C)\nxr = x.reshape(B*L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\ndef bench(name, fn, n=20):\n    fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    print(f'{name}: {(t1-t0)/n/1e6:.3f} ms')\n\n# === IDEA: Compute projections to output (B, H, L, D) without explicit permute ===\n# What if we use view-as with stride tricks?\n# Actually, let's try computing directly in the right layout\n\n# Current: (B*L, C) @ (C, H*D) -> (B*L, H*D) \n# -> reshape (B, L, H, D) -> permute (0,2,1,3) -> contiguous (B, H, L, D)\n# \n# Alternative: Can we arrange the weight matrix so that matmul gives BH LD directly?\n# (B*L, C) @ (C, H*D) gives row-major (B*L) x (H*D)\n# That is, rows vary fastest in L, columns vary fastest in D\n# BH LD layout would have rows vary fastest in L too (within each head)\n# Actually no, BH LD contiguous means: memory order is B->H->L->D (D varies fastest)\n# BLHD contiguous means: memory order is B->L->H->D (D varies fastest)\n# \n# The output of (B*L, C) @ (C, H*D) is (B*L, H*D) = reshaped to (B, L, H, D)\n# This IS BLHD contiguous. We want BH LD. So we need to transpose H and L dims.\n# No way around that.\n\n# === IDEA: Can we skip contiguous for q and k? ===\n# q@k\"'^T produces contiguous output anyway.\nq_nc = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\nk_nc = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\nv_nc = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n\nq_c = q_nc.contiguous()\nk_c = k_nc.contiguous()\nv_c = v_nc.contiguous()\n\nprint(f'\"'q_nc contiguous: {q_nc.is_contiguous()}')\nprint(f'q stride: {q_nc.stride()}')\n\nbench('q@k\"'^T non-contig'\"', lambda: q_nc @ k_nc.transpose(-1, -2))\nbench('q@k\"'^T contiguous'\"', lambda: q_c @ k_c.transpose(-1, -2))\n\n# What about p @ v?\np = torch.randn(B, H, L, L)\nbench('p @ v_nc', lambda: p @ v_nc)\nbench('p @ v_c', lambda: p @ v_c)\n\nprint()\n\n# === IDEA: Fuse softmax reshape trick into the pipeline ===\nlogits = q_c @ k_c.transpose(-1, -2)\nlogits.mul_(inv_sqrt_d)\n\ndef fast_softmax(x):\n    s = x.shape\n    return x.reshape(-1, s[-1]).softmax(dim=-1).reshape(s)\n\nbench('native softmax (4D)', lambda: logits.softmax(dim=-1))\nbench('fast softmax (2D reshape)', lambda: fast_softmax(logits))\n\n# Output of fast_softmax is contiguous?\nout = fast_softmax(logits)\nprint(f'fast_softmax output contiguous: {out.is_contiguous()}')\n\nprint()\n\n# === IDEA: p_mix computed as lerp, does it need contiguous for p@G and p@v? ===\np0 = logits.softmax(dim=-1)\np1_logits = logits * 0.5 * (1 + 1.05) + logits.transpose(-1, -2) * 0.5 * (1 - 1.05)\np1 = p1_logits.softmax(dim=-1)\n\np_mix_lerp = torch.lerp(p0, p1, 7.5)\np_mix_add = (1 - 7.5) * p0 + 7.5 * p1\n\nbench('lerp', lambda: torch.lerp(p0, p1, 7.5))\nbench('add (1-b)*p0 + b*p1', lambda: (1 - 7.5) * p0 + 7.5 * p1)\n\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\n\nbench('p_mix_lerp @ G', lambda: p_mix_lerp @ G_exp)\nbench('p_mix_add @ G', lambda: p_mix_add @ G_exp)\nbench('p_mix_lerp.contiguous() @ G', lambda: p_mix_lerp.contiguous() @ G_exp)\n\\\"\n\"","aggregated_output":"q_nc contiguous: False\nq stride: (327680, 64, 1280, 1)\nq@k^T non-contig: 3.945 ms\nq@k^T contiguous: 2.857 ms\np @ v_nc: 3.153 ms\np @ v_c: 5.030 ms\n\nnative softmax (4D): 13.975 ms\nfast softmax (2D reshape): 15.847 ms\nfast_softmax output contiguous: True\n\nlerp: 0.330 ms\nadd (1-b)*p0 + b*p1: 0.847 ms\np_mix_lerp @ G: 12.312 ms\np_mix_add @ G: 16.121 ms\np_mix_lerp.contiguous() @ G: 12.276 ms\n","exit_code":0,"status":"completed"}}

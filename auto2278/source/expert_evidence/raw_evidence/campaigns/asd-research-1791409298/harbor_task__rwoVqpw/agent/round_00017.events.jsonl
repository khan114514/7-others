{"type":"item.started","item":{"id":"item_75","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch\nimport time\nimport math\n\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nHD = H * D\nBH = B * H\nalpha, beta = 1.05, 7.5\n\nx = torch.randn(B, L, C)\np1 = torch.randn(B, H, L, L).softmax(dim=-1)\np_mix = torch.randn(B, H, L, L).softmax(dim=-1)\nG = x @ x.transpose(-1, -2)\n\ndef bench(name, fn, n=20):\n    fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    print(f'{name}: {(t1-t0)/n/1e6:.3f} ms')\n\n# Separate bmm (current)\ndef sep_bmm():\n    G_3d = G.expand(BH, L, L)\n    p1G = torch.bmm(p1.reshape(BH, L, L), G_3d).reshape(B, H, L, L)\n    pmG = torch.bmm(p_mix.reshape(BH, L, L), G_3d).reshape(B, H, L, L)\n    return p1G, pmG\n\n# Stacked bmm: concatenate p1 and pmix along batch dim\ndef stacked_bmm():\n    p_stacked = torch.cat([p1.reshape(BH, L, L), p_mix.reshape(BH, L, L)], dim=0)\n    G_stacked = G.expand(2*BH, L, L)\n    out = torch.bmm(p_stacked, G_stacked)\n    p1G = out[:BH].reshape(B, H, L, L)\n    pmG = out[BH:].reshape(B, H, L, L)\n    return p1G, pmG\n\n# 4D broadcast (original)\ndef broadcast_4d():\n    G_exp = G.unsqueeze(1)\n    p1G = p1 @ G_exp\n    pmG = p_mix @ G_exp\n    return p1G, pmG\n\nbench('separate bmm', sep_bmm)\nbench('stacked bmm', stacked_bmm)\nbench('4D broadcast', broadcast_4d)\n\n# Verify\na1, b1 = sep_bmm()\na2, b2 = stacked_bmm()\na3, b3 = broadcast_4d()\nprint(f'stacked == sep: {(a1-a2).abs().max():.2e}, {(b1-b2).abs().max():.2e}')\nprint(f'4d == sep: {(a1-a3).abs().max():.2e}, {(b1-b3).abs().max():.2e}')\n\nprint()\n# Try: pre-allocate G expanded\nG_expanded = G.expand(BH, L, L).contiguous()\ndef sep_bmm_pre():\n    p1G = torch.bmm(p1.reshape(BH, L, L), G_expanded).reshape(B, H, L, L)\n    pmG = torch.bmm(p_mix.reshape(BH, L, L), G_expanded).reshape(B, H, L, L)\n    return p1G, pmG\nbench('sep bmm (pre-expanded G)', sep_bmm_pre)\n\nprint()\n# What about the reshape overhead?\np1_flat = p1.reshape(BH, L, L).contiguous()\npm_flat = p_mix.reshape(BH, L, L).contiguous()\ndef bmm_preflat():\n    p1G = torch.bmm(p1_flat, G_expanded)\n    pmG = torch.bmm(pm_flat, G_expanded)\n    return p1G, pmG\nbench('bmm (pre-flattened p)', bmm_preflat)\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

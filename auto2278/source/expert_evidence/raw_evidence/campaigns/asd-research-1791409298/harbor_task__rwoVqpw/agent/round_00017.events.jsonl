'einsum bqhd,bkhd->bqhk', lambda: torch.einsum('bqhd,bkhd->bqhk', q_blhd, k_blhd))\nlogits_blhl = torch.einsum('bqhd,bkhd->bqhk', q_blhd, k_blhd)\nprint(f'logits_blhl shape: {logits_blhl.shape}, contiguous: {logits_blhl.is_contiguous()}')\n\n# softmax along last dim (k)\nbench('softmax BLHL', lambda: logits_blhl.softmax(dim=-1))\n\n# p @ v in BLHD\np_blhl = logits_blhl.softmax(dim=-1)\nbench('einsum blhk,bkhd->blhd (p@v)', lambda: torch.einsum('blhk,bkhd->blhd', p_blhl, v_blhd))\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

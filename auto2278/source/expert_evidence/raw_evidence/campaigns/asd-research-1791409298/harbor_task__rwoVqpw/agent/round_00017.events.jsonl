{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch\nimport time\nimport math\n\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nHD = H * D\ninv_sqrt_d = 1.0 / math.sqrt(D)\nalpha, beta = 1.05, 7.5\n\nx = torch.randn(B, L, C)\nxr = x.reshape(B*L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nv = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\nlogits = q @ k.transpose(-1, -2)\nlogits.mul_(inv_sqrt_d)\np0 = logits.softmax(dim=-1)\n\na_p = 0.5 * (1 + alpha)\na_m = 0.5 * (1 - alpha)\np1_logits = logits.mul(a_p)\np1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\np1 = p1_logits.softmax(dim=-1)\np_mix = torch.lerp(p0, p1, beta)\n\nG = x @ x.transpose(-1, -2)\n\ndef bench(name, fn, n=20):\n    fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    print(f'{name}: {(t1-t0)/n/1e6:.3f} ms')\n\n# Compare: 4D broadcast vs bmm\nG_exp = G.unsqueeze(1)\n\n# 4D approach\np1G_4d = p1 @ G_exp\nnorm1_4d = (p1G_4d * p1).sum(dim=-1, keepdim=True)\npmG_4d = p_mix @ G_exp\nnormm_4d = (pmG_4d * p_mix).sum(dim=-1, keepdim=True)\n\n# bmm approach\np1_3d = p1.reshape(B*H, L, L)\npm_3d = p_mix.reshape(B*H, L, L)\nG_3d = G.expand(B*H, L, L).contiguous()\n\np1G_bmm = torch.bmm(p1_3d, G_3d).reshape(B, H, L, L)\nnorm1_bmm = (p1G_bmm * p1).sum(dim=-1, keepdim=True)\npmG_bmm = torch.bmm(pm_3d, G_3d).reshape(B, H, L, L)\nnormm_bmm = (pmG_bmm * p_mix).sum(dim=-1, keepdim=True)\n\nprint(f'norm1 match: {(norm1_4d - norm1_bmm).abs().max():.2e}')\nprint(f'normm match: {(normm_4d - normm_bmm).abs().max():.2e}')\n\nbench('p@G (4D broadcast)', lambda: p1 @ G_exp)\nbench('p@G (bmm 3D)', lambda: torch.bmm(p1_3d, G_3d))\n\n# What about both matmuls computed back-to-back?\ndef two_4d():\n    a = p1 @ G_exp\n    b = p_mix @ G_exp\n    return a, b\n\ndef two_bmm():\n    a = torch.bmm(p1_3d, G_3d)\n    b = torch.bmm(pm_3d, G_3d)\n    return a, b\n\nbench('two p@G (4D)', two_4d)\nbench('two p@G (bmm)', two_bmm)\n\nprint()\n\n# What about G expand cost?\nbench('G expand + contiguous', lambda: G.expand(B*H, L, L).contiguous())\nprint(f'G_3d size: {G_3d.numel() * 4 / 1024 / 1024:.1f} MB')\n\n# That's 20 * 256 * 256 * 4 = 5.2 MB. Very cheap.\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

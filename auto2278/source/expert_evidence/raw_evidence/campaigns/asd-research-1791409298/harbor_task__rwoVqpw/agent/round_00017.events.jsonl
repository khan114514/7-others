{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch\nimport time\nimport math\n\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nHD = H * D\ninv_sqrt_d = 1.0 / math.sqrt(D)\nalpha, beta = 1.05, 7.5\n\nx = torch.randn(B, L, C)\nxr = x.reshape(B*L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nv = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\nlogits = q @ k.transpose(-1, -2)\nlogits.mul_(inv_sqrt_d)\np0 = logits.softmax(dim=-1)\n\na_p = 0.5 * (1 + alpha)\na_m = 0.5 * (1 - alpha)\np1_logits = logits.mul(a_p)\np1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\np1 = p1_logits.softmax(dim=-1)\np_mix = torch.lerp(p0, p1, beta)\n\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\n\ndef bench(name, fn, n=20):\n    fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    print(f'{name}: {(t1-t0)/n/1e6:.3f} ms')\n\n# Current approach: 2 p@G matmuls\n# p1@G -> norm1_sq, pmix@G -> normm_sq\n\n# Alternative: 2 p@G matmuls but compute normm differently\n# p0@G -> norm0_sq, p1@G -> norm1_sq\n# cross = (p0 * p1G).sum(dim=-1, keepdim=True)  (elementwise, cheap)\n# normm_sq = (1-beta)\"'^2 * norm0_sq + beta''^2 * norm1_sq + 2*beta*(1-beta) * cross\n# Same number of matmuls, but maybe the computation is more balanced?\n# Actually the cross term is very cheap (elementwise multiply + sum).\n\np1G = p1 @ G_exp\np0G = p0 @ G_exp\nnorm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\nnorm0_sq = (p0G * p0).sum(dim=-1, keepdim=True)\ncross = (p0 * p1G).sum(dim=-1, keepdim=True)\nom_b = 1.0 - beta\nnormm_sq_alt = om_b*om_b * norm0_sq + beta*beta * norm1_sq + 2*beta*om_b * cross\n\n# Verify\npmG = p_mix @ G_exp\nnormm_sq_direct = (pmG * p_mix).sum(dim=-1, keepdim=True)\nprint(f'\"'normm_sq match: {(normm_sq_alt - normm_sq_direct).abs().max():.2e}')\n\n# Both approaches are 2 matmuls. Same cost.\n\n# === BIGGER IDEA: What if we don't need the Gram matrix at all? ===\n# What if we compute u1 = p1 @ x directly (in C-space) and get the norm from it?\n# But p1 @ x is B*H*L*L*C FLOPs = 1.68B for case 4.\n# Gram + 2*p@G = 84M + 671M = 755M.\n# So Gram is better.\n\n# === IDEA: What if we compute u1_norm differently, using x's structure? ===\n# ||u1||\"'^2 = sum_c (sum_j p1_ij x_jc)''^2 = sum_c (p1_i @ x_c)''^2\n# where x_c is column c of x.\n# This is equivalent to doing B*H*L dot products each of length L, C times.\n# = C * B*H*L*L = same as p1 @ x. No saving.\n\n# === IDEA: What about using SVD of x? ===\n# x = U S V''^T. Then G = x x''^T = U S''^2 U''^T.\n# ||p @ x||''^2 = ||p U S||''^2 (Frobenius along the C/S dims).\n# But computing SVD of x is O(L''^2*C + L''^3) = probably not worth it.\n\n# === IDEA: Compute p1 and pmix @ G together in one batched call? ===\n# Concatenate along batch dim: [p1; pmix] shape (2B, H, L, L)\n# G expanded: [G; G] shape (2B, L, L)  \n# Still same FLOPs.\n\n# === Let me check: what if we use float16 for the p@G computation? ===\n# No, we need float32 precision.\n\n# === Let me check if the softmax issue is really about memory bandwidth ===\n# 4D softmax reads/writes B*H*L*L elements = 1*20*256*256*4 bytes = 5MB. That'\"'s tiny.\n# But softmax does max - subtract - exp - sum - divide = 5 passes over the data.\n# 5 * 5MB = 25MB read/write. At ~20 GB/s, that's 1.25ms. But we measure 8+ ms.\n# So it's compute-bound? 20 heads * 256 rows * (max + sub + exp + sum + div)\n# Hmm, exp is expensive.\n\n# Let's count: 20*256=5120 softmax operations, each on 256 elements.\n# Each softmax: max(256), sub(256), exp(256), sum(256), div(256) = ~5*256 FLOPs + exp ops\n# Total: 5120 * 5 * 256 = 6.5M FLOPs + 5120 * 256 exp = 1.3M exp ops\n# At 2 GHz, 6.5M + 1.3M*~10cycles = 6.5M + 13M = 19.5M cycles = ~10ms. That matches\"'!\n# So softmax is dominated by exp() cost.\n\n# Can we reduce exp cost? Only if we reduce the number of softmaxes or the size.\n# We need both p0 and p1. Both are L x L per head.\n# Unless... we can derive one from the other? No, they have different logits.\n\n# Actually wait: p1 = softmax(a_p*A + a_m*A''^T)\n# p0 = softmax(A)\n# These are fundamentally different.\n\n# === What about the alpha=1.0 case? ===\n# When alpha=1.0, p1=p0, u1=u0, m=u0, ratio=1, y = p0 @ v\n# That'\"'s case 6 only. Not a big win.\n\nprint()\nprint('Key remaining costs (case 4):')\nprint('  Projections: ~45ms (3 matmuls)')\nprint('  Softmax x2: ~25ms (dominated by exp)')\nprint('  p@G x2: ~25ms')\nprint('  p@v + q@k\"'^T + other: ~15ms'\"')\nprint()\n\n# Let me check if we can fuse the scaling into the projections\n# logits = q @ k\"'^T / sqrt(D)\n# If we scale q by 1/sqrt(D)''^(1/2) and k by 1/sqrt(D)''^(1/2), then q@k''^T already has the scale.\n# But that'\"'s just a scalar multiply. Probably not meaningful.\n\n# Actually wait - what if we bake the scale into the weights?\n# wq_scaled = wq / sqrt(D)\"'^(1/4), wk_scaled = wk / sqrt(D)''^(1/4)\n# Then q = x @ wq_scaled''^T, k = x @ wk_scaled''^T\n# q @ k''^T = (x @ wq_scaled''^T) @ (x @ wk_scaled''^T)''^T = (x @ (wq/sqrt(sqrt(D)))''^T) @ (x @ (wk/sqrt(sqrt(D)))''^T)''^T\n# = 1/sqrt(D) * (x @ wq''^T) @ (x @ wk''^T)''^T\n# Hmm that'\"'s the same. And we can't modify wq/wk (they're inputs, but reading is fine).\n# Actually we CAN compute scaled versions. But it's just a scalar multiply on the weights,\n# which is H*D*C = 20*64*1280 = 1.6M elements. Cheap.\n# But then we save one mul on logits (B*H*L*L = 1.3M elements). Also cheap.\n# Not meaningful.\n\n# === IDEA: Can we use the output of q@k\"'^T directly as logits without mul? ===\n# Only if we pre-scale q or k. Same thing.\n\n# Let me try a completely different approach: what if we work in C-space for u0/u1/m\n# but use a low-rank approximation of G? No, that changes the operator.\n\n# Let me try: what if we compute p_mix @ v FIRST (which is small/fast), \n# then compute the ratio, and see if the ratio computation can be optimized more.\n# Already doing this.\n\n# Let me check: is there a way to compute norm ratio from q,k directly?\n# ||p @ x||''^2 = sum_j sum_k p_j p_k G_jk\n# p = softmax(qk''^T / sqrt(D))\n# No easy formula.\n\n# Let me think about this from a completely different angle.\n# What'\"'s the theoretical minimum cost?\n# We need to compute 3 projections: 3 * B*L*C*H*D = 3 * 420M = 1.26B FLOPs\n# We need q@k\"'^T: B*H*L*L*D = 84M (each side)\n# We need softmax: ~cheap\n# We need p0@v: B*H*L*L*D = 84M, pmix@v: B*H*L*L*D = 84M\n# We need norms: at minimum, we need B*H*L dot products of length L (for ||u||)\n# but those dot products are in C-space... each u is C-dimensional...\n# wait, u = p @ x. u has C dimensions. ||u||''^2 = sum_c u_c''^2.\n# u_c = sum_j p_j x_jc. So u_c is C different dot products.\n# Total to compute u0 (B*H*L different vectors, each C-dimensional): B*H*L*L*C FLOPs\n# That'\"'s 1.68B. Plus same for u1: 3.36B. Plus same for m: 5.04B.\n# \n# Gram approach: G = x@x\"'^T: L''^2*C = 84M.\n# p@G: B*H*L''^3 = 335M each.\n# 2 p@G: 670M. Total: 754M.\n# \n# That'\"'s the minimum for exact norms with the Gram trick.\n\nprint('Let me check if there is ANY way to avoid the second p@G...')\n# We need: ||u1|| and ||m||\n# m = (1-beta)*u0 + beta*u1\n# ||m||\"'^2 = (1-beta)''^2*||u0||''^2 + beta''^2*||u1||''^2 + 2*beta*(1-beta)*<u0,u1>\n# \n# If we compute p1 @ x (u1), we get u1 directly. Cost: B*H*L*L*C = 1.68B\n# Then we need u0 = p0 @ x: another 1.68B. Total: 3.36B.\n# That'\"'s worse than Gram (754M).\n# \n# Unless we only compute u1 from p1@x and get u0 from... where?\n# We need both u0 and u1 for ||m||.\n# \n# What if we compute only u1 (from p1@x) and use some relation?\n# No simple relation between u0 and u1.\n\nprint('No shortcut for norms. Gram is optimal.')\nprint()\n\n# Let's look at other optimizations.\n# What if we compute p_mix @ G as an in-place operation?\n# Already somewhat optimized.\n\n# What about using torch.addbmm or combining multiple operations?\n# Let me check: is there a difference between p @ G_exp and (p.unsqueeze(2) @ G.unsqueeze(1).unsqueeze(1)).squeeze(2)?\n# No, they're equivalent.\n\n# Let me check memory layout of G\nprint(f'G shape: {G.shape}, contiguous: {G.is_contiguous()}')\nprint(f'G_exp shape: {G_exp.shape}, contiguous: {G_exp.is_contiguous()}')\n\n# What if we pre-expand G to (B, H, L, L)?\nG_expanded = G.unsqueeze(1).expand(B, H, L, L).contiguous()\np = p_mix\nprint(f'G_expanded shape: {G_expanded.shape}, contiguous: {G_expanded.is_contiguous()}')\nbench('p @ G_exp (broadcast)', lambda: p @ G_exp)\nbench('p @ G_expanded (contiguous 4D)', lambda: p @ G_expanded)\n\n# What about reshaping both to 3D?\np_3d = p.reshape(B*H, L, L)\nG_3d = G_expanded.reshape(B*H, L, L)\nbench('bmm p_3d @ G_3d', lambda: torch.bmm(p_3d, G_3d))\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_56","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch\nimport time\nimport math\n\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nHD = H * D\ninv_sqrt_d = 1.0 / math.sqrt(D)\nalpha, beta = 1.05, 7.5\na_p = 0.5 * (1 + alpha)\na_m = 0.5 * (1 - alpha)\n\nx = torch.randn(B, L, C)\nxr = x.reshape(B*L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\ndef bench(name, fn, n=15):\n    fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    print(f'{name}: {(t1-t0)/n/1e6:.3f} ms')\n\n# Let me try stacking all three projections\nw_all = torch.cat([wq.reshape(HD, C), wk.reshape(HD, C), wv.reshape(HD, C)], dim=0)  # (3*HD, C)\n\ndef three_separate():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    return q, k, v\n\ndef fused_three():\n    out = xr @ w_all.T  # (B*L, 3*HD)\n    out = out.reshape(B, L, H, 3*D)\n    out = out.permute(0, 2, 1, 3).contiguous()  # (B, H, L, 3*D)\n    q = out[:, :, :, :D]\n    k = out[:, :, :, D:2*D]\n    v = out[:, :, :, 2*D:]\n    return q.contiguous(), k.contiguous(), v.contiguous()\n\nbench('3 separate projs', three_separate)\nbench('fused 3 projs', fused_three)\n\nq1, k1, v1 = three_separate()\nq2, k2, v2 = fused_three()\nprint(f'q match: {(q1-q2).abs().max():.2e}')\nprint(f'k match: {(k1-k2).abs().max():.2e}')\nprint(f'v match: {(v1-v2).abs().max():.2e}')\n\nprint()\n# What if we don't need q,k,v to be contiguous separately?\n# q@k\"'^T: both need to be in right layout for matmul\n# Actually, q and k are both (B,H,L,D) - if they'\"'re slices of the same contiguous tensor,\n# they might not be contiguous themselves.\nprint(f'q2 contiguous: {q2.is_contiguous()}')\nprint(f'k2 contiguous: {k2.is_contiguous()}')\nprint(f'v2 contiguous: {v2.is_contiguous()}')\n\n# Test q@k\"'^T with sliced tensors\nbench('\"'q1@k1\"'^T (separate)'\"', lambda: q1 @ k1.transpose(-1, -2))\nbench('q2@k2\"'^T (fused slices)'\"', lambda: q2 @ k2.transpose(-1, -2))\n\n# Also test p @ v\np = torch.randn(B, H, L, L)\nbench('p @ v1 (separate)', lambda: p @ v1)\nbench('p @ v2 (fused slices)', lambda: p @ v2)\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

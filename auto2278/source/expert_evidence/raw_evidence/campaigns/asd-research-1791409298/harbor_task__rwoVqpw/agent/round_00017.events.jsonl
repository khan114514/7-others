{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch\nimport time\nimport math\n\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\n\n# Check softmax performance with various layouts\nlogits = torch.randn(B, H, L, L)\nprint(f'logits contiguous: {logits.is_contiguous()}')\nprint(f'logits shape: {logits.shape}')\n\ndef bench(name, fn, n=20):\n    fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    print(f'{name}: {(t1-t0)/n/1e6:.2f} ms')\n\nbench('softmax (BHLL contiguous)', lambda: logits.softmax(dim=-1))\n\n# What about different shapes?\nlogits_2d = logits.reshape(B*H*L, L)\nbench('softmax (2D contiguous, dim=-1)', lambda: logits_2d.softmax(dim=-1))\n\n# What about just sum/max?\nbench('logits.max(dim=-1)', lambda: logits.max(dim=-1))\nbench('logits.sum(dim=-1)', lambda: logits.sum(dim=-1))\n\n# Manual softmax?\ndef manual_softmax(x):\n    m = x.max(dim=-1, keepdim=True).values\n    e = (x - m).exp_()\n    s = e.sum(dim=-1, keepdim=True)\n    return e.div_(s)\n\nbench('manual softmax (BHLL)', lambda: manual_softmax(logits))\n\n# What about transposed?\nlogits_t = logits.transpose(0, 1).contiguous()  # (H, B, L, L)\nbench('softmax (HBLL contiguous)', lambda: logits_t.softmax(dim=-1))\n\n# p@G - check layout\nG = torch.randn(B, L, L)\nG_exp = G.unsqueeze(1)\np = torch.randn(B, H, L, L)\nprint()\nprint(f'p shape: {p.shape}, contiguous: {p.is_contiguous()}')\nprint(f'G_exp shape: {G_exp.shape}, contiguous: {G_exp.is_contiguous()}')\n\nbench('p @ G_exp (BHLL @ B1LL)', lambda: p @ G_exp)\n\n# What if we reshape to (B*H, L, L)?\np_reshaped = p.reshape(B*H, L, L)\nG_bcast = G.expand(B*H, L, L).contiguous()\nbench('p3d @ G3d (BHL,LL)', lambda: p_reshaped @ G_bcast)\n\n# Using einsum\nbench('einsum bhij,bjk->bhik', lambda: torch.einsum('bhij,bjk->bhik', p, G))\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

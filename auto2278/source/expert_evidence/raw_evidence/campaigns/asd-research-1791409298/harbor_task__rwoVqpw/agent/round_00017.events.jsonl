ous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    \n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    \n    # 2D softmax - reshape to 2D, softmax, reshape back\n    # logits: (B, H, L, L) -> (B*H*L, L)\n    BHL = B * H * L\n    p0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    \n    # p1 logits\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    \n    p_mix = torch.lerp(p0, p1, beta)\n    \n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    \n    p1G = p1 @ G_exp\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\nbench('\"'current', current)\nbench('opt v1 (2D softmax)', optimized_v1)\n\n# Verify\ny0 = current()\ny1 = optimized_v1()\nprint(f'diff: {(y0-y1).abs().max():.2e}')\n\nprint()\n\n# Try another optimization: use einsum for the final output to avoid transpose?\n# Current: y.transpose(1, 2).flatten(2).contiguous()\n# This is BHLD -> BLHD -> BL(HD). Cost is negligible.\n\n# Let me check if .view() works vs .reshape() for the 2D softmax\nlogits = (torch.randn(B, H, L, L) @ torch.randn(B, H, L, D).transpose(-1,-2))\nprint(f'logits contiguous: {logits.is_contiguous()}')\nprint(f'logits view(-1, L) same as reshape: {logits.view(-1, L).data_ptr() == logits.reshape(-1, L).data_ptr()}')\n\n# What about p1_logits? After mul + add transpose, is it contiguous?\np1_logits = logits.mul(a_p)\np1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\nprint(f'p1_logits contiguous: {p1_logits.is_contiguous()}')\n\\\"\n\"","aggregated_output":"Traceback (most recent
{"type":"item.started","item":{"id":"item_83","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch\nimport torch.nn.functional as F\nimport time\nimport math\nimport statistics\n\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nHD = H * D\n\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\ndef bench(fn, n=15):\n    for _ in range(3): fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        t1 = time.process_time_ns()\n        times.append((t1-t0)/1e6)\n    return statistics.median(times)\n\n# Current: reshape + matmul + permute + contiguous\ndef proj_reshape(w):\n    return (x.reshape(B*L, C) @ w.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\n# F.linear\nw_2d = wq.reshape(HD, C)\ndef proj_flinear():\n    return F.linear(x, w_2d).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\nprint(f'reshape: {bench(lambda: proj_reshape(wq)):.2f} ms')\nprint(f'F.linear: {bench(proj_flinear):.2f} ms')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

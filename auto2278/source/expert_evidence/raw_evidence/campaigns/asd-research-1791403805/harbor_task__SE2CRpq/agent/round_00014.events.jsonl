# At output ~40, tol = 0.012, so 5e-3 is OK\n# But let's verify with the actual oracle which uses einsum AND a specific p1 pattern\n\ndef oracle_out():\n    q = torch.einsum('blc,hdc->bhld', x, wq)\n    k = torch.einsum('blc,hdc->bhld', x, wk)\n    logits = q @ k.transpose(-1, -2) / math.sqrt(D)\n    p0 = logits.softmax(-1)\n    p1 = (.5 * (1 + alpha) * logits + .5 * (1 - alpha) * logits.transpose(-1, -2)).softmax(-1)\n    base, modified = p0 @ x.unsqueeze(1), p1 @ x.unsqueeze(1)\n    mix = base + beta * (modified - base)\n    return torch.einsum('bhlc,hdc->bhld', mix, wv)\n\nref_out = oracle_out()\nprint()\nprint('V-first vs oracle (no ratio, no norm):', (out_b - ref_out).abs().max().item())\nprint('Expected max: ~40, tol would be:', 3e-5 + 3e-4 * 40)\nprint('allclose:', torch.allclose(ref_out, out_b, atol=3e-5, rtol=3e-4))\n\\\"\n\"","aggregated_output":"p1 diff (A vs B): 2.5153160095214844e-05\npmix lerp vs direct: 4.76837158203125e-07\nmix_a vs mix_b: 3.814697265625e-06\noutput a (einsum): torch.Size([1, 10, 256, 64])\noutput b (v-first): torch.Size([1, 10, 256, 64])\noutput diff: 0.00067138671875\n\nV-first vs oracle (no ratio, no norm): 0.0135498046875\nExpected max: ~40, tol would be: 0.012029999999999999\nallclose: False\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_55","type":"command_execution","command":"/bin/sh -lc 'cd /workspace && python3 -c \"\nimport torch, math\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 640, 10, 64\nalpha, beta = 1.2, 5.0\ng = torch.Generator(); g.manual_seed(17*1009 + 4)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g)\nwk = torch.randn(H, D, C, generator=g)\nwv = torch.randn(H, D, C, generator=g)\n\n# The v-first approach has error of ~0.013 at output of ~40 -> just barely fails (tol ~0.012)\n# The error comes from: (p_mix @ x) @ wv''^T vs p_mix @ (x @ wv''^T)\n# These are mathematically equivalent but differ numerically\n\n# Let'\"'s try: output the C-space way but with optimized matmul instead of einsum\n# mix @ wv\"'^T per head: (B, H, L, C) @ (H, D, C).T -> (B, H, L, D)\n# We can reshape to do a single big matmul\n\nHD = H * D\nxr = x.reshape(B * L, C)\ninv_sqrt_d = 1.0 / math.sqrt(D)\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nv = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nlogits = q @ k.transpose(-1, -2) * inv_sqrt_d\np0 = logits.softmax(-1)\np1 = (0.5*(1+alpha)*logits + 0.5*(1-alpha)*logits.transpose(-1,-2)).softmax(-1)\np_mix = torch.lerp(p0, p1, beta)\n\n# Option A: v-first (fast but less accurate)\ny_a = p_mix @ v  # (B,H,L,D)\n\n# Option B: C-space p_mix @ x then @ wv''^T\nx_exp = x.unsqueeze(1)\nm_c = p_mix @ x_exp  # (B,H,L,C)\n# einsum way\ny_b = torch.einsum('\"'bhlc,hdc->bhld', m_c, wv)\n\n# Option C: reshape to big matmul\n# m_c: (B,H,L,C) -> (B*H*L, C)\n# wv: (H,D,C) -> (H*D, C)\n# output: (B*H*L, H*D) -> no, wrong\"'! Each head has its own wv\n# Actually: for each head h, m_c[h] @ wv[h].T\n# m_c (B, H, L, C), wv (H, D, C)\n# We can do: m_c.reshape(B*H, L, C) @ wv.reshape(H, D, C).transpose(-1,-2).expand(B,H,D,C).reshape(B*H,D,C)\n# That'\"'s B*H matmuls of (L, C) @ (C, D) = B*H*L*C*D = same as einsum\nm_c_bh = m_c.reshape(B*H, L, C)  # (B*H, L, C)\nwv_bh = wv.unsqueeze(0).expand(B, H, D, C).reshape(B*H, D, C)  # (B*H, D, C)\ny_c = torch.bmm(m_c_bh, wv_bh.transpose(-1, -2)).reshape(B, H, L, D)\n\nprint('A (v-first) vs B (einsum):', (y_a - y_b).abs().max().item())\nprint('B (einsum) vs C (bmm):', (y_b - y_c).abs().max().item())\n\n# What about the ratio effect?\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\nu1_c = p1 @ x_exp\nnorm1_ref = u1_c.norm(dim=-1, keepdim=True).clamp_min(1e-6)\nnormm_ref = m_c.norm(dim=-1, keepdim=True).clamp_min(1e-6)\nratio_ref = (norm1_ref / normm_ref).clamp(.25, 4.)\n\n# Gram norms\nnorm1_sq = (p1 @ G_exp).mul(p1).sum(dim=-1, keepdim=True)\nnormm_sq = (p_mix @ G_exp).mul(p_mix).sum(dim=-1, keepdim=True)\nnorm1_g = norm1_sq.sqrt().clamp_min(1e-6)\nnormm_g = normm_sq.sqrt().clamp_min(1e-6)\nratio_g = (norm1_g / normm_g).clamp(0.25, 4.0)\n\nprint()\nprint('ratio diff (gram vs direct):', (ratio_ref - ratio_g).abs().max().item())\n\n# Final outputs\ndef oracle_full():\n    q = torch.einsum('blc,hdc->bhld', x, wq)\n    k = torch.einsum('blc,hdc->bhld', x, wk)\n    logits = q @ k.transpose(-1, -2) / math.sqrt(D)\n    p0 = logits.softmax(-1)\n    p1 = (.5 * (1 + alpha) * logits + .5 * (1 - alpha) * logits.transpose(-1, -2)).softmax(-1)\n    base, modified = p0 @ x.unsqueeze(1), p1 @ x.unsqueeze(1)\n    mix = base + beta * (modified - base)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / mix.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    return torch.einsum('bhlc,hdc->bhld', mix * ratio, wv).transpose(1, 2).flatten(2).contiguous()\n\nout_ref = oracle_full()\n\n# Option A + gram ratio\nout_a = (y_a * ratio_g).transpose(1, 2).flatten(2).contiguous()\nprint()\nprint('v-first + gram ratio:', (out_a - out_ref).abs().max().item(), ' allclose:', torch.allclose(out_ref, out_a, atol=3e-5, rtol=3e-4))\n\n# Option C + gram ratio (C-space output via bmm)\nout_c = (y_c * ratio_g).transpose(1, 2).flatten(2).contiguous()\nprint('C-space bmm + gram ratio:', (out_c - out_ref).abs().max().item(), ' allclose:', torch.allclose(out_ref, out_c, atol=3e-5, rtol=3e-4))\n\n# Option C + direct norm (more accurate but slower)\nout_c_direct = (y_c * ratio_ref).transpose(1, 2).flatten(2).contiguous()\nprint('C-space bmm + direct norm:', (out_c_direct - out_ref).abs().max().item(), ' allclose:', torch.allclose(out_ref, out_c_direct, atol=3e-5, rtol=3e-4))\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

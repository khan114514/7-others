{"type":"item.started","item":{"id":"item_57","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math, time\ntorch.set_num_threads(1)\n\ncases = [\n    (1, 64, 512, 8, 64, 1.05, 5.0),\n    (1, 128, 640, 10, 64, 1.1, 4.0),\n    (1, 128, 1280, 20, 64, 1.15, 3.0),\n    (1, 256, 1280, 20, 64, 1.05, 7.5),\n    (1, 256, 640, 10, 64, 1.2, 5.0),\n    (2, 128, 512, 8, 64, 1.0, 5.0),\n]\n\ndef time_fn(fn, n=11, warmup=3):\n    for _ in range(warmup):\n        fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return sorted(times)[len(times)//2]\n\nfor i, (B, L, C, H, D, alpha, beta) in enumerate(cases):\n    g = torch.Generator(); g.manual_seed(17*1009 + i)\n    x = torch.randn(B, L, C, generator=g)\n    wq = torch.randn(H, D, C, generator=g)\n    wk = torch.randn(H, D, C, generator=g)\n    wv = torch.randn(H, D, C, generator=g)\n    HD = H * D\n    xr = x.reshape(B * L, C)\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    \n    def baseline():\n        q = torch.einsum('blc,hdc->bhld', x, wq)\n        k = torch.einsum('blc,hdc->bhld', x, wk)\n        logits = (q @ k.transpose(-1, -2)) / math.sqrt(D)\n        p0 = logits.softmax(dim=-1)\n        base = p0 @ x.unsqueeze(1)\n        if alpha == 1.0:\n            modified = base\n        else:\n            perturbed = .5 * (1 + alpha) * logits + .5 * (1 - alpha) * logits.transpose(-1, -2)\n            modified = perturbed.softmax(dim=-1) @ x.unsqueeze(1)\n        blended = base + beta * (modified - base)\n        ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n                 / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n        y = torch.einsum('bhlc,hdc->bhld', blended * ratio, wv)\n        return y.transpose(1, 2).flatten(2).contiguous()\n    \n    # Current: v-first + gram\n    def cur_vfirst_gram():\n        q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n        k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n        v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n        logits = q @ k.transpose(-1, -2)\n        logits.mul_(inv_sqrt_d)\n        p0 = logits.softmax(dim=-1)\n        if alpha == 1.0:\n            y = p0 @ v\n        else:\n            a_p = 0.5 * (1.0 + alpha)\n            a_m = 0.5 * (1.0 - alpha)\n            p1_logits = logits.mul(a_p)\n            p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n            p1 = p1_logits.softmax(dim=-1)\n            p_mix = torch.lerp(p0, p1, beta)\n            G = x @ x.transpose(-1, -2)\n            G_exp = G.unsqueeze(1)\n            p1G = p1 @ G_exp\n            norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n            pmG = p_mix @ G_exp\n            normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n            norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n            normm = normm_sq.sqrt_().clamp_min_(1e-6)\n            ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n            y = (p_mix @ v).mul_(ratio)\n        return y.transpose(1, 2).flatten(2).contiguous()\n    \n    # C-space output via bmm + gram norm\n    def cur_cspace_gram():\n        q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n        k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n        logits = q @ k.transpose(-1, -2)\n        logits.mul_(inv_sqrt_d)\n        p0 = logits.softmax(dim=-1)\n        if alpha == 1.0:\n            m = p0 @ x.unsqueeze(1)\n            norm1 = m.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n            ratio = 1.0\n            y = torch.bmm(\n                (m * ratio).reshape(B*H, L, C),\n                wv.unsqueeze(0).expand(B, H, D, C).reshape(B*H, D, C).transpose(-1, -2)\n            ).reshape(B, H, L, D)\n        else:\n            a_p = 0.5 * (1.0 + alpha)\n            a_m = 0.5 * (1.0 - alpha)\n            p1_logits = logits.mul(a_p)\n            p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n            p1 = p1_logits.softmax(dim=-1)\n            p_mix = torch.lerp(p0, p1, beta)\n            G = x @ x.transpose(-1, -2)\n            G_exp = G.unsqueeze(1)\n            p1G = p1 @ G_exp\n            norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n            pmG = p_mix @ G_exp\n            normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n            norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n            normm = normm_sq.sqrt_().clamp_min_(1e-6)\n            ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n            m = p_mix @ x.unsqueeze(1)\n            wv_bh = wv.unsqueeze(0).expand(B, H, D, C).reshape(B*H, D, C)\n            y = torch.bmm(\n                (m * ratio).reshape(B*H, L, C),\n                wv_bh.transpose(-1, -2)\n            ).reshape(B, H, L, D)\n        return y.transpose(1, 2).flatten(2).contiguous()\n    \n    tb = time_fn(baseline)\n    tv = time_fn(cur_vfirst_gram)\n    tc = time_fn(cur_cspace_gram)\n    \n    ref = baseline()\n    err_v = (cur_vfirst_gram() - ref).abs().max().item()\n    err_c = (cur_cspace_gram() - ref).abs().max().item()\n    ok_v = torch.allclose(ref, cur_vfirst_gram(), atol=3e-5, rtol=3e-4)\n    ok_c = torch.allclose(ref, cur_cspace_gram(), atol=3e-5, rtol=3e-4)\n    \n    print(f'Case {i}: base={tb:.1f}ms  vfirst={tv:.1f}ms (r={tv/tb:.3f}, e={err_v:.2e}, ok={ok_v})  cspace={tc:.1f}ms (r={tc/tb:.3f}, e={err_c:.2e}, ok={ok_c})')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

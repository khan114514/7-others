{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math\ntorch.set_num_threads(1)\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\ng = torch.Generator(); g.manual_seed(17*1009+3)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g)\nwk = torch.randn(H, D, C, generator=g)\nwv = torch.randn(H, D, C, generator=g)\n\nHD = H * D\nxr = x.reshape(B * L, C)\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nv = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\ninv_sqrt_d = 1.0 / math.sqrt(D)\nlogits = q @ k.transpose(-1, -2)\nlogits.mul_(inv_sqrt_d)\np0 = logits.softmax(dim=-1)\na_p = 0.5 * (1.0 + alpha)\na_m = 0.5 * (1.0 - alpha)\np1_logits = logits.mul(a_p)\np1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\np1 = p1_logits.softmax(dim=-1)\np_mix = torch.lerp(p0, p1, beta)\n\n# Baseline approach\nm_ref = (1-beta) * (p0 @ x.unsqueeze(1)) + beta * (p1 @ x.unsqueeze(1))\nu1_ref = p1 @ x.unsqueeze(1)\nnorm1_ref = u1_ref.norm(dim=-1, keepdim=True).clamp_min(1e-6)\nnormm_ref = m_ref.norm(dim=-1, keepdim=True).clamp_min(1e-6)\nratio_ref = (norm1_ref / normm_ref).clamp(.25, 4.)\ny_ref = torch.einsum('bhlc,hdc->bhld', m_ref * ratio_ref, wv)\n\n# Test variant: keep norm computation via direct p@x (accurate), \n# but output via p_mix @ v * ratio (less accurate for output)\nm_v = p_mix @ v  # output in D dimensions\nratio_via_x = ratio_ref  # accurate ratio\ny_v = m_v * ratio_via_x\nprint('y with v-projection but accurate ratio:', (y_v - y_ref).abs().max())\n\n# Test: output via einsum (like baseline) but with norm via gram\n# Actually let's test: output via (p_mix @ x) @ wv\"'^T then accurate vs gram ratio\nm_x = p_mix @ x.unsqueeze(1)  # (B,H,L,C)\ny_x = torch.einsum('\"'bhlc,hdc->bhld', m_x * ratio_ref, wv)\nprint('y with p_mix@x and accurate ratio:', (y_x - y_ref).abs().max())\n# This should be ~0 since it's basically the same as baseline\n\n# What about: compute m_x for norms (accurate), then y = m_x @ wv\"'^T * ratio?\n# That'\"'s the baseline approach basically.\n\n# The current solution has TWO sources of error:\n# 1. Gram-based norms (small error in ratio)\n# 2. v-first output ordering (larger error in y)\n# Let's isolate:\n\n# Error from gram ratio only, using einsum output\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\nnorm1_sq = (p1 @ G_exp).mul(p1).sum(dim=-1, keepdim=True)\nnormm_sq = (p_mix @ G_exp).mul(p_mix).sum(dim=-1, keepdim=True)\nnorm1_g = norm1_sq.sqrt().clamp_min(1e-6)\nnormm_g = normm_sq.sqrt().clamp_min(1e-6)\nratio_g = (norm1_g / normm_g).clamp(0.25, 4.0)\ny_gram_ratio = torch.einsum('bhlc,hdc->bhld', m_x * ratio_g, wv)\nprint('y with p_mix@x and gram ratio:', (y_gram_ratio - y_ref).abs().max())\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

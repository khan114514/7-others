{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/sh -lc 'cd /workspace && python3 -c \"\nimport torch, math, time\ntorch.set_num_threads(1)\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\ng = torch.Generator(); g.manual_seed(17*1009+3)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g)\nwk = torch.randn(H, D, C, generator=g)\nwv = torch.randn(H, D, C, generator=g)\n\ndef time_fn(fn, n=11, warmup=3):\n    for _ in range(warmup):\n        fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return sorted(times)[len(times)//2]\n\nHD = H * D\nxr = x.reshape(B * L, C)\n\n# Baseline approach with direct matmul projections\ndef opt_accurate():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    # Compute output via p_mix @ v (in D dims - like v-first)\n    y = p_mix @ v\n    # Compute norms via gram approach (fast)\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    norm1_sq = (p1 @ G_exp).mul(p1).sum(dim=-1, keepdim=True)\n    normm_sq = (p_mix @ G_exp).mul(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n    normm = normm_sq.sqrt().clamp_min(1e-6)\n    ratio = (norm1 / normm).clamp(0.25, 4.0)\n    y.mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Same but output via m_c @ wv''^T (reshape matmul instead of einsum)\ndef opt_accurate2():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    # p_mix: (B,H,L,L), x: (B,L,C) -> m_c: (B,H,L,C)\n    m_c = p_mix @ x.unsqueeze(1)\n    # norms (direct)\n    norm1 = (p1 @ x.unsqueeze(1)).norm(dim=-1, keepdim=True).clamp_min(1e-6)\n    normm = m_c.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n    ratio = (norm1 / normm).clamp(0.25, 4.0)\n    # output: m_c * ratio -> (B,H,L,C), matmul wv (H,D,C) -> (B,H,L,D)\n    # reshape to (B*H*L, C) @ (H*D, C).T -> (B*H*L, H*D) - no, per head\n    # m_c: (B,H,L,C), wv: (H,D,C)\n    # m_c_rs = m_c.permute(0,2,1,3).reshape(B*L, H*C)  -- no\n    # Per head: (B,H,L,C) @ (H,D,C).transpose(-1,-2) = (B,H,L,D)\n    y = (m_c * ratio) @ wv.unsqueeze(0).transpose(-1, -2)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Reference\ndef baseline():\n    q = torch.einsum('\"'blc,hdc->bhld', x, wq)\n    k = torch.einsum('blc,hdc->bhld', x, wk)\n    logits = (q @ k.transpose(-1, -2)) / math.sqrt(D)\n    p0 = logits.softmax(dim=-1)\n    base = p0 @ x.unsqueeze(1)\n    perturbed = .5 * (1 + alpha) * logits + .5 * (1 - alpha) * logits.transpose(-1, -2)\n    modified = perturbed.softmax(dim=-1) @ x.unsqueeze(1)\n    blended = base + beta * (modified - base)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    y = torch.einsum('bhlc,hdc->bhld', blended * ratio, wv)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\nref = baseline()\nr1 = opt_accurate()\nr2 = opt_accurate2()\nprint('opt_accurate max err:', (r1 - ref).abs().max().item(), '  allclose:', torch.allclose(r1, ref, atol=3e-5, rtol=3e-4))\nprint('opt_accurate2 max err:', (r2 - ref).abs().max().item(), '  allclose:', torch.allclose(r2, ref, atol=3e-5, rtol=3e-4))\nprint()\nprint('opt_accurate time:', time_fn(opt_accurate), 'ms')\nprint('opt_accurate2 time:', time_fn(opt_accurate2), 'ms')\nprint('baseline time:', time_fn(baseline), 'ms')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

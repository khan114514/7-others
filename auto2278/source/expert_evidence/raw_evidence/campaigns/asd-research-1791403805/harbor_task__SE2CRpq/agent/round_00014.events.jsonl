{"type":"item.started","item":{"id":"item_74","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 << 'PYEOF'\nimport torch, math, time\ntorch.set_num_threads(1)\n\n# Let me try: compute G = x @ x.T as float32, then do p@G more efficiently\n# Also try: precomputing G and then doing both gram multiplications as one\n# Also try: using in-place operations on pre-allocated buffers\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\ng = torch.Generator().manual_seed(17 * 1009 + 3)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwv = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n\ndef time_fn(fn, n=20, warmup=5):\n    for _ in range(warmup):\n        fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return sorted(times)[len(times)//2]\n\nHD = H * D\nxr = x.reshape(B * L, C)\ninv_sqrt_d = 1.0 / math.sqrt(D)\na_p = 0.5 * (1.0 + alpha)\na_m = 0.5 * (1.0 - alpha)\nb = beta\nomb = 1.0 - beta\n\n# Current approach\ndef current():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    p1G = p1 @ G_exp\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Idea: compute G in the inner loop differently, or use einsum\n# Actually, the most expensive parts are:\n# 1. Projections (45ms) - unavoidable\n# 2. Softmax (28ms for both p0 and p1) - hard to optimize\n# 3. Gram matmuls (25ms) - maybe optimize layout\n\n# Let me try: doing everything in (B*H, L, D) format to avoid 4D broadcasting\ndef flat():\n    qf = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).reshape(B*H, L, D).contiguous()\n    kf = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).reshape(B*H, L, D).contiguous()\n    vf = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).reshape(B*H, L, D).contiguous()\n    logits = torch.bmm(qf, kf.transpose(-1, -2))\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    # G needs to be (B*H, L, L)\n    G = x @ x.transpose(-1, -2)  # (B, L, L)\n    Gf = G.expand(B, H, L, L).reshape(B*H, L, L).contiguous()\n    p1G = torch.bmm(p1, Gf)\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = torch.bmm(p_mix, Gf)\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    y = torch.bmm(p_mix, vf).mul_(ratio)\n    return y.reshape(B, H, L, D).transpose(1, 2).flatten(2).contiguous()\n\n# But G.expand + contiguous costs memory and time. Instead, use 4D broadcasting which PyTorch handles.\n# The current approach already does that.\n\n# Let me try: doing the gram computation with einsum or direct summation\n# Actually: (p @ G) * p summed over last dim = sum_j sum_k p_ij * G_jk * p_ik
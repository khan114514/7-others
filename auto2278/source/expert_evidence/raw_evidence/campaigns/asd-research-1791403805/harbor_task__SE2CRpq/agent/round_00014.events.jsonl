{"type":"item.started","item":{"id":"item_54","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 640, 10, 64\nalpha, beta = 1.2, 5.0\ng = torch.Generator(); g.manual_seed(17*1009 + 4)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g)\nwk = torch.randn(H, D, C, generator=g)\nwv = torch.randn(H, D, C, generator=g)\n\nHD = H * D\nxr = x.reshape(B * L, C)\n\n# Pattern 1 p1 (in-place add_) gives 2.5e-5 diff in p1\n# What about p_mix?\ninv_sqrt_d = 1.0 / math.sqrt(D)\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nlogits = q @ k.transpose(-1, -2) * inv_sqrt_d\n\np0 = logits.softmax(-1)\na_p = 0.5 * (1.0 + alpha)\na_m = 0.5 * (1.0 - alpha)\n\n# Pattern A: in-place\np1_a = logits.mul(a_p).add_(logits.transpose(-1, -2), alpha=a_m).softmax(-1)\n\n# Pattern B: out-of-place \np1_b = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(-1)\n\nprint('p1 diff (A vs B):', (p1_a - p1_b).abs().max().item())\n\n# p_mix with lerp vs direct\npmix_lerp = torch.lerp(p0, p1_a, beta)\npmix_direct = p0 + beta * (p1_a - p0)\nprint('pmix lerp vs direct:', (pmix_lerp - pmix_direct).abs().max().item())\n\n# Now the big test: does mix (C-space) have big diff?\nx_exp = x.unsqueeze(1)\nmix_a = p0 @ x_exp + beta * (p1_a @ x_exp - p0 @ x_exp)\nmix_b = pmix_lerp @ x_exp\nprint('mix_a vs mix_b:', (mix_a - mix_b).abs().max().item())\n\n# And the output:\nout_a = torch.einsum('bhlc,hdc->bhld', mix_a, wv)\nout_b = (pmix_lerp @ ((xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()))\nprint('output a (einsum):', out_a.shape)\nprint('output b (v-first):', out_b.shape)\nprint('output diff:', (out_a - out_b).abs().max().item())\n\n# The output diff of 5e-3 is from v-first approach\n# For tolerance: 3e-5 + 3e-4 * |expected|\n# At output ~40, tol = 0.012, so 5e-3 is OK\n# But let's verify with the actual oracle which uses einsum AND a specific p1 pattern\n\ndef oracle_out():\n    q = torch.einsum('blc,hdc->bhld', x, wq)\n    k = torch.einsum('blc,hdc->bhld', x, wk)\n    logits = q @ k.transpose(-1, -2) / math.sqrt(D)\n    p0 = logits.softmax(-1)\n    p1 = (.5 * (1 + alpha) * logits + .5 * (1 - alpha) * logits.transpose(-1, -2)).softmax(-1)\n    base, modified = p0 @ x.unsqueeze(1), p1 @ x.unsqueeze(1)\n    mix = base + beta * (modified - base)\n    return torch.einsum('bhlc,hdc->bhld', mix, wv)\n\nref_out = oracle_out()\nprint()\nprint('V-first vs oracle (no ratio, no norm):', (out_b - ref_out).abs().max().item())\nprint('Expected max: ~40, tol would be:', 3e-5 + 3e-4 * 40)\nprint('allclose:', torch.allclose(ref_out, out_b, atol=3e-5, rtol=3e-4))\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_58","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math\ntorch.set_num_threads(1)\n\n# Case 4 is failing even with C-space + gram\n# Let me investigate what causes the 5.2e-3 error there\n\nB, L, C, H, D = 1, 256, 640, 10, 64\nalpha, beta = 1.2, 5.0\ng = torch.Generator(); g.manual_seed(17*1009 + 4)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g)\nwk = torch.randn(H, D, C, generator=g)\nwv = torch.randn(H, D, C, generator=g)\n\ndef oracle():\n    q = torch.einsum('blc,hdc->bhld', x, wq)\n    k = torch.einsum('blc,hdc->bhld', x, wk)\n    logits = q @ k.transpose(-1, -2) / math.sqrt(D)\n    p0 = logits.softmax(-1)\n    p1 = (.5 * (1 + alpha) * logits + .5 * (1 - alpha) * logits.transpose(-1, -2)).softmax(-1)\n    base, modified = p0 @ x.unsqueeze(1), p1 @ x.unsqueeze(1)\n    mix = base + beta * (modified - base)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / mix.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    return torch.einsum('bhlc,hdc->bhld', mix * ratio, wv).transpose(1, 2).flatten(2).contiguous()\n\nHD = H * D\nxr = x.reshape(B * L, C)\ninv_sqrt_d = 1.0 / math.sqrt(D)\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nlogits = q @ k.transpose(-1, -2)\nlogits.mul_(inv_sqrt_d)\np0 = logits.softmax(dim=-1)\n\na_p = 0.5 * (1.0 + alpha)\na_m = 0.5 * (1.0 - alpha)\n\n# p1 pattern comparison\np1_standard = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(-1)\np1_inplace = logits.mul(a_p).add_(logits.transpose(-1, -2), alpha=a_m).softmax(-1)\nprint('p1 standard vs inplace:', (p1_standard - p1_inplace).abs().max().item())\n\n# Oracle uses .5 * (1+alpha) * logits + .5 * (1-alpha) * logits.T\n# That's the same as a_p * logits + a_m * logits.T\n# Let's verify\nq_ref = torch.einsum('blc,hdc->bhld', x, wq)\nk_ref = torch.einsum('blc,hdc->bhld', x, wk)\nlogits_ref = q_ref @ k_ref.transpose(-1, -2) / math.sqrt(D)\np1_oracle = (.5 * (1 + alpha) * logits_ref + .5 * (1 - alpha) * logits_ref.transpose(-1, -2)).softmax(-1)\nprint('p1 oracle vs standard:', (p1_oracle - p1_standard).abs().max().item())\nprint('logits oracle vs candidate:', (logits_ref - logits).abs().max().item())\n\n# The p1 diff is 0 for standard computation. So the error comes from somewhere else.\n# Let me trace it step by step using the same computation pattern as oracle\np1 = p1_standard  # use standard (out-of-place) for fairness\np_mix = p0 + beta * (p1 - p0)  # same as oracle pattern\n\nx_exp = x.unsqueeze(1)\nbase = p0 @ x_exp\nmodified = p1 @ x_exp\nmix = base + beta * (modified - base)\n\nprint()\nprint('mix (C-space) vs oracle:', (mix - (p_mix @ x_exp)).abs().max().item())\n\n# Direct norm computation\nnorm1_direct = modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\nnormm_direct = mix.norm(dim=-1, keepdim=True).clamp_min(1e-6)\nratio_direct = (norm1_direct / normm_direct).clamp(.25, 4.)\n\n# Gram norm\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\nnorm1_sq_g = (p1 @ G_exp).mul(p1).sum(dim=-1, keepdim=True)\nnormm_sq_g = (p_mix @ G_exp).mul(p_mix).sum(dim=-1, keepdim=True)\nnorm1_g = norm1_sq_g.sqrt().clamp_min(1e-6)\nnormm_g = normm_sq_g.sqrt().clamp_min(1e-6)\nratio_g = (norm1_g / normm_g).clamp(0.25, 4.0)\n\nprint('norm1 diff:', (norm1_direct - norm1_g).abs().max().item())\nprint('normm diff:', (normm_direct - normm_g).abs().max().item())\nprint('ratio diff:', (ratio_direct - ratio_g).abs().max().item())\n\n# Output: C-space via einsum\nout_direct = torch.einsum('bhlc,hdc->bhld', mix * ratio_direct, wv).transpose(1, 2).flatten(2).contiguous()\nout_gram = torch.einsum('bhlc,hdc->bhld', mix * ratio_g, wv).transpose(1, 2).flatten(2).contiguous()\n\nref = oracle()\nprint()\nprint('direct (same pattern) vs oracle:', (out_direct - ref).abs().max().item(), ' allclose:', torch.allclose(ref, out_direct, atol=3e-5, rtol=3e-4))\nprint('gram ratio vs oracle:', (out_gram - ref).abs().max().item(), ' allclose:', torch.allclose(ref, out_gram, atol=3e-5, rtol=3e-4))\n\n# Hmm so even the direct computation (same pattern) has 0 error? Let me check...\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

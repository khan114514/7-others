{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math\ntorch.set_num_threads(1)\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\ng = torch.Generator(); g.manual_seed(17*1009+3)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g)\nwk = torch.randn(H, D, C, generator=g)\nwv = torch.randn(H, D, C, generator=g)\n\n# Full step-by-step comparison\n# Reference\nq_ref = torch.einsum('blc,hdc->bhld', x, wq)\nk_ref = torch.einsum('blc,hdc->bhld', x, wk)\nlogits_ref = (q_ref @ k_ref.transpose(-1, -2)) / math.sqrt(D)\np0_ref = logits_ref.softmax(dim=-1)\nperturbed_ref = .5 * (1 + alpha) * logits_ref + .5 * (1 - alpha) * logits_ref.transpose(-1, -2)\np1_ref = perturbed_ref.softmax(dim=-1)\nu0_ref = p0_ref @ x.unsqueeze(1)\nu1_ref = p1_ref @ x.unsqueeze(1)\nm_ref = u0_ref + beta * (u1_ref - u0_ref)\nnorm1_ref = u1_ref.norm(dim=-1, keepdim=True).clamp_min(1e-6)\nnormm_ref = m_ref.norm(dim=-1, keepdim=True).clamp_min(1e-6)\nratio_ref = (norm1_ref / normm_ref).clamp(.25, 4.)\ny_ref = torch.einsum('bhlc,hdc->bhld', m_ref * ratio_ref, wv)\n\n# Current optimized\nHD = H * D\nxr = x.reshape(B * L, C)\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nv = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nlogits = q @ k.transpose(-1, -2)\nlogits.mul_(1.0 / math.sqrt(D))\np0 = logits.softmax(dim=-1)\na_p = 0.5 * (1.0 + alpha)\na_m = 0.5 * (1.0 - alpha)\np1_logits = logits.mul(a_p)\np1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\np1 = p1_logits.softmax(dim=-1)\np_mix = torch.lerp(p0, p1, beta)\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\np1G = p1 @ G_exp\nnorm1_sq = p1G.mul(p1).sum(dim=-1, keepdim=True)\npmG = p_mix @ G_exp\nnormm_sq = pmG.mul(p_mix).sum(dim=-1, keepdim=True)\nnorm1 = norm1_sq.sqrt().clamp_min(1e-6)\nnormm = normm_sq.sqrt().clamp_min(1e-6)\nratio = (norm1 / normm).clamp(0.25, 4.0)\nm = p_mix @ v\ny = m * ratio\n# Final output\nout_ref = y_ref.transpose(1, 2).flatten(2).contiguous()\nout_opt = y.transpose(1, 2).flatten(2).contiguous()\n\n# Track error sources\nprint('q diff:', (q - q_ref).abs().max())\nprint('k diff:', (k - k_ref).abs().max())\nprint('logits diff:', (logits - logits_ref).abs().max())\nprint('p0 diff:', (p0 - p0_ref).abs().max())\nprint('p1 diff:', (p1 - p1_ref).abs().max())\nprint('p_mix vs (1-beta)*p0+beta*p1:', (p_mix - ((1-beta)*p0 + beta*p1_ref)).abs().max())\nprint()\n# Now compute m directly using x (like baseline) vs using v\n# m should = p_mix @ x per head (in C dimensions)\n# v = x @ wv\"'^T per head, shape (B,H,L,D)\n# m_v = p_mix @ v gives output in D dims, then multiplied by wv\n# baseline: m_c = p_mix @ x (C dims), then m_c @ wv''^T\n# These are mathematically equal: (p_mix @ x) @ wv''^T = p_mix @ (x @ wv''^T)\nm_c_ref = p_mix @ x.unsqueeze(1)  # (B,H,L,C)\ny_from_mc = torch.einsum('\"'bhlc,hdc->bhld', m_c_ref * ratio_ref, wv)\nprint('y from m_c (reference) vs from v (current):', (y_from_mc - y).abs().max())\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

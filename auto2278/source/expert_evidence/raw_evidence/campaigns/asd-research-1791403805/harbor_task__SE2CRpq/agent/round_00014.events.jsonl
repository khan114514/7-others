{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math, time\ntorch.set_num_threads(1)\n\n# Test SDPA performance on the largest case\nB, L, C, H, D = 1, 256, 1280, 20, 64\ng = torch.Generator(); g.manual_seed(17*1009+3)\nq = torch.randn(B, H, L, D, generator=g)\nk = torch.randn(B, H, L, D, generator=g)\nv = torch.randn(B, H, L, D, generator=g)\n\ndef time_fn(fn, n=20, warmup=5):\n    for _ in range(warmup):\n        fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return sorted(times)[len(times)//2]\n\ndef manual_attn():\n    logits = q @ k.transpose(-1, -2) / math.sqrt(D)\n    p = logits.softmax(dim=-1)\n    return p @ v\n\ndef sdpa():\n    return torch.nn.functional.scaled_dot_product_attention(q, k, v)\n\nprint('Manual:', time_fn(manual_attn), 'ms')\nprint('SDPA:', time_fn(sdpa), 'ms')\nout_manual = manual_attn()\nout_sdpa = sdpa()\nprint('Max diff:', (out_manual - out_sdpa).abs().max())\nprint('SDPA available backends:', torch.backends.cuda, torch.backends.mkl)\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math, time\ntorch.set_num_threads(1)\n\n# Test SDPA performance on the largest case\nB, L, C, H, D = 1, 256, 1280, 20, 64\ng = torch.Generator(); g.manual_seed(17*1009+3)\nq = torch.randn(B, H, L, D, generator=g)\nk = torch.randn(B, H, L, D, generator=g)\nv = torch.randn(B, H, L, D, generator=g)\n\ndef time_fn(fn, n=20, warmup=5):\n    for _ in range(warmup):\n        fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return sorted(times)[len(times)//2]\n\ndef manual_attn():\n    logits = q @ k.transpose(-1, -2) / math.sqrt(D)\n    p = logits.softmax(dim=-1)\n    return p @ v\n\ndef sdpa():\n    return torch.nn.functional.scaled_dot_product_attention(q, k, v)\n\nprint('Manual:', time_fn(manual_attn), 'ms')\nprint('SDPA:', time_fn(sdpa), 'ms')\nout_manual = manual_attn()\nout_sdpa = sdpa()\nprint('Max diff:', (out_manual - out_sdpa).abs().max())\nprint('SDPA available backends:', torch.backends.cuda, torch.backends.mkl)\n\\\"\n\"","aggregated_output":"Manual: 13.134667 ms\nSDPA: 12.405417 ms\nMax diff: tensor(7.1526e-07)\nSDPA available backends: <module 'torch.backends.cuda' from '/usr/local/lib/python3.12/site-packages/torch/backends/cuda/__init__.py'> <module 'torch.backends.mkl' from '/usr/local/lib/python3.12/site-packages/torch/backends/mkl/__init__.py'>\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math, time\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\ng = torch.Generator(); g.manual_seed(17*1009+3)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g)\nwk = torch.randn(H, D, C, generator=g)\nwv = torch.randn(H, D, C, generator=g)\n\ndef time_fn(fn, n=11, warmup=3):\n    for _ in range(warmup):\n        fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return sorted(times)[len(times)//2]\n\nHD = H * D\nxr = x.reshape(B * L, C)\n\n# Current best\ndef current():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    p1G = p1 @ G_exp\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# With SDPA for p0 and p1 output computations\ndef with_sdpa():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    \n    # Compute p0 output via SDPA\n    u0_v = torch.nn.functional.scaled_dot_product_attention(q, k, v)\n    \n    # Compute p1: need symmetrized attention\n    # Can we compute p1 output via SDPA? Not directly since p1 is from symmetrized logits\n    # But we can compute logits, symmetrize, softmax, then @ v\n    \n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    \n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    p1G = p1 @ G_exp\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    \n    # Instead of p_mix @ v, compute from u0_v and p1 @ v\n    u1_v = p1 @ v\n    y = torch.lerp(u0_v, u1_v, beta).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\nprint('Current:', time_fn(current), 'ms')\nprint('With SDPA:', time_fn(with_sdpa), 'ms')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math, time\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\ng = torch.Generator(); g.manual_seed(17*1009+3)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g)\nwk = torch.randn(H, D, C, generator=g)\nwv = torch.randn(H, D, C, generator=g)\n\ndef time_fn(fn, n=11, warmup=3):\n    for _ in range(warmup):\n        fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return sorted(times)[len(times)//2]\n\nHD = H * D\nxr = x.reshape(B * L, C)\n\n# Current best\ndef current():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    p1G = p1 @ G_exp\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# With SDPA for p0 and p1 output computations\ndef with_sdpa():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    \n    # Compute p0 output via SDPA\n    u0_v = torch.nn.functional.scaled_dot_product_attention(q, k, v)\n    \n    # Compute p1: need symmetrized attention\n    # Can we compute p1 output via SDPA? Not directly since p1 is from symmetrized logits\n    # But we can compute logits, symmetrize, softmax, then @ v\n    \n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    \n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    p1G = p1 @ G_exp\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    \n    # Instead of p_mix @ v, compute from u0_v and p1 @ v\n    u1_v = p1 @ v\n    y = torch.lerp(u0_v, u1_v, beta).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\nprint('Current:', time_fn(current), 'ms')\nprint('With SDPA:', time_fn(with_sdpa), 'ms')\n\\\"\n\"","aggregated_output":"Current: 134.684584 ms\nWith SDPA: 132.742208 ms\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math, time\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\ng = torch.Generator(); g.manual_seed(17*1009+3)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g)\nwk = torch.randn(H, D, C, generator=g)\nwv = torch.randn(H, D, C, generator=g)\n\ndef time_fn(fn, n=20, warmup=5):\n    for _ in range(warmup):\n        fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return sorted(times)[len(times)//2]\n\nHD = H * D\nxr = x.reshape(B * L, C)\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nv = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\ninv_sqrt_d = 1.0 / math.sqrt(D)\n\n# Time individual components\ndef t_qk():\n    return q @ k.transpose(-1, -2) * inv_sqrt_d\n\ndef t_softmax(logits):\n    return logits.softmax(dim=-1)\n\nlogits = t_qk()\np0 = logits.softmax(dim=-1)\n\ndef t_pv():\n    return p0 @ v\n\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\n\ndef t_gram_mul():\n    return p0 @ G_exp\n\nprint('q@k + scale:', time_fn(t_qk), 'ms')\nprint('softmax:', time_fn(lambda: logits.softmax(dim=-1)), 'ms')\nprint('p@v:', time_fn(t_pv), 'ms')\nprint('p@G (gram):', time_fn(t_gram_mul), 'ms')\nprint()\n\n# Time projections\ndef t_proj_q():\n    return (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\ndef t_proj_all():\n    q_ = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k_ = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v_ = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    return q_, k_, v_\n\nprint('All 3 projections:', time_fn(t_proj_all), 'ms')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

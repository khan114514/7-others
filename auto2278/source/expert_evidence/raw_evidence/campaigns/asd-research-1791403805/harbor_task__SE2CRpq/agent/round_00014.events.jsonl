{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math, time\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\ng = torch.Generator(); g.manual_seed(17*1009+3)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g)\nwk = torch.randn(H, D, C, generator=g)\nwv = torch.randn(H, D, C, generator=g)\n\ndef time_fn(fn, n=11, warmup=3):\n    for _ in range(warmup):\n        fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return sorted(times)[len(times)//2]\n\nHD = H * D\nxr = x.reshape(B * L, C)\n\n# Current best\ndef current():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    p1G = p1 @ G_exp\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Optimized: fused p0+p1 stacked gram, derived normm\ndef opt_stacked():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    \n    # Stack p0 and p1 along head dim for fused gram multiplication\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    stacked_p = torch.cat([p0, p1], dim=2)  # (B, H, 2L, L)\n    stacked_G = stacked_p @ G_exp  # (B, H, 2L, L)\n    p0G = stacked_G[:, :, :L, :]\n    p1G = stacked_G[:, :, L:, :]\n    \n    norm0_sq = p0G.mul(p0).sum(dim=-1, keepdim=True)\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    cross = p0G.mul_(p1).sum(dim=-1, keepdim=True)\n    \n    b = beta\n    omb = 1.0 - beta\n    normm_sq = omb*omb * norm0_sq + b*b * norm1_sq + 2*omb*b * cross\n    \n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    \n    p_mix = torch.lerp(p0, p1, beta)\n    y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\nprint('Current:', time_fn(current), 'ms')\nprint('Stacked:', time_fn(opt_stacked), 'ms')\nref = current()\nopt = opt_stacked()\nprint('Max diff:', (ref - opt).abs().max())\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math, time\ntorch.set_num_threads(1)\n\n# Test multiple cases\ncases = [\n    (1, 64, 512, 8, 64, 1.05, 5.0),\n    (1, 128, 640, 10, 64, 1.1, 4.0),\n    (1, 128, 1280, 20, 64, 1.15, 3.0),\n    (1, 256, 1280, 20, 64, 1.05, 7.5),\n    (1, 256, 640, 10, 64, 1.2, 5.0),\n    (2, 128, 512, 8, 64, 1.0, 5.0),\n]\n\ndef time_fn(fn, n=11, warmup=3):\n    for _ in range(warmup):\n        fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return sorted(times)[len(times)//2]\n\nfor i, (B, L, C, H, D, alpha, beta) in enumerate(cases):\n    g = torch.Generator(); g.manual_seed(17*1009 + i)\n    x = torch.randn(B, L, C, generator=g)\n    wq = torch.randn(H, D, C, generator=g)\n    wk = torch.randn(H, D, C, generator=g)\n    wv = torch.randn(H, D, C, generator=g)\n    \n    HD = H * D\n    xr = x.reshape(B * L, C)\n    \n    def current_4d():\n        q4 = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n        k4 = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n        v4 = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n        inv_sqrt_d = 1.0 / math.sqrt(D)\n        logits = q4 @ k4.transpose(-1, -2)\n        logits.mul_(inv_sqrt_d)\n        p0 = logits.softmax(dim=-1)\n        if alpha == 1.0:\n            y = p0 @ v4\n        else:\n            a_p = 0.5 * (1.0 + alpha)\n            a_m = 0.5 * (1.0 - alpha)\n            p1_logits = logits.mul(a_p)\n            p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n            p1 = p1_logits.softmax(dim=-1)\n            p_mix = torch.lerp(p0, p1, beta)\n            G = x @ x.transpose(-1, -2)\n            G_exp = G.unsqueeze(1)\n            p1G = p1 @ G_exp\n            norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n            pmG = p_mix @ G_exp\n            normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n            norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n            normm = normm_sq.sqrt_().clamp_min_(1e-6)\n            ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n            y = (p_mix @ v4).mul_(ratio)\n        return y.transpose(1, 2).flatten(2).contiguous()\n\n    def flat_full():\n        qf = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).reshape(B*H, L, D).contiguous()\n        kf = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).reshape(B*H, L, D).contiguous()\n        vf = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).reshape(B*H, L, D).contiguous()\n        inv_sqrt_d = 1.0 / math.sqrt(D)\n        logits = torch.bmm(qf, kf.transpose(-1, -2))\n        logits.mul_(inv_sqrt_d)\n        p0 = logits.softmax(dim=-1)\n        if alpha == 1.0:\n            y = torch.bmm(p0, vf)\n        else:\n            a_p = 0.5 * (1.0 + alpha)\n            a_m = 0.5 * (1.0 - alpha)\n            p1_logits = logits.mul(a_p)\n            p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n            p1 = p1_logits.softmax(dim=-1)\n            p_mix = torch.lerp(p0, p1, beta)\n            Gf = (x @ x.transpose(-1, -2)).expand(B, H, L, L).reshape(B*H, L, L).contiguous()\n            p1G = torch.bmm(p1, Gf)\n            norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n            pmG = torch.bmm(p_mix, Gf)\n            normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n            norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n            normm = normm_sq.sqrt_().clamp_min_(1e-6)\n            ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n            y = torch.bmm(p_mix, vf).mul_(ratio)\n        return y.reshape(B, H, L, D).transpose(1, 2).flatten(2).contiguous()\n    \n    t4 = time_fn(current_4d)\n    tf = time_fn(flat_full)\n    diff = (current_4d() - flat_full()).abs().max()\n    print(f'Case {i}: B={B} L={L} C={C} H={H} D={D}  4D={t4:.1f}ms  flat={tf:.1f}ms  speedup={t4/tf:.2f}x  diff={diff:.2e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

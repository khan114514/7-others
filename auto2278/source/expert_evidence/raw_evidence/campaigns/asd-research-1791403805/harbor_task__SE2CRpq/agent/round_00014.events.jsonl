{"type":"item.started","item":{"id":"item_70","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 << 'PYEOF'\nimport torch, math, time\ntorch.set_num_threads(1)\n\n# Let me try a more impactful optimization: \n# Instead of computing p_mix @ G and p1 @ G separately (2 matmuls),\n# compute them as a single batched matmul\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\ng = torch.Generator().manual_seed(17 * 1009 + 3)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwv = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n\ndef time_fn(fn, n=20, warmup=5):\n    for _ in range(warmup):\n        fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return sorted(times)[len(times)//2]\n\nHD = H * D\nxr = x.reshape(B * L, C)\ninv_sqrt_d = 1.0 / math.sqrt(D)\na_p = 0.5 * (1.0 + alpha)\na_m = 0.5 * (1.0 - alpha)\n\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nv = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nlogits = q @ k.transpose(-1, -2)\nlogits.mul_(inv_sqrt_d)\np0 = logits.softmax(dim=-1)\np1_logits = logits.mul(a_p)\np1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\np1 = p1_logits.softmax(dim=-1)\np_mix = torch.lerp(p0, p1, beta)\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\n\n# Current approach: 2 separate matmuls\ndef current_gram():\n    p1G = p1 @ G_exp\n    norm1_sq = p1G.mul(p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = pmG.mul(p_mix).sum(dim=-1, keepdim=True)\n    return norm1_sq, normm_sq\n\n# Fused: stack p1 and p_mix along a new dim, single matmul\ndef fused_gram():\n    stacked = torch.cat([p1, p_mix], dim=2)  # (B, H, 2L, L)\n    sG = stacked @ G_exp  # (B, H, 2L, L)\n    p1G = sG[:, :, :L, :]\n    pmG = sG[:, :, L:, :]\n    norm1_sq = p1G.mul(p1).sum(dim=-1, keepdim=True)\n    normm_sq = pmG.mul(p_mix).sum(dim=-1, keepdim=True)\n    return norm1_sq, normm_sq\n\n# Alternative: reshape to (2*B*H, L, L) and bmm\ndef bmm_gram():\n    p1_f = p1.reshape(B*H, L, L)\n    pm_f = p_mix.reshape(B*H, L, L)\n    stacked = torch.cat([p1_f, pm_f], dim=0)  # (2*B*H, L, L)\n    G_f = G.expand(2*B*H, L, L)\n    sG = torch.bmm(stacked, G_f)\n    p1G = sG[:B*H].reshape(B, H, L, L)\n    pmG = sG[B*H:].reshape(B, H, L, L)\n    norm1_sq = p1G.mul(p1).sum(dim=-1, keepdim=True)\n    normm_sq = pmG.mul(p_mix).sum(dim=-1, keepdim=True)\n    return norm1_sq, normm_sq\n\nprint('Current 2-matmuls:', time_fn(current_gram), 'ms')\nprint('Fused stacked:', time_fn(fused_gram), 'ms')\nprint('Bmm stacked:', time_fn(bmm_gram), 'ms')\n\nr1a, r1b = current_gram()\nr2a, r2b = fused_gram()\nr3a, r3b = bmm_gram()\nprint('Same (fused):', (r1a - r2a).abs().max().item(), (r1b - r2b).abs().max().item())\nprint('Same (bmm):', (r1a - r3a).abs().max().item(), (r1b - r3b).abs().max().item())\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_69","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 << 'PYEOF'\nimport torch, math, time\ntorch.set_num_threads(1)\n\n# Largest case for profiling\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\ng = torch.Generator().manual_seed(17 * 1009 + 3)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwv = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n\ndef time_fn(fn, n=20, warmup=5):\n    for _ in range(warmup):\n        fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return sorted(times)[len(times)//2]\n\nHD = H * D\nxr = x.reshape(B * L, C)\ninv_sqrt_d = 1.0 / math.sqrt(D)\na_p = 0.5 * (1.0 + alpha)\na_m = 0.5 * (1.0 - alpha)\n\n# Current\ndef current():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    p1G = p1 @ G_exp\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Test: compute G earlier (it doesn't depend on attention)\n# Test: avoid contiguous on v (since we only do p @ v where v is last dim contiguous)\ndef opt_no_v_contig():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    # v doesn't need to be contiguous for p @ v (only last dim is contracted)\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    p1G = p1 @ G_exp\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Test: use a different approach for computing p_mix @ v and the ratio\n# What if we compute ratio first then apply to v before p_mix @ v?\n# No, ratio is per-token, so it applies after p_mix @ v (or before p_mix, same thing)\n\n# Test: fuse the ratio multiplication into p_mix before matmul\n# ratio: (B,H,L,1), p_mix: (B,H,L,L)\n# (p_mix * ratio) @ v = p_mix @ v * ratio (they're equivalent: ratio is per output row)\n# So we can scale p_mix first then do p_mix @ v\n# Actually no, scaling p_mix (B,H,L,L) is more elements than scaling output (B,H,L,D)\n# L=256, D=64, so L > D, scaling output is cheaper\n\n# Test: skip the p_mix allocation and compute y directly from p0 and p1\n# y = ((1-beta)*p0 + beta*p1) @ v * ratio\n# = (1-beta) * (p0 @ v) * ratio + beta * (p1 @ v) * ratio\n# But we need p_mix for the gram norm computation anyway\n\nprint('Current:', time_fn(current), 'ms')\nprint('No v contiguous:', time_fn(opt_no_v_contig), 'ms')\n\n# Let me check correctness\nref = current()\nopt = opt_no_v_contig()\nprint('Diff:', (ref - opt).abs().max().item())\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

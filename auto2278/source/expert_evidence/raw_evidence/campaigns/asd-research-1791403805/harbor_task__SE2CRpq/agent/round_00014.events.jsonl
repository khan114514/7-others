pe(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    \n    # Stack p0 and p1 along head dim for fused gram multiplication\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    stacked_p = torch.cat([p0, p1], dim=2)  # (B, H, 2L, L)\n    stacked_G = stacked_p @ G_exp  # (B, H, 2L, L)\n    p0G = stacked_G[:, :, :L, :]\n    p1G = stacked_G[:, :, L:, :]\n    \n    norm0_sq = p0G.mul(p0).sum(dim=-1, keepdim=True)\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    cross = p0G.mul_(p1).sum(dim=-1, keepdim=True)\n    \n    b = beta\n    omb = 1.0 - beta\n    normm_sq = omb*omb * norm0_sq + b*b * norm1_sq + 2*omb*b * cross\n    \n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    \n    p_mix = torch.lerp(p0, p1, beta)\n    y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\nprint('Current:', time_fn(current), 'ms')\nprint('Stacked:', time_fn(opt_stacked), 'ms')\nref = current()\nopt = opt_stacked()\nprint('Max diff:', (ref - opt).abs().max())\n\\\"\n\"","aggregated_output":"Current: 114.678416 ms\nStacked: 114.939083 ms\nMax diff: tensor(0.0008)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math, time\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\ng = torch.Generator(); g.manual_seed(17*1009+3)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g)\nwk = torch.randn(H, D, C, generator=g)\nwv = torch.randn(H, D, C, generator=g)\n\ndef time_fn(fn, n=20, warmup=5):\n    for _ in range(warmup):\n        fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return sorted(times)[len(times)//2]\n\nHD = H * D\nxr = x.reshape(B * L, C)\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nv = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nlogits = q @ k.transpose(-1, -2) / math.sqrt(D)\np0 = logits.softmax(dim=-1)\na_p = 0.5 * (1.0 + alpha); a_m = 0.5 * (1.0 - alpha)\np1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\n\n# How much does softmax cost?\nprint('softmax:', time_fn(lambda: logits.softmax(dim=-1)), 'ms')\n\n# Try the torch._softmax internal?\nprint('log_softmax:', time_fn(lambda: logits.log_softmax(dim=-1)), 'ms')\n\n# What about manual softmax?\ndef manual_softmax():\n    m = logits.max(dim=-1, keepdim=True).values\n    e = (logits - m).exp_()\n    return e.div_(e.sum(dim=-1, keepdim=True))\nprint('manual softmax:', time_fn(manual_softmax), 'ms')\nms = manual_softmax()\nts = logits.softmax(dim=-1)\nprint('manual vs torch:', (ms - ts).abs().max())\nprint()\n\n# What about the Gram computation: x @ x.T part?\nprint('G = x @ x.T:', time_fn(lambda: x @ x.transpose(-1, -2)), 'ms')\n\n# Can we compute G as G = x.matmul(x.T)? Same thing.\n\n# Actually, let me think about a totally different approach.\n# The norm ratio is: ||u1|| / ||m|| where u1 = p1@x, m = (1-b)*p0@x + b*p1@x\n# The ratio scales m to have the same norm as u1... \n# Wait, actually: r = clamp(||u1||/||m||, 0.25, 4)\n# output = r * m * wv\"'^T = r * (p_mix @ x) * wv''^T\n\n# Hmm, can we avoid computing m in C-space entirely?\n# We have: output = r * p_mix @ (x @ wv''^T)  [in D-space] = r * p_mix @ v\n# But r depends on ||u1|| and ||m|| which are in C-space.\n# So we need the norms (C-space), but output is D-space.\n\n# Can we compute ||p@x|| more efficiently than gram?\n# Actually gram IS efficient: G = x @ x.T (L*L*C), then (p@G)*p sum (H*L*L + H*L*L)\n# = L*L*C + 2*H*L*L = 256*256*1280 + 2*20*256*256 = 84M + 2.6M = 86.6M\n# vs direct: p @ x = H*L*L*C = 20*256*256*1280 = 1.68B\n# Gram is 20x more efficient for norms.\n\n# OK so gram is great. Let me think about what else we can optimize.\n# The projections (3 * L*C*H*D = 3 * 256*1280*20*64 = 3*420M = 1.26B) are the biggest cost.\n# Can we reduce projection cost? Not really, they'\"'re necessary.\n\n# Wait - wq, wk, wv have shape (H, D, C). What if we reshape them differently?\n# Current: w.reshape(HD, C).T gives (C, HD), then xr @ w.T gives (B*L, HD)\n# That's B*L * C * HD = 256 * 1280 * 1280 = 419M per projection, 1.26B total\n\n# Is there a way to do projections faster? MKL is already optimized.\n# What about using torch.addmm or other variants? No, just matmul.\n\n# Let me look at what takes time more carefully with a simple profile\nimport cProfile, pstats, io\n\ndef full():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    p1G = p1 @ G_exp\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\nfor _ in range(3):\n    full()\n\n# Use time around each major step\nt0 = time.process_time_ns()\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nt1 = time.process_time_ns()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nt2 = time.process_time_ns()\nv = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nt3 = time.process_time_ns()\nlogits = q @ k.transpose(-1, -2)\nlogits.mul_(1.0/math.sqrt(D))\nt4 = time.process_time_ns()\np0 = logits.softmax(dim=-1)\nt5 = time.process_time_ns()\na_p = 0.5 * (1.0 + alpha); a_m = 0.5 * (1.0 - alpha)\np1_logits = logits.mul(a_p)\np1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\np1 = p1_logits.softmax(dim=-1)\nt6 = time.process_time_ns()\np_mix = torch.lerp(p0, p1, beta)\nt7 = time.process_time_ns()\nG = x @ x.transpose(-1, -2)\nt8 = time.process_time_ns()\nG_exp = G.unsqueeze(1)\np1G = p1 @ G_exp\nt9 = time.process_time_ns()\nnorm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\npmG = p_mix @ G_exp\nt10 = time.process_time_ns()\nnormm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\nnorm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\nnormm = normm_sq.sqrt_().clamp_min_(1e-6)\nratio = norm1.div_(normm).clamp_(0.25, 4.0)\nt11 = time.process_time_ns()\ny = (p_mix @ v).mul_(ratio)\nt12 = time.process_time_ns()\nout = y.transpose(1, 2).flatten(2).contiguous()\nt13 = time.process_time_ns()\n\nprint()\nprint('--- Per-step timing ---')\nprint(f'q proj: {(t1-t0)/1e6:.2f} ms')\nprint(f'k proj: {(t2-t1)/1e6:.2f} ms')\nprint(f'v proj: {(t3-t2)/1e6:.2f} ms')\nprint(f'q@k + scale: {(t4-t3)/1e6:.2f} ms')\nprint(f'p0 softmax: {(t5-t4)/1e6:.2f} ms')\nprint(f'p1 logits + softmax: {(t6-t5)/1e6:.2f} ms')\nprint(f'p_mix lerp: {(t7-t6)/1e6:.2f} ms')\nprint(f'G = x@x.T: {(t8-t7)/1e6:.2f} ms')\nprint(f'p1@G: {(t9-t8)/1e6:.2f} ms')\nprint(f'p_mix@G: {(t10-t9)/1e6:.2f} ms')\nprint(f'norm + ratio: {(t11-t10)/1e6:.2f} ms')\nprint(f'p_mix@v + ratio: {(t12-t11)/1e6:.2f} ms')\nprint(f'transpose + flatten: {(t13-t12)/1e6:.2f} ms')\nprint(f'Total: {(t13-t0)/1e6:.2f} ms')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

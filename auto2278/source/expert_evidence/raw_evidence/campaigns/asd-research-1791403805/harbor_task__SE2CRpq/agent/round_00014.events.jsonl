{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport re\nfrom pathlib import Path\ng = Path('/workspace/environment/public_eval/grader.py').read_text()\n# Find the error check function\nidx = g.find('def run_case')\nprint(g[idx:idx+3000])\n\\\"\n\"","aggregated_output":"def run_case(source, values, protocol, scratch):\n    input_path = scratch / \"input.npz\"\n    output_path = scratch / \"output.npz\"\n    # The prior input is read-only. Replace it instead of attempting to reopen it\n    # for writing when public grading runs as the unprivileged Agent user.\n    input_path.unlink(missing_ok=True)\n    arrays = {name: t.numpy() for name, t in zip((\"x\", \"wq\", \"wk\", \"wv\"), values[:4])}\n    np.savez(input_path, **arrays, alpha=values[4], beta=values[5],\n             warmup=protocol[\"warmup\"], repeats=protocol[\"timed_repeats\"])\n    input_path.chmod(0o444)\n    output_path.unlink(missing_ok=True)\n    try:\n        p = subprocess.run([sys.executable, \"-I\", str(ROOT / \"worker.py\"), str(source),\n                            str(input_path), str(output_path)], cwd=scratch,\n                           env={\"PATH\": os.environ.get(\"PATH\", \"/usr/local/bin:/usr/bin:/bin\"),\n                                \"HOME\": str(scratch), \"OMP_NUM_THREADS\": \"1\", \"OPENBLAS_NUM_THREADS\": \"1\",\n                                \"MKL_NUM_THREADS\": \"1\", \"PYTHONDONTWRITEBYTECODE\": \"1\"},\n                           preexec_fn=worker_limits, capture_output=True, text=True, timeout=120)\n    except subprocess.TimeoutExpired:\n        raise Invalid(\"timeout\", \"One case exceeded 120 seconds.\")\n    if p.returncode != 0:\n        for line in p.stdout.splitlines():\n            try:\n                report = json.loads(line)\n            except json.JSONDecodeError:\n                continue\n            if report.get(\"worker_failure\") in {\"hard_gate\", \"format_error\"}:\n                raise Invalid(report[\"worker_failure\"], report[\"message\"])\n        kind = \"resource_error\" if p.returncode < 0 else \"candidate_error\"\n        raise Invalid(kind, p.stderr[-2000:])\n    if not output_path.is_file() or output_path.is_symlink() or output_path.stat().st_size > 256 * 1024 * 1024:\n        raise Invalid(\"format_error\", \"Worker did not produce a valid output array.\")\n    data = np.load(output_path, allow_pickle=False)\n    if not bool(data[\"input_unchanged\"]):\n        raise Invalid(\"hard_gate\", \"Candidate modified input tensors.\")\n    actual = torch.from_numpy(data[\"output\"].copy())\n    expected = oracle(values)\n    if actual.shape != expected.shape or actual.dtype != expected.dtype or not torch.isfinite(actual).all():\n        raise Invalid(\"hard_gate\", \"Output shape, dtype or finiteness failed.\")\n    if not torch.allclose(actual, expected, **protocol[\"quality\"]):\n        raise Invalid(\"hard_gate\", f\"Numerical correctness failed; max abs error={float((actual-expected).abs().max()):.8g}.\")\n    samples = data[\"samples\"].tolist()\n    if len(samples) != protocol[\"timed_repeats\"] or not all(math.isfinite(t) and t > 0 for t in samples):\n        raise Invalid(\"format_error\", \"Invalid timing samples.\")\n    return {\"latency_ms\": statistics.median(samples), \"samples_ms\": samples,\n            \"wall_latency_ms\": statistics.median(data[\"wall_samples\"].tolist()),\n            \"wall_samples_ms\": data[\"wall\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math\ntorch.set_num_threads(1)\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\ng = torch.Generator(); g.manual_seed(17*1009+3)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g)\nwk = torch.randn(H, D, C, generator=g)\nwv = torch.randn(H, D, C, generator=g)\n\ndef baseline():\n    q = torch.einsum('blc,hdc->bhld', x, wq)\n    k = torch.einsum('blc,hdc->bhld', x, wk)\n    logits = (q @ k.transpose(-1, -2)) / math.sqrt(D)\n    p0 = logits.softmax(dim=-1)\n    base = p0 @ x.unsqueeze(1)\n    perturbed = .5 * (1 + alpha) * logits + .5 * (1 - alpha) * logits.transpose(-1, -2)\n    modified = perturbed.softmax(dim=-1) @ x.unsqueeze(1)\n    blended = base + beta * (modified - base)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    y = torch.einsum('bhlc,hdc->bhld', blended * ratio, wv)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ndef current():\n    HD = H * D\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    p1G = p1 @ G_exp\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\nref = baseline()\ncur = current()\nprint('allclose:', torch.allclose(ref, cur, atol=3e-5, rtol=3e-4))\nprint()\n# Find max relative error\nabs_err = (cur - ref).abs()\nrel_err = abs_err / (3e-5 + 3e-4 * ref.abs())\nprint(f'Max abs error: {abs_err.max():.6e}')\nprint(f'Max relative violation: {rel_err.max():.4f}x tolerance')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

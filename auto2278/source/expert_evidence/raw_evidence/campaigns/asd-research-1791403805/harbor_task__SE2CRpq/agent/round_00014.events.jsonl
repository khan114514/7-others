{"type":"item.started","item":{"id":"item_63","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 << 'PYEOF'\nimport torch, math\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 640, 10, 64\nalpha, beta = 1.2, 5.0\ng = torch.Generator(); g.manual_seed(17*1009 + 4)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g)\nwk = torch.randn(H, D, C, generator=g)\nwv = torch.randn(H, D, C, generator=g)\n\nHD = H * D\nxr = x.reshape(B * L, C)\ninv_sqrt_d = 1.0 / math.sqrt(D)\na_p = 0.5 * (1.0 + alpha)\na_m = 0.5 * (1.0 - alpha)\n\ndef oracle():\n    q = torch.einsum('blc,hdc->bhld', x, wq)\n    k = torch.einsum('blc,hdc->bhld', x, wk)\n    logits = q @ k.transpose(-1, -2) / math.sqrt(D)\n    p0 = logits.softmax(-1)\n    p1 = (.5 * (1 + alpha) * logits + .5 * (1 - alpha) * logits.transpose(-1, -2)).softmax(-1)\n    base, modified = p0 @ x.unsqueeze(1), p1 @ x.unsqueeze(1)\n    mix = base + beta * (modified - base)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / mix.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    return torch.einsum('bhlc,hdc->bhld', mix * ratio, wv).transpose(1, 2).flatten(2).contiguous()\n\nref = oracle()\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nlogits = q @ k.transpose(-1, -2) * inv_sqrt_d\np0 = logits.softmax(-1)\n\n# Use out-of-place p1 (matching oracle's computation order)\np1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(-1)\np_mix = torch.lerp(p0, p1, beta)\n\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\n\n# v-first approach\nv = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nnorm1_sq = (p1 @ G_exp).mul(p1).sum(dim=-1, keepdim=True)\nnormm_sq = (p_mix @ G_exp).mul(p_mix).sum(dim=-1, keepdim=True)\nnorm1_g = norm1_sq.sqrt().clamp_min(1e-6)\nnormm_g = normm_sq.sqrt().clamp_min(1e-6)\nratio_g = (norm1_g / normm_g).clamp(0.25, 4.0)\ny = (p_mix @ v) * ratio_g\nout = y.transpose(1, 2).flatten(2).contiguous()\nprint('v-first + gram (out-of-place p1):', (out - ref).abs().max().item(), ' allclose:', torch.allclose(ref, out, atol=3e-5, rtol=3e-4))\n\n# Let's test all cases with this fixed version\ncases = [\n    (1, 64, 512, 8, 64, 1.05, 5.0),\n    (1, 128, 640, 10, 64, 1.1, 4.0),\n    (1, 128, 1280, 20, 64, 1.15, 3.0),\n    (1, 256, 1280, 20, 64, 1.05, 7.5),\n    (1, 256, 640, 10, 64, 1.2, 5.0),\n    (2, 128, 512, 8, 64, 1.0, 5.0),\n]\n\nprint()\nprint('--- All cases (out-of-place p1 + v-first + gram) ---')\nimport time\ndef time_fn(fn, n=11, warmup=3):\n    for _ in range(warmup):\n        fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return sorted(times)[len(times)//2]\n\nfor i, (B2, L2, C2, H2, D2, alpha2, beta2) in enumerate(cases):\n    g2 = torch.Generator(); g2.manual_seed(17*1009 + i)\n    x2 = torch.randn(B2, L2, C2, generator=g2)\n    wq2 = torch.randn(H2, D2, C2, generator=g2)\n    wk2 = torch.randn(H2, D2, C2, generator=g2)\n    wv2 = torch.randn(H2, D2, C2, generator=g2)\n    HD2 = H2 * D2\n    xr2 = x2.reshape(B2 * L2, C2)\n    isd = 1.0 / math.sqrt(D2)\n    ap = 0.5 * (1.0 + alpha2)\n    am = 0.5 * (1.0 - alpha2)\n    \n    def sol():\n        qq = (xr2 @ wq2.reshape(HD2, C2).T).reshape(B2, L2, H2, D2).permute(0, 2, 1, 3).contiguous()\n        kk = (xr2 @ wk2.reshape(HD2, C2).T).reshape(B2, L2, H2, D2).permute(0, 2, 1, 3).contiguous()\n        vv = (xr2 @ wv2.reshape(HD2, C2).T).reshape(B2, L2, H2, D2).permute(0, 2, 1, 3).contiguous()\n        logits_ = qq @ kk.transpose(-1, -2) * isd\n        p0_ = logits_.softmax(dim=-1)\n        if alpha2 == 1.0:\n            y_ = p0_ @ vv\n        else:\n            p1_ = (ap * logits_ + am * logits_.transpose(-1, -2)).softmax(dim=-1)\n            pmix_ = torch.lerp(p0_, p1_, beta2)\n            GG = x2 @ x2.transpose(-1, -2)\n            GGe = GG.unsqueeze(1)\n            n1sq = (p1_ @ GGe).mul(p1_).sum(dim=-1, keepdim=True)\n            nmsq = (pmix_ @ GGe).mul(pmix_).sum(dim=-1, keepdim=True)\n            n1 = n1sq.sqrt().clamp_min(1e-6)\n            nm = nmsq.sqrt().clamp_min(1e-6)\n            r = (n1 / nm).clamp(0.25, 4.0)\n            y_ = (pmix_ @ vv).mul(r)\n        return y_.transpose(1, 2).flatten(2).contiguous()\n    \n    def base():\n        qq = torch.einsum('blc,hdc->bhld', x2, wq2)\n        kk = torch.einsum('blc,hdc->bhld', x2, wk2)\n        logits_ = (qq @ kk.transpose(-1, -2)) / math.sqrt(D2)\n        p0_ = logits_.softmax(dim=-1)\n        base_ = p0_ @ x2.unsqueeze(1)\n        if alpha2 == 1.0:\n            modified_ = base_\n        else:\n            perturbed = .5 * (1 + alpha2) * logits_ + .5 * (1 - alpha2) * logits_.transpose(-1, -2)\n            modified_ = perturbed.softmax(dim=-1) @ x2.unsqueeze(1)\n        blended = base_ + beta2 * (modified_ - base_)\n        r = (modified_.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n        yy = torch.einsum('bhlc,hdc->bhld', blended * r, wv2)\n        return yy.transpose(1, 2).flatten(2).contiguous()\n    \n    tb = time_fn(base)\n    ts = time_fn(sol)\n    ref = base()\n    out = sol()\n    err = (out - ref).abs().max().item()\n    ok = torch.allclose(ref, out, atol=3e-5, rtol=3e-4)\n    print(f'Case {i}: base={tb:.1f}ms  sol={ts:.1f}ms  ratio={ts/tb:.3f}  err={err:.2e}  ok={ok}')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

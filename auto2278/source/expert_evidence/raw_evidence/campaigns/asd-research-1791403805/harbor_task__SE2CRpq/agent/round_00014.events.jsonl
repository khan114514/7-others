{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/sh -lc 'cd /workspace && python3 -c \"\nimport torch, math, time\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\ng = torch.Generator(); g.manual_seed(17*1009+3)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g)\nwk = torch.randn(H, D, C, generator=g)\nwv = torch.randn(H, D, C, generator=g)\n\ndef time_fn(fn, n=11, warmup=3):\n    for _ in range(warmup):\n        fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return sorted(times)[len(times)//2]\n\nHD = H * D\nxr = x.reshape(B * L, C)\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nv = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\ninv_sqrt_d = 1.0 / math.sqrt(D)\nlogits = q @ k.transpose(-1, -2)\nlogits.mul_(inv_sqrt_d)\np0 = logits.softmax(dim=-1)\na_p = 0.5 * (1.0 + alpha); a_m = 0.5 * (1.0 - alpha)\np1_logits = logits.mul(a_p)\np1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\np1 = p1_logits.softmax(dim=-1)\np_mix = torch.lerp(p0, p1, beta)\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\n\n# Verify norm derivation\np0G = p0 @ G_exp\np1G = p1 @ G_exp\npmG = p_mix @ G_exp\n\n# normm_sq = sum_j sum_k (p_mix_ij * p_mix_ik * G_jk)\n# p_mix = (1-b)*p0 + b*p1\n# p_mix_ij * p_mix_ik = (1-b)''^2 * p0_ij * p0_ik + b''^2 * p1_ij * p1_ik + (1-b)*b * (p0_ij*p1_ik + p1_ij*p0_ik)\n# sum over j,k with G_jk:\n# = (1-b)''^2 * norm0_sq + b''^2 * norm1_sq + 2*(1-b)*b * cross\n# where cross = sum_j sum_k p0_ij * p1_ik * G_jk = (p0 @ G) dot p1 = sum_i (p0G * p1)\n\nnorm0_sq = (p0G * p0).sum(dim=-1, keepdim=True)\nnorm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n# cross = (p0G * p1).sum(dim=-1, keepdim=True) -- YES, p0G = p0 @ G, so elementwise * p1 then sum\ncross = (p0G * p1).sum(dim=-1, keepdim=True)\n\nb = beta\nom1 = 1.0 - beta\nnormm_derived = om1*om1 * norm0_sq + b*b * norm1_sq + 2*om1*b * cross\nnormm_direct = (pmG * p_mix).sum(dim=-1, keepdim=True)\n\nprint('\"'normm direct max:', normm_direct.abs().max())\nprint('normm derived max:', normm_derived.abs().max())\nprint('diff:', (normm_direct - normm_derived).abs().max())\nprint('rel diff:', ((normm_direct - normm_derived).abs() / normm_direct.abs()).max())\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

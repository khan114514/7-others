{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math, time\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\ng = torch.Generator(); g.manual_seed(17*1009+3)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g)\nwk = torch.randn(H, D, C, generator=g)\nwv = torch.randn(H, D, C, generator=g)\n\ndef time_fn(fn, n=20, warmup=5):\n    for _ in range(warmup):\n        fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return sorted(times)[len(times)//2]\n\nHD = H * D\nxr = x.reshape(B * L, C)\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nv = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nlogits = q @ k.transpose(-1, -2) / math.sqrt(D)\np0 = logits.softmax(dim=-1)\na_p = 0.5 * (1.0 + alpha); a_m = 0.5 * (1.0 - alpha)\np1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\np_mix = torch.lerp(p0, p1, beta)\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\n\n# Try bmm approach for gram\np1_b = p1.reshape(B*H, L, L)\nG_b = G.expand(B, H, L, L).reshape(B*H, L, L).contiguous()\n\nprint('4D gram p1@G:', time_fn(lambda: p1 @ G_exp), 'ms')\nprint('bmm gram p1@G:', time_fn(lambda: torch.bmm(p1_b, G_b)), 'ms')\nout4 = p1 @ G_exp\noutb = torch.bmm(p1_b, G_b).reshape(B, H, L, L)\nprint('Same?', (out4 - outb).abs().max())\nprint()\n\n# Try batched approach for projections: all 3 at once?\n# w = concat(wq, wk, wv) -> (3*H*D, C), then x @ w\"'^T -> (B*L, 3*H*D)\nw_all = torch.cat([wq.reshape(HD, C), wk.reshape(HD, C), wv.reshape(HD, C)], dim=0)\nprint('\"'w_all shape:', w_all.shape)\ndef t_proj_separate():\n    q_ = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k_ = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v_ = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    return q_, k_, v_\n\ndef t_proj_fused():\n    out = xr @ w_all.T  # (B*L, 3*HD)\n    q_ = out[:, :HD].reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k_ = out[:, HD:2*HD].reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v_ = out[:, 2*HD:].reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    return q_, k_, v_\n\nprint('Separate proj:', time_fn(t_proj_separate), 'ms')\nprint('Fused proj:', time_fn(t_proj_fused), 'ms')\nqs, ks, vs = t_proj_separate()\nqf, kf, vf = t_proj_fused()\nprint('q same?', (qs - qf).abs().max())\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math, time\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\ng = torch.Generator(); g.manual_seed(17*1009+3)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g)\nwk = torch.randn(H, D, C, generator=g)\nwv = torch.randn(H, D, C, generator=g)\n\ndef time_fn(fn, n=20, warmup=5):\n    for _ in range(warmup):\n        fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return sorted(times)[len(times)//2]\n\nHD = H * D\nxr = x.reshape(B * L, C)\n\n# Test: is permute + contiguous needed?\ndef proj_contiguous():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    return q\n\ndef proj_no_contiguous():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    return q\n\nprint('q proj + contiguous:', time_fn(proj_contiguous), 'ms')\nprint('q proj no contiguous:', time_fn(proj_no_contiguous), 'ms')\nprint()\n\n# Test q@k performance with non-contiguous q,k\nq_c = proj_contiguous()\nk_c = proj_contiguous()\nq_nc = proj_no_contiguous()\nk_nc = proj_no_contiguous()\n\nprint('q@k contiguous:', time_fn(lambda: q_c @ k_c.transpose(-1, -2)), 'ms')\nprint('q@k non-contig:', time_fn(lambda: q_nc @ k_nc.transpose(-1, -2)), 'ms')\nprint()\n\n# Test softmax with non-contiguous\nlogits_c = q_c @ k_c.transpose(-1, -2)\nlogits_nc = q_nc @ k_nc.transpose(-1, -2)\nprint('softmax contig:', time_fn(lambda: logits_c.softmax(dim=-1)), 'ms')\nprint('softmax non-contig:', time_fn(lambda: logits_nc.softmax(dim=-1)), 'ms')\nprint()\n\n# Test p@v with non-contiguous\nv_c = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nv_nc = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\np0 = logits_c.softmax(dim=-1)\nprint('p@v contiguous v:', time_fn(lambda: p0 @ v_c), 'ms')\nprint('p@v non-contig v:', time_fn(lambda: p0 @ v_nc), 'ms')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math, time\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\ng = torch.Generator(); g.manual_seed(17*1009+3)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g)\nwk = torch.randn(H, D, C, generator=g)\nwv = torch.randn(H, D, C, generator=g)\n\ndef time_fn(fn, n=20, warmup=5):\n    for _ in range(warmup):\n        fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return sorted(times)[len(times)//2]\n\nHD = H * D\nxr = x.reshape(B * L, C)\ninv_sqrt_d = 1.0 / math.sqrt(D)\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nv = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\n# Test SDPA for p0 and p1\n# p0 = softmax(q @ k.T / sqrt(D))\n# p1 = softmax(a_p * q@k.T + a_m * k@q.T) / sqrt(D) = softmax(q @ (a_p*k).T + (a_m*q) @ k.T) / sqrt(D)\n# Hmm, not easily expressible as a standard attention\n\n# But we can use SDPA for p0 output: u0_v = SDPA(q, k, v)\n# This should be faster than manual q@k + softmax + p@v\nprint('SDPA:', time_fn(lambda: torch.nn.functional.scaled_dot_product_attention(q, k, v, scale=inv_sqrt_d)), 'ms')\nprint('manual attn:', time_fn(lambda: (q @ k.transpose(-1, -2) * inv_sqrt_d).softmax(-1) @ v), 'ms')\nprint()\n\n# For p1, can we construct a modified q,k such that SDPA gives p1 output?\n# p1 = softmax(a_p * qk\"'^T + a_m * kq''^T) / sqrt(D)\n# = softmax((a_p * q) @ k''^T + q @ (a_m * k)''^T)... no that'\"'s wrong\n# a_p * qk\"'^T + a_m * kq''^T is symmetric if a_p = a_m (alpha=0)\n# But generally not expressible as a single q'\"' @ k'\"'^T\n\n# What about: compute p1 output as SDPA(q'\"', k', v) where q' and k' are chosen s.t. q'@k'\"'^T = a_p*qk''^T + a_m*kq''^T\n# For this we'\"'d need q'k'\"'^T = a_p*qk''^T + a_m*kq''^T\n# That'\"'s generally not possible with rank D matrices (right side is rank 2D at most, but specific structure)\n\n# Let's try another approach: compute p0 output via SDPA, then compute p1 manually\n# (saves one softmax + one p@v = ~16ms)\n\n# Actually, we can do both p0 and p1 manually and just accept the cost.\n# Let's see if we can fuse the p1 computation differently.\n\n# Idea: we need both p0@v and p1@v for the output mix.\n# We also need p0 and p1 (full matrices) for the Gram norm computation.\n# So we need both attention weight matrices anyway.\n# SDPA doesn't help us because we need the full attention matrix (for norms), not just the output.\n\n# Wait, actually... do we need the full p matrices for Gram?\n# ||p @ x||\"'^2 = diag((p @ G) @ p''^T) = sum over j of (p @ G)_ij * p_ij\n# Yes, we need element-wise products of p with (p @ G), which requires full p matrix.\n\n# So SDPA can'\"'t help with the norms. But it could help compute u0_v = p0 @ v faster.\n# Let's measure: SDPA vs manual p0 + p0@v\ndef p0_manual():\n    logits = q @ k.transpose(-1, -2) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    u0 = p0 @ v\n    return p0, u0\n\ndef p0_sdpa():\n    u0 = torch.nn.functional.scaled_dot_product_attention(q, k, v, scale=inv_sqrt_d)\n    # But we still need p0 for the mix and gram...\n    # So SDPA doesn't save us from computing p0.\n    return u0\n\nt_manual = time_fn(p0_manual)\nt_sdpa = time_fn(p0_sdpa)\nprint(f'p0 manual (with p0 + u0): {t_manual:.2f} ms')\nprint(f'SDPA (u0 only): {t_sdpa:.2f} ms')\nprint()\n\n# Actually, SDPA with attn_mask can handle symmetric attention? Let's check.\n# attn_mask of shape (B, H, L, L) added to logits before softmax\n# We need: logits + (a_p - 1)*logits + a_m*logits\"'^T... no, that'\"'s circular.\n\n# Wait, another thought: what if we compute p0 via SDPA's attention weight output?\n# PyTorch SDPA doesn't output attention weights on CPU (only with enable_gqa_grad or similar).\n\n# Let me verify: does SDPA save time when we need both p0 AND p0@v?\n# Cost of manual: q@k (3ms) + softmax (14ms) + p@v (3ms) = 20ms\n# Cost of SDPA: ~12ms (from earlier test)\n# But we still need p0 for gram computation... so we'd need both SDPA AND the manual computation.\n# That's worse.\n\n# OK, what other optimizations can we try?\n# 1. Fuse G computation with something else? G = x @ x.T, costs 3.6ms, hard to fuse.\n# 2. Compute p1@G and p_mix@G more efficiently? They each cost ~13ms.\n# 3. Reduce the number of allocations?\n\n# Let me try a major restructuring: compute everything in (B*H, L, *) format\n# and use bmm, which might be better optimized for some operations\n\n# Actually let me try one more thing: what if we use float64 for the gram computation\n# to improve accuracy, allowing us to use a more aggressive (but less accurate) approach elsewhere?\n# No, float64 would be slower.\n\n# Let me think about the actual bottlenecks:\n# 1. Projections: 3 * ~15ms = ~45ms (38% of total)\n# 2. Softmax (p0 + p1): ~31ms (26%)  \n# 3. Gram multiplications (p1@G + pmix@G): ~26ms (22%)\n# 4. q@k + p@v + G + other: ~15ms (12%)\n\n# The projections are the biggest cost but they're necessary.\n# Softmax is surprisingly expensive. Let me see if I can optimize it.\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

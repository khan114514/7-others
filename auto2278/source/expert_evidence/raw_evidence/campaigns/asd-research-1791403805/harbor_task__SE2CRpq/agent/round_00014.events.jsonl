{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/sh -lc 'cd /workspace && python3 -c \"\nimport torch, math, time\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\ng = torch.Generator(); g.manual_seed(17*1009+3)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g)\nwk = torch.randn(H, D, C, generator=g)\nwv = torch.randn(H, D, C, generator=g)\n\ndef time_fn(fn, n=20, warmup=5):\n    for _ in range(warmup):\n        fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return sorted(times)[len(times)//2]\n\nHD = H * D\nxr = x.reshape(B * L, C)\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nv = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nlogits = q @ k.transpose(-1, -2) / math.sqrt(D)\np0 = logits.softmax(dim=-1)\na_p = 0.5 * (1.0 + alpha); a_m = 0.5 * (1.0 - alpha)\np1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\np_mix = torch.lerp(p0, p1, beta)\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\n\n# Try computing norm in a different way\n# norm''^2 = sum over c of (sum_j p_ij * x_jc)''^2 = sum_j sum_k p_ij * p_ik * (x_j . x_k)\n# This is what Gram does: (p @ G) * p summed over last dim\n\n# Alternative: compute row-wise norm of p_mix @ x directly (but that'\"'s the slow way)\n# What about: p @ x is B*H*L*C, then norm is B*H*L\n\n# Another idea: compute norm from v-space? No, D < C, so norm in D \"'!= norm in C\n\n# What about using .reshape(B*H, L, L) and bmm for everything?\n# Let me try a completely flat (B*H, L, D) approach\n\nq_flat = q.reshape(B*H, L, D)\nk_flat = k.reshape(B*H, L, D)\nv_flat = v.reshape(B*H, L, D)\nG_flat = G.expand(B, H, L, L).reshape(B*H, L, L).contiguous()\n\ndef t_flat_attention():\n    logits_flat = torch.bmm(q_flat, k_flat.transpose(-1, -2))\n    logits_flat.mul_(1.0 / math.sqrt(D))\n    p0f = logits_flat.softmax(dim=-1)\n    return p0f\n\ndef t_4d_attention():\n    logits = q @ k.transpose(-1, -2) / math.sqrt(D)\n    p0 = logits.softmax(dim=-1)\n    return p0\n\nprint('\"'Flat attn:', time_fn(t_flat_attention), 'ms')\nprint('4D attn:', time_fn(t_4d_attention), 'ms')\np0f = t_flat_attention()\np04 = t_4d_attention()\nprint('Same?', (p0f.reshape(B,H,L,L) - p04).abs().max())\nprint()\n\n# Let me try full end-to-end flat approach\ndef flat_full():\n    qf = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).reshape(B*H, L, D).contiguous()\n    kf = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).reshape(B*H, L, D).contiguous()\n    vf = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).reshape(B*H, L, D).contiguous()\n    \n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    logits = torch.bmm(qf, kf.transpose(-1, -2))\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    \n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    \n    Gf = (x @ x.transpose(-1, -2)).expand(B, H, L, L).reshape(B*H, L, L).contiguous()\n    \n    p1G = torch.bmm(p1, Gf)\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = torch.bmm(p_mix, Gf)\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    \n    y = torch.bmm(p_mix, vf).mul_(ratio)\n    return y.reshape(B, H, L, D).transpose(1, 2).flatten(2).contiguous()\n\ndef current_4d():\n    q4 = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k4 = (xr @ wk.reshape
{"type":"item.started","item":{"id":"item_60","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 640, 10, 64\nalpha, beta = 1.2, 5.0\ng = torch.Generator(); g.manual_seed(17*1009 + 4)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g)\nwk = torch.randn(H, D, C, generator=g)\nwv = torch.randn(H, D, C, generator=g)\n\ndef oracle():\n    q = torch.einsum('blc,hdc->bhld', x, wq)\n    k = torch.einsum('blc,hdc->bhld', x, wk)\n    logits = q @ k.transpose(-1, -2) / math.sqrt(D)\n    p0 = logits.softmax(-1)\n    p1 = (.5 * (1 + alpha) * logits + .5 * (1 - alpha) * logits.transpose(-1, -2)).softmax(-1)\n    base, modified = p0 @ x.unsqueeze(1), p1 @ x.unsqueeze(1)\n    mix = base + beta * (modified - base)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / mix.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    return torch.einsum('bhlc,hdc->bhld', mix * ratio, wv).transpose(1, 2).flatten(2).contiguous()\n\nHD = H * D\nxr = x.reshape(B * L, C)\ninv_sqrt_d = 1.0 / math.sqrt(D)\n\n# Full cspace_gram function, matching my earlier test\ndef cur_cspace_gram():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    if alpha == 1.0:\n        m = p0 @ x.unsqueeze(1)\n        ratio = 1.0\n        wv_bh = wv.unsqueeze(0).expand(B, H, D, C).reshape(B*H, D, C)\n        y = torch.bmm(\n            (m * ratio).reshape(B*H, L, C),\n            wv_bh.transpose(-1, -2)\n        ).reshape(B, H, L, D)\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1_logits = logits.mul(a_p)\n        p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n        p1 = p1_logits.softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        p1G = p1 @ G_exp\n        norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n        m = p_mix @ x.unsqueeze(1)\n        wv_bh = wv.unsqueeze(0).expand(B, H, D, C).reshape(B*H, D, C)\n        y = torch.bmm(\n            (m * ratio).reshape(B*H, L, C),\n            wv_bh.transpose(-1, -2)\n        ).reshape(B, H, L, D)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\nref = oracle()\nout = cur_cspace_gram()\nerr = (out - ref).abs()\nprint('Max error:', err.max().item())\nprint('allclose:', torch.allclose(ref, out, atol=3e-5, rtol=3e-4))\n\n# The error is 5.2e-3 which is large. Let me trace it.\n# Key difference from oracle: \n# 1. p1_logits computed with in-place mul + add\n# 2. p_mix via lerp instead of base + beta*(modified-base)\n# 3. norms via gram instead of direct\n# 4. output via bmm instead of einsum\n\n# Let me isolate each difference\n\n# First, fix p1 to be out-of-place\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nlogits = q @ k.transpose(-1, -2) * inv_sqrt_d\np0 = logits.softmax(dim=-1)\np1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(-1)\np_mix = p0 + beta * (p1 - p0)  # oracle pattern\nm = p_mix @ x.unsqueeze(1)\nnorm1 = (p1 @ x.unsqueeze(1)).norm(dim=-1, keepdim=True).clamp_min(1e-6)\nnormm = m.norm(dim=-1, keepdim=True).clamp_min(1e-6)\nratio = (norm1 / normm).clamp(.25, 4.)\ny = torch.einsum('bhlc,hdc->bhld', m * ratio, wv)\nout_full = y.transpose(1, 2).flatten(2).contiguous()\nprint()\nprint('Same pattern (direct + einsum):', (out_full - ref).abs().max().item())\nprint('allclose:', torch.allclose(ref, out_full, atol=3e-5, rtol=3e-4))\n# This should be exactly 0\n\n# Now add bmm\nwv_bh = wv.unsqueeze(0).expand(B, H, D, C).reshape(B*H, D, C)\ny_bmm = torch.bmm((m * ratio).reshape(B*H, L, C), wv_bh.transpose(-1, -2)).reshape(B, H, L, D)\nout_bmm = y_bmm.transpose(1, 2).flatten(2).contiguous()\nprint('Same + bmm output:', (out_bmm - ref).abs().max().item())\nprint('allclose:', torch.allclose(ref, out_bmm, atol=3e-5, rtol=3e-4))\n# Should be ~0\n\n# Now add gram norms\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\nnorm1_sq = (p1 @ G_exp).mul(p1).sum(dim=-1, keepdim=True)\nnormm_sq = (p_mix @ G_exp).mul(p_mix).sum(dim=-1, keepdim=True)\nnorm1_g = norm1_sq.sqrt().clamp_min(1e-6)\nnormm_g = normm_sq.sqrt().clamp_min(1e-6)\nratio_g = (norm1_g / normm_g).clamp(0.25, 4.0)\ny_g = torch.einsum('bhlc,hdc->bhld', m * ratio_g, wv)\nout_g = y_g.transpose(1, 2).flatten(2).contiguous()\nprint('Same + gram norms + einsum:', (out_g - ref).abs().max().item())\nprint('allclose:', torch.allclose(ref, out_g, atol=3e-5, rtol=3e-4))\n\n# Now add in-place p1 computation\nlogits2 = q @ k.transpose(-1, -2)\nlogits2.mul_(inv_sqrt_d)\np0_2 = logits2.softmax(dim=-1)\np1_logits = logits2.mul(a_p)\np1_logits.add_(logits2.transpose(-1, -2), alpha=a_m)\np1_2 = p1_logits.softmax(dim=-1)\nprint()\nprint('p1 inplace diff:', (p1 - p1_2).abs().max().item())\nprint('p0 inplace diff:', (p0 - p0_2).abs().max().item())\n\n# Add lerp\npmix_lerp = torch.lerp(p0_2, p1_2, beta)\npmix_direct = p0_2 + beta * (p1_2 - p0_2)\nprint('lerp vs direct p_mix:', (pmix_lerp - pmix_direct).abs().max().item())\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

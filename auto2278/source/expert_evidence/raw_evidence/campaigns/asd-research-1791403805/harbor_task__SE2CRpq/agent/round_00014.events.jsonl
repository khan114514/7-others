{"type":"item.started","item":{"id":"item_59","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math\ntorch.set_num_threads(1)\n\n# OK so gram ratio + einsum output gives 4.96e-5 error for case 4, which passes allclose.\n# But earlier C-space bmm + gram ratio gave 5.2e-3 error.\n# The difference must be in HOW we compute the output matmul.\n\nB, L, C, H, D = 1, 256, 640, 10, 64\nalpha, beta = 1.2, 5.0\ng = torch.Generator(); g.manual_seed(17*1009 + 4)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g)\nwk = torch.randn(H, D, C, generator=g)\nwv = torch.randn(H, D, C, generator=g)\n\ndef oracle():\n    q = torch.einsum('blc,hdc->bhld', x, wq)\n    k = torch.einsum('blc,hdc->bhld', x, wk)\n    logits = q @ k.transpose(-1, -2) / math.sqrt(D)\n    p0 = logits.softmax(-1)\n    p1 = (.5 * (1 + alpha) * logits + .5 * (1 - alpha) * logits.transpose(-1, -2)).softmax(-1)\n    base, modified = p0 @ x.unsqueeze(1), p1 @ x.unsqueeze(1)\n    mix = base + beta * (modified - base)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / mix.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    return torch.einsum('bhlc,hdc->bhld', mix * ratio, wv).transpose(1, 2).flatten(2).contiguous()\n\nHD = H * D\nxr = x.reshape(B * L, C)\ninv_sqrt_d = 1.0 / math.sqrt(D)\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nlogits = q @ k.transpose(-1, -2)\nlogits.mul_(inv_sqrt_d)\np0 = logits.softmax(dim=-1)\na_p = 0.5 * (1.0 + alpha)\na_m = 0.5 * (1.0 - alpha)\np1_logits = logits.mul(a_p)\np1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\np1 = p1_logits.softmax(dim=-1)\np_mix = torch.lerp(p0, p1, beta)\n\nx_exp = x.unsqueeze(1)\nm = p_mix @ x_exp\n\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\nnorm1_sq = (p1 @ G_exp).mul(p1).sum(dim=-1, keepdim=True)\nnormm_sq = (p_mix @ G_exp).mul(p_mix).sum(dim=-1, keepdim=True)\nnorm1 = norm1_sq.sqrt().clamp_min(1e-6)\nnormm = normm_sq.sqrt().clamp_min(1e-6)\nratio_g = (norm1 / normm).clamp(0.25, 4.0)\n\n# Einsum output\ny_einsum = torch.einsum('bhlc,hdc->bhld', m * ratio_g, wv)\n\n# Bmm output (previous attempt)\nwv_bh = wv.unsqueeze(0).expand(B, H, D, C).reshape(B*H, D, C)\nm_bh = (m * ratio_g).reshape(B*H, L, C)\ny_bmm = torch.bmm(m_bh, wv_bh.transpose(-1, -2)).reshape(B, H, L, D)\n\nprint('einsum vs bmm output:', (y_einsum - y_bmm).abs().max().item())\n# Hmm should be 0... Let me check\n# wait, wv.unsqueeze(0).expand(B, H, D, C) should give same data per batch\n# But bmm with expanded tensor might have different memory layout\n\n# Let me try copy instead of expand\nwv_bh_copy = wv.unsqueeze(0).expand(B, H, D, C).contiguous().reshape(B*H, D, C)\ny_bmm2 = torch.bmm(m_bh, wv_bh_copy.transpose(-1, -2)).reshape(B, H, L, D)\nprint('einsum vs bmm (contig):', (y_einsum - y_bmm2).abs().max().item())\n\n# Try another approach: reshape to (B*H*L, C) @ (C, H*D)... no that's wrong\n\n# Actually wait: einsum('bhlc,hdc->bhld', m, wv)\n# For each b,h: m[b,h] is (L,C), wv[h] is (D,C)\n# output[b,h] = m[b,h] @ wv[h].T  = (L, C) @ (C, D) = (L, D)\n# That's exactly what bmm does: (B*H, L, C) @ (B*H, C, D) -> (B*H, L, D)\n\n# But with expand, the wv_bh tensor might not be what we expect\nprint('wv_bh shape:', wv_bh.shape)\nprint('wv_bh is contiguous:', wv_bh.is_contiguous())\nprint('wv_bh_copy is contiguous:', wv_bh_copy.is_contiguous())\nprint('wv_bh stride:', wv_bh.stride())\nprint('wv_bh_copy stride:', wv_bh_copy.stride())\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

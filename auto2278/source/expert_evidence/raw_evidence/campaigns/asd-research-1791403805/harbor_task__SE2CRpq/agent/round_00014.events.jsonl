{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/sh -lc 'cd /workspace && python3 -c \"\nimport torch, math, time\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\ng = torch.Generator(); g.manual_seed(17*1009+3)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g)\nwk = torch.randn(H, D, C, generator=g)\nwv = torch.randn(H, D, C, generator=g)\n\ndef time_fn(fn, n=11, warmup=3):\n    for _ in range(warmup):\n        fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return sorted(times)[len(times)//2]\n\nHD = H * D\nxr = x.reshape(B * L, C)\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nv = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\ninv_sqrt_d = 1.0 / math.sqrt(D)\nlogits = q @ k.transpose(-1, -2)\nlogits.mul_(inv_sqrt_d)\np0 = logits.softmax(dim=-1)\na_p = 0.5 * (1.0 + alpha); a_m = 0.5 * (1.0 - alpha)\np1_logits = logits.mul(a_p)\np1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\np1 = p1_logits.softmax(dim=-1)\np_mix = torch.lerp(p0, p1, beta)\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\n\n# Key insight: p_mix = (1-beta)*p0 + beta*p1\n# normm_sq = sum_j sum_k p_mix_ij * p_mix_ik * G_jk\n# = (1-beta)''^2 * p0G*p0 + beta''^2 * p1G*p1 + 2*(1-beta)*beta * p0G*p1\n# We already compute p1G*p1 for norm1\n# We need p0G*p0 and p0G*p1\n# But p0G = p0 @ G (another B H L L matmul)\n# If we compute p0G, we get both p0G*p0 and p0G*p1 for free\n\n# Actually wait, p0G = p0 @ G (B,H,L,L) @ (B,1,L,L) -> B,H,L,L (262M FLOPs for L=256,H=20)\n# Compare to pmG = p_mix @ G (also B,H,L,L = same cost)\n# So we'\"'d save one p@G matmul (262M FLOPs = ~6ms)\n# Instead of computing p1@G and p_mix@G, we compute p0@G and p1@G\n# and derive normm_sq from p0G, p1G, p0, p1\n\n# Let me verify\np0G = p0 @ G_exp\np1G = p1 @ G_exp\n\n# norm0_sq = (p0G * p0).sum(-1)\n# norm1_sq = (p1G * p1).sum(-1)\n# cross01_sq = (p0G * p1).sum(-1) = (p1G * p0).sum(-1) \n# (since p0@G * p1 summed = p1@G * p0 summed if G is symmetric, which it is)\nnorm0_sq = (p0G * p0).sum(dim=-1, keepdim=True)\nnorm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\ncross01 = (p0G * p1).sum(dim=-1, keepdim=True)\n\n# Direct computation for reference\npmG = p_mix @ G_exp\nnormm_sq_direct = (pmG * p_mix).sum(dim=-1, keepdim=True)\n\n# Derived computation\nbm1 = beta - 1.0  # = -(1-beta)\nnormm_sq_derived = norm0_sq * bm1 * bm1 + norm1_sq * beta * beta + 2 * bm1 * beta * cross01\n\nprint('normm_sq diff:', (normm_sq_direct - normm_sq_derived).abs().max())\nprint()\n# So we can compute norms from p0@G and p1@G (2 matmuls) instead of p1@G and p_mix@G (2 matmuls)\n# Same number of matmuls, but smaller intermediate tensors... \n# Actually same total work. Not a win.\n\n# Wait, actually we only need ONE matmul if we're clever:\n# Stack p0 and p1: (2*B*H, L, L), @ G: (2*B*H, L, L)\n# Then extract: saves the overhead of two separate calls\nstacked_p = torch.cat([p0, p1], dim=0)  # (2B, H, L, L) -- no, stacking along new dim\n# Actually let's try: reshape both to (B*H, L, L), stack to (2*B*H, L, L)\np0_f = p0.reshape(B*H, L, L)\np1_f = p1.reshape(B*H, L, L)\nstacked = torch.cat([p0_f, p1_f], dim=0)  # (2*B*H, L, L)\nG_f = G.expand(B*H, L, L)  # no, G is (B, L, L), we need (2*B*H, L, L)\n\n# Actually G is (1, L, L) for B=1, so it broadcasts fine\ndef t_two_separate():\n    p0G = p0 @ G_exp\n    p1G = p1 @ G_exp\n    return p0G, p1G\n\ndef t_stacked():\n    s = torch.cat([p0, p1], dim=2)  # (B, H, 2L, L)\n    sG = s @ G_exp  # (B, H, 2L, L)\n    p0G = sG[:, :, :L, :]\n    p1G = sG[:, :, L:, :]\n    return p0G, p1G\n\nprint('Two separate:', time_fn(t_two_separate), 'ms')\nprint('Stacked:', time_fn(t_stacked), 'ms')\nr1a, r1b = t_two_separate()\nr2a, r2b = t_stacked()\nprint('Same p0G?', (r1a - r2a).abs().max())\nprint('Same p1G?', (r1b - r2b).abs().max())\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/sh -lc 'cd /workspace && python3 -c \"\nimport torch, math, time\ntorch.set_num_threads(1)\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\ng = torch.Generator(); g.manual_seed(17*1009+3)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g)\nwk = torch.randn(H, D, C, generator=g)\nwv = torch.randn(H, D, C, generator=g)\n\ndef time_fn(fn, n=11, warmup=3):\n    for _ in range(warmup):\n        fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return sorted(times)[len(times)//2]\n\nHD = H * D\nxr = x.reshape(B * L, C)\n\n# Strategy: compute v last thing using einsum-like approach but optimized\n# The expensive part is p_mix @ x (B*H*L*L*C) and m_c @ wv''^T (B*H*L*C*D)\n# Total: 2*B*H*L*L*C + B*H*L*C*D = 2*1*20*256*256*1280 + 1*20*256*1280*64\n# = 3.36B + 420M = 3.78B FLOPs\n# vs v-first: B*H*L*L*C (v proj) + B*H*L*L*D (p_mix @ v) + 2*B*H*L*L (gram norms) \n# v proj: 1*20*256*256*1280 wait no, v proj is B*L*C*H*D = 1*256*1280*20*64 = 420M\n# p_mix @ v: B*H*L*L*D = 1*20*256*256*64 = 84M\n# gram: 2*B*H*L*L = 2.6M (negligible) + G: B*L*L*C = 84M\n# Total v-first: 420 + 84 + 84 = 588M + q/k proj\n\n# Wait, q and k projections are also needed. q: B*L*C*H*D = 420M, k: 420M\n# So all projections: 3 * 420M = 1.26B\n# Plus q@k''^T: B*H*L*L*D = 84M\n# Plus softmax: negligible\n# Plus p0@p1 stuff: negligible\n# Plus p_mix @ v: 84M\n# Plus norms via gram: G (B*L*L*C = 84M) + 2*p@G (2*B*H*L*L = 2.6M)\n# Wait, p @ G is B*H*L*L matmul B*1*L*L -> no, G is (B, L, L), p is (B,H,L,L)\n# p @ G_exp broadcasts: effectively B*H*L*L*L? No, it'\"'s batched matmul\n# p (B,H,L,L) @ G (B,1,L,L) broadcasted = B*H matmuls of (L,L)@(L,L) = B*H*L*L*L\n# = 1*20*256*256*256 = 335M\n# That's actually significant\"'!\n\n# Let me verify the shape flow\nprint('\"'Testing shapes...')\nG = x @ x.transpose(-1, -2)\nprint(f'G shape: {G.shape}')  # (B, L, L)\nG_exp = G.unsqueeze(1)\nprint(f'G_exp shape: {G_exp.shape}')  # (B, 1, L, L)\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nlogits = q @ k.transpose(-1, -2)\nlogits.mul_(1.0 / math.sqrt(D))\np0 = logits.softmax(dim=-1)\na_p = 0.5 * (1.0 + alpha)\na_m = 0.5 * (1.0 - alpha)\np1_logits = logits.mul(a_p)\np1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\np1 = p1_logits.softmax(dim=-1)\np_mix = torch.lerp(p0, p1, beta)\nprint(f'p_mix shape: {p_mix.shape}')  # (B, H, L, L)\nresult = p_mix @ G_exp\nprint(f'p_mix @ G_exp shape: {result.shape}')  # (B, H, L, L)\n# This is indeed B*H matmuls of (L, L) @ (L, L)\n\n# Alternative: compute norm directly as ||p_mix @ x|| \n# p_mix @ x: (B,H,L,L) @ (B,1,L,C) broadcast = B*H*(L,L)@(L,C) = B*H*L*L*C\n# = 1*20*256*256*1280 = 1.68B\n# vs gram: G = B*L*L*C = 84M, p@G = B*H*L*L*L = 335M -> total 419M\n# Hmm so gram is actually faster for the norm computation\n\n# But wait, we already have v = x @ wv\"'^T (in D dimensions). \n# Can we compute norms in D dimensions using v?\n# ||p_mix @ x||_C != ||p_mix @ v||_D\n# Because v is in a different subspace (D < C).\n\n# Actually let me re-read the problem: norms are of u0, u1, m which are in C dimensions\n# u0 = P0 @ x, so ||u0|| is in C dims\n# We cannot compute this from v (which is in D dims)\n\n# So gram approach is the right idea. But we'\"'re getting numerical errors.\n# Let me try: normm via direct computation (one p@x), but norm1 via gram\n# OR: use double precision for the gram computation? No, inputs are float32.\n\n# Wait, the numerical error is 5.8e-4 but tolerance is 3e-5 + 3e-4*|expected|\n# The max |expected| is ~386, so tolerance is ~0.116 for large values\n# But the error is in small values (0.007) where tolerance is ~3.2e-5\n# So 5.8e-4 > 3.2e-5 -> fails\n\n# The issue is that v-first has error from: (p_mix @ (x @ wv\"'^T)) vs ((p_mix @ x) @ wv''^T)\n# These are mathematically equal but differ numerically\n# AND gram norms add more error\n\nprint()\nprint('\"'--- Detailed error breakdown ---')\n\n# Reference norms\nu1_ref = p1 @ x.unsqueeze(1)\nm_ref = p_mix @ x.unsqueeze(1)\nnorm1_ref = u1_ref.norm(dim=-1, keepdim=True).clamp_min(1e-6)\nnormm_ref = m_ref.norm(dim=-1, keepdim=True).clamp_min(1e-6)\nratio_ref = (norm1_ref / normm_ref).clamp(.25, 4.)\ny_ref = torch.einsum('bhlc,hdc->bhld', m_ref * ratio_ref, wv)\n\n# Gram norms\nnorm1_sq = (p1 @ G_exp).mul(p1).sum(dim=-1, keepdim=True)\nnormm_sq = (p_mix @ G_exp).mul(p_mix).sum(dim=-1, keepdim=True)\nnorm1_g = norm1_sq.sqrt().clamp_min(1e-6)\nnormm_g = normm_sq.sqrt().clamp_min(1e-6)\nratio_g = (norm1_g / normm_g).clamp(0.25, 4.0)\n\n# v-first output\nv = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\ny_v = (p_mix @ v) * ratio_g\nout_v = y_v.transpose(1, 2).flatten(2).contiguous()\nout_ref = y_ref.transpose(1, 2).flatten(2).contiguous()\n\n# Error components\nerr_ratio_only = (torch.einsum('bhlc,hdc->bhld', m_ref * ratio_g, wv) - y_ref).abs().max()\nerr_vonly = ((p_mix @ v) * ratio_ref - y_ref).abs().max()\nerr_both = out_v - out_ref\nprint(f'Ratio-only error (gram): {err_ratio_only.max():.3e}')\nprint(f'V-only error (v-first): {err_vonly.max():.3e}')\nprint(f'Combined error: {err_both.abs().max():.3e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

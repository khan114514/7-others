{"type":"item.started","item":{"id":"item_62","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 << 'PYEOF'\nimport torch, math\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 640, 10, 64\nalpha, beta = 1.2, 5.0\ng = torch.Generator(); g.manual_seed(17*1009 + 4)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g)\nwk = torch.randn(H, D, C, generator=g)\nwv = torch.randn(H, D, C, generator=g)\n\nHD = H * D\nxr = x.reshape(B * L, C)\ninv_sqrt_d = 1.0 / math.sqrt(D)\na_p = 0.5 * (1.0 + alpha)\na_m = 0.5 * (1.0 - alpha)\n\ndef oracle():\n    q = torch.einsum('blc,hdc->bhld', x, wq)\n    k = torch.einsum('blc,hdc->bhld', x, wk)\n    logits = q @ k.transpose(-1, -2) / math.sqrt(D)\n    p0 = logits.softmax(-1)\n    p1 = (.5 * (1 + alpha) * logits + .5 * (1 - alpha) * logits.transpose(-1, -2)).softmax(-1)\n    base, modified = p0 @ x.unsqueeze(1), p1 @ x.unsqueeze(1)\n    mix = base + beta * (modified - base)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / mix.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    return torch.einsum('bhlc,hdc->bhld', mix * ratio, wv).transpose(1, 2).flatten(2).contiguous()\n\nref = oracle()\n\n# The culprit is in-place p1_logits computation (T3 fails, T2 passes)\n# The difference is: logits.mul_(inv_sqrt_d) vs * inv_sqrt_d\n# And p1_logits = logits.mul(a_p) (makes a copy)\n# p1_logits.add_(logits.transpose(-1,-2), alpha=a_m) (in-place add)\n\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\n# Test: does logits.mul_(inv_sqrt_d) cause issues?\nlogits_a = q @ k.transpose(-1, -2)\nlogits_a.mul_(inv_sqrt_d)\np0_a = logits_a.softmax(-1)\n\nlogits_b = q @ k.transpose(-1, -2) * inv_sqrt_d\np0_b = logits_b.softmax(-1)\n\nprint('p0 inplace vs out-of-place:', (p0_a - p0_b).abs().max().item())\n\n# Now test p1 difference\n# Pattern A: in-place\np1_logits_a = logits_a.mul(a_p)  # copy\np1_logits_a.add_(logits_a.transpose(-1, -2), alpha=a_m)  # in-place add\np1_a = p1_logits_a.softmax(-1)\n\n# Pattern B: out-of-place (standard)\np1_logits_b = a_p * logits_b + a_m * logits_b.transpose(-1, -2)\np1_b = p1_logits_b.softmax(-1)\n\nprint('p1 inplace vs out-of-place:', (p1_a - p1_b).abs().max().item())\nprint('p1_logits diff:', (p1_logits_a - p1_logits_b).abs().max().item())\n\n# Pattern C: out-of-place mul, then add\np1_logits_c = logits_b.mul(a_p)  # copy\np1_logits_c.add_(logits_b.transpose(-1, -2), alpha=a_m)\np1_c = p1_logits_c.softmax(-1)\nprint('p1 out-of-place mul + add_ vs out-of-place:', (p1_c - p1_b).abs().max().item())\n\n# Pattern D: in-place with cloned logits\nlogits_clone = (q @ k.transpose(-1, -2) * inv_sqrt_d).clone()\np1_logits_d = logits_clone.mul(a_p)\np1_logits_d.add_(logits_clone.transpose(-1, -2), alpha=a_m)\np1_d = p1_logits_d.softmax(-1)\nprint('p1 with cloned logits:', (p1_d - p1_b).abs().max().item())\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

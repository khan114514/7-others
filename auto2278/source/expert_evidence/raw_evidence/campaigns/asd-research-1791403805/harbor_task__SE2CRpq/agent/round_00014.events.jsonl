{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 640, 10, 64\nalpha, beta = 1.2, 5.0\ng = torch.Generator(); g.manual_seed(17*1009 + 4)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g)\nwk = torch.randn(H, D, C, generator=g)\nwv = torch.randn(H, D, C, generator=g)\n\ndef oracle():\n    q = torch.einsum('blc,hdc->bhld', x, wq)\n    k = torch.einsum('blc,hdc->bhld', x, wk)\n    logits = q @ k.transpose(-1, -2) / math.sqrt(D)\n    p0 = logits.softmax(-1)\n    p1 = (.5 * (1 + alpha) * logits + .5 * (1 - alpha) * logits.transpose(-1, -2)).softmax(-1)\n    base, modified = p0 @ x.unsqueeze(1), p1 @ x.unsqueeze(1)\n    mix = base + beta * (modified - base)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / mix.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    return torch.einsum('bhlc,hdc->bhld', mix * ratio, wv).transpose(1, 2).flatten(2).contiguous()\n\nHD = H * D\nxr = x.reshape(B * L, C)\ninv_sqrt_d = 1.0 / math.sqrt(D)\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nlogits = q @ k.transpose(-1, -2)\nlogits.mul_(inv_sqrt_d)\np0 = logits.softmax(dim=-1)\na_p = 0.5 * (1.0 + alpha)\na_m = 0.5 * (1.0 - alpha)\n\n# Test different p1 computation patterns\np1_ref_full = (.5 * (1 + alpha) * logits + .5 * (1 - alpha) * logits.transpose(-1, -2)).softmax(-1)\n\n# Pattern 1: logits.mul(a_p).add_(logits.T * a_m)\np1_logits_1 = logits.mul(a_p)\np1_logits_1.add_(logits.transpose(-1, -2), alpha=a_m)\np1_1 = p1_logits_1.softmax(dim=-1)\n\n# Pattern 2: a_p * logits + a_m * logits.T  (standard)\np1_logits_2 = a_p * logits + a_m * logits.transpose(-1, -2)\np1_2 = p1_logits_2.softmax(dim=-1)\n\nprint('p1 ref vs pat1:', (p1_ref_full - p1_1).abs().max().item())\nprint('p1 ref vs pat2:', (p1_ref_full - p1_2).abs().max().item())\n\n# OK so p1 is fine. Now test norms.\np1 = p1_1\np_mix = torch.lerp(p0, p1, beta)\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\n\nmodified_ref = p1 @ x.unsqueeze(1)\nmix_ref = p0 @ x.unsqueeze(1) + beta * (modified_ref - p0 @ x.unsqueeze(1))\nnorm1_ref = modified_ref.norm(dim=-1, keepdim=True).clamp_min(1e-6)\nnormm_ref = mix_ref.norm(dim=-1, keepdim=True).clamp_min(1e-6)\nratio_ref = (norm1_ref / normm_ref).clamp(.25, 4.)\n\np1G = p1 @ G_exp\nnorm1_sq = p1G.mul(p1).sum(dim=-1, keepdim=True)\npmG = p_mix @ G_exp\nnormm_sq = pmG.mul(p_mix).sum(dim=-1, keepdim=True)\nnorm1_g = norm1_sq.sqrt().clamp_min(1e-6)\nnormm_g = normm_sq.sqrt().clamp_min(1e-6)\nratio_g = (norm1_g / normm_g).clamp(0.25, 4.0)\nprint()\nprint('norm1 diff:', (norm1_ref - norm1_g).abs().max().item())\nprint('normm diff:', (normm_ref - normm_g).abs().max().item())\nprint('ratio diff:', (ratio_ref - ratio_g).abs().max().item())\n\n# Now test output computation\nv = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\n# v-first output\ny_v = (p_mix @ v) * ratio_g\nout_v = y_v.transpose(1, 2).flatten(2).contiguous()\n\n# einsum output with gram ratio\ny_einsum_g = torch.einsum('bhlc,hdc->bhld', mix_ref * ratio_g, wv)\nout_einsum_g = y_einsum_g.transpose(1, 2).flatten(2).contiguous()\n\n# einsum output with ref ratio\ny_einsum_r = torch.einsum('bhlc,hdc->bhld', mix_ref * ratio_ref, wv)\nout_einsum_r = y_einsum_r.transpose(1, 2).flatten(2).contiguous()\n\nref = oracle()\nprint()\nprint('v-first + gram ratio:', (out_v - ref).abs().max().item())\nprint('einsum + gram ratio:', (out_einsum_g - ref).abs().max().item())\nprint('einsum + ref ratio:', (out_einsum_r - ref).abs().max().item())\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

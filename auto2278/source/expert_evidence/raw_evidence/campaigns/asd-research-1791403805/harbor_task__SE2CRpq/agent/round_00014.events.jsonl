{"type":"item.started","item":{"id":"item_67","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 << 'PYEOF'\nimport torch, math\ntorch.set_num_threads(1)\n\n# The weights are scaled by 1/sqrt(c)\"'! I missed that.\ncases = [\n    (1, 64, 512, 8, 64, 1.05, 5.0),\n    (1, 128, 640, 10, 64, 1.1, 4.0),\n    (1, 128, 1280, 20, 64, 1.15, 3.0),\n    (1, 256, 1280, 20, 64, 1.05, 7.5),\n    (1, 256, 640, 10, 64, 1.2, 5.0),\n    (2, 128, 512, 8, 64, 1.0, 5.0),\n]\n\nimport time\ndef time_fn(fn, n=11, warmup=3):\n    for _ in range(warmup):\n        fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return sorted(times)[len(times)//2]\n\nfor i, (B, L, C, H, D, alpha, beta) in enumerate(cases):\n    g = torch.Generator().manual_seed(17 * 1009 + i)\n    x = torch.randn(B, L, C, generator=g)\n    wq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n    wk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n    wv = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n    HD = H * D\n    xr = x.reshape(B * L, C)\n    isd = 1.0 / math.sqrt(D)\n    ap = 0.5 * (1.0 + alpha)\n    am = 0.5 * (1.0 - alpha)\n    \n    def sol():\n        qq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n        kk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n        vv = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n        logits_ = qq @ kk.transpose(-1, -2) * isd\n        p0_ = logits_.softmax(dim=-1)\n        if alpha == 1.0:\n            y_ = p0_ @ vv\n        else:\n            p1_ = (ap * logits_ + am * logits_.transpose(-1, -2)).softmax(dim=-1)\n            pmix_ = torch.lerp(p0_, p1_, beta)\n            GG = x @ x.transpose(-1, -2)\n            GGe = GG.unsqueeze(1)\n            n1sq = (p1_ @ GGe).mul(p1_).sum(dim=-1, keepdim=True)\n            nmsq = (pmix_ @ GGe).mul(pmix_).sum(dim=-1, keepdim=True)\n            n1 = n1sq.sqrt().clamp_min(1e-6)\n            nm = nmsq.sqrt().clamp_min(1e-6)\n            r = (n1 / nm).clamp(0.25, 4.0)\n            y_ = (pmix_ @ vv).mul(r)\n        return y_.transpose(1, 2).flatten(2).contiguous()\n    \n    def base():\n        qq = torch.einsum('\"'blc,hdc->bhld', x, wq)\n        kk = torch.einsum('blc,hdc->bhld', x, wk)\n        logits_ = (qq @ kk.transpose(-1, -2)) / math.sqrt(D)\n        p0_ = logits_.softmax(dim=-1)\n        base_ = p0_ @ x.unsqueeze(1)\n        if alpha == 1.0:\n            modified_ = base_\n        else:\n            perturbed = .5 * (1 + alpha) * logits_ + .5 * (1 - alpha) * logits_.transpose(-1, -2)\n            modified_ = perturbed.softmax(dim=-1) @ x.unsqueeze(1)\n        blended = base_ + beta * (modified_ - base_)\n        r = (modified_.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n        yy = torch.einsum('bhlc,hdc->bhld', blended * r, wv)\n        return yy.transpose(1, 2).flatten(2).contiguous()\n    \n    tb = time_fn(base)\n    ts = time_fn(sol)\n    ref = base()\n    out = sol()\n    err = (out - ref).abs().max().item()\n    ok = torch.allclose(ref, out, atol=3e-5, rtol=3e-4)\n    print(f'Case {i}: base={tb:.1f}ms  sol={ts:.1f}ms  ratio={ts/tb:.3f}  err={err:.2e}  ok={ok}')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_71","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 << 'PYEOF'\nimport torch, math, time\ntorch.set_num_threads(1)\n\n# Let me try the key optimization: can we avoid computing p_mix entirely?\n# y = p_mix @ v * ratio\n#   = ((1-beta)*p0 + beta*p1) @ v * ratio\n#   = (1-beta) * (p0 @ v) * ratio + beta * (p1 @ v) * ratio\n#\n# But we need p_mix for the gram norm. However:\n# ||m||\"'^2 = ||(1-beta)*u0 + beta*u1||''^2 \n#         = (1-beta)''^2 * ||u0||''^2 + beta''^2 * ||u1||''^2 + 2*(1-beta)*beta * (u0 . u1)\n#\n# If we compute ||u0|| and u0 . u1 via gram, we only need p0 @ G and p1 @ G (two matmuls, same as before)\n# Same number of matmuls, but we avoid computing p_mix and doing p_mix @ G\n# We do save the p_mix allocation and lerp though.\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\ng = torch.Generator().manual_seed(17 * 1009 + 3)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwv = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n\ndef time_fn(fn, n=20, warmup=5):\n    for _ in range(warmup):\n        fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return sorted(times)[len(times)//2]\n\nHD = H * D\nxr = x.reshape(B * L, C)\ninv_sqrt_d = 1.0 / math.sqrt(D)\na_p = 0.5 * (1.0 + alpha)\na_m = 0.5 * (1.0 - alpha)\n\n# Current full\ndef current():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    p1G = p1 @ G_exp\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# No-pmix: compute y from p0 and p1 directly, norms from p0G and p1G\ndef opt_nopmix():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    \n    # Stack p0 and p1 for fused gram\n    stacked = torch.cat([p0, p1], dim=2)\n    sG = stacked @ G_exp\n    p0G = sG[:, :, :L, :]\n    p1G = sG[:, :, L:, :]\n    \n    norm0_sq = p0G.mul(p0).sum(dim=-1, keepdim=True)\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    cross = p0G.mul_(p1).sum(dim=-1, keepdim=True)\n    \n    b = beta\n    omb = 1.0 - beta\n    normm_sq = omb*omb * norm0_sq + b*b * norm1_sq + 2*omb*b * cross\n    \n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    \n    # y = p_mix @ v = (1-b)*p0@v + b*p1@v\n    u0_v = p0 @ v\n    u1_v = p1 @ v\n    # y = (omb * u0_v + b * u1_v) * ratio\n    y = torch.lerp(u0_v, u1_v, b)\n    y.mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\nprint('\"'Current:', time_fn(current), 'ms')\nprint('No-pmix:', time_fn(opt_nopmix), 'ms')\n\nref = current()\nopt = opt_nopmix()\nprint('Diff:', (ref - opt).abs().max().item())\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

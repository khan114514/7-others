{"type":"item.started","item":{"id":"item_72","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 << 'PYEOF'\nimport torch, math, time\ntorch.set_num_threads(1)\n\n# Test all cases with the no-pmix approach\ncases = [\n    (1, 64, 512, 8, 64, 1.05, 5.0),\n    (1, 128, 640, 10, 64, 1.1, 4.0),\n    (1, 128, 1280, 20, 64, 1.15, 3.0),\n    (1, 256, 1280, 20, 64, 1.05, 7.5),\n    (1, 256, 640, 10, 64, 1.2, 5.0),\n    (2, 128, 512, 8, 64, 1.0, 5.0),\n]\n\ndef time_fn(fn, n=11, warmup=3):\n    for _ in range(warmup):\n        fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return sorted(times)[len(times)//2]\n\nprint('Case | Base (ms) | Current (ms) | NoPmix (ms) | Cur ratio | NoPmix ratio | Err')\nprint('-' * 90)\n\nfor i, (B, L, C, H, D, alpha, beta) in enumerate(cases):\n    g = torch.Generator().manual_seed(17 * 1009 + i)\n    x = torch.randn(B, L, C, generator=g)\n    wq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n    wk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n    wv = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n    HD = H * D\n    xr = x.reshape(B * L, C)\n    isd = 1.0 / math.sqrt(D)\n    ap = 0.5 * (1.0 + alpha)\n    am = 0.5 * (1.0 - alpha)\n    \n    def baseline():\n        q = torch.einsum('blc,hdc->bhld', x, wq)\n        k = torch.einsum('blc,hdc->bhld', x, wk)\n        logits = (q @ k.transpose(-1, -2)) / math.sqrt(D)\n        p0 = logits.softmax(dim=-1)\n        base = p0 @ x.unsqueeze(1)\n        if alpha == 1.0:\n            modified = base\n        else:\n            perturbed = .5 * (1 + alpha) * logits + .5 * (1 - alpha) * logits.transpose(-1, -2)\n            modified = perturbed.softmax(dim=-1) @ x.unsqueeze(1)\n        blended = base + beta * (modified - base)\n        ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n                 / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n        y = torch.einsum('bhlc,hdc->bhld', blended * ratio, wv)\n        return y.transpose(1, 2).flatten(2).contiguous()\n    \n    def current():\n        q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n        k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n        v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n        logits = q @ k.transpose(-1, -2)\n        logits.mul_(isd)\n        p0 = logits.softmax(dim=-1)\n        if alpha == 1.0:\n            y = p0 @ v\n        else:\n            p1_logits = logits.mul(ap)\n            p1_logits.add_(logits.transpose(-1, -2), alpha=am)\n            p1 = p1_logits.softmax(dim=-1)\n            p_mix = torch.lerp(p0, p1, beta)\n            G = x @ x.transpose(-1, -2)\n            G_exp = G.unsqueeze(1)\n            p1G = p1 @ G_exp\n            norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n            pmG = p_mix @ G_exp\n            normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n            norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n            normm = normm_sq.sqrt_().clamp_min_(1e-6)\n            ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n            y = (p_mix @ v).mul_(ratio)\n        return y.transpose(1, 2).flatten(2).contiguous()\n    \n    def opt_nopmix():\n        q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n        k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n        v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n        logits = q @ k.transpose(-1, -2)\n        logits.mul_(isd)\n        p0 = logits.softmax(dim=-1)\n        if alpha == 1.0:\n            y = p0 @ v\n        else:\n            p1_logits = logits.mul(ap)\n            p1_logits.add_(logits.transpose(-1, -2), alpha=am)\n            p1 = p1_logits.softmax(dim=-1)\n            G = x @ x.transpose(-1, -2)\n            G_exp = G.unsqueeze(1)\n            # Fused gram: stack p0 and p1\n            stacked_p = torch.cat([p0, p1], dim=2)\n            sG = stacked_p @ G_exp\n            p0G = sG[:, :, :L, :]\n            p1G = sG[:, :, L:, :]\n            \n            norm0_sq = p0G.mul(p0).sum(dim=-1, keepdim=True)\n            norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n            cross = p0G.mul_(p1).sum(dim=-1, keepdim=True)\n            \n            b = beta\n            omb = 1.0 - beta\n            normm_sq = omb*omb * norm0_sq + b*b * norm1_sq + 2*omb*b * cross\n            \n            norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n            normm = normm_sq.sqrt_().clamp_min_(1e-6)\n            ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n            \n            y = torch.lerp(p0 @ v, p1 @ v, b)\n            y.mul_(ratio)\n        return y.transpose(1, 2).flatten(2).contiguous()\n    \n    tb = time_fn(baseline)\n    tc = time_fn(current)\n    tn = time_fn(opt_nopmix)\n    err = (opt_nopmix() - baseline()).abs().max().item()\n    ok = torch.allclose(baseline(), opt_nopmix(), atol=3e-5, rtol=3e-4)\n    print(f'{i:4d} | {tb:9.1f} | {tc:12.1f} | {tn:11.1f} | {tc/tb:9.3f} | {tn/tb:12.3f} | {err:.2e} {ok}')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport torch, math, time, statistics\ntorch.set_num_threads(1)\n\nfrom method import attention\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\ng = torch.Generator().manual_seed(42)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwv = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nalpha, beta = 1.05, 5.0\n\nref = attention(x, wq, wk, wv, alpha, beta)\nHD = H * D\nxr = x.reshape(B*L, C)\ninv_sqrt_d = 1.0 / math.sqrt(D)\n\ndef bench(name, fn, n=11):\n    fn()\n    times = []\n    for _ in range(n):\n        t0 = time.perf_counter()\n        fn()\n        times.append((time.perf_counter() - t0) * 1000)\n    print(f'{name}: {statistics.median(times):.2f} ms')\n\n# The output is: r * (p_mix @ v) where v = x @ wv\"'^T\n# p_mix has shape (B, H, L, L), v has shape (B, H, L, D)\n# p_mix @ v has shape (B, H, L, D)\n# Final: (B, L, H*D)\n#\n# Alternative: compute p_mix @ x first (in C-space), then project with wv\n# p_mix @ x: (B, H, L, C) - this is larger!\n# But the starter does this. Let'\"'s see:\n#\n# Current approach: v = x @ wv\"'^T (B*L*C * C*HD = B*L*C*HD FLOPs)\n#   then p_mix @ v (B*H*L*L*D FLOPs)\n# Total for output: B*L*C*H*D + B*H*L''^2*D\n#\n# C-space approach: u = p_mix @ x (B*H*L''^2*C FLOPs)\n#   then u @ wv''^T (B*H*L*C*D FLOPs)\n# Total: B*H*L''^2*C + B*H*L*C*D\n#\n# For B=1, L=256, C=1280, H=20, D=64:\n# Current: 256*1280*1280 + 20*256*256*64 = 419M + 84M = 503M\n# C-space: 20*256*256*1280 + 20*256*1280*64 = 1.68B + 419M = 2.1B\n#\n# Current is way better for large C. No surprise.\n\n# Let'\"'s check what the norm computation actually needs.\n# We need ||p1 @ x|| and ||p_mix @ x|| (in C-space, for the ratio)\n# G = x @ x\"'^T is (L, L), and p @ G gives the per-row x-space dot products.\n# ||p_i @ x||''^2 = p_i @ G @ p_i''^T = (p_i @ G) * p_i summed.\n#\n# But G is symmetric, so we could optimize? Not really.\n#\n# Key insight: Can we compute both p1@G and p_mix@G more efficiently?\n# They'\"'re both (B,H,L,L) matmuls with G (B,L,L) — 2 * B*H*L\"'^2 = 2*20*256''^2 = 2.6M elements,\n# but each is a full matmul: B*H*L*L*L = 20*256''^3 = 336M FLOPs each = 672M total.\n# \n# Hmm wait: p @ G where p is (B,H,L,L) and G is (B,1,L,L) = broadcast\n# It'\"'s a batched matmul: (B*H, L, L) @ (B, L, L)... no, G is (B, L, L).\n# Actually G_exp = G.unsqueeze(1) makes it (B, 1, L, L).\n# p1 @ G_exp: (B, H, L, L) @ (B, 1, L, L) -> broadcasts to (B, H, L, L)\n# This is B*H independent LxL @ LxL matmuls = B*H*L\"'^3 FLOPs = 1*20*256''^3 = 336M each.\n\n# WAIT: G is x @ x''^T with shape (B, L, L). It'\"'s a Gram matrix.\n# What if we don't compute G explicitly? \n# p @ G = p @ x @ x\"'^T = (p @ x) @ x''^T\n# p @ x is (B,H,L,C), then @ x''^T is (B,H,L,C) @ (B,C,L) = (B,H,L,L)\n# FLOPs: B*H*L''^2*C + B*H*L*C*L = 2*B*H*L''^2*C = 2*20*256''^2*1280 = 3.36B\n# That'\"'s way worse than G approach which is 2*B*H*L\"'^3 = 672M.\n# So G approach is 5x better.\n\n# Can we do even better? We only need the diagonal of (p @ G @ p''^T) per row,\n# i.e., row norms of (p @ x). So we need ||p_i @ x|| for each row i.\n# \n# Equivalently, we need the row-norms of p @ x.\n# p @ x has shape (B,H,L,C). Row norms = (B,H,L).\n# \n# Alternative: use the formula ||p @ x||_row = sqrt(diag(p @ G @ p''^T))\n# where diag is per-row (i.e., (p@G) * p summed along last dim).\n# \n# We'\"'re already doing this efficiently.\n\n# What about: since we need both p1 and p_mix norms, and p_mix = (1-b)*p0 + b*p1,\n# can we use p0@G and p1@G to derive p_mix@G norms?\n# \n# ||p_mix_i @ x||\"'^2 = ((1-b)*p0_i + b*p1_i) @ G @ ((1-b)*p0_i + b*p1_i)''^T\n# = (1-b)''^2 * ||p0_i@x||''^2 + b''^2 * ||p1_i@x||''^2 + 2*(1-b)*b * (p0_i @ G @ p1_i''^T)\n# \n# The cross term is tricky. We'\"'d need p0_i @ G @ p1_i\"'^T for each row i.\n# That'\"'s (p0 @ G) * p1 summed along last dim — same work as computing p0@G.\n# So total: p0@G + p1@G (2 matmuls) + elementwise work.\n# Old total: p1@G + p_mix@G (2 matmuls) + elementwise work.\n# Same number of matmuls. No win.\n\n# What if we fuse the v projection with something?\n# v = x @ wv\"'^T is B*L*C*H*D = 1*256*1280*20*64 = 419M FLOPs\n# Can'\"'t avoid this.\n\n# Let's check: what about computing u = p_mix @ x and then doing u @ wv\"'^T?\n# No, that'\"'s worse as shown above.\n\n# Let me look at where the actual time goes more carefully.\nprint('--- Full breakdown ---')\n\n# Warm\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nv = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\nlogits = q @ k.transpose(-1, -2)\nlogits.mul_(inv_sqrt_d)\np0 = logits.softmax(dim=-1)\n\na_p = 0.5 * (1.0 + alpha)\na_m = 0.5 * (1.0 - alpha)\np1_logits = logits.mul(a_p)\np1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\np1 = p1_logits.softmax(dim=-1)\np_mix = torch.lerp(p0, p1, beta)\n\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\n\nprint('p0 shape:', p0.shape, 'memory:', p0.numel() * 4 / 1024 / 1024, 'MB')\nprint('p1 shape:', p1.shape, 'memory:', p1.numel() * 4 / 1024 / 1024, 'MB')\nprint('G shape:', G.shape, 'memory:', G.numel() * 4 / 1024 / 1024, 'MB')\n\n# Maybe we can avoid storing p0 explicitly? \n# p_mix = (1-b)*p0 + b*p1\n# We need p0 for... the base output. But output = r * (p_mix @ v)\n# Wait let me re-read the problem:\n# m = u0 + beta*(u1-u0)  -- this is p_mix @ x (in C-space) or p_mix @ v (in v-space)\n# r = clamp(||u1|| / ||m||, 0.25, 4.0)\n# return (r * m) @ wv\"'^T\n# \n# In v-space: m = p_mix @ v, u1 = p1 @ v\n# Wait NO! u1 = P1 @ x (in C-space), and ||u1|| is the norm in C-space.\n# u1 in v-space would be (P1 @ x) @ wv''^T, which is different from P1 @ v.\n# \n# Let me re-check the current solution:\n# G = x @ x''^T. p1@G gives p1 @ x @ x''^T. Row-squared-norm of p1@x = (p1@G * p1).sum(-1).\n# Yes! That'\"'s ||p1 @ x||\"'^2 in C-space. Good.\n# \n# But then the output is (p_mix @ v) * ratio. And v = x @ wv''^T.\n# So output = p_mix @ (x @ wv''^T) = (p_mix @ x) @ wv''^T = m @ wv''^T (in C-space).\n# And ratio = ||u1|| / ||m||.\n# Final output: ratio * m @ wv''^T.\n# \n# Yes this is correct: (r * m) @ wv''^T = r * (m @ wv''^T) = r * (p_mix @ v).\n\nprint()\nprint('\"'All correct. Now let me think about the v projection + p_mix@v fusion.')\n\n# Can we do: p_mix is (B,H,L,L), wv is (H,D,C) -> can we compute (p_mix @ x @ wv\"'^T) \n# by first computing x @ wv''^T (= v, which we do) then p_mix @ v.\n# That'\"'s the current approach. No better option.\n\n# What about memory layout? Let's see if contiguous / stride matters.\nq_4d = q\nk_4d = k\nv_4d = v\n\n# Reshape to 3D for bmm\nq_3d = q.reshape(B*H, L, D)\nk_3d = k.reshape(B*H, L, D)\nv_3d = v.reshape(B*H, L, D)\n\n# Check if they're contiguous\nprint('q_4d contiguous:', q_4d.is_contiguous())\nprint('q_3d contiguous:', q_3d.is_contiguous())\n\n# Let me try the full attention with 3D (B*H) approach to see if it's faster\ndef attention_3d():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B*L, H, D).permute(1, 0, 2)  # (H, B*L, D)\n    # Actually let's do it properly\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).reshape(B*H, L, D)\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).reshape(B*H, L, D)\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).reshape(B*H, L, D)\n    \n    logits = torch.bmm(q, k.transpose(-1, -2))\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    \n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    \n    # p_mix is (B*H, L, L)\n    # G is (B, L, L) - need to broadcast\n    G = x @ x.transpose(-1, -2)  # (B, L, L)\n    # For p@G: (B*H, L, L) @ (B, L, L) -> need to expand G\n    G_bh = G.unsqueeze(1).expand(B, H, L, L).reshape(B*H, L, L)\n    \n    p1G = torch.bmm(p1, G_bh)\n    norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n    pmG = torch.bmm(p_mix, G_bh)\n    normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n    \n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    \n    y = torch.bmm(p_mix, v).mul_(ratio)\n    return y.reshape(B, H, L, D).transpose(1, 2).flatten(2).contiguous()\n\nout_3d = attention_3d()\nprint(f'3d vs ref diff: {(ref - out_3d).abs().max():.6e}')\n\nbench('attention_3d', attention_3d)\nbench('attention (current)', lambda: attention(x, wq, wk, wv, alpha, beta))\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math, statistics\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n# Import current solution\nimport sys\nsys.path.insert(0, '/workspace/solution')\nfrom method import attention\n\n# Largest case\nB, L, C, H, D = 1, 256, 1280, 20, 64\ng = torch.Generator().manual_seed(42)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwv = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nalpha, beta = 1.05, 5.0\n\n# Warmup\nfor _ in range(3):\n    y = attention(x, wq, wk, wv, alpha, beta)\n\n# Benchmark total\ntimes = []\nfor _ in range(11):\n    t0 = time.perf_counter()\n    y = attention(x, wq, wk, wv, alpha, beta)\n    times.append((time.perf_counter() - t0) * 1000)\nprint(f'Total: {statistics.median(times):.2f} ms')\n\n# Now profile each stage\nimport torch\nxr = x.reshape(B*L, C)\nHD = H * D\ninv_sqrt_d = 1.0 / math.sqrt(D)\n\ndef bench(name, fn, n=11):\n    fn()  # warmup\n    times = []\n    for _ in range(n):\n        t0 = time.perf_counter()\n        fn()\n        times.append((time.perf_counter() - t0) * 1000)\n    print(f'{name}: {statistics.median(times):.2f} ms')\n    return statistics.median(times)\n\n# Projections\ndef proj():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    return q, k, v\nq, k, v = proj()\nbench('Projections (q,k,v)', proj)\n\n# q@k\"'^T\nbench('\"'q@k\"'^T'\"', lambda: q @ k.transpose(-1, -2))\nlogits = q @ k.transpose(-1, -2)\nlogits.mul_(inv_sqrt_d)\n\n# softmax\nbench('softmax', lambda: logits.softmax(dim=-1))\np0 = logits.softmax(dim=-1)\n\n# p1_logits\na_p, a_m = 0.5*(1+alpha), 0.5*(1-alpha)\nbench('p1_logits', lambda: logits.mul(a_p) + a_m * logits.transpose(-1,-2))\np1_logits = logits.mul(a_p) + a_m * logits.transpose(-1,-2)\np1 = p1_logits.softmax(dim=-1)\n\n# p_mix\nbench('p_mix (lerp)', lambda: torch.lerp(p0, p1, beta))\np_mix = torch.lerp(p0, p1, beta)\n\n# Gram\nbench('G = x @ x.T', lambda: x @ x.transpose(-1,-2))\nG = x @ x.transpose(-1,-2)\nG_exp = G.unsqueeze(1)\n\n# p1 @ G\nbench('p1 @ G', lambda: p1 @ G_exp)\np1G = p1 @ G_exp\n\n# p_mix @ G\nbench('p_mix @ G', lambda: p_mix @ G_exp)\npmG = p_mix @ G_exp\n\n# norm computations\nbench('norm computation', lambda: (p1G * p1).sum(dim=-1).sqrt())\n\n# p_mix @ v\nbench('p_mix @ v', lambda: p_mix @ v)\n\n# ratio + output\nbench('ratio + output', lambda: ((p_mix @ v) * (p1G.norm(dim=-1)/pmG.norm(dim=-1)).clamp(0.25,4.0).unsqueeze(-1)).transpose(1,2).flatten(2).contiguous())\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

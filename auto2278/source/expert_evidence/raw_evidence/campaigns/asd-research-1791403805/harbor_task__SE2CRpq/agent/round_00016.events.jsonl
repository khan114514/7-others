T. p1@G gives p1 @ x @ x''^T. Row-squared-norm of p1@x = (p1@G * p1).sum(-1).\n# Yes! That'\"'s ||p1 @ x||\"'^2 in C-space. Good.\n# \n# But then the output is (p_mix @ v) * ratio. And v = x @ wv''^T.\n# So output = p_mix @ (x @ wv''^T) = (p_mix @ x) @ wv''^T = m @ wv''^T (in C-space).\n# And ratio = ||u1|| / ||m||.\n# Final output: ratio * m @ wv''^T.\n# \n# Yes this is correct: (r * m) @ wv''^T = r * (m @ wv''^T) = r * (p_mix @ v).\n\nprint()\nprint('\"'All correct. Now let me think about the v projection + p_mix@v fusion.')\n\n# Can we do: p_mix is (B,H,L,L), wv is (H,D,C) -> can we compute (p_mix @ x @ wv\"'^T) \n# by first computing x @ wv''^T (= v, which we do) then p_mix @ v.\n# That'\"'s the current approach. No better option.\n\n# What about memory layout? Let's see if contiguous / stride matters.\nq_4d = q\nk_4d = k\nv_4d = v\n\n# Reshape to 3D for bmm\nq_3d = q.reshape(B*H, L, D)\nk_3d = k.reshape(B*H, L, D)\nv_3d = v.reshape(B*H, L, D)\n\n# Check if they're contiguous\nprint('q_4d contiguous:', q_4d.is_contiguous())\nprint('q_3d contiguous:', q_3d.is_contiguous())\n\n# Let me try the full attention with 3D (B*H) approach to see if it's faster\ndef attention_3d():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B*L, H, D).permute(1, 0, 2)  # (H, B*L, D)\n    # Actually let's do it properly\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).reshape(B*H, L, D)\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).reshape(B*H, L, D)\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).reshape(B*H, L, D)\n    \n    logits = torch.bmm(q, k.transpose(-1, -2))\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    \n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    \n    # p_mix is (B*H, L, L)\n    # G is (B, L, L) - need to broadcast\n    G = x @ x.transpose(-1, -2)  # (B, L, L)\n    # For p@G: (B*H, L, L) @ (B, L, L) -> need to expand G\n    G_bh = G.unsqueeze(1).expand(B, H, L, L).reshape(B*H, L, L)\n    \n    p1G = torch.bmm(p1, G_bh)\n    norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n    pmG = torch.bmm(p_mix, G_bh)\n    normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n    \n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    \n    y = torch.bmm(p_mix, v).mul_(ratio)\n    return y.reshape(B, H, L, D).transpose(1, 2).flatten(2).contiguous()\n\nout_3d = attention_3d()\nprint(f'3d vs ref diff: {(ref - out_3d).abs().max():.6e}')\n\nbench('attention_3d', attention_3d)\nbench('attention (current)', lambda: attention(x, wq, wk, wv, alpha, beta))\n\\\"\n\"","aggregated_output":"--- Full breakdown ---\np0 shape: torch.Size([1, 20, 256, 256]) memory: 5.0 MB\np1 shape: torch.Size([1, 20, 256, 256]) memory: 5.0 MB\nG shape: torch.Size([1, 256, 256]) memory: 0.25 MB\n\nAll correct. Now let me think about the v projection + p_mix@v fusion.\nq_4d contiguous: True\nq_3d contiguous: True\n3d vs ref diff: 0.000000e+00\nattention_3d: 132.84 ms\nattention (current): 101.06 ms\n","exit_code":0,"status":"completed"}}

{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport torch, math, time, statistics\ntorch.set_num_threads(1)\n\nfrom method import attention\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\ng = torch.Generator().manual_seed(42)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwv = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nalpha, beta = 1.05, 5.0\n\nref = attention(x, wq, wk, wv, alpha, beta)\nHD = H * D\nxr = x.reshape(B*L, C)\ninv_sqrt_d = 1.0 / math.sqrt(D)\n\ndef bench(name, fn, n=21):\n    fn()\n    times = []\n    for _ in range(n):\n        t0 = time.perf_counter()\n        fn()\n        times.append((time.perf_counter() - t0) * 1000)\n    print(f'{name}: {statistics.median(times):.3f} ms')\n\n# --- Test: scaling wk weights by inv_sqrt_d ---\nwk_scaled = wk * inv_sqrt_d\n\ndef proj_with_scaled_k():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk_scaled.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    return q, k, v\n\ndef proj_normal():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    return q, k, v\n\nbench('projections (normal)', proj_normal)\nbench('projections (scaled wk)', proj_with_scaled_k)\n\nq_n, k_n, v_n = proj_normal()\nq_s, k_s, v_s = proj_with_scaled_k()\n\nlogits_n = q_n @ k_n.transpose(-1,-2) * inv_sqrt_d\nlogits_s = q_s @ k_s.transpose(-1,-2)\nprint(f'scaled wk logits diff: {(logits_n - logits_s).abs().max():.6e}')\n\n# This is the key: by scaling wk weights, we avoid the logits.mul_(inv_sqrt_d) step\n# And the scaling of wk is O(H*D*C) = 20*64*1280 = 1.6M elements, done once\n# Whereas logits scaling is O(B*H*L*L) = 20*256*256 = 1.3M elements per call\n# Similar cost, but saves a separate kernel launch.\n\n# Let's also try: can we avoid the .contiguous() on q,k,v?\n# The 4D matmul q @ k.transpose(-1,-2) should work with non-contiguous tensors.\n\nq_nc = q_n  # not contiguous after permute\nk_nc = k_n\nprint(f'q is contiguous: {q_nc.is_contiguous()}')\nprint(f'k is contiguous: {k_nc.is_contiguous()}')\n\nbench('logits (contiguous)', lambda: q_n.contiguous() @ k_n.contiguous().transpose(-1,-2))\nbench('logits (non-contig)', lambda: q_nc @ k_nc.transpose(-1,-2))\n\n# --- Full optimized attention v2 ---\n@torch.no_grad()\ndef attention_v2(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    xr = x.reshape(B * L, C)\n    \n    # Scale wk by inv_sqrt_d to fuse logits scaling into projection\n    wk_s = wk.mul(inv_sqrt_d).reshape(HD, C)\n    wq_r = wq.reshape(HD, C)\n    wv_r = wv.reshape(HD, C)\n    \n    q = (xr @ wq_r.T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk_s.T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wv_r.T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    \n    logits = q @ k.transpose(-1, -2)\n    p0 = logits.softmax(dim=-1)\n    \n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1_logits = logits.mul(a_p)\n        p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n        p1 = p1_logits.softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n\n        p1G = p1 @ G_exp\n        norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n\n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n\n        y = (p_mix @ v).mul_(ratio)\n\n    return y.transpose(1, 2).flatten(2).contiguous()\n\nout_v2 = attention_v2(x, wq, wk, wv, alpha, beta)\nprint(f'v2 vs ref diff: {(ref - out_v2).abs().max():.6e}')\n\nbench('current attention', lambda: attention(x, wq, wk, wv, alpha, beta))\nbench('v2 (fused k scaling)', lambda: attention_v2(x, wq, wk, wv, alpha, beta))\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport torch, math, time, statistics\ntorch.set_num_threads(1)\n\nfrom method import attention\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\ng = torch.Generator().manual_seed(42)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwv = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nalpha, beta = 1.05, 5.0\n\nref = attention(x, wq, wk, wv, alpha, beta)\nHD = H * D\nxr = x.reshape(B*L, C)\ninv_sqrt_d = 1.0 / math.sqrt(D)\n\ndef bench(name, fn, n=21):\n    fn()\n    times = []\n    for _ in range(n):\n        t0 = time.perf_counter()\n        fn()\n        times.append((time.perf_counter() - t0) * 1000)\n    print(f'{name}: {statistics.median(times):.3f} ms')\n\n# --- Test: scaling wk weights by inv_sqrt_d ---\nwk_scaled = wk * inv_sqrt_d\n\ndef proj_with_scaled_k():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk_scaled.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    return q, k, v\n\ndef proj_normal():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    return q, k, v\n\nbench('projections (normal)', proj_normal)\nbench('projections (scaled wk)', proj_with_scaled_k)\n\nq_n, k_n, v_n = proj_normal()\nq_s, k_s, v_s = proj_with_scaled_k()\n\nlogits_n = q_n @ k_n.transpose(-1,-2) * inv_sqrt_d\nlogits_s = q_s @ k_s.transpose(-1,-2)\nprint(f'scaled wk logits diff: {(logits_n - logits_s).abs().max():.6e}')\n\n# This is the key: by scaling wk weights, we avoid the logits.mul_(inv_sqrt_d) step\n# And the scaling of wk is O(H*D*C) = 20*64*1280 = 1.6M elements, done once\n# Whereas logits scaling is O(B*H*L*L) = 20*256*256 = 1.3M elements per call\n# Similar cost, but saves a separate kernel launch.\n\n# Let's also try: can we avoid the .contiguous() on q,k,v?\n# The 4D matmul q @ k.transpose(-1,-2) should work with non-contiguous tensors.\n\nq_nc = q_n  # not contiguous after permute\nk_nc = k_n\nprint(f'q is contiguous: {q_nc.is_contiguous()}')\nprint(f'k is contiguous: {k_nc.is_contiguous()}')\n\nbench('logits (contiguous)', lambda: q_n.contiguous() @ k_n.contiguous().transpose(-1,-2))\nbench('logits (non-contig)', lambda: q_nc @ k_nc.transpose(-1,-2))\n\n# --- Full optimized attention v2 ---\n@torch.no_grad()\ndef attention_v2(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    xr = x.reshape(B * L, C)\n    \n    # Scale wk by inv_sqrt_d to fuse logits scaling into projection\n    wk_s = wk.mul(inv_sqrt_d).reshape(HD, C)\n    wq_r = wq.reshape(HD, C)\n    wv_r = wv.reshape(HD, C)\n    \n    q = (xr @ wq_r.T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk_s.T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wv_r.T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    \n    logits = q @ k.transpose(-1, -2)\n    p0 = logits.softmax(dim=-1)\n    \n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1_logits = logits.mul(a_p)\n        p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n        p1 = p1_logits.softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n\n        p1G = p1 @ G_exp\n        norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n\n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n\n        y = (p_mix @ v).mul_(ratio)\n\n    return y.transpose(1, 2).flatten(2).contiguous()\n\nout_v2 = attention_v2(x, wq, wk, wv, alpha, beta)\nprint(f'v2 vs ref diff: {(ref - out_v2).abs().max():.6e}')\n\nbench('current attention', lambda: attention(x, wq, wk, wv, alpha, beta))\nbench('v2 (fused k scaling)', lambda: attention_v2(x, wq, wk, wv, alpha, beta))\n\\\"\n\"","aggregated_output":"projections (normal): 42.022 ms\nprojections (scaled wk): 41.278 ms\nscaled wk logits diff: 0.000000e+00\nq is contiguous: False\nk is contiguous: False\nlogits (contiguous): 2.957 ms\nlogits (non-contig): 3.920 ms\nv2 vs ref diff: 0.000000e+00\ncurrent attention: 103.615 ms\nv2 (fused k scaling): 110.926 ms\n","exit_code":0,"status":"completed"}}

{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport torch, math, time, statistics\ntorch.set_num_threads(1)\n\nfrom method import attention\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\ng = torch.Generator().manual_seed(42)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwv = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nalpha, beta = 1.05, 5.0\n\nref = attention(x, wq, wk, wv, alpha, beta)\nHD = H * D\nxr = x.reshape(B*L, C)\ninv_sqrt_d = 1.0 / math.sqrt(D)\n\ndef bench(name, fn, n=11):\n    fn()\n    times = []\n    for _ in range(n):\n        t0 = time.perf_counter()\n        fn()\n        times.append((time.perf_counter() - t0) * 1000)\n    print(f'{name}: {statistics.median(times):.2f} ms')\n\n# Test 1: stacked projections\nwq_flat = wq.reshape(HD, C)\nwk_flat = wk.reshape(HD, C)\nwv_flat = wv.reshape(HD, C)\n\ndef separate_proj():\n    q = (xr @ wq_flat.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk_flat.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv_flat.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    return q, k, v\n\ndef stacked_proj():\n    w_all = torch.cat([wq_flat, wk_flat, wv_flat], dim=0)  # (3*HD, C)\n    out = xr @ w_all.T  # (B*L, 3*HD)\n    out = out.reshape(B, L, 3, H, D).permute(2, 0, 3, 1, 4).contiguous()\n    return out[0], out[1], out[2]\n\nq, k, v = separate_proj()\nq2, k2, v2 = stacked_proj()\nprint(f'stacked proj q diff: {(q-q2).abs().max():.6e}')\nprint(f'stacked proj k diff: {(k-k2).abs().max():.6e}')\nprint(f'stacked proj v diff: {(v-v2).abs().max():.6e}')\n\nbench('separate_proj', separate_proj)\nbench('stacked_proj', stacked_proj)\n\n# Test 2: F.linear vs manual matmul\ndef linear_proj():\n    q = torch.nn.functional.linear(xr, wq_flat).reshape(B, L, H, D).permute(0,2,1,3).contiguous()\n    k = torch.nn.functional.linear(xr, wk_flat).reshape(B, L, H, D).permute(0,2,1,3).contiguous()\n    v = torch.nn.functional.linear(xr, wv_flat).reshape(B, L, H, D).permute(0,2,1,3).contiguous()\n    return q, k, v\nbench('F.linear_proj', linear_proj)\n\n# Test 3: bmm vs 4D matmul\nq_bmm = q.reshape(B*H, L, D)\nk_bmm = k.reshape(B*H, L, D)\nv_bmm = v.reshape(B*H, L, D)\n\nlogits_4d = q @ k.transpose(-1,-2)\nlogits_bmm = torch.bmm(q_bmm, k_bmm.transpose(-1,-2))\nprint(f'bmm logits diff: {(logits_4d.reshape(B*H,L,L) - logits_bmm).abs().max():.6e}')\n\nbench('4d q@k\"'^T'\"', lambda: q @ k.transpose(-1,-2))\nbench('bmm q@k\"'^T'\"', lambda: torch.bmm(q_bmm, k_bmm.transpose(-1,-2)))\n\np0 = logits_4d.softmax(dim=-1)\np0_bmm = logits_bmm.softmax(dim=-1)\n\nbench('4d p@v', lambda: p0 @ v)\nbench('bmm p@v', lambda: torch.bmm(p0_bmm, v_bmm))\n\n# Test 4: SDPA\nbench('sdpa (p0@v)', lambda: torch.nn.functional.scaled_dot_product_attention(q, k, v, scale=inv_sqrt_d))\n\nsdpa_out = torch.nn.functional.scaled_dot_product_attention(q, k, v, scale=inv_sqrt_d)\nmanual_out = p0 * inv_sqrt_d  # no, just check p0@v\nmanual_out = p0 @ v\nprint(f'sdpa vs manual p0@v diff: {(sdpa_out - manual_out).abs().max():.6e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport torch, math, time, statistics\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\ng = torch.Generator().manual_seed(42)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwv = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n\nHD = H * D\nxr = x.reshape(B*L, C)\n\ndef bench(name, fn, n=21):\n    fn()\n    times = []\n    for _ in range(n):\n        t0 = time.perf_counter()\n        fn()\n        times.append((time.perf_counter() - t0) * 1000)\n    print(f'{name}: {statistics.median(times):.3f} ms')\n\n# Current approach: reshape + matmul + reshape + permute + contiguous\ndef proj_v1():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    return q, k, v\n\n# einsum\ndef proj_v2():\n    q = torch.einsum('blc,hdc->bhld', x, wq).contiguous()\n    k = torch.einsum('blc,hdc->bhld', x, wk).contiguous()\n    v = torch.einsum('blc,hdc->bhld', x, wv).contiguous()\n    return q, k, v\n\n# Weights reshaped to (H, C, D), then x.unsqueeze -> (B, 1, L, C) @ (1, H, C, D)... no\n# Better: treat as (B, L, C) @ (H, C, D) -> need to broadcast H dim\n# Or: reshape weights to (H*C, D)? No.\n# \n# Alternative: reshape wq to (H, C, D), then:\n# x (B, L, C) -> x_exp (B, 1, L, C)\n# wq (H, C, D) -> wq_exp (1, H, C, D)\n# Can't easily matmul these with different batch dims.\n\n# What about: reshape x to (B*L, C), w to (C, H*D), get (B*L, H*D), \n# then reshape to (B, L, H, D), then permute\n# Same as v1 essentially.\n\n# What if we transpose the weight so it's (H, C, D), then reshape to (C, H*D),\n# then x @ w\"'^T... wait that'\"'s the same.\n\n# What about computing all three projections in one big matmul?\n# w_all = cat(wq, wk, wv) in HD dim -> (3*HD, C)\n# out = xr @ w_all.T -> (B*L, 3*HD)\n# reshape to (B, L, 3, H, D) -> permute to (3, B, H, L, D)\nw_all = torch.cat([wq.reshape(HD, C), wk.reshape(HD, C), wv.reshape(HD, C)], dim=0)\ndef proj_v3():\n    out = xr @ w_all.T\n    out = out.reshape(B, L, 3, H, D).permute(2, 0, 3, 1, 4).contiguous()\n    return out[0], out[1], out[2]\n\nbench('v1 (reshape+permute)', proj_v1)\nbench('v2 (einsum)', proj_v2)\nbench('v3 (stacked)', proj_v3)\n\nq1, k1, v1 = proj_v1()\nq3, k3, v3 = proj_v3()\nprint(f'q diff: {(q1-q3).abs().max():.6e}')\nprint(f'k diff: {(k1-k3).abs().max():.6e}')\nprint(f'v diff: {(v1-v3).abs().max():.6e}')\n\n# What about: output in (B, L, H, D) format, and adjust rest of the code?\n# Let me see what format we need for q@k\"'^T.\n# If q is (B, L, H, D), we need q @ k''^T per head: (B, L, D) @ (B, D, L) per head -> (B, L, L) per head\n# With H dim: (B, H, L, D) @ (B, H, D, L) = (B, H, L, L)\n# So we need H before L.\n# \n# What if we compute logits differently?\n# logits[b,h,i,j] = sum_d q[b,l=i,h,d] * k[b,l=j,h,d] / sqrt(D)\n# = einsum('\"'bihd,bjhd->bhij', q, k)\n# where q is (B, L, H, D)\n#\n# Let's try:\nq_bldh = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D)\nk_bldh = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D)\n\n# Option A: permute to BH then matmul\nlogits_a = q_bldh.permute(0,2,1,3) @ k_bldh.permute(0,2,3,1)\n\n# Option B: einsum directly from BLHD\nlogits_b = torch.einsum('blhd,bmhd->bh lm', q_bldh, k_bldh)\nprint(f'logits diff: {(logits_a - logits_b).abs().max():.6e}')\n\nbench('logits via permute+matmul', lambda: q_bldh.permute(0,2,1,3) @ k_bldh.permute(0,2,3,1))\nbench('logits via einsum', lambda: torch.einsum('blhd,bmhd->bhlm', q_bldh, k_bldh))\n\n# softmax of (B, H, L, L) vs (B, L, L, H)?\n# Softmax over last dim. For BHLL, last dim is L (correct).\n# For BLLH, last dim is H (wrong, we need L).\n# So we need BHLL or equivalent.\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/sh -lc 'cd /workspace && python3 -c \"\nimport torch, math, time, statistics\n\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\ng = torch.Generator().manual_seed(42)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwv = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nalpha, beta = 1.05, 5.0\n\n# Compute reference\nfrom method import attention\nref = attention(x, wq, wk, wv, alpha, beta)\n\n# Manual computation with cross-term norm\nHD = H * D\nxr = x.reshape(B*L, C)\ninv_sqrt_d = 1.0 / math.sqrt(D)\n\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\nv = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n\nlogits = (q @ k.transpose(-1,-2)) * inv_sqrt_d\np0 = logits.softmax(dim=-1)\n\na_p = 0.5*(1+alpha)\na_m = 0.5*(1-alpha)\np1_logits = a_p * logits + a_m * logits.transpose(-1,-2)\np1 = p1_logits.softmax(dim=-1)\n\np_mix = torch.lerp(p0, p1, beta)\n\nG = x @ x.transpose(-1,-2)\nG_exp = G.unsqueeze(1)\n\n# Old way: two p@G matmuls\np1G = p1 @ G_exp\nnorm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\npmG = p_mix @ G_exp\nnormm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n\n# New way: p0@G and p1@G, derive normm_sq from cross\n# normm_sq = ||p_mix @ x||''^2 = ((1-b)*p0 + b*p1) @ G @ ((1-b)*p0 + b*p1)''^T\n# But we need per-row norm: for each row i of p_mix:\n# normm_sq[i] = sum_j sum_k p_mix[i,j] * G[j,k] * p_mix[i,k]\n# = (1-b)''^2 * (p0@G*p0).sum(-1) + b''^2 * (p1@G*p1).sum(-1) + 2*(1-b)*b * (p0@G*p1).sum(-1)\np0G = p0 @ G_exp\np1G = p1 @ G_exp\n\nb = beta\none_minus_b = 1.0 - b\nnorm0_sq = (p0G * p0).sum(dim=-1, keepdim=True)\nnorm1_sq_new = (p1G * p1).sum(dim=-1, keepdim=True)\ncross_sq = (p0G * p1).sum(dim=-1, keepdim=True)\n\nnormm_sq_new = one_minus_b**2 * norm0_sq + b**2 * norm1_sq_new + 2*one_minus_b*b * cross_sq\n\nprint(f'\"'norm1_sq max diff: {(norm1_sq - norm1_sq_new).abs().max():.6e}')\nprint(f'normm_sq max diff: {(normm_sq - normm_sq_new).abs().max():.6e}')\n\nnorm1 = norm1_sq.sqrt().clamp(min=1e-6)\nnormm = normm_sq.sqrt().clamp(min=1e-6)\nratio = (norm1 / normm).clamp(0.25, 4.0)\n\nnorm1_new = norm1_sq_new.sqrt().clamp(min=1e-6)\nnormm_new = normm_sq_new.sqrt().clamp(min=1e-6)\nratio_new = (norm1_new / normm_new).clamp(0.25, 4.0)\n\nprint(f'ratio max diff: {(ratio - ratio_new).abs().max():.6e}')\n\ny_new = (p_mix @ v) * ratio_new\ny_new = y_new.transpose(1, 2).flatten(2).contiguous()\n\nprint(f'output max diff: {(ref - y_new).abs().max():.6e}')\nprint(f'output rel diff: {((ref - y_new).abs() / ref.abs().clamp(min=1e-8)).max():.6e}')\n\n# Benchmark: p0@G + p1@G + 3 element-wise sums vs p1@G + p_mix@G + 2 sums\ndef bench(name, fn, n=11):\n    fn()\n    times = []\n    for _ in range(n):\n        t0 = time.perf_counter()\n        fn()\n        times.append((time.perf_counter() - t0) * 1000)\n    print(f'{name}: {statistics.median(times):.2f} ms')\n\n# Old way\ndef old_norms():\n    p1G = p1 @ G_exp\n    n1 = (p1G * p1).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    pmG = p_mix @ G_exp\n    nm = (pmG * p_mix).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    return (n1 / nm).clamp_(0.25, 4.0)\n\n# New way\ndef new_norms():\n    p0G = p0 @ G_exp\n    p1G = p1 @ G_exp\n    n0 = (p0G * p0).sum(dim=-1, keepdim=True)\n    n1 = (p1G * p1).sum(dim=-1, keepdim=True)\n    cross = (p0G * p1).sum(dim=-1, keepdim=True)\n    nm = (one_minus_b**2 * n0 + b**2 * n1 + 2*one_minus_b*b * cross).sqrt_().clamp_min_(1e-6)\n    n1s = n1.sqrt_().clamp_min_(1e-6)\n    return (n1s / nm).clamp_(0.25, 4.0)\n\nbench('old norm approach', old_norms)\nbench('new norm approach', new_norms)\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

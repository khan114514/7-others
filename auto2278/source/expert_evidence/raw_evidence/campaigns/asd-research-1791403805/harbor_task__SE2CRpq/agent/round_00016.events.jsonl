{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport torch, math, time, statistics\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\ng = torch.Generator().manual_seed(42)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwv = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nalpha, beta = 1.05, 5.0\n\nHD = H * D\nxr = x.reshape(B*L, C)\ninv_sqrt_d = 1.0 / math.sqrt(D)\n\ndef bench(name, fn, n=21):\n    fn()\n    times = []\n    for _ in range(n):\n        t0 = time.perf_counter()\n        fn()\n        times.append((time.perf_counter() - t0) * 1000)\n    print(f'{name}: {statistics.median(times):.3f} ms')\n\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nv = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\n# Test fusing inv_sqrt_d into q\nq_scaled = q * inv_sqrt_d\nlogits1 = q @ k.transpose(-1,-2) * inv_sqrt_d\nlogits2 = q_scaled @ k.transpose(-1,-2)\nprint(f'logits diff: {(logits1 - logits2).abs().max():.6e}')\n\nbench('q@kT * s', lambda: (q @ k.transpose(-1,-2)).mul_(inv_sqrt_d))\nbench('q_scaled@kT', lambda: q_scaled @ k.transpose(-1,-2))\n\n# Test: scale q in-place after computing it\n# vs: scale logits after computing\n# The q scaling approach: q_scaled @ k\"'^T is one fewer op\n# But we need unscaled q? No, we only need q for logits.\n\n# What about scaling k instead? Same thing.\n\n# Test in-place logits vs out-of-place\nlogits = q @ k.transpose(-1,-2)\nbench('\"'logits = q@kT; logits.mul_(s)', lambda: (q @ k.transpose(-1,-2)).mul_(inv_sqrt_d))\nbench('logits = q@kT * s', lambda: q @ k.transpose(-1,-2) * inv_sqrt_d)\n\n# Now let me try the overall approach more carefully.\n# Key idea: can we save the G computation and one p@G?\n# \n# We need: ||p1@x|| and ||p_mix@x||\n# \n# Alternative approach for norms:\n# u1 = p1 @ v (in v-space) -- we need this for output anyway? No, output is p_mix @ v.\n# Wait, ||p1@x|| \"'!= ||p1@v||. The norm is in input (C) space, not v-space.\n# So we can'\"'t avoid computing it via G or via p1@x.\n# \n# But what if we compute p1@x directly for norm purposes? \n# p1@x has shape (B,H,L,C) and is B*H*L\"'^2*C = 1.68B FLOPs. Way worse than p1@G (336M).\n# So G approach is clearly better.\n\n# Another thought: can we reuse the G computation with the logits somehow?\n# logits = q @ k''^T / sqrt(D), G = x @ x''^T\n# q = x @ wq''^T, k = x @ wk''^T\n# logits = x @ wq''^T @ wk @ x''^T / sqrt(D) = x @ (wq''^T@wk) @ x''^T / sqrt(D)\n# G = x @ x''^T\n# These are different quadratic forms. Can'\"'t easily share.\n\n# Let me try: what if we compute G before everything and see if it helps with data locality?\n# Probably not much.\n\n# Let me try the 3D (B*H) approach with bmm more carefully.\nq_3d = q.reshape(B*H, L, D)\nk_3d = k.reshape(B*H, L, D)\nv_3d = v.reshape(B*H, L, D)\n\nlogits_3d = torch.bmm(q_3d, k_3d.transpose(-1,-2))\nlogits_3d.mul_(inv_sqrt_d)\np0_3d = logits_3d.softmax(dim=-1)\n\na_p = 0.5*(1+alpha)\na_m = 0.5*(1-alpha)\np1_logits_3d = a_p * logits_3d + a_m * logits_3d.transpose(-1,-2)\np1_3d = p1_logits_3d.softmax(dim=-1)\np_mix_3d = torch.lerp(p0_3d, p1_3d, beta)\n\n# G with bmm: G is (B, L, L), need (B*H, L, L)\nG = x @ x.transpose(-1,-2)\n\n# Option 1: expand G to (B*H, L, L) then bmm\nG_bh = G.unsqueeze(1).expand(B, H, L, L).reshape(B*H, L, L)\n\nbench('bmm p1@G (expanded G)', lambda: torch.bmm(p1_3d, G_bh))\nbench('4d p1@G', lambda: p1_3d.reshape(B,H,L,L) @ G.unsqueeze(1))\n\n# Option 2: reshape p1 to (H, B*L, L)... no, wrong dims.\n\n# What about computing norms from p@G differently?\n# We only need row-wise norms, not full p@G.\n# ||p_i @ x||\"'^2 = p_i @ G @ p_i''^T for each row i of p\n# \n# This is essentially the diagonal of p @ G @ p''^T.\n# Can we compute this more efficiently?\n# \n# In PyTorch, no built-in diagonal-of-matmul function.\n# But we could do: (p @ G) * p sum along dim=-1\n# That'\"'s what we already do.\n# \n# Alternative: use einsum\nbench('einsum norm', lambda: torch.einsum('bij,bjk,bik->bi', p1_3d, G_bh, p1_3d))\nbench('current norm approach', lambda: (torch.bmm(p1_3d, G_bh) * p1_3d).sum(dim=-1))\n\n# Test the result\nnorm1_einsum = torch.einsum('bij,bjk,bik->bi', p1_3d, G_bh, p1_3d)\nnorm1_current = (torch.bmm(p1_3d, G_bh) * p1_3d).sum(dim=-1)\nprint(f'norm diff: {(norm1_einsum - norm1_current).abs().max():.6e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

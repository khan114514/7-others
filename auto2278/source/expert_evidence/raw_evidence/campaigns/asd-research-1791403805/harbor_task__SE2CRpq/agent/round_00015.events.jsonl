{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\nalpha = 1.05\nbeta = 7.5\n\ninv_sqrt_d = 1.0 / math.sqrt(D)\nHD = H * D\nxr = x.reshape(B*L, C)\n\ndef timeit(name, fn, n=7):\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    print(f'{name}: {sorted(times)[len(times)//2]:.3f} ms')\n\n# Full current solution\ndef current():\n    q = (xr @ wq.reshape(HD,C).T).reshape(B,L,H,D).permute(0,2,1,3).contiguous()\n    k = (xr @ wk.reshape(HD,C).T).reshape(B,L,H,D).permute(0,2,1,3).contiguous()\n    v = (xr @ wv.reshape(HD,C).T).reshape(B,L,H,D).permute(0,2,1,3).contiguous()\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    p1G = p1 @ G_exp\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ntimeit('current full', current)\n\n# Try: bmm approach with (B*H, L, D) tensors\ndef opt_bmm():\n    q = (xr @ wq.reshape(HD,C).T).reshape(B, L, H, D).permute(0,2,1,3).reshape(B*H, L, D).contiguous()\n    k = (xr @ wk.reshape(HD,C).T).reshape(B, L, H, D).permute(0,2,1,3).reshape(B*H, L, D).contiguous()\n    v = (xr @ wv.reshape(HD,C).T).reshape(B, L, H, D).permute(0,2,1,3).reshape(B*H, L, D).contiguous()\n    logits = torch.bmm(q, k.transpose(-1, -2))\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.clone().mul_(a_p).add_(logits.transpose(-1,-2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2)  # (B, L, L)\n    G_b = G.expand(B*H, L, L).contiguous()  # (B*H, L, L)\n    p1G = torch.bmm(p1, G_b)\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = torch.bmm(p_mix, G_b)\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    y = torch.bmm(p_mix, v).mul_(ratio)\n    return y.reshape(B, H, L, D).transpose(1, 2).flatten(2).contiguous()\n\ntimeit('opt_bmm full', opt_bmm)\n\n# Check correctness\nout1 = current()\nout2 = opt_bmm()\nprint('max diff:', (out1 - out2).abs().max().item())\nprint('shape match:', out1.shape == out2.shape)\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\nalpha = 1.05\nbeta = 7.5\n\ninv_sqrt_d = 1.0 / math.sqrt(D)\nHD = H * D\nxr = x.reshape(B*L, C)\n\nq = (xr @ wq.reshape(HD,C).T).reshape(B,L,H,D).permute(0,2,1,3).contiguous()\nk = (xr @ wk.reshape(HD,C).T).reshape(B,L,H,D).permute(0,2,1,3).contiguous()\nv = (xr @ wv.reshape(HD,C).T).reshape(B,L,H,D).permute(0,2,1,3).contiguous()\n\nlogits = q @ k.transpose(-1, -2)\nlogits.mul_(inv_sqrt_d)\n\ndef timeit(name, fn, n=5):\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    print(f'{name}: {sorted(times)[len(times)//2]:.3f} ms')\n\na_p = 0.5 * (1+alpha)\na_m = 0.5 * (1-alpha)\n\n# Different approaches for p1_logits\ntimeit('a_p*logits + a_m*T', lambda: a_p * logits + a_m * logits.transpose(-1,-2))\n\n# In-place on a clone\ntimeit('clone + mul_ + add_', lambda: logits.clone().mul_(a_p).add_(logits.transpose(-1,-2), alpha=a_m))\n\n# empty_like + copy + mul + add\ndef approach3():\n    out = torch.empty_like(logits)\n    out.copy_(logits)\n    out.mul_(a_p)\n    out.add_(logits.transpose(-1,-2), alpha=a_m)\n    return out\ntimeit('empty + copy + mul + add', approach3)\n\n# What about using baddbmm?\nlogits_2d = logits.reshape(B*H, L, L)\ntimeit('baddbmm approach', lambda: torch.baddbmm(logits_2d.transpose(-1,-2), logits_2d, torch.eye(L).unsqueeze(0).expand(B*H,L,L), alpha=a_p, beta=a_m))\n\n# actually simpler: a_p*logits + a_m*logits\"'^T\n# = a_m * logits''^T + a_p * I * logits... no not helpful\n\n# Try using addcmul or other fused ops\n# Just benchmark different orderings\ntimeit('\"'a_m*T + a_p*logits', lambda: a_m * logits.transpose(-1,-2) + a_p * logits)\n\n# Softmax on different shapes\np1_logits = a_p * logits + a_m * logits.transpose(-1,-2)\ntimeit('softmax 4D', lambda: p1_logits.softmax(dim=-1))\np1_2d = p1_logits.reshape(B*H*L, L)\ntimeit('softmax 2D', lambda: p1_2d.softmax(dim=-1))\n\n# Custom softmax (log-sum-exp trick) - is PyTorch's already optimal?\ndef manual_softmax(x):\n    m = x.max(dim=-1, keepdim=True).values\n    e = (x - m).exp_()\n    s = e.sum(dim=-1, keepdim=True)\n    return e.div_(s)\ntimeit('manual softmax', lambda: manual_softmax(p1_logits.clone()))\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

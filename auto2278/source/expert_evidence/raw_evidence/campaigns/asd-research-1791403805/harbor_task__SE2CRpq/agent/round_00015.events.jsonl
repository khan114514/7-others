{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\nalpha = 1.05\nbeta = 7.5\n\nHD = H * D\nxr = x.reshape(B*L, C)\n\n# Test: fused q+k projection (2*HD x C)\nwqk = torch.cat([wq.reshape(HD, C), wk.reshape(HD, C)], dim=0)\nqk = xr @ wqk.T\nq = qk[:, :HD].reshape(B, L, H, D).permute(0,2,1,3).contiguous()\nk = qk[:, HD:].reshape(B, L, H, D).permute(0,2,1,3).contiguous()\n\n# Separate\nq2 = (xr @ wq.reshape(HD,C).T).reshape(B,L,H,D).permute(0,2,1,3).contiguous()\nk2 = (xr @ wk.reshape(HD,C).T).reshape(B,L,H,D).permute(0,2,1,3).contiguous()\nv2 = (xr @ wv.reshape(HD,C).T).reshape(B,L,H,D).permute(0,2,1,3).contiguous()\n\nprint('q match:', torch.allclose(q, q2))\nprint('k match:', torch.allclose(k, k2))\n\ndef timeit(name, fn, n=5):\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    print(f'{name}: {sorted(times)[len(times)//2]:.3f} ms')\n\n# Separate projections\ntimeit('3 separate projs', lambda: (\n    (xr @ wq.reshape(HD,C).T).reshape(B,L,H,D).permute(0,2,1,3).contiguous(),\n    (xr @ wk.reshape(HD,C).T).reshape(B,L,H,D).permute(0,2,1,3).contiguous(),\n    (xr @ wv.reshape(HD,C).T).reshape(B,L,H,D).permute(0,2,1,3).contiguous(),\n))\n\n# Fused q+k+v\nwqkv = torch.cat([wq.reshape(HD, C), wk.reshape(HD, C), wv.reshape(HD, C)], dim=0)\ntimeit('1 fused proj', lambda: xr @ wqkv.T)\n\n# Check SDPA\nq_ = q2.reshape(B*H, L, D)\nk_ = k2.reshape(B*H, L, D)\nv_ = v2.reshape(B*H, L, D)\ntimeit('manual attn', lambda: (q_ @ k_.transpose(-1,-2) / math.sqrt(D)).softmax(dim=-1) @ v_)\ntimeit('SDPA', lambda: torch.nn.functional.scaled_dot_product_attention(q_, k_, v_))\n\n# Verify SDPA match\nout_manual = ((q_ @ k_.transpose(-1,-2) / math.sqrt(D)).softmax(dim=-1) @ v_).reshape(B,H,L,D)\nout_sdpa = torch.nn.functional.scaled_dot_product_attention(q_, k_, v_).reshape(B,H,L,D)\nprint('SDPA vs manual max diff:', (out_manual - out_sdpa).abs().max().item())\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

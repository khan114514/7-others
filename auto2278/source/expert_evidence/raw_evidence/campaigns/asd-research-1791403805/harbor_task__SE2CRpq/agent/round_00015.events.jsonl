{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\nalpha = 1.05\nbeta = 7.5\n\ninv_sqrt_d = 1.0 / math.sqrt(D)\nHD = H * D\nxr = x.reshape(B*L, C)\n\ndef timeit(name, fn, n=10):\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    print(f'{name}: {sorted(times)[len(times)//2]:.3f} ms')\n\n# Let me try a bigger optimization: \n# Instead of computing p_mix and then p_mix @ v and p_mix @ G,\n# can we use the identity p_mix = (1-beta)*p0 + beta*p1 to avoid\n# explicitly forming p_mix, and instead compute outputs from p0 and p1?\n\n# Cost analysis:\n# Current: p_mix (lerp), pmix@G, pmix@v = 1 elem op + 2 matmuls\n# Alternative: p0@G, p1@G, p0@v, p1@v + 3 elem ops = 4 matmuls + 3 elem ops\n# That's 2 more matmuls. Worse.\n\n# BUT: we already need p1@G (for norm1) and p1@v is... no we don't need p1@v.\n# We need pmix@v (output) and pmix@G (for normm).\n# Plus p1@G (for norm1).\n# Total: 3 matmuls (p1@G, pmix@G, pmix@v)\n\n# Alternative with p0@p1 cross:\n# p0@G, p1@G (2 matmuls) -> both norms + cross\n# pmix@v = (1-beta)*p0@v + beta*p1@v -> p0@v + p1@v (2 matmuls)\n# Total: 4 matmuls. Worse by 1.\n\n# What if we stack? p0v and p1v from stacked [p0; p1] @ v?\n# Stacked: cat([p0, p1], dim=2) @ v -> (B,H,2L,D) -> 1 matmul\n# Cost: B*H*2L*L*D = 2 * p@v cost = same as 2 separate.\n# No benefit.\n\n# OK, so 3 matmuls is optimal.\n\n# Let me try another angle: what about the projection step?\n# q = x @ wq\"'^T: (B*L, C) @ (C, H*D) = (B*L, H*D)\n# For the logits, we need q in (B,H,L,D) or (B*H,L,D).\n# The current reshape+permute+contiguous is fast (~0.07ms), so not the bottleneck.\n\n# Let me check if torch.mm is faster than @ \nwqr = wq.reshape(HD, C)\ntimeit('\"'x @ w.T', lambda: xr @ wqr.T)\ntimeit('torch.mm', lambda: torch.mm(xr, wqr.T))\ntimeit('torch.matmul', lambda: torch.matmul(xr, wqr.T))\n\n# What if we transpose the weight once and use mm with that?\nwq_T = wqr.T.contiguous()\ntimeit('x @ wq_T', lambda: xr @ wq_T)\n\n# Try with 2D x (no reshape)\ntimeit('x.reshape @ w', lambda: x.reshape(B*L, C) @ wqr.T)\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

da: a_m * logits.transpose(-1,-2) + a_p * logits)\n\n# Softmax on different shapes\np1_logits = a_p * logits + a_m * logits.transpose(-1,-2)\ntimeit('softmax 4D', lambda: p1_logits.softmax(dim=-1))\np1_2d = p1_logits.reshape(B*H*L, L)\ntimeit('softmax 2D', lambda: p1_2d.softmax(dim=-1))\n\n# Custom softmax (log-sum-exp trick) - is PyTorch's already optimal?\ndef manual_softmax(x):\n    m = x.max(dim=-1, keepdim=True).values\n    e = (x - m).exp_()\n    s = e.sum(dim=-1, keepdim=True)\n    return e.div_(s)\ntimeit('manual softmax', lambda: manual_softmax(p1_logits.clone()))\n\\\"\n\"","aggregated_output":"a_p*logits + a_m*T: 5.440 ms\nclone + mul_ + add_: 3.866 ms\nempty + copy + mul + add: 3.716 ms\nbaddbmm approach: 48.954 ms\na_m*T + a_p*logits: 5.609 ms\nsoftmax 4D: 13.616 ms\nsoftmax 2D: 13.354 ms\nmanual softmax: 13.518 ms\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\nHD = H * D\nxr = x.reshape(B*L, C)\n\ndef timeit(name, fn, n=7):\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    print(f'{name}: {sorted(times)[len(times)//2]:.3f} ms')\n\n# 3 separate\ntimeit('3 separate', lambda: (\n    xr @ wq.reshape(HD,C).T,\n    xr @ wk.reshape(HD,C).T,\n    xr @ wv.reshape(HD,C).T,\n))\n\n# Fused all 3\nw_all = torch.cat([wq.reshape(HD,C), wk.reshape(HD,C), wv.reshape(HD,C)], dim=0)\ntimeit('fused 3', lambda: xr @ w_all.T)\n\n# Fused q+k only (v might need different handling)\nw_qk = torch.cat([wq.reshape(HD,C), wk.reshape(HD,C)], dim=0)\ntimeit('fused q+k + v sep', lambda: (\n    xr @ w_qk.T,\n    xr @ wv.reshape(HD,C).T,\n))\n\n# Using F.linear\nimport torch.nn.functional as F\ntimeit('F.linear q', lambda: F.linear(xr, wq.reshape(HD,C)))\n\n# What about reshaping q,k,v to (B*H, L, D) for bmm instead of (B,H,L,D)?\nq_2d = xr @ wq.reshape(HD,C).T  # (B*L, H*D)\n# For logits, we want (B*H, L, D) @ (B*H, D, L) = (B*H, L, L)\n# q as (B*L, H*D) -> reshape to (B,L,H,D) -> (B,H,L,D) -> (B*H, L, D)\n# The reshape/permute has overhead. Can we avoid it?\n\n# Alternative: compute q as (H*D, B*L) by transposing, then reshape...\n# No, the matmul output is (B*L, H*D), which is row-major.\n# To get (B,H,L,D), we need to reshape and permute, which requires copy.\n\n# Let's check: can we compute logits with a different layout?\n# q of shape (B, L, H, D), k of shape (B, L, H, D)\n# logits[b,h,i,j] = sum_d q[b,i,h,d] * k[b,j,h,d]\n# = einsum('bihd,bjhd->bhij')\n# Can we do this more efficiently with standard matmul?\n\n# If q is (B, L, H*D), k is (B, L, H*D)...\n# No, that doesn't work because we need per-head computation.\n\n# What if we think of it as:\n# q shape (B*H, L, D), k shape (B*H, L, D)\n# q = xr @ wq.T  # (B*L, H*D)\n# We want (B*H, L, D)\n# This is a reshape + transpose: (B*L, H, D) -> (B, L, H, D) -> (B, H, L, D) -> (B*H, L, D)\n# The issue is that L and H are swapped, so it's not a simple reshape.\n\n# Let me check if there's a smarter way...\n# What if we layout weights as (D, H, C) -> no, same problem.\n\n# Actually, let me time the reshape/permute/contiguous overhead\nq_flat = xr @ wq.reshape(HD,C).T\ntimeit('reshape+permute+contig q', lambda: q_flat.reshape(B,L,H,D).permute(0,2,1,3).contiguous())\n\n# What if we don't make contiguous and let the matmul handle it?\nq_nc = q_flat.reshape(B,L,H,D).permute(0,2,1,3)  # not contiguous\nk_nc = (xr @ wk.reshape(HD,C).T).reshape(B,L,H,D).permute(0,2,1,3)\ntimeit('logits non-contig', lambda: q_nc @ k_nc.transpose(-1,-2))\n\nq_c = q_nc.contiguous()\nk_c = k_nc.contiguous()\ntimeit('logits contig', lambda: q_c @ k_c.transpose(-1,-2))\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

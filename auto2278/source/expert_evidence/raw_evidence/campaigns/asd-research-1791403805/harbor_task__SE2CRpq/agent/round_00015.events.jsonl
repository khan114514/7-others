{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\nHD = H * D\nxr = x.reshape(B*L, C)\n\n# Test: einsum vs matmul+reshape for projections\ndef timeit(name, fn, n=5):\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    print(f'{name}: {sorted(times)[len(times)//2]:.3f} ms')\n\ntimeit('einsum q', lambda: torch.einsum('blc,hdc->bhld', x, wq))\ntimeit('matmul q', lambda: (xr @ wq.reshape(HD,C).T).reshape(B,L,H,D).permute(0,2,1,3).contiguous())\n\n# Softmax optimization - does contiguous matter?\nlogits = torch.randn(B, H, L, L)\ntimeit('softmax', lambda: logits.softmax(dim=-1))\nlogits_c = logits.contiguous()\ntimeit('softmax contiguous', lambda: logits_c.softmax(dim=-1))\n\n# Softmax along different dims\nlogits_t = logits.transpose(0,1).contiguous()  # H,B,L,L\ntimeit('softmax on H,B,L,L', lambda: logits_t.softmax(dim=-1))\n\n# p@G optimization - bmm vs 4D\nG = x @ x.transpose(-1,-2)  # B,L,L\np = torch.randn(B, H, L, L)\np_b = p.reshape(B*H, L, L)\nG_b = G.unsqueeze(1).expand(B,H,L,L).reshape(B*H, L, L)\ntimeit('p@G 4D', lambda: p @ G.unsqueeze(1))\ntimeit('p@G bmm', lambda: torch.bmm(p_b, G_b))\n\n# Test: compute norm using p@x (v in original space) instead of Gram\n# p0@x shape (B,H,L,C), norm = sqrt(sum of squares along C)\n# v_shape (B,H,L,C), p@v is cheaper if D<C... wait D=64, C=1280\n# p@x = p @ x where x is (B,L,C), p is (B,H,L,L)\n# -> output (B,H,L,C). Norm along C = sum over C of (p@x)\"'^2\n# Cost: B*H*L*L*C vs B*H*L*L (Gram only B*L*L*C)\n# Gram approach: B*L*L*C (gram) + 2*B*H*L*L (p1@G and pm@G) + 2*B*H*L (sum)\n# Direct approach: 2*B*H*L*C (norm via p@x) + dot products\n# Gram: 256*256*1280 + 2*20*256*256 = 84M + 2.6M = 86.6M FLOPs\n# Direct p@x: 2*20*256*256*1280 = 3.35B FLOPs -- way worse\n# So Gram is better\n\n# But: what if we compute p0@x and p1@x directly (they are needed for u0, u1)?\n# Actually we need m = u0 + beta*(u1-u0), and output is m*r @ wv''^T\n# But we changed the formulation to compute p_mix @ v directly\n# Wait, let me re-read the current solution...\n\n# Current solution: v = x @ wv''^T, output = p_mix @ v  (shape B,H,L,D)\n# v projection: B*L*C*H*D = 256*1280*1280 = 419M\n# p_mix @ v: B*H*L*L*D = 20*256*256*64 = 84M\n# Total for output: ~503M\n\n# Alternative: output = (p_mix @ x) @ wv''^T\n# p_mix @ x: B*H*L*L*C = 20*256*256*1280 = 1.68B\n# @ wv''^T: B*H*L*C*D = 20*256*1280*64 = 419M\n# Total: 2.1B -- way worse\n\n# So v-first is better. Gram trick for norms is good.\nprint()\nprint('\"'Gram approach is correct optimization')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

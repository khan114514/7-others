{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\nalpha = 1.05\nbeta = 7.5\n\ninv_sqrt_d = 1.0 / math.sqrt(D)\nHD = H * D\n\ndef timeit(name, fn, n=10):\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    print(f'{name}: {sorted(times)[len(times)//2]:.3f} ms')\n\nxr = x.reshape(B*L, C)\nwqr = wq.reshape(HD, C)\nwkr = wk.reshape(HD, C)\nwvr = wv.reshape(HD, C)\n\n# Projection optimizations\n# Current: xr @ wqr.T -> reshape(B,L,H,D) -> permute(0,2,1,3) -> contiguous\n# Can we avoid permute + contiguous?\n\n# The output of xr @ wqr.T is (B*L, H*D), row-major.\n# Reshape to (B, L, H, D): stride (L*H*D, H*D, D, 1)\n# Permute to (B, H, L, D): stride (L*H*D, D, H*D, 1) -- not contiguous\n# We need contiguous for efficient matmul.\n\n# Alternative: what if we lay out weights as (H, C, D) instead?\n# q[b,h,l,d] = sum_c x[b,l,c] * w[h,d,c]\n# If w is (H, C, D): sum_c x[b,l,c] * w[h,c,d]\n# Then x @ w gives (B, L, H, D) directly?\n# x: (B, L, C), w: (H, C, D)\n# einsum('blc,hcd->blhd', x, w)\n# That's the same as our current approach but different weight layout.\n# Not helpful since weights are given as (H,D,C).\n\n# What if we transpose the weights to (H, C, D) and use different approach?\n# wq_t = wq.transpose(1,2)  # (H, C, D)\n# Then q[b,h,l,d] = sum_c x[b,l,c] * wq_t[h,c,d]\n# = x @ wq_t[h] for each h. That's H separate matmuls.\n# Each: (B*L, C) @ (C, D) = (B*L, D). H of them.\n# Total: H * B*L*C*D = 20 * 256*1280*64 = 419M FLOPs. Same as before.\n# But 20 small matmuls vs 1 big one. The big one is probably more efficient.\n\n# Let me test: H separate matmuls vs 1 big one\nwq_t = wq.transpose(1, 2).contiguous()  # (H, C, D)\ndef sep_proj():\n    out = torch.empty(B, L, H, D)\n    for h in range(H):\n        out[:, :, h, :] = xr @ wq_t[h]\n    return out\ntimeit('H separate projs', sep_proj)\ntimeit('1 big proj + reshape', lambda: (xr @ wqr.T).reshape(B, L, H, D))\n\n# What about F.linear?\nimport torch.nn.functional as F\ntimeit('F.linear', lambda: F.linear(x, wqr))\n\n# Output step: y.transpose(1,2).flatten(2).contiguous()\n# y shape (B, H, L, D) -> (B, L, H, D) -> (B, L, H*D)\ny = torch.randn(B, H, L, D)\ntimeit('transpose+flatten+contig', lambda: y.transpose(1,2).flatten(2).contiguous())\ntimeit('permute+reshape+contig', lambda: y.permute(0,2,1,3).reshape(B, L, HD).contiguous())\n\n# Try: can we compute output directly in the right layout?\n# v has shape (B, H, L, D), p_mix @ v has shape (B, H, L, D)\n# If v were (B, L, H, D), p_mix @ v... no, p_mix is (B, H, L, L)\n\n# Wait: what if we use a different layout throughout?\n# Keep q,k,v in (B, L, H, D) and use einsum for logits?\n# No, einsum is slower.\n\n# What about: p_mix is (B, H, L, L). v is (B, L, H, D).\n# output[b,l,h,d] = sum_j p_mix[b,h,l,j] * v[b,j,h,d]\n# = einsum('bhjl,jhd->lhd')... nah, complicated.\n\n# Let me try one more thing: computing the ratio in-place on y\n# Actually we already do mul_(ratio)\nprint()\n\n# What about the final contiguous? \n# The output needs to be contiguous. Let's see if there's a way to avoid it.\n# The return statement: y.transpose(1, 2).flatten(2).contiguous()\n# y is (B,H,L,D), transpose -> (B,L,H,D), flatten -> (B,L,H*D)\n# transpose + flatten is not contiguous (since H and L were swapped)\n# So we need contiguous. No way around it.\n\n# Let me try a trick: compute output as (p_mix @ v).transpose(1,2).reshape(B, L, HD)\n# and see if it's already contiguous... no, transpose makes it non-contiguous.\n\n# OK, let me focus on a different angle.\n# Can we compute G_r = G.unsqueeze(1).expand(B,H,L,L) and use it without making contiguous?\n# Earlier results said it matters. Let me verify again.\n\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)  # (B,1,L,L)\nG_rep = G.unsqueeze(1).repeat(1, H, 1, 1)  # contig (B,H,L,L)\np = torch.randn(B, H, L, L).softmax(dim=-1)\n\ntimeit('p @ G_exp', lambda: p @ G_exp)\ntimeit('p @ G_rep', lambda: p @ G_rep)\nprint('G_exp contig:', G_exp.is_contiguous())\nprint('G_rep contig:', G_rep.is_contiguous())\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\nalpha = 1.05\nbeta = 7.5\n\ninv_sqrt_d = 1.0 / math.sqrt(D)\nHD = H * D\n\ndef timeit(name, fn, n=7):\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    print(f'{name}: {sorted(times)[len(times)//2]:.3f} ms')\n\n# xr vs x\nxr = x.reshape(B*L, C)\ntimeit('xr @ wq.T', lambda: xr @ wq.reshape(HD,C).T)\ntimeit('x.reshape @ wq.T', lambda: x.reshape(B*L, C) @ wq.reshape(HD,C).T)\n\nimport torch.nn.functional as F\ntimeit('F.linear(x, wq)', lambda: F.linear(x, wq.reshape(HD,C)))\ntimeit('F.linear(xr, wq)', lambda: F.linear(xr, wq.reshape(HD,C)))\n\n# Now the full optimized version\ndef opt_v2():\n    qkv = (xr @ torch.cat([wq.reshape(HD,C), wk.reshape(HD,C), wv.reshape(HD,C)], dim=0).T)\n    q = qkv[:, :HD].reshape(B, L, H, D).permute(0,2,1,3).reshape(B*H, L, D).contiguous()\n    k = qkv[:, HD:2*HD].reshape(B, L, H, D).permute(0,2,1,3).reshape(B*H, L, D).contiguous()\n    v = qkv[:, 2*HD:].reshape(B, L, H, D).permute(0,2,1,3).reshape(B*H, L, D).contiguous()\n    logits = torch.bmm(q, k.transpose(-1, -2))\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.clone().mul_(a_p).add_(logits.transpose(-1,-2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2)\n    G_b = G.expand(B*H, L, L).contiguous()\n    p1G = torch.bmm(p1, G_b)\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = torch.bmm(p_mix, G_b)\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    y = torch.bmm(p_mix, v).mul_(ratio)\n    return y.reshape(B, H, L, D).transpose(1, 2).flatten(2).contiguous()\n\ndef opt_v3():\n    # Separate projections (known to be faster than fused)\n    q = (xr @ wq.reshape(HD,C).T).reshape(B, L, H, D).permute(0,2,1,3).reshape(B*H, L, D).contiguous()\n    k = (xr @ wk.reshape(HD,C).T).reshape(B, L, H, D).permute(0,2,1,3).reshape(B*H, L, D).contiguous()\n    v = (xr @ wv.reshape(HD,C).T).reshape(B, L, H, D).permute(0,2,1,3).reshape(B*H, L, D).contiguous()\n    logits = torch.bmm(q, k.transpose(-1, -2))\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.clone().mul_(a_p).add_(logits.transpose(-1,-2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2)\n    G_b = G.expand(B*H, L, L).contiguous()\n    p1G = torch.bmm(p1, G_b)\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = torch.bmm(p_mix, G_b)\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    y = torch.bmm(p_mix, v).mul_(ratio)\n    return y.reshape(B, H, L, D).transpose(1, 2).flatten(2).contiguous()\n\n# Reference\nimport sys\nsys.path.insert(0, '/workspace/solution')\nfrom method import attention as current_fn\nout_ref = current_fn(x, wq, wk, wv, alpha, beta)\n\nout_v2 = opt_v2()\nout_v3 = opt_v3()\nprint('v2 max diff:', (out_ref - out_v2).abs().max().item())\nprint('v3 max diff:', (out_ref - out_v3).abs().max().item())\n\n# time full\ntimeit('opt_v2 (fused proj)', opt_v2)\ntimeit('opt_v3 (sep proj)', opt_v3)\ntimeit('current solution', lambda: current_fn(x, wq, wk, wv, alpha, beta))\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

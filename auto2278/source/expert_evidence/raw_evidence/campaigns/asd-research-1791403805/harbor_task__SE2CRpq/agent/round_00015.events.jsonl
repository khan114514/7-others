{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\nalpha = 1.05\nbeta = 7.5\n\ninv_sqrt_d = 1.0 / math.sqrt(D)\nHD = H * D\nxr = x.reshape(B*L, C)\n\ndef timeit(name, fn, n=10):\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    print(f'{name}: {sorted(times)[len(times)//2]:.3f} ms')\n\n# Let me check if SDPA is actually usable for p0 (alpha=1 case)\nq_3d = (xr @ wq.reshape(HD,C).T).reshape(B,L,H,D).permute(0,2,1,3).reshape(B*H, L, D).contiguous()\nk_3d = (xr @ wk.reshape(HD,C).T).reshape(B,L,H,D).permute(0,2,1,3).reshape(B*H, L, D).contiguous()\nv_3d = (xr @ wv.reshape(HD,C).T).reshape(B,L,H,D).permute(0,2,1,3).reshape(B*H, L, D).contiguous()\n\n# SDPA for p0 @ v\ntimeit('SDPA', lambda: torch.nn.functional.scaled_dot_product_attention(q_3d, k_3d, v_3d, scale=inv_sqrt_d))\n\n# Manual: logits + softmax + p@v\ndef manual():\n    logits = q_3d @ k_3d.transpose(-1,-2) * inv_sqrt_d\n    p = logits.softmax(dim=-1)\n    return p @ v_3d\ntimeit('manual attn', manual)\n\n# But we need p0 explicitly for p_mix, so SDPA only helps in alpha=1 case\n# For alpha \"'!= 1, we need p0 and p1 explicitly\n# Let'\"'s see how much the alpha=1 case matters (case 6)\n\n# Actually, we need p0 for p_mix even when alpha \"'!= 1. So SDPA only helps\n# for the alpha=1.0 case. Let me check how much that case weighs.\n# There are 6 cases, 1 has alpha=1.0. So small impact.\n\n# Let me try another approach: can we compute p0 and p1 more efficiently?\n# p0 = softmax(A), p1 = softmax(a_p * A + a_m * A''^T)\n# What if we compute both softmax inputs together?\n\n# Actually, let me try to compute p1_logits differently.\n# p1_logits[i,j] = a_p * A[i,j] + a_m * A[j,i]\n# This is like: diag part = A[i,i] (since a_p + a_m = 1), off-diag = a_p*A[i,j] + a_m*A[j,i]\n\n# Not helpful. Let me try the G_repeat + in-place approach as the main optimization\n# and also see if we can save memory / improve cache locality.\n\n# One more idea: can we compute the norm1 ratio using p1 directly (without G)?\n# ||u1|| = ||p1 @ x||. We need this for each head and token.\n# With G: p1@G + elementwise = B*H*L''^3 + B*H*L''^2 = 20*256''^3 + ... = 336M\n# Direct: p1@x then norm = B*H*L''^2*C + B*H*L*C = 1.68B\n# G is way better.\n\n# What about computing G differently?\n# G = x @ x''^T is B*L''^2*C = 256''^2 * 1280 = 84M FLOPs\n# Could be done cheaper if we used sum of outer products... no same cost.\n\n# Let me benchmark the whole thing with all optimizations I know work\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nv = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\ndef v_optimized():\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.clone().mul_(a_p).add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2)\n    G_r = G.unsqueeze(1).repeat(1, H, 1, 1)\n    p1G = p1 @ G_r\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_r\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Only the middle part (after projections, before output reshape)\ntimeit('\"'optimized middle', v_optimized)\n\n# Now let me try the algebraic norm approach with G_rep\ndef v_algebraic():\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.clone().mul_(a_p).add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2)\n    G_r = G.unsqueeze(1).repeat(1, H, 1, 1)\n    p0G = p0 @ G_r\n    p1G = p1 @ G_r\n    norm1_sq = p1G.mul(p1).sum(dim=-1, keepdim=True)\n    norm0_sq = p0G.mul(p0).sum(dim=-1, keepdim=True)\n    cross = p0G.mul(p1).sum(dim=-1, keepdim=True)\n    ob = 1.0 - beta\n    normm_sq = ob*ob * norm0_sq + beta*beta * norm1_sq + 2*ob*beta * cross\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\nout_opt = v_optimized()\nout_alg = v_algebraic()\nprint('algebraic max diff:', (out_opt - out_alg).abs().max().item())\n\ntimeit('algebraic normm', v_algebraic)\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

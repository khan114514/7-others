\nn1a, nma = approach1()\nn1b, nmb = approach2()\nprint('\"'norm1 match:', torch.allclose(n1a, n1b, atol=1e-6))\nprint('normm match:', torch.allclose(nma, nmb, atol=1e-5))\nprint('max diff norm1:', (n1a-n1b).abs().max().item())\nprint('max diff normm:', (nma-nmb).abs().max().item())\n\ndef timeit(name, fn, n=5):\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    print(f'{name}: {sorted(times)[len(times)//2]:.3f} ms')\n\ntimeit('approach1 (current)', approach1)\ntimeit('approach2 (p0G+p1G)', approach2)\n\\\"\n\"","aggregated_output":"norm1 match: True\nnormm match: False\nmax diff norm1: 0.0\nmax diff normm: 0.0234375\napproach1 (current): 30.113 ms\napproach2 (p0G+p1G): 26.020 ms\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/sh -lc 'cd /workspace && python3 -c \"\nimport torch, time, math\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\nalpha = 1.05\nbeta = 7.5\n\ninv_sqrt_d = 1.0 / math.sqrt(D)\nHD = H * D\nxr = x.reshape(B*L, C)\n\nq = (xr @ wq.reshape(HD,C).T).reshape(B,L,H,D).permute(0,2,1,3).contiguous()\nk = (xr @ wk.reshape(HD,C).T).reshape(B,L,H,D).permute(0,2,1,3).contiguous()\n\nlogits = q @ k.transpose(-1, -2)\nlogits.mul_(inv_sqrt_d)\np0 = logits.softmax(dim=-1)\n\na_p = 0.5 * (1+alpha)\na_m = 0.5 * (1-alpha)\np1_logits = a_p * logits + a_m * logits.transpose(-1,-2)\np1 = p1_logits.softmax(dim=-1)\np_mix = torch.lerp(p0, p1, beta)\n\n# Verify approach2 mathematically\n# m = (1-beta)*u0 + beta*u1\n# ||m||''^2 = (1-beta)''^2*||u0||''^2 + beta''^2*||u1||''^2 + 2*(1-beta)*beta*<u0, u1>\n# u0 = p0 @ x, u1 = p1 @ x\n# <u0, u1> = sum_c (sum_j p0_j x_jc)(sum_k p1_k x_kc)\n# = sum_j sum_k p0_j p1_k sum_c x_jc x_kc\n# = sum_j sum_k p0_j p1_k G_jk\n# = p0 @ G @ p1''^T (just the diagonal / per-row same-index)\n# Wait: for each row i of p0 and p1:\n# u0[b,h,i,:] = p0[b,h,i,:] @ x[b,:,:]\n# <u0[b,h,i,:], u1[b,h,i,:]> = p0[b,h,i,:] @ G[b,:,:] @ p1[b,h,i,:].T\n# = (p0 @ G)[b,h,i,:] . p1[b,h,i,:]  (elementwise dot product of the i-th rows)\n# So cross[i] = sum_j (p0@G)[i,j] * p1[i,j]\n# That'\"'s correct.\n\n# But wait - the difference is 0.023\"'! That'\"'s too much.\n# Let me check: beta is 7.5, so 1-beta is -6.5\n# (1-beta)\"'^2 = 42.25, beta''^2 = 56.25, 2*(1-beta)*beta = -97.5\n# These are large coefficients, amplifying float errors.\n# Let me check the relative error.\n\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\n\np0G = p0 @ G_exp\np1G = p1 @ G_exp\nnorm0_sq = p0G.mul(p0).sum(dim=-1, keepdim=True)\nnorm1_sq = p1G.mul(p1).sum(dim=-1, keepdim=True)\ncross = p0G.mul(p1).sum(dim=-1, keepdim=True)\n\none_minus_b = 1.0 - beta\nnormm_sq_v2 = one_minus_b*one_minus_b * norm0_sq + beta*beta * norm1_sq + 2*one_minus_b*beta * cross\n\n# Direct\npmG = p_mix @ G_exp\nnormm_sq_v1 = pmG.mul(p_mix).sum(dim=-1, keepdim=True)\n\nrel_diff = (normm_sq_v1 - normm_sq_v2).abs() / normm_sq_v1.abs().clamp_min(1e-10)\nprint('\"'max relative diff normm_sq:', rel_diff.max().item())\nprint('max abs diff:', (normm_sq_v1 - normm_sq_v2).abs().max().item())\nprint('normm_sq range:', normm_sq_v1.min().item(), normm_sq_v1.max().item())\n\n# Now the ratio uses sqrt(norm1) / sqrt(normm)\n# let's see the final ratio diff\nnorm1_v1 = norm1_sq_v1 = norm1_sq.sqrt().clamp_min(1e-6)\nnormm_v1 = normm_sq_v1.sqrt().clamp_min(1e-6)\nratio_v1 = (norm1_v1 / normm_v1).clamp(0.25, 4.0)\n\nnormm_v2 = normm_sq_v2.sqrt().clamp_min(1e-6)\nratio_v2 = (norm1_v1 / normm_v2).clamp(0.25, 4.0)\n\nprint()\nprint('ratio max diff:', (ratio_v1 - ratio_v2).abs().max().item())\nprint('ratio rel diff:', ((ratio_v1 - ratio_v2).abs() / ratio_v1.abs().clamp_min(1e-10)).max().item())\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\nalpha = 1.05\nbeta = 7.5\n\ninv_sqrt_d = 1.0 / math.sqrt(D)\nHD = H * D\nxr = x.reshape(B*L, C)\n\ndef timeit(name, fn, n=10):\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    print(f'{name}: {sorted(times)[len(times)//2]:.3f} ms')\n\n# The bmm version is slower overall. The extra reshape/contiguous overhead negates the win.\n# Let me focus on p@G optimization specifically.\n# p@G is the most expensive single operation after projections.\n\nG = x @ x.transpose(-1, -2)\np = torch.randn(B, H, L, L).softmax(dim=-1)\np_contig = p.contiguous()\n\n# Current: 4D @ 4D\nG_exp = G.unsqueeze(1)  # (B,1,L,L)\ntimeit('p@G 4D (unsqueeze)', lambda: p_contig @ G_exp)\n\n# With repeat\nG_rep = G.unsqueeze(1).repeat(1, H, 1, 1)  # (B,H,L,L) contiguous\ntimeit('p@G 4D (repeat contig)', lambda: p_contig @ G_rep)\n\n# Is G_exp contiguous?\nprint('G_exp contiguous:', G_exp.is_contiguous())\nprint('G_rep contiguous:', G_rep.is_contiguous())\n\n# Try: p_3d = p.reshape(B*H, L, L), then bmm with contig G\np_3d = p_contig.reshape(B*H, L, L)\nG_3d_contig = G.expand(B*H, L, L).contiguous()\ntimeit('bmm p@G (contig G)', lambda: torch.bmm(p_3d, G_3d_contig))\n\n# Hmm, earlier bmm was 12ms, 4D was 14ms. But in the full function, 4D was faster.\n# Maybe it's the G expand/repeat/contig overhead.\n\n# Time the G setup separately\ntimeit('G expand + contig', lambda: G.expand(B*H, L, L).contiguous())\ntimeit('G unsqueeze', lambda: G.unsqueeze(1))\n\n# What about using G as is with broadcasting?\n# p shape (B,H,L,L), G shape (B,L,L) -> (B,1,L,L) for broadcasting\n# The 4D matmul with broadcast: p @ G.unsqueeze(1)\n# This should work, and G.unsqueeze(1) is O(1).\n# But the underlying matmul might not be as efficient.\n\n# Alternative: compute p@G per-batch with bmm\n# p: (B,H,L,L), G: (B,L,L)\n# For each batch b: p[b] @ G[b] where p[b] is (H, L, L), G[b] is (L, L)\n# = bmm of (H, L, L) with expanded (H, L, L)\n\n# Let's check: which is faster, 4D broadcast or per-batch loop?\n# For B=1, per-batch is just 1 call.\n# For B=2, 2 calls.\n\n# Let's try for B=2\nB2 = 2\nx2 = torch.randn(B2, L, C)\nG2 = x2 @ x2.transpose(-1, -2)\np2 = torch.randn(B2, H, L, L).softmax(dim=-1)\n\ntimeit('4D B=2', lambda: p2 @ G2.unsqueeze(1))\n\np2_3d = p2.reshape(B2*H, L, L)\nG2_3d = G2.expand(B2*H, L, L).contiguous()\ntimeit('bmm B=2', lambda: torch.bmm(p2_3d, G2_3d))\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

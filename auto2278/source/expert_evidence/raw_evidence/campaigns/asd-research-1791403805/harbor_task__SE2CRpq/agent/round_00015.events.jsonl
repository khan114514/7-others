{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nx = torch.randn(B, L, C)\n\ndef timeit(name, fn, n=7):\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    print(f'{name}: {sorted(times)[len(times)//2]:.3f} ms')\n\n# Gram matrix computation\ntimeit('x @ x.T', lambda: x @ x.transpose(-1, -2))\n\n# Using einsum\ntimeit('einsum gram', lambda: torch.einsum('blc,bmc->blm', x, x))\n\n# What about bmm for the p@G step?\n# p shape (B,H,L,L), G shape (B,1,L,L)\n# If we reshape p to (B*H, L, L) and expand G to (B*H, L, L), then bmm\nG = x @ x.transpose(-1, -2)\np = torch.randn(B, H, L, L).softmax(dim=-1)\n\np_b = p.reshape(B*H, L, L)\nG_b = G.unsqueeze(1).expand(B, H, L, L).reshape(B*H, L, L)\ntimeit('p@G 4D', lambda: p @ G.unsqueeze(1))\ntimeit('bmm', lambda: torch.bmm(p_b, G_b))\n\n# expand vs repeat\nG_r = G.repeat(H, 1, 1)  # (B*H, L, L) -- no, B=1 so (H, L, L)\n# Actually B*H = 20, we need G expanded to (20, L, L)\nG_r = G.expand(H, L, L).contiguous().clone()\ntimeit('bmm (contig G_r)', lambda: torch.bmm(p_b, G_r))\n\n# Let me check: is G_b contiguous?\nprint('G_b contiguous:', G_b.is_contiguous())\nprint('G_r contiguous:', G_r.is_contiguous())\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

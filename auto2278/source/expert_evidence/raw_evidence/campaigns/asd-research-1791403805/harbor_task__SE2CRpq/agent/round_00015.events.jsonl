{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math\ntorch.set_num_threads(1)\n\n# Test all cases for correctness with the G_repeat + in-place approach\ncases = [\n    (1, 64, 512, 8, 64, 1.05, 5.0),\n    (1, 128, 640, 10, 64, 1.1, 4.0),\n    (1, 128, 1280, 20, 64, 1.15, 3.0),\n    (1, 256, 1280, 20, 64, 1.05, 7.5),\n    (1, 256, 640, 10, 64, 1.2, 5.0),\n    (2, 128, 512, 8, 64, 1.0, 5.0),\n]\n\nimport sys\nsys.path.insert(0, '/workspace/environment/starter')\nfrom method import attention as ref_fn\n\ndef opt_fn(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    xr = x.reshape(B * L, C)\n    \n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    \n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    \n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1_logits = logits.clone().mul_(a_p).add_(logits.transpose(-1, -2), alpha=a_m)\n        p1 = p1_logits.softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        \n        G = x @ x.transpose(-1, -2)\n        G_r = G.unsqueeze(1).repeat(1, H, 1, 1)\n        \n        p1G = p1 @ G_r\n        norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_r\n        normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n        \n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n        \n        y = (p_mix @ v).mul_(ratio)\n    \n    return y.transpose(1, 2).flatten(2).contiguous()\n\nall_ok = True\nfor i, (B, L, C, H, D, alpha, beta) in enumerate(cases):\n    x = torch.randn(B, L, C)\n    wq = torch.randn(H, D, C)\n    wk = torch.randn(H, D, C)\n    wv = torch.randn(H, D, C)\n    \n    ref = ref_fn(x, wq, wk, wv, alpha, beta)\n    opt = opt_fn(x, wq, wk, wv, alpha, beta)\n    \n    atol = 3e-5\n    rtol = 3e-4\n    diff = (ref - opt).abs()\n    tol = atol + rtol * ref.abs()\n    max_viol = (diff - tol).max().item()\n    status = 'OK' if max_viol <= 0 else 'FAIL'\n    if max_viol > 0:\n        all_ok = False\n    print(f'Case {i} (B={B},L={L},C={C},H={H},alpha={alpha}): max_diff={diff.max().item():.2e}, max_viol={max_viol:.2e} [{status}]')\n\nprint(f'All cases OK: {all_ok}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\nalpha = 1.05\nbeta = 7.5\n\ninv_sqrt_d = 1.0 / math.sqrt(D)\nHD = H * D\nxr = x.reshape(B*L, C)\n\ndef timeit(name, fn, n=7):\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    print(f'{name}: {sorted(times)[len(times)//2]:.3f} ms')\n\n# Best approach so far: bmm with contiguous tensors\ndef opt_v1():\n    q = (xr @ wq.reshape(HD,C).T).reshape(B, L, H, D).permute(0,2,1,3).reshape(B*H, L, D).contiguous()\n    k = (xr @ wk.reshape(HD,C).T).reshape(B, L, H, D).permute(0,2,1,3).reshape(B*H, L, D).contiguous()\n    v = (xr @ wv.reshape(HD,C).T).reshape(B, L, H, D).permute(0,2,1,3).reshape(B*H, L, D).contiguous()\n    logits = torch.bmm(q, k.transpose(-1, -2))\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.clone().mul_(a_p).add_(logits.transpose(-1,-2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2)\n    G_b = G.expand(B*H, L, L).contiguous()\n    p1G = torch.bmm(p1, G_b)\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = torch.bmm(p_mix, G_b)\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    y = torch.bmm(p_mix, v).mul_(ratio)\n    return y.reshape(B, H, L, D).transpose(1, 2).flatten(2).contiguous()\n\n# Now let me try: can we avoid the separate p_mix allocation?\n# Instead of p_mix = lerp(p0, p1, beta), compute pmG directly:\n# pmG = p_mix @ G = (1-beta)*p0@G + beta*p1@G\n# This way we still need 2 matmuls (p0@G and p1@G), but we save the lerp memory.\n# Actually we need p_mix @ v too.\n# p_mix @ v = (1-beta)*p0@v + beta*p1@v\n# So we could avoid explicitly forming p_mix\"'!\n# But we'\"'d still have 2 p@v matmuls instead of 1.\n# 2 * p@v = 2 * 84M = 168M vs 1 * p_mix@v = 84M... no win.\n# For p@G: 2 * p@G = 2 * 336M = 672M vs 1 * pmix@G = 336M + 1 p1@G... same.\n\n# Actually wait, let me recount. Current:\n# - p1 @ G (1 matmul) - for norm1\n# - p_mix @ G (1 matmul) - for normm\n# Total: 2 matmuls for norms\n# If we do p0@G + p1@G and derive normm algebraically: still 2 matmuls\n# But we save the p_mix allocation (big tensor: B*H*L*L = 20*256*256 = 1.3M floats = 5MB)\n\n# But wait: we still need p_mix for p_mix @ v.\n# Unless we do p0@v + p1@v = 2 matmuls instead of 1.\n# p@v cost: B*H*L*L*D = 20*256*256*64 = 84M each\n# Saving 1 p@G matmul = 336M, but adding 1 p@v = 84M\n# Net save: 252M FLOPs + save p_mix allocation\n# But we also need to be accurate with the algebraic approach...\n\n# Actually wait no, I miscounted. Let me re-check.\n# Current approach needs: p1@G (for norm1), pmix@G (for normm), pmix@v (for output)\n# = 2 p@G + 1 p@v = 2*336M + 84M = 756M\n\n# Alternative: p0@G, p1@G, p0@v, p1@v\n# Then: norm1 from p1@G, normm from algebraic formula, output from (1-b)*p0v + b*p1v\n# = 2 p@G + 2 p@v = 2*336M + 2*84M = 840M\n# WORSE by 84M.\n\n# What if we stack p0 and p1 for p@v too?\n# Stacked p@v: cat(p0, p1, dim=1) @ v = (B*H, 2L, L) @ (B*H, L, D) = (B*H, 2L, D)\n# Cost: B*H*2L*L*D = 2*84M = 168M (same as 2 separate)\n# Plus the cat overhead. No win.\n\n# OK, so the current approach is optimal for matmul count.\n# Let me focus on micro-optimizations.\n\n# Try: compute G before softmax (overlap memory/compute? single-thread so no)\n# Try: precompute G_b = G.expand(...).contiguous()\n# Try: different order of operations\n\n# What about using torch.addbmm or other variants?\n# Nah, single batch bmm is fine.\n\n# What about: avoiding the v contiguous? \n# v = (xr @ wv.T) -> (B*L, H*D). reshape to (B,L,H,D). permute to (B,H,L,D). reshape to (B*H, L, D)\n# We need v to be contiguous for bmm.\n\n# What if we compute v as (wv @ x.T)... no, wrong shape.\n\n# Let me try another idea: fuse inv_sqrt_d into the weights\n# q = x @ wq\"'^T / sqrt(D) = x @ (wq/sqrt(D))''^T\n# So we can scale wq by inv_sqrt_d before the matmul.\n# But wq has shape (H,D,C), scaling it costs H*D*C = 20*64*1280 = 1.6M ops\n# And we save 1 scalar mul of B*H*L*L = 1.3M ops.\n# Comparable, maybe slightly worse. Let me check.\n\nwq_scaled = wq * inv_sqrt_d\ntimeit('\"'q proj (scaled wq)', lambda: xr @ wq_scaled.reshape(HD,C).T)\ntimeit('q proj + scalar mul', lambda: (xr @ wq.reshape(HD,C).T) * inv_sqrt_d)\n\n# Actually the logits = q@k\"'^T / sqrt(D). If we scale q and k each by 1/D''^(1/4), \n# then logits = q_scaled @ k_scaled''^T. That'\"'s 2 scalar muls instead of 1. Worse.\n\n# What about: logits = q @ (k.transpose * inv_sqrt_d)? \n# Still 1 scalar mul, just on different tensor.\nk_t = k.transpose(-1,-2)\ntimeit('bmm q,kT*inv_sqrt', lambda: torch.bmm(q_c, k_t * inv_sqrt_d))\ntimeit('bmm then mul', lambda: (torch.bmm(q_c, k_t)).mul_(inv_sqrt_d))\n\nprint()\n# OK, let me try one more thing: using F.linear instead of manual matmul\nimport torch.nn.functional as F\ntimeit('F.linear 3 times', lambda: (\n    F.linear(x, wq.reshape(HD,C)),\n    F.linear(x, wk.reshape(HD,C)),\n    F.linear(x, wv.reshape(HD,C)),\n))\ntimeit('manual 3 times', lambda: (\n    x @ wq.reshape(HD,C).T,\n    x @ wk.reshape(HD,C).T,\n    x @ wv.reshape(HD,C).T,\n))\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nx = torch.randn(B, L, C)\nG = x @ x.transpose(-1, -2)  # B, L, L\n\np0 = torch.randn(B, H, L, L).softmax(dim=-1)\np1 = torch.randn(B, H, L, L).softmax(dim=-1)\n\ndef timeit(name, fn, n=7):\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    print(f'{name}: {sorted(times)[len(times)//2]:.3f} ms')\n\n# Separate matmuls\ndef sep():\n    a = p0 @ G.unsqueeze(1)\n    b = p1 @ G.unsqueeze(1)\n    return a, b\ntimeit('2 separate p@G', sep)\n\n# Stacked\ndef stacked():\n    ps = torch.cat([p0, p1], dim=2)  # B,H,2L,L\n    result = ps @ G.unsqueeze(1)  # B,H,2L,L\n    return result[:,:,:L,:], result[:,:,L:,:]\ntimeit('stacked p@G', stacked)\n\n# What about bmm with (B*H, 2*L, L) @ (B*H, L, L)?\ndef stacked_bmm():\n    ps = torch.cat([p0, p1], dim=2).reshape(B*H, 2*L, L)\n    G_exp = G.unsqueeze(1).expand(B,H,L,L).reshape(B*H, L, L)\n    result = torch.bmm(ps, G_exp)\n    return result[:, :L, :].reshape(B,H,L,L), result[:, L:, :].reshape(B,H,L,L)\ntimeit('stacked bmm', stacked_bmm)\n\n# Also try: what if we use G with expand?\nG_exp = G.unsqueeze(1).expand(B,H,L,L)\ndef sep_expand():\n    a = p0 @ G_exp\n    b = p1 @ G_exp\n    return a, b\ntimeit('2 sep p@G (expanded G)', sep_expand)\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

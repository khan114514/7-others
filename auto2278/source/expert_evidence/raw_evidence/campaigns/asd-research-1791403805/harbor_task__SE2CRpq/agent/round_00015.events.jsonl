{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\nHD = H * D\nxr = x.reshape(B*L, C)\n\ndef timeit(name, fn, n=7):\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    print(f'{name}: {sorted(times)[len(times)//2]:.3f} ms')\n\n# Let me think about this differently.\n# The biggest win so far is from algorithmic changes (Gram trick, v-first).\n# Can we find another algorithmic optimization?\n\n# Current flow for alpha \"'!= 1:\n# 1. q, k, v projections (3 matmuls)\n# 2. logits = q@k''^T / sqrt(D)  (1 matmul + scalar)\n# 3. p0 = softmax(logits)\n# 4. p1_logits = a_p * logits + a_m * logits''^T\n# 5. p1 = softmax(p1_logits)\n# 6. p_mix = (1-beta)*p0 + beta*p1\n# 7. G = x @ x''^T (Gram)\n# 8. norm1_sq = rowsum((p1 @ G) * p1)  \n# 9. normm_sq = rowsum((p_mix @ G) * p_mix)\n# 10. ratio = clamp(sqrt(norm1) / sqrt(normm), 0.25, 4)\n# 11. y = (p_mix @ v) * ratio\n# 12. reshape\n\n# Key insight: steps 8-9 are 2 matmuls + elementwise.\n# What if we change to: compute p0@G and p1@G, then derive all norms?\n# Let'\"'s check: still 2 matmuls. Same.\n\n# Wait - actually what if we compute norms differently?\n# Let me look at the cost breakdown again:\n# Projections: ~45ms (matmul B*L x C x H*D)\n# p@G (each): ~13ms (B*H*L x L x L matmul = 20*256*256*256 mult-adds = 336M FLOPs)\n# p@v: ~3ms (B*H*L x L x D matmul = 20*256*256*64 = 84M FLOPs)\n# q@k\"'^T: ~5ms (B*H*L x D x L = same 84M, but 5ms vs 3ms? Maybe memory layout)\n# softmax: ~27ms total (surprisingly expensive!)\n# p1_logits: ~4ms\n\n# Softmax is 27ms! That'\"'s a lot. Each softmax is 13-14ms.\n# Can we optimize softmax?\n\n# softmax on (B,H,L,L) = (1,20,256,256)\n# Let me try reshaping to (B*H*L, L) and using different approaches\n\nlogits = torch.randn(B, H, L, L)\nlogits_2d = logits.reshape(B*H*L, L)\n\ntimeit('softmax 4D dim=-1', lambda: logits.softmax(dim=-1))\ntimeit('softmax 2D dim=-1', lambda: logits_2d.softmax(dim=-1))\ntimeit('softmax 2D dim=1', lambda: logits_2d.softmax(dim=1))\n\n# What about log_softmax then exp?\ntimeit('log_softmax + exp', lambda: logits.log_softmax(dim=-1).exp_())\n\n# Let's see if we can use a different algorithm\n# On CPU with 1 thread, for L=256, the softmax might be memory-bandwidth bound.\n# 2 softmaxes on B*H*L*L = 20*256*256 = 1.3M elements each\n# Each softmax: read + max + subtract + exp + sum + divide = multiple passes\n# 1.3M * 4 bytes = 5.2MB per read. Multiple reads = ~26MB.\n# At ~20GB/s memory bandwidth, that's 1.3ms. But we see 13ms\"'!\n# So there'\"'s a lot of overhead. Let's investigate.\n\n# Maybe the issue is that 4D softmax is slow?\nlogits_3d = logits.reshape(B*H, L, L)\ntimeit('softmax 3D dim=-1', lambda: logits_3d.softmax(dim=-1))\n\n# Try manually with vectorized operations\ndef my_softmax(x):\n    x = x - x.max(dim=-1, keepdim=True).values\n    x = x.exp()\n    return x / x.sum(dim=-1, keepdim=True)\n\ntimeit('manual softmax 4D', lambda: my_softmax(logits))\ntimeit('manual softmax 2D', lambda: my_softmax(logits_2d))\n\n# What about with in-place operations\ndef my_softmax_ip(x_in):\n    x = x_in.clone()\n    m = x.max(dim=-1, keepdim=True).values\n    x.sub_(m)\n    x.exp_()\n    s = x.sum(dim=-1, keepdim=True)\n    x.div_(s)\n    return x\n\ntimeit('manual softmax in-place', lambda: my_softmax_ip(logits))\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

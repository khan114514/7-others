{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/sh -lc 'cd /workspace && python3 -c \"\nimport torch, time, math\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\nalpha = 1.05\nbeta = 7.5\n\ninv_sqrt_d = 1.0 / math.sqrt(D)\nHD = H * D\nxr = x.reshape(B*L, C)\n\nq = (xr @ wq.reshape(HD,C).T).reshape(B,L,H,D).permute(0,2,1,3).contiguous()\nk = (xr @ wk.reshape(HD,C).T).reshape(B,L,H,D).permute(0,2,1,3).contiguous()\nv = (xr @ wv.reshape(HD,C).T).reshape(B,L,H,D).permute(0,2,1,3).contiguous()\n\nlogits = q @ k.transpose(-1, -2)\nlogits.mul_(inv_sqrt_d)\np0 = logits.softmax(dim=-1)\n\na_p = 0.5 * (1+alpha)\na_m = 0.5 * (1-alpha)\np1_logits = a_p * logits + a_m * logits.transpose(-1,-2)\np1 = p1_logits.softmax(dim=-1)\n\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\n\n# Approach 1: p1@G + pmix@G (current)\np_mix = torch.lerp(p0, p1, beta)\ndef approach1():\n    p1G = p1 @ G_exp\n    norm1_sq = p1G.mul(p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = pmG.mul(p_mix).sum(dim=-1, keepdim=True)\n    return norm1_sq, normm_sq\n\n# Approach 2: p0@G + p1@G, derive normm_sq algebraically\n# normm_sq = (1-beta)''^2 * norm0_sq + beta''^2 * norm1_sq + 2*(1-beta)*beta * cross\n# norm0_sq = rowsum((p0@G) * p0)\n# cross = rowsum((p0@G) * p1)\ndef approach2():\n    p0G = p0 @ G_exp  # (B,H,L,L)\n    p1G = p1 @ G_exp  # (B,H,L,L)\n    norm0_sq = p0G.mul(p0).sum(dim=-1, keepdim=True)\n    norm1_sq = p1G.mul(p1).sum(dim=-1, keepdim=True)\n    cross = p0G.mul(p1).sum(dim=-1, keepdim=True)  # (p0@G).T @ p1 per row = p0 @ G @ p1''^T diag\n    one_minus_b = 1.0 - beta\n    normm_sq = one_minus_b*one_minus_b * norm0_sq + beta*beta * norm1_sq + 2*one_minus_b*beta * cross\n    return norm1_sq, normm_sq\n\n# Approach 3: p_mix@G + p0@G + use formula? No, still 2 matmuls.\n\nn1a, nma = approach1()\nn1b, nmb = approach2()\nprint('\"'norm1 match:', torch.allclose(n1a, n1b, atol=1e-6))\nprint('normm match:', torch.allclose(nma, nmb, atol=1e-5))\nprint('max diff norm1:', (n1a-n1b).abs().max().item())\nprint('max diff normm:', (nma-nmb).abs().max().item())\n\ndef timeit(name, fn, n=5):\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    print(f'{name}: {sorted(times)[len(times)//2]:.3f} ms')\n\ntimeit('approach1 (current)', approach1)\ntimeit('approach2 (p0G+p1G)', approach2)\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

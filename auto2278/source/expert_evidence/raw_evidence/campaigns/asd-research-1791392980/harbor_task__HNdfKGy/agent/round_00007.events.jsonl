{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/sh -lc \"cat << 'PYEOF' > /tmp/profile6.py\nimport math\nimport time\nimport torch\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\ninv_sqrt_d = 1.0 / math.sqrt(D)\nxr = x.reshape(B * L, C)\n\ndef bench(name, fn, n=20):\n    for _ in range(3): fn()\n    times = []\n    for _ in range(n):\n        t0 = time.perf_counter()\n        fn()\n        times.append(time.perf_counter() - t0)\n    times.sort()\n    med = times[n//2] * 1000\n    print(f\\\"  {name:50s}: {med:7.2f} ms med\\\")\n    return med\n\n# === p @ G optimization ===\nprint(\\\"=== p @ G optimization ===\\\")\np = torch.randn(B, H, L, L).softmax(dim=-1)\nG = (xr @ xr.T).reshape(B, L, L)\nG_exp = G.unsqueeze(1)\n\nbench(\\\"p @ G_exp (broadcast, current)\\\", lambda: p @ G_exp)\n\n# bmm approach: G needs to be (B*H, L, L) but G is (B, L, L) shared across H heads\n# We can't just expand (wouldn't be contiguous), but we can try repeat\nG_repeat = G.repeat(H, 1, 1)  # (B*H, L, L) - B=1 case\np_flat = p.reshape(B*H, L, L)\nbench(\\\"bmm p_flat @ G_repeat\\\", lambda: torch.bmm(p_flat, G_repeat).reshape(B, H, L, L))\n\n# For general B: G is (B, L, L), we want (B*H, L, L)\n# = G.unsqueeze(1).expand(B, H, L, L).reshape(B*H, L, L) -- not contiguous\n# Need contiguous version\nG_bmm = G.unsqueeze(1).expand(B, H, L, L).contiguous().reshape(B*H, L, L)\nbench(\\\"bmm with contig G_bmm\\\", lambda: torch.bmm(p_flat, G_bmm).reshape(B, H, L, L))\n\n# Check: what's the cost of making G_bmm?\nbench(\\\"make G_bmm (expand+contig+reshape)\\\", \n      lambda: G.unsqueeze(1).expand(B, H, L, L).contiguous().reshape(B*H, L, L))\n\n# Result verification\nr_bc = p @ G_exp\nr_bmm = torch.bmm(p_flat, G_bmm).reshape(B, H, L, L)\nprint(f\\\"  broadcast vs bmm diff: {(r_bc-r_bmm).abs().max():.2e}\\\")\n\n# === Combined: full norm computation ===\nprint(\\\"\\\\n=== Full norm (p@G + mul+sum) ===\\\")\nbench(\\\"norm: broadcast p@G + mul+sum\\\",\n      lambda: ((p @ G_exp) * p).sum(dim=-1, keepdim=True))\n\nbench(\\\"norm: bmm p@G + mul+sum\\\",\n      lambda: (torch.bmm(p_flat, G_bmm).reshape(B, H, L, L) * p).sum(dim=-1, keepdim=True))\n\n# === Can we do even better? Use einsum or directly compute the quadratic form? ===\n# Per row of p: ||p_i @ X||\"'^2 where X is the x matrix (not G)\n# p_i is (1, L), X is (L, C). Result is (1, C). Norm is sqrt(sum of squares).\n# ||p_i @ X||''^2 = sum_c (sum_l p_i[l] * X[l,c])''^2\n# \n# But with Gram: (p @ G * p).sum = p @ G @ p''^T diagonal\n# G = X @ X''^T, so p @ G @ p''^T = p @ X @ X''^T @ p''^T = (p @ X) @ (p @ X)''^T\n# Diagonal = ||p_i @ X||''^2 per row i. Correct.\n\n# Can we compute this with einsum?\n# p is (B,H,L,L), x is (B,L,C)\n# u = p @ x has shape (B,H,L,C). Norm per (b,h,l): sqrt(sum_c u[b,h,l,c]''^2)\n# This is: sqrt(einsum(\"bhli,bic->bhlc\", ... ) squared sum)\n# No, this requires computing p@x in full which is O(BHLC) - expensive for large C.\n\n# Another idea: use torch.norm on p@x? No, same cost.\n# Stick with Gram approach.\n\nprint(\"'\"\\\\n=== Full function comparison: reference vs bmm-optimized ===\\\")\n\n@torch.no_grad()\ndef ref_attention(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wv.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    logits = q @ k.transpose(-1, -2) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    p1G = p1 @ G_exp\n    norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n    normm = normm_sq.sqrt().clamp_min(1e-6)\n    ratio = (norm1 / normm).clamp(0.25, 4.0)\n    y = (p_mix @ v) * ratio\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n@torch.no_grad()\ndef bmm_attention(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wv.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    logits = q @ k.transpose(-1, -2) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n\n    # Fast Gram + bmm norm computation\n    G = (xr @ xr.T).reshape(B, L, L)\n    G_bmm = G.unsqueeze(1).expand(B, H, L, L).contiguous().reshape(B * H, L, L)\n    \n    p1_flat = p1.reshape(B * H, L, L)\n    pmix_flat = p_mix.reshape(B * H, L, L)\n    \n    p1G = torch.bmm(p1_flat, G_bmm).reshape(B, H, L, L)\n    norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n    \n    pmG = torch.bmm(pmix_flat, G_bmm).reshape(B, H, L, L)\n    normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n    \n    norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n    normm = normm_sq.sqrt().clamp_min(1e-6)\n    ratio = (norm1 / normm).clamp(0.25, 4.0)\n    y = (p_mix @ v) * ratio\n    return y.transpose(1, 2).flatten(2).contiguous()\n\nr0 = ref_attention(x, wq, wk, wv, alpha, beta)\nr1 = bmm_attention(x, wq, wk, wv, alpha, beta)\nprint(f\\\"  Ref shape: {r0.shape}, BMM shape: {r1.shape}\\\")\nprint(f\\\"  Max diff: {(r0-r1).abs().max():.2e}\\\")\n\nbench(\\\"Reference\\\", lambda: ref_attention(x, wq, wk, wv, alpha, beta))\nbench(\\\"BMM-optimized\\\", lambda: bmm_attention(x, wq, wk, wv, alpha, beta))\n\n# Also test small cases\nprint(\\\"\\\\n=== Small case B=1,L=64,C=512,H=8,D=64 ===\\\")\nx2 = torch.randn(1, 64, 512)\nwq2 = torch.randn(8, 64, 512)\nwk2 = torch.randn(8, 64, 512)\nwv2 = torch.randn(8, 64, 512)\nbench(\\\"Ref small\\\", lambda: ref_attention(x2, wq2, wk2, wv2, 1.05, 5.0))\nbench(\\\"BMM small\\\", lambda: bmm_attention(x2, wq2, wk2, wv2, 1.05, 5.0))\n\nr0s = ref_attention(x2, wq2, wk2, wv2, 1.05, 5.0)\nr1s = bmm_attention(x2, wq2, wk2, wv2, 1.05, 5.0)\nprint(f\\\"  Small max diff: {(r0s-r1s).abs().max():.2e}\\\")\n\nPYEOF\npython /tmp/profile6.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

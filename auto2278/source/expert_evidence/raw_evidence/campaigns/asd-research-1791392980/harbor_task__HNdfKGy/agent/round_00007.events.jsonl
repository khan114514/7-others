{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/sh -lc \"cat << 'PYEOF' > /tmp/profile5.py\nimport math\nimport time\nimport torch\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\ninv_sqrt_d = 1.0 / math.sqrt(D)\nxr = x.reshape(B * L, C)\nwq_r = wq.reshape(H*D, C)\nwk_r = wk.reshape(H*D, C)\nwv_r = wv.reshape(H*D, C)\n\ndef bench(name, fn, n=20):\n    for _ in range(3): fn()\n    times = []\n    for _ in range(n):\n        t0 = time.perf_counter()\n        fn()\n        times.append(time.perf_counter() - t0)\n    times.sort()\n    med = times[n//2] * 1000\n    mn = sum(times)/n * 1000\n    print(f\\\"  {name:45s}: {med:7.2f} ms med, {mn:7.2f} ms mean\\\")\n    return med\n\n# Let's understand memory layout better\nprint(\\\"=== Memory layouts ===\\\")\nq_nc = (xr @ wq_r.T).reshape(B, L, H, D).permute(0, 2, 1, 3)\nq_c = q_nc.contiguous()\nprint(f\\\"  q non-contig: shape={q_nc.shape}, stride={q_nc.stride()}, is_contig={q_nc.is_contiguous()}\\\")\nprint(f\\\"  q contig:     shape={q_c.shape}, stride={q_c.stride()}, is_contig={q_c.is_contiguous()}\\\")\nprint(f\\\"  q_nc memory size: {q_nc.numel() * 4 / 1024:.1f} KB\\\")\nprint(f\\\"  G memory size: {L*L*4/1024:.1f} KB\\\")\n\n# Key question: does making q contiguous help logits, but cost more in projection?\nprint(\\\"\\\\n=== Step by step costs ===\\\")\nbench(\\\"proj q (non-contig)\\\", lambda: (xr @ wq_r.T).reshape(B, L, H, D).permute(0, 2, 1, 3))\nbench(\\\"proj k (non-contig)\\\", lambda: (xr @ wk_r.T).reshape(B, L, H, D).permute(0, 2, 1, 3))\nbench(\\\"proj v (non-contig)\\\", lambda: (xr @ wv_r.T).reshape(B, L, H, D).permute(0, 2, 1, 3))\nbench(\\\"proj q + contig\\\", lambda: (xr @ wq_r.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous())\nbench(\\\"proj k + contig\\\", lambda: (xr @ wk_r.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous())\n\n# logits with each\nbench(\\\"logits (nc q, nc k)\\\", lambda: q_nc @ q_nc.transpose(-1, -2) * inv_sqrt_d)\nbench(\\\"logits (c q, c k)\\\", lambda: q_c @ q_c.transpose(-1, -2) * inv_sqrt_d)\n\n# Softmax\nlogits_nc = q_nc @ q_nc.transpose(-1, -2) * inv_sqrt_d\nlogits_c = q_c @ q_c.transpose(-1, -2) * inv_sqrt_d\nprint(f\\\"  logits from nc q,k contiguous? {logits_nc.is_contiguous()}\\\")\nprint(f\\\"  logits from c q,k contiguous? {logits_c.is_contiguous()}\\\")\nbench(\\\"softmax (from nc)\\\", lambda: logits_nc.softmax(dim=-1))\nbench(\\\"softmax (from c)\\\", lambda: logits_c.softmax(dim=-1))\n\n# Gram approach cost breakdown\nprint(\\\"\\\\n=== Norm computation cost ===\\\")\np = torch.randn(B, H, L, L).softmax(dim=-1)\nG = (xr @ xr.T).reshape(B, L, L)\nG_exp = G.unsqueeze(1)\n\nbench(\\\"p @ G_exp\\\", lambda: p @ G_exp)\nbench(\\\"(pG * p).sum\\\", lambda: ((p @ G_exp) * p).sum(dim=-1, keepdim=True))\n\n# Test: what if we reshape p to (B*H, L, L) and use bmm?\np_flat = p.reshape(B*H, L, L)\nG_flat = G.expand(B*H, L, L).contiguous()  # Wait, we can't easily expand...\n# Actually G is (B,L,L). For bmm we need (B*H, L, L). We'd need to expand+reshape.\nG_bh = G.unsqueeze(1).expand(B, H, L, L).contiguous().reshape(B*H, L, L)\nbench(\\\"bmm p_flat @ G_bh\\\", lambda: torch.bmm(p_flat, G_bh).reshape(B, H, L, L))\n\n# Alternative: compute p @ G with p in (B*H, L, L) and G broadcast\np_bh = p.reshape(B*H, L, L)\nG_exp2 = G.unsqueeze(0).expand(B*H, L, L)  # This is a view\"'!\nprint(f\"  G_exp2 is view? {G_exp2.data_ptr() == G.data_ptr()}\")\nprint(f\"  G_exp2 contiguous? {G_exp2.is_contiguous()}\")\nbench(\"bmm p_bh @ G_exp2 (non-contig G)\", lambda: torch.bmm(p_bh, G_exp2).reshape(B, H, L, L))\n\n# Result check\nr1 = p @ G_exp\nr2 = torch.bmm(p_bh, G_exp2).reshape(B, H, L, L)\nprint(f\"  p@G broadcast vs bmm diff: {(r1-r2).abs().max():.2e}\")\n\nPYEOF\npython /tmp/profile5.py'","aggregated_output":"","exit_code":null,"status":"in_progress"}}

   G_exp = G.unsqueeze(1)\n        p1G = p1 @ G_exp\n        norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n        normm = normm_sq.sqrt().clamp_min(1e-6)\n        ratio = (norm1 / normm).clamp(0.25, 4.0)\n        y = (p_mix @ v) * ratio\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Version: BLHD format + transpose-based logits\n@torch.no_grad()\ndef opt_blhd_transpose(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    xr = x.reshape(B * L, C)\n    HD = H * D\n    \n    # BLHD format - no permute needed\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D)\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D)\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D)\n    \n    # logits[b,h,l,m] = sum_d q[b,l,h,d] * k[b,m,h,d]\n    # = (q.transpose(1,2) @ k.transpose(1,2).transpose(-1,-2))\n    # But transposing twice... let's just do it properly\n    # q: (B, L, H, D) -> (B, H, L, D) via transpose(1,2)\n    q_bh = q.transpose(1, 2)  # (B, H, L, D)\n    k_bh = k.transpose(1, 2)  # (B, H, L, D)\n    logits = q_bh @ k_bh.transpose(-1, -2) * inv_sqrt_d\n    \n    p0 = logits.softmax(dim=-1)\n    if alpha == 1.0:\n        y = p0 @ v.transpose(1, 2)\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        G = (xr @ xr.T).reshape(B, L, L)\n        G_exp = G.unsqueeze(1)\n        p1G = p1 @ G_exp\n        norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n        normm = normm_sq.sqrt().clamp_min(1e-6)\n        ratio = (norm1 / normm).clamp(0.25, 4.0)\n        y = (p_mix @ v.transpose(1, 2)) * ratio\n    return y.transpose(1, 2).flatten(2).contiguous()\n\nvariants = [\n    (\"ref\", ref_attention),\n    (\"fastG\", opt_fastG),\n    (\"fastG+contigQK\", opt_fastG_contigqk),\n    (\"blhd_einsum\", opt_blhd_einsum),\n    (\"blhd_transpose\", opt_blhd_transpose),\n]\n\nprint(f\"{'Case':25s}  \", end=\"\")\nfor name, _ in variants:\n    print(f\"{name:>15s}\", end=\"\")\nprint()\nprint(\"-\" * (25 + 15 * len(variants)))\n\ngeomean_ref = 1.0\ngeomean_opt = [1.0] * (len(variants)-1)\n\nfor i, (B, L, C, H, D, alpha, beta) in enumerate(cases):\n    torch.manual_seed(42 + i)\n    x = torch.randn(B, L, C)\n    wq = torch.randn(H, D, C)\n    wk = torch.randn(H, D, C)\n    wv = torch.randn(H, D, C)\n    \n    case_label = f\"B{B} L{L} C{C} H{H} a{alpha}\"\n    \n    ref_out = ref_attention(x, wq, wk, wv, alpha, beta)\n    \n    times = []\n    for name, fn in variants:\n        ms = bench(name, lambda: fn(x, wq, wk, wv, alpha, beta), n=15)\n        times.append(ms)\n        \n        # Verify\n        if name != \"ref\":\n            out = fn(x, wq, wk, wv, alpha, beta)\n            diff = (out - ref_out).abs().max().item()\n            reldiff = (diff / (ref_out.abs().max().item() + 1e-8))\n            if diff > 3e-5 + 3e-4 * abs(ref_out.abs().max().item()):\n                print(f\"  WARNING: {name} exceeds tolerance! max_abs={diff:.2e}, max_rel={reldiff:.2e}\")\n    \n    print(f\"{case_label:25s}  \", end=\"\")\n    for t in times:\n        print(f\"{t:14.2f} \", end=\"\")\n    print()\n    \n    if times[0] > 0:\n        for j in range(1, len(variants)):\n            geomean_opt[j-1] *= times[j] / times[0]\n\nprint(f\"\\nGeometric mean ratio (vs ref):\")\nfor j in range(1, len(variants)):\n    print(f\"  {variants[j][0]:20s}: {geomean_opt[j-1]**(1/len(cases)):.4f}\")\n\nPYEOF\npython /tmp/bench_all.py</parameter><parameter name=\"yield_time_ms\">120000</parameter></function></seed:tool_call>"}}

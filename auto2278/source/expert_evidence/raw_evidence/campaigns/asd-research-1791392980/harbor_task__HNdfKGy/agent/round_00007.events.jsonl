{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/sh -lc \"cat << 'PYEOF' > /tmp/profile9.py\nimport math\nimport time\nimport torch\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\ninv_sqrt_d = 1.0 / math.sqrt(D)\nxr = x.reshape(B * L, C)\nwq_r = wq.reshape(H*D, C)\nwk_r = wk.reshape(H*D, C)\nwv_r = wv.reshape(H*D, C)\n\ndef bench(name, fn, n=30):\n    for _ in range(3): fn()\n    times = []\n    for _ in range(n):\n        t0 = time.perf_counter()\n        fn()\n        times.append(time.perf_counter() - t0)\n    times.sort()\n    med = times[n//2] * 1000\n    print(f\\\"  {name:45s}: {med:7.3f} ms\\\")\n    return med\n\nq = (xr @ wq_r.T).reshape(B, L, H, D).permute(0, 2, 1, 3)\nk = (xr @ wk_r.T).reshape(B, L, H, D).permute(0, 2, 1, 3)\nv = (xr @ wv_r.T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n\nlogits = q @ k.transpose(-1, -2) * inv_sqrt_d\np0 = logits.softmax(dim=-1)\na_p = 0.5 * (1 + alpha)\na_m = 0.5 * (1 - alpha)\np1_logits = a_p * logits + a_m * logits.transpose(-1, -2)\np1 = p1_logits.softmax(dim=-1)\np_mix = torch.lerp(p0, p1, beta)\nG = (xr @ xr.T).reshape(B, L, L)\nG_exp = G.unsqueeze(1)\n\n# === Norm sharing ===\nprint(\\\"=== Norm computation approaches ===\\\")\n\ndef norm_current():\n    p1G = p1 @ G_exp\n    pmG = p_mix @ G_exp\n    n1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n    nm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n    n1 = n1_sq.sqrt().clamp_min(1e-6)\n    nm = nm_sq.sqrt().clamp_min(1e-6)\n    return (n1 / nm).clamp(0.25, 4.0)\n\ndef norm_shared_p0_p1():\n    p0G = p0 @ G_exp\n    p1G = p1 @ G_exp\n    n0_sq = (p0G * p0).sum(dim=-1, keepdim=True)\n    n1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n    cross = (p0G * p1).sum(dim=-1, keepdim=True)\n    b0 = 1.0 - beta\n    nm_sq = b0*b0 * n0_sq + beta*beta * n1_sq + 2*b0*beta * cross\n    n1 = n1_sq.sqrt().clamp_min(1e-6)\n    nm = nm_sq.sqrt().clamp_min(1e-6)\n    return (n1 / nm).clamp(0.25, 4.0)\n\nbench(\\\"current (p1@G + pmix@G)\\\", norm_current)\nbench(\\\"shared (p0@G + p1@G + formula)\\\", norm_shared_p0_p1)\n\nr_c = norm_current()\nr_s = norm_shared_p0_p1()\nprint(f\\\"  diff: {(r_c-r_s).abs().max():.2e}\\\")\n\n# === Full optimized function ===\nprint(\\\"\\\\n=== Full function comparison ===\\\")\n\n@torch.no_grad()\ndef ref_attention(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wv.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    logits = q @ k.transpose(-1, -2) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        p1G = p1 @ G_exp\n        norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n        normm = normm_sq.sqrt().clamp_min(1e-6)\n        ratio = (norm1 / normm).clamp(0.25, 4.0)\n        y = (p_mix @ v) * ratio\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n@torch.no_grad()\ndef opt_v1(x, wq, wk, wv, alpha, beta):\n    \\\"\\\"\\\"v1: fused qkv projection + fast G + shared norms\\\"\\\"\\\"\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    xr = x.reshape(B * L, C)\n    HD = H * D\n    \n    wq_r = wq.reshape(HD, C)\n    wk_r = wk.reshape(HD, C)\n    wv_r = wv.reshape(HD, C)\n    \n    # Fused QKV projection\n    w_qkv = torch.cat([wq_r, wk_r, wv_r], dim=0)\n    out = xr @ w_qkv.T  # (B*L, 3*HD)\n    out = out.reshape(B, L, 3, H, D).permute(2, 0, 3, 1, 4)\n    q, k, v = out[0], out[1], out[2]\n    \n    logits = q @ k.transpose(-1, -2) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    \n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        \n        G = (xr @ xr.T).reshape(B, L, L)\n        G_exp = G.unsqueeze(1)\n        \n        # Shared norm computation: use p0@G and p1@G to derive m-norm\n        p0G = p0 @ G_exp\n        p1G = p1 @ G_exp\n        \n        n0_sq = (p0G * p0).sum(dim=-1, keepdim=True)\n        n1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n        cross = (p0G * p1).sum(dim=-1, keepdim=True)\n        \n        b0 = 1.0 - beta\n        nm_sq = b0*b0 * n0_sq + beta*beta * n1_sq + 2*b0*beta * cross\n        \n        norm1 = n1_sq.sqrt().clamp_min(1e-6)\n        normm = nm_sq.sqrt().clamp_min(1e-6)\n        ratio = (norm1 / normm).clamp(0.25, 4.0)\n        \n        y = (p_mix @ v) * ratio\n    \n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Verify\nr0 = ref_attention(x, wq, wk, wv, alpha, beta)\nr1 = opt_v1(x, wq, wk, wv, alpha, beta)\nprint(f\\\"  shape match: {r0.shape == r1.shape}\\\")\nprint(f\\\"  max diff: {(r0-r1).abs().max():.2e}\\\")\nprint(f\\\"  rel diff: {((r0-r1).abs() / (r0.abs() + 1e-8)).max():.2e}\\\")\n\nbench(\\\"Reference\\\", lambda: ref_attention(x, wq, wk, wv, alpha, beta), n=20)\nbench(\\\"Opt v1 (fused qkv + fast G + shared norm)\\\", lambda: opt_v1(x, wq, wk, wv, alpha, beta), n=20)\n\n# Also test alpha=1.0 case\nprint(\\\"\\\\n  Alpha=1.0:\\\")\nbench(\\\"  Ref\\\", lambda: ref_attention(x, wq, wk, wv, 1.0, beta), n=20)\nbench(\\\"  Opt v1\\\", lambda: opt_v1(x, wq, wk, wv, 1.0, beta), n=20)\n\n# Small case\nprint(\\\"\\\\n=== Small case B=1,L=64,C=512,H=8,D=64 ===\\\")\nx2 = torch.randn(1, 64, 512)\nwq2 = torch.randn(8, 64, 512)\nwk2 = torch.randn(8, 64, 512)\nwv2 = torch.randn(8, 64, 512)\nr0s = ref_attention(x2, wq2, wk2, wv2, 1.05, 5.0)\nr1s = opt_v1(x2, wq2, wk2, wv2, 1.05, 5.0)\nprint(f\\\"  max diff: {(r0s-r1s).abs().max():.2e}\\\")\nbench(\\\"  Ref small\\\", lambda: ref_attention(x2, wq2, wk2, wv2, 1.05, 5.0), n=30)\nbench(\\\"  Opt small\\\", lambda: opt_v1(x2, wq2, wk2, wv2, 1.05, 5.0), n=30)\n\nPYEOF\npython /tmp/profile9.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/sh -lc \"cat << 'PYEOF' > /tmp/profile7.py\nimport math\nimport time\nimport torch\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n# Use the largest case for profiling\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\ninv_sqrt_d = 1.0 / math.sqrt(D)\nxr = x.reshape(B * L, C)\nwq_r = wq.reshape(H*D, C)\nwk_r = wk.reshape(H*D, C)\nwv_r = wv.reshape(H*D, C)\n\n# Properly warm up\nfor _ in range(5):\n    _ = (xr @ wq_r.T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    _ = (xr @ wk_r.T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    _ = (xr @ wv_r.T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n\nq = (xr @ wq_r.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk_r.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nv = (xr @ wv_r.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\nlogits = q @ k.transpose(-1, -2) * inv_sqrt_d\np0 = logits.softmax(dim=-1)\na_p = 0.5 * (1.0 + alpha)\na_m = 0.5 * (1.0 - alpha)\np1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\np_mix = torch.lerp(p0, p1, beta)\nG = (xr @ xr.T).reshape(B, L, L)\nG_exp = G.unsqueeze(1)\n\ndef bench(name, fn, n=30):\n    for _ in range(3): fn()\n    times = []\n    for _ in range(n):\n        t0 = time.perf_counter()\n        fn()\n        times.append(time.perf_counter() - t0)\n    times.sort()\n    med = times[n//2] * 1000\n    print(f\\\"  {name:40s}: {med:7.3f} ms\\\")\n    return med\n\nprint(\\\"=== Detailed breakdown ===\\\")\nbench(\\\"q proj + permute\\\", lambda: (xr @ wq_r.T).reshape(B, L, H, D).permute(0, 2, 1, 3))\nbench(\\\"k proj + permute\\\", lambda: (xr @ wk_r.T).reshape(B, L, H, D).permute(0, 2, 1, 3))\nbench(\\\"v proj + permute\\\", lambda: (xr @ wv_r.T).reshape(B, L, H, D).permute(0, 2, 1, 3))\nbench(\\\"just q gemm (xr @ wq_r.T)\\\", lambda: xr @ wq_r.T)\nbench(\\\"gemm + reshape (no permute)\\\", lambda: (xr @ wq_r.T).reshape(B, L, H, D))\nbench(\\\"logits q @ k\"'^T * s\", lambda: q @ k.transpose(-1, -2) * inv_sqrt_d)\nbench(\"softmax p0\", lambda: logits.softmax(dim=-1))\nbench(\"p1 logits computation\", lambda: a_p * logits + a_m * logits.transpose(-1, -2))\nbench(\"softmax p1\", lambda: (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1))\nbench(\"lerp p_mix\", lambda: torch.lerp(p0, p1, beta))\nbench(\"G = xr @ xr.T\", lambda: (xr @ xr.T).reshape(B, L, L))\nbench(\"p1 @ G_exp\", lambda: p1 @ G_exp)\nbench(\"p_mix @ G_exp\", lambda: p_mix @ G_exp)\nbench(\"norm1 = (p1G*p1).sum.sqrt.clamp\", lambda: ((p1 @ G_exp) * p1).sum(dim=-1, keepdim=True).sqrt().clamp_min(1e-6))\nbench(\"p_mix @ v\", lambda: p_mix @ v)\nbench(\"y = (pmix@v) * ratio (fused)\", lambda: (p_mix @ v) * torch.ones(B, H, L, 1))\nbench(\"transpose + flatten + contig\", lambda: (p_mix @ v).transpose(1, 2).flatten(2).contiguous())\n\n# Let me check the output projection cost too\n# y * wv''^T: y is (B,H,L,D), wv is (H,D,C) -> output is (B,H,L,C)? No...\n# Actually return: (r*m) @ wv''^T where r*m is in u-space (B,H,L,C), and wv is (H,D,C)\n# Wait no! The output is (r*m) wv''^T... but m is in input space (C-dim), and wv maps input to D-dim per head\n# (r*m) is (B,H,L,C) [in input space], wv''^T is (C, D) per head\n# result per head: (B, L, C) @ (C, D) = (B, L, D)\n\n# Wait, let me re-read the spec:\n# \"Return the concatenated head outputs (r*m) wv''^T in shape (B,L,H*D)\"\n# m = u0 + beta*(u1-u0), u0 = P0 @ x, u1 = P1 @ x -- all in input space C\n# (r*m) wv''^T = applying wv projection to the rescaled blended result\n# m is (B,H,L,C), wv is (H,D,C) -> m @ wv''^T per head: (B,L,C) @ (C,D) = (B,L,D)\n# = einsum(\"bhlc,hdc->bhld\", m, wv)\n\n# Wait, but the current solution uses v-first: p_mix @ v where v = x @ wv''^T\n# v is (B,H,L,D), p_mix is (B,H,L,L) -> p_mix @ v = (B,H,L,D)\n# And y = (p_mix @ v) * ratio -- ratio is (B,H,L,1)\n# This is correct because: (p_mix @ x) * ratio @ wv''^T = p_mix @ (x @ wv''^T) * ratio\n# = p_mix @ v * ratio -- but wait, the ratio scales m (in input space)\n# ratio = ||u1|| / ||m|| -- scalar per head/token\n# (ratio * m) @ wv''^T = ratio * (m @ wv''^T) = ratio * (p_mix @ v)\n# YES! Because ratio is a scalar per token, it commutes with the linear projection.\n# So y = (p_mix @ v) * ratio is correct.\n\n# OK so current solution is correct and avoids the final projection.\n# The final step is just transpose+flatten.\n\nprint(\"'\"\\\\n=== Let me check: can we fuse ratio * (p_mix @ v) ? ===\\\")\nratio = torch.rand(B, H, L, 1).clamp(0.25, 4.0)\nout = p_mix @ v\nbench(\\\"p_mix @ v then * ratio\\\", lambda: (p_mix @ v) * ratio)\n\n# What if we scale v or p_mix first?\n# ratio * (p_mix @ v) = (p_mix * ratio.unsqueeze(-1)) @ v ... no, ratio is per output row\n# Actually: (p_mix @ v)[i,j] = sum_k p_mix[i,k] * v[k,j]\n# ratio[i] * (p_mix @ v)[i,j] = sum_k (ratio[i] * p_mix[i,k]) * v[k,j]\n# = (ratio.unsqueeze(-1) * p_mix) @ v\n# This requires scaling p_mix (BHL² elements) vs scaling output (BHLD elements)\n# L=256, D=64: L²=65536, LD=16384. So scaling output is cheaper (16k vs 65k per head per batch)\n# Already optimal.\n\nbench(\\\"scale p_mix then @ v\\\", lambda: (p_mix * ratio) @ v)\n\nprint(\\\"\\\\n=== Idea: compute both p0@v and p1@v, then lerp, vs p_mix@v ===\\\")\n# p_mix = (1-beta)*p0 + beta*p1\n# p_mix @ v = (1-beta)*(p0 @ v) + beta*(p1 @ v)\n# Cost: 2*(BHL*L*D) vs 1*(BHL*L*D) -- 2x more matmul, NO\nbench(\\\"p0@v + p1@v then lerp\\\", lambda: torch.lerp(p0 @ v, p1 @ v, beta))\nbench(\\\"p_mix @ v (current)\\\", lambda: p_mix @ v)\n\nPYEOF\npython /tmp/profile7.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

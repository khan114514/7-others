{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/sh -lc \"cat << 'PYEOF' > /tmp/profile.py\nimport math\nimport time\nimport torch\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n@torch.no_grad()\ndef attention_current(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wv.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n\n    logits = q @ k.transpose(-1, -2) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n\n        p1G = p1 @ G_exp\n        norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n\n        pmG = p_mix @ G_exp\n        normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n\n        norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n        normm = normm_sq.sqrt().clamp_min(1e-6)\n        ratio = (norm1 / normm).clamp(0.25, 4.0)\n\n        y = (p_mix @ v) * ratio\n\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ndef profile_case(B, L, C, H, D, alpha, beta, label):\n    torch.manual_seed(42)\n    x = torch.randn(B, L, C)\n    wq = torch.randn(H, D, C)\n    wk = torch.randn(H, D, C)\n    wv = torch.randn(H, D, C)\n\n    # warmup\n    for _ in range(3):\n        attention_current(x, wq, wk, wv, alpha, beta)\n\n    N = 20\n    t0 = time.perf_counter()\n    for _ in range(N):\n        attention_current(x, wq, wk, wv, alpha, beta)\n    t_total = (time.perf_counter() - t0) / N * 1000\n\n    print(f\\\"\\\\n=== {label}: B={B}, L={L}, C={C}, H={H}, D={D} ===\\\")\n    print(f\\\"Total: {t_total:.2f} ms\\\")\n\n    # Detailed profiling\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    xr = x.reshape(B * L, C)\n\n    def time_op(name, fn, n=20):\n        for _ in range(2): fn()  # warmup\n        t0 = time.perf_counter()\n        for _ in range(n): fn()\n        ms = (time.perf_counter() - t0) / n * 1000\n        print(f\\\"  {name:35s}: {ms:7.2f} ms ({ms/t_total*100:5.1f}%)\\\")\n\n    # Projections\n    wq_r = wq.reshape(H * D, C)\n    wk_r = wk.reshape(H * D, C)\n    wv_r = wv.reshape(H * D, C)\n    time_op(\\\"q projection\\\", lambda: (xr @ wq_r.T).reshape(B, L, H, D).permute(0, 2, 1, 3))\n    time_op(\\\"k projection\\\", lambda: (xr @ wk_r.T).reshape(B, L, H, D).permute(0, 2, 1, 3))\n    time_op(\\\"v projection\\\", lambda: (xr @ wv_r.T).reshape(B, L, H, D).permute(0, 2, 1, 3))\n\n    # Fused projection\n    w_all = torch.cat([wq_r, wk_r, wv_r], dim=0)\n    def fused_proj():\n        out = xr @ w_all.T\n        q = out[:, :H*D].reshape(B, L, H, D).permute(0, 2, 1, 3)\n        k = out[:, H*D:2*H*D].reshape(B, L, H, D).permute(0, 2, 1, 3)\n        v = out[:, 2*H*D:].reshape(B, L, H, D).permute(0, 2, 1, 3)\n        return q, k, v\n    time_op(\\\"fused qkv projection\\\", fused_proj)\n\n    q = (xr @ wq_r.T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk_r.T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wv_r.T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    logits = q @ k.transpose(-1, -2) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n\n    time_op(\\\"logits (q @ k\"'^T)\", lambda: q @ k.transpose(-1, -2) * inv_sqrt_d)\n    time_op(\"softmax p0\", lambda: logits.softmax(dim=-1))\n\n    if alpha != 1.0:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1_logits = a_p * logits + a_m * logits.transpose(-1, -2)\n        p1 = p1_logits.softmax(dim=-1)\n        time_op(\"p1 logits (a_p*A + a_m*A''^T)\", lambda: a_p * logits + a_m * logits.transpose(-1, -2))\n        time_op(\"softmax p1\", lambda: p1_logits.softmax(dim=-1))\n\n        p_mix = torch.lerp(p0, p1, beta)\n        time_op(\"p_mix = lerp(p0, p1)\", lambda: torch.lerp(p0, p1, beta))\n\n        # Gram matrix\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        time_op(\"G = x @ x''^T\", lambda: x @ x.transpose(-1, -2))\n\n        p1G = p1 @ G_exp\n        time_op(\"p1 @ G\", lambda: p1 @ G_exp)\n        time_op(\"norm1_sq = (p1G * p1).sum()\", lambda: (p1G * p1).sum(dim=-1, keepdim=True))\n\n        pmG = p_mix @ G_exp\n        time_op(\"p_mix @ G\", lambda: p_mix @ G_exp)\n        time_op(\"normm_sq = (pmG * pmix).sum()\", lambda: (pmG * p_mix).sum(dim=-1, keepdim=True))\n\n        time_op(\"p_mix @ v\", lambda: p_mix @ v)\n\n        time_op(\"p0 @ v\", lambda: p0 @ v)\n        time_op(\"p1 @ v\", lambda: p1 @ v)\n\ncases = [\n    (1, 64, 512, 8, 64, 1.05, 5.0, \"case1\"),\n    (1, 256, 1280, 20, 64, 1.05, 7.5, \"case4 (largest)\"),\n    (2, 128, 512, 8, 64, 1.0, 5.0, \"case6 (alpha=1)\"),\n]\n\nfor B, L, C, H, D, alpha, beta, label in cases:\n    profile_case(B, L, C, H, D, alpha, beta, label)\nPYEOF\npython /tmp/profile.py'","aggregated_output":"\n=== case1: B=1, L=64, C=512, H=8, D=64 ===\nTotal: 5.04 ms\n  q projection                       :    1.29 ms ( 25.7%)\n  k projection                       :    0.66 ms ( 13.0%)\n  v projection                       :    0.65 ms ( 12.8%)\n  fused qkv projection               :    2.07 ms ( 41.1%)\n  logits (q @ k^T)                   :    0.72 ms ( 14.3%)\n  softmax p0                         :    0.37 ms (  7.3%)\n  p1 logits (a_p*A + a_m*A^T)        :    0.05 ms (  1.0%)\n  softmax p1                         :    0.35 ms (  6.9%)\n  p_mix = lerp(p0, p1)               :    0.01 ms (  0.2%)\n  G = x @ x^T                        :    0.70 ms ( 14.0%)\n  p1 @ G                             :    0.11 ms (  2.1%)\n  norm1_sq = (p1G * p1).sum()        :    0.02 ms (  0.3%)\n  p_mix @ G                          :    0.11 ms (  2.3%)\n  normm_sq = (pmG * pmix).sum()      :    0.02 ms (  0.3%)\n  p_mix @ v                          :    0.12 ms (  2.3%)\n  p0 @ v                             :    0.11 ms (  2.3%)\n  p1 @ v                             :    0.11 ms (  2.2%)\n\n=== case4 (largest): B=1, L=256, C=1280, H=20, D=64 ===\nTotal: 128.63 ms\n  q projection                       :   16.68 ms ( 13.0%)\n  k projection                       :   27.31 ms ( 21.2%)\n  v projection                       :   34.39 ms ( 26.7%)\n  fused qkv projection               :   67.80 ms ( 52.7%)\n  logits (q @ k^T)                   :    4.02 ms (  3.1%)\n  softmax p0                         :   13.59 ms ( 10.6%)\n  p1 logits (a_p*A + a_m*A^T)        :    4.16 ms (  3.2%)\n  softmax p1                         :   19.30 ms ( 15.0%)\n  p_mix = lerp(p0, p1)               :    0.33 ms (  0.3%)\n  G = x @ x^T                        :    7.12 ms (  5.5%)\n  p1 @ G                             :   15.77 ms ( 12.3%)\n  norm1_sq = (p1G * p1).sum()        :    0.47 ms (  0.4%)\n  p_mix @ G                          :   12.22 ms (  9.5%)\n  normm_sq = (pmG * pmix).sum()      :    0.48 ms (  0.4%)\n  p_mix @ v                          :    3.20 ms (  2.5%)\n  p0 @ v                             :    2.98 ms (  2.3%)\n  p1 @ v                             :    2.72 ms (  2.1%)\n\n=== case6 (alpha=1): B=2, L=128, C=512, H=8, D=64 ===\nTotal: 13.29 ms\n  q projection                       :    2.44 ms ( 18.4%)\n  k projection                       :    2.44 ms ( 18.3%)\n  v projection                       :    3.30 ms ( 24.8%)\n  fused qkv projection               :   10.44 ms ( 78.5%)\n  logits (q @ k^T)                   :    3.69 ms ( 27.8%)\n  softmax p0                         :    3.06 ms ( 23.0%)\n","exit_code":0,"status":"completed"}}

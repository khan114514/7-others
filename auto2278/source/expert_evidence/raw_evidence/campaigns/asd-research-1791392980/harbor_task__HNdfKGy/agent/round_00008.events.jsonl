ute(2, 0, 3, 1, 4).contiguous()\n        return out[0], out[1], out[2]\n    \n    q1, k1, v1 = separate()\n    q2, k2, v2 = fused_cat()\n    q3, k3, v3 = fused_view()\n    \n    assert (q1 - q2).abs().max() < 1e-5, f\"q diff: {(q1-q2).abs().max()}\"\n    assert (k1 - k2).abs().max() < 1e-5\n    assert (v1 - v2).abs().max() < 1e-5\n    assert (q1 - q3).abs().max() < 1e-5\n    \n    t_sep = bench(separate, n=30)\n    t_fused = bench(fused_cat, n=30)\n    t_view = bench(fused_view, n=30)\n    print(f\"  separate: {t_sep:.2f}ms, fused_cat: {t_fused:.2f}ms ({t_fused/t_sep:.3f}), fused_view: {t_view:.2f}ms ({t_view/t_sep:.3f})\")\n    return t_sep, t_fused\n\nprint(\"=== Fused projection (properly) ===\")\nfor B, L, C, H, D in [\n    (1, 256, 1280, 20, 64),\n    (1, 128, 1280, 20, 64),\n    (1, 256, 640, 10, 64),\n    (1, 128, 640, 10, 64),\n    (1, 64, 512, 8, 64),\n    (2, 128, 512, 8, 64),\n]:\n    print(f\"B{B} L{L} C{C} H{H} D{D}:\")\n    test_fused_proj(B, L, C, H, D)\n\nPYEOF\npython /tmp/optimize6.py'","aggregated_output":"=== Fused projection (properly) ===\nB1 L256 C1280 H20 D64:\n  separate: 65.88ms, fused_cat: 59.77ms (0.907), fused_view: 60.53ms (0.919)\nB1 L128 C1280 H20 D64:\n  separate: 31.75ms, fused_cat: 25.24ms (0.795), fused_view: 22.69ms (0.715)\nB1 L256 C640 H10 D64:\n  separate: 11.19ms, fused_cat: 10.34ms (0.924), fused_view: 11.91ms (1.064)\nB1 L128 C640 H10 D64:\n  separate: 9.23ms, fused_cat: 5.78ms (0.626), fused_view: 6.21ms (0.673)\nB1 L64 C512 H8 D64:\n  separate: 2.28ms, fused_cat: 1.97ms (0.861), fused_view: 1.98ms (0.868)\nB2 L128 C512 H8 D64:\n  separate: 7.27ms, fused_cat: 11.07ms (1.522), fused_view: 7.05ms (0.970)\n","exit_code":0,"status":"completed"}}

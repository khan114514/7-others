{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/optimize4.py << 'PYEOF'\nimport math\nimport torch\nimport time\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\ndef bench(fn, n=20):\n    for _ in range(3):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    return (t1 - t0) / n / 1e6\n\n# Key question: can we compute norms without full Gram matrix?\n# ||p@x||\"'^2 = sum_ij p_i p_j <x_i, x_j> = p @ G @ p''^T diagonal\n# G is (B, L, L) = x @ x''^T. Cost: B * L''^2 * C\n# p @ G is (B, H, L, L) = p @ G.unsqueeze(1). Cost: B * H * L''^2 * L = B H L''^3 ??? No...\n# Wait: p is (B, H, L, L), G_exp is (B, 1, L, L) broadcast to (B, H, L, L)\n# p @ G_exp does matmul on last 2 dims: (L, L) @ (L, L) = (L, L), B*H batch\n# Cost: B * H * L * L * L = B H L''^3 ... that can'\"'t be right for large L.\n# Wait no, for the B1L256 case: 1*20*256*256*256 = 335M ops vs direct p@x: 20*256*256*1280 = 1.67B ops\n# So Gram is better when C > L, which is usually true here.\n\n# But wait - we only need the DIAGONAL of p @ G @ p\"'^T.\n# That'\"'s sum_j (p_i * (G @ p\"'^T)_ji) for each i, which is what we compute with (pG * p).sum(-1)\n# Same cost.\n\n# Alternative: compute u = p @ v first (we need it anyway), then compute norms from that?\n# No, we need norm of p@x, not p@v. The ratio depends on u1 and m which are p@x products.\n\n# Wait - let'\"'s re-read the problem:\n# u0 = P0 @ x, u1 = P1 @ x, m = u0 + beta*(u1-u0)\n# r = clamp(||u1|| / ||m||, 0.25, 4.0) per head and token\n# output = (r * m) @ wv\"'^T, then concat heads\n# \n# v-first approach: v = x @ wv''^T\n# output = (r * m) has shape (B,H,L,C), multiply by wv''^T... wait no.\n# \n# Actually current code does:\n# y = (p_mix @ v) * ratio  -- this is WRONG mathematically!\n# Let me verify...\n\n# Let'\"'s check: original formula says r * m * wv\"'^T where m = u0 + beta*(u1-u0)\n# and u = p @ x.  So r * m has shape (B,H,L,C), then @ wv''^T gives (B,H,L,D).\n# \n# But v = x @ wv''^T has shape (B,H,L,D).\n# p_mix @ v has shape (B,H,L,D).\n# \n# Is (p_mix @ x) @ wv''^T == p_mix @ (x @ wv''^T)? YES! Matrix multiplication is associative.\n# But what about (r * (p_mix @ x)) @ wv''^T? That'\"'s NOT the same as r * (p_mix @ v).\n# Because r is per-token, per-head scalar. (r * u) @ wv\"'^T = r * (u @ wv''^T) since r is scalar per row.\n# Wait, r has shape (B,H,L,1). u has shape (B,H,L,C). wv has shape (H,D,C).\n# (r * u) is (B,H,L,C). Then einsum with wv gives (B,H,L,D).\n# p_mix @ v is (B,H,L,D). Then * ratio is (B,H,L,D).\n# These are the same! Because:\n# (r * (p@x)) @ wv''^T = r * ((p@x) @ wv''^T) = r * (p @ (x @ wv''^T)) = r * (p @ v)\n# Yes, scalar multiplication commutes with linear projection.\n\n# OK so the v-first approach is correct. Good. Now the problem:\n# We need ||u1|| and ||m|| where these are p@x products. We need the norms in C-dimensional space.\n# We can'\"'t get those from v = x@wv\"'^T (which is D-dimensional).\n# So we still need the Gram matrix G = x@x''^T for norm computation.\n\n# Let'\"'s verify current solution numerically:\n\ndef ref_attention(x, wq, wk, wv, alpha, beta):\n    q = torch.einsum(\\\"blc,hdc->bhld\\\", x, wq)\n    k = torch.einsum(\\\"blc,hdc->bhld\\\", x, wk)\n    logits = (q @ k.transpose(-1, -2)) / math.sqrt(wq.shape[1])\n    p0 = logits.softmax(dim=-1)\n    base = p0 @ x.unsqueeze(1)\n    if alpha == 1.0:\n        modified = base\n    else:\n        perturbed = .5 * (1 + alpha) * logits + .5 * (1 - alpha) * logits.transpose(-1, -2)\n        modified = perturbed.softmax(dim=-1) @ x.unsqueeze(1)\n    blended = base + beta * (modified - base)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    y = torch.einsum(\\\"bhlc,hdc->bhld\\\", blended * ratio, wv)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n\n@torch.no_grad()\ndef current_best(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wv.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n\n    logits = q @ k.transpose(-1, -2) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n\n        p1G = p1 @ G_exp\n        norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n\n        pmG = p_mix @ G_exp\n        normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n\n        norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n        normm = normm_sq.sqrt().clamp_min(1e-6)\n        ratio = (norm1 / normm).clamp(0.25, 4.0)\n\n        y = (p_mix @ v) * ratio\n\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n\n# Verify correctness\nfor B, L, C, H, D, alpha, beta in [\n    (1, 64, 512, 8, 64, 1.05, 5.0),\n    (1, 128, 640, 10, 64, 1.1, 4.0),\n    (1, 256, 1280, 20, 64, 1.05, 7.5),\n    (2, 128, 512, 8, 64, 1.0, 5.0),\n]:\n    torch.manual_seed(42)\n    x = torch.randn(B, L, C)\n    wq = torch.randn(H, D, C)\n    wk = torch.randn(H, D, C)\n    wv = torch.randn(H, D, C)\n    \n    ref = ref_attention(x, wq, wk, wv, alpha, beta)\n    cur = current_best(x, wq, wk, wv, alpha, beta)\n    \n    diff = (ref - cur).abs().max().item()\n    reldiff = diff / (ref.abs().max().item() + 1e-8)\n    tol = 3e-5 + 3e-4 * ref.abs().max().item()\n    status = \\\"PASS\\\" if diff <= tol else \\\"FAIL\\\"\n    print(f\\\"B{B}L{L}C{C}H{H} a={alpha}: max_diff={diff:.2e}, max_reldiff={reldiff:.2e}, tol={tol:.2e} [{status}]\\\")\n\nPYEOF\npython /tmp/optimize4.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/optimize4.py << 'PYEOF'\nimport math\nimport torch\nimport time\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\ndef bench(fn, n=20):\n    for _ in range(3):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    return (t1 - t0) / n / 1e6\n\n# Key question: can we compute norms without full Gram matrix?\n# ||p@x||\"'^2 = sum_ij p_i p_j <x_i, x_j> = p @ G @ p''^T diagonal\n# G is (B, L, L) = x @ x''^T. Cost: B * L''^2 * C\n# p @ G is (B, H, L, L) = p @ G.unsqueeze(1). Cost: B * H * L''^2 * L = B H L''^3 ??? No...\n# Wait: p is (B, H, L, L), G_exp is (B, 1, L, L) broadcast to (B, H, L, L)\n# p @ G_exp does matmul on last 2 dims: (L, L) @ (L, L) = (L, L), B*H batch\n# Cost: B * H * L * L * L = B H L''^3 ... that can'\"'t be right for large L.\n# Wait no, for the B1L256 case: 1*20*256*256*256 = 335M ops vs direct p@x: 20*256*256*1280 = 1.67B ops\n# So Gram is better when C > L, which is usually true here.\n\n# But wait - we only need the DIAGONAL of p @ G @ p\"'^T.\n# That'\"'s sum_j (p_i * (G @ p\"'^T)_ji) for each i, which is what we compute with (pG * p).sum(-1)\n# Same cost.\n\n# Alternative: compute u = p @ v first (we need it anyway), then compute norms from that?\n# No, we need norm of p@x, not p@v. The ratio depends on u1 and m which are p@x products.\n\n# Wait - let'\"'s re-read the problem:\n# u0 = P0 @ x, u1 = P1 @ x, m = u0 + beta*(u1-u0)\n# r = clamp(||u1|| / ||m||, 0.25, 4.0) per head and token\n# output = (r * m) @ wv\"'^T, then concat heads\n# \n# v-first approach: v = x @ wv''^T\n# output = (r * m) has shape (B,H,L,C), multiply by wv''^T... wait no.\n# \n# Actually current code does:\n# y = (p_mix @ v) * ratio  -- this is WRONG mathematically!\n# Let me verify...\n\n# Let'\"'s check: original formula says r * m * wv\"'^T where m = u0 + beta*(u1-u0)\n# and u = p
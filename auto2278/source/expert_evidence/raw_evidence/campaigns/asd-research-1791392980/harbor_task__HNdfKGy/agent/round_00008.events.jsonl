{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/optimize3.py << 'PYEOF'\nimport math\nimport torch\nimport time\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\ndef bench(fn, n=20):\n    for _ in range(3):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    return (t1 - t0) / n / 1e6\n\n# Test: fused projection with permutation options\ndef test_proj_layouts(B, L, C, H, D):\n    x = torch.randn(B, L, C)\n    wq = torch.randn(H, D, C)\n    wk = torch.randn(H, D, C)\n    wv = torch.randn(H, D, C)\n    xr = x.reshape(B*L, C)\n    \n    # Current: (B*L, C) @ (HD, C)\"'^T -> (B*L, HD) -> reshape (B,L,H,D) -> permute (B,H,L,D)\n    def current():\n        q = (xr @ wq.reshape(H*D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n        k = (xr @ wk.reshape(H*D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n        v = (xr @ wv.reshape(H*D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n        return q, k, v\n    \n    # Alternative: pre-transpose weights to (C, HD), then reshape differently\n    wq_t = wq.reshape(H*D, C).T.contiguous()  # (C, H*D)\n    wk_t = wk.reshape(H*D, C).T.contiguous()\n    wv_t = wv.reshape(H*D, C).T.contiguous()\n    \n    def pretranspose():\n        q = (xr @ wq_t).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n        k = (xr @ wk_t).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n        v = (xr @ wv_t).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n        return q, k, v\n    \n    # Alternative: arrange output directly in (B,H,L,D) layout via reshaping\n    # After xr @ W''^T we have (B*L, H*D) = (B*L, H, D)\n    # We want (B, H, L, D)\n    def permute_optimized():\n        q = (xr @ wq.reshape(H*D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n        k = (xr @ wk.reshape(H*D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n        v = (xr @ wv.reshape(H*D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n        return q.contiguous(), k.contiguous(), v.contiguous()\n    \n    # Verify\n    q1, k1, v1 = current()\n    q2, k2, v2 = pretranspose()\n    assert (q1 - q2).abs().max() < 1e-6\n    assert (k1 - k2).abs().max() < 1e-6\n    assert (v1 - v2).abs().max() < 1e-6\n    \n    t_cur = bench(current, n=20)\n    t_pre = bench(pretranspose, n=20)\n    t_po = bench(permute_optimized, n=20)\n    print(f\"  current: {t_cur:.2f}ms, pretranspose: {t_pre:.2f}ms ({t_pre/t_cur:.3f}), perm_opt: {t_po:.2f}ms ({t_po/t_cur:.3f})\")\n\nprint(\"=== Projection layout tests ===\")\nfor B, L, C, H, D in [(1,256,1280,20,64), (1,128,1280,20,64), (1,128,640,10,64)]:\n    print(f\"B{B} L{L} C{C} H{H} D{D}:\")\n    test_proj_layouts(B, L, C, H, D)\n\n# Test: is the reshape+permute+contiguous needed, or does q@k''^T handle non-contiguous?\ndef test_noncontig_logits(B, L, C, H, D):\n    x = torch.randn(B, L, C)\n    wq = torch.randn(H, D, C)\n    wk = torch.randn(H, D, C)\n    xr = x.reshape(B*L, C)\n    \n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    \n    # With contiguous\n    def with_contig():\n        q = (xr @ wq.reshape(H*D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n        k = (xr @ wk.reshape(H*D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n        return q @ k.transpose(-1, -2) * inv_sqrt_d\n    \n    # Without contiguous\n    def without_contig():\n        q = (xr @ wq.reshape(H*D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n        k = (xr @ wk.reshape(H*D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n        return q @ k.transpose(-1, -2) * inv_sqrt_d\n    \n    r1 = with_contig()\n    r2 = without_contig()\n    print(f\"  diff: {(r1-r2).abs().max():.2e}\")\n    \n    t_wc = bench(with_contig, n=20)\n    t_woc = bench(without_contig, n=20)\n    print(f\"  with contig: {t_wc:.2f}ms, without: {t_woc:.2f}ms ({t_woc/t_wc:.3f})\")\n\nprint(\"'\"\\\\n=== Non-contiguous logits test ===\\\")\nfor B, L, C, H, D in [(1,256,1280,20,64), (1,128,640,10,64)]:\n    print(f\\\"B{B} L{L} C{C} H{H} D{D}:\\\")\n    test_noncontig_logits(B, L, C, H, D)\n\n# Test: einsum vs gemm for projection - wait we already know gemm wins\n# Test: can we use torch.addmm or similar?\n\n# Test: memory layout of softmax input - is softmax faster with contiguous last dim?\ndef test_softmax_layout(B, L, H):\n    logits_c = torch.randn(B, H, L, L).contiguous()  # last dim contiguous\n    logits_t = logits_c.transpose(-1, -2).contiguous().transpose(-1, -2)  # non-contiguous last dim\n    \n    def sm_c():\n        return logits_c.softmax(dim=-1)\n    def sm_t():\n        return logits_t.softmax(dim=-1)\n    \n    t_c = bench(sm_c, n=20)\n    t_t = bench(sm_t, n=20)\n    print(f\\\"  contiguous: {t_c:.2f}ms, non-contig: {t_t:.2f}ms ({t_t/t_c:.3f})\\\")\n\nprint(\\\"\\\\n=== Softmax layout test ===\\\")\nfor B, L, H in [(1, 256, 20), (1, 128, 10), (1, 64, 8)]:\n    print(f\\\"B{B} L{L} H{H}:\\\")\n    test_softmax_layout(B, L, H)\n\nPYEOF\npython /tmp/optimize3.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

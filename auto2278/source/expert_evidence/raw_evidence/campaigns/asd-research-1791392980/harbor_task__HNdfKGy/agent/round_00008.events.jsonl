{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/stable_bench.py << 'PYEOF'\nimport math\nimport torch\nimport time\nimport statistics\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\ndef bench_median(fn, n=25):\n    for _ in range(5):\n        fn()\n    times = []\n    for _ in range(n):\n        torch.compiler.reset() if hasattr(torch, 'compiler') else None\n        t0 = time.process_time_ns()\n        fn()\n        t1 = time.process_time_ns()\n        times.append((t1 - t0) / 1e6)\n    return statistics.median(times)\n\ndef ref_attention(x, wq, wk, wv, alpha, beta):\n    q = torch.einsum(\\\"blc,hdc->bhld\\\", x, wq)\n    k = torch.einsum(\\\"blc,hdc->bhld\\\", x, wk)\n    logits = (q @ k.transpose(-1, -2)) / math.sqrt(wq.shape[1])\n    p0 = logits.softmax(dim=-1)\n    base = p0 @ x.unsqueeze(1)\n    if alpha == 1.0:\n        modified = base\n    else:\n        perturbed = .5 * (1 + alpha) * logits + .5 * (1 - alpha) * logits.transpose(-1, -2)\n        modified = perturbed.softmax(dim=-1) @ x.unsqueeze(1)\n    blended = base + beta * (modified - base)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    y = torch.einsum(\\\"bhlc,hdc->bhld\\\", blended * ratio, wv)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n\n@torch.no_grad()\ndef v0_current(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wv.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n\n    logits = q @ k.transpose(-1, -2) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n\n        p1G = p1 @ G_exp\n        norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n\n        pmG = p_mix @ G_exp\n        normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n\n        norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n        normm = normm_sq.sqrt().clamp_min(1e-6)\n        ratio = (norm1 / normm).clamp(0.25, 4.0)\n\n        y = (p_mix @ v) * ratio\n\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n\n@torch.no_grad()\ndef v3_lean(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n\n    w_all = torch.cat([wq.reshape(HD, C), wk.reshape(HD, C), wv.reshape(HD, C)], dim=0)\n    qkv = (x.reshape(B * L, C) @ w_all.T).reshape(B, L, 3, H, D).permute(2, 0, 3, 1, 4)\n    q, k, v = qkv[0].contiguous(), qkv[1].contiguous(), qkv[2].contiguous()\n\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        sym = logits.mul(a_p)\n        sym.add_(logits.transpose(-1, -2), alpha=a_m)\n        p1 = sym.softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n\n        p1G = p1 @ G_exp\n        norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n\n        pmG = p_mix @ G_exp\n        normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n\n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = (norm1 / normm).clamp_(0.25, 4.0)\n\n        y = (p_mix @ v) * ratio\n\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n\ncases = [\n    dict(B=1, L=64, C=512, H=8, D=64, alpha=1.05, beta=5.0),\n    dict(B=1, L=128, C=640, H=10, D=64, alpha=1.1, beta=4.0),\n    dict(B=1, L=128, C=1280, H=20, D=64, alpha=1.15, beta=3.0),\n    dict(B=1, L=256, C=1280, H=20, D=64, alpha=1.05, beta=7.5),\n    dict(B=1, L=256, C=640, H=10, D=64, alpha=1.2, beta=5.0),\n    dict(B=2, L=128, C=512, H=8, D=64, alpha=1.0, beta=5.0),\n]\n\nprint(\\\"Running stable benchmarks (median of 25 after 5 warmups)...\\\")\nprint()\n\n# Interleave runs to reduce cache effects\nall_results = {}\nfor run_idx in range(3):\n    for c in cases:\n        B, L, C, H, D = c['B'], c['L'], c['C'], c['H'], c['D']\n        alpha, beta = c['alpha'], c['beta']\n        key = f\\\"B{B}L{L}C{C}H{H}\\\"\n        torch.manual_seed(42)\n        x = torch.randn(B, L, C)\n        wq = torch.randn(H, D, C)\n        wk = torch.randn(H, D, C)\n        wv = torch.randn(H, D, C)\n        \n        ref = ref_attention(x, wq, wk, wv, alpha, beta)\n        tol = 3e-5 + 3e-4 * ref.abs().max().item()\n        \n        for name, fn in [(\\\"v0\\\", v0_current), (\\\"v3\\\", v3_lean)]:\n            out = fn(x, wq, wk, wv, alpha, beta)\n            diff = (out - ref).abs().max().item()\n            assert diff <= tol, f\\\"{name} {key} diff={diff:.2e} > tol={tol:.2e}\\\"\n            \n            ms = bench_median(lambda: fn(x, wq, wk, wv, alpha, beta), n=15)\n            all_results.setdefault((key, name), []).append(ms)\n\nprint(f\\\"{'Case':20s} {'v0 (ms)':>10s} {'v3 (ms)':>10s} {'ratio':>8s}\\\")\nprint(\\\"-\\\" * 52)\ngeo = 1.0\nfor c in cases:\n    B, L, C, H, D = c['B'], c['L'], c['C'], c['H'], c['D']\n    key = f\\\"B{B}L{L}C{C}H{H}\\\"\n    v0_times = all_results[(key, \\\"v0\\\")]\n    v3_times = all_results[(key, \\\"v3\\\")]\n    v0 = statistics.median(v0_times)\n    v3 = statistics.median(v3_times)\n    ratio = v3 / v0\n    geo *= ratio\n    print(f\\\"{key:20s} {v0:10.2f} {v3:10.2f} {ratio:8.4f}\\\")\n\nprint(\\\"-\\\" * 52)\nprint(f\\\"{'Geomean':20s} {'':>10s} {'':>10s} {geo**(1/len(cases)):8.4f}\\\")\n\nPYEOF\npython /tmp/stable_bench.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/sh -lc \"cat > /workspace/solution/method.py << 'PYEOF'\n\\\"\\\"\\\"Optimized multihead retrieval kernel using fused projection and Gram-matrix norms.\\\"\\\"\\\"\nimport math\nimport torch\n\n\n@torch.no_grad()\ndef attention(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n\n    # Fuse q, k, v projections into a single GEMM\n    w_all = torch.cat([wq.reshape(HD, C), wk.reshape(HD, C), wv.reshape(HD, C)], dim=0)\n    qkv = (x.reshape(B * L, C) @ w_all.T).reshape(B, L, 3, H, D).permute(2, 0, 3, 1, 4)\n    q = qkv[0].contiguous()\n    k = qkv[1].contiguous()\n    v = qkv[2].contiguous()\n\n    logits = q @ k.transpose(-1, -2) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n\n        # Gram matrix for norm computation\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n\n        p1G = p1 @ G_exp\n        norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n\n        pmG = p_mix @ G_exp\n        normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n\n        norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n        normm = normm_sq.sqrt().clamp_min(1e-6)\n        ratio = (norm1 / normm).clamp(0.25, 4.0)\n\n        y = (p_mix @ v) * ratio\n\n    return y.transpose(1, 2).flatten(2).contiguous()\nPYEOF\npython -c \\\"\nimport torch, math\nimport sys\nsys.path.insert(0, '/workspace/solution')\nfrom method import attention\n\n# Quick correctness check\ntorch.manual_seed(0)\nB, L, C, H, D = 2, 16, 32, 4, 8\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\nout = attention(x, wq, wk, wv, 1.1, 2.0)\nprint(f'Output shape: {out.shape}')  # expected (B, L, H*D)\nassert out.shape == (B, L, H*D)\nprint('OK')\n\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

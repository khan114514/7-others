{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 << 'PYEOF'\nimport torch, time, math\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\n\ng = torch.Generator().manual_seed(17)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwv = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n\ninv_sqrt_d = 1.0 / math.sqrt(D)\n\ndef time_fn(name, fn, reps=20):\n    for _ in range(3): fn()\n    t0 = time.process_time_ns()\n    for _ in range(reps): fn()\n    ms = (time.process_time_ns() - t0) / reps / 1e6\n    print(f'{name:50s} {ms:8.2f} ms')\n    return ms\n\nwith torch.inference_mode():\n    q = (x.reshape(B*L, C) @ wq.reshape(H*D, C).T).reshape(B, L, H, D).permute(0,2,1,3)\n    k = (x.reshape(B*L, C) @ wk.reshape(H*D, C).T).reshape(B, L, H, D).permute(0,2,1,3)\n    logits = q @ k.transpose(-1,-2) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    \n    base = torch.einsum('bhjk,bkc->bhjc', p0, x)\n    \n    # Output projection alternatives\n    ratio = torch.randn(B, H, L, 1).abs() + 1\n    blended = base * ratio\n    \n    out_ein = torch.einsum('bhlc,hdc->bhld', blended, wv)\n    \n    # matmul approach: (B,H,L,C) @ (H,C,D) -> (B,H,L,D)\n    wv_t = wv.transpose(-1, -2).contiguous()  # H, C, D\n    def matmul_out():\n        return torch.matmul(blended, wv_t)\n    time_fn('matmul output proj', matmul_out)\n    out_mm = matmul_out()\n    print(f'matmul out diff: {(out_ein - out_mm).abs().max():.2e}')\n    \n    # bmm approach\n    def bmm_out():\n        bf = blended.permute(1, 0, 2, 3).reshape(H, B*L, C).contiguous()\n        return torch.bmm(bf, wv_t).reshape(H, B, L, D).permute(1, 0, 2, 3)\n    time_fn('bmm output proj', bmm_out)\n    \n    # Q projection: try keeping as (B, L, H, D) instead of (B, H, L, D)\n    # logits: q @ k.T where q is (B,H,L,D) and k.T is (B,H,D,L)\n    # If q is (B,L,H,D) and k is (B,L,H,D): \n    # logits[b,h,i,j] = sum_d q[b,h,i,d] * k[b,h,j,d]\n    # = sum_d q[b,i,h,d] * k[b,j,h,d]\n    # We can do: q.permute(0,2,1,3) @ k.permute(0,2,3,1)\n    # That's same cost\n    \n    # But: what if we compute logits differently?\n    # (x wq\"'^T) (x wk''^T)''^T / sqrt(D) = x wq''^T wk x''^T / sqrt(D)\n    # = x @ (wq''^T @ wk) @ x''^T / sqrt(D) for each head? No, per-head is different\n    # Actually per head h: A_h = x wq_h''^T wk_h x''^T / sqrt(D)\n    # where wq_h is (D, C), so wq_h''^T wk_h is (C, C)\n    # That'\"'s more expensive for large C\n    \n    # Let me time the full end-to-end with current approach\n    def current_best():\n        q = (x.reshape(B*L, C) @ wq.reshape(H*D, C).T).reshape(B, L, H, D).permute(0,2,1,3)\n        k = (x.reshape(B*L, C) @ wk.reshape(H*D, C).T).reshape(B, L, H, D).permute(0,2,1,3)\n        logits = q @ k.transpose(-1, -2) * inv_sqrt_d\n        p0 = logits.softmax(dim=-1)\n        base = torch.einsum('bhjk,bkc->bhjc', p0, x)\n        a_p = 0.5 * (1 + alpha)\n        a_m = 0.5 * (1 - alpha)\n        perturbed = a_p * logits + a_m * logits.transpose(-1, -2)\n        p1 = perturbed.softmax(dim=-1)\n        modified = torch.einsum('bhjk,bkc->bhjc', p1, x)\n        blended = base.lerp(modified, beta)\n        ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n                 / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n        y = torch.einsum('bhlc,hdc->bhld', blended * ratio, wv)\n        return y.transpose(1, 2).flatten(2).contiguous()\n    \n    alpha, beta = 1.05, 7.5\n    time_fn('FULL current best', current_best, reps=10)\n    \n    # Now with matmul output proj\n    def opt_out():\n        q = (x.reshape(B*L, C) @ wq.reshape(H*D, C).T).reshape(B, L, H, D).permute(0,2,1,3)\n        k = (x.reshape(B*L, C) @ wk.reshape(H*D, C).T).reshape(B, L, H, D).permute(0,2,1,3)\n        logits = q @ k.transpose(-1, -2) * inv_sqrt_d\n        p0 = logits.softmax(dim=-1)\n        base = torch.einsum('bhjk,bkc->bhjc', p0, x)\n        a_p = 0.5 * (1 + alpha)\n        a_m = 0.5 * (1 - alpha)\n        perturbed = a_p * logits + a_m * logits.transpose(-1, -2)\n        p1 = perturbed.softmax(dim=-1)\n        modified = torch.einsum('bhjk,bkc->bhjc', p1, x)\n        blended = base.lerp(modified, beta)\n        ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n                 / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n        y = torch.matmul(blended * ratio, wv_t)\n        return y.transpose(1, 2).flatten(2).contiguous()\n    \n    r1 = current_best()\n    r2 = opt_out()\n    print(f'full opt out diff: {(r1-r2).abs().max():.2e}')\n    time_fn('FULL with matmul out', opt_out, reps=10)\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

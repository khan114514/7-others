{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 << 'PYEOF'\nimport torch, time, math\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\n\ng = torch.Generator().manual_seed(17)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n\ninv_sqrt_d = 1.0 / math.sqrt(D)\n\ndef time_fn(name, fn, reps=20):\n    for _ in range(3): fn()\n    t0 = time.process_time_ns()\n    for _ in range(reps): fn()\n    ms = (time.process_time_ns() - t0) / reps / 1e6\n    print(f'{name:55s} {ms:8.2f} ms')\n    return ms\n\nwith torch.inference_mode():\n    q = (x.reshape(B*L, C) @ wq.reshape(H*D, C).T).reshape(B, L, H, D).permute(0,2,1,3)\n    k = (x.reshape(B*L, C) @ wk.reshape(H*D, C).T).reshape(B, L, H, D).permute(0,2,1,3)\n    logits = q @ k.transpose(-1,-2) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    \n    base = torch.einsum('bhjk,bkc->bhjc', p0, x)\n    \n    # Check contiguity\n    pf = p0.reshape(B*H*L, L)\n    print(f'p0 contiguous: {p0.is_contiguous()}')\n    print(f'p0.reshape(BHL,L) contiguous: {pf.is_contiguous()}')\n    print(f'x contiguous: {x.is_contiguous()}')\n    \n    # Try with explicit contiguous\n    def gemm_px_contig():\n        pf = p0.reshape(B*H*L, L).contiguous()\n        xf = x.reshape(L, C).contiguous()\n        return (pf @ xf).reshape(B, H, L, C)\n    time_fn('gemm px (contiguous p)', gemm_px_contig)\n    \n    # What if we compute p0 in a different layout?\n    # Instead of (B,H,L,L), compute as (B,L,H,L) or reshape before softmax\n    # Wait, actually the problem is memory layout. softmax along last dim means last dim is L\n    # p is (B,H,L_q,L_k). For p@x along k (the last dim):\n    #   result[b,h,j,c] = sum_k p[b,h,j,k] * x[b,k,c]\n    # For efficiency, we want k to be the fast-moving dim in p and first dim in x? \n    # Actually for matmul: (M, K) @ (K, N) needs K as last dim of first, first dim of second\n    # p is (B,H,L_q,L_k) - L_k is last dim -> good for (M, K) @ (K, N) if K = L_k\n    \n    # Let's try: permute p0 to have shape where we can do efficient batch matmul\n    # p0: (B,H,Lq,Lk) -> treat as (B, H*Lq, Lk)\n    # x: (B, Lk, C) \n    # bmm: (B, H*Lq, Lk) @ (B, Lk, C) -> (B, H*Lq, C)\n    def bmm_px_2():\n        pf = p0.reshape(B, H*L, L)  # (B, H*L, L)\n        xf = x  # (B, L, C)\n        return torch.bmm(pf, xf).reshape(B, H, L, C)\n    time_fn('bmm (B, H*L, L) @ (B, L, C)', bmm_px_2)\n    \n    # Check if reshape creates a view vs copy\n    p_reshaped = p0.reshape(B, H*L, L)\n    print(f'p0.reshape(B, H*L, L) contiguous: {p_reshaped.is_contiguous()}')\n    print(f'p0 strides: {p0.stride()}')\n    print(f'p0.reshape strides: {p_reshaped.stride()}')\n    \n    # Try with transposed layout\n    # p0_t = p0.permute(0, 2, 1, 3) -> (B, Lq, H, Lk) -> reshape (B, Lq, H*Lk)? No...\n    # Actually we want sum over L_k. Let me try different orderings\n    \n    # What if we think of it as: for each token position, weight x by attention\n    # x is (B, L, C), p is (B, H, L, L)\n    # Another approach: x.unsqueeze(1) (B,1,L,C) * p.unsqueeze(-1) (B,H,L,L,1)\n    # No that's worse\n    \n    # Let me try: what if we compute attention in a single efficient pass?\n    # Actually the einsum is already pretty good. Let me check the full profile breakdown\n    print()\n    print('=== Full breakdown ===')\n    time_fn('q projection (einsum)', lambda: torch.einsum('blc,hdc->bhld', x, wq))\n    time_fn('q projection (gemm)', lambda: (x.reshape(B*L, C) @ wq.reshape(H*D, C).T).reshape(B, L, H, D).permute(0,2,1,3))\n    time_fn('qk\"'^T + scale'\"', lambda: q @ k.transpose(-1,-2) * inv_sqrt_d)\n    time_fn('softmax', lambda: logits.softmax(dim=-1))\n    time_fn('p@x (einsum)', lambda: torch.einsum('bhjk,bkc->bhjc', p0, x))\n    \n    # Two p@x calls is the biggest cost. What if we can fuse them?\n    # We need p0@x and p1@x. Both same x, different p.\n    # Stack p0 and p1: (B, 2*H, L, L) -> single einsum\n    # Would save some overhead\n    \n    # Output projection\n    ratio = torch.ones(B, H, L, 1)\n    blended = base * ratio\n    wv_t = wv.transpose(-1, -2).contiguous()\n    time_fn('output proj (einsum)', lambda: torch.einsum('bhlc,hdc->bhld', blended, wv))\n    time_fn('output proj (matmul)', lambda: torch.matmul(blended, wv_t))\n    \n    # Can we also compute q,k projections as a single matmul?\n    # [wq; wk] stacked as (2*H, D, C) -> reshape (2*H*D, C)\n    wqk = torch.cat([wq, wk], dim=0)  # (2H, D, C)\n    time_fn('q+k projection (gemm stacked)', lambda: (x.reshape(B*L, C) @ wqk.reshape(2*H*D, C).T))\n    # Then split\n    def gemm_qk():\n        out = (x.reshape(B*L, C) @ wqk.reshape(2*H*D, C).T).reshape(B, L, 2*H, D).permute(0,2,1,3)\n        return out[:, :H], out[:, H:]\n    time_fn('q+k stacked (with split)', gemm_qk)\n    q2, k2 = gemm_qk()\n    print(f'q stacked diff: {(q2-q).abs().max():.2e}')\n    print(f'k stacked diff: {(k2-k).abs().max():.2e}')\n    \nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

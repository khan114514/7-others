{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/sh -lc \"cat > /workspace/solution/method.py << 'EOF'\n\\\"\\\"\\\"Optimized multihead retrieval kernel using v-first ordering and Gram-matrix norms.\\\"\\\"\\\"\nimport math\nimport torch\n\n\n@torch.no_grad()\ndef attention(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n\n    xr = x.reshape(B * L, C)\n    wqr = wq.reshape(H * D, C)\n    wkr = wk.reshape(H * D, C)\n    wvr = wv.reshape(H * D, C)\n\n    q = (xr @ wqr.T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wkr.T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wvr.T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n\n    logits = q @ k.transpose(-1, -2) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n\n        G = x @ x.transpose(-1, -2).unsqueeze(0) if B == 1 else x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n\n        p1G = p1 @ G_exp\n        norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n\n        pmG = p_mix @ G_exp\n        normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n\n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = (norm1 / normm).clamp_(0.25, 4.0)\n\n        y = (p_mix @ v) * ratio\n\n    return y.transpose(1, 2).flatten(2).contiguous()\nEOF\necho \\\"Written\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

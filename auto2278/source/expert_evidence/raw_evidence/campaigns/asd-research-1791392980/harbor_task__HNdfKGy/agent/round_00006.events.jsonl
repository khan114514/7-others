{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 << 'PYEOF'\nimport torch, time, math\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\n\ng = torch.Generator().manual_seed(17)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwv = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n\ninv_sqrt_d = 1.0 / math.sqrt(D)\n\ndef time_fn(name, fn, reps=10):\n    for _ in range(3): fn()\n    t0 = time.process_time_ns()\n    for _ in range(reps): fn()\n    ms = (time.process_time_ns() - t0) / reps / 1e6\n    print(f'{name:55s} {ms:8.2f} ms')\n    return ms\n\nwith torch.inference_mode():\n    q = (x.reshape(B*L, C) @ wq.reshape(H*D, C).T).reshape(B, L, H, D).permute(0,2,1,3)\n    k = (x.reshape(B*L, C) @ wk.reshape(H*D, C).T).reshape(B, L, H, D).permute(0,2,1,3)\n    logits = q @ k.transpose(-1,-2) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    \n    a_p = 0.5 * (1 + alpha)\n    a_m = 0.5 * (1 - alpha)\n    perturbed = a_p * logits + a_m * logits.transpose(-1, -2)\n    p1 = perturbed.softmax(dim=-1)\n    \n    # Reference: full p@x\n    u0 = torch.einsum('bhjk,bkc->bhjc', p0, x)  # (B,H,L,C)\n    u1 = torch.einsum('bhjk,bkc->bhjc', p1, x)  # (B,H,L,C)\n    \n    norm0_ref = u0.norm(dim=-1)  # (B,H,L)\n    norm1_ref = u1.norm(dim=-1)\n    m = u0 + beta * (u1 - u0)\n    norm_m_ref = m.norm(dim=-1)\n    dot_ref = (u0 * u1).sum(dim=-1)\n    \n    # Gram matrix approach\n    G = x @ x.transpose(-1, -2)  # (B, L, L)\n    print(f'G shape: {G.shape}')\n    \n    # p0 @ G: (B,H,L,L) @ (B,L,L) -> we need batch matmul\n    # p0: (B,H,L,L), G: (B,L,L)\n    # tmp0 = p0 @ G.unsqueeze(1) ? \n    # matmul broadcast: (B,H,L,L) @ (B,1,L,L) -> (B,H,L,L)\n    tmp0 = p0 @ G.unsqueeze(1)  # (B,H,L,L)\n    norm_sq0 = (tmp0 * p0).sum(dim=-1)  # (B,H,L)\n    norm0_g = norm_sq0.sqrt()\n    \n    print(f'norm0 diff: {(norm0_g - norm0_ref).abs().max():.2e}')\n    \n    # p1\n    tmp1 = p1 @ G.unsqueeze(1)\n    norm_sq1 = (tmp1 * p1).sum(dim=-1)\n    norm1_g = norm_sq1.sqrt()\n    print(f'norm1 diff: {(norm1_g - norm1_ref).abs().max():.2e}')\n    \n    # cross dot: p0 @ G @ p1\"'^T per row\n    cross = (tmp0 * p1).sum(dim=-1)  # (B,H,L)\n    print(f'\"'cross diff: {(cross - dot_ref).abs().max():.2e}')\n    \n    # m norm: ||(1-b)u0 + b u1||\"'^2 = (1-b)''^2 n0''^2 + b''^2 n1''^2 + 2(1-b)b dot\n    norm_m_sq_g = (1-beta)**2 * norm_sq0 + beta**2 * norm_sq1 + 2*(1-beta)*beta * cross\n    norm_m_g = norm_m_sq_g.sqrt()\n    print(f'\"'norm_m diff: {(norm_m_g - norm_m_ref).abs().max():.2e}')\n    \n    # Check ratio\n    ratio_ref = (norm1_ref.clamp_min(1e-6) / norm_m_ref.clamp_min(1e-6)).clamp(.25, 4.)\n    ratio_g = (norm1_g.clamp_min(1e-6) / norm_m_g.clamp_min(1e-6)).clamp(.25, 4.)\n    print(f'ratio diff: {(ratio_g.unsqueeze(-1) - (u1.norm(dim=-1, keepdim=True).clamp_min(1e-6)/m.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25,4.)).abs().max():.2e}')\n    \n    # Time the gram approach\n    def gram_norms():\n        G = x @ x.transpose(-1, -2)\n        tmp0 = p0 @ G.unsqueeze(1)\n        tmp1 = p1 @ G.unsqueeze(1)\n        n0_sq = (tmp0 * p0).sum(dim=-1)\n        n1_sq = (tmp1 * p1).sum(dim=-1)\n        cross = (tmp0 * p1).sum(dim=-1)\n        nm_sq = (1-beta)**2 * n0_sq + beta**2 * n1_sq + 2*(1-beta)*beta * cross\n        n0 = n0_sq.sqrt()\n        n1 = n1_sq.sqrt()\n        nm = nm_sq.sqrt()\n        return n0, n1, nm\n    \n    time_fn('gram matrix norms', gram_norms)\n    \n    # Time original p@x + norms\n    def orig_norms():\n        u0 = torch.einsum('bhjk,bkc->bhjc', p0, x)\n        u1 = torch.einsum('bhjk,bkc->bhjc', p1, x)\n        n0 = u0.norm(dim=-1)\n        n1 = u1.norm(dim=-1)\n        m = u0.lerp(u1, beta)\n        nm = m.norm(dim=-1)\n        return n0, n1, nm\n    \n    time_fn('original p@x + norms', orig_norms)\n\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

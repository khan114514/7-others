{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 << 'PYEOF'\nimport torch, time, math\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\n\ng = torch.Generator().manual_seed(17)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n\ninv_sqrt_d = 1.0 / math.sqrt(D)\n\ndef time_fn(name, fn, reps=20):\n    for _ in range(3): fn()\n    t0 = time.process_time_ns()\n    for _ in range(reps): fn()\n    ms = (time.process_time_ns() - t0) / reps / 1e6\n    print(f'{name:55s} {ms:8.2f} ms')\n    return ms\n\nwith torch.inference_mode():\n    q = (x.reshape(B*L, C) @ wq.reshape(H*D, C).T).reshape(B, L, H, D).permute(0,2,1,3)\n    k = (x.reshape(B*L, C) @ wk.reshape(H*D, C).T).reshape(B, L, H, D).permute(0,2,1,3)\n    logits = q @ k.transpose(-1,-2) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)  # (B, H, L, L)\n    \n    base = torch.einsum('bhjk,bkc->bhjc', p0, x)  # (B, H, L, C)\n    print(f'base shape: {base.shape}')\n    \n    # p@x analysis:\n    # p is (B,H,L,L), x is (B,L,C) -> (B,H,L,C)\n    # Each head multiplies (L,L) @ (L,C) = (L,C). H heads.\n    # Total FLOPS: H * B * L * L * C = 20 * 1 * 256 * 256 * 1280 = 1.68 GFLOP\n    # 57ms -> ~29 GFLOP/s ? That seems high for single thread...\n    # Actually it's BH * L\"'^2 * C = 20 * 256''^2 * 1280 = 1.68G \n    # 57ms for that is ~29 GFLOP/s which doesn'\"'t make sense for single-thread CPU\n    # Wait - einsum might be doing a different contraction order\n    \n    # Wait let me re-check the shapes\n    print(f'p0 shape: {p0.shape}')  # (1,20,256,256)\n    print(f'x shape: {x.shape}')    # (1,256,1280)\n    # bhjk,bkc -> bhjc\n    # dim sizes: b=1, h=20, j=256, k=256, c=1280\n    # Optimal path: probably first contract j&k or b? No, j is in output\n    # einsum contracts k: sum_k p[b,h,j,k] * x[b,k,c]\n    # For each b,h,j,c: sum over k of p_val * x_val\n    # That's B*H*L*C*L = 1*20*256*1280*256 = 1.68G FLOPs\n    # 57ms -> 29.5 GFLOP/s for single-thread? That seems fast for SGEMM \n    # But wait, MKL sgemm on a modern core can do ~20-30 GFLOP/s\n    # The question is whether einsum dispatches to GEMM efficiently\n    \n    # Let me try: reshape p to (B*H*L, L) and x is (L, C) -> single GEMM\n    # (B*H*L, L) @ (L, C) = (B*H*L, C)\n    def gemm_px():\n        pf = p0.reshape(B*H*L, L)\n        return (pf @ x.reshape(L, C)).reshape(B, H, L, C)\n    time_fn('gemm p@x: (BHL, L) @ (L, C)', gemm_px)\n    r = gemm_px()\n    print(f'gemm px diff: {(r - base).abs().max():.2e}')\n    \n    # Wait that's brilliant\"'! p0 @ x along the k dimension\n    # p is (B,H,L,L), x is (B,L,C)\n    # But wait, b also needs to match. For B=1 it'\"'s same, but B>1...\n    # For B>1: p (B, H, L, L), x (B, L, C)\n    # We need per-batch: p[b] @ x[b] for each head\n    # (H, L, L) @ (L, C) -> (H, L, C) per batch\n    # Using bmm: (B*H, L, L) @ (B, L, C) - no, bmm needs matching batch dims\n    # We'd need to expand x to (B*H, L, C)\n    \n    # Wait, actually: (B*H, L, L) bmm (B*H, L, C) requires x expansion\n    # But (B*H*L, L) @ (L, C) only works if all batches share same x\n    # For B>1, we need to handle batches separately\n    # (B, H*L, L) @ (B, L, C) - batch matmul\"'!\n    # p reshaped (B, H*L, L), x (B, L, C) -> (B, H*L, C) -> reshape (B, H, L, C)\n    def batch_px():\n        pf = p0.reshape(B, H*L, L)\n        return torch.bmm(pf, x).reshape(B, H, L, C)\n    time_fn('\"'bmm p@x: (B, H*L, L) @ (B, L, C)', batch_px)\n    r = batch_px()\n    print(f'bmm px diff: {(r - base).abs().max():.2e}')\n    \n    # That should be MUCH better\"'! bmm with batch=B, (H*L, L) @ (L, C)\n    # For B=1, H*L=20*256=5120: (5120, 256) @ (256, 1280) = single big GEMM\n    # That'\"'s way more efficient than 20 separate small ones through einsum\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\ntorch.set_num_threads(1)\n\n# Case 3: large one  batch=1, length=256, channels=1280, heads=20, dim=64\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\n\ng = torch.Generator().manual_seed(17)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwv = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n\ninv_sqrt_d = 1.0 / math.sqrt(D)\n\ndef time_fn(name, fn, reps=20):\n    for _ in range(3): fn()\n    t0 = time.process_time_ns()\n    for _ in range(reps): fn()\n    ms = (time.process_time_ns() - t0) / reps / 1e6\n    print(f'{name:45s} {ms:8.2f} ms')\n    return ms\n\n# Profile each step\nwith torch.inference_mode():\n    # q projection\n    time_fn('einsum q', lambda: torch.einsum('blc,hdc->bhld', x, wq))\n    \n    q = torch.einsum('blc,hdc->bhld', x, wq)\n    k = torch.einsum('blc,hdc->bhld', x, wk)\n    \n    # gemm-based q\n    def gemm_q():\n        return (x.reshape(B*L, C) @ wq.reshape(H*D, C).T).reshape(B, L, H, D).permute(0,2,1,3)\n    time_fn('gemm q (reshape+mm+permute)', gemm_q)\n    \n    # check correctness\n    r1 = torch.einsum('blc,hdc->bhld', x, wq)\n    r2 = gemm_q()\n    print(f'q diff: {(r1-r2).abs().max():.2e}')\n    \n    # logits\n    time_fn('q @ k.T', lambda: q @ k.transpose(-1,-2) * inv_sqrt_d)\n    logits = q @ k.transpose(-1,-2) * inv_sqrt_d\n    \n    # softmax\n    time_fn('softmax', lambda: logits.softmax(dim=-1))\n    p0 = logits.softmax(dim=-1)\n    \n    # p @ x\n    time_fn('einsum p@x', lambda: torch.einsum('bhjk,bkc->bhjc', p0, x))\n    \n    # matmul broadcast\n    time_fn('p @ x.unsqueeze(1)', lambda: p0 @ x.unsqueeze(1))\n    \n    # bmm version\n    def bmm_px():\n        pf = p0.reshape(B*H, L, L)\n        xf = x.unsqueeze(1).expand(B, H, L, C).reshape(B*H, L, C)\n        return torch.bmm(pf, xf).reshape(B, H, L, C)\n    time_fn('bmm p@x (expand)', bmm_px)\n    \n    # check\n    ref = torch.einsum('bhjk,bkc->bhjc', p0, x)\n    r2 = p0 @ x.unsqueeze(1)\n    r3 = bmm_px()\n    print(f'matmul diff: {(ref-r2).abs().max():.2e}')\n    print(f'bmm diff: {(ref-r3).abs().max():.2e}')\n    \n    # output projection\n    base = ref\n    ratio = torch.randn(B, H, L, 1).abs() + 1\n    time_fn('einsum output proj', lambda: torch.einsum('bhlc,hdc->bhld', base * ratio, wv))\n    \n    def gemm_out():\n        br = (base * ratio).permute(0, 2, 1, 3).reshape(B*L, H*C)\n        return (br @ wv.reshape(H*D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    time_fn('gemm output proj', gemm_out)\n    \n    ref_out = torch.einsum('bhlc,hdc->bhld', base * ratio, wv)\n    r_out = gemm_out()\n    print(f'out proj diff: {(ref_out-r_out).abs().max():.2e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 << 'PYEOF'\nimport torch, math, json\ntorch.set_num_threads(1)\n\nwith open('/workspace/environment/public_assets/dev/protocol.json') as f:\n    proto = json.load(f)\n\ndef oracle(x, wq, wk, wv, alpha, beta):\n    q = torch.einsum(\\\"blc,hdc->bhld\\\", x, wq)\n    k = torch.einsum(\\\"blc,hdc->bhld\\\", x, wk)\n    logits = q @ k.transpose(-1, -2) / math.sqrt(wq.shape[1])\n    p0 = logits.softmax(-1)\n    p1 = (.5 * (1 + alpha) * logits + .5 * (1 - alpha) * logits.transpose(-1, -2)).softmax(-1)\n    base, modified = p0 @ x.unsqueeze(1), p1 @ x.unsqueeze(1)\n    mix = base + beta * (modified - base)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / mix.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    return torch.einsum(\\\"bhlc,hdc->bhld\\\", mix * ratio, wv).transpose(1, 2).flatten(2).contiguous()\n\n@torch.no_grad()\ndef attention(x, wq, wk, wv, alpha, beta):\n    D = wq.shape[1]\n    H = wq.shape[0]\n    B = x.shape[0]\n    L = x.shape[1]\n    C = x.shape[2]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    \n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wv.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    \n    logits = q @ k.transpose(-1, -2) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    \n    if alpha == 1.0:\n        p_mix = p0\n        ratio = 1.0\n    else:\n        a_p = 0.5 * (1 + alpha)\n        a_m = 0.5 * (1 - alpha)\n        p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        \n        # Gram matrix for norms\n        G = x @ x.transpose(-1, -2)  # (B, L, L)\n        G_exp = G.unsqueeze(1)  # (B, 1, L, L)\n        \n        # ||u1||\"'^2 per row\n        p1G = p1 @ G_exp\n        norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n        \n        # ||m||''^2 per row\n        pmG = p_mix @ G_exp\n        normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n        \n        norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n        normm = normm_sq.sqrt().clamp_min(1e-6)\n        ratio = (norm1 / normm).clamp(.25, 4.)\n    \n    out_pre = p_mix @ v  # (B,H,L,D)\n    y = out_pre * ratio\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Test all cases\nall_pass = True\nfor seed in [17, 29, 43, 71, 101]:\n    for i, case in enumerate(proto['\"'cases']):\n        g = torch.Generator().manual_seed(seed * 1000 + i)\n        B, L, C, H, D = case['batch'], case['length'], case['channels'], case['heads'], case['dim']\n        x = torch.randn(B, L, C, generator=g) * case.get('input_scale', 1.)\n        wq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n        wk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n        wv = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n        alpha, beta = case['alpha'], case['beta']\n        \n        ref = oracle(x, wq, wk, wv, alpha, beta)\n        out = attention(x, wq, wk, wv, alpha, beta)\n        \n        diff = (out - ref).abs()\n        tol = 3e-5 + 3e-4 * ref.abs()\n        ok = (diff <= tol).all().item()\n        max_abs = diff.max().item()\n        max_rel = (diff / ref.abs().clamp_min(1e-8)).max().item()\n        \n        if not ok:\n            print(f'SEED {seed} CASE {i} (B={B},L={L},C={C},H={H},D={D},a={alpha},b={beta}): FAIL max_abs={max_abs:.2e} max_rel={max_rel:.2e}')\n            all_pass = False\n        else:\n            print(f'SEED {seed} CASE {i} (B={B},L={L},C={C},H={H}): OK max_abs={max_abs:.2e}')\n\nprint(f'\\\\nAll pass: {all_pass}')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

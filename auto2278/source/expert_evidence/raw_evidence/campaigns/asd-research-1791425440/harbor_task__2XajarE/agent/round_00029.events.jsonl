 stacked (with cat): 50.205 ms\nApproach qk stacked (pre-cat): 41.348 ms (vs 2*19 = 38ms for two separate)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_75","type":"command_execution","command":"/bin/sh -lc \"python << 'PYEOF'\nimport torch, time, math\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n# Test various tensor sizes for matmul throughput\nimport statistics\n\ndef bench_matmul(m, k, n, n_iter=20):\n    a = torch.randn(m, k)\n    b = torch.randn(k, n)\n    for _ in range(3):\n        a @ b\n    times = []\n    for _ in range(n_iter):\n        t0 = time.process_time_ns()\n        c = a @ b\n        times.append((time.process_time_ns() - t0) / 1e6)\n    times.sort()\n    median = times[n_iter//2]\n    gflops = (2 * m * k * n) / (median * 1e-3) / 1e9\n    return median, gflops\n\n# Projection sizes for each case\ncases = [\n    (\\\"case0_proj\\\", 64, 512, 512),    # BL=64, C=512, HD=512\n    (\\\"case1_proj\\\", 128, 640, 640),   # BL=128, C=640, HD=640\n    (\\\"case2_proj\\\", 128, 1280, 1280), # BL=128, C=1280, HD=1280\n    (\\\"case3_proj\\\", 256, 1280, 1280), # BL=256, C=1280, HD=1280\n    (\\\"case4_proj\\\", 256, 640, 640),   # BL=256, C=640, HD=640\n    (\\\"case5_proj\\\", 256, 512, 512),   # BL=256, C=512, HD=512\n]\n\nfor name, m, k, n in cases:\n    ms, gflops = bench_matmul(m, k, n)\n    print(f'{name} ({m}x{k}x{n}): {ms:.3f}ms, {gflops:.1f} GFLOPS')\n\n# p@G sizes (L x L @ L x L, with BH in batch)\nprint()\nfor name, bh, l in [\n    (\\\"case3_pG\\\", 20, 256),\n    (\\\"case4_pG\\\", 10, 256),\n    (\\\"case2_pG\\\", 20, 128),\n]:\n    a = torch.randn(bh, l, l)\n    b = torch.randn(bh, l, l)\n    for _ in range(3):\n        torch.bmm(a, b)\n    times = []\n    for _ in range(20):\n        t0 = time.process_time_ns()\n        torch.bmm(a, b)\n        times.append((time.process_time_ns() - t0) / 1e6)\n    times.sort()\n    median = times[10]\n    gflops = (2 * bh * l * l * l) / (median * 1e-3) / 1e9\n    print(f'{name} (bmm {bh}x{l}x{l}): {median:.3f}ms, {gflops:.1f} GFLOPS')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

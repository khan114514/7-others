{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/sh -lc \"python << 'EOF'\nimport torch, time, math\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\ninv_sqrt_d = 1.0 / math.sqrt(D)\nHD = H * D\nBHL = B * H * L\nxr = x.reshape(B * L, C)\n\ndef bench(name, fn, n=5):\n    fn()  # warmup\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    print(f'{name}: {(t1-t0)/n/1e6:.2f} ms')\n\n# q, k, v projections\nwq_flat = wq.reshape(HD, C)\nwk_flat = wk.reshape(HD, C)\nwv_flat = wv.reshape(HD, C)\n\ndef proj_q():\n    q = (xr @ wq_flat.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    return q\n\nq = proj_q()\nk = proj_q()  # just for shape reference\nbench('q proj + permute', proj_q)\n\n# stacked projection\nw_all = torch.cat([wq_flat, wk_flat, wv_flat], dim=0)\ndef proj_all_stacked():\n    out = xr @ w_all.T\n    q, k, v = out.split([HD, HD, HD], dim=1)\n    q = q.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = k.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = v.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    return q, k, v\n\nbench('qkv stacked + permutes', proj_all_stacked)\n\nq, k, v = proj_all_stacked()\n\n# logits\ndef compute_logits():\n    return (q @ k.transpose(-1, -2)).mul(inv_sqrt_d)\n\nlogits = compute_logits()\nbench('logits (qk\"'^T * scale)'\"', compute_logits)\n\n# softmax p0\ndef softmax_p0():\n    return logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n\np0 = softmax_p0()\nbench('p0 softmax', softmax_p0)\n\n# p1 logits + softmax\na_p = 0.5 * (1.0 + alpha)\na_m = 0.5 * (1.0 - alpha)\ndef p1_softmax():\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    return p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n\np1 = p1_softmax()\nbench('p1 logits + softmax', p1_softmax)\n\n# p_mix\ndef pmix():\n    return torch.lerp(p0, p1, beta)\n\np_mix = pmix()\nbench('p_mix (lerp)', pmix)\n\n# G = x @ x\"'^T\ndef compute_G():\n    return x @ x.transpose(-1, -2)\n\nG = compute_G()\nbench('\"'G = xx\"'^T'\"', compute_G)\nG_exp = G.unsqueeze(1)\n\n# p1 @ G\ndef p1G_mm():\n    return p1 @ G_exp\n\np1G = p1G_mm()\nbench('p1 @ G', p1G_mm)\n\n# norm1_sq = (p1G * p1).sum(-1)\ndef norm1_from_p1G():\n    return p1G.mul(p1).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n\nbench('norm1 from p1G (mul+sum+sqrt)', norm1_from_p1G)\n\n# p_mix @ G\ndef pmG_mm():\n    return p_mix @ G_exp\n\npmG = pmG_mm()\nbench('p_mix @ G', pmG_mm)\n\n# normm + ratio\ndef ratio_from_pmG():\n    normm_sq = pmG.mul(p_mix).sum(dim=-1, keepdim=True)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    norm1 = p1G.mul(p1).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    return norm1.div(normm).clamp_(0.25, 4.0)\n\nratio = ratio_from_pmG()\nbench('normm + ratio', ratio_from_pmG)\n\n# p_mix @ v\ndef pmv():\n    return p_mix @ v\n\nbench('p_mix @ v', pmv)\n\n# final: y * ratio, transpose, flatten\ny = pmv()\ndef finalize():\n    return (y * ratio).transpose(1, 2).flatten(2).contiguous()\n\nbench('finalize (mul+transpose+flatten)', finalize)\n\nprint(f'\\\\n--- Total estimated: sum of individual ops ---')\nEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

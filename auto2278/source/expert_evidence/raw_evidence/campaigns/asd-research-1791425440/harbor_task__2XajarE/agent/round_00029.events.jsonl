{"type":"item.started","item":{"id":"item_79","type":"command_execution","command":"/bin/sh -lc \"python << 'PYEOF'\nimport torch, time, math\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n# Let me try a completely different approach: compute the output in a different order\n# to reduce memory movement and improve cache reuse.\n\n# Current order: q, k, v projections → logits → p0 → p1 → p_mix → G → p1G → pmG → y\n# The projections read x 3 times. G reads x 2 times. Total x reads: 5.\n\n# If we compute G first (reads x twice), then projections (reads x 3 times), that's still 5 reads.\n# But maybe having x in L2 cache for the projections helps?\n\n# Actually, let me think about this differently.\n# The projection matmuls are (BL, C) @ (C, HD). \n# This is BL rows of C elements, multiplied by HD columns of C elements.\n# Output is BL * HD elements.\n\n# For case 3: BL=256, C=1280, HD=1280\n# Output: 256 * 1280 * 4 = 1.3 MB. Easy to fit in cache.\n# But the weight matrix is C*HD = 1280*1280*4 = 6.5 MB. \n# x input: BL*C = 256*1280*4 = 1.3 MB.\n\n# 3 projections: 3 weight matrices of 6.5MB each = 19.5MB. \n# L3 cache on this machine might be ~20-30MB, so this might spill.\n\n# If we stacked the weights: 19.5MB as one big matrix. Same total memory.\n# But the matmul would have better cache reuse because x is read once instead of 3 times.\n\n# Wait, the stacked approach IS one big matmul. Let me verify it's faster.\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nHD = H * D\nBL = B * L\n\ntorch.manual_seed(42)\nxr = torch.randn(BL, C) / math.sqrt(C)\nw1 = torch.randn(HD, C)\nw2 = torch.randn(HD, C)\nw3 = torch.randn(HD, C)\n\n# 3 separate matmuls\ndef three_matmuls():\n    a = xr @ w1.T\n    b = xr @ w2.T\n    c = xr @ w3.T\n    return a, b, c\n\n# Stacked\nw_all = torch.cat([w1, w2, w3], dim=0)\ndef stacked_matmul():\n    out = xr @ w_all.T\n    return out.split(HD, dim=1)\n\nfor _ in range(5):\n    three_matmuls()\n    stacked_matmul()\n\nn = 20\nt3 = []\nfor _ in range(n):\n    t0 = time.process_time_ns()\n    three_matmuls()\n    t3.append((time.process_time_ns() - t0) / 1e6)\nt3.sort()\nprint(f'3 separate matmuls: {t3[n//2]:.3f} ms')\n\nts = []\nfor _ in range(n):\n    t0 = time.process_time_ns()\n    stacked_matmul()\n    ts.append((time.process_time_ns() - t0) / 1e6)\nts.sort()\nprint(f'stacked (pre-cat): {ts[n//2]:.3f} ms')\n\n# Including cat time\ndef stacked_with_cat():\n    w = torch.cat([w1, w2, w3], dim=0)\n    out = xr @ w.T\n    return out.split(HD, dim=1)\n\ntc = []\nfor _ in range(n):\n    t0 = time.process_time_ns()\n    stacked_with_cat()\n    tc.append((time.process_time_ns() - t0) / 1e6)\ntc.sort()\nprint(f'stacked (with cat): {tc[n//2]:.3f} ms')\n\n# What about 2 stacked (q+k) + 1 separate (v)?\nw_qk = torch.cat([w1, w2], dim=0)\ndef two_plus_one():\n    qk = xr @ w_qk.T\n    v = xr @ w3.T\n    return qk.split(HD, dim=1), v\n\nt21 = []\nfor _ in range(n):\n    t0 = time.process_time_ns()\n    two_plus_one()\n    t21.append((time.process_time_ns() - t0) / 1e6)\nt21.sort()\nprint(f'2 stacked + 1 separate (pre-cat): {t21[n//2]:.3f} ms')\n\n# With cat:\ndef two_plus_one_cat():\n    w = torch.cat([w1, w2], dim=0)\n    qk = xr @ w.T\n    v = xr @ w3.T\n    return qk.split(HD, dim=1), v\n\nt21c = []\nfor _ in range(n):\n    t0 = time.process_time_ns()\n    two_plus_one_cat()\n    t21c.append((time.process_time_ns() - t0) / 1e6)\nt21c.sort()\nprint(f'2 stacked + 1 separate (with cat): {t21c[n//2]:.3f} ms')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

+ 16 = 119ms (but order-dependent)\n# 2 combined+1: ?\n# Let me check total\nprint()\nprint('Compare totals:')\nfor trial in range(3):\n    xr2 = xr.clone()\n    wa = w1.clone()\n    wb = w2.clone()\n    wc = w3.clone()\n    \n    t0 = time.process_time_ns()\n    q = xr2 @ wa.T\n    k = xr2 @ wb.T\n    v = xr2 @ wc.T\n    t1 = time.process_time_ns()\n    print(f'Trial {trial} 3-separate: {(t1-t0)/1e6:.2f}ms')\n    \n    xr3 = xr.clone()\n    wa2 = w1.clone()\n    wb2 = w2.clone()\n    wc2 = wc.clone()\n    \n    t0 = time.process_time_ns()\n    wqk2 = torch.cat([wa2, wb2], dim=0)\n    qk = xr3 @ wqk2.T\n    q2, k2 = qk.split(HD, dim=1)\n    v2 = xr3 @ wc2.T\n    t1 = time.process_time_ns()\n    print(f'Trial {trial} 2+1: {(t1-t0)/1e6:.2f}ms')\nPYEOF\n\"","aggregated_output":"Trial 0: q=82.05ms k=42.26ms v=51.00ms\nTrial 1: q=18.09ms k=14.55ms v=14.54ms\nTrial 2: q=13.98ms k=14.10ms v=13.93ms\n\nTrial 0: q+k_combined=35.84ms v=10.95ms total=46.80ms\nTrial 1: q+k_combined=42.51ms v=36.92ms total=79.43ms\nTrial 2: q+k_combined=26.98ms v=11.49ms total=38.47ms\n\nCompare totals:\nTrial 0 3-separate: 70.47ms\nTrial 0 2+1: 132.10ms\nTrial 1 3-separate: 79.17ms\nTrial 1 2+1: 70.41ms\nTrial 2 3-separate: 125.19ms\nTrial 2 2+1: 44.73ms\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_91","type":"command_execution","command":"/bin/sh -lc \"python << 'PYEOF'\nimport torch, time, math, statistics\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nHD = H * D\nBL = B * L\n\ntorch.manual_seed(42)\nxr = torch.randn(BL, C) / math.sqrt(C)\nw1 = torch.randn(HD, C)\nw2 = torch.randn(HD, C)\nw3 = torch.randn(HD, C)\n\ndef three_separate():\n    q = xr @ w1.T\n    k = xr @ w2.T\n    v = xr @ w3.T\n    return q, k, v\n\ndef two_plus_one():\n    wqk = torch.cat([w1, w2], dim=0)\n    qk = xr @ wqk.T\n    q, k = qk.split(HD, dim=1)\n    v = xr @ w3.T\n    return q, k, v\n\n# Warmup\nfor _ in range(5):\n    three_separate()\n    two_plus_one()\n\nn = 30\ntimes_3 = []\ntimes_21 = []\nfor i in range(n):\n    if i % 2 == 0:\n        t0 = time.process_time_ns()\n        three_separate()\n        times_3.append((time.process_time_ns() - t0) / 1e6)\n        t0 = time.process_time_ns()\n        two_plus_one()\n        times_21.append((time.process_time_ns() - t0) / 1e6)\n    else:\n        t0 = time.process_time_ns()\n        two_plus_one()\n        times_21.append((time.process_time_ns() - t0) / 1e6)\n        t0 = time.process_time_ns()\n        three_separate()\n        times_3.append((time.process_time_ns() - t0) / 1e6)\n\ntimes_3.sort()\ntimes_21.sort()\nprint(f'3 separate: median={times_3[n//2]:.2f}ms mean={statistics.mean(times_3):.2f}ms')\nprint(f'2+1 stacked: median={times_21[n//2]:.2f}ms mean={statistics.mean(times_21):.2f}ms')\nprint(f'Ratio: {times_21[n//2]/times_3[n//2]:.3f}')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_91","type":"command_execution","command":"/bin/sh -lc \"python << 'PYEOF'\nimport torch, time, math, statistics\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nHD = H * D\nBL = B * L\n\ntorch.manual_seed(42)\nxr = torch.randn(BL, C) / math.sqrt(C)\nw1 = torch.randn(HD, C)\nw2 = torch.randn(HD, C)\nw3 = torch.randn(HD, C)\n\ndef three_separate():\n    q = xr @ w1.T\n    k = xr @ w2.T\n    v = xr @ w3.T\n    return q, k, v\n\ndef two_plus_one():\n    wqk = torch.cat([w1, w2], dim=0)\n    qk = xr @ wqk.T\n    q, k = qk.split(HD, dim=1)\n    v = xr @ w3.T\n    return q, k, v\n\n# Warmup\nfor _ in range(5):\n    three_separate()\n    two_plus_one()\n\nn = 30\ntimes_3 = []\ntimes_21 = []\nfor i in range(n):\n    if i % 2 == 0:\n        t0 = time.process_time_ns()\n        three_separate()\n        times_3.append((time.process_time_ns() - t0) / 1e6)\n        t0 = time.process_time_ns()\n        two_plus_one()\n        times_21.append((time.process_time_ns() - t0) / 1e6)\n    else:\n        t0 = time.process_time_ns()\n        two_plus_one()\n        times_21.append((time.process_time_ns() - t0) / 1e6)\n        t0 = time.process_time_ns()\n        three_separate()\n        times_3.append((time.process_time_ns() - t0) / 1e6)\n\ntimes_3.sort()\ntimes_21.sort()\nprint(f'3 separate: median={times_3[n//2]:.2f}ms mean={statistics.mean(times_3):.2f}ms')\nprint(f'2+1 stacked: median={times_21[n//2]:.2f}ms mean={statistics.mean(times_21):.2f}ms')\nprint(f'Ratio: {times_21[n//2]/times_3[n//2]:.3f}')\nPYEOF\n\"","aggregated_output":"3 separate: median=62.33ms mean=101.30ms\n2+1 stacked: median=53.36ms mean=85.00ms\nRatio: 0.856\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_92","type":"command_execution","command":"/bin/sh -lc \"python << 'PYEOF'\nimport torch, time, math, statistics\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n# Let me test for each case size\ncases = [\n    (\\\"case0\\\", 64, 512, 8, 64),\n    (\\\"case1\\\", 128, 640, 10, 64),\n    (\\\"case2\\\", 128, 1280, 20, 64),\n    (\\\"case3\\\", 256, 1280, 20, 64),\n    (\\\"case4\\\", 256, 640, 10, 64),\n    (\\\"case5\\\", 256, 512, 8, 64),\n]\n\nfor name, L, C, H, D in cases:\n    HD = H * D\n    BL = L\n    xr = torch.randn(BL, C) / math.sqrt(C)\n    w1 = torch.randn(HD, C)\n    w2 = torch.randn(HD, C)\n    w3 = torch.randn(HD, C)\n    \n    def three_sep():\n        xr @ w1.T\n        xr @ w2.T\n        xr @ w3.T\n    \n    def two_plus_one():\n        wqk = torch.cat([w1, w2], dim=0)\n        qk = xr @ wqk.T\n        qk.split(HD, dim=1)\n        xr @ w3.T\n    \n    for _ in range(5):\n        three_sep()\n        two_plus_one()\n    \n    n = 30\n    t3 = []\n    t21 = []\n    for i in range(n):\n        if i % 2 == 0:\n            t0 = time.process_time_ns()\n            three_sep()\n            t3.append((time.process_time_ns() - t0) / 1e6)\n            t0 = time.process_time_ns()\n            two_plus_one()\n            t21.append((time.process_time_ns() - t0) / 1e6)\n        else:\n            t0 = time.process_time_ns()\n            two_plus_one()\n            t21.append((time.process_time_ns() - t0) / 1e6)\n            t0 = time.process_time_ns()\n            three_sep()\n            t3.append((time.process_time_ns() - t0) / 1e6)\n    \n    t3.sort()\n    t21.sort()\n    print(f'{name}: 3sep={t3[n//2]:.3f}ms 2+1={t21[n//2]:.3f}ms ratio={t21[n//2]/t3[n//2]:.3f}')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_92","type":"command_execution","command":"/bin/sh -lc \"python << 'PYEOF'\nimport torch, time, math, statistics\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n# Let me test for each case size\ncases = [\n    (\\\"case0\\\", 64, 512, 8, 64),\n    (\\\"case1\\\", 128, 640, 10, 64),\n    (\\\"case2\\\", 128, 1280, 20, 64),\n    (\\\"case3\\\", 256, 1280, 20, 64),\n    (\\\"case4\\\", 256, 640, 10, 64),\n    (\\\"case5\\\", 256, 512, 8, 64),\n]\n\nfor name, L, C, H, D in cases:\n    HD = H * D\n    BL = L\n    xr = torch.randn(BL, C) / math.sqrt(C)\n    w1 = torch.randn(HD, C)\n    w2 = torch.randn(HD, C)\n    w3 = torch.randn(HD, C)\n    \n    def three_sep():\n        xr @ w1.T\n        xr @ w2.T\n        xr @ w3.T\n    \n    def two_plus_one():\n        wqk = torch.cat([w1, w2], dim=0)\n        qk = xr @ wqk.T\n        qk.split(HD, dim=1)\n        xr @ w3.T\n    \n    for _ in range(5):\n        three_sep()\n        two_plus_one()\n    \n    n = 30\n    t3 = []\n    t21 = []\n    for i in range(n):\n        if i % 2 == 0:\n            t0 = time.process_time_ns()\n            three_sep()\n            t3.append((time.process_time_ns() - t0) / 1e6)\n            t0 = time.process_time_ns()\n            two_plus_one()\n            t21.append((time.process_time_ns() - t0) / 1e6)\n        else:\n            t0 = time.process_time_ns()\n            two_plus_one()\n            t21.append((time.process_time_ns() - t0) / 1e6)\n            t0 = time.process_time_ns()\n            three_sep()\n            t3.append((time.process_time_ns() - t0) / 1e6)\n    \n    t3.sort()\n    t21.sort()\n    print(f'{name}: 3sep={t3[n//2]:.3f}ms 2+1={t21[n//2]:.3f}ms ratio={t21[n//2]/t3[n//2]:.3f}')\nPYEOF\n\"","aggregated_output":"case0: 3sep=2.256ms 2+1=3.062ms ratio=1.357\ncase1: 3sep=6.432ms 2+1=7.921ms ratio=1.232\ncase2: 3sep=26.978ms 2+1=37.852ms ratio=1.403\ncase3: 3sep=56.674ms 2+1=61.716ms ratio=1.089\ncase4: 3sep=10.236ms 2+1=10.450ms ratio=1.021\ncase5: 3sep=7.298ms 2+1=7.172ms ratio=0.983\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_93","type":"command_execution","command":"/bin/sh -lc \"python << 'PYEOF'\nimport torch, time, math\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n# 2+1 is slower for most cases. The torch.cat overhead is significant.\n# The key cost is the cat (which allocates new memory and copies data).\n\n# Let me think differently. What if we pre-format the weights?\n# Can't - no persistent state.\n\n# What if we do the projections in a different order?\n# Currently: q, k, v (three matmuls, all read x)\n# What if we interleave them? No, they're independent.\n\n# OK, let me focus on the bigger picture.\n# Current ratio is 0.438. Can I push it further?\n\n# The main remaining costs:\n# 1. Projection matmuls (q, k, v) - biggest cost\n# 2. p@G matmuls - second biggest\n# 3. Softmaxes - third biggest\n# 4. Everything else - small\n\n# For the projections, we're already using reshaped matmuls (optimal).\n# For p@G, we're using 4D broadcast matmul (close to optimal).\n# For softmax, we're using PyTorch's built-in (optimal).\n\n# What about fusing operations?\n# - Can we fuse qk\"'^T with the scale? Already done with mul_.\n# - Can we fuse p@v with the ratio multiplication? Already done with mul_.\n# - Can we fuse softmax with something? Not easily.\n\n# What about memory allocation overhead?\n# Every new tensor creation has overhead. Can we reduce allocations?\n# Let me count allocations in the current function:\n# 1. q (new)\n# 2. k (new)\n# 3. v (new)\n# 4. logits = q @ k.T (new)\n# 5. logits.mul_ (in-place)\n# 6. p0 = softmax (new)\n# 7. p1_logits = logits.mul(a_p) (new)\n# 8. p1_logits.add_ (in-place)\n# 9. p1 = softmax (new)\n# 10. p_mix = lerp (new)\n# 11. G = x @ x.T (new)\n# 12. G_exp = G.unsqueeze (view)\n# 13. p1G = p1 @ G_exp (new)\n# 14. p1G.mul_(p1) (in-place)\n# 15. norm1_sq = .sum() (new)\n# 16. norm1_sq.sqrt_().clamp_min_() (in-place)\n# 17. pmG = p_mix @ G_exp (new)\n# 18. pmG.mul_(p_mix) (in-place)\n# 19. normm_sq = .sum() (new)\n# 20. normm_sq.sqrt_().clamp_min_() (in-place)\n# 21. ratio = norm1.div_(normm).clamp_() (in-place on norm1)\n# 22. y = p_mix @ v (new)\n# 23. y.mul_(ratio) (in-place)\n# 24. y.transpose(1,2).flatten(2).contiguous() (new)\n\n# That'\"'s about 12 new tensor allocations of meaningful size.\n# Could we reuse some? For example, reuse logits buffer for p1_logits?\n# After p0 softmax, logits is still needed for p1_logits computation.\n# But we could compute p0, then modify logits in-place to get p1_logits...\n# no, because p1_logits = a_p * logits + a_m * logits\"'^T\n# and we can'\"'t add logits.T to logits in-place (aliasing).\n\n# What about: compute p1 first, then modify p1_logits in-place to get p0?\n# No, p0 = softmax(logits) not logits itself.\n\n# Hmm. What about computing G before the projections to warm up memory?\n# Probably negligible.\n\n# Let me try one more thing: compute q@k\"'^T / sqrt(D) as (q/sqrt(D)) @ k''^T\n# to fuse the scaling into the q computation.\n# This saves one elementwise multiplication on the (B,H,L,L) tensor.\n\n# Actually, the scaling is tiny (L''^2 elements) compared to the matmul.\n# Not worth it.\n\n# Let me try another approach: what if we compute attention output via a different formula?\n\n# Output: y = ratio * (p_mix @ v)\n# where ratio = clamp(||u1|| / ||m||, 0.25, 4.0)\n# u1 = p1 @ x\n# m = p_mix @ x\n\n# We use the Gram trick for ||u1|| and ||m|| because it'\"'s cheaper than computing u1 and m.\n# But what about using a different norm approximation?\n# No, we need exact L2 norm.\n\n# OK let me just try one more optimization and run the full eval:\n# Compute G = xx\"'^T first (while x is hot in cache), then do projections.\n# This might help because G reads x twice, and after that x is still hot for projections.\n\n# Actually, I already tried computing G early in the bmm version, and that was 0.51 (worse).\n# But the bmm version had other changes too. Let me just add G-early to the current best.\n\n# Wait, the current best already has G computed AFTER the projections and softmaxes.\n# Let me try computing G BEFORE the projections and see if it helps.\n\nprint(\"Testing G-early vs G-late...\")\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\nHD = H * D\nBHL = B * H * L\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C) / math.sqrt(C)\nwq = torch.randn(H, D, C) / math.sqrt(C)\nwk = torch.randn(H, D, C) / math.sqrt(C)\nwv = torch.randn(H, D, C) / math.sqrt(C)\n\n@torch.no_grad()\ndef attn_g_late(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BHL = B * H * L\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    p1G = p1 @ G_exp\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    pmG = p_mix @ G_exp\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n@torch.no_grad()\ndef attn_g_early(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BHL = B * H * L\n    xr = x.reshape(B * L, C)\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    p1G = p1 @ G_exp\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    pmG = p_mix @ G_exp\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Verify same output\ny1 = attn_g_late(x, wq, wk, wv, alpha, beta)\ny2 = attn_g_early(x.clone(), wq.clone(), wk.clone(), wv.clone(), alpha, beta)\nprint(f'\"'Same output: {torch.allclose(y1, y2)}')\n\nimport statistics\n# Benchmark\nn = 20\nt_late = []\nt_early = []\nfor i in range(n):\n    if i % 2 == 0:\n        t0 = time.process_time_ns()\n        attn_g_late(x, wq, wk, wv, alpha, beta)\n        t_late.append((time.process_time_ns() - t0) / 1e6)\n        t0 = time.process_time_ns()\n        attn_g_early(x, wq, wk, wv, alpha, beta)\n        t_early.append((time.process_time_ns() - t0) / 1e6)\n    else:\n        t0 = time.process_time_ns()\n        attn_g_early(x, wq, wk, wv, alpha, beta)\n        t_early.append((time.process_time_ns() - t0) / 1e6)\n        t0 = time.process_time_ns()\n        attn_g_late(x, wq, wk, wv, alpha, beta)\n        t_late.append((time.process_time_ns() - t0) / 1e6)\n\nt_late.sort()\nt_early.sort()\nprint(f'G-late median: {t_late[n//2]:.3f} ms')\nprint(f'G-early median: {t_early[n//2]:.3f} ms')\nprint(f'Ratio: {t_early[n//2]/t_late[n//2]:.3f}')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/sh -lc \"python << 'PYEOF'\nimport torch, time, math\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n# Carefully measure p@G for different sizes\nfor B, H, L in [(1, 20, 256), (1, 10, 256), (1, 20, 128), (1, 10, 128)]:\n    p = torch.randn(B, H, L, L).softmax(dim=-1)\n    G = torch.randn(B, 1, L, L)\n    \n    # warmup\n    for _ in range(5):\n        _ = p @ G\n    \n    n = 20\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        _ = p @ G\n        times.append((time.process_time_ns() - t0) / 1e6)\n    \n    times.sort()\n    median = times[n//2]\n    gflops = (2 * B * H * L * L * L) / (median * 1e-3) / 1e9\n    print(f'B={B} H={H} L={L}: median={median:.3f}ms, {gflops:.1f} GFLOPS')\n\n# Also test bmm version\nfor B, H, L in [(1, 20, 256), (1, 10, 256), (1, 20, 128), (1, 10, 128)]:\n    BH = B * H\n    p = torch.randn(BH, L, L)\n    G = torch.randn(L, L)\n    \n    for _ in range(5):\n        _ = torch.bmm(p, G.expand(BH, L, L))\n    \n    n = 20\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        _ = torch.bmm(p, G.expand(BH, L, L))\n        times.append((time.process_time_ns() - t0) / 1e6)\n    \n    times.sort()\n    median = times[n//2]\n    gflops = (2 * BH * L * L * L) / (median * 1e-3) / 1e9\n    print(f'bmm BH={BH} L={L}: median={median:.3f}ms, {gflops:.1f} GFLOPS')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

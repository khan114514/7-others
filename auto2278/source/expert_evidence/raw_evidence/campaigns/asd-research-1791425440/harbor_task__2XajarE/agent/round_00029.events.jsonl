{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/sh -lc \"python << 'EOF'\nimport torch, time, math\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n# Test softmax performance\nfor shape in [(5120, 256), (10240, 128), (2560, 512)]:\n    x = torch.randn(*shape)\n    # warmup\n    for _ in range(3):\n        y = x.softmax(dim=-1)\n    t0 = time.process_time_ns()\n    for _ in range(20):\n        y = x.softmax(dim=-1)\n    t1 = time.process_time_ns()\n    print(f'softmax {shape}: {(t1-t0)/20/1e6:.3f} ms, {shape[0]*shape[1]/1e6:.2f}M elements')\n\n# Compare with manual softmax\nx = torch.randn(5120, 256)\ndef manual_softmax(x):\n    m = x.max(dim=-1, keepdim=True)[0]\n    e = (x - m).exp_()\n    s = e.sum(dim=-1, keepdim=True)\n    return e.div_(s)\n\nfor _ in range(3):\n    manual_softmax(x)\nt0 = time.process_time_ns()\nfor _ in range(20):\n    manual_softmax(x)\nt1 = time.process_time_ns()\nprint(f'manual softmax (5120, 256): {(t1-t0)/20/1e6:.3f} ms')\n\n# What about 4D softmax?\nx4 = torch.randn(1, 20, 256, 256)\nfor _ in range(3):\n    y = x4.softmax(dim=-1)\nt0 = time.process_time_ns()\nfor _ in range(20):\n    y = x4.softmax(dim=-1)\nt1 = time.process_time_ns()\nprint(f'4D softmax (1,20,256,256): {(t1-t0)/20/1e6:.3f} ms')\n\n# What about contiguous vs not?\nx_nc = x4.permute(0, 2, 1, 3)  # (1, 256, 20, 256) - last dim contiguous?\nprint(f'is contiguous last dim? {x_nc.stride()}')\nfor _ in range(3):\n    y = x_nc.softmax(dim=-1)\nt0 = time.process_time_ns()\nfor _ in range(20):\n    y = x_nc.softmax(dim=-1)\nt1 = time.process_time_ns()\nprint(f'non-contiguous softmax last dim (1,256,20,256): {(t1-t0)/20/1e6:.3f} ms')\nEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

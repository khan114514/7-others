{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/sh -lc \"python << 'PYEOF'\nimport torch, time, math\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\ndef bench(name, fn, n=5, warmup=3):\n    for _ in range(warmup):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    ms = (t1-t0)/n/1e6\n    print(f'{name}: {ms:.2f} ms')\n    return ms\n\n@torch.no_grad()\ndef attention_ref(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BHL = B * H * L\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    p1G = p1 @ G_exp\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ny_ref = attention_ref(x, wq, wk, wv, alpha, beta)\nbench('Reference', lambda: attention_ref(x, wq, wk, wv, alpha, beta))\n\n# V2: bmm + stacked qkv\n@torch.no_grad()\ndef attention_v2(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BH = B * H\n    xr = x.reshape(B * L, C)\n    w_qkv = torch.cat([wq.reshape(HD, C), wk.reshape(HD, C), wv.reshape(HD, C)], dim=0)\n    qkv = xr @ w_qkv.T\n    q_flat, k_flat, v_flat = qkv.split([HD, HD, HD], dim=1)\n    q = q_flat.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous().reshape(BH, L, D)\n    k = k_flat.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous().reshape(BH, L, D)\n    v = v_flat.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous().reshape(BH, L, D)\n    logits = torch.bmm(q, k.transpose(1, 2))\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(1, 2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = p0.clone()\n    p_mix.lerp_(p1, beta)\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.expand(BH, L, L)\n    p1G = torch.bmm(p1, G_exp)\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = torch.bmm(p_mix, G_exp)\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    y = torch.bmm(p_mix, v).mul_(ratio)\n    return y.reshape(B, H, L, D).transpose(1, 2).flatten(2).contiguous()\n\ny_v2 = attention_v2(x, wq, wk, wv, alpha, beta)\nprint(f'V2 max error: {(y_v2 - y_ref).abs().max():.2e}')\nbench('V2 (bmm + stacked qkv)', lambda: attention_v2(x, wq, wk, wv, alpha, beta))\n\n# V3: compute p_mix via p0 + beta*(p1-p0) to avoid clone, and fused norms\n@torch.no_grad()\ndef attention_v3(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BH = B * H\n    BHL = BH * L\n    xr = x.reshape(B * L, C)\n    w_qkv = torch.cat([wq.reshape(HD, C), wk.reshape(HD, C), wv.reshape(HD, C)], dim=0)\n    qkv = xr @ w_qkv.T\n    q_flat, k_flat, v_flat = qkv.split([HD, HD, HD], dim=1)\n    q = q_flat.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous().reshape(BH, L, D)\n    k = k_flat.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous().reshape(BH, L, D)\n    v = v_flat.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous().reshape(BH, L, D)\n    logits = torch.bmm(q, k.transpose(1, 2))\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(1, 2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.expand(BH, L, L)\n    # Compute p_mix @ v and both p@G using a single stacked bmm\n    # Stack: p1 and p_mix as one big batch\n    p_mix = p0.clone().lerp_(p1, beta)\n    p_stacked = torch.cat([p1, p_mix], dim=0)\n    G_stacked = G.expand(2 * BH, L, L)\n    pG_stacked = torch.bmm(p_stacked, G_stacked)\n    p1G = pG_stacked[:BH]\n    pmG = pG_stacked[BH:]\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    y = torch.bmm(p_mix, v).mul_(ratio)\n    return y.reshape(B, H, L, D).transpose(1, 2).flatten(2).contiguous()\n\ny_v3 = attention_v3(x, wq, wk, wv, alpha, beta)\nprint(f'V3 max error: {(y_v3 - y_ref).abs().max():.2e}')\nbench('V3 (stacked p@G)', lambda: attention_v3(x, wq, wk, wv, alpha, beta))\n\n# V4: avoid p_mix materialization - compute pmG from p0G and p1G\n@torch.no_grad()\ndef attention_v4(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BH = B * H\n    xr = x.reshape(B * L, C)\n    w_qkv = torch.cat([wq.reshape(HD, C), wk.reshape(HD, C), wv.reshape(HD, C)], dim=0)\n    qkv = xr @ w_qkv.T\n    q_flat, k_flat, v_flat = qkv.split([HD, HD, HD], dim=1)\n    q = q_flat.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous().reshape(BH, L, D)\n    k = k_flat.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous().reshape(BH, L, D)\n    v = v_flat.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous().reshape(BH, L, D)\n    logits = torch.bmm(q, k.transpose(1, 2))\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(1, 2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.expand(BH, L, L)\n    # Stack p0 and p1 for single bmm with G\n    p_stacked = torch.cat([p0, p1], dim=0)\n    G_stacked = G.expand(2 * BH, L, L)\n    pG_stacked = torch.bmm(p_stacked, G_stacked)\n    p0G = pG_stacked[:BH]\n    p1G = pG_stacked[BH:]\n    # norm1_sq = (p1G * p1).sum(-1)\n    norm1_sq = p1G.mul(p1).sum(dim=-1, keepdim=True)\n    # normm_sq = ((1-beta)\"'^2 * (p0G*p0).sum + beta''^2 * (p1G*p1).sum + ...\n    # (1-beta)*beta * ((p0G*p1).sum + (p1G*p0).sum))\n    # Note: (p0G * p1).sum(-1) = (p1G * p0).sum(-1) because G is symmetric\n    # Actually: p0G = p0 @ G, p1G = p1 @ G\n    # (p0G * p1).sum = sum_j (sum_k p0_ik G_kj) * p1_ij\n    # (p1G * p0).sum = sum_j (sum_k p1_ik G_kj) * p0_ij\n    # These are equal because G is symmetric: G_kj = G_jk\n    # Let'\"'s verify: sum_j sum_k p0_ik G_kj p1_ij = sum_k sum_j p0_ik G_jk p1_ij = sum_k p0_ik sum_j p1_ij G_jk\n    # vs sum_j sum_k p1_ik G_kj p0_ij = sum_k p0_ik sum_j p1_ij G_kj\n    # These are equal since G_jk = G_kj. Yes\"'!\n    one_minus_b = 1.0 - beta\n    cross = p0G.mul(p1).sum(dim=-1, keepdim=True)\n    normm_sq = (one_minus_b * one_minus_b) * p0G.mul(p0).sum(dim=-1, keepdim=True) '\"\\\\\n               + (beta * beta) * norm1_sq \\\\\n               + 2.0 * one_minus_b * beta * cross\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    # Output: p_mix @ v = (1-beta)*(p0@v) + beta*(p1@v)\n    y0 = torch.bmm(p0, v)\n    y1 = torch.bmm(p1, v)\n    y = y0.lerp_(y1, beta).mul_(ratio)\n    return y.reshape(B, H, L, D).transpose(1, 2).flatten(2).contiguous()\n\ny_v4 = attention_v4(x, wq, wk, wv, alpha, beta)\nprint(f'V4 max error: {(y_v4 - y_ref).abs().max():.2e}')\nbench('V4 (stacked p0/p1@G, no pmix)', lambda: attention_v4(x, wq, wk, wv, alpha, beta))\n\nprint('\\\\n--- Case 4: L=256, C=640, H=10 ---')\nB2, L2, C2, H2, D2 = 1, 256, 640, 10, 64\nx2 = torch.randn(B2, L2, C2)\nwq2 = torch.randn(H2, D2, C2)\nwk2 = torch.randn(H2, D2, C2)\nwv2 = torch.randn(H2, D2, C2)\nbench('Ref case4', lambda: attention_ref(x2, wq2, wk2, wv2, alpha, beta))\nbench('V2 case4', lambda: attention_v2(x2, wq2, wk2, wv2, alpha, beta))\nbench('V3 case4', lambda: attention_v3(x2, wq2, wk2, wv2, alpha, beta))\nbench('V4 case4', lambda: attention_v4(x2, wq2, wk2, wv2, alpha, beta))\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

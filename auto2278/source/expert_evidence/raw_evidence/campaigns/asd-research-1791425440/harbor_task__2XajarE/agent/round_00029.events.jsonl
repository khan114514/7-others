{"type":"item.started","item":{"id":"item_67","type":"command_execution","command":"/bin/sh -lc \"cat > /workspace/solution/method.py << 'PYEOF'\n\\\"\\\"\\\"Optimized multihead retrieval kernel: bmm-based, G-early, Gram norm trick.\\\"\\\"\\\"\nimport math\nimport torch\n\n\n@torch.no_grad()\ndef attention(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BH = B * H\n    BHL = BH * L\n    xr = x.reshape(B * L, C)\n\n    G = x @ x.transpose(-1, -2)\n\n    wq_flat = wq.reshape(HD, C)\n    wk_flat = wk.reshape(HD, C)\n    wv_flat = wv.reshape(HD, C)\n\n    q_flat = xr @ wq_flat.T\n    k_flat = xr @ wk_flat.T\n    v_flat = xr @ wv_flat.T\n\n    q = q_flat.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous().reshape(BH, L, D)\n    k = k_flat.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous().reshape(BH, L, D)\n    v = v_flat.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous().reshape(BH, L, D)\n\n    logits = torch.bmm(q, k.transpose(1, 2))\n    logits.mul_(inv_sqrt_d)\n\n    p0 = logits.softmax(dim=-1)\n\n    if alpha == 1.0:\n        y = torch.bmm(p0, v)\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1_logits = logits.mul(a_p)\n        p1_logits.add_(logits.transpose(1, 2), alpha=a_m)\n        p1 = p1_logits.softmax(dim=-1)\n\n        p_mix = torch.lerp(p0, p1, beta)\n\n        G_bmm = G.expand(BH, L, L)\n\n        p1G = torch.bmm(p1, G_bmm)\n        norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n\n        pmG = torch.bmm(p_mix, G_bmm)\n        normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n\n        y = torch.bmm(p_mix, v).mul_(ratio)\n\n    return y.reshape(B, H, L, D).transpose(1, 2).flatten(2).contiguous()\nPYEOF\necho \\\"Written method.py\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

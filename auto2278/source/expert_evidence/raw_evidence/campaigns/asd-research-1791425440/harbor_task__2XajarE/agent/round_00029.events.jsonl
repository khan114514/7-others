{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/sh -lc \"python << 'PYEOF'\nimport torch, time, math\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n# Profile individual components for the current solution\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\nHD = H * D\nBHL = B * H * L\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\nxr = x.reshape(B * L, C)\n\ndef bench(name, fn, n=5):\n    for _ in range(3):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    print(f'{name}: {(t1-t0)/n/1e6:.2f} ms')\n    return (t1-t0)/n/1e6\n\n# Q projection only\nwq_flat = wq.reshape(HD, C)\ndef proj_q():\n    q = (xr @ wq_flat.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    return q\n\nq = proj_q()\nk = proj_q()\nv = proj_q()\nbench('q proj + permute', proj_q)\n\n# Projection without permute\ndef proj_q_noperm():\n    q = (xr @ wq_flat.T).reshape(B, L, H, D)\n    return q\nbench('q proj (no permute)', proj_q_noperm)\n\n# Permute only\nq_np = proj_q_noperm()\ndef perm():\n    return q_np.permute(0, 2, 1, 3).contiguous()\nbench('permute only', perm)\n\n# logits\ndef logits_fn():\n    return q @ k.transpose(-1, -2)\n\nlogits = logits_fn()\nbench('q @ k\"'^T'\"', logits_fn)\n\n# scale\nlogits2 = logits.clone()\ndef scale_fn():\n    logits2.mul_(1.0/math.sqrt(D))\n    return logits2\nbench('scale in-place', scale_fn)\nlogits2 = logits * (1.0/math.sqrt(D))\n\n# softmax\ndef sm_fn():\n    return logits2.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n\nbench('softmax (2D view)', sm_fn)\np0 = sm_fn()\n\ndef sm_4d_fn():\n    return logits2.softmax(dim=-1)\nbench('softmax (4D)', sm_4d_fn)\n\n# p1 logits\na_p = 0.5 * (1+alpha)\na_m = 0.5 * (1-alpha)\ndef p1_logits_fn():\n    p1l = logits2.mul(a_p)\n    p1l.add_(logits2.transpose(-1, -2), alpha=a_m)\n    return p1l\np1l = p1_logits_fn()\nbench('p1_logits (mul + add_)', p1_logits_fn)\n\n# p1 softmax\ndef p1_sm():\n    return p1l.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\np1 = p1_sm()\nbench('p1 softmax', p1_sm)\n\n# lerp\ndef lerp_fn():\n    return torch.lerp(p0, p1, beta)\nbench('lerp p_mix', lerp_fn)\np_mix = lerp_fn()\n\n# G\ndef G_fn():\n    return x @ x.transpose(-1, -2)\nbench('G = xx\"'^T'\"', G_fn)\nG = G_fn()\nG_exp = G.unsqueeze(1)\n\n# p1 @ G\ndef p1G_fn():\n    return p1 @ G_exp\nbench('p1 @ G', p1G_fn)\np1G = p1G_fn()\n\n# p_mix @ G\ndef pmG_fn():\n    return p_mix @ G_exp\nbench('p_mix @ G', pmG_fn)\n\n# norm1\ndef norm1_fn():\n    return p1G.mul(p1).sum(dim=-1, keepdim=True).sqrt().clamp_min(1e-6)\nbench('norm1 (mul+sum+sqrt+clamp)', norm1_fn)\n\n# p_mix @ v\ndef pmv_fn():\n    return p_mix @ v\nbench('p_mix @ v', pmv_fn)\n\n# final mul + transpose + flatten\ny = pmv_fn()\nratio = norm1_fn()\ndef final_fn():\n    return (y * ratio).transpose(1, 2).flatten(2).contiguous()\nbench('final: mul+transpose+flatten', final_fn)\n\nprint(f'\\\\nTotal sum: manual sum of all components')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_77","type":"command_execution","command":"/bin/sh -lc \"python << 'PYEOF'\nimport torch, time, math\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n# The 4D matmul with broadcast is slower for H=10 (40 GFLOPS vs 53 GFLOPS for bmm)\n# Let me verify this consistently.\n\nB, H, L = 1, 10, 256\na = torch.randn(B, H, L, L)\nb = torch.randn(B, 1, L, L)\na_3d = a.reshape(B*H, L, L)\nb_3d = b.expand(B, H, L, L).reshape(B*H, L, L).contiguous()\n\n# 4D broadcast\nfor _ in range(5):\n    a @ b\nt_4d = []\nfor _ in range(20):\n    t0 = time.process_time_ns()\n    c = a @ b\n    t_4d.append((time.process_time_ns() - t0) / 1e6)\nt_4d.sort()\nprint(f'4D broadcast: {t_4d[10]:.3f} ms')\n\n# bmm version (need to expand b first)\nb_exp = b.expand(B, H, L, L).reshape(B*H, L, L)\nfor _ in range(5):\n    torch.bmm(a_3d, b_exp)\nt_bmm = []\nfor _ in range(20):\n    t0 = time.process_time_ns()\n    c = torch.bmm(a_3d, b_exp)\n    t_bmm.append((time.process_time_ns() - t0) / 1e6)\nt_bmm.sort()\nprint(f'bmm (pre-expanded G): {t_bmm[10]:.3f} ms')\n\n# But expanding G takes time too\nt_expand = []\nfor _ in range(20):\n    t0 = time.process_time_ns()\n    be = b.expand(B, H, L, L).reshape(B*H, L, L).contiguous()\n    t_expand.append((time.process_time_ns() - t0) / 1e6)\nt_expand.sort()\nprint(f'expand + reshape + contig: {t_expand[10]:.3f} ms')\n\n# Total for bmm approach\nprint(f'bmm total (with expand): {t_bmm[10] + t_expand[10]:.3f} ms')\n\n# Check if the expand+reshape is needed or if bmm can handle strided\nb_strided = b.expand(B, H, L, L).reshape(B*H, L, L)\nprint(f'b_strided contiguous: {b_strided.is_contiguous()}')\n# It won't be contiguous. Let me check if bmm handles non-contiguous.\nfor _ in range(5):\n    torch.bmm(a_3d, b_strided)\nt_bmm_strided = []\nfor _ in range(20):\n    t0 = time.process_time_ns()\n    c = torch.bmm(a_3d, b_strided)\n    t_bmm_strided.append((time.process_time_ns() - t0) / 1e6)\nt_bmm_strided.sort()\nprint(f'bmm (strided G): {t_bmm_strided[10]:.3f} ms')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

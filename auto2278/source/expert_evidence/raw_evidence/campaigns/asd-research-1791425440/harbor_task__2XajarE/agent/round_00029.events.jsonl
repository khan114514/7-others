{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/sh -lc \"python << 'PYEOF'\nimport torch, time, math\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\nHD = H * D\nBHL = B * H * L\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\n# Generate p1 and p_mix similar to the real function\nq = torch.randn(B, H, L, D)\nk = torch.randn(B, H, L, D)\nlogits = (q @ k.transpose(-1, -2)) / math.sqrt(D)\np0 = logits.softmax(dim=-1)\n\na_p = 0.5 * (1 + alpha)\na_m = 0.5 * (1 - alpha)\np1_logits = logits.mul(a_p)\np1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\np1 = p1_logits.softmax(dim=-1)\np_mix = torch.lerp(p0, p1, beta)\n\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\n\nprint(f'p1 contiguous: {p1.is_contiguous()}, stride: {p1.stride()}')\nprint(f'p_mix contiguous: {p_mix.is_contiguous()}, stride: {p_mix.stride()}')\n\n# Alternate back and forth to eliminate ordering effects\ndef bmm_op(p):\n    return p @ G_exp\n\n# warmup\nfor _ in range(5):\n    bmm_op(p1)\n    bmm_op(p_mix)\n\nn = 20\nt1_times = []\ntm_times = []\nfor i in range(n):\n    t0 = time.process_time_ns()\n    r1 = bmm_op(p1)\n    t1 = time.process_time_ns()\n    rm = bmm_op(p_mix)\n    t2 = time.process_time_ns()\n    t1_times.append((t1-t0)/1e6)\n    tm_times.append((t2-t1)/1e6)\n\nt1_times.sort()\ntm_times.sort()\nprint(f'p1@G median: {t1_times[n//2]:.2f}ms, p_mix@G median: {tm_times[n//2]:.2f}ms')\n\n# Try with cloned/contiguous versions\np1_c = p1.contiguous()\np_mix_c = p_mix.contiguous()\nfor _ in range(5):\n    bmm_op(p1_c)\n    bmm_op(p_mix_c)\n\nt1c_times = []\ntmc_times = []\nfor i in range(n):\n    t0 = time.process_time_ns()\n    r1 = bmm_op(p1_c)\n    t1 = time.process_time_ns()\n    rm = bmm_op(p_mix_c)\n    t2 = time.process_time_ns()\n    t1c_times.append((t1-t0)/1e6)\n    tmc_times.append((t2-t1)/1e6)\n\nt1c_times.sort()\ntmc_times.sort()\nprint(f'p1_c@G median: {t1c_times[n//2]:.2f}ms, p_mix_c@G median: {tmc_times[n//2]:.2f}ms')\n\n# Now test softmax ordering effects\nlogits_c = logits.contiguous()\np1_logits_c = p1_logits.contiguous()\n\ndef sm(t):\n    return t.softmax(dim=-1)\n\nfor _ in range(5):\n    sm(logits_c)\n    sm(p1_logits_c)\n\ntsm0 = []\ntsm1 = []\nfor i in range(n):\n    t0 = time.process_time_ns()\n    sm(logits_c)\n    t1 = time.process_time_ns()\n    sm(p1_logits_c)\n    t2 = time.process_time_ns()\n    tsm0.append((t1-t0)/1e6)\n    tsm1.append((t2-t1)/1e6)\n\ntsm0.sort()\ntsm1.sort()\nprint(f'p0_softmax median: {tsm0[n//2]:.3f}ms, p1_softmax median: {tsm1[n//2]:.3f}ms')\n\n# 2D view vs 4D\nlogits_2d = logits_c.view(BHL, L)\np1l_2d = p1_logits_c.view(BHL, L)\n\ndef sm2d(t):\n    return t.softmax(dim=-1)\n\nfor _ in range(5):\n    sm2d(logits_2d)\n    sm2d(p1l_2d)\n\ntsm0_2d = []\ntsm1_2d = []\nfor i in range(n):\n    t0 = time.process_time_ns()\n    sm2d(logits_2d)\n    t1 = time.process_time_ns()\n    sm2d(p1l_2d)\n    t2 = time.process_time_ns()\n    tsm0_2d.append((t1-t0)/1e6)\n    tsm1_2d.append((t2-t1)/1e6)\n\ntsm0_2d.sort()\ntsm1_2d.sort()\nprint(f'p0_softmax_2d median: {tsm0_2d[n//2]:.3f}ms, p1_softmax_2d median: {tsm1_2d[n//2]:.3f}ms')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

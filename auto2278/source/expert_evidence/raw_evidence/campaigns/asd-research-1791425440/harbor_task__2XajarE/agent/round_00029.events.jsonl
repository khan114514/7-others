\ny_ref = attention_ref(x, wq, wk, wv, alpha, beta)\nbench('Reference', lambda: attention_ref(x, wq, wk, wv, alpha, beta))\n\n# V2: bmm + stacked qkv\n@torch.no_grad()\ndef attention_v2(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BH = B * H\n    xr = x.reshape(B * L, C)\n    w_qkv = torch.cat([wq.reshape(HD, C), wk.reshape(HD, C), wv.reshape(HD, C)], dim=0)\n    qkv = xr @ w_qkv.T\n    q_flat, k_flat, v_flat = qkv.split([HD, HD, HD], dim=1)\n    q = q_flat.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous().reshape(BH, L, D)\n    k = k_flat.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous().reshape(BH, L, D)\n    v = v_flat.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous().reshape(BH, L, D)\n    logits = torch.bmm(q, k.transpose(1, 2))\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(1, 2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = p0.clone()\n    p_mix.lerp_(p1, beta)\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.expand(BH, L, L)\n    p1G = torch.bmm(p1, G_exp)\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = torch.bmm(p_mix, G_exp)\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    y = torch.bmm(p_mix, v).mul_(ratio)\n    return y.reshape(B, H, L, D).transpose(1, 2).flatten(2).contiguous()\n\ny_v2 = attention_v2(x, wq, wk, wv, alpha, beta)\nprint(f'V2 max error: {(y_v2 - y_ref).abs().max():.2e}')\nbench('V2 (bmm + stacked qkv)', lambda: attention_v2(x, wq, wk, wv, alpha, beta))\n\n# V3: compute p_mix via p0 + beta*(p1-p0) to avoid clone, and fused norms\n@torch.no_grad()\ndef attention_v3(x, wq, wk, wv, alpha, beta):\n    B, L
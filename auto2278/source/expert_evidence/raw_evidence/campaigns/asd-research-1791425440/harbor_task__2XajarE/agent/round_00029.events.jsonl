{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/sh -lc \"python << 'PYEOF'\nimport torch, math\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 128, 1280, 20, 64\nalpha, beta = 1.15, 3.0\ntorch.manual_seed(42 + 2)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\nHD = H * D\nBHL = B * H * L\ninv_sqrt_d = 1.0 / math.sqrt(D)\nxr = x.reshape(B * L, C)\n\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\nlogits = q @ k.transpose(-1, -2)\nlogits.mul_(inv_sqrt_d)\n\na_p = 0.5 * (1.0 + alpha)\na_m = 0.5 * (1.0 - alpha)\np1_logits = logits.mul(a_p)\np1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\np1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n\n# norm1 via Gram trick\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\np1G = p1 @ G_exp\nnorm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\nprint(f'norm1_sq min: {norm1_sq.min()}, max: {norm1_sq.max()}')\n\n# norm1 via direct computation\nu1 = p1 @ x.unsqueeze(1)\nnorm1_direct = u1.norm(dim=-1, keepdim=True)\nprint(f'norm1_direct min: {norm1_direct.min()}, max: {norm1_direct.max()}')\n\n# Compare\nprint(f'Difference: {(norm1_sq.sqrt() - norm1_direct).abs().max():.6e}')\n\n# wait - the ref says norm1_ref vs opt is 37\"'! That'\"'s huge.\n# The ref uses the starter's modified.norm(dim=-1) \n# modified = p1 @ x.unsqueeze(1) - same as u1 above\n# But wait - the starter computes p1 differently?\n\n# Let me recompute p1 the starter way\nq_s = torch.einsum(\\\"blc,hdc->bhld\\\", x, wq)\nk_s = torch.einsum(\\\"blc,hdc->bhld\\\", x, wk)\nlogits_s = (q_s @ k_s.transpose(-1, -2)) / math.sqrt(D)\nperturbed_s = .5 * (1 + alpha) * logits_s + .5 * (1 - alpha) * logits_s.transpose(-1, -2)\np1_s = perturbed_s.softmax(dim=-1)\nmodified_s = p1_s @ x.unsqueeze(1)\nnorm1_s = 
.632ms, 53.1 GFLOPS\ncase1_proj (128x640x640): 1.896ms, 55.3 GFLOPS\ncase2_proj (128x1280x1280): 8.336ms, 50.3 GFLOPS\ncase3_proj (256x1280x1280): 15.338ms, 54.7 GFLOPS\ncase4_proj (256x640x640): 3.651ms, 57.4 GFLOPS\ncase5_proj (256x512x512): 2.335ms, 57.5 GFLOPS\n\ncase3_pG (bmm 20x256x256): 12.243ms, 54.8 GFLOPS\ncase4_pG (bmm 10x256x256): 20.838ms, 16.1 GFLOPS\ncase2_pG (bmm 20x128x128): 1.524ms, 55.0 GFLOPS\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_76","type":"command_execution","command":"/bin/sh -lc \"python << 'PYEOF'\nimport torch, time, math\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n# Case 4 p@G is only 16 GFLOPS - that's very slow\"'!\n# BH=10, L=256: 10 batches of 256x256 @ 256x256\n# Let me check why it'\"'s so slow.\n\nfor BH, L in [(10, 256), (20, 256), (5, 256), (15, 256)]:\n    a = torch.randn(BH, L, L)\n    b = torch.randn(BH, L, L)\n    for _ in range(5):\n        torch.bmm(a, b)\n    times = []\n    for _ in range(20):\n        t0 = time.process_time_ns()\n        torch.bmm(a, b)\n        times.append((time.process_time_ns() - t0) / 1e6)\n    times.sort()\n    median = times[10]\n    gflops = (2 * BH * L * L * L) / (median * 1e-3) / 1e9\n    print(f'BH={BH} L={L}: {median:.3f}ms, {gflops:.1f} GFLOPS')\n\n# Hmm, maybe it was a one-off. Let me also test 4D broadcast version.\nprint()\nfor B, H, L in [(1, 10, 256), (1, 20, 256)]:\n    a = torch.randn(B, H, L, L)\n    b = torch.randn(B, 1, L, L)\n    for _ in range(5):\n        a @ b\n    times = []\n    for _ in range(20):\n        t0 = time.process_time_ns()\n        a @ b\n        times.append((time.process_time_ns() - t0) / 1e6)\n    times.sort()\n    median = times[10]\n    gflops = (2 * B * H * L * L * L) / (median * 1e-3) / 1e9\n    print(f'4D B={B} H={H} L={L}: {median:.3f}ms, {gflops:.1f} GFLOPS')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_89","type":"command_execution","command":"/bin/sh -lc \"python << 'PYEOF'\nimport torch, time, math\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n# Stacked p@v is slower. p@v is small anyway (6ms out of 160ms for case 3).\n# Not worth optimizing.\n\n# The big costs are:\n# 1. 3 projection matmuls: ~48ms (case 3)\n# 2. 2 p@G matmuls: ~26ms (case 3)\n# 3. 2 softmaxes: ~14ms (case 3)\n# 4. Everything else: ~10ms\n\n# Total: ~98ms? But actual is ~130ms. There must be other overhead.\n\n# Let me profile the full function more carefully with line-by-line timing.\n\nimport torch, math, time\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\nHD = H * D\nBHL = B * H * L\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C) / math.sqrt(C)\nwq = torch.randn(H, D, C) / math.sqrt(C)\nwk = torch.randn(H, D, C) / math.sqrt(C)\nwv = torch.randn(H, D, C) / math.sqrt(C)\nxr = x.reshape(B * L, C)\n\nwq_flat = wq.reshape(HD, C)\nwk_flat = wk.reshape(HD, C)\nwv_flat = wv.reshape(HD, C)\n\ndef attention_timed(xr, wq_flat, wk_flat, wv_flat, B, L, H, D, alpha, beta):\n    times = {}\n    \n    t0 = time.process_time_ns()\n    q = (xr @ wq_flat.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    times['q_proj'] = (time.process_time_ns() - t0) / 1e6\n    \n    t0 = time.process_time_ns()\n    k = (xr @ wk_flat.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    times['k_proj'] = (time.process_time_ns() - t0) / 1e6\n    \n    t0 = time.process_time_ns()\n    v = (xr @ wv_flat.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    times['v_proj'] = (time.process_time_ns() - t0) / 1e6\n    \n    t0 = time.process_time_ns()\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(1.0 / math.sqrt(D))\n    times['logits'] = (time.process_time_ns() - t0) / 1e6\n    \n    BHL = B * H * L\n    t0 = time.process_time_ns()\n    p0 = logits.softmax(dim=-1)\n    times['p0_softmax'] = (time.process_time_ns() - t0) / 1e6\n    \n    t0 = time.process_time_ns()\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    times['p1_logits'] = (time.process_time_ns() - t0) / 1e6\n    \n    t0 = time.process_time_ns()\n    p1 = p1_logits.softmax(dim=-1)\n    times['p1_softmax'] = (time.process_time_ns() - t0) / 1e6\n    \n    t0 = time.process_time_ns()\n    p_mix = torch.lerp(p0, p1, beta)\n    times['lerp'] = (time.process_time_ns() - t0) / 1e6\n    \n    t0 = time.process_time_ns()\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    times['G'] = (time.process_time_ns() - t0) / 1e6\n    \n    t0 = time.process_time_ns()\n    p1G = p1 @ G_exp\n    times['p1@G'] = (time.process_time_ns() - t0) / 1e6\n    \n    t0 = time.process_time_ns()\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    times['norm1'] = (time.process_time_ns() - t0) / 1e6\n    \n    t0 = time.process_time_ns()\n    pmG = p_mix @ G_exp\n    times['pmix@G'] = (time.process_time_ns() - t0) / 1e6\n    \n    t0 = time.process_time_ns()\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    times['normm'] = (time.process_time_ns() - t0) / 1e6\n    \n    t0 = time.process_time_ns()\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    times['ratio'] = (time.process_time_ns() - t0) / 1e6\n    \n    t0 = time.process_time_ns()\n    y = (p_mix @ v).mul_(ratio)\n    times['pmix@v + mul_ratio'] = (time.process_time_ns() - t0) / 1e6\n    \n    t0 = time.process_time_ns()\n    y = y.transpose(1, 2).flatten(2).contiguous()\n    times['final_reshape'] = (time.process_time_ns() - t0) / 1e6\n    \n    return y, times\n\n# warmup\nfor _ in range(3):\n    attention_timed(xr, wq_flat, wk_flat, wv_flat, B, L, H, D, alpha, beta)\n\n# run\n_, times = attention_timed(xr, wq_flat, wk_flat, wv_flat, B, L, H, D, alpha, beta)\n\ntotal = sum(times.values())\nprint(f'{\\\"Component\\\":<25} {\\\"Time (ms)\\\":>12} {\\\"%\\\":>7}')\nprint('-' * 47)\nfor name, t in sorted(times.items(), key=lambda x: -x[1]):\n    print(f'{name:<25} {t:>12.3f} {t/total*100:>6.1f}%')\nprint('-' * 47)\nprint(f'{\\\"Total\\\":<25} {total:>12.3f}')\n\n# Full function time\ndef full():\n    q = (xr @ wq_flat.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk_flat.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv_flat.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(1.0 / math.sqrt(D))\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    p1G = p1 @ G_exp\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    pmG = p_mix @ G_exp\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\nfor _ in range(3):\n    full()\nt0 = time.process_time_ns()\nfor _ in range(5):\n    full()\nt1 = time.process_time_ns()\nprint(f'\\\\nFull function (5 iters): {(t1-t0)/5/1e6:.3f} ms')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

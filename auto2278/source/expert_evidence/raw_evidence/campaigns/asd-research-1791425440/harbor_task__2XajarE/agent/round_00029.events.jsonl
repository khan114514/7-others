st recent call last):\n  File \"<stdin>\", line 55, in <module>\nImportError: cannot import name 'enable_math' from 'torch.backends.cpu' (/usr/local/lib/python3.12/site-packages/torch/backends/cpu/__init__.py)\n","exit_code":1,"status":"failed"}}
{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/sh -lc \"python << 'PYEOF'\nimport torch, time, math\nimport torch.nn.functional as F\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n# Test SDPA across cases\ncases = [\n    (1, 64, 8, 64),\n    (1, 128, 10, 64),\n    (1, 128, 20, 64),\n    (1, 256, 20, 64),\n    (1, 256, 10, 64),\n    (2, 128, 8, 64),\n]\n\nfor B, L, H, D in cases:\n    torch.manual_seed(42)\n    q = torch.randn(B, H, L, D)\n    k = torch.randn(B, H, L, D)\n    v = torch.randn(B, H, L, D)\n    scale = 1.0 / math.sqrt(D)\n    \n    for _ in range(3):\n        F.scaled_dot_product_attention(q, k, v, scale=scale)\n        (q @ k.transpose(-1, -2) * scale).softmax(dim=-1) @ v\n    \n    n = 20 if L <= 128 else 10\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        logits = q @ k.transpose(-1, -2)\n        logits.mul_(scale)\n        p = logits.softmax(dim=-1)\n        _ = p @ v\n    t1 = time.process_time_ns()\n    manual_ms = (t1-t0)/n/1e6\n    \n    t0 = time.process_time_ns()\n    for _ in range(n):\n        _ = F.scaled_dot_product_attention(q, k, v, scale=scale)\n    t1 = time.process_time_ns()\n    sdpa_ms = (t1-t0)/n/1e6\n    \n    print(f'B={B} L={L} H={H} D={D}: manual={manual_ms:.3f}ms sdpa={sdpa_ms:.3f}ms ratio={sdpa_ms/manual_ms:.3f}')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

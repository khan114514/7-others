{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/sh -lc \"python << 'PYEOF'\nimport torch, math, sys\nimport importlib.util\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nspec = importlib.util.spec_from_file_location(\\\"starter\\\", \\\"/workspace/environment/starter/method.py\\\")\nstarter = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(starter)\n\nsys.path.insert(0, '/workspace/solution')\nfrom method import attention\n\n# Case 2 - biggest error\nB, L, C, H, D = 1, 128, 1280, 20, 64\nalpha, beta = 1.15, 3.0\ntorch.manual_seed(42 + 2)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\ny_ref = starter.attention(x, wq, wk, wv, alpha, beta)\ny_opt = attention(x.clone(), wq.clone(), wk.clone(), wv.clone(), alpha, beta)\n\n# Where is the error largest?\nerr = (y_opt - y_ref).abs()\nmax_idx = err.argmax()\nprint(f'Max error location: {max_idx}, value: {err.max():.6e}')\nprint(f'Ref value at max err: {y_ref.flatten()[max_idx]:.6e}')\nprint(f'Tol at max err: {3e-5 + 3e-4 * abs(y_ref.flatten()[max_idx]):.6e}')\n\n# Let's check intermediate values\n# Reference intermediate\n@torch.no_grad()\ndef debug_starter(x, wq, wk, wv, alpha, beta):\n    q = torch.einsum(\\\"blc,hdc->bhld\\\", x, wq)\n    k = torch.einsum(\\\"blc,hdc->bhld\\\", x, wk)\n    logits = (q @ k.transpose(-1, -2)) / math.sqrt(wq.shape[1])\n    p0 = logits.softmax(dim=-1)\n    base = p0 @ x.unsqueeze(1)\n    perturbed = .5 * (1 + alpha) * logits + .5 * (1 - alpha) * logits.transpose(-1, -2)\n    modified = perturbed.softmax(dim=-1) @ x.unsqueeze(1)\n    blended = base + beta * (modified - base)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    y = torch.einsum(\\\"bhlc,hdc->bhld\\\", blended * ratio, wv)\n    return q, k, logits, p0, base, modified, blended, ratio, y\n\n@torch.no_grad()\ndef debug_opt(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BHL = B * H * L\n    xr = x.reshape(B * L, C)\n    w_q = wq.reshape(HD, C)\n    w_k = wk.reshape(HD, C)\n    w_qk = torch.cat([w_q, w_k], dim=0)\n    qk_flat = xr @ w_qk.T\n    q_flat, k_flat = qk_flat.split(HD, dim=1)\n    v_flat = xr @ wv.reshape(HD, C).T\n    q = q_flat.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = k_flat.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = v_flat.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    p1G = p1 @ G_exp\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    pmG = p_mix @ G_exp\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    y = (p_mix @ v).mul_(ratio)\n    return q, k, logits, p0, p1, p_mix, G, norm1, normm, ratio, y\n\nq_r, k_r, logits_r, p0_r, base_r, modified_r, blended_r, ratio_r, y_r = debug_starter(x, wq, wk, wv, alpha, beta)\nq_o, k_o, logits_o, p0_o, p1_o, pmix_o, G_o, n1_o, nm_o, ratio_o, y_o = debug_opt(x, wq, wk, wv, alpha, beta)\n\nprint(f'\\\\nq error: {(q_r - q_o).abs().max():.2e}')\nprint(f'k error: {(k_r - k_o).abs().max():.2e}')\nprint(f'logits error: {(logits_r - logits_o).abs().max():.2e}')\nprint(f'p0 error: {(p0_r - p0_o).abs().max():.2e}')\nprint(f'ratio error: {(ratio_r - ratio_o).abs().max():.2e}')\n\n# Check if q/k from combined projection are correct (vs separate)\nHD = H * D\nxr = x.reshape(B*L, C)\nw_q = wq.reshape(HD, C)\nw_k = wk.reshape(HD, C)\nq_sep = xr @ w_q.T\nk_sep = xr @ w_k.T\nw_qk = torch.cat([w_q, w_k], dim=0)\nqk_comb = xr @ w_qk.T\nq_comb, k_comb = qk_comb.split(HD, dim=1)\nprint(f'\\\\nq sep vs comb: {(q_sep - q_comb).abs().max():.2e}')\nprint(f'k sep vs comb: {(k_sep - k_comb).abs().max():.2e}')\n\n# The q/k are computed correctly. The error must be from the softmax or Gram trick.\n# Let's check p1\nprint(f'\\\\np1 error: {(logits_r.mul(0.5*(1+alpha)).add(logits_r.transpose(-1,-2), alpha=0.5*(1-alpha)).softmax(dim=-1) - p1_o).abs().max():.2e}')\n\n# Let's check the norm computation\n# Reference: modified.norm(dim=-1) = ||p1 @ x|| = sqrt((p1@x)\"'^2.sum(-1))\n# Ours: norm1 = sqrt((p1@G * p1).sum(-1))\nu1_ref = modified_r  # (B,H,L,C)\nnorm1_ref = u1_ref.norm(dim=-1, keepdim=True)\nprint(f'\"'\\\\nnorm1 ref vs opt: {(norm1_ref - n1_o).abs().max():.2e}')\n\n# Check if it's the Gram trick causing error\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\np1G = p1_o @ G_exp\nnorm1_gram = p1G.mul(p1_o).sum(dim=-1, keepdim=True).sqrt()\nnorm1_direct = (p1_o @ x.unsqueeze(1)).norm(dim=-1, keepdim=True)\nprint(f'Gram vs direct norm1: {(norm1_gram - norm1_direct).abs().max():.2e}')\n\n# Hmm the Gram trick should be exact in theory. Let's check more carefully.\nu1_direct = p1_o @ x.unsqueeze(1)  # (B,H,L,C)\nnorm1_direct = u1_direct.norm(dim=-1, keepdim=True)\nprint(f'Direct norm1 vs ref norm: {(norm1_direct - norm1_ref).abs().max():.2e}')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

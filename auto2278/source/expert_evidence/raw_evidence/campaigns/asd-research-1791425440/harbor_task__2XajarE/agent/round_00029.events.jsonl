beta)\n\ntotal = sum(times.values())\nprint(f'{\\\"Component\\\":<25} {\\\"Time (ms)\\\":>12} {\\\"%\\\":>7}')\nprint('-' * 47)\nfor name, t in sorted(times.items(), key=lambda x: -x[1]):\n    print(f'{name:<25} {t:>12.3f} {t/total*100:>6.1f}%')\nprint('-' * 47)\nprint(f'{\\\"Total\\\":<25} {total:>12.3f}')\n\n# Full function time\ndef full():\n    q = (xr @ wq_flat.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk_flat.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv_flat.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(1.0 / math.sqrt(D))\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    p1G = p1 @ G_exp\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    pmG = p_mix @ G_exp\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\nfor _ in range(3):\n    full()\nt0 = time.process_time_ns()\nfor _ in range(5):\n    full()\nt1 = time.process_time_ns()\nprint(f'\\\\nFull function (5 iters): {(t1-t0)/5/1e6:.3f} ms')\nPYEOF\n\"","aggregated_output":"Component                    Time (ms)       %\n-----------------------------------------------\nq_proj                          68.481   31.0%\nk_proj                          35.008   15.8%\npmix@v + mul_ratio              27.873   12.6%\npmix@G                          17.583    8.0%\nv_proj                          16.233    7.3%\np1@G                            16.130    7.3%\nG                               12.827    5.8%\np1_softmax                       8.474    3.8%\np0_softmax                       8.027    3.6%\np1_logits                        4.285    1.9%\nlogits                           3.835    1.7%\nlerp                             0.781    0.4%\nnorm1                            0.756    0.3%\nnormm                            0.646    0.3%\nfinal_reshape                    0.140    0.1%\nratio                            0.026    0.0%\n-----------------------------------------------\nTotal                          221.105\n\nFull function (5 iters): 187.286 ms\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_90","type":"command_execution","command":"/bin/sh -lc \"python << 'PYEOF'\nimport torch, time, math\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n# Interesting: q_proj is 68ms but k_proj is only 35ms\"'! \n# That'\"'s a huge difference even though they're identical operations\"'!\n# This must be cache / memory allocation effects.\n# The first matmul is slow, subsequent ones are faster.\n\n# If we could make the first matmul faster...\n# Or if we could combine q and k into one matmul (saving one \"cold\" matmul)...\n\n# Let me verify this effect\nB, L, C, H, D = 1, 256, 1280, 20, 64\nHD = H * D\nBL = B * L\nxr = torch.randn(BL, C) / math.sqrt(C)\nw1 = torch.randn(HD, C)\nw2 = torch.randn(HD, C)\nw3 = torch.randn(HD, C)\n\nfor trial in range(3):\n    # fresh tensors to avoid cache effects\n    xr2 = xr.clone()\n    wa = w1.clone()\n    wb = w2.clone()\n    wc = w3.clone()\n    \n    t0 = time.process_time_ns()\n    q = xr2 @ wa.T\n    t1 = time.process_time_ns()\n    k = xr2 @ wb.T\n    t2 = time.process_time_ns()\n    v = xr2 @ wc.T\n    t3 = time.process_time_ns()\n    \n    print(f'\"'Trial {trial}: q={(t1-t0)/1e6:.2f}ms k={(t2-t1)/1e6:.2f}ms v={(t3-t2)/1e6:.2f}ms')\n    # Clean up\n    del q, k, v, xr2, wa, wb, wc\n\n# Wow, q projection is consistently slower because it's \\\"cold\\\"\n# If we combine q and k into one matmul, we only pay the cold cost once.\n# Let me test that.\n\nprint()\nfor trial in range(3):\n    xr2 = xr.clone()\n    wa = w1.clone()\n    wb = w2.clone()\n    wc = w3.clone()\n    \n    # Combined q+k\n    t0 = time.process_time_ns()\n    wqk = torch.cat([wa, wb], dim=0)\n    qk = xr2 @ wqk.T\n    q2, k2 = qk.split(HD, dim=1)\n    t1 = time.process_time_ns()\n    v2 = xr2 @ wc.T\n    t2 = time.process_time_ns()\n    \n    print(f'Trial {trial}: q+k_combined={(t1-t0)/1e6:.2f}ms v={(t2-t1)/1e6:.2f}ms total={(t2-t0)/1e6:.2f}ms')\n    del q2, k2, v2\n\n# Summary:\n# 3 separate: 68 + 35 + 16 = 119ms (but order-dependent)\n# 2 combined+1: ?\n# Let me check total\nprint()\nprint('Compare totals:')\nfor trial in range(3):\n    xr2 = xr.clone()\n    wa = w1.clone()\n    wb = w2.clone()\n    wc = w3.clone()\n    \n    t0 = time.process_time_ns()\n    q = xr2 @ wa.T\n    k = xr2 @ wb.T\n    v = xr2 @ wc.T\n    t1 = time.process_time_ns()\n    print(f'Trial {trial} 3-separate: {(t1-t0)/1e6:.2f}ms')\n    \n    xr3 = xr.clone()\n    wa2 = w1.clone()\n    wb2 = w2.clone()\n    wc2 = wc.clone()\n    \n    t0 = time.process_time_ns()\n    wqk2 = torch.cat([wa2, wb2], dim=0)\n    qk = xr3 @ wqk2.T\n    q2, k2 = qk.split(HD, dim=1)\n    v2 = xr3 @ wc2.T\n    t1 = time.process_time_ns()\n    print(f'Trial {trial} 2+1: {(t1-t0)/1e6:.2f}ms')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

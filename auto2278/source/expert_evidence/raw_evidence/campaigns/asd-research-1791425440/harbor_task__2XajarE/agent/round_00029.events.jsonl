{"type":"item.started","item":{"id":"item_60","type":"command_execution","command":"/bin/sh -lc \"cat > /workspace/solution/method.py << 'PYEOF'\n\\\"\\\"\\\"Optimized multihead retrieval kernel: v-space projections, Gram norms, stacked p@G.\\\"\\\"\\\"\nimport math\nimport torch\n\n\n@torch.no_grad()\ndef attention(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BHL = B * H * L\n    xr = x.reshape(B * L, C)\n\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n\n    p0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1_logits = logits.mul(a_p)\n        p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n        p1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n\n        # Compute Gram matrix early\n        G = x @ x.transpose(-1, -2)\n\n        # Stack p0 and p1 along head dim for single combined p@G matmul\n        p_stack = torch.cat([p0, p1], dim=1)\n        G_exp = G.unsqueeze(1).expand(B, 2 * H, L, L)\n        pG_stack = p_stack @ G_exp\n        p0G = pG_stack[:, :H, :, :]\n        p1G = pG_stack[:, H:, :, :]\n\n        # norm1 = sqrt((p1G * p1).sum(-1))\n        norm1_sq = p1G.mul(p1).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n\n        # norm_m where m = p_mix @ x = (1-beta)*u0 + beta*u1\n        # ||m||\"'^2 = (1-b)''^2 * ||u0||''^2 + b''^2 * ||u1||''^2 + 2*(1-b)*b * <u0, u1>\n        # ||u0||''^2 = (p0G * p0).sum(-1)\n        # ||u1||''^2 = (p1G * p1).sum(-1) = norm1_sq  (note: was modified in-place! use fresh)\n        # <u0, u1> = (p0G * p1).sum(-1) = (p1G * p0).sum(-1)\n        one_minus_b = 1.0 - beta\n        norm0_sq = p0G.mul(p0).sum(dim=-1, keepdim=True)\n        cross = p0G.mul(p1).sum(dim=-1, keepdim=True)\n        # Recompute norm1_sq (norm1_sq was modified by sqrt_ above)\n        norm1_sq_val = p1G.mul(p1).sum(dim=-1, keepdim=True)\n        normm_sq = (one_minus_b * one_minus_b) * norm0_sq + (beta * beta) * norm1_sq_val + 2.0 * one_minus_b * beta * cross\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n\n        # Output: p_mix @ v = (1-beta)*(p0@v) + beta*(p1@v)\n        y0 = p0 @ v\n        y1 = p1 @ v\n        y = y0.lerp_(y1, beta).mul_(ratio)\n\n    return y.transpose(1, 2).flatten(2).contiguous()\nPYEOF\necho \"Written\"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}

L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BH = B * H\n    xr = x.reshape(B * L, C)\n    w_qkv = torch.cat([wq.reshape(HD, C), wk.reshape(HD, C), wv.reshape(HD, C)], dim=0)\n    qkv = xr @ w_qkv.T\n    q_flat, k_flat, v_flat = qkv.split([HD, HD, HD], dim=1)\n    q = q_flat.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous().reshape(BH, L, D)\n    k = k_flat.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous().reshape(BH, L, D)\n    v = v_flat.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous().reshape(BH, L, D)\n    logits = torch.bmm(q, k.transpose(1, 2))\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(1, 2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.expand(BH, L, L)\n    # Stack p0 and p1 for single bmm with G\n    p_stacked = torch.cat([p0, p1], dim=0)\n    G_stacked = G.expand(2 * BH, L, L)\n    pG_stacked = torch.bmm(p_stacked, G_stacked)\n    p0G = pG_stacked[:BH]\n    p1G = pG_stacked[BH:]\n    # norm1_sq = (p1G * p1).sum(-1)\n    norm1_sq = p1G.mul(p1).sum(dim=-1, keepdim=True)\n    # normm_sq = ((1-beta)\"'^2 * (p0G*p0).sum + beta''^2 * (p1G*p1).sum + ...\n    # (1-beta)*beta * ((p0G*p1).sum + (p1G*p0).sum))\n    # Note: (p0G * p1).sum(-1) = (p1G * p0).sum(-1) because G is symmetric\n    # Actually: p0G = p0 @ G, p1G = p1 @ G\n    # (p0G * p1).sum = sum_j (sum_k p0_ik G_kj) * p1_ij\n    # (p1G * p0).sum = sum_j (sum_k p1_ik G_kj) * p0_ij\n    # These are equal because G is symmetric: G_kj = G_jk\n    # Let'\"'s verify: sum_j sum_k p0_ik G_kj p1_ij = sum_k sum_j p0_ik G_jk p1_ij = sum_k p0_ik sum_j p1_ij G_jk\n    # vs sum_j sum_k p1_ik G_kj p0_ij = sum_k p0_ik sum_j p1_ij G_kj\n    # These are equal since G_jk = G_kj. Yes\"'!\n    one_minus_b = 1.0 - beta\n    cross = p0G.mul(p1).sum(dim=-1, keepdim=True)\n    normm_sq = (one_minus_b * one_minus_b) * p0G.mul(p0).sum(dim=-1, keepdim=True) '\"\\\\\n               + (beta * beta) * norm1_sq \\\\\n               + 2.0 * one_minus_b * beta * cross\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    # Output: p_mix @ v = (1-beta)*(p0@v) + beta*(p1@v)\n    y0 = torch.bmm(p0, v)\n    y1 = torch.bmm(p1, v)\n    y = y0.lerp_(y1, beta).mul_(ratio)\n    return y.reshape(B, H, L, D).transpose(1, 2).flatten(2).contiguous()\n\ny_v4 = attention_v4(x, wq, wk, wv, alpha, beta)\nprint(f'V4 max error: {(y_v4 - y_ref).abs().max():.2e}')\nbench('V4 (stacked p0/p1@G, no pmix)', lambda: attention_v4(x, wq, wk, wv, alpha, beta))\n\nprint('\\\\n--- Case 4: L=256, C=640, H=10 ---')\nB2, L2, C2, H2, D2 = 1, 256, 640, 10, 64\nx2 = torch.randn(B2, L2, C2)\nwq2 = torch.randn(H2, D2, C2)\nwk2 = torch.randn(H2, D2, C2)\nwv2 = torch.randn(H2, D2, C2)\nbench('Ref case4', lambda: attention_ref(x2, wq2, wk2, wv2, alpha, beta))\nbench('V2 case4', lambda: attention_v2(x2, wq2, wk2, wv2, alpha, beta))\nbench('V3 case4', lambda: attention_v3(x2, wq2, wk2, wv2, alpha, beta))\nbench('V4 case4', lambda: attention_v4(x2, wq2, wk2, wv2, alpha, beta))\nPYEOF\n\"","aggregated_output":"Reference: 159.35 ms\nV2 max error: 0.00e+00\nV2 (bmm + stacked qkv): 148.12 ms\nV3 max error: 0.00e+00\nV3 (stacked p@G): 208.66 ms\nV4 max error: 9.38e-04\nV4 (stacked p0/p1@G, no pmix): 162.43 ms\n\n--- Case 4: L=256, C=640, H=10 ---\nRef case4: 61.41 ms\nV2 case4: 72.00 ms\nV3 case4: 60.21 ms\nV4 case4: 73.92 ms\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/sh -lc \"python << 'PYEOF'\nimport torch, time, math\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\nBH = B * H\n\ntorch.manual_seed(42)\np0 = torch.randn(BH, L, L).softmax(dim=-1)\np1 = torch.randn(BH, L, L).softmax(dim=-1)\nG = torch.randn(B, L, L)\nG_exp = G.expand(BH, L, L)\n\ndef bench(name, fn, n=5):\n    for _ in range(3):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    print(f'{name}: {(t1-t0)/n/1e6:.2f} ms')\n\n# 2 separate bmm calls\ndef two_bmm():\n    a = torch.bmm(p0, G_exp)\n    b = torch.bmm(p1, G_exp)\n    return a, b\n\nbench('2 separate bmm', two_bmm)\n\n# 1 stacked bmm\ndef stacked_bmm():\n    p_stacked = torch.cat([p0, p1], dim=0)\n    G_stacked = G.expand(2 * BH, L, L)\n    out = torch.bmm(p_stacked, G_stacked)\n    return out[:BH], out[BH:]\n\nbench('1 stacked bmm', stacked_bmm)\n\n# What about addbmm?\ndef addbmm_test():\n    # addbmm: (n, M, K) @ (n, K, N) -> (M, N) summed over n\n    # Not applicable here\n    pass\n\n# 4D broadcast matmul\np0_4d = p0.view(B, H, L, L)\np1_4d = p1.view(B, H, L, L)\nG_4d = G.view(B, 1, L, L)\n\ndef broadcast_4d():\n    a = p0_4d @ G_4d\n    b = p1_4d @ G_4d\n    return a, b\n\nbench('4D broadcast matmul', broadcast_4d)\n\n# What about the current approach in the solution?\ndef current_4d():\n    G_exp_4d = G.unsqueeze(1)\n    a = p0_4d @ G_exp_4d\n    b = p1_4d @ G_exp_4d\n    return a, b\n\nbench('current 4D (unsqueeze)', current_4d)\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

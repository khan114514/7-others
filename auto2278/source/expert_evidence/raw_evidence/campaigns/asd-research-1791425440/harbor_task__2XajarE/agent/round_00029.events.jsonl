ngle matmul\n    w_q = wq.reshape(HD, C)\n    w_k = wk.reshape(HD, C)\n    w_qk = torch.cat([w_q, w_k], dim=0)\n    qk_flat = xr @ w_qk.T\n    q_flat, k_flat = qk_flat.split(HD, dim=1)\n\n    # Reshape + permute q and k\n    q = q_flat.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = k_flat.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\n    # v separately\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1_logits = logits.mul(a_p)\n        p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n        p1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n\n        p_mix = torch.lerp(p0, p1, beta)\n        \n        p1G = p1 @ G_exp\n        norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n\n        pmG = p_mix @ G_exp\n        normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n        y = (p_mix @ v).mul_(ratio)\n\n    return y.transpose(1, 2).flatten(2).contiguous()\n\nseed = 17\nfor ci, case in enumerate(cases):\n    x, wq, wk, wv, alpha, beta = generate(case, seed * 1000 + ci)\n    \n    # Verify correctness\n    y_best = best.attention(x, wq, wk, wv, alpha, beta)\n    y_opt = opt_v2(x.clone(), wq.clone(), wk.clone(), wv.clone(), alpha, beta)\n    err = (y_opt - y_best).abs().max()\n    \n    for _ in range(3):\n        best.attention(x, wq, wk, wv, alpha, beta)\n        opt_v2(x, wq, wk, wv, alpha, beta)\n    \n    n = 11\n    best_times = []\n    opt_times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        best.attention(x, wq, wk, wv, alpha, beta)\n        best_times.append((time.process_time_ns() - t0) / 1e6)\n        \n        t0 = time.process_time_ns()\n        opt_v2(x, wq, wk, wv, alpha, beta)\n        opt_times.append((time.process_time_ns() - t0) / 1e6)\n    \n    best_times.sort()\n    opt_times.sort()\n    bm = best_times[n//2]\n    om = opt_times[n//2]\n    print(f'Case {ci}: best={bm:.2f}ms opt={om:.2f}ms ratio={om/bm:.4f} err={err:.2e}')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

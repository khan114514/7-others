{"type":"item.started","item":{"id":"item_80","type":"command_execution","command":"/bin/sh -lc \"python << 'PYEOF'\nimport torch, time, math\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n# Interesting: 3 separate is 48ms, stacked pre-cat is 60ms (SLOWER).\n# The stacked version is slower even without the cat\"'!\n# Why? Because the bigger matrix might have worse cache behavior.\n\n# Let me check for smaller cases too.\nfor L, C, H, D in [(64, 512, 8, 64), (128, 640, 10, 64), (128, 1280, 20, 64), (256, 640, 10, 64), (256, 512, 8, 64)]:\n    HD = H * D\n    BL = L\n    xr = torch.randn(BL, C) / math.sqrt(C)\n    w1 = torch.randn(HD, C)\n    w2 = torch.randn(HD, C)\n    w3 = torch.randn(HD, C)\n    w_all = torch.cat([w1, w2, w3], dim=0)\n    \n    for _ in range(3):\n        xr @ w1.T\n        xr @ w_all.T\n    \n    n = 20\n    t3 = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        xr @ w1.T\n        xr @ w2.T\n        xr @ w3.T\n        t3.append((time.process_time_ns() - t0) / 1e6)\n    t3.sort()\n    \n    ts = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        xr @ w_all.T\n        ts.append((time.process_time_ns() - t0) / 1e6)\n    ts.sort()\n    \n    print(f'\"'L={L} C={C} H={H}: 3mat={t3[n//2]:.3f}ms stacked={ts[n//2]:.3f}ms ratio={ts[n//2]/t3[n//2]:.3f}')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

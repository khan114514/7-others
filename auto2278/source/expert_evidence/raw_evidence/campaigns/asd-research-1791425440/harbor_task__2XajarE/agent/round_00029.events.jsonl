{"type":"item.started","item":{"id":"item_78","type":"command_execution","command":"/bin/sh -lc \"python << 'PYEOF'\nimport torch, time, math\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n# The 4D broadcast result varies wildly. Let me check more carefully.\n# Earlier I got 8ms, now 17ms. Must be measurement noise.\n\nB, H, L = 1, 10, 256\n\n# Run many iterations and take median of medians\nresults = []\nfor trial in range(5):\n    a = torch.randn(B, H, L, L)\n    b = torch.randn(B, 1, L, L)\n    \n    # warm up\n    for _ in range(10):\n        a @ b\n    \n    times = []\n    for _ in range(50):\n        t0 = time.process_time_ns()\n        c = a @ b\n        times.append((time.process_time_ns() - t0) / 1e6)\n    times.sort()\n    results.append(times[25])\n\nresults.sort()\nprint(f'4D broadcast medians: {[f\\\"{r:.2f}\\\" for r in results]}')\nprint(f'median of medians: {results[2]:.3f} ms')\n\n# Same for bmm\nBH = B * H\na_3d = torch.randn(BH, L, L)\nb_3d = torch.randn(L, L)\nb_exp = b_3d.expand(BH, L, L).contiguous()\n\nresults2 = []\nfor trial in range(5):\n    for _ in range(10):\n        torch.bmm(a_3d, b_exp)\n    times = []\n    for _ in range(50):\n        t0 = time.process_time_ns()\n        c = torch.bmm(a_3d, b_exp)\n        times.append((time.process_time_ns() - t0) / 1e6)\n    times.sort()\n    results2.append(times[25])\n\nresults2.sort()\nprint(f'bmm medians: {[f\\\"{r:.2f}\\\" for r in results2]}')\nprint(f'median of medians: {results2[2]:.3f} ms')\n\n# Same for current best 4D approach (p @ G where G_exp = G.unsqueeze(1))\nG = torch.randn(B, L, L)\nG_exp = G.unsqueeze(1)\np = torch.randn(B, H, L, L)\n\nresults3 = []\nfor trial in range(5):\n    for _ in range(10):\n        p @ G_exp\n    times = []\n    for _ in range(50):\n        t0 = time.process_time_ns()\n        c = p @ G_exp\n        times.append((time.process_time_ns() - t0) / 1e6)\n    times.sort()\n    results3.append(times[25])\n\nresults3.sort()\nprint(f'4D (G.unsqueeze(1)) medians: {[f\\\"{r:.2f}\\\" for r in results3]}')\nprint(f'median of medians: {results3[2]:.3f} ms')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

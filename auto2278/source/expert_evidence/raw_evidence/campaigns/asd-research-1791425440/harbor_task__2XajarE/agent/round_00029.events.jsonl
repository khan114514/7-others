{"type":"item.started","item":{"id":"item_73","type":"command_execution","command":"/bin/sh -lc \"python << 'PYEOF'\nimport torch, time, math\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\nHD = H * D\nBH = B * H\nBHL = BH * L\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C) / math.sqrt(C)\nxr = x.reshape(B * L, C)\n\n# Profile individual parts\nwq = torch.randn(H, D, C) / math.sqrt(C)\nwk = torch.randn(H, D, C) / math.sqrt(C)\nwv = torch.randn(H, D, C) / math.sqrt(C)\n\nwq_flat = wq.reshape(HD, C)\nwk_flat = wk.reshape(HD, C)\nwv_flat = wv.reshape(HD, C)\n\ndef bench(name, fn, n=10):\n    for _ in range(3):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    print(f'{name}: {(t1-t0)/n/1e6:.3f} ms')\n\n# Q projection alone\nq = (xr @ wq_flat.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nbench('q proj + permute', lambda: (xr @ wq_flat.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous())\n\n# All 3 projections\nbench('3 proj (q,k,v)', lambda: (\n    (xr @ wq_flat.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous(),\n    (xr @ wk_flat.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous(),\n    (xr @ wv_flat.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous(),\n))\n\n# qk\"'^T + scale\nk = q.clone()\nbench('\"'qk\"'^T + scale'\"', lambda: (q @ k.transpose(-1, -2)).mul_(1.0/math.sqrt(D)))\n\n# logits for softmax timing\nlogits = (q @ k.transpose(-1, -2)) * (1.0/math.sqrt(D))\n\n# softmax\nbench('softmax (2D view)', lambda: logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L))\nbench('softmax (4D)', lambda: logits.softmax(dim=-1))\n\n# p1 logits computation\na_p = 0.5 * (1 + alpha)\na_m = 0.5 * (1 - alpha)\nbench('p1_logits (mul + add_)', lambda: logits.mul(a_p).add_(logits.transpose(-1, -2), alpha=a_m))\n\n# p1 softmax\np1_logits = logits.mul(a_p)\np1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\nbench('p1 softmax', lambda: p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L))\n\np0 = logits.softmax(dim=-1)\np1 = p1_logits.softmax(dim=-1)\n\n# lerp\nbench('lerp p_mix', lambda: torch.lerp(p0, p1, beta))\np_mix = torch.lerp(p0, p1, beta)\n\n# G\nbench('G = xx\"'^T'\"', lambda: x @ x.transpose(-1, -2))\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\n\n# p1 @ G\nbench('p1 @ G', lambda: p1 @ G_exp)\np1G = p1 @ G_exp\n\n# p_mix @ G\nbench('p_mix @ G', lambda: p_mix @ G_exp)\n\n# norm computation (mul + sum + sqrt + clamp)\nbench('norm (mul+sum+sqrt+clamp)', lambda: (p1G * p1).sum(dim=-1, keepdim=True).sqrt().clamp_min(1e-6))\n\n# p_mix @ v\nv = q.clone()  # just for timing\nbench('p_mix @ v', lambda: p_mix @ v)\n\nprint(f'\\\\nEstimated total: ~160ms')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_73","type":"command_execution","command":"/bin/sh -lc \"python << 'PYEOF'\nimport torch, time, math\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\nHD = H * D\nBH = B * H\nBHL = BH * L\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C) / math.sqrt(C)\nxr = x.reshape(B * L, C)\n\n# Profile individual parts\nwq = torch.randn(H, D, C) / math.sqrt(C)\nwk = torch.randn(H, D, C) / math.sqrt(C)\nwv = torch.randn(H, D, C) / math.sqrt(C)\n\nwq_flat = wq.reshape(HD, C)\nwk_flat = wk.reshape(HD, C)\nwv_flat = wv.reshape(HD, C)\n\ndef bench(name, fn, n=10):\n    for _ in range(3):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    print(f'{name}: {(t1-t0)/n/1e6:.3f} ms')\n\n# Q projection alone\nq = (xr @ wq_flat.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nbench('q proj + permute', lambda: (xr @ wq_flat.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous())\n\n# All 3 projections\nbench('3 proj (q,k,v)', lambda: (\n    (xr @ wq_flat.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous(),\n    (xr @ wk_flat.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous(),\n    (xr @ wv_flat.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous(),\n))\n\n# qk\"'^T + scale\nk = q.clone()\nbench('\"'qk\"'^T + scale'\"', lambda: (q @ k.transpose(-1, -2)).mul_(1.0/math.sqrt(D)))\n\n# logits for softmax timing\nlogits = (q @ k.transpose(-1, -2)) * (1.0/math.sqrt(D))\n\n# softmax\nbench('softmax (2D view)', lambda: logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L))\nbench('softmax (4D)', lambda: logits.softmax(dim=-1))\n\n# p1 logits computation\na_p = 0.5 * (1 + alpha)\na_m = 0.5 * (1 - alpha)\nbench('p1_logits (mul + add_)', lambda: logits.mul(a_p).add_(logits.transpose(-1, -2), alpha=a_m))\n\n# p1 softmax\np1_logits = logits.mul(a_p)\np1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\nbench('p1 softmax', lambda: p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L))\n\np0 = logits.softmax(dim=-1)\np1 = p1_logits.softmax(dim=-1)\n\n# lerp\nbench('lerp p_mix', lambda: torch.lerp(p0, p1, beta))\np_mix = torch.lerp(p0, p1, beta)\n\n# G\nbench('G = xx\"'^T'\"', lambda: x @ x.transpose(-1, -2))\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\n\n# p1 @ G\nbench('p1 @ G', lambda: p1 @ G_exp)\np1G = p1 @ G_exp\n\n# p_mix @ G\nbench('p_mix @ G', lambda: p_mix @ G_exp)\n\n# norm computation (mul + sum + sqrt + clamp)\nbench('norm (mul+sum+sqrt+clamp)', lambda: (p1G * p1).sum(dim=-1, keepdim=True).sqrt().clamp_min(1e-6))\n\n# p_mix @ v\nv = q.clone()  # just for timing\nbench('p_mix @ v', lambda: p_mix @ v)\n\nprint(f'\\\\nEstimated total: ~160ms')\nPYEOF\n\"","aggregated_output":"q proj + permute: 19.153 ms\n3 proj (q,k,v): 63.961 ms\nqk^T + scale: 4.488 ms\nsoftmax (2D view): 6.887 ms\nsoftmax (4D): 6.616 ms\np1_logits (mul + add_): 6.569 ms\np1 softmax: 7.806 ms\nlerp p_mix: 0.421 ms\nG = xx^T: 4.299 ms\np1 @ G: 13.882 ms\np_mix @ G: 13.370 ms\nnorm (mul+sum+sqrt+clamp): 0.256 ms\np_mix @ v: 2.980 ms\n\nEstimated total: ~160ms\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_74","type":"command_execution","command":"/bin/sh -lc \"python << 'PYEOF'\nimport torch, time, math\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nHD = H * D\nBH = B * H\nBHL = BH * L\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C) / math.sqrt(C)\nxr = x.reshape(B * L, C)\nw = torch.randn(H, D, C) / math.sqrt(C)\nw_flat = w.reshape(HD, C)\n\n# 1. Standard approach: matmul, then reshape, permute, contiguous\ndef approach1():\n    q = (xr @ w_flat.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    return q\n\nq1 = approach1()\nt1_times = []\nfor _ in range(20):\n    t0 = time.process_time_ns()\n    approach1()\n    t1_times.append((time.process_time_ns() - t0) / 1e6)\nt1_times.sort()\nprint(f'Approach 1 (matmul+permute+contig): {t1_times[10]:.3f} ms')\n\n# 2. Can we produce (BH, L, D) directly via bmm?\n# Reshape x to (BH, L, C) - no, x doesn't have H dim\n# Expand x to (BH, L, C)? That would use B*H*L*C memory = too much.\n\n# 3. matmul then transpose(1,2) then contiguous\ndef approach3():\n    q = (xr @ w_flat.T).reshape(B, L, H, D).transpose(1, 2).contiguous()\n    return q\n\nq3 = approach3()\nprint(f'Approach 3 same as 1: {torch.allclose(q1, q3)}')\n\n# 4. What if we use einsum? (should be slower)\ndef approach4():\n    return torch.einsum(\\\"blc,hdc->bhld\\\", x, w)\n\nt4_times = []\nfor _ in range(20):\n    t0 = time.process_time_ns()\n    approach4()\n    t4_times.append((time.process_time_ns() - t0) / 1e6)\nt4_times.sort()\nprint(f'Approach 4 (einsum): {t4_times[10]:.3f} ms')\n\n# 5. Can we use torch.nn.functional.linear?\ndef approach5():\n    return torch.nn.functional.linear(x, w_flat, None).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n# Same thing basically.\n\n# 6. What about as_strided tricks?\n# Not applicable.\n\n# Key insight: the matmul itself is 18ms, permute+contiguous is tiny.\n# The matmul (BL, C) @ (HD, C)\"'^T is the cost.\n# For B=1, L=256, C=1280, H=20, D=64: BL=256, HD=1280\n# (256, 1280) @ (1280, 1280) = 256*1280*1280 = 419M ops\n\n# Three of these = 1.26B ops. At 50 GFLOPS: 25ms. But measured is 64ms.\n# So we'\"'re getting ~20 GFLOPS for these small-ish matmuls.\n\n# Can we make one big matmul instead of 3? \n# w_all = cat([wq, wk, wv], dim=0) → (3*HD, C) = (3840, 1280)\n# qkv = xr @ w_all.T → (256, 3840)\n# 256 * 1280 * 3840 = 1.26B ops total (same as 3 separate)\n# But one big matmul might be more efficient than 3 small ones.\n\n# Let's test:\nw_all = torch.cat([w_flat, w_flat, w_flat], dim=0)  # (3*HD, C)\ndef approach_stacked():\n    qkv = xr @ w_all.T\n    return qkv.split(HD, dim=1)\n\nt_stack = []\nfor _ in range(20):\n    t0 = time.process_time_ns()\n    approach_stacked()\n    t_stack.append((time.process_time_ns() - t0) / 1e6)\nt_stack.sort()\nprint(f'Approach stacked (1 matmul): {t_stack[10]:.3f} ms')\n\n# Wait but the cat is outside the timing. In real code, cat is inside.\n# Let's include cat:\ndef approach_stacked_with_cat():\n    wa = torch.cat([w_flat, w_flat, w_flat], dim=0)\n    qkv = xr @ wa.T\n    return qkv.split(HD, dim=1)\n\nt_stack2 = []\nfor _ in range(20):\n    t0 = time.process_time_ns()\n    approach_stacked_with_cat()\n    t_stack2.append((time.process_time_ns() - t0) / 1e6)\nt_stack2.sort()\nprint(f'Approach stacked (with cat): {t_stack2[10]:.3f} ms')\n\n# What about only stacking q and k (2 instead of 3)?\nw_qk = torch.cat([w_flat, w_flat], dim=0)\ndef approach_qk():\n    qk = xr @ w_qk.T\n    return qk.split(HD, dim=1)\n\nt_qk = []\nfor _ in range(20):\n    t0 = time.process_time_ns()\n    approach_qk()\n    t_qk.append((time.process_time_ns() - t0) / 1e6)\nt_qk.sort()\nprint(f'Approach qk stacked (pre-cat): {t_qk[10]:.3f} ms (vs 2*19 = 38ms for two separate)')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

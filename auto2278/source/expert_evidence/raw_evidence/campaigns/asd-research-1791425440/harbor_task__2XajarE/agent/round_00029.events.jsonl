{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/sh -lc \"python << 'PYEOF'\nimport torch, math\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 64, 512, 8, 64\nalpha, beta = 1.05, 5.0\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\n@torch.no_grad()\ndef attention_stacked(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BHL = B * H * L\n    xr = x.reshape(B * L, C)\n\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1_logits = logits.mul(a_p)\n        p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n        p1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n\n        G = x @ x.transpose(-1, -2)\n        p_stack = torch.cat([p1, p0], dim=1)\n        G_stack = G.unsqueeze(1).expand(B, 2 * H, L, L)\n        pG_stack = p_stack @ G_stack\n        p1G = pG_stack[:, :H, :, :]\n        p0G = pG_stack[:, H:, :, :]\n\n        norm1_sq = p1G.mul(p1).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        \n        one_minus_b = 1.0 - beta\n        cross = p0G.mul(p1).sum(dim=-1, keepdim=True)\n        norm0_sq = p0G.mul(p0).sum(dim=-1, keepdim=True)\n        normm_sq = one_minus_b * one_minus_b * norm0_sq + beta * beta * norm1_sq + 2.0 * one_minus_b * beta * cross\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n\n        y0 = p0 @ v\n        y1 = p1 @ v\n        y = y0.lerp_(y1, beta).mul_(ratio)\n\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ny = attention_stacked(x, wq, wk, wv, alpha, beta)\nprint(f'output has nan: {torch.isnan(y).any()}')\nprint(f'output shape: {y.shape}')\nprint(f'output min: {y.min()}, max: {y.max()}')\n\n# Let me check where nan comes from - step by step\n@torch.no_grad()\ndef debug(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BHL = B * H * L\n    xr = x.reshape(B * L, C)\n\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    print(f'q nan: {torch.isnan(q).any()}')\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\n    logits = q @ k.transpose(-1, -2)\n    print(f'logits nan: {torch.isnan(logits).any()}')\n    logits.mul_(inv_sqrt_d)\n    print(f'logits scaled nan: {torch.isnan(logits).any()}')\n    p0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    print(f'p0 nan: {torch.isnan(p0).any()}')\n\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    print(f'p1_logits mul nan: {torch.isnan(p1_logits).any()}')\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    print(f'p1_logits add nan: {torch.isnan(p1_logits).any()}')\n    p1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    print(f'p1 nan: {torch.isnan(p1).any()}')\n\n    G = x @ x.transpose(-1, -2)\n    print(f'G nan: {torch.isnan(G).any()}')\n    p_stack = torch.cat([p1, p0], dim=1)\n    print(f'p_stack nan: {torch.isnan(p_stack).any()}')\n    G_stack = G.unsqueeze(1).expand(B, 2 * H, L, L)\n    pG_stack = p_stack @ G_stack\n    print(f'pG_stack nan: {torch.isnan(pG_stack).any()}')\n    p1G = pG_stack[:, :H, :, :]\n    p0G = pG_stack[:, H:, :, :]\n\n    norm1_sq = p1G.mul(p1).sum(dim=-1, keepdim=True)\n    print(f'norm1_sq nan: {torch.isnan(norm1_sq).any()}, min: {norm1_sq.min()}')\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    print(f'norm1 nan: {torch.isnan(norm1).any()}')\n    \n    one_minus_b = 1.0 - beta\n    cross = p0G.mul(p1).sum(dim=-1, keepdim=True)\n    print(f'cross nan: {torch.isnan(cross).any()}')\n    norm0_sq = p0G.mul(p0).sum(dim=-1, keepdim=True)\n    print(f'norm0_sq nan: {torch.isnan(norm0_sq).any()}, min: {norm0_sq.min()}')\n    \n    # THIS might be the issue: beta * beta * norm1_sq where norm1_sq was modified in-place\"'!\n    # We did norm1_sq.sqrt_() which modifies norm1_sq IN PLACE\n    # So when we compute beta * beta * norm1_sq, norm1_sq now contains sqrt values, not squared values!\n    print(f'\"'norm1_sq after sqrt_: min={norm1_sq.min()}, max={norm1_sq.max()}')\n    \n    normm_sq = one_minus_b * one_minus_b * norm0_sq + beta * beta * norm1_sq + 2.0 * one_minus_b * beta * cross\n    print(f'normm_sq nan: {torch.isnan(normm_sq).any()}, min: {normm_sq.min()}')\n\ndebug(x, wq, wk, wv, alpha, beta)\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

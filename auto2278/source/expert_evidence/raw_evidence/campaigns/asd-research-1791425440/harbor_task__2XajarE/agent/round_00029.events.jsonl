{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/sh -lc \"python << 'PYEOF'\nimport torch, time, math\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n# Let's just do a careful end-to-end comparison of the current solution\n# vs a slightly optimized one, measuring total time per case.\n\n@torch.no_grad()\ndef attention_current(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BHL = B * H * L\n    xr = x.reshape(B * L, C)\n\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n\n    p0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1_logits = logits.mul(a_p)\n        p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n        p1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n\n        p_mix = torch.lerp(p0, p1, beta)\n\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n\n        p1G = p1 @ G_exp\n        norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n\n        y = (p_mix @ v).mul_(ratio)\n\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Optimized: use 4D softmax, pre-compute things differently\n@torch.no_grad()\ndef attention_v2(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    xr = x.reshape(B * L, C)\n\n    w_q = wq.reshape(HD, C)\n    w_k = wk.reshape(HD, C)\n    w_v = wv.reshape(HD, C)\n\n    q_flat = xr @ w_q.T\n    k_flat = xr @ w_k.T\n    v_flat = xr @ w_v.T\n\n    # Reshape to (B, H, L, D) via reshape+permute\n    q = q_flat.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = k_flat.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = v_flat.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n\n    p0 = logits.softmax(dim=-1)\n\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        \n        # Fuse p1_logits: a_p * logits + a_m * logits\"'^T\n        p1_logits = logits.mul(a_p)\n        p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n        p1 = p1_logits.softmax(dim=-1)\n\n        # Compute G earlier (can be done in parallel with other things in theory)\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n\n        # p_mix = (1-beta)*p0 + beta*p1\n        p_mix = torch.lerp(p0, p1, beta)\n\n        p1G = p1 @ G_exp\n        norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n        \n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n\n        y = (p_mix @ v).mul_(ratio)\n\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ncases = [\n    (1, 64, 512, 8, 64, 1.05, 5.0),\n    (1, 128, 640, 10, 64, 1.1, 4.0),\n    (1, 128, 1280, 20, 64, 1.15, 3.0),\n    (1, 256, 1280, 20, 64, 1.05, 7.5),\n    (1, 256, 640, 10, 64, 1.2, 5.0),\n    (2, 128, 512, 8, 64, 1.0, 5.0),\n]\n\nfor i, (B, L, C, H, D, alpha, beta) in enumerate(cases):\n    torch.manual_seed(42 + i)\n    x = torch.randn(B, L, C)\n    wq = torch.randn(H, D, C)\n    wk = torch.randn(H, D, C)\n    wv = torch.randn(H, D, C)\n\n    y_curr = attention_current(x, wq, wk, wv, alpha, beta)\n    y_v2 = attention_v2(x, wq, wk, wv, alpha, beta)\n    err = (y_v2 - y_curr).abs().max()\n\n    # Warmup\n    for _ in range(3):\n        attention_current(x, wq, wk, wv, alpha, beta)\n        attention_v2(x, wq, wk, wv, alpha, beta)\n\n    n = 11\n    samples_curr = []\n    samples_v2 = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        attention_current(x, wq, wk, wv, alpha, beta)\n        samples_curr.append((time.process_time_ns() - t0) / 1e6)\n        \n        t0 = time.process_time_ns()\n        attention_v2(x, wq, wk, wv, alpha, beta)\n        samples_v2.append((time.process_time_ns() - t0) / 1e6)\n\n    samples_curr.sort()\n    samples_v2.sort()\n    med_curr = samples_curr[n//2]\n    med_v2 = samples_v2[n//2]\n    \n    print(f'\"'Case {i}: B={B} L={L} C={C} H={H} alpha={alpha}')\n    print(f'  curr={med_curr:.2f}ms v2={med_v2:.2f}ms ratio={med_v2/med_curr:.4f} err={err:.2e}')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

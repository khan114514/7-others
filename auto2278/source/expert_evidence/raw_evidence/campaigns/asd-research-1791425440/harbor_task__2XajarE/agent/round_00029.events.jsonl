ted_output":"Written method.py\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_68","type":"command_execution","command":"/bin/sh -lc \"python << 'PYEOF'\nimport torch, math, sys\nimport importlib.util\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\ndef generate(case, seed):\n    g = torch.Generator().manual_seed(seed)\n    b, l, c, h, d = (case[k] for k in (\\\"batch\\\", \\\"length\\\", \\\"channels\\\", \\\"heads\\\", \\\"dim\\\"))\n    x = torch.randn(b, l, c, generator=g) * case.get(\\\"input_scale\\\", 1.)\n    weights = [torch.randn(h, d, c, generator=g) / math.sqrt(c) for _ in range(3)]\n    return x, *weights, case[\\\"alpha\\\"], case[\\\"beta\\\"]\n\ncases = [\n    {\\\"batch\\\": 1, \\\"length\\\": 64, \\\"channels\\\": 512, \\\"heads\\\": 8, \\\"dim\\\": 64, \\\"alpha\\\": 1.05, \\\"beta\\\": 5.0},\n    {\\\"batch\\\": 1, \\\"length\\\": 128, \\\"channels\\\": 640, \\\"heads\\\": 10, \\\"dim\\\": 64, \\\"alpha\\\": 1.1, \\\"beta\\\": 4.0},\n    {\\\"batch\\\": 1, \\\"length\\\": 128, \\\"channels\\\": 1280, \\\"heads\\\": 20, \\\"dim\\\": 64, \\\"alpha\\\": 1.15, \\\"beta\\\": 3.0},\n    {\\\"batch\\\": 1, \\\"length\\\": 256, \\\"channels\\\": 1280, \\\"heads\\\": 20, \\\"dim\\\": 64, \\\"alpha\\\": 1.05, \\\"beta\\\": 7.5},\n    {\\\"batch\\\": 1, \\\"length\\\": 256, \\\"channels\\\": 640, \\\"heads\\\": 10, \\\"dim\\\": 64, \\\"alpha\\\": 1.2, \\\"beta\\\": 5.0},\n    {\\\"batch\\\": 2, \\\"length\\\": 128, \\\"channels\\\": 512, \\\"heads\\\": 8, \\\"dim\\\": 64, \\\"alpha\\\": 1.0, \\\"beta\\\": 5.0},\n]\n\nspec_starter = importlib.util.spec_from_file_location(\\\"starter\\\", \\\"/workspace/environment/starter/method.py\\\")\nstarter = importlib.util.module_from_spec(spec_starter)\nspec_starter.loader.exec_module(starter)\n\nsys.path.insert(0, '/workspace/solution')\nfrom method import attention\n\nall_ok = True\nfor seed in [17, 29, 43, 71, 101]:\n    for ci, case in enumerate(cases):\n        x, wq, wk, wv, alpha, beta = generate(case, seed * 1000 + ci)\n        y_ref = starter.attention(x, wq, wk, wv, alpha, beta)\n        y_opt = attention(x.clone(), wq.clone(), wk.clone(), wv.clone(), alpha, beta)\n        err = (y_opt - y_ref).abs().max()\n        tol = 3e-5 + 3e-4 * y_ref.abs()\n        max_viol = ((y_opt - y_ref).abs() - tol).max()\n        if max_viol > 0:\n            print(f'Seed {seed} case {ci}: FAIL err={err:.2e} viol={max_viol:.2e}')\n            all_ok = False\n\nprint(f'All pass: {all_ok}')\nPYEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

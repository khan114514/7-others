{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport importlib.util\nimport math\nimport time\nimport torch\nspec = importlib.util.spec_from_file_location('method', '/workspace/solution/method.py')\nm = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(m)\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\nx = torch.randn(2,128,512)\nweights = [torch.randn(8,64,512)/math.sqrt(512) for _ in range(3)]\n\ndef fused(x,wq,wk,wv,alpha,beta):\n    q,k,v,_ = m.project_qkv(x,wq,wk,wv)\n    y = torch.nn.functional.scaled_dot_product_attention(q.contiguous(),k.contiguous(),v.contiguous())\n    return y.transpose(1,2).flatten(2).contiguous()\n\nwith torch.inference_mode():\n    expected = m.attention(x,*weights,1.0,5.0)\n    actual = fused(x,*weights,1.0,5.0)\n    print('maximum error', float((actual-expected).abs().max()), 'valid', torch.allclose(actual,expected,atol=3e-5,rtol=3e-4))\n    for name,fn in [('current',m.attention),('fused',fused)]:\n        for _ in range(3): fn(x,*weights,1.0,5.0)\n        start = time.process_time_ns()\n        for _ in range(15): fn(x,*weights,1.0,5.0)\n        print(name, (time.process_time_ns()-start)/15e6)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.completed","item":{"id":"item_13","type":"agent_message","text":"The kernel already shares a Cholesky factor of the token Gram matrix across heads. I’ll test transposing its norm contractions so each panel produces a `(panel, rows)` tensor; this preserves the algebra while changing the matrix multiplication and reduction layout.\n"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport importlib.util\nimport time\nimport torch\nspec = importlib.util.spec_from_file_location('method', '/workspace/solution/method.py')\nm = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(m)\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\ndef transposed_norms(coefficients, factor):\n    b, rows, length = coefficients.shape\n    heads = rows // (2 * length)\n    if b == 1 and length == 128 and heads >= 20:\n        projected = torch.mm(factor[0].t(), coefficients[0].t())\n        return projected.square_().sum(dim=0).reshape(1, rows, 1).clamp_min_(1e-12)\n    squared = coefficients.new_zeros((b, rows, 1))\n    for start in range(0, length, 64):\n        end = min(start + 64, length)\n        if b == 1 and length >= 256 and heads >= 20:\n            projected = torch.mm(factor[0, start:, start:end].t(), coefficients[0, :, start:].t())\n            squared[0, :, 0].add_(projected.square_().sum(dim=0))\n        else:\n            projected = torch.bmm(factor[:, start:, start:end].transpose(1, 2), coefficients[:, :, start:].transpose(1, 2))\n            squared.add_(projected.square_().sum(dim=1).unsqueeze(-1))\n    return squared.clamp_min_(1e-12)\n\nwith torch.inference_mode():\n    for length, channels, heads in [(128,640,10),(128,1280,20),(256,1280,20),(256,640,10)]:\n        x = torch.randn(1, length, channels)\n        factor = torch.linalg.cholesky(x @ x.transpose(1,2))\n        coefficients = torch.randn(1,2*heads*length,length).softmax(-1)\n        expected = m.factored_norms(coefficients, factor)\n        actual = transposed_norms(coefficients, factor)\n        times=[]\n        for fn in [m.factored_norms,transposed_norms]:\n            for _ in range(3): fn(coefficients,factor)\n            start=time.process_time_ns()\n            for _ in range(15): fn(coefficients,factor)\n            times.append((time.process_time_ns()-start)/15e6)\n        print(length, heads, times, 'max_err', float((expected-actual).abs().max()))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

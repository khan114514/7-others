{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/sh -lc \"python -B - <<'PY'\nimport torch,time,statistics\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\nfor h,l,d in ((8,64,64),(10,128,64),(20,128,64),(20,256,64),(10,256,64)):\n    p=torch.randn(h,l,l)\n    vt=torch.randn(h,d,l)\n    v=vt.transpose(1,2)\n    r=torch.rand(h,l,1)\n    def plain():\n        y=torch.bmm(p,v)\n        y.mul_(r)\n        return y.transpose(0,1).contiguous()\n    def packed():\n        y=torch.empty(l,h,d)\n        yh=y.transpose(0,1)\n        torch.bmm(p,v,out=yh)\n        yh.mul_(r)\n        return y\n    e=plain()\n    a=packed()\n    print('shape',h,l,d,'error',(e-a).abs().max().item())\n    for f in (plain,packed):\n        for _ in range(5):f()\n        samples=[]\n        for _ in range(21):\n            t=time.process_time_ns()\n            for j in range(8):f()\n            samples.append((time.process_time_ns()-t)/8e6)\n        print(f.__name__,statistics.median(samples))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/sh -lc \"python -B - <<'PY'\nimport torch,time,statistics,importlib.util\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\nspec=importlib.util.spec_from_file_location('method','/workspace/solution/method.py')\nmethod=importlib.util.module_from_spec(spec)\nspec.loader.exec_module(method)\nfor h,l in ((10,128),(20,128),(20,256),(10,256)):\n    p=torch.randn(1,2*h*l,l)\n    f=torch.randn(1,l,l).tril()\n    def current():\n        return method.factored_norms(p,f)\n    def full():\n        y=torch.mm(p[0],f[0])\n        return y.norm(dim=-1,keepdim=True).square_().clamp_min_(1e-12).unsqueeze(0)\n    def panels128():\n        y=p.new_zeros((2*h*l,1))\n        for s in range(0,l,128):\n            z=torch.mm(p[0,:,s:],f[0,s:,s:s+128])\n            y.add_(z.norm(dim=-1,keepdim=True).square_())\n        return y.unsqueeze(0).clamp_min_(1e-12)\n    print('shape',h,l)\n    for fun in (current,full,panels128):\n        for _ in range(3):fun()\n        samples=[]\n        for _ in range(15):\n            t=time.process_time_ns()\n            for j in range(4):fun()\n            samples.append((time.process_time_ns()-t)/4e6)\n        print(fun.__name__,statistics.median(samples))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport importlib.util, math, statistics, time\nimport torch\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\nspec=importlib.util.spec_from_file_location('candidate','/workspace/solution/method.py')\nm=importlib.util.module_from_spec(spec)\nspec.loader.exec_module(m)\n\ndef packed(x,wq,wk,wv,need_gram):\n b,l,c=x.shape\n h,d,_=wq.shape\n rows=h*d\n maps=(wq.reshape(rows,c),wk.reshape(rows,c),wv.reshape(rows,c))\n weights=torch.cat((*maps,x.reshape(l,c)),dim=0)\n projected=torch.mm(x.reshape(l,c),weights.t())\n q,k,v=projected[:,:3*rows].reshape(b,l,3,h,d).permute(2,0,3,1,4).unbind(0)\n return q,k,v,projected[:,3*rows:].unsqueeze(0)\n\ndef median(f):\n for _ in range(2): f()\n times=[]\n for _ in range(7):\n  start=time.process_time_ns(); f(); times.append((time.process_time_ns()-start)/1e6)\n return statistics.median(times)\nwith torch.inference_mode():\n for l,c,h in [(64,512,8),(128,640,10),(128,1280,20),(256,1280,20),(256,640,10)]:\n  x=torch.randn(1,l,c)\n  ws=[torch.randn(h,64,c)/math.sqrt(c) for _ in range(3)]\n  old=m.project_qkv(x,*ws,True)\n  new=packed(x,*ws,True)\n  err=max(float((a-b).abs().max()) for a,b in zip(old,new))\n  old_ms=median(lambda:m.project_qkv(x,*ws,True))\n  new_ms=median(lambda:packed(x,*ws,True))\n  print('projection',l,c,h,'error',err,'old_ms',old_ms,'packed_ms',new_ms,'ratio',new_ms/old_ms)\n for rows,width in [(2560,64),(5120,128),(10240,64)]:\n  p=torch.randn(rows,width)\n  old_ms=median(lambda:p.clone().square_().sum(-1,keepdim=True))\n  new_ms=median(lambda:p.norm(dim=-1,keepdim=True).square_())\n  print('reduction',rows,width,'old_ms',old_ms,'norm_ms',new_ms,'ratio',new_ms/old_ms)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

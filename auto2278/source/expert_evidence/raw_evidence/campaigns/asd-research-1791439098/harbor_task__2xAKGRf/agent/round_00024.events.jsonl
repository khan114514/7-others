     \"batch\": 1,\n      \"length\": 128,\n      \"channels\": 1280,\n      \"heads\": 20,\n      \"dim\": 64,\n      \"alpha\": 1.15,\n      \"beta\": 3.0\n    },\n    {\n      \"batch\": 1,\n      \"length\": 256,\n      \"channels\": 1280,\n      \"heads\": 20,\n      \"dim\": 64,\n      \"alpha\": 1.05,\n      \"beta\": 7.5\n    },\n    {\n      \"batch\": 1,\n      \"length\": 256,\n      \"channels\": 640,\n      \"heads\": 10,\n      \"dim\": 64,\n      \"alpha\": 1.2,\n      \"beta\": 5.0\n    },\n    {\n      \"batch\": 2,\n      \"length\": 128,\n      \"channels\": 512,\n      \"heads\": 8,\n      \"dim\": 64,\n      \"alpha\": 1.0,\n      \"beta\": 5.0\n    }\n  ],\n  \"metric\": \"relative_process_cpu_time\",\n  \"baseline_anchor_units\": \"dimensionless_relative_cpu_time\",\n  \"measurement_order\": \"control_then_candidate_for_odd_seed_candidate_then_control_for_even_seed\"\n}","exit_code":0,"status":"completed"}}

{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\nHD = H*D\nBHL = B*H*L\n\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\nxr = x.reshape(B*L, C)\n\n# Current approach: 3 separate matmuls\nfor _ in range(3):\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nt0 = time.process_time_ns()\nfor _ in range(11):\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nt1 = time.process_time_ns()\nprint(f'3 separate matmuls + permute: {(t1-t0)/11/1e6:.2f} ms')\n\n# Stacked approach\nfor _ in range(3):\n    w_qkv = torch.cat([wq.reshape(HD, C), wk.reshape(HD, C), wv.reshape(HD, C)], dim=0)\nt0 = time.process_time_ns()\nfor _ in range(11):\n    w_qkv = torch.cat([wq.reshape(HD, C), wk.reshape(HD, C), wv.reshape(HD, C)], dim=0)\n    qkv = (xr @ w_qkv.T).reshape(B, L, 3, H, D).permute(2, 0, 3, 1, 4).contiguous()\n    q2, k2, v2 = qkv[0], qkv[1], qkv[2]\nt1 = time.process_time_ns()\nprint(f'Stacked QKV single matmul: {(t1-t0)/11/1e6:.2f} ms')\n\n# Verify\nq_ref = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nw_qkv = torch.cat([wq.reshape(HD, C), wk.reshape(HD, C), wv.reshape(HD, C)], dim=0)\nqkv = (xr @ w_qkv.T).reshape(B, L, 3, H, D).permute(2, 0, 3, 1, 4).contiguous()\nprint(f'q diff: {(q_ref - qkv[0]).abs().max():.2e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/sh -lc 'cd /workspace && python3 -c \"\nimport torch, time, math\nfrom importlib.machinery import SourceFileLoader\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n# New approach: fully 3D computation with minimal allocations\n@torch.no_grad()\ndef attention_3d(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BH = B * H\n    xr = x.reshape(B * L, C)\n\n    # Compute q,k,v: (B*L, C) @ (C, H*D) -> (B*L, H*D) -> reshape to (BH, L, D)\n    # Trick: reshape (B, L, H, D) -> (B*H, L, D) by permuting then reshaping\n    q = (xr @ wq.reshape(HD, C).T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    k = (xr @ wk.reshape(HD, C).T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    v = (xr @ wv.reshape(HD, C).T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n\n    # Logits: (BH, L, D) @ (BH, D, L) = (BH, L, L)\n    logits = torch.bmm(q, k.transpose(1, 2))\n    logits.mul_(inv_sqrt_d)\n\n    p0 = logits.softmax(dim=-1)\n\n    if alpha == 1.0:\n        y = torch.bmm(p0, v)\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        # p1_logits = a_p * logits + a_m * logits''^T\n        p1_logits = logits.mul(a_p)\n        p1_logits.add_(logits.transpose(1, 2), alpha=a_m)\n        p1 = p1_logits.softmax(dim=-1)\n\n        # p_mix = (1-beta)*p0 + beta*p1\n        p_mix = torch.lerp(p0, p1, beta)\n\n        # Gram matrix for norms\n        G = x @ x.transpose(-1, -2)  # B, L, L\n        G_tiled = G.expand(BH, L, L).contiguous()\n\n        p1G = torch.bmm(p1, G_tiled)\n        norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n        pmG = torch.bmm(p_mix, G_tiled)\n        normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n\n        y = torch.bmm(p_mix, v).mul_(ratio)\n\n    return y.view(B, H, L, D).transpose(1, 2).flatten(2).contiguous()\n\nm = SourceFileLoader('\"'method', '/workspace/solution/method.py').load_module()\n\ncases = [\n    (1, 64, 512, 8, 64, 1.05, 5.0),\n    (1, 128, 640, 10, 64, 1.1, 4.0),\n    (1, 128, 1280, 20, 64, 1.15, 3.0),\n    (1, 256, 1280, 20, 64, 1.05, 7.5),\n    (1, 256, 640, 10, 64, 1.2, 5.0),\n    (2, 128, 512, 8, 64, 1.0, 5.0),\n]\n\nfor ci, (B, L, C, H, D, alpha, beta) in enumerate(cases):\n    torch.manual_seed(42 + ci)\n    x = torch.randn(B, L, C)\n    wq = torch.randn(H, D, C)\n    wk = torch.randn(H, D, C)\n    wv = torch.randn(H, D, C)\n\n    y_ref = m.attention(x, wq, wk, wv, alpha, beta)\n    y_new = attention_3d(x, wq, wk, wv, alpha, beta)\n    \n    diff = (y_ref - y_new).abs().max().item()\n    rel = (diff / y_ref.abs().max().clamp(min=1e-30)).item()\n    \n    for _ in range(3):\n        m.attention(x, wq, wk, wv, alpha, beta)\n    t0 = time.process_time_ns()\n    for _ in range(11):\n        m.attention(x, wq, wk, wv, alpha, beta)\n    t1 = time.process_time_ns()\n    ref_ms = (t1-t0)/11/1e6\n    \n    for _ in range(3):\n        attention_3d(x, wq, wk, wv, alpha, beta)\n    t0 = time.process_time_ns()\n    for _ in range(11):\n        attention_3d(x, wq, wk, wv, alpha, beta)\n    t1 = time.process_time_ns()\n    new_ms = (t1-t0)/11/1e6\n    \n    print(f'Case {ci}: ref={ref_ms:.2f}ms, new={new_ms:.2f}ms, speedup={1-new_ms/ref_ms:+.1%}, max_diff={diff:.2e}, rel={rel:.2e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

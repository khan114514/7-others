{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n# Case 4 - largest: B=1, L=256, C=1280, H=20, D=64\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\n\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\n# Warmup\nfor _ in range(3):\n    q = x.reshape(B*L, C) @ wq.reshape(H*D, C).T\n    q = q.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\n# Time components\nt0 = time.process_time_ns()\nfor _ in range(11):\n    xr = x.reshape(B*L, C)\n    q = (xr @ wq.reshape(H*D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(H*D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(H*D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nt1 = time.process_time_ns()\nprint(f'QKV projections: {(t1-t0)/11/1e6:.2f} ms')\n\nq = (x.reshape(B*L, C) @ wq.reshape(H*D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (x.reshape(B*L, C) @ wk.reshape(H*D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\nt0 = time.process_time_ns()\nfor _ in range(11):\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(1.0/math.sqrt(D))\nt1 = time.process_time_ns()\nprint(f'Logits (q@kT): {(t1-t0)/11/1e6:.2f} ms')\n\nBHL = B*H*L\nt0 = time.process_time_ns()\nfor _ in range(11):\n    p0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\nt1 = time.process_time_ns()\nprint(f'p0 softmax: {(t1-t0)/11/1e6:.2f} ms')\n\na_p = 0.5*(1+alpha)\na_m = 0.5*(1-alpha)\nt0 = time.process_time_ns()\nfor _ in range(11):\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\nt1 = time.process_time_ns()\nprint(f'p1 compute+softmax: {(t1-t0)/11/1e6:.2f} ms')\n\np1_logits = logits.mul(a_p) + logits.transpose(-1,-2) * a_m\np1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n\nt0 = time.process_time_ns()\nfor _ in range(11):\n    p_mix = torch.lerp(p0, p1, beta)\nt1 = time.process_time_ns()\nprint(f'p_mix lerp: {(t1-t0)/11/1e6:.2f} ms')\n\np_mix = torch.lerp(p0, p1, beta)\nv = (x.reshape(B*L, C) @ wv.reshape(H*D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\nt0 = time.process_time_ns()\nfor _ in range(11):\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    p1G = p1 @ G_exp\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\nt1 = time.process_time_ns()\nprint(f'Gram norms + ratio: {(t1-t0)/11/1e6:.2f} ms')\n\nt0 = time.process_time_ns()\nfor _ in range(11):\n    y = (p_mix @ v).mul_(ratio)\nt1 = time.process_time_ns()\nprint(f'p_mix@v + ratio mul: {(t1-t0)/11/1e6:.2f} ms')\n\n# Total\nfrom importlib.machinery import SourceFileLoader\nm = SourceFileLoader('method', '/workspace/solution/method.py').load_module()\nt0 = time.process_time_ns()\nfor _ in range(3):\n    m.attention(x, wq, wk, wv, alpha, beta)\nt0 = time.process_time_ns()\nfor _ in range(11):\n    m.attention(x, wq, wk, wv, alpha, beta)\nt1 = time.process_time_ns()\nprint(f'Total attention: {(t1-t0)/11/1e6:.2f} ms')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math\nfrom importlib.machinery import SourceFileLoader\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n# Quick correctness check on all cases\nm_ref = SourceFileLoader('ref', '/workspace/environment/starter/method.py').load_module()\nm_new = SourceFileLoader('new', '/workspace/solution/method.py').load_module()\n\ncases = [\n    (1, 64, 512, 8, 64, 1.05, 5.0),\n    (1, 128, 640, 10, 64, 1.1, 4.0),\n    (1, 128, 1280, 20, 64, 1.15, 3.0),\n    (1, 256, 1280, 20, 64, 1.05, 7.5),\n    (1, 256, 640, 10, 64, 1.2, 5.0),\n    (2, 128, 512, 8, 64, 1.0, 5.0),\n]\n\nfor ci, (B, L, C, H, D, alpha, beta) in enumerate(cases):\n    torch.manual_seed(42 + ci)\n    x = torch.randn(B, L, C)\n    wq = torch.randn(H, D, C)\n    wk = torch.randn(H, D, C)\n    wv = torch.randn(H, D, C)\n    \n    y_ref = m_ref.attention(x.clone(), wq.clone(), wk.clone(), wv.clone(), alpha, beta)\n    y_new = m_new.attention(x.clone(), wq.clone(), wk.clone(), wv.clone(), alpha, beta)\n    \n    diff = (y_ref - y_new).abs().max().item()\n    tol = 3e-5 + 3e-4 * y_ref.abs().max().item()\n    ok = diff <= tol\n    print(f'Case {ci}: max_diff={diff:.2e}, tol={tol:.2e}, pass={ok}, shape={list(y_new.shape)}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

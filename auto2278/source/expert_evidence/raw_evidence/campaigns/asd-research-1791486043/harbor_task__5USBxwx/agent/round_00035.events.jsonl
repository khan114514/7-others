{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math, time\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nBH = B * H\nHL = H * L\n\ng = torch.Generator().manual_seed(17*1009+3)\nx = torch.randn(B, L, C, generator=g)\nlogits = torch.randn(BH, L, L, generator=g)\np0 = logits.softmax(dim=-1)\nalpha, beta = 1.05, 7.5\na_p = 0.5 + 0.5 * alpha\na_m = 0.5 - 0.5 * alpha\np1_logits = logits.mul(a_p).add(logits.transpose(1, 2), alpha=a_m)\np1 = p1_logits.softmax(dim=-1)\n\nn = 50\n\n# Current lerp\ndef lerp_method():\n    return torch.lerp(p0, p1, beta)\n\n# Manual: p0 + beta * (p1 - p0)\ndef add_method():\n    return p0.add(p1.sub(p0), alpha=beta)\n\n# Manual in-place on p1\ndef inplace_method():\n    pm = p1.clone()\n    pm.sub_(p0).mul_(beta).add_(p0)\n    return pm\n\nfor name, fn in [('lerp', lerp_method), ('add', add_method), ('inplace', inplace_method)]:\n    for _ in range(5): fn()\n    t0 = time.process_time_ns()\n    for _ in range(n): fn()\n    t1 = time.process_time_ns()\n    print(f'{name}: {(t1-t0)/n/1e6:.4f} ms')\n\n# Verify\na = lerp_method()\nb = add_method()\nc = inplace_method()\nprint(f'add diff: {(a-b).abs().max().item():.2e}')\nprint(f'inplace diff: {(a-c).abs().max().item():.2e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

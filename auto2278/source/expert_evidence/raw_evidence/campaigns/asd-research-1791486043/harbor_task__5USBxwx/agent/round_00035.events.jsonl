{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math, time\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nBH = B * H\nHL = H * L\n\ng = torch.Generator().manual_seed(17*1009+3)\nx = torch.randn(B, L, C, generator=g)\np0 = torch.randn(BH, L, L, generator=g).softmax(dim=-1)\np1 = torch.randn(BH, L, L, generator=g).softmax(dim=-1)\np_mix = torch.lerp(p0, p1, 7.5)\nG = torch.bmm(x, x.transpose(1, 2))\n\nn = 20\n\n# Current: two bmms (p1G and pmG)\ndef current():\n    p1G = torch.bmm(p1.view(B, HL, L), G).view(BH, L, L)\n    pmG = torch.bmm(p_mix.view(B, HL, L), G).view(BH, L, L)\n    return p1G, pmG\n\n# New: p0G + p1G, then pmG = lerp(p0G, p1G, beta)\ndef lerp_approach():\n    p0G = torch.bmm(p0.view(B, HL, L), G).view(BH, L, L)\n    p1G = torch.bmm(p1.view(B, HL, L), G).view(BH, L, L)\n    pmG = torch.lerp(p0G, p1G, 7.5)\n    return p1G, pmG\n\nfor name, fn in [('current (2 bmm)', current), ('lerp (2 bmm + lerp)', lerp_approach)]:\n    for _ in range(5): fn()\n    t0 = time.process_time_ns()\n    for _ in range(n): fn()\n    t1 = time.process_time_ns()\n    print(f'{name}: {(t1-t0)/n/1e6:.4f} ms')\n\n# The issue is we still do 2 bmms. But what if we need p0G for something else?\n# We DON'T need p0@G otherwise. So this is just the same 2 bmms + a lerp - worse.\n\n# Wait, but what about: p1G and pmG - what if we compute them in a single larger bmm?\n# We can reshape p1 and p_mix as (B, 2HL, L) and do one bmm of size (B, 2HL, L) @ (B, L, L)\n\ndef stacked_bmm():\n    p_stacked = torch.cat([p1.view(B, HL, L), p_mix.view(B, HL, L)], dim=1)\n    bothG = torch.bmm(p_stacked, G)\n    p1G = bothG[:, :HL, :].view(BH, L, L)\n    pmG = bothG[:, HL:, :].view(BH, L, L)\n    return p1G, pmG\n\nfor _ in range(5): stacked_bmm()\nt0 = time.process_time_ns()\nfor _ in range(n): stacked_bmm()\nt1 = time.process_time_ns()\nprint(f'stacked (1 bmm): {(t1-t0)/n/1e6:.4f} ms')\n\n# Verify\na, b = current()\nc, d = stacked_bmm()\nprint(f'stacked p1G diff: {(a-c).abs().max().item():.2e}')\nprint(f'stacked pmG diff: {(b-d).abs().max().item():.2e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

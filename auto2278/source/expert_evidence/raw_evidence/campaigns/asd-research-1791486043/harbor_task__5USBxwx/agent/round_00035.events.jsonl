{"type":"item.started","item":{"id":"item_55","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math, time, statistics\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nHD = H * D\nBH = B * H\n\ng = torch.Generator().manual_seed(17*1009+3)\nq = torch.randn(BH, L, D, generator=g)\nk = torch.randn(BH, L, D, generator=g)\nbias = torch.zeros(BH, L, L)\n\nn = 200\ntimes_bmm = []\ntimes_baddbmm = []\n\n# Interleave to reduce systematic bias\nfor i in range(n):\n    if i % 2 == 0:\n        t0 = time.process_time_ns()\n        torch.bmm(q, k.transpose(1, 2))\n        t1 = time.process_time_ns()\n        times_bmm.append((t1-t0)/1e6)\n    else:\n        t0 = time.process_time_ns()\n        torch.baddbmm(bias, q, k.transpose(1, 2))\n        t1 = time.process_time_ns()\n        times_baddbmm.append((t1-t0)/1e6)\n\nprint(f'bmm:      median={statistics.median(times_bmm):.4f}ms mean={statistics.mean(times_bmm):.4f}ms')\nprint(f'baddbmm:  median={statistics.median(times_baddbmm):.4f}ms mean={statistics.mean(times_baddbmm):.4f}ms')\nprint(f'Ratio: {statistics.median(times_bmm)/statistics.median(times_baddbmm):.3f}x')\n\n# Does output match?\na = torch.bmm(q, k.transpose(1, 2))\nb = torch.baddbmm(bias, q, k.transpose(1, 2))\nprint(f'Output match: {(a-b).abs().max().item():.2e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

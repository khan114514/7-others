{"type":"item.started","item":{"id":"item_63","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math, time, statistics\nimport torch.nn.functional as F\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nHD = H * D\nBH = B * H\n\ng = torch.Generator().manual_seed(17*1009+3)\nq = torch.randn(BH, L, D, generator=g)\nk = torch.randn(BH, L, D, generator=g)\nv = torch.randn(BH, L, D, generator=g)\n\nn = 50\n\n# Manual: bmm + softmax + bmm\ndef manual_sdpa():\n    logits = torch.bmm(q, k.transpose(1, 2)) / math.sqrt(D)\n    p = logits.softmax(dim=-1)\n    return torch.bmm(p, v)\n\n# torch SDPA\ndef torch_sdpa():\n    return F.scaled_dot_product_attention(q, k, v, scale=1.0/math.sqrt(D))\n\nfor name, fn in [('manual', manual_sdpa), ('torch SDPA', torch_sdpa)]:\n    for _ in range(5): fn()\n    times = []\n    for i in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        t1 = time.process_time_ns()\n        times.append((t1-t0)/1e6)\n    print(f'{name:15s}: median={statistics.median(times):.3f}ms')\n\n# Check output match\na = manual_sdpa()\nb = torch_sdpa()\nprint(f'Diff: {(a-b).abs().max().item():.2e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

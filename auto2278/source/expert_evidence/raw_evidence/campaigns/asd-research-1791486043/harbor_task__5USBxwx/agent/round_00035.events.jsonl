{"type":"item.started","item":{"id":"item_69","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math, time, statistics\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nHD = H * D\nBH = B * H\n\ng = torch.Generator().manual_seed(17*1009+3)\nx = torch.randn(B, L, C, generator=g)\nw = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n\nxr = x.reshape(B * L, C)\nwr = w.reshape(HD, C)\n\nn = 100\n\n# The projection + rearrangement to BH, L, D\ndef baseline_proj():\n    return (xr @ wr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n\n# What if we compute as w @ x.T (i.e., weight @ input) and reshape?\n# wr @ xr.T gives (HD, BL). View as (H, D, B, L) -> (B, H, L, D)... messy.\n\n# What about using unfold or as_strided? No.\n\n# What if we just work in (B, H, L, D) layout (4D) and never call contiguous,\n# using 4D matmul throughout?\n\nwr_4d = wr.view(H, D, C)  # (H, D, C) - same as original w\n\n# 4D approach: q = torch.einsum('blc,hdc->bhld', x, wq)\n# But that's slow. What about doing it with batched matmul?\n# x (B, L, C), wq (H, D, C) -> q (B, H, L, D)\n# We can do: x.unsqueeze(1).expand(B, H, L, C) @ wq.unsqueeze(0).expand(B, H, D, C).transpose(-1,-2)\n# = (B, H, L, C) @ (B, H, C, D) = (B, H, L, D)\n# But the expand copies... actually x.expand doesn't copy.\n# But bmm would need actual copies because bmm expects contiguous batches.\n\n# Let's try it anyway\ndef expanded_4d():\n    xe = x.unsqueeze(1).expand(B, H, L, C)  # no copy, non-contiguous\n    we = wr_4d.unsqueeze(0).expand(B, H, D, C).transpose(-1, -2)  # (B, H, C, D)\n    return xe @ we  # 4D matmul\n\nfor name, fn in [('baseline (2d+permute)', baseline_proj), ('expanded 4d', expanded_4d)]:\n    for _ in range(5): fn()\n    times = []\n    for i in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        t1 = time.process_time_ns()\n        times.append((t1-t0)/1e6)\n    print(f'{name:30s}: median={statistics.median(times):.3f}ms')\n\n# Check\na = baseline_proj()\nb = expanded_4d().reshape(BH, L, D)\nprint(f'Output diff: {(a-b).abs().max().item():.2e}')\nprint(f'a shape: {a.shape}, b shape: {b.shape}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

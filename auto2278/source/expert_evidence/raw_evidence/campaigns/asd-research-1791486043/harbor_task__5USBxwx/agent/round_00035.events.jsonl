{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math, time\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nHD = H * D\nBH = B * H\nHL = H * L\n\ng = torch.Generator().manual_seed(17*1009+3)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwv = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nalpha, beta = 1.05, 7.5\n\nn = 10\n\n# Baseline\nimport sys\nsys.path.insert(0, '/workspace/solution')\nfrom method import attention\nfor _ in range(3): y0 = attention(x, wq, wk, wv, alpha, beta)\nt0 = time.process_time_ns()\nfor _ in range(n): y0 = attention(x, wq, wk, wv, alpha, beta)\nt1 = time.process_time_ns()\nbase_ms = (t1-t0)/n/1e6\nprint(f'Baseline: {base_ms:.3f} ms')\n\n# Idea: pre-transpose k so bmm doesn't need to transpose\ndef pretransposed_k():\n    xr = x.reshape(B * L, C)\n    wqr = wq.reshape(HD, C)\n    wkr = wk.reshape(HD, C)\n    wvr = wv.reshape(HD, C)\n    \n    q = (xr @ wqr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    k = (xr @ wkr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    q.mul_(1.0 / math.sqrt(D))\n    kT = k.transpose(1, 2).contiguous()\n    \n    logits = torch.bmm(q, kT)\n    p0 = logits.softmax(dim=-1)\n    \n    a_p = 0.5 + 0.5 * alpha\n    a_m = 0.5 - 0.5 * alpha\n    p1_logits = logits.mul(a_p).add_(logits.transpose(1, 2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    \n    G = torch.bmm(x, x.transpose(1, 2))\n    p1G = torch.bmm(p1.view(B, HL, L), G).view(BH, L, L)\n    pmG = torch.bmm(p_mix.view(B, HL, L), G).view(BH, L, L)\n    \n    norm1 = p1G.mul_(p1).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    normm = pmG.mul_(p_mix).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    \n    v = (xr @ wvr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    y = torch.bmm(p_mix, v).mul_(ratio)\n    return y.view(B, H, L, D).transpose(1, 2).flatten(2).contiguous()\n\nfor _ in range(3): y = pretransposed_k()\nt0 = time.process_time_ns()\nfor _ in range(n): y = pretransposed_k()\nt1 = time.process_time_ns()\nprint(f'Pre-transposed k: {(t1-t0)/n/1e6:.3f} ms')\n\n# Idea: compute k as (D, L) shaped from the start\ndef k_as_DL():\n    xr = x.reshape(B * L, C)\n    wqr = wq.reshape(HD, C)\n    wkr = wk.reshape(HD, C)\n    wvr = wv.reshape(HD, C)\n    \n    q = (xr @ wqr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    # Compute k in (BH, D, L) layout directly\n    k = (xr @ wkr.T).view(B, L, H, D).permute(0, 2, 3, 1).contiguous().view(BH, D, L)\n    q.mul_(1.0 / math.sqrt(D))\n    \n    logits = torch.bmm(q, k)  # (BH, L, D) @ (BH, D, L) = (BH, L, L)\n    p0 = logits.softmax(dim=-1)\n    \n    a_p = 0.5 + 0.5 * alpha\n    a_m = 0.5 - 0.5 * alpha\n    p1_logits = logits.mul(a_p).add_(logits.transpose(1, 2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    \n    G = torch.bmm(x, x.transpose(1, 2))\n    p1G = torch.bmm(p1.view(B, HL, L), G).view(BH, L, L)\n    pmG = torch.bmm(p_mix.view(B, HL, L), G).view(BH, L, L)\n    \n    norm1 = p1G.mul_(p1).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    normm = pmG.mul_(p_mix).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    \n    v = (xr @ wvr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    y = torch.bmm(p_mix, v).mul_(ratio)\n    return y.view(B, H, L, D).transpose(1, 2).flatten(2).contiguous()\n\nfor _ in range(3): y = k_as_DL()\nt0 = time.process_time_ns()\nfor _ in range(n): y = k_as_DL()\nt1 = time.process_time_ns()\nprint(f'k as (BH,D,L): {(t1-t0)/n/1e6:.3f} ms')\nprint(f'k_as_DL diff: {(y - y0).abs().max().item():.2e}')\n\n# Idea:
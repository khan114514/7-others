{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math, time\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nHD = H * D\nBH = B * H\n\ng = torch.Generator().manual_seed(17*1009+3)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n\nxr = x.reshape(B * L, C)\nwqr = wq.reshape(HD, C)\nwkr = wk.reshape(HD, C)\n\nn = 20\n\n# Current: q in (BH, L, D) contiguous\ndef current_logits():\n    q = (xr @ wqr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    k = (xr @ wkr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    q.mul_(1.0 / math.sqrt(D))\n    logits = torch.bmm(q, k.transpose(1, 2))\n    return logits\n\nfor _ in range(3): current_logits()\nt0 = time.process_time_ns()\nfor _ in range(n): current_logits()\nt1 = time.process_time_ns()\nprint(f'Current q+k+logits: {(t1-t0)/n/1e6:.3f} ms')\n\n# Alternative: compute q and k without moving to BH layout, using 4D matmul\ndef logits_4d():\n    q = (xr @ wqr.T).view(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wkr.T).view(B, L, H, D).permute(0, 2, 1, 3)\n    q = q * (1.0 / math.sqrt(D))\n    logits = q @ k.transpose(-1, -2)\n    return logits\n\nfor _ in range(3): logits_4d()\nt0 = time.process_time_ns()\nfor _ in range(n): logits_4d()\nt1 = time.process_time_ns()\nprint(f'4D q+k+logits (no contiguous): {(t1-t0)/n/1e6:.3f} ms')\n\n# Check result shape\nprint(f'Current: {current_logits().shape}, 4D: {logits_4d().shape}')\nprint(f'Max diff: {(current_logits() - logits_4d().reshape(BH, L, L)).abs().max().item():.2e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

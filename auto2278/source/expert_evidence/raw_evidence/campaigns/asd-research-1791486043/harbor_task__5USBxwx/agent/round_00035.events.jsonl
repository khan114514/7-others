{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math, time\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 128, 1280, 20, 64\nHD = H * D\nBH = B * H\n\ng = torch.Generator().manual_seed(17*1009+2)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwv = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n\nxr = x.reshape(B * L, C)\nwqr = wq.reshape(HD, C)\nwkr = wk.reshape(HD, C)\nwvr = wv.reshape(HD, C)\n\n# Profile separate vs fused\nn = 20\n\n# Separate\ndef separate():\n    q = xr @ wqr.T\n    k = xr @ wkr.T\n    v = xr @ wvr.T\n    return q, k, v\nfor _ in range(3): separate()\nt0 = time.process_time_ns()\nfor _ in range(n): separate()\nt1 = time.process_time_ns()\nprint(f'Separate q+k+v: {(t1-t0)/n/1e6:.3f} ms')\n\n# Fused\nwqkv = torch.cat([wqr, wkr, wvr], dim=0)\ndef fused():\n    out = xr @ wqkv.T\n    q = out[:, :HD]\n    k = out[:, HD:2*HD]\n    v = out[:, 2*HD:]\n    return q, k, v\nfor _ in range(3): fused()\nt0 = time.process_time_ns()\nfor _ in range(n): fused()\nt1 = time.process_time_ns()\nprint(f'Fused q+k+v:   {(t1-t0)/n/1e6:.3f} ms')\n\n# Just q+k fused (for alpha==1 we don't need v early)\nwqk = torch.cat([wqr, wkr], dim=0)\ndef fused_qk():\n    out = xr @ wqk.T\n    q = out[:, :HD]\n    k = out[:, HD:2*HD]\n    return q, k\nfor _ in range(3): fused_qk()\nt0 = time.process_time_ns()\nfor _ in range(n): fused_qk()\nt1 = time.process_time_ns()\nprint(f'Fused q+k:     {(t1-t0)/n/1e6:.3f} ms')\n\n# Separate q+k\ndef separate_qk():\n    q = xr @ wqr.T\n    k = xr @ wkr.T\n    return q, k\nfor _ in range(3): separate_qk()\nt0 = time.process_time_ns()\nfor _ in range(n): separate_qk()\nt1 = time.process_time_ns()\nprint(f'Separate q+k:  {(t1-t0)/n/1e6:.3f} ms')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

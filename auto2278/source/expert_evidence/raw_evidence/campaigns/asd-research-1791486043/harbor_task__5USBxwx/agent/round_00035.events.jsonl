{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math, time\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nHD = H * D\nBH = B * H\nHL = H * L\n\ng = torch.Generator().manual_seed(17*1009+3)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwv = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nalpha, beta = 1.05, 7.5\n\nxr = x.reshape(B * L, C)\nwqr = wq.reshape(HD, C)\nwkr = wk.reshape(HD, C)\nwvr = wv.reshape(HD, C)\n\nn = 10\n\n# Profile full current method\nimport sys\nsys.path.insert(0, '/workspace/solution')\nfrom method import attention\n\nfor _ in range(3): y = attention(x, wq, wk, wv, alpha, beta)\nt0 = time.process_time_ns()\nfor _ in range(n): y = attention(x, wq, wk, wv, alpha, beta)\nt1 = time.process_time_ns()\nprint(f'Current full: {(t1-t0)/n/1e6:.3f} ms')\n\n# Let me try computing the output differently.\n# Current: y = (p_mix @ v) * ratio  where v = x @ wv\"'^T\n# Alternative: y = (p_mix_r @ x) @ wv''^T where p_mix_r = ratio * p_mix\n# But this requires p_mix_r @ x which is huge (BH, L, L) @ (BH, L, C) = BH*L*L*C\n\n# Wait, ratio is per-token per-head (BH, L, 1). p_mix is (BH, L, L).\n# p_mix_r = ratio * p_mix  -> (BH, L, L) - same size\n# p_mix_r @ x  -> would need (BH, L, L) @ (BH, L, C) = (BH, L, C), then @ wv''^T\n\n# But we'\"'d need x in (BH, L, C), which is just a view/expand... no x has shape (B, L, C)\n# and we'd need it per head. That's B*H*L*C memory and bmm cost.\n# For B=1,H=20,L=256,C=1280: bmm cost = 20 * 256 * 256 * 1280 = 1.68B ops\n# vs current: p_mix @ v = 20 * 256 * 256 * 64 = 84M ops + v_proj = 256 * 1280 * 1280 = 420M ops\n# = 504M ops total. So current is better (504M vs 1680M).\n\n# What about: can we avoid v-projection by doing (r*m) @ wv\"'^T in a single step?\n# We'\"'d need m in feature space: m = p_mix @ x, then m @ wv\"'^T\n# Same as above.\n\n# What about the alpha==1 fast path?\n# Case 6 has alpha=1.0, so p1 = p0, m = u0, ratio=1, so y = p0 @ v\n# But we still need to compute ratio=1... wait, if alpha==1:\n# P1 = softmax(A) = P0, u1=u0, m=u0, ratio=1, output = u0 @ wv''^T = p0 @ v\n# That'\"'s already optimized.\n\n# Key question: are there redundant computations?\n# We compute: q = x@wq\"'^T, k = x@wk''^T, v = x@wv''^T (3 projections)\n# Can we express the attention output in terms of x alone?\n# Output = r * p_mix @ x @ wv''^T. r depends on norms of p1@x and p_mix@x.\n# So we need: p1@x (for norm) and p_mix@x (for norm and output). \n# But p_mix@x @ wv''^T is the output. We currently do p_mix @ v = p_mix @ (x@wv''^T).\n# Same thing, different order. The cheaper order depends on L, D, C.\n# p_mix @ v: cost = BH*L*L*D + BL*C*HD = 84M + 420M = 504M for largest case\n# (p_mix @ x) @ wv''^T: cost = BH*L*L*C + BH*L*C*D = 1680M + 420M = 2100M\n# So p_mix@v is way better.\n\n# BUT we also need p1@x and p_mix@x for norms. We compute those via Gram.\n# Gram approach cost: G = B*L*L*C = 84M (forward), p1G = B*HL*L*L = 336M, pmG = 336M\n# = 756M operations (but these are L''^2 operations, not LC).\n# Plus: p_mix@v = 84M, v_proj = 420M\n# Total for norms + output: 756 + 84 + 420 = 1260M (approx)\n\n# Alternative: compute u1 = p1 @ x, m = p_mix @ x directly, then get norms + output\n# Cost: u1 = BH*L*L*C = 1680M, m = BH*L*L*C = 1680M, output = BH*L*C*D = 420M\n# Total: 3780M. Way worse.\n\n# So Gram is correct approach.\n\n# What if we only compute ONE Gram-multiplication?\n# Currently: p1G and pmG. But pm = (1-beta)*p0 + beta*p1, so pmG = (1-beta)*p0G + beta*p1G\n# If we compute both p1G and p0G via 2 bmms, that'\"'s still 2 bmms.\n# But what if we do 1 bmm with stacked (p1, p0)?\np0 = torch.randn(BH, L, L).softmax(dim=-1)\np1 = torch.randn(BH, L, L).softmax(dim=-1)\nG = torch.bmm(x, x.transpose(1, 2))\n\n# Stacked approach\np_stacked = torch.cat([p1.view(B, HL, L), p0.view(B, HL, L)], dim=1)  # (B, 2HL, L)\ndef stacked():\n    bothG = torch.bmm(p_stacked, G)\n    p1G = bothG[:, :HL, :].view(BH, L, L)\n    p0G = bothG[:, HL:, :].view(BH, L, L)\n    return p1G, p0G\n\nfor _ in range(3): stacked()\nt0 = time.process_time_ns()\nfor _ in range(20): stacked()\nt1 = time.process_time_ns()\nprint(f'Stacked p1G+p0G: {(t1-t0)/20/1e6:.3f} ms')\n\n# Separate approach\ndef separate():\n    p1G = torch.bmm(p1.view(B, HL, L), G).view(BH, L, L)\n    p0G = torch.bmm(p0.view(B, HL, L), G).view(BH, L, L)\n    return p1G, p0G\n\nfor _ in range(3): separate()\nt0 = time.process_time_ns()\nfor _ in range(20): separate()\nt1 = time.process_time_ns()\nprint(f'Separate p1G+p0G: {(t1-t0)/20/1e6:.3f} ms')\n\n# pmG from p0G, p1G\np1G_a, p0G_a = separate()\ndef derived_pmG():\n    return p0G_a.lerp(p1G_a, beta)\n\n# vs direct pmG computation\np_mix = torch.lerp(p0, p1, beta)\ndef direct_pmG():\n    return torch.bmm(p_mix.view(B, HL, L), G).view(BH, L, L)\n\nfor _ in range(3): derived_pmG()\nt0 = time.process_time_ns()\nfor _ in range(50): derived_pmG()\nt1 = time.process_time_ns()\nprint(f'Derived pmG (lerp): {(t1-t0)/50/1e6:.4f} ms')\n\nfor _ in range(3): direct_pmG()\nt0 = time.process_time_ns()\nfor _ in range(20): direct_pmG()\nt1 = time.process_time_ns()\nprint(f'Direct pmG (bmm): {(t1-t0)/20/1e6:.4f} ms')\n\n# Check: p0G + p1G stacked + pmG via lerp vs current p1G + pmG direct\n# Current: p1G bmm + pmG bmm = 2 bmms\n# New: p_stacked bmm (p1 + p0) + pmG_lerp = 1 bmm + 1 lerp\n# Let's check if this is faster overall\n\ndef gram_new():\n    G = torch.bmm(x, x.transpose(1, 2))\n    p_stacked = torch.cat([p1.view(B, HL, L), p0.view(B, HL, L)], dim=1)\n    bothG = torch.bmm(p_stacked, G)\n    p1G = bothG[:, :HL, :].view(BH, L, L)\n    p0G = bothG[:, HL:, :].view(BH, L, L)\n    pmG = p0G.lerp(p1G, beta)\n    norm1 = p1G.mul(p1).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    normm = pmG.mul(p_mix).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    return ratio\n\ndef gram_current():\n    G = torch.bmm(x, x.transpose(1, 2))\n    p1G = torch.bmm(p1.view(B, HL, L), G).view(BH, L, L)\n    pmG = torch.bmm(p_mix.view(B, HL, L), G).view(BH, L, L)\n    norm1 = p1G.mul_(p1).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    normm = pmG.mul_(p_mix).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    return ratio\n\nfor _ in range(3): gram_new()\nt0 = time.process_time_ns()\nfor _ in range(20): gram_new()\nt1 = time.process_time_ns()\nprint(f'Gram new (stacked+lerp): {(t1-t0)/20/1e6:.3f} ms')\n\nfor _ in range(3): gram_current()\nt0 = time.process_time_ns()\nfor _ in range(20): gram_current()\nt1 = time.process_time_ns()\nprint(f'Gram current: {(t1-t0)/20/1e6:.3f} ms')\n\nr1 = gram_new()\nr2 = gram_current()\nprint(f'Ratio diff: {(r1-r2).abs().max().item():.2e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

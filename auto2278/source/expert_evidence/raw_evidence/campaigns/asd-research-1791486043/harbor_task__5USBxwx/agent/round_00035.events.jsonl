{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math, time\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nHD = H * D\nBH = B * H\nHL = H * L\n\ng = torch.Generator().manual_seed(17*1009+3)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwv = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nalpha, beta = 1.05, 7.5\n\nn = 10\n\n# 4D approach - compute q,k,v in (B, H, L, D) using einsum then 4D matmul\ndef approach_4d():\n    q = torch.einsum('blc,hdc->bhld', x, wq)\n    k = torch.einsum('blc,hdc->bhld', x, wk)\n    logits = q @ k.transpose(-1, -2) / math.sqrt(D)\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 + 0.5 * alpha\n    a_m = 0.5 - 0.5 * alpha\n    p1_logits = a_p * logits + a_m * logits.transpose(-1, -2)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    v = torch.einsum('blc,hdc->bhld', x, wv)\n    \n    # Norms via Gram\n    G = torch.bmm(x, x.transpose(1, 2))  # (B, L, L)\n    p1G = torch.bmm(p1.reshape(B, HL, L), G).reshape(B, H, L, L)\n    pmG = torch.bmm(p_mix.reshape(B, HL, L), G).reshape(B, H, L, L)\n    norm1 = (p1G * p1).sum(dim=-1, keepdim=True).sqrt().clamp_min(1e-6)\n    normm = (pmG * p_mix).sum(dim=-1, keepdim=True).sqrt().clamp_min(1e-6)\n    ratio = (norm1 / normm).clamp(0.25, 4.0)\n    \n    y = (p_mix @ v) * ratio\n    return y.transpose(1, 2).flatten(2).contiguous()\n\nfor _ in range(3): y = approach_4d()\nt0 = time.process_time_ns()\nfor _ in range(n): y = approach_4d()\nt1 = time.process_time_ns()\nprint(f'4D einsum approach: {(t1-t0)/n/1e6:.3f} ms')\n\n# Reference\nimport sys\nsys.path.insert(0, '/workspace/solution')\nfrom method import attention\ny0 = attention(x, wq, wk, wv, alpha, beta)\nprint(f'Diff: {(y - y0).abs().max().item():.2e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"
{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math, time\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nHD = H * D\nBH = B * H\nHL = H * L\n\ng = torch.Generator().manual_seed(17*1009+3)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwv = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nalpha, beta = 1.05, 7.5\n\nn = 10\n\n# Current best\nimport sys\nsys.path.insert(0, '/workspace/solution')\nfrom method import attention\nfor _ in range(3): y0 = attention(x, wq, wk, wv, alpha, beta)\nt0 = time.process_time_ns()\nfor _ in range(n): y0 = attention(x, wq, wk, wv, alpha, beta)\nt1 = time.process_time_ns()\nprint(f'Current: {(t1-t0)/n/1e6:.3f} ms')\n\n# Try: v projection computed as (H, B*L, D) @ wv\"'^T via a single big matmul\n# No, that'\"'s the same thing.\n\n# Try: compute v projection before softmaxes, for cache locality on xr?\n# v is just another matmul.\n\n# Let me try the most impactful thing: can we reduce from 3 projections to 2?\n# Output: r * m @ wv\"'^T where m = p_mix @ x\n# = r * (p_mix @ x) @ wv''^T\n# But we could compute: p_mix @ (x @ wv''^T) = p_mix @ v\n# Same either way.\n\n# What if we skip the v projection entirely when we can compute output differently?\n# No, wv is part of the output.\n\n# Let me try: rearranging the computation to be more memory efficient\n# Specifically: free logits after computing p0 and p1 to save memory\n# (might help with cache). Also free p0 and p1 after computing p_mix and p1G.\n\ndef memory_efficient():\n    B2, L2, C2 = x.shape\n    H2, D2 = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D2)\n    HD2 = H2 * D2\n    BH2 = B2 * H2\n    HL2 = H2 * L2\n    xr = x.reshape(B2 * L2, C2)\n\n    wqr = wq.reshape(HD2, C2)\n    wkr = wk.reshape(HD2, C2)\n    wvr = wv.reshape(HD2, C2)\n\n    q = (xr @ wqr.T).view(B2, L2, H2, D2).permute(0, 2, 1, 3).contiguous().view(BH2, L2, D2)\n    k = (xr @ wkr.T).view(B2, L2, H2, D2).permute(0, 2, 1, 3).contiguous().view(BH2, L2, D2)\n    q.mul_(inv_sqrt_d)\n\n    logits = torch.bmm(q, k.transpose(1, 2))\n    del q, k\n\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 + 0.5 * alpha\n    a_m = 0.5 - 0.5 * alpha\n    p1_logits = logits.mul(a_p).add_(logits.transpose(1, 2), alpha=a_m)\n    del logits\n    p1 = p1_logits.softmax(dim=-1)\n    del p1_logits\n\n    p_mix = torch.lerp(p0, p1, beta)\n\n    G = torch.bmm(x, x.transpose(1, 2))\n    p1G = torch.bmm(p1.view(B2, HL2, L2), G).view(BH2, L2, L2)\n    pmG = torch.bmm(p_mix.view(B2, HL2, L2), G).view(BH2, L2, L2)\n    del G\n\n    norm1 = p1G.mul_(p1).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    del p1, p1G\n    normm = pmG.mul_(p_mix).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    del pmG\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    del norm1, normm\n\n    v = (xr @ wvr.T).view(B2, L2, H2, D2).permute(0, 2, 1, 3).contiguous().view(BH2, L2, D2)\n    y = torch.bmm(p_mix, v).mul_(ratio)\n    del p_mix, v, ratio\n    return y.view(B2, H2, L2, D2).transpose(1, 2).flatten(2).contiguous()\n\nfor _ in range(3): y = memory_efficient()\nt0 = time.process_time_ns()\nfor _ in range(n): y = memory_efficient()\nt1 = time.process_time_ns()\nprint(f'\"'Memory efficient: {(t1-t0)/n/1e6:.3f} ms')\nprint(f'Diff: {(y - y0).abs().max().item():.2e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

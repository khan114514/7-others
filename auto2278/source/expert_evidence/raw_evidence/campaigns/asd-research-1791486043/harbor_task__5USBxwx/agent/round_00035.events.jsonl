{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math, time\ntorch.set_num_threads(1)\n\n# Test: does the Gram approach produce accurate enough results?\nB, L, C, H, D = 1, 256, 1280, 20, 64\nHD = H * D\nBH = B * H\nHL = H * L\n\ng = torch.Generator().manual_seed(17*1009+3)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwv = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nalpha, beta = 1.05, 7.5\n\nimport sys\nsys.path.insert(0, '/workspace/solution')\nfrom method import attention\n\ny = attention(x, wq, wk, wv, alpha, beta)\n\n# Reference\nq = torch.einsum('blc,hdc->bhld', x, wq)\nk = torch.einsum('blc,hdc->bhld', x, wk)\nlogits = q @ k.transpose(-1, -2) / math.sqrt(D)\np0 = logits.softmax(-1)\np1 = (.5*(1+alpha)*logits + .5*(1-alpha)*logits.transpose(-1,-2)).softmax(-1)\nbase = p0 @ x.unsqueeze(1)\nmodified = p1 @ x.unsqueeze(1)\nmix = base + beta * (modified - base)\nratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6) / mix.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\nexpected = torch.einsum('bhlc,hdc->bhld', mix * ratio, wv).transpose(1,2).flatten(2).contiguous()\n\nprint(f'Current method max abs error: {(y-expected).abs().max().item():.6e}')\nprint(f'Current method max rel error: {((y-expected).abs() / expected.abs().clamp_min(1e-10)).max().item():.6e}')\nprint(f'atol+rtol*|expected| max: {(3e-5 + 3e-4 * expected.abs()).max().item():.6e}')\nprint()\n\n# Check error components: is it the Gram norms or the p_mix@v?\nxr = x.reshape(B * L, C)\nwqr = wq.reshape(HD, C)\nwkr = wk.reshape(HD, C)\nwvr = wv.reshape(HD, C)\ninv_sqrt_d = 1.0 / math.sqrt(D)\n\nq2 = (xr @ wqr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\nk2 = (xr @ wkr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\nq2.mul_(inv_sqrt_d)\n\nlogits2 = torch.bmm(q2, k2.transpose(1, 2))\np0_2 = logits2.softmax(dim=-1)\na_p = 0.5 + 0.5 * alpha\na_m = 0.5 - 0.5 * alpha\np1_logits = logits2.mul(a_p).add_(logits2.transpose(1, 2), alpha=a_m)\np1_2 = p1_logits.softmax(dim=-1)\np_mix = torch.lerp(p0_2, p1_2, beta)\n\n# Check softmax equivalence\nprint(f'p0 diff: {(p0 - p0_2.view(B, H, L, L)).abs().max().item():.6e}')\nprint(f'p1 diff: {(p1 - p1_2.view(B, H, L, L)).abs().max().item():.6e}')\n\nv = (xr @ wvr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\ny_direct = torch.bmm(p_mix, v)\n\n# expected output in BH, L, D format\nexpected_bhld = (expected.view(B, L, H, D).transpose(1, 2).contiguous().view(BH, L, D))\n\n# What's the error if we use exact (computed) ratio?\nu1 = torch.bmm(p1_2, x.unsqueeze(1).expand(B, H, L, C).reshape(BH, L, C))\num = torch.bmm(p_mix, x.unsqueeze(1).expand(B, H, L, C).reshape(BH, L, C))\nratio_direct = u1.norm(dim=-1, keepdim=True).clamp_min(1e-6) / um.norm(dim=-1, keepdim=True).clamp_min(1e-6)\nratio_direct.clamp_(0.25, 4.0)\ny_direct_ratio = y_direct * ratio_direct\nprint(f'y_direct_ratio diff from expected: {(y_direct_ratio.view_as(expected) - expected).abs().max().item():.6e}')\n\n# Gram-based ratio\nG = torch.bmm(x, x.transpose(1, 2))\np1G = torch.bmm(p1_2.view(B, HL, L), G).view(BH, L, L)\npmG = torch.bmm(p_mix.view(B, HL, L), G).view(BH, L, L)\nnorm1 = p1G.mul_(p1_2).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\nnormm = pmG.mul_(p_mix).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\nratio_gram = norm1.div_(normm).clamp_(0.25, 4.0)\n\ny_gram = torch.bmm(p_mix, v) * ratio_gram\nprint(f'y_gram diff from expected: {(y_gram.view_as(expected) - expected).abs().max().item():.6e}')\nprint(f'ratio diff (gram vs direct): {(ratio_gram - ratio_direct).abs().max().item():.6e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

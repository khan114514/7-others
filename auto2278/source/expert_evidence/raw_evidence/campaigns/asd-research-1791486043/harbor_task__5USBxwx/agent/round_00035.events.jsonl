{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math, time\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 128, 1280, 20, 64\nHL = H * L\n\ng = torch.Generator().manual_seed(17*1009+2)\nx = torch.randn(B, L, C, generator=g)\n\n# G in float64\nx64 = x.double()\nG32 = torch.bmm(x, x.transpose(1, 2))\nG64 = torch.bmm(x64, x64.transpose(1, 2))\nprint(f'G max value: {G32.abs().max().item():.2f}')\nprint(f'G relative diff 32 vs 64: {((G32-G64.float()).abs() / G64.float().abs().clamp_min(1e-10)).max().item():.2e}')\n\n# p@G in float32 vs float64\np = torch.randn(B, HL, L, generator=g).softmax(dim=-1)\npG32 = torch.bmm(p, G32)\npG64 = torch.bmm(p.double(), G64)\nprint(f'pG relative diff 32 vs 64: {((pG32-pG64.float()).abs() / pG64.float().abs().clamp_min(1e-10)).max().item():.2e}')\n\n# Norm diff\nnorm32 = pG32.mul(p).sum(dim=-1).sqrt()\nnorm64 = pG64.mul(p.double()).sum(dim=-1).sqrt()\nprint(f'norm diff: {(norm32 - norm64.float()).abs().max().item():.2e}')\nprint(f'norm relative diff: {((norm32 - norm64.float()).abs() / norm64.float().abs().clamp_min(1e-10)).max().item():.2e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

m=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    normm = pmG.mul_(p_mix).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n\n    v = (xr @ wvr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    y = torch.bmm(p_mix, v).mul_(ratio)\n    return y.view(B, H, L, D).transpose(1, 2).flatten(2).contiguous()\n\nfor _ in range(3): y = optimized_v2()\nt0 = time.process_time_ns()\nfor _ in range(n): y = optimized_v2()\nt1 = time.process_time_ns()\nprint(f'Fused q+k: {(t1-t0)/n/1e6:.3f} ms')\n\n# Check correctness\ny1 = attention(x, wq, wk, wv, alpha, beta)\ny2 = optimized_v2()\nprint(f'Diff: {(y1-y2).abs().max().item():.2e}')\n\\\"\n\"","aggregated_output":"Current: 42.375 ms\nFused q+k: 41.753 ms\nDiff: 0.00e+00\n","exit_code":0,"status":"completed"}}

1, 2)))\nG = torch.bmm(x, x.transpose(1, 2))\n\ntime_step('p1G bmm', lambda: torch.bmm(p1.view(B, HL, L), G).view(BH, L, L))\np1G = torch.bmm(p1.view(B, HL, L), G).view(BH, L, L)\ntime_step('pmG bmm', lambda: torch.bmm(p_mix.view(B, HL, L), G).view(BH, L, L))\npmG = torch.bmm(p_mix.view(B, HL, L), G).view(BH, L, L)\n\ntime_step('norms + ratio', lambda: (\n    p1G.mul(p1).sum(dim=-1, keepdim=True).sqrt().clamp_min(1e-6),\n    pmG.mul(p_mix).sum(dim=-1, keepdim=True).sqrt().clamp_min(1e-6),\n))\nnorm1 = p1G.mul(p1).sum(dim=-1, keepdim=True).sqrt().clamp_min(1e-6)\nnormm = pmG.mul(p_mix).sum(dim=-1, keepdim=True).sqrt().clamp_min(1e-6)\ntime_step('ratio clamp', lambda: norm1.div(normm).clamp(0.25, 4.0))\nratio = norm1.div_(normm).clamp_(0.25, 4.0)\n\ntime_step('v proj', lambda: (xr @ wvr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D))\nv = (xr @ wvr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n\ntime_step('p_mix @ v', lambda: torch.bmm(p_mix, v))\ny = torch.bmm(p_mix, v).mul_(ratio)\n\ntime_step('output reshape', lambda: y.view(B, H, L, D).transpose(1, 2).flatten(2).contiguous())\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

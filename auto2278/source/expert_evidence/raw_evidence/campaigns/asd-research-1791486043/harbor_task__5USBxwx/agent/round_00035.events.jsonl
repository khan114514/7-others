{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math, time\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 128, 1280, 20, 64\nHD = H * D\nBH = B * H\n\ng = torch.Generator().manual_seed(17*1009+2)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\nwk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n\nxr = x.reshape(B * L, C)\nwqr = wq.reshape(HD, C)\nwkr = wk.reshape(HD, C)\n\nn = 50\n\n# Current approach\ndef current():\n    q = (xr @ wqr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    return q\nfor _ in range(3): current()\nt0 = time.process_time_ns()\nfor _ in range(n): current()\nt1 = time.process_time_ns()\nprint(f'Current q proj: {(t1-t0)/n/1e6:.3f} ms')\n\n# Just matmul (no reshape)\ndef just_matmul():\n    q = xr @ wqr.T\n    return q\nfor _ in range(3): just_matmul()\nt0 = time.process_time_ns()\nfor _ in range(n): just_matmul()\nt1 = time.process_time_ns()\nprint(f'Just matmul:    {(t1-t0)/n/1e6:.3f} ms')\n\n# Matmul + view + permute + contiguous\ndef with_contiguous():\n    q = (xr @ wqr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    return q\nfor _ in range(3): with_contiguous()\nt0 = time.process_time_ns()\nfor _ in range(n): with_contiguous()\nt1 = time.process_time_ns()\nprint(f'+contiguous:    {(t1-t0)/n/1e6:.3f} ms')\n\n# Alternative: reshape differently\ndef alt_reshape():\n    q = (xr @ wqr.T).view(B, L, H, D).movedim(2, 1).contiguous().view(BH, L, D)\n    return q\nfor _ in range(3): alt_reshape()\nt0 = time.process_time_ns()\nfor _ in range(n): alt_reshape()\nt1 = time.process_time_ns()\nprint(f'movedim:        {(t1-t0)/n/1e6:.3f} ms')\n\n# Use 4D tensor without contiguous for logits bmm?\n# Actually bmm requires 3D contiguous tensor in last two dims\n# Let's try computing q with x @ wq.T directly with proper reshaping\n# using 4D operations instead\n\n# Alternative: compute q as (B*H, L, D) directly by reshaping weights and using bmm\n# x is (B, L, C), wq is (H, D, C). We want (B, H, L, D) -> (BH, L, D)\n# We can't do this with a single bmm because weights are per-head.\n\n# What if we use einops rearrange? Not allowed (only torch+math).\n\n# Try transposing weight beforehand\nwqr_T = wqr.T.contiguous()  # (C, HD)\ndef matmul_T():\n    q = xr @ wqr_T\n    return q\nfor _ in range(3): matmul_T()\nt0 = time.process_time_ns()\nfor _ in range(n): matmul_T()\nt1 = time.process_time_ns()\nprint(f'Pre-transposed: {(t1-t0)/n/1e6:.3f} ms')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_71","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math, time, statistics\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nBH = B * H\nHL = H * L\n\ng = torch.Generator().manual_seed(17*1009+3)\nx = torch.randn(B, L, C, generator=g)\np = torch.randn(BH, L, L, generator=g).softmax(dim=-1)\nG = torch.bmm(x, x.transpose(1, 2))\n\nn = 50\n\n# Method 1: (B, HL, L) @ (B, L, L) -- current\ndef m1():\n    return torch.bmm(p.view(B, HL, L), G).view(BH, L, L)\n\n# Method 2: (BH, L, L) @ (BH, L, L) with expanded G\nG_exp = G.expand(BH, L, L).contiguous()\ndef m2():\n    return torch.bmm(p, G_exp)\n\n# Method 3: 4D matmul (B, H, L, L) @ (B, 1, L, L) = broadcast\np_4d = p.view(B, H, L, L)\nG_4d = G.unsqueeze(1)  # (B, 1, L, L)\ndef m3():\n    return (p_4d @ G_4d).view(BH, L, L)\n\n# Method 4: Use matmul instead of bmm for method 1\ndef m4():\n    return (p.view(B, HL, L) @ G).view(BH, L, L)\n\nresults = {}\nfor name, fn in [('M1 (B,HL,L)@G bmm', m1), ('M2 (BH,L,L)@G_exp bmm', m2), ('M3 4D broadcast', m3), ('M4 matmul', m4)]:\n    for _ in range(5): fn()\n    times = []\n    for i in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        t1 = time.process_time_ns()\n        times.append((t1-t0)/1e6)\n    med = statistics.median(times)\n    results[name] = med\n    print(f'{name:30s}: {med:.4f}ms')\n\n# Reference check\na = m1()\nfor name, fn in [('M2', m2), ('M3', m3), ('M4', m4)]:\n    b = fn()\n    print(f'{name} diff: {(a-b).abs().max().item():.2e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

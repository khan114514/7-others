{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math, time\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nHL = H * L\nBH = B * H\n\ng = torch.Generator().manual_seed(17*1009+3)\nx = torch.randn(B, L, C, generator=g)\np1 = torch.randn(B, H, L, L, generator=g).softmax(dim=-1)\np_mix = torch.randn(B, H, L, L, generator=g).softmax(dim=-1)\n\nn = 50\n\n# G computation alternatives\ndef bmm_gram():\n    return torch.bmm(x, x.transpose(1, 2))\n\ndef matmul_gram():\n    return x @ x.transpose(-1, -2)\n\ndef einsum_gram():\n    return torch.einsum('blc,bmc->blm', x, x)\n\nfor name, fn in [('bmm', bmm_gram), ('matmul', matmul_gram), ('einsum', einsum_gram)]:\n    for _ in range(3): fn()\n    t0 = time.process_time_ns()\n    for _ in range(n): fn()\n    t1 = time.process_time_ns()\n    print(f'G ({name}): {(t1-t0)/n/1e6:.4f} ms')\n\n# p@G alternatives\nG = torch.bmm(x, x.transpose(1, 2))\np1_reshaped = p1.view(B, HL, L)\n\ndef bmm_pG():\n    return torch.bmm(p1_reshaped, G)\n\ndef matmul_pG():\n    return p1_reshaped @ G\n\nfor name, fn in [('bmm', bmm_pG), ('matmul', matmul_pG)]:\n    for _ in range(3): fn()\n    t0 = time.process_time_ns()\n    for _ in range(n): fn()\n    t1 = time.process_time_ns()\n    print(f'p1G ({name}): {(t1-t0)/n/1e6:.4f} ms')\n\n# What about using the 4D version with @ operator?\np1_4d = p1  # (B, H, L, L)\nG_4d = G.unsqueeze(1).expand(B, H, L, L)\ndef bmm_4d():\n    return (p1_4d @ G_4d)\nfor _ in range(3): bmm_4d()\nt0 = time.process_time_ns()\nfor _ in range(n): bmm_4d()\nt1 = time.process_time_ns()\nprint(f'p1G (4D broadcast): {(t1-t0)/n/1e6:.4f} ms')\n\n# What about computing p@x@x\"'^T as (p@x) @ x''^T?\np1_3d = p1.view(BH, L, L)\ndef pxxT():\n    px = torch.bmm(p1_3d, x.unsqueeze(1).expand(BH, L, C).reshape(BH, L, C))\n    return torch.bmm(px, x.unsqueeze(1).expand(BH, L, C).transpose(1, 2))\n# Actually no, we can'\"'t easily expand x across BH with bmm... let's try differently\n# px would be (BH, L, C), and x is (B, L, C). We need px @ x\"'^T per batch.\n# Let'\"'s reshape px to (B, H*L, C) then do (B, H*L, C) @ (B, C, L) = (B, H*L, L)\ndef pxxT_method():\n    # Need p1@x in (BH, L, C) first, which is expensive\n    pass\n\n# Let's just check: what about computing u1 = p1 @ x directly?\n# For the norm we just need sum of squares of u1 along last dim\nx_expanded = x.unsqueeze(1).expand(B, H, L, C).reshape(BH, L, C)\ndef direct_norm():\n    u1 = torch.bmm(p1_3d, x_expanded)\n    return u1.norm(dim=-1, keepdim=True).clamp_min(1e-6)\nfor _ in range(3): direct_norm()\nt0 = time.process_time_ns()\nfor _ in range(n // 5): direct_norm()  # slower, fewer iters\nt1 = time.process_time_ns()\nprint(f'Direct p@x norm: {(t1-t0)/(n//5)/1e6:.4f} ms')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

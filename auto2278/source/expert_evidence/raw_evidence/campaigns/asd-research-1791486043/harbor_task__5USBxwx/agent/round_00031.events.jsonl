{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\n\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\nHD = H * D\nxr = x.reshape(B * L, C)\ninv_sqrt_d = 1.0 / math.sqrt(D)\nBHL = B * H * L\n\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nlogits = q @ k.transpose(-1, -2)\nlogits.mul_(inv_sqrt_d)\n\n# Test: softmax on contiguous 2D view vs 4D in-place\ndef softmax_view():\n    p = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    return p\n\ndef softmax_4d():\n    p = logits.softmax(dim=-1)\n    return p\n\n# warmup\nfor _ in range(5):\n    softmax_view()\n    softmax_4d()\n\nN = 30\nt0 = time.process_time_ns()\nfor _ in range(N):\n    softmax_view()\nt1 = time.process_time_ns()\nprint(f'softmax view 2D: {(t1-t0)/N/1e6:.3f} ms')\n\nt0 = time.process_time_ns()\nfor _ in range(N):\n    softmax_4d()\nt1 = time.process_time_ns()\nprint(f'softmax 4D: {(t1-t0)/N/1e6:.3f} ms')\n\n# verify\np1 = softmax_view()\np2 = softmax_4d()\nprint(f'diff: {(p1-p2).abs().max():.6e}')\n\n# Test: in-place softmax_ (not available for softmax)\n# Test: pre-allocate and use .softmax out= \nprint()\nprint('Testing output pre-allocation:')\nout = torch.empty_like(logits)\ndef softmax_out():\n    torch.softmax(logits, dim=-1, out=out)\n    return out\n\nfor _ in range(5):\n    softmax_out()\n\nt0 = time.process_time_ns()\nfor _ in range(N):\n    softmax_out()\nt1 = time.process_time_ns()\nprint(f'softmax out=: {(t1-t0)/N/1e6:.3f} ms')\n\n# Now the bigger question: can we compute p0 and p1 more efficiently?\n# p0 = softmax(A)\n# p1 = softmax(a_p * A + a_m * A\"'^T)\n# Both require softmax over L-dim on BHL rows\n\n# What about computing everything in one big softmax call?\n# Stack logits and logits_T, compute p0 and p1 together...\n# No, p1 needs a_p*A + a_m*A''^T, not just A''^T\n\nprint()\nprint('\"'Logits memory layout test:')\n# Is logits contiguous in the right way for view-based softmax?\nprint(f'logits is_contiguous: {logits.is_contiguous()}')\nprint(f'logits.view(BHL, L) is_contiguous: {logits.view(BHL, L).is_contiguous()}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

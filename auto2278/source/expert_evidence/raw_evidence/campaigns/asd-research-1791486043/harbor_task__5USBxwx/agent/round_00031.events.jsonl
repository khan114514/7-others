{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\ntorch.set_num_threads(1)\n\n# Largest case: B=1, L=256, C=1280, H=20, D=64\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\n\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\n# Warmup\nfrom solution.method import attention\nfor _ in range(3):\n    attention(x, wq, wk, wv, alpha, beta)\n\n# Measure total\nt0 = time.process_time_ns()\nfor _ in range(11):\n    attention(x, wq, wk, wv, alpha, beta)\nt1 = time.process_time_ns()\nprint(f'Total: {(t1-t0)/11/1e6:.2f} ms')\n\n# Profile stages\nHD = H * D\nBHL = B * H * L\nxr = x.reshape(B * L, C)\ninv_sqrt_d = 1.0 / math.sqrt(D)\n\n# q,k,v projections\nt0 = time.process_time_ns()\nfor _ in range(11):\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nt1 = time.process_time_ns()\nprint(f'q,k,v projections: {(t1-t0)/11/1e6:.2f} ms')\n\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nv = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\n# logits\nt0 = time.process_time_ns()\nfor _ in range(11):\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\nt1 = time.process_time_ns()\nprint(f'logits: {(t1-t0)/11/1e6:.2f} ms')\n\nlogits = q @ k.transpose(-1, -2)\nlogits.mul_(inv_sqrt_d)\n\n# softmax p0\nt0 = time.process_time_ns()\nfor _ in range(11):\n    p0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\nt1 = time.process_time_ns()\nprint(f'softmax p0: {(t1-t0)/11/1e6:.2f} ms')\n\np0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n\n# p1 logits + softmax\na_p = 0.5 * (1.0 + alpha)\na_m = 0.5 * (1.0 - alpha)\nt0 = time.process_time_ns()\nfor _ in range(11):\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\nt1 = time.process_time_ns()\nprint(f'p1 logits + softmax: {(t1-t0)/11/1e6:.2f} ms')\n\np1_logits = logits.mul(a_p)\np1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\np1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n\n# p_mix\nt0 = time.process_time_ns()\nfor _ in range(11):\n    p_mix = torch.lerp(p0, p1, beta)\nt1 = time.process_time_ns()\nprint(f'p_mix (lerp): {(t1-t0)/11/1e6:.2f} ms')\n\np_mix = torch.lerp(p0, p1, beta)\n\n# Gram + norms\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\nt0 = time.process_time_ns()\nfor _ in range(11):\n    p1G = p1 @ G_exp\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\nt1 = time.process_time_ns()\nprint(f'norms (Gram): {(t1-t0)/11/1e6:.2f} ms')\n\n# Output: p_mix @ v * ratio\nt0 = time.process_time_ns()\nfor _ in range(11):\n    y = (p_mix @ v).mul_(ratio)\nt1 = time.process_time_ns()\nprint(f'p_mix @ v + ratio: {(t1-t0)/11/1e6:.2f} ms')\n\n# Reshape output\nt0 = time.process_time_ns()\ny = (p_mix @ v).mul_(ratio)\nfor _ in range(11):\n    out = y.transpose(1, 2).flatten(2).contiguous()\nt1 = time.process_time_ns()\nprint(f'output reshape: {(t1-t0)/11/1e6:.2f} ms')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

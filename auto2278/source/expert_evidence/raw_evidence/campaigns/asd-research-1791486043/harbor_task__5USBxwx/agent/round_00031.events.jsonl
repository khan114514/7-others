wq_3d = wq.transpose(1, 2).reshape(H, C, D)  -- (H, C, D)\n# bmm(x_expanded, wq_3d.expand(B,H,C,D).reshape(B*H,C,D)) => (B*H, L, D)\n# => reshape to (B, H, L, D) -- contiguous\"'!\n\n# But this has memory overhead of expanding x...\n# Let'\"'s just benchmark the alternatives\n\ndef current_proj(w):\n    out = xr @ w.reshape(HD, C).T\n    return out.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\ndef batch_proj(w):\n    # w: (H, D, C) -> w.T per head: (H, C, D)\n    w_t = w.transpose(1, 2)  # (H, C, D)\n    x_b = x.unsqueeze(1).expand(B, H, L, C).reshape(B * H, L, C)\n    w_b = w_t.expand(B, H, C, D).reshape(B * H, C, D)\n    out = torch.bmm(x_b, w_b)  # (B*H, L, D)\n    return out.view(B, H, L, D)\n\n# warmup\nfor _ in range(3):\n    current_proj(wq)\n    batch_proj(wq)\n\nN = 20\nt0 = time.process_time_ns()\nfor _ in range(N):\n    current_proj(wq)\nt1 = time.process_time_ns()\nprint(f'Current proj (single matmul+permute): {(t1-t0)/N/1e6:.2f} ms')\n\nt0 = time.process_time_ns()\nfor _ in range(N):\n    batch_proj(wq)\nt1 = time.process_time_ns()\nprint(f'Batch bmm proj: {(t1-t0)/N/1e6:.2f} ms')\n\nq1 = current_proj(wq)\nq2 = batch_proj(wq)\nprint(f'diff: {(q1-q2).abs().max():.6e}')\nprint(f'q1 contiguous: {q1.is_contiguous()}')\nprint(f'q2 contiguous: {q2.is_contiguous()}')\n\\\"\n\"","aggregated_output":"Current proj (single matmul+permute): 6.98 ms\nBatch bmm proj: 9.54 ms\ndiff: 0.000000e+00\nq1 contiguous: True\nq2 contiguous: True\n","exit_code":0,"status":"completed"}}

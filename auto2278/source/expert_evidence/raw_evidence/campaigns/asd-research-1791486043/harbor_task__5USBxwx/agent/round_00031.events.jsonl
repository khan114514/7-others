{"type":"item.started","item":{"id":"item_65","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 128, 1280, 20, 64\nalpha, beta = 1.15, 3.0\n\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\nHD = H * D\nBHL = B * H * L\ninv_sqrt_d = 1.0 / math.sqrt(D)\nxr = x.reshape(B * L, C)\n\n# Reference computation (starter logic)\nq_ref = torch.einsum('blc,hdc->bhld', x, wq)\nk_ref = torch.einsum('blc,hdc->bhld', x, wk)\nlogits_ref = (q_ref @ k_ref.transpose(-1, -2)) / math.sqrt(D)\np0_ref = logits_ref.softmax(dim=-1)\nbase_ref = p0_ref @ x.unsqueeze(1)\nperturbed = .5 * (1 + alpha) * logits_ref + .5 * (1 - alpha) * logits_ref.transpose(-1, -2)\nmodified_ref = perturbed.softmax(dim=-1) @ x.unsqueeze(1)\nblended_ref = base_ref + beta * (modified_ref - base_ref)\nratio_ref = (modified_ref.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n         / blended_ref.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\ny_ref = torch.einsum('bhlc,hdc->bhld', blended_ref * ratio_ref, wv)\nref_out = y_ref.transpose(1, 2).flatten(2).contiguous()\n\n# Our computation - step by step comparison\nG = x @ x.transpose(-1, -2).unsqueeze(1)\n\nwqr = wq.reshape(HD, C)\nwkr = wk.reshape(HD, C)\nq = (xr @ wqr.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wkr.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\nlogits = q @ k.transpose(-1, -2)\nlogits.mul_(inv_sqrt_d)\n\np0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n\na_p = 0.5 * (1.0 + alpha)\na_m = 0.5 * (1.0 - alpha)\n\np1_logits = logits.mul(a_p)\np1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\np1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n\np_mix = torch.lerp(p0, p1, beta)\n\n# Check p0, p1, p_mix\nprint(f'p0 vs ref max diff: {(p0 - p0_ref).abs().max():.6e}')\n\n# p1 ref\np1_ref_logits = .5 * (1 + alpha) * logits_ref + .5 * (1 - alpha) * logits_ref.transpose(-1, -2)\np1_ref = p1_ref_logits.softmax(dim=-1)\nprint(f'p1 vs ref max diff: {(p1 - p1_ref).abs().max():.6e}')\n\np_mix_ref = (1-beta)*p0_ref + beta*p1_ref\nprint(f'p_mix vs ref max diff: {(p_mix - p_mix_ref).abs().max():.6e}')\n\n# Now check norms\n# ref norms\nu1_ref = modified_ref\nm_ref = blended_ref\nnorm1_ref = u1_ref.norm(dim=-1, keepdim=True).clamp_min(1e-6)\nnormm_ref = m_ref.norm(dim=-1, keepdim=True).clamp_min(1e-6)\nratio_ref2 = (norm1_ref / normm_ref).clamp(0.25, 4.0)\n\n# our norms via Gram\np1G = p1 @ G\nnorm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\npmG = p_mix @ G\nnormm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\nnorm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\nnormm = normm_sq.sqrt_().clamp_min_(1e-6)\nratio_ours = norm1.div_(normm).clamp_(0.25, 4.0)\n\nprint(f'norm1 vs ref max diff: {(norm1 - norm1_ref).abs().max():.6e}')\nprint(f'normm vs ref max diff: {(normm - normm_ref).abs().max():.6e}')\nprint(f'ratio vs ref max diff: {(ratio_ours - ratio_ref2).abs().max():.6e}')\n\n# Now output\nv = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\ny_ours = (p_mix @ v).mul_(ratio_ours)\nout_ours = y_ours.transpose(1, 2).flatten(2).contiguous()\n\nprint(f'output vs ref max diff: {(out_ours - ref_out).abs().max():.6e}')\n\n# What about m_ref @ wv\"'^T (the x-space blend projected to v-space)?\ny_ref2 = (blended_ref * ratio_ref) @ wv.transpose(-1, -2)\nprint(f'\"'y_ref2 vs ref_out max diff: {(y_ref2.transpose(1,2).flatten(2).contiguous() - ref_out).abs().max():.6e}')\n\n# What about p_mix @ v vs m @ wv\"'^T (should be same)\ny_direct = p_mix @ v\ny_from_x = (p_mix_ref @ x.unsqueeze(1)) @ wv.transpose(-1, -2).unsqueeze(0)\nprint(f'\"'p_mix@v vs (p_mix_ref@x)@wv\"'^T max diff: {(y_direct - y_from_x).abs().max():.6e}'\"')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_71","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math\ntorch.set_num_threads(1)\n\nimport sys\nsys.path.insert(0, '/workspace/environment/starter')\nfrom method import attention as ref_attention\nfrom solution.method import attention\n\nprotocol_cases = [\n    {'batch': 1, 'length': 64, 'channels': 512, 'heads': 8, 'dim': 64, 'alpha': 1.05, 'beta': 5.0},\n    {'batch': 1, 'length': 128, 'channels': 640, 'heads': 10, 'dim': 64, 'alpha': 1.1, 'beta': 4.0},\n    {'batch': 1, 'length': 128, 'channels': 1280, 'heads': 20, 'dim': 64, 'alpha': 1.15, 'beta': 3.0},\n    {'batch': 1, 'length': 256, 'channels': 1280, 'heads': 20, 'dim': 64, 'alpha': 1.05, 'beta': 7.5},\n    {'batch': 1, 'length': 256, 'channels': 640, 'heads': 10, 'dim': 64, 'alpha': 1.2, 'beta': 5.0},\n    {'batch': 2, 'length': 128, 'channels': 512, 'heads': 8, 'dim': 64, 'alpha': 1.0, 'beta': 5.0},\n]\n\nall_pass = True\nfor i, case in enumerate(protocol_cases):\n    seed = 17 * 1009 + i\n    g = torch.Generator().manual_seed(seed)\n    b, l, c, h, d = case['batch'], case['length'], case['channels'], case['heads'], case['dim']\n    x = torch.randn(b, l, c, generator=g) * case.get('input_scale', 1.)\n    weights = [torch.randn(h, d, c, generator=g) / math.sqrt(c) for _ in range(3)]\n    wq, wk, wv = weights\n    alpha, beta = case['alpha'], case['beta']\n    \n    ref = ref_attention(x, wq, wk, wv, alpha, beta)\n    out = attention(x, wq, wk, wv, alpha, beta)\n    \n    tol = 3e-5 + 3e-4 * ref.abs()\n    passed = ((out - ref).abs() <= tol).all().item()\n    maxd = (out - ref).abs().max().item()\n    if not passed:\n        all_pass = False\n    print(f'Case {i}: passed={passed}, max_diff={maxd:.6e}, max_tol={tol.max():.6e}')\n\nprint(f'All pass: {all_pass}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

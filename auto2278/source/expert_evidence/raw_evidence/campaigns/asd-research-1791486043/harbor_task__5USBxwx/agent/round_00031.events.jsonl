{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/sh -lc 'cd /workspace && python3 -c \"\nimport torch, time, math\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\n\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\nHD = H * D\nxr = x.reshape(B * L, C)\ninv_sqrt_d = 1.0 / math.sqrt(D)\nBHL = B * H * L\n\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nlogits = q @ k.transpose(-1, -2)\nlogits.mul_(inv_sqrt_d)\np0 = logits.softmax(dim=-1)\n\na_p = 0.5 * (1.0 + alpha)\na_m = 0.5 * (1.0 - alpha)\np1_logits = logits.mul(a_p)\np1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\np1 = p1_logits.softmax(dim=-1)\np_mix = torch.lerp(p0, p1, beta)\n\n# The norm computation is the 2nd biggest cost\n# Let me think: G = x @ x''^T (B, L, L)\n# p @ G for p shape (B, H, L, L) and G shape (B, 1, L, L)\n# Result shape (B, H, L, L)\n# This is B*H matmuls of (L, L) @ (L, L) = B*H*L''^3\n\n# Alternative: use the fact that G is symmetric\n# But torch matmul should already exploit this...\n\n# Alternative: compute norm''^2 = (p @ x).pow(2).sum(-1) via a different route\n# We have v = x @ wv''^T, which is (B,H,L,D)\n# But norm of p@x (in x-space C), not norm of p@v (in v-space D)\n\n# What if we compute: u1 = p1 @ x (B,H,L,C), then norm(u1)\n# Cost: B*H matmuls LxL @ LxC = B*H*L''^2*C\n# = 20 * 256*256*1280 = 1.68B FLOPs for u1, same for m = 3.36B total\n# Gram approach: G = L*L*C = 84M, p@G = 2 * B*H*L''^3 = 2*20*256''^3 = 671M\n# Total: 755M FLOPs vs 3.36B -- Gram is ~4.4x less compute\n\n# But what about the output computation? We need p_mix @ v which is B*H*L*L*D = 84M (tiny)\n\n# Let'\"'s look at a completely different angle: \n# Can we compute everything in the v-space?\n# y = r * (p_mix @ v), where r = ||u1||/||m||, u1 = p1@x, m = p_mix@x\n# The problem is r needs x-space norms\n\n# New idea: compute u0 and u1 (the x-space weighted sums) by direct matmul\n# and reuse them for both norm computation AND output computation\n# Wait, for output we need v-space not x-space...\n\n# Actually, output is (r * m) @ wv\"'^T = r * (m @ wv''^T) = r * (p_mix @ (x @ wv''^T))\n# = r * (p_mix @ v)  (in v-space)\n# For r we need x-space norms\n# We can'\"'t avoid two different space computations\n\n# What if we directly compute u1 = p1 @ x and m = p_mix @ x in x-space?\n# Then we get norms for free (just .norm(dim=-1))\n# But then we also need v-space output... we need v = x @ wv\"'^T anyway\n\n# Wait, what if we compute:\n# u0 = p0 @ x  (B,H,L,C)\n# u1 = p1 @ x  (B,H,L,C)\n# m = u0 + beta*(u1-u0)  (B,H,L,C)\n# norms from u1 and m\n# output = (r * m) @ wv''^T = r * (m @ wv''^T)  (B,H,L,D)\n# m @ wv''^T = m reshaped @ wv reshaped''^T\n\n# Cost breakdown:\n# p0@x: B*H*L''^2*C = 1.68B\n# p1@x: B*H*L''^2*C = 1.68B\n# m: B*H*L*C = 6.5M (elementwise, negligible)\n# norms: B*H*L*C = 6.5M (negligible)\n# m @ wv''^T: B*H*L*C*D = 20*256*1280*64 = 420M\n# Total: ~3.8B FLOPs\n\n# Current approach:\n# q,k,v projections: 3 * B*L*C*H*D = 3*420M = 1.26B  \n# logits: B*H*L''^2*D = 20*256*256*64 = 84M (tiny)\n# softmax x2: small\n# G = x@x''^T: B*L''^2*C = 84M\n# p1@G: B*H*L''^3 = 336M\n# p_mix@G: B*H*L''^3 = 336M\n# p_mix@v: B*H*L''^2*D = 84M\n# Total: ~2.2B FLOPs\n# So current approach already has less compute...\n\n# Let me check if using addmm or other variants helps\n# Let me also check if in-place operations on p1_logits help\n\n# What about computing p0 and p1 softmax with a single combined operation?\n# Not really, they have different inputs.\n\n# What about fusing logits + inv_sqrt_d multiplication into the matmul?\n# We can scale q or k by sqrt(sqrt(D)) before the matmul, but that changes numerical results slightly\n# Actually, logits / sqrt(D) = (q / D''^(1/4)) @ (k / D''^(1/4))''^T\n# But this changes the numerical path slightly. Should be within tolerance.\n\nq_scaled = q * (inv_sqrt_d ** 0.5)\nk_scaled = k * (inv_sqrt_d ** 0.5)\nlogits2 = q_scaled @ k_scaled.transpose(-1, -2)\nlogits1 = q @ k.transpose(-1, -2) * inv_sqrt_d\nprint(f'\"'Scaled qk vs direct logits max diff: {(logits1-logits2).abs().max():.6e}')\n# This should be fine numerically, but is it faster? \n# Probably not - we trade 1 mul on the result for 2 muls on q and k\n# q and k have B*H*L*D = 20*256*64 = 328K elements each\n# logits has B*H*L\"'^2 = 20*256*256 = 1.3M elements\n# So 2*328K muls vs 1.3M muls... slightly less compute but the matmul dominates\n\n# Better: scale q by inv_sqrt_d, leave k. Then q@k''^T has the scale.\n# logits = (q*inv_sqrt_d) @ k''^T  -- same number of muls as direct, may fuse better\n# Probably no meaningful difference\n\nprint()\nprint('\"'Let me check norm computation alternatives more carefully')\n\nG = x @ x.transpose(-1, 2)  # (B, L, L)\nG_exp = G.unsqueeze(1)  # (B, 1, L, L)\n\n# Method 1: current\ndef norm_v1():\n    p1G = p1 @ G_exp\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    return ratio\n\n# Method 2: use (p * (p @ G)) instead of intermediate variable\ndef norm_v2():\n    p1G = p1 @ G_exp\n    norm1_sq = (p1 * p1G).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = (p_mix * pmG).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n    normm = normm_sq.sqrt().clamp_min(1e-6)\n    ratio = (norm1 / normm).clamp(0.25, 4.0)\n    return ratio\n\n# Method 3: compute p_mix = (1-beta)*p0 + beta*p1, then p_mix@G = (1-beta)*p0G + beta*p1G\n# This avoids the p_mix @ G matmul, replacing it with elementwise operations\ndef norm_v3():\n    p0G = p0 @ G_exp\n    p1G = p1 @ G_exp\n    norm0_sq = (p0 * p0G).sum(dim=-1, keepdim=True)\n    norm1_sq = (p1 * p1G).sum(dim=-1, keepdim=True)\n    dot_01 = (p0 * p1G).sum(dim=-1, keepdim=True)\n    b1 = 1.0 - beta\n    normm_sq = b1*b1*norm0_sq + beta*beta*norm1_sq + 2*b1*beta*dot_01\n    norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n    normm = normm_sq.sqrt().clamp_min(1e-6)\n    ratio = (norm1 / normm).clamp(0.25, 4.0)\n    return ratio\n\n# Method 4: like v3 but with in-place\ndef norm_v4():\n    p0G = p0 @ G_exp\n    p1G = p1 @ G_exp\n    norm0_sq = p0G.mul_(p0).sum(dim=-1, keepdim=True)\n    norm1_sq = (p1 * p1G).sum(dim=-1, keepdim=True)\n    dot_01 = (p0 * p1G).sum(dim=-1, keepdim=True)\n    b1 = 1.0 - beta\n    normm_sq = norm0_sq.mul_(b1*b1)\n    normm_sq.add_(norm1_sq * (beta*beta))\n    normm_sq.add_(dot_01, alpha=2*b1*beta)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    return ratio\n\nfor _ in range(5):\n    norm_v1()\n    norm_v2()\n    norm_v3()\n    norm_v4()\n\nN = 20\nt0 = time.process_time_ns()\nfor _ in range(N):\n    norm_v1()\nt1 = time.process_time_ns()\nprint(f'v1 (current): {(t1-t0)/N/1e6:.2f} ms')\n\nt0 = time.process_time_ns()\nfor _ in range(N):\n    norm_v2()\nt1 = time.process_time_ns()\nprint(f'v2 (no inplace): {(t1-t0)/N/1e6:.2f} ms')\n\nt0 = time.process_time_ns()\nfor _ in range(N):\n    norm_v3()\nt1 = time.process_time_ns()\nprint(f'v3 (p0G+p1G, replace 1 matmul with elementwise): {(t1-t0)/N/1e6:.2f} ms')\n\nt0 = time.process_time_ns()\nfor _ in range(N):\n    norm_v4()\nt1 = time.process_time_ns()\nprint(f'v4 (v3 + inplace): {(t1-t0)/N/1e6:.2f} ms')\n\nr1 = norm_v1()\nr3 = norm_v3()\nr4 = norm_v4()\nprint(f'v1 vs v3 max diff: {(r1-r3).abs().max():.6e}')\nprint(f'v1 vs v4 max diff: {(r1-r4).abs().max():.6e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

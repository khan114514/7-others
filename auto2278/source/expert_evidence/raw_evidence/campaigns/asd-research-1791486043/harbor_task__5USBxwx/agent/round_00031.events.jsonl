{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\nimport torch.nn.functional as F\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\n\nx = torch.randn(B, L, C)\nw = torch.randn(H, D, C)\n\nHD = H * D\nxr = x.reshape(B * L, C)\n\n# Method 1: current (reshape + matmul + reshape + permute + contiguous)\ndef proj1(w):\n    return (xr @ w.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\n# Method 2: F.linear\nw_2d = w.reshape(HD, C)\ndef proj2():\n    return F.linear(x, w_2d).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\n# Method 3: addmm\ndef proj3():\n    out = torch.empty(B * L, HD)\n    out.addmm_(xr, w.reshape(HD, C).T)\n    return out.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\n# Method 4: compute directly in BH, L, D layout by doing H separate matmuls\n# x (B, L, C), w[h] (D, C), per head: x @ w[h].T = (B, L, D)\ndef proj4():\n    outs = []\n    for h in range(H):\n        outs.append(x @ w[h].T)\n    return torch.stack(outs, dim=1)\n\nfor _ in range(5):\n    proj1(w)\n    proj2()\n    proj3()\n    proj4()\n\nN = 20\nt0 = time.process_time_ns()\nfor _ in range(N):\n    proj1(w)\nt1 = time.process_time_ns()\nprint(f'1. reshape+matmul+permute+contiguous: {(t1-t0)/N/1e6:.3f} ms')\n\nt0 = time.process_time_ns()\nfor _ in range(N):\n    proj2()\nt1 = time.process_time_ns()\nprint(f'2. F.linear: {(t1-t0)/N/1e6:.3f} ms')\n\nt0 = time.process_time_ns()\nfor _ in range(N):\n    proj3()\nt1 = time.process_time_ns()\nprint(f'3. addmm_: {(t1-t0)/N/1e6:.3f} ms')\n\nt0 = time.process_time_ns()\nfor _ in range(N):\n    proj4()\nt1 = time.process_time_ns()\nprint(f'4. per-head loop + stack: {(t1-t0)/N/1e6:.3f} ms')\n\nr1 = proj1(w)\nr2 = proj2()\nr3 = proj3()\nr4 = proj4()\nprint(f'1 vs 2 diff: {(r1-r2).abs().max():.6e}')\nprint(f'1 vs 3 diff: {(r1-r3).abs().max():.6e}')\nprint(f'1 vs 4 diff: {(r1-r4).abs().max():.6e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\ntorch.set_num_threads(1)\n\n# Let me profile each case to understand where time is spent per case\ncases = [\n    (1, 64, 512, 8, 64, 1.05, 5.0),\n    (1, 128, 640, 10, 64, 1.1, 4.0),\n    (1, 128, 1280, 20, 64, 1.15, 3.0),\n    (1, 256, 1280, 20, 64, 1.05, 7.5),\n    (1, 256, 640, 10, 64, 1.2, 5.0),\n    (2, 128, 512, 8, 64, 1.0, 5.0),\n]\n\nfrom solution.method import attention\n\nfor idx, (B, L, C, H, D, alpha, beta) in enumerate(cases):\n    x = torch.randn(B, L, C)\n    wq = torch.randn(H, D, C)\n    wk = torch.randn(H, D, C)\n    wv = torch.randn(H, D, C)\n    for _ in range(3):\n        attention(x, wq, wk, wv, alpha, beta)\n    t0 = time.process_time_ns()\n    for _ in range(11):\n        attention(x, wq, wk, wv, alpha, beta)\n    t1 = time.process_time_ns()\n    ms = (t1-t0)/11/1e6\n    print(f'Case {idx}: B={B} L={L} C={C} H={H} D={D} alpha={alpha} -> {ms:.2f} ms')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

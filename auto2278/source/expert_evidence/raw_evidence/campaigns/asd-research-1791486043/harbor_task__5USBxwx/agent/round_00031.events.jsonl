{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\n\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\nHD = H * D\nxr = x.reshape(B * L, C)\n\n# Separate projections\ndef separate():\n    q = xr @ wq.reshape(HD, C).T\n    k = xr @ wk.reshape(HD, C).T\n    v = xr @ wv.reshape(HD, C).T\n    return q, k, v\n\n# Fused qk projection\nw_qk = torch.cat([wq.reshape(HD, C), wk.reshape(HD, C)], dim=0)\ndef fused_qk():\n    out = xr @ w_qk.T\n    q, k = out.split(HD, dim=1)\n    return q, k\n\n# Fused all 3\nw_all = torch.cat([wq.reshape(HD, C), wk.reshape(HD, C), wv.reshape(HD, C)], dim=0)\ndef fused_all():\n    out = xr @ w_all.T\n    q, k, v = out.split(HD, dim=1)\n    return q, k, v\n\nfor _ in range(5):\n    separate()\n    fused_qk()\n    fused_all()\n\nN = 20\nt0 = time.process_time_ns()\nfor _ in range(N):\n    separate()\nt1 = time.process_time_ns()\nprint(f'Separate (3 matmuls): {(t1-t0)/N/1e6:.3f} ms')\n\nt0 = time.process_time_ns()\nfor _ in range(N):\n    fused_qk()\nt1 = time.process_time_ns()\nprint(f'Fused qk (1 matmul): {(t1-t0)/N/1e6:.3f} ms')\n\nt0 = time.process_time_ns()\nfor _ in range(N):\n    fused_all()\nt1 = time.process_time_ns()\nprint(f'Fused all (1 matmul): {(t1-t0)/N/1e6:.3f} ms')\n\n# Verify\nqs, ks, vs = separate()\nqf, kf, vf = fused_all()\nprint(f'q diff: {(qs-qf).abs().max():.6e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

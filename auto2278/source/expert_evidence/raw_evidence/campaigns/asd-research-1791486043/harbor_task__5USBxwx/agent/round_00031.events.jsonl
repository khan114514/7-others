{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\n\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\nHD = H * D\nxr = x.reshape(B * L, C)\ninv_sqrt_d = 1.0 / math.sqrt(D)\nBHL = B * H * L\n\n# Approach: compute q,k in (B, L, H, D) layout, then compute logits differently\n# logits[b,h,i,j] = sum_d q[b,h,i,d] * k[b,h,j,d]\n# = sum_d q[b,i,h,d] * k[b,j,h,d]\n# Can we compute this efficiently with (B, L, H, D) layout?\n\n# Option: compute logits as:\n# q: (B, L, H, D), k: (B, L, H, D)\n# logits[b,h,i,j] = sum_d q[b,i,h,d] * k[b,j,h,d]\n# = einsum('bihd,bjhd->bhij', q, k)\n\nq_bld = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D)\nk_bld = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D)\nv_bld = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D)\n\nq_bhld = q_bld.permute(0, 2, 1, 3).contiguous()\nk_bhld = k_bld.permute(0, 2, 1, 3).contiguous()\n\n# Method 1: current (BH, L, D) layout\ndef logits_current():\n    return q_bhld @ k_bhld.transpose(-1, -2) * inv_sqrt_d\n\n# Method 2: einsum with (B, L, H, D)\ndef logits_einsum():\n    return torch.einsum('bihd,bjhd->bhij', q_bld, k_bld) * inv_sqrt_d\n\n# Method 3: reshape q,k to (B*H, L, D) without contiguous\nq_reshaped = q_bld.permute(0, 2, 1, 3)  # (B, H, L, D) non-contiguous\nk_reshaped = k_bld.permute(0, 2, 1, 3)\ndef logits_permuted():\n    return (q_reshaped @ k_reshaped.transpose(-1, -2)) * inv_sqrt_d\n\n# warmup\nfor _ in range(5):\n    logits_current()\n    logits_einsum()\n    logits_permuted()\n\nN = 30\nt0 = time.process_time_ns()\nfor _ in range(N):\n    logits_current()\nt1 = time.process_time_ns()\nprint(f'Current (contiguous BH, L, D): {(t1-t0)/N/1e6:.3f} ms')\n\nt0 = time.process_time_ns()\nfor _ in range(N):\n    logits_einsum()\nt1 = time.process_time_ns()\nprint(f'Einsum BLHD: {(t1-t0)/N/1e6:.3f} ms')\n\nt0 = time.process_time_ns()\nfor _ in range(N):\n    logits_permuted()\nt1 = time.process_time_ns()\nprint(f'Permuted (non-contiguous): {(t1-t0)/N/1e6:.3f} ms')\n\nl1 = logits_current()\nl2 = logits_einsum()\nl3 = logits_permuted()\nprint(f'current vs einsum diff: {(l1-l2).abs().max():.6e}')\nprint(f'current vs permuted diff: {(l1-l3).abs().max():.6e}')\nprint()\n\n# Also check: can we avoid contiguous() for q,k but still compute logits efficiently?\n# The permuted (non-contiguous) approach avoids the contiguous copy\n# Let's see total cost of proj + logits with and without contiguous\n\ndef full_current():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    return logits\n\ndef full_nocontig():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    return logits\n\nfor _ in range(3):\n    full_current()\n    full_nocontig()\n\nN = 20\nt0 = time.process_time_ns()\nfor _ in range(N):\n    full_current()\nt1 = time.process_time_ns()\nprint(f'Full current (with contiguous): {(t1-t0)/N/1e6:.2f} ms')\n\nt0 = time.process_time_ns()\nfor _ in range(N):\n    full_nocontig()\nt1 = time.process_time_ns()\nprint(f'Full no-contig: {(t1-t0)/N/1e6:.2f} ms')\n\nf1 = full_current()\nf2 = full_nocontig()\nprint(f'diff: {(f1-f2).abs().max():.6e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

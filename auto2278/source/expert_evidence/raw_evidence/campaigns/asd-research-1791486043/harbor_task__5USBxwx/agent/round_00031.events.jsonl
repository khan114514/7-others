{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/sh -lc 'cd /workspace && python3 -c \"\nimport torch, time, math\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\n\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\nfrom solution.method import attention\n# warmup\nfor _ in range(3):\n    attention(x, wq, wk, wv, alpha, beta)\n\n# Reference output\nref = attention(x, wq, wk, wv, alpha, beta)\n\n# Now test: compute norms via direct approach on v-space instead of x-space\n# Instead of norm of p@x, compute norm of p@v where v = x @ wv''^T is what we use anyway\n# Wait, no - r*m is multiplied by wv''^T at the end. The norm is applied to u0, u1 which are in x-space\n# u = p @ x, so u has shape (B,H,L,C)\n# r = clamp(||u1|| / ||m||, 0.25, 4.0)\n# return (r*m) @ wv''^T\n\n# Alternative: directly compute y = (r*m) @ wv''^T without computing m in x-space\n# m = (1-beta)*u0 + beta*u1\n# u0 = p0 @ x, u1 = p1 @ x\n# m = ((1-beta)*p0 + beta*p1) @ x = p_mix @ x\n# y = (r * (p_mix @ x)) @ wv''^T\n# r = ||p1@x|| / ||p_mix@x|| (clamped)\n\n# So we need: y_i = r_i * (p_mix @ v)_i where v = x @ wv''^T... no wait\n# (r * m) @ wv''^T: m is (B,H,L,C), r is (B,H,L,1)\n# = r * (m @ wv''^T) -- scalar r multiplies per-token, then projected to v-space\n# = r * (p_mix @ x) @ wv''^T\n# = r * (p_mix @ v)  where v = x @ wv''^T of shape (B,H,L,D)\n\n# So y = r * (p_mix @ v), and r = ||u1||/||m||, u1 = p1@x, m = p_mix@x\n# Norm is in x-space (C-dimensional), not v-space (D-dimensional)\n\n# Can we compute ||p@x|| efficiently?\n# ||p@x||''^2 = sum_j (sum_i p_i * x_i) . (sum_k p_k * x_k) ... no\n# ||p @ x||''^2 for each row: (p @ x) dot (p @ x) = (p @ x) @ (p @ x)''^T diagonal\n# = sum_c (sum_i p_i x_ic) * (sum_j p_j x_jc)\n# = sum_c sum_i sum_j p_i p_j x_ic x_jc\n# = sum_i sum_j p_i p_j (x_i dot x_j)\n# = p @ (x @ x''^T) @ p''^T -- take diagonal\n# Which is exactly (p @ G * p).sum(-1) where G = x @ x''^T\n\n# That'\"'s what we do already. G is LxL symmetric.\n# p is (B,H,L,L), so p @ G_exp is B*H*L matmuls of size LxL @ LxL = O(L\"'^3) per head\n# With B=1,H=20,L=256: 20 * 256''^3 = 20*16.8M = 335M ops, plus elementwise\n# That'\"'s the 12.7ms...\n\n# Alternative: compute u = p@x directly then take norm\n# p@x: B*H matmuls of LxL @ LxC = B*H*L\"'^2*C ops\n# With B=1,H=20,L=256,C=1280: 20 * 256*256*1280 = 20*84M = 1.7B ops\n# norm: B*H*L*C elementwise + reduce = 20*256*1280 = 6.5M (negligible)\n# Total: ~1.7B ops, vs Gram approach: 20 * L''^3 (for p@G) + L''^2*C (for G itself)\n# Gram: G = x@x''^T = L*L*C = 256*256*1280 = 84M\n# p@G: B*H * L*L*L = 20*16.8M = 336M (each is LxL @ LxL)\n# Actually, wait: p is (B,H,L,L), G_exp is (B,1,L,L), so p @ G_exp is (B,H,L,L)\n# That'\"'s B*H matmuls of size LxL @ LxL = B*H*L\"'^3 FLOPs\n# = 20*256''^3 = 335.5M FLOPs for p1@G and p_mix@G = 671M FLOPs\n# Plus G construction: L*L*C = 84M FLOPs\n# Total norm cost: ~755M FLOPs\n\n# Direct approach: compute u1 = p1@x, m = p_mix@x, then norms\n# u1: B*H matmuls LxL @ LxC = 20*256*256*1280 = 1.68B FLOPs\n# m: same = 1.68B FLOPs\n# Total: 3.36B FLOPs -- MUCH worse!\n\n# Wait, but we already compute p_mix @ v for the output. v is LxD\n# p_mix @ v: B*H*L*L*D = 20*256*256*64 = 84M FLOPs (small)\n# And we need p_mix @ x for the norms...\n\n# Key insight: can we avoid computing p_mix @ x?\n# m = (1-beta)*u0 + beta*u1\n# ||m||''^2 = (1-beta)''^2*||u0||''^2 + beta''^2*||u1||''^2 + 2*(1-beta)*beta*(u0 dot u1)\n# u0 dot u1 = (p0 @ x) dot (p1 @ x) = p0 @ G @ p1''^T -- diagonal\n\n# So we need ||u0||''^2, ||u1||''^2, and u0·u1\n# ||u0||''^2 = (p0 @ G * p0).sum(-1)  -- p0@G is B*H*L''^3\n# ||u1||''^2 = (p1 @ G * p1).sum(-1)  -- p1@G is B*H*L''^3\n# u0·u1    = (p0 @ G * p1).sum(-1)  -- but we already computed p0@G for u0!\n# Wait no, we need p_mix@G currently: p_mix = (1-beta)*p0 + beta*p1\n# p_mix @ G = (1-beta)*p0@G + beta*p1@G\n# And (p_mix @ G * p_mix).sum(-1) = ||m||''^2\n\n# Current code does:\n# p1 @ G (for norm1_sq = (p1G * p1).sum)\n# p_mix @ G (for normm_sq = (pmG * p_mix).sum)\n# = 2 x B*H*L''^3 matmuls\n\n# If we compute p0@G and p1@G instead:\n# norm0_sq = (p0G * p0).sum\n# norm1_sq = (p1G * p1).sum  \n# dot_01 = (p0G * p1).sum  -- free since we have p0G\n# normm_sq = (1-beta)''^2 * norm0_sq + beta''^2 * norm1_sq + 2*(1-beta)*beta * dot_01\n# This way we do p0@G + p1@G = 2 matmuls (same number), just different ones\n# But wait, we already compute p1@G... we'\"'d replace p_mix@G with p0@G\n# Same number of matmuls, no gain\n\n# What about computing G only as upper triangle? Not easy with torch.\n\n# What about computing p_mix @ x directly and taking norm?\n# m = p_mix @ x, u1 = p1 @ x, then norms\n# Cost: B*H*L\"'^2*C for each = 2 * 20*256''^2*1280 = 2*1.68B = 3.36B vs Gram'\"'s ~755M\n# Gram is better\n\n# Another angle: what if we don't need full p_mix @ G?\n# We only need the diagonals of p_mix @ G @ p_mix\"'^T, i.e. row-wise dot products\n# This IS (p_mix @ G * p_mix).sum(-1), which is what we compute.\n\n# What about using torch.bmm or something more efficient?\n# Let'\"'s check if the reshape/view approach helps\n\nG = x @ x.transpose(-1, -2)  # (B,L,L)\nG_exp = G.unsqueeze(1)  # (B,1,L,L)\n\nfrom solution.method import attention\n# setup\nHD = H * D\nxr = x.reshape(B * L, C)\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nv = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nlogits = q @ k.transpose(-1, -2)\nlogits.mul_(1.0/math.sqrt(D))\nBHL = B * H * L\np0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\na_p = 0.5 * (1.0 + alpha)\na_m = 0.5 * (1.0 - alpha)\np1_logits = logits.mul(a_p)\np1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\np1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\np_mix = torch.lerp(p0, p1, beta)\n\n# Method A: current (4D matmul)\ndef norm_method_a():\n    p1G = p1 @ G_exp\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    return ratio\n\n# Method B: reshape to 3D bmm\ndef norm_method_b():\n    p1_3d = p1.reshape(B*H, L, L)\n    pm_3d = p_mix.reshape(B*H, L, L)\n    G_3d = G.expand(B*H, L, L)\n    p1G = torch.bmm(p1_3d, G_3d).view(B, H, L, L)\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = torch.bmm(pm_3d, G_3d).view(B, H, L, L)\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    return ratio\n\n# Method C: compute u1 and m in v-space, but we need x-space norms...\n# Wait, no, r is applied to m, then multiplied by wv\"'^T\n# y = r * m @ wv''^T\n# r = ||u1||_x / ||m||_x\n\n# What if we compute u = p@x directly but use a different approach?\ndef norm_method_direct():\n    u1 = p1 @ x.unsqueeze(1)  # B,H,L,C\n    m = p_mix @ x.unsqueeze(1)\n    norm1 = u1.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n    normm = m.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n    ratio = (norm1 / normm).clamp(0.25, 4.0)\n    return ratio\n\n# warmup\nfor _ in range(3):\n    norm_method_a()\n    norm_method_b()\n    norm_method_direct()\n\nN = 20\nt0 = time.process_time_ns()\nfor _ in range(N):\n    norm_method_a()\nt1 = time.process_time_ns()\nprint(f'\"'Method A (4D matmul): {(t1-t0)/N/1e6:.2f} ms')\n\nt0 = time.process_time_ns()\nfor _ in range(N):\n    norm_method_b()\nt1 = time.process_time_ns()\nprint(f'Method B (bmm): {(t1-t0)/N/1e6:.2f} ms')\n\nt0 = time.process_time_ns()\nfor _ in range(N):\n    norm_method_direct()\nt1 = time.process_time_ns()\nprint(f'Method Direct (p@x): {(t1-t0)/N/1e6:.2f} ms')\n\n# verify\nr_a = norm_method_a()\nr_b = norm_method_b()\nr_d = norm_method_direct()\nprint(f'A vs B max diff: {(r_a-r_b).abs().max():.6e}')\nprint(f'A vs D max diff: {(r_a-r_d).abs().max():.6e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

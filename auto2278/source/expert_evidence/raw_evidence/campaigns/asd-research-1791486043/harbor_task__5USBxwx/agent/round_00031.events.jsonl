{"type":"item.started","item":{"id":"item_55","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\n\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\nfrom solution.method import attention\n\n# warmup\nfor _ in range(3):\n    attention(x, wq, wk, wv, alpha, beta)\n\n# precise total timing\nN = 20\nt0 = time.process_time_ns()\nfor _ in range(N):\n    attention(x, wq, wk, wv, alpha, beta)\nt1 = time.process_time_ns()\ntotal_ms = (t1-t0)/N/1e6\nprint(f'Total: {total_ms:.3f} ms')\n\n# Now let me try an idea: compute everything without the v projection, \n# but instead compute the output from x-space via m @ wv\"'^T\n# Wait no, that'\"'s slower.\n\n# Let me try the key idea: can we avoid the permute+contiguous on q and k\n# by computing logits differently?\n\nHD = H * D\nxr = x.reshape(B * L, C)\ninv_sqrt_d = 1.0 / math.sqrt(D)\nBHL = B * H * L\n\n# Approach A: current (permute+contiguous + contiguous logits)\ndef approach_a():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    return logits, q, k, v\n\n# Approach B: compute logits via einsum bihd, bjhd -> bhij (no permute+contiguous)\ndef approach_b():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D)\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D)\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D)\n    logits = torch.einsum('bihd,bjhd->bhij', q, k) * inv_sqrt_d\n    return logits, q, k, v\n\n# Approach C: reshape q,k to (B*H, L, D) non-contiguous, then do bmm\ndef approach_c():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    q_b = q.reshape(B*H, L, D)\n    k_b = k.reshape(B*H, L, D)\n    logits = (q_b @ k_b.transpose(-1, -2)).view(B, H, L, L)\n    logits.mul_(inv_sqrt_d)\n    return logits, q, k, v\n\nfor _ in range(5):\n    approach_a()\n    approach_b()\n    approach_c()\n\nN = 20\nt0 = time.process_time_ns()\nfor _ in range(N):\n    approach_a()\nt1 = time.process_time_ns()\nprint(f'Approach A (permute+contiguous): {(t1-t0)/N/1e6:.3f} ms')\n\nt0 = time.process_time_ns()\nfor _ in range(N):\n    approach_b()\nt1 = time.process_time_ns()\nprint(f'Approach B (einsum BLHD): {(t1-t0)/N/1e6:.3f} ms')\n\nt0 = time.process_time_ns()\nfor _ in range(N):\n    approach_c()\nt1 = time.process_time_ns()\nprint(f'Approach C (non-contig reshape + bmm): {(t1-t0)/N/1e6:.3f} ms')\n\nla, _, _, _ = approach_a()\nlb, _, _, _ = approach_b()\nlc, _, _, _ = approach_c()\nprint(f'A vs B diff: {(la-lb).abs().max():.6e}')\nprint(f'A vs C diff: {(la-lc).abs().max():.6e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

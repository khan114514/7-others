0)/N/1e6:.2f} ms')\n\n# verify\nr_a = norm_method_a()\nr_b = norm_method_b()\nr_d = norm_method_direct()\nprint(f'A vs B max diff: {(r_a-r_b).abs().max():.6e}')\nprint(f'A vs D max diff: {(r_a-r_d).abs().max():.6e}')\n\\\"\n\"","aggregated_output":"Method A (4D matmul): 10.91 ms\nMethod B (bmm): 10.90 ms\nMethod Direct (p@x): 56.10 ms\nA vs B max diff: 0.000000e+00\nA vs D max diff: 4.172325e-07\n","exit_code":0,"status":"completed"}}

{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\n\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\nHD = H * D\nxr = x.reshape(B * L, C)\ninv_sqrt_d = 1.0 / math.sqrt(D)\n\n# Alternative full pipeline in BLHD layout\ndef attention_blhd():\n    # Projections: (B*L, C) @ (C, HD) -> (B*L, HD) -> (B, L, H, D)\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D)\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D)\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D)\n    \n    # logits[b,h,i,j] = sum_d q[b,i,h,d] * k[b,j,h,d]\n    # Reshape q and k for batched matmul\n    # q: (B, L, H, D) -> (B, H, L, D) is what we need for matmul\n    # But we want to avoid permute+contiguous\n    # Use einsum? Slow.\n    # Use reshape trick?\n    \n    # Alternative: compute logits via:\n    # q reshaped to (B*H, L, D), k reshaped to (B*H, L, D)\n    # q.transpose to get there...\n    logits = q.permute(0, 2, 1, 3) @ k.permute(0, 2, 1, 3).transpose(-1, -2) * inv_sqrt_d\n    # logits is (B, H, L, L)\n    \n    p0 = logits.softmax(dim=-1)\n    \n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    \n    # Output: p_mix @ v where v is (B, H, L, D)\n    # But v is in (B, L, H, D) layout...\n    v_bhld = v.permute(0, 2, 1, 3)\n    y = p_mix @ v_bhld\n    \n    # Norms via Gram\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    p1G = p1 @ G_exp\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    \n    y = y.mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\nfrom solution.method import attention\n\n# warmup\nfor _ in range(3):\n    attention(x, wq, wk, wv, alpha, beta)\n    attention_blhd()\n\nN = 11\nt0 = time.process_time_ns()\nfor _ in range(N):\n    attention(x, wq, wk, wv, alpha, beta)\nt1 = time.process_time_ns()\nprint(f'Current: {(t1-t0)/N/1e6:.2f} ms')\n\nt0 = time.process_time_ns()\nfor _ in range(N):\n    attention_blhd()\nt1 = time.process_time_ns()\nprint(f'BLHD variant: {(t1-t0)/N/1e6:.2f} ms')\n\nr1 = attention(x, wq, wk, wv, alpha, beta)\nr2 = attention_blhd()\nprint(f'diff: {(r1-r2).abs().max():.6e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

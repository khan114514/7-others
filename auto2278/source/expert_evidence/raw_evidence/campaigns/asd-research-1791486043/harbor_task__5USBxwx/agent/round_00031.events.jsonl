{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\n\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\nHD = H * D\nxr = x.reshape(B * L, C)\ninv_sqrt_d = 1.0 / math.sqrt(D)\nBHL = B * H * L\n\n# Method 1: separate projections (current)\ndef separate():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    return q, k, v\n\n# Method 2: fused projection\ndef fused():\n    w_all = torch.cat([wq.reshape(HD, C), wk.reshape(HD, C), wv.reshape(HD, C)], dim=0)\n    out = xr @ w_all.T\n    q_flat, k_flat, v_flat = out.split([HD, HD, HD], dim=1)\n    q = q_flat.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = k_flat.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = v_flat.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    return q, k, v\n\n# Warmup\nfor _ in range(3):\n    separate()\n    fused()\n\nN = 20\nt0 = time.process_time_ns()\nfor _ in range(N):\n    separate()\nt1 = time.process_time_ns()\nprint(f'Separate: {(t1-t0)/N/1e6:.2f} ms')\n\nt0 = time.process_time_ns()\nfor _ in range(N):\n    fused()\nt1 = time.process_time_ns()\nprint(f'Fused: {(t1-t0)/N/1e6:.2f} ms')\n\n# Verify\nq1, k1, v1 = separate()\nq2, k2, v2 = fused()\nprint(f'q max diff: {(q1-q2).abs().max():.6e}')\nprint(f'k max diff: {(k1-k2).abs().max():.6e}')\nprint(f'v max diff: {(v1-v2).abs().max():.6e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

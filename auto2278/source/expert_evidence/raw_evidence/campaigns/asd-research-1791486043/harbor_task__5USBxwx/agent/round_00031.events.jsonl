{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/sh -lc 'cd /workspace && python3 -c \"\nimport torch, time, math\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\n\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\nHD = H * D\nxr = x.reshape(B * L, C)\ninv_sqrt_d = 1.0 / math.sqrt(D)\nBHL = B * H * L\n\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nlogits = q @ k.transpose(-1, -2)\nlogits.mul_(inv_sqrt_d)\np0 = logits.softmax(dim=-1)\n\na_p = 0.5 * (1.0 + alpha)\na_m = 0.5 * (1.0 - alpha)\np1_logits = logits.mul(a_p)\np1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\np1 = p1_logits.softmax(dim=-1)\np_mix = torch.lerp(p0, p1, beta)\n\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\n\n# Current: 4D matmul\ndef norm_current():\n    p1G = p1 @ G_exp\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    return ratio\n\n# Reshape to 3D and use bmm (with expanded G)\nG_bmm = G.expand(B*H, L, L).contiguous()\np1_3d = p1.reshape(B*H, L, L)\npm_3d = p_mix.reshape(B*H, L, L)\n\ndef norm_bmm():\n    p1G = torch.bmm(p1_3d, G_bmm).view(B, H, L, L)\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = torch.bmm(pm_3d, G_bmm).view(B, H, L, L)\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    return ratio\n\n# Try: compute norms using einsum\n# ||p@x||''^2_i = sum_jk p_ij p_ik G_jk = einsum('\"'bij,bik,jk->bi', p, p, G)\ndef norm_einsum():\n    norm1_sq = torch.einsum('bhij,bhik,bjk->bhi', p1, p1, G).unsqueeze(-1)\n    normm_sq = torch.einsum('bhij,bhik,bjk->bhi', p_mix, p_mix, G).unsqueeze(-1)\n    norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n    normm = normm_sq.sqrt().clamp_min(1e-6)\n    ratio = (norm1 / normm).clamp(0.25, 4.0)\n    return ratio\n\nfor _ in range(5):\n    norm_current()\n    norm_bmm()\n    norm_einsum()\n\nN = 20\nt0 = time.process_time_ns()\nfor _ in range(N):\n    norm_current()\nt1 = time.process_time_ns()\nprint(f'Current (4D matmul): {(t1-t0)/N/1e6:.2f} ms')\n\nt0 = time.process_time_ns()\nfor _ in range(N):\n    norm_bmm()\nt1 = time.process_time_ns()\nprint(f'bmm (expanded G): {(t1-t0)/N/1e6:.2f} ms')\n\nt0 = time.process_time_ns()\nfor _ in range(N):\n    norm_einsum()\nt1 = time.process_time_ns()\nprint(f'einsum: {(t1-t0)/N/1e6:.2f} ms')\n\nr1 = norm_current()\nr2 = norm_bmm()\nr3 = norm_einsum()\nprint(f'current vs bmm diff: {(r1-r2).abs().max():.6e}')\nprint(f'current vs einsum diff: {(r1-r3).abs().max():.6e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

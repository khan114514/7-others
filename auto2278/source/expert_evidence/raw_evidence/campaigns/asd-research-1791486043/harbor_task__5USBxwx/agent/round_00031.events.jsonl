{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\n\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\nHD = H * D\ninv_sqrt_d = 1.0 / math.sqrt(D)\nBHL = B * H * L\n\n# Current approach: reshape to (B*L, C) @ (HD, C).T -> (B*L, HD)\n# Then reshape to (B, L, H, D), permute to (B, H, L, D)\nxr = x.reshape(B * L, C)\n\n# Alternative: compute q, k as (B, H, L, D) directly via bmm or batch matmul\n# wq is (H, D, C), x.unsqueeze(1) is (B, 1, L, C)\n# q = x.unsqueeze(1) @ wq.T(?) -- need to think about shapes\n\n# x shape (B, L, C), wq shape (H, D, C)\n# q[b,h,l,d] = sum_c x[b,l,c] * wq[h,d,c]\n# This is like: for each head, x @ wq[h].T\n# = (B, L, C) @ (C, D) = (B, L, D) per head\n# total H matmuls: B*L*C*D * H = B*H*L*C*D\n\n# Current: (B*L, C) @ (C, H*D) = B*L*C*H*D (same FLOPs, one big matmul)\n# One big matmul should be more efficient...\n\n# But then we have the permute+contiguous cost\n# What if we avoid the permute by computing in a layout that's already (B, H, L, D)?\n\n# Current sequence:\n# out = (B*L,C) @ (C,HD) => (B*L, HD)\n# reshape => (B, L, H, D)  -- free if contiguous\n# permute(0,2,1,3) => (B, H, L, D) -- not contiguous\n# contiguous() => copies data\n# Total: 1 matmul + 1 copy (permute+contiguous)\n\n# Alternative: compute (B, H, L, D) directly\n# = x.unsqueeze(1) @ wq.mT  -- wait, wq is (H, D, C), we need (H, C, D)\n# wq.transpose(1,2) is (H, C, D)\n# x.unsqueeze(1).expand(B,H,L,C) @ wq.transpose(1,2).expand(B,H,C,D)\n# = (B, H, L, C) @ (B, H, C, D) = (B, H, L, D)\n# This is B*H matmuls of L*C*D = same FLOPs\n\n# But bmm with B*H batch size:\n# x_3d = x.reshape(B*L, C).unsqueeze(0).expand(H, B*L, C) -- no, that's bad\n\n# Better: x_expanded = x.unsqueeze(1).expand(B, H, L, C).reshape(B*H, L, C)\n# wq_3d = wq.transpose(1, 2).reshape(H, C, D)  -- (H, C, D)\n# bmm(x_expanded, wq_3d.expand(B,H,C,D).reshape(B*H,C,D)) => (B*H, L, D)\n# => reshape to (B, H, L, D) -- contiguous\"'!\n\n# But this has memory overhead of expanding x...\n# Let'\"'s just benchmark the alternatives\n\ndef current_proj(w):\n    out = xr @ w.reshape(HD, C).T\n    return out.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\ndef batch_proj(w):\n    # w: (H, D, C) -> w.T per head: (H, C, D)\n    w_t = w.transpose(1, 2)  # (H, C, D)\n    x_b = x.unsqueeze(1).expand(B, H, L, C).reshape(B * H, L, C)\n    w_b = w_t.expand(B, H, C, D).reshape(B * H, C, D)\n    out = torch.bmm(x_b, w_b)  # (B*H, L, D)\n    return out.view(B, H, L, D)\n\n# warmup\nfor _ in range(3):\n    current_proj(wq)\n    batch_proj(wq)\n\nN = 20\nt0 = time.process_time_ns()\nfor _ in range(N):\n    current_proj(wq)\nt1 = time.process_time_ns()\nprint(f'Current proj (single matmul+permute): {(t1-t0)/N/1e6:.2f} ms')\n\nt0 = time.process_time_ns()\nfor _ in range(N):\n    batch_proj(wq)\nt1 = time.process_time_ns()\nprint(f'Batch bmm proj: {(t1-t0)/N/1e6:.2f} ms')\n\nq1 = current_proj(wq)\nq2 = batch_proj(wq)\nprint(f'diff: {(q1-q2).abs().max():.6e}')\nprint(f'q1 contiguous: {q1.is_contiguous()}')\nprint(f'q2 contiguous: {q2.is_contiguous()}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

r similar?\n\nLet me try another angle: what if we compute `p1 @ G` using a different BLAS call? Like `torch.mm` on reshaped 2D?\n\n`p1` reshaped: (B*H*L, L), `G` is (L, L), we want (B*H*L, L).\nThat's just `p1.reshape(BHL, L) @ G` = (BHL, L) @ (L, L) = (BHL, L).\n\nLet me check if this is faster than the 4D approach:\n</think>\n</think>\n"}}
{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, time, math\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\n\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\nHD = H * D\nxr = x.reshape(B * L, C)\ninv_sqrt_d = 1.0 / math.sqrt(D)\nBHL = B * H * L\n\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nlogits = q @ k.transpose(-1, -2)\nlogits.mul_(inv_sqrt_d)\np0 = logits.softmax(dim=-1)\na_p = 0.5 * (1.0 + alpha)\na_m = 0.5 * (1.0 - alpha)\np1_logits = logits.mul(a_p)\np1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\np1 = p1_logits.softmax(dim=-1)\np_mix = torch.lerp(p0, p1, beta)\n\nG = x @ x.transpose(-1, -2)  # (B, L, L)\n\n# Method A: 4D matmul with broadcast G\nG_exp = G.unsqueeze(1)  # (B,1,L,L)\ndef method_a():\n    p1G = p1 @ G_exp\n    pmG = p_mix @ G_exp\n    return p1G, pmG\n\n# Method B: 2D matmul (BHL, L) @ (L, L)\nG_2d = G.reshape(L, L)  # B=1\ndef method_b():\n    p1G = (p1.reshape(BHL, L) @ G_2d).view(B, H, L, L)\n    pmG = (p_mix.reshape(BHL, L) @ G_2d).view(B, H, L, L)\n    return p1G, pmG\n\n# Method C: mm (same as @ but explicit)\ndef method_c():\n    p1G = torch.mm(p1.reshape(BHL, L), G_2d).view(B, H, L, L)\n    pmG = torch.mm(p_mix.reshape(BHL, L), G_2d).view(B, H, L, L)\n    return p1G, pmG\n\n# Method D: bmm with expanded G\nG_bmm = G.expand(B*H, L, L)\np1_3d = p1.reshape(B*H, L, L)\npm_3d = p_mix.reshape(B*H, L, L)\ndef method_d():\n    p1G = torch.bmm(p1_3d, G_bmm).view(B, H, L, L)\n    pmG = torch.bmm(pm_3d, G_bmm).view(B, H, L, L)\n    return p1G, pmG\n\nfor _ in range(5):\n    method_a()\n    method_b()\n    method_c()\n    method_d()\n\nN = 20\nt0 = time.process_time_ns()\nfor _ in range(N):\n    method_a()\nt1 = time.pro
{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport torch\nimport time\nimport math\nimport statistics\nimport torch.nn.functional as F\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nHD = H * D\nBH = B * H\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nw = torch.randn(H, D, C)\nxr = x.reshape(B * L, C)\nwr = w.reshape(HD, C)\n\ndef time_fn(fn, n=30):\n    for _ in range(5): fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return statistics.median(times)\n\n# Big matmul: x @ w.T (our current)\ndef t1():\n    return xr @ wr.T\nprint(f'x @ w.T (big): {time_fn(t1):.3f} ms')\n\n# F.linear\ndef t2():\n    return F.linear(xr, wr)\nprint(f'F.linear: {time_fn(t2):.3f} ms')\n\n# matmul\ndef t3():\n    return torch.matmul(xr, wr.T)\nprint(f'torch.matmul: {time_fn(t3):.3f} ms')\n\n# x[0] @ each head's weight (per-head for single batch)\ndef t4():\n    out = []\n    for h in range(H):\n        out.append(x[0] @ w[h].T)\n    return torch.stack(out, dim=0)  # (H, L, D)\nprint(f'per head @ (loop): {time_fn(t4):.3f} ms')\n\n# batched matmul: (H, L, C) @ (H, C, D) -> (H, L, D)\n# for B=1 case\nxb = x.expand(H, L, C).contiguous()  # (H, L, C)\nwb = w.transpose(1, 2)  # (H, C, D)\ndef t5():\n    return torch.bmm(xb, wb)\nprint(f'bmm per-head (H batch): {time_fn(t5):.3f} ms')\n\n# Hmm, expand adds overhead. What about the general B>1 case?\n# x: (B, L, C), w: (H, D, C)\n# Output: (B, H, L, D)\n# Can we do: x.repeat(H, 1, 1) view (BH, L, C) bmm w.expand(B, H, C, D) view (BH, C, D)?\n# That's what the big matmul already does but in one shot.\n\n# Let me test all three projections at once\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\n# Three separate big matmuls (current)\ndef three_big():\n    q = xr @ wq.reshape(HD, C).T\n    k = xr @ wk.reshape(HD, C).T\n    v = xr @ wv.reshape(HD, C).T\n    return q, k, v\nprint(f'\\\\\\\\n3 big matmuls: {time_fn(three_big):.3f} ms')\n\n# One stacked matmul\nw_all = torch.cat([wq.reshape(HD, C), wk.reshape(HD, C), wv.reshape(HD, C)], dim=0)\ndef one_stacked():\n    return xr @ w_all.T\nprint(f'1 stacked matmul: {time_fn(one_stacked):.3f} ms')\n\n# What about: 3H per-head matmuls via bmm with 3H batch\nw_all_3h = torch.cat([wq, wk, wv], dim=0)  # (3H, D, C)\nw_all_3h_t = w_all_3h.transpose(1, 2)  # (3H, C, D)\nx_3h = x[0].expand(3*H, L, C).contiguous()  # (3H, L, C)\ndef bmm_3h():\n    return torch.bmm(x_3h, w_all_3h_t)\nprint(f'bmm 3H batch: {time_fn(bmm_3h):.3f} ms')\n\n# Now check across cases - for small L and large C, big matmul might be better\n# For large L and small C? Let me test case 0\nB2, L2, C2, H2, D2 = 1, 64, 512, 8, 64\nx2 = torch.randn(B2, L2, C2)\nw2 = torch.randn(H2, D2, C2)\nxr2 = x2.reshape(B2 * L2, C2)\nwr2 = w2.reshape(H2*D2, C2)\n\ndef big_small():\n    return xr2 @ wr2.T\n\nx_3h2 = x2[0].expand(3*H2, L2, C2).contiguous()\nw_3h2 = torch.cat([w2, w2, w2], dim=0).transpose(1, 2)\ndef bmm_small():\n    return torch.bmm(x_3h2, w_3h2)\n\nprint(f'\\\\\\\\nCase 0 size: big={time_fn(big_small):.4f} ms, bmm_3h={time_fn(bmm_small):.4f} ms')\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport torch\nimport time\nimport math\nimport statistics\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha = 1.05\nbeta = 7.5\nBH = B * H\nHD = H * D\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\nxr = x.reshape(B * L, C)\ninv_sqrt_d = 1.0 / math.sqrt(D)\n\ndef time_fn(fn, n=20):\n    for _ in range(3): fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return statistics.median(times)\n\n# Get logits, p0, p1\nq = (xr @ wq.reshape(HD, C).T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\nk = (xr @ wk.reshape(HD, C).T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\nq.mul_(inv_sqrt_d)\nlogits = torch.bmm(q, k.transpose(1, 2))\np0 = logits.softmax(dim=-1)\na_p = 0.5 * (1.0 + alpha)\na_m = 0.5 * (1.0 - alpha)\np1_logits = logits.mul(a_p)\np1_logits.add_(logits.transpose(1, 2), alpha=a_m)\np1 = p1_logits.softmax(dim=-1)\np_mix = torch.lerp(p0, p1, beta)\n\nv = (xr @ wv.reshape(HD, C).T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n\n# Approach: compute y = (1-beta)*p0@v + beta*p1@v (without materializing p_mix)\ndef y_lerp():\n    # y = p_mix @ v = ((1-beta)*p0 + beta*p1) @ v = (1-beta)*(p0@v) + beta*(p1@v)\n    y0 = torch.bmm(p0, v)\n    y1 = torch.bmm(p1, v)\n    y0.lerp_(y1, beta)\n    return y0\n\ndef y_direct():\n    return torch.bmm(p_mix, v)\n\ny_a = y_lerp()\ny_b = y_direct()\nprint(f'y_lerp vs direct match: {torch.allclose(y_a, y_b, atol=1e-6)}')\nprint(f'y_lerp: {time_fn(y_lerp):.3f} ms')\nprint(f'y_direct: {time_fn(y_direct):.3f} ms')\n\n# This is 2 bmms vs 1 — slower. Not worth it.\n\n# What about: can we compute p1_logits in-place on logits, then softmax in-place?\n# But we still need the original logits for p0 (well, no — we already computed p0)\n# Wait, p0 = softmax(logits). After computing p0, we don't need logits anymore.\n# So we CAN reuse logits memory for p1_logits\"'!\n\n# Let me check if in-place softmax saves allocation time\nlogits2 = logits.clone()\ndef softmax_inplace_style():\n    # compute p1_logits in-place on a copy of logits (simulating reuse)\n    tmp = logits2.clone()\n    tmp.mul_(a_p).add_(logits2.transpose(1, 2), alpha=a_m)\n    return tmp.softmax_(dim=-1)\n\ndef softmax_normal():\n    p1_l = logits.mul(a_p)\n    p1_l.add_(logits.transpose(1, 2), alpha=a_m)\n    return p1_l.softmax(dim=-1)\n\nprint(f'\"'\\\\\\\\nsoftmax inplace: {time_fn(softmax_inplace_style):.3f} ms')\nprint(f'softmax normal: {time_fn(softmax_normal):.3f} ms')\n# Hard to measure allocation time in isolation; the savings come from less allocation pressure\n\n# Let me try a fully optimized version with minimal allocations\n# Key idea: reuse logits memory for p1 computation\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

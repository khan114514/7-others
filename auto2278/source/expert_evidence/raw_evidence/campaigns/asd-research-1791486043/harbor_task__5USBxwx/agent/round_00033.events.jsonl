x (expensive) + m@wv''^T (expensive)\n# Gram approach: G = x@x''^T (BL*L*C = 21M), 2 * (p@G + mul+sum) (2 * BH*L*L*L = 2*20*128''^3 = 84M)\n#   + v-proj (210M) + p_mix@v (21M) = ~336M for norms + output\n# Direct approach: p1@x (BH*L*L*C = 420M) + p_mix@x (420M) + m@wv''^T (210M) = 1050M\n# Gram is way better. Confirmed.\n\n# So projections are the bottleneck. What can we do?\n# 1. Fuse q+k projections into one matmul? Same total FLOPS.\n# 2. Use float16? No, output must be float32 exact.\n# 3. What about MKLDNN / torch.compile? No, can'\"'t use compile.\n# 4. Can we avoid computing all of q and k? Only logits matter. logits = q @ k\"'^T / sqrt(D)\n#    q = x @ wq''^T, k = x @ wk''^T\n#    logits[b,h,i,j] = sum_d q[b,h,i,d] * k[b,h,j,d] / sqrt(D)\n#    = sum_d (sum_c x[b,i,c] * wq[h,d,c]) * (sum_c'\"' x[b,j,c'] * wk[h,d,c']) / sqrt(D)\n#    = sum_c sum_c' x[b,i,c] * x[b,j,c'] * sum_d wq[h,d,c] * wk[h,d,c'] / sqrt(D)\n#    = sum_c sum_c' X_ij * K_h[c,c'] / sqrt(D)\n#    where K_h = wq_h\"'^T @ wk_h (C x C)\n#    and logits[b,h] = x_b @ K_h @ x_b''^T / sqrt(D)\n#    \n#    Cost: K_h computation: H * C * D * C = H * C''^2 * D = 20 * 1280''^2 * 64 = 2097M (way more!)\n#    No good.\n\nprint('\"'Analysis confirmed: Gram approach is optimal for norms+output')\n\\\" 2>&1\n\"","aggregated_output":"Traceback (most recent call last):\n  File \"<string>\", line 24, in <module>\nModuleNotFoundError: No module named 'method'\n","exit_code":1,"status":"failed"}}
{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport torch\nimport time\nimport math\nimport statistics\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n# Check if torch.baddbmm or fused ops help, or if we can reduce softmax cost.\nB, L, C, H, D = 1, 128, 1280, 20, 64\nalpha = 1.15\nbeta = 3.0\nBH = B * H\nHD = H * D\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nxr = x.reshape(B * L, C)\ninv_sqrt_d = 1.0 / math.sqrt(D)\n\nq = (xr @ wq.reshape(HD, C).T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\nk = (xr @ wk.reshape(HD, C).T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n\nlogits = torch.bmm(q, k.transpose(1, 2)) * inv_sqrt_d\n\ndef time_fn(fn, n=50):\n    for _ in range(5): fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return statistics.median(times)\n\n# Softmax in-place style vs regular\ndef softmax_regular():\n    return logits.softmax(dim=-1)\n\n# Test log_softmax + exp\ndef logsoftmax_exp():\n    return logits.log_softmax(dim=-1).exp_()\n\nprint(f'softmax: {time_fn(softmax_regular):.3f} ms')\nprint(f'log_softmax + exp: {time_fn(logsoftmax_exp):.3f} ms')\n\n# Check 2D vs 3D softmax speed\nlogits_2d = logits.view(BH * L, L)\ndef softmax_2d():\n    return logits_2d.softmax(dim=-1)\nprint(f'2D softmax: {time_fn(softmax_2d):.3f} ms')\n\n# Try the full pipeline with alpha == 1 path? case 6 has alpha=1.0\n# For non-alpha==1, we do 2 softmaxes. Can we fuse p1 computation?\n# p1 = softmax(a_p * A + a_m * A\"'^T)\n# Let me check if there'\"'s a way to compute p1 more efficiently\n\n# What about using the OUT view to save memory allocation?\np0 = torch.empty_like(logits)\ndef softmax_out():\n    return torch.softmax(logits, dim=-1, out=p0)\n# actually torch.softmax doesn't take out param directly\n\n# Check if torch.nn.functional.softmax is same\nimport torch.nn.functional as F\ndef f_softmax():\n    return F.softmax(logits, dim=-1)\nprint(f'F.softmax: {time_fn(f_softmax):.3f} ms')\n\n# Manual softmax for 2D\ndef manual_softmax_2d():\n    x2d = logits_2d\n    m = x2d.max(dim=-1, keepdim=True).values\n    e = (x2d - m).exp_()\n    s = e.sum(dim=-1, keepdim=True)\n    return e.div_(s)\nprint(f'manual 2d softmax: {time_fn(manual_softmax_2d):.3f} ms')\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/sh -lc 'cd /workspace && python3 -c \"\nimport torch\nimport time\nimport math\nimport statistics\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n# Test the two approaches on case 3: p_mix@v vs (p_mix*x)@wv''^T\nB, L, C, H, D = 1, 128, 1280, 20, 64\nalpha = 1.15\nbeta = 3.0\nBH = B * H\nHD = H * D\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\n# Get p_mix\nfrom method import attention as _\nxr = x.reshape(B * L, C)\ninv_sqrt_d = 1.0 / math.sqrt(D)\nq = (xr @ wq.reshape(HD, C).T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\nk = (xr @ wk.reshape(HD, C).T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\nq.mul_(inv_sqrt_d)\nlogits = torch.bmm(q, k.transpose(1, 2))\np0 = logits.softmax(dim=-1)\na_p = 0.5 * (1.0 + alpha)\na_m = 0.5 * (1.0 - alpha)\np1_logits = logits.mul(a_p)\np1_logits.add_(logits.transpose(1, 2), alpha=a_m)\np1 = p1_logits.softmax(dim=-1)\np_mix = torch.lerp(p0, p1, beta)\n\ndef time_fn(fn, n=30):\n    for _ in range(5): fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return statistics.median(times)\n\n# Approach A: compute v = x @ wv''^T, then p_mix @ v  (current)\ndef approach_A():\n    v = (xr @ wv.reshape(HD, C).T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    y = torch.bmm(p_mix, v)\n    return y\n\n# Approach B: compute m = p_mix @ x, then m @ wv''^T \n# p_mix is (BH, L, L), x is (B, L, C). We need p_mix@x for each head.\n# p_mix.view(B, H, L, L) @ x.unsqueeze(1) -> (B, H, L, C)\n# Then matmul with wv: (B, H, L, C) @ (H, D, C)''^T -> einsum\ndef approach_B():\n    m = torch.bmm(p_mix, x.expand(BH, L, C))  # (BH, L, C)\n    y = m.view(B, H, L, C).transpose(1, 2).flatten(0, 1)  # (B*L, H*C) -- no wrong\n    # Actually: m (BH, L, C). We want y (BH, L, D) where y[b*h] = m[b*h] @ wv[h]''^T\n    # This is a batched matmul: (BH, L, C) @ (H, C, D) -> ... \n    # Actually wv is (H, D, C), so wv''^T per head is (C, D)\n    # We have (BH, L, C) and want (BH, L, D). We can do:\n    wvr = wv.transpose(1, 2).reshape(C, HD)  # (C, H*D) - no, this gives per-head output\n    # Hmm, actually y[b,l,h,d] = sum_c m[b,h,l,c] * wv[h,d,c]\n    # m reshaped to (B*H, L, C), wv reshaped to (H, D, C)\n    # We want (B*H, L, D)\n    # Can'\"'t do simple matmul because the H dimension doesn't batch correctly\n    # Correct approach: m is (B, H, L, C), wv is (H, D, C)\n    # y[b,h,l,d] = sum_c m[b,h,l,c] * wv[h,d,c]\n    # = einsum('bhlc,hdc->bhld', m, wv)\n    # But we know this is expensive...\n    m4d = p_mix.view(B, H, L, L) @ x.unsqueeze(1)  # (B, H, L, C)\n    y = torch.einsum('bhlc,hdc->bhld', m4d, wv)\n    return y.reshape(BH, L, D)\n\n# Approach C: p_mix (BH, L, L) @ x (B, L, C) tiled to (BH, L, C) = (BH, L, C)\n# Then reshape to (B*L, H*C) ? No. Reshape to (B*L, H, C)...\n# y[b,l,h,d] = sum_c m[b,h,l,c] * wv[h,d,c]\n# If we have m_reshaped = m.view(B, H, L, C).transpose(1,2) = (B, L, H, C)\n# then y[b,l,h,d] = sum_c m[b,l,h,c] * wv[h,d,c]\n# This is (B*L, H, C) @ (H, C, D) -> batched matmul over H?\n# (B*L, H, C) bmm (H, C, D) won't work because H is different from B*L\n# Actually: for each head h, we have M_h of size (B*L, C) and wv_h of size (D, C)\n# output_h = M_h @ wv_h\"'^T  -> (B*L, D)\n# This is H matrix multiplications, each (BL, C) @ (C, D) -> (BL, D)\n# Total FLOPS: H * BL * C * D. Same as a single (BL, H*C) @ (H*C, H*D)? No way to block it.\n# Actually total is same as 1 big matmul: BL * C * HD = BL * C * H * D\n# Same as v-projection cost. So no savings.\n\nprint(f'\"'Approach A (v-proj + p_mix@v): {time_fn(approach_A):.3f} ms')\n\n# Let me not test B fully since einsum is known slow. Let me think of approach D.\n# Approach D: Can we compute y = p_mix @ x @ wv\"'^T differently?\n# The key insight: we'\"'re computing u1 = p1 @ x, m = p_mix @ x (both needed for norms anyway\"'!)\n# Then output = (ratio * m) @ wv''^T\n# If we do norms via direct u1@x approach instead of Gram, we ALREADY have u1 and m.\n# Then we save the separate v-projection + p_mix@v cost, and instead just do m @ wv''^T\n# But wait, m is (BH, L, C) and wv is (H, D, C). That'\"'s not a simple matmul.\n# Unless we reorganize...\n\n# Let's compute cost of direct u1 = p1 @ x, m = p_mix @ x:\n# p_mix is (BH, L, L), x tiled is (BH, L, C)\n# Each bmm: BH * L * L * C FLOPS\n# For case 3: BH=20, L=128, C=1280 -> 20 * 128 * 128 * 1280 = 420M per bmm, 2 bmms = 840M\n# Plus m @ wv\"'^T: what'\"'s the best way?\n# m: (B, H, L, C) or (BH, L, C), wv: (H, D, C)\n# If we reshape m to (B, L, H*C) - no that doesn't help.\n# Actually, what if we think of it as output[b,l,h,d] = sum_c m[b,h,l,c] * wv[h,d,c]\n# = sum_c m[b,h,l,c] * wv_T[h,c,d] where wv_T = wv.transpose(-1,-2)\n# This is a batch matmul over (B*H) batches: each batch is (L, C) @ (C, D)\n# m.view(BH, L, C) @ wv_T -> we need wv expanded to (BH, C, D)\n# wv_T_b = wv.transpose(1, 2).expand(B, H, C, D).reshape(BH, C, D)  -- no, expand doesn't copy\n# Actually we'd need wv_T = wv.transpose(1,2).repeat(B, 1, 1).reshape(BH, C, D)\n# That's B*H*C*D memory = 20*1280*64*4 = 6.5 MB. Not bad.\n# But the bmm would be BH * L * C * D = 20 * 128 * 1280 * 64 = 210M FLOPS.\n# That's the same FLOPS as v-projection (BL * C * HD = 128 * 1280 * 1280 = 210M).\n# So no FLOP savings.\n\n# WAIT. The current approach does:\n# 1. v-proj: BL * C * HD = 128 * 1280 * 1280 = 210M FLOPS\n# 2. p_mix @ v: BH * L * L * D = 20 * 128 * 128 * 64 = 21M FLOPS\n# Total: 231M FLOPS for the output projection\n\n# Direct approach (if we already have m from norms):\n# 1. m @ wv\"'^T (batched): BH * L * C * D = 20 * 128 * 1280 * 64 = 210M FLOPS\n# Same! So no savings either way.\n\n# The real question is: Gram (cheap) + v-proj (expensive) vs Direct p@x (expensive) + m@wv''^T (expensive)\n# Gram approach: G = x@x''^T (BL*L*C = 21M), 2 * (p@G + mul+sum) (2 * BH*L*L*L = 2*20*128''^3 = 84M)\n#   + v-proj (210M) + p_mix@v (21M) = ~336M for norms + output\n# Direct approach: p1@x (BH*L*L*C = 420M) + p_mix@x (420M) + m@wv''^T (210M) = 1050M\n# Gram is way better. Confirmed.\n\n# So projections are the bottleneck. What can we do?\n# 1. Fuse q+k projections into one matmul? Same total FLOPS.\n# 2. Use float16? No, output must be float32 exact.\n# 3. What about MKLDNN / torch.compile? No, can'\"'t use compile.\n# 4. Can we avoid computing all of q and k? Only logits matter. logits = q @ k\"'^T / sqrt(D)\n#    q = x @ wq''^T, k = x @ wk''^T\n#    logits[b,h,i,j] = sum_d q[b,h,i,d] * k[b,h,j,d] / sqrt(D)\n#    = sum_d (sum_c x[b,i,c] * wq[h,d,c]) * (sum_c'\"' x[b,j,c'] * wk[h,d,c']) / sqrt(D)\n#    = sum_c sum_c' x[b,i,c] * x[b,j,c'] * sum_d wq[h,d,c] * wk[h,d,c'] / sqrt(D)\n#    = sum_c sum_c' X_ij * K_h[c,c'] / sqrt(D)\n#    where K_h = wq_h\"'^T @ wk_h (C x C)\n#    and logits[b,h] = x_b @ K_h @ x_b''^T / sqrt(D)\n#    \n#    Cost: K_h computation: H * C * D * C = H * C''^2 * D = 20 * 1280''^2 * 64 = 2097M (way more!)\n#    No good.\n\nprint('\"'Analysis confirmed: Gram approach is optimal for norms+output')\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/sh -lc 'cd /workspace && python3 -c \"\nimport torch\nimport time\nimport math\nimport statistics\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n# Test the two approaches on case 3: p_mix@v vs (p_mix*x)@wv''^T\nB, L, C, H, D = 1, 128, 1280, 20, 64\nalpha = 1.15\nbeta = 3.0\nBH = B * H\nHD = H * D\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\n# Get p_mix\nfrom method import attention as _\nxr = x.reshape(B * L, C)\ninv_sqrt_d = 1.0 / math.sqrt(D)\nq = (xr @ wq.reshape(HD, C).T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\nk = (xr @ wk.reshape(HD, C).T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\nq.mul_(inv_sqrt_d)\nlogits = torch.bmm(q, k.transpose(1, 2))\np0 = logits.softmax(dim=-1)\na_p = 0.5 * (1.0 + alpha)\na_m = 0.5 * (1.0 - alpha)\np1_logits = logits.mul(a_p)\np1_logits.add_(logits.transpose(1, 2), alpha=a_m)\np1 = p1_logits.softmax(dim=-1)\np_mix = torch.lerp(p0, p1, beta)\n\ndef time_fn(fn, n=30):\n    for _ in range(5): fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return statistics.median(times)\n\n# Approach A: compute v = x @ wv''^T, then p_mix @ v  (current)\ndef approach_A():\n    v = (xr @ wv.reshape(HD, C).T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    y = torch.bmm(p_mix, v)\n    return y\n\n# Approach B: compute m = p_mix @ x, then m @ wv''^T \n# p_mix is (BH, L, L), x is (B, L, C). We need p_mix@x for each head.\n# p_mix.view(B, H, L, L) @ x.unsqueeze(1) -> (B, H, L, C)\n# Then matmul with wv: (B, H, L, C) @ (H, D, C)''^T -> einsum\ndef approach_B():\n    m = torch.bmm(p_mix, x.expand(BH, L, C))  # (BH, L, C)\n    y = m.view(B, H, L, C).transpose(1, 2).flatten(0, 1)  # (B*L,
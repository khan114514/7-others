{"type":"item.started","item":{"id":"item_71","type":"command_execution","command":"/bin/sh -lc 'cd /workspace/solution && python3 -c \"\nimport torch\nimport time\nimport math\nimport statistics\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha = 1.05\nbeta = 7.5\nBH = B * H\nHD = H * D\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\nxr = x.reshape(B * L, C)\ninv_sqrt_d = 1.0 / math.sqrt(D)\n\nq = (xr @ wq.reshape(HD, C).T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\nk = (xr @ wk.reshape(HD, C).T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\nq.mul_(inv_sqrt_d)\nlogits = torch.bmm(q, k.transpose(1, 2))\np0 = logits.softmax(dim=-1)\na_p = 0.5 * (1.0 + alpha)\na_m = 0.5 * (1.0 - alpha)\np1_logits = logits.mul(a_p)\np1_logits.add_(logits.transpose(1, 2), alpha=a_m)\np1 = p1_logits.softmax(dim=-1)\nv = (xr @ wv.reshape(HD, C).T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n\nG = x @ x.transpose(-1, -2)\nG_tiled = G.expand(BH, L, L).contiguous()\n\ndef time_fn(fn, n=20):\n    for _ in range(5): fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return statistics.median(times)\n\n# Approach A (current): materialize p_mix, then p_mix@v, p_mix@G\ndef approach_A():\n    p_mix = torch.lerp(p0, p1, beta)\n    y = torch.bmm(p_mix, v)\n    p1G = torch.bmm(p1, G_tiled)\n    n1 = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = torch.bmm(p_mix, G_tiled)\n    nm = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    return y, n1, nm\n\n# Approach B: compute p0@v, p1@v, then lerp. Compute p0@G, p1@G, then use quadratic expansion for nm.\n# p_mix = (1-b)*p0 + b*p1\n# p_mix@v = (1-b)*(p0@v) + b*(p1@v)\n# norm_m''^2 = (1-b)''^2 * n0 + b''^2 * n1 + 2*b*(1-b) * (p0@G * p1).sum(-1)\ndef approach_B():\n    p0v = torch.bmm(p0, v)\n    p1v = torch.bmm(p1, v)\n    y = p0v.lerp_(p1v, beta)\n    \n    p0G = torch.bmm(p0, G_tiled)\n    p1G = torch.bmm(p1, G_tiled)\n    n1 = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    n0 = p0G.mul_(p0).sum(dim=-1, keepdim=True)\n    cross = p0G.mul_(p1).sum(dim=-1, keepdim=True)\n    \n    b1 = 1.0 - beta\n    nm = b1*b1 * n0 + beta*beta * n1 + 2*beta*b1 * cross\n    return y, n1, nm\n\ny_a, n1a, nma = approach_A()\ny_b, n1b, nmb = approach_B()\nprint(f'\"'y match: {torch.allclose(y_a, y_b, atol=1e-5)}')\nprint(f'n1 match: {torch.allclose(n1a, n1b, atol=1e-5)}')\nprint(f'nm max diff: {(nma-nmb).abs().max():.2e}')\n\n# Check ratio\nr_a = n1a.sqrt().clamp_min_(1e-6) / nma.sqrt().clamp_min_(1e-6)\nr_a.clamp_(0.25, 4.0)\nr_b = n1b.sqrt().clamp_min_(1e-6) / nmb.sqrt().clamp_min_(1e-6)\nr_b.clamp_(0.25, 4.0)\nprint(f'ratio max diff: {(r_a-r_b).abs().max():.2e}')\nprint(f'ratio allclose: {torch.allclose(r_a, r_b, atol=3e-5, rtol=3e-4)}')\n\nprint(f'\\\\\\\\nApproach A: {time_fn(approach_A):.3f} ms')\nprint(f'Approach B: {time_fn(approach_B):.3f} ms')\n\n# Approach B does: 2 bmm for output (vs 1), 2 bmm for norms (vs 2) = 4 bmm total vs 3\n# Plus extra multiplications for the quadratic expansion.\n# Should be slower, but might save p_mix allocation. Let's see.\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

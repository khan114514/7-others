{"type":"item.started","item":{"id":"item_89","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport torch\nimport time\nimport math\nimport statistics\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\ncases = [\n    (1, 64, 512, 8, 64, 1.05, 5.0),\n    (1, 128, 640, 10, 64, 1.1, 4.0),\n    (1, 128, 1280, 20, 64, 1.15, 3.0),\n    (1, 256, 1280, 20, 64, 1.05, 7.5),\n    (1, 256, 640, 10, 64, 1.2, 5.0),\n    (2, 128, 512, 8, 64, 1.0, 5.0),\n]\n\nfrom method import attention as current_attention\n\n# Transposed matmul approach: (w @ x.T).T instead of x @ w.T\ndef attn_tproj(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H = wq.shape[0]\n    D = wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BH = B * H\n    xr = x.reshape(B * L, C)\n    xrt = xr.T.contiguous()  # (C, BL) - pre-transpose x\n    \n    wqr = wq.reshape(HD, C)\n    wkr = wk.reshape(HD, C)\n    wvr = wv.reshape(HD, C)\n    \n    # (HD, C) @ (C, BL) = (HD, BL) -> transpose -> (BL, HD)\n    q = (wqr @ xrt).T.view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    k = (wkr @ xrt).T.view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    q.mul_(inv_sqrt_d)\n    \n    logits = torch.bmm(q, k.transpose(1, 2))\n    p0 = logits.softmax(dim=-1)\n    \n    if alpha == 1.0:\n        v = (wvr @ xrt).T.view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n        y = torch.bmm(p0, v)\n    else:\n        a_p = 0.5 + 0.5 * alpha\n        a_m = 0.5 - 0.5 * alpha\n        p1_logits = logits.mul(a_p).add_(logits.transpose(1, 2), alpha=a_m)\n        p1 = p1_logits.softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        \n        G = x @ x.transpose(-1, -2)\n        G_tiled = G.expand(BH, L, L).contiguous()\n        \n        p1G = torch.bmm(p1, G_tiled)\n        norm1 = p1G.mul_(p1).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n        pmG = torch.bmm(p_mix, G_tiled)\n        normm = pmG.mul_(p_mix).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n        \n        v = (wvr @ xrt).T.view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n        y = torch.bmm(p_mix, v).mul_(ratio)\n    \n    return y.view(B, H, L, D).transpose(1, 2).flatten(2).contiguous()\n\n# Verify\nall_ok = True\nfor i, (B, L, C, H, D, alpha, beta) in enumerate(cases):\n    torch.manual_seed(i*100+7)\n    x = torch.randn(B, L, C)\n    wq = torch.randn(H, D, C)\n    wk = torch.randn(H, D, C)\n    wv = torch.randn(H, D, C)\n    y1 = current_attention(x, wq, wk, wv, alpha, beta)\n    y2 = attn_tproj(x, wq, wk, wv, alpha, beta)\n    ok = torch.allclose(y1, y2, atol=3e-5, rtol=3e-4)\n    if not ok:\n        diff = (y1-y2).abs().max()\n        rel = (diff / y1.abs().clamp(min=1e-8)).max()\n        print(f'Case {i}: FAIL, abs={diff:.2e}, rel={rel:.2e}')\n        all_ok = False\nprint(f'All correct: {all_ok}')\n\nif not all_ok:\n    exit()\n\n# Time\ndef time_fn(fn, n=11):\n    for _ in range(3): fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return statistics.median(times)\n\nprint()\ntotal_c = 0\ntotal_o = 0\nfor i, (B, L, C, H, D, alpha, beta) in enumerate(cases):\n    torch.manual_seed(i*100+7)\n    x = torch.randn(B, L, C)\n    wq = torch.randn(H, D, C)\n    wk = torch.randn(H, D, C)\n    wv = torch.randn(H, D, C)\n    tc = time_fn(lambda: current_attention(x, wq, wk, wv, alpha, beta))\n    to = time_fn(lambda: attn_tproj(x, wq, wk, wv, alpha, beta))\n    total_c += tc\n    total_o += to\n    print(f'Case {i}: {tc:.3f} -> {to:.3f} ms ({(tc-to)/tc*100:+.2f}%)')\nprint(f'Overall: {(total_c-total_o)/total_c*100:+.2f}%')\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

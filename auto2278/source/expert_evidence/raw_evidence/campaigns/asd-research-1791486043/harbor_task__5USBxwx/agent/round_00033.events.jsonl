{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch\nimport time\nimport math\nimport statistics\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 128, 1280, 20, 64\nalpha = 1.15\nbeta = 3.0\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\ninv_sqrt_d = 1.0 / math.sqrt(D)\nHD = H * D\nBH = B * H\nxr = x.reshape(B * L, C)\n\n# Profile each step\ndef time_fn(fn, n=20):\n    # warmup\n    for _ in range(3):\n        fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return statistics.median(times)\n\n# Step 1: q projection\ndef step_q():\n    q = (xr @ wq.reshape(HD, C).T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    return q\nprint(f'q-proj: {time_fn(step_q):.3f} ms')\n\n# Step 2: k projection\ndef step_k():\n    k = (xr @ wk.reshape(HD, C).T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    return k\nprint(f'k-proj: {time_fn(step_k):.3f} ms')\n\nq = step_q()\nk = step_k()\nq.mul_(inv_sqrt_d)\n\n# Step 3: logits (bmm)\ndef step_logits():\n    return torch.bmm(q, k.transpose(1, 2))\nprint(f'logits bmm: {time_fn(step_logits):.3f} ms')\n\nlogits = step_logits()\n\n# Step 4: softmax p0\ndef step_softmax0():\n    return logits.softmax(dim=-1)\nprint(f'p0 softmax: {time_fn(step_softmax0):.3f} ms')\n\np0 = step_softmax0()\n\n# Step 5: p1_logits\na_p = 0.5 * (1.0 + alpha)\na_m = 0.5 * (1.0 - alpha)\ndef step_p1_logits():\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(1, 2), alpha=a_m)\n    return p1_logits\nprint(f'p1 logits: {time_fn(step_p1_logits):.3f} ms')\n\np1_logits = step_p1_logits()\n\n# Step 6: p1 softmax\ndef step_p1_softmax():\n    return p1_logits.softmax(dim=-1)\nprint(f'p1 softmax: {time_fn(step_p1_softmax):.3f} ms')\n\np1 = step_p1_softmax()\n\n# Step 7: p_mix\ndef step_pmix():\n    return torch.lerp(p0, p1, beta)\nprint(f'p_mix lerp: {time_fn(step_pmix):.3f} ms')\n\np_mix = step_pmix()\n\n# Step 8: G + tiled\ndef step_G():\n    G = x @ x.transpose(-1, -2)\n    G_tiled = G.expand(BH, L, L).contiguous()\n    return G_tiled\nprint(f'G + tiled: {time_fn(step_G):.3f} ms')\n\nG_tiled = step_G()\n\n# Step 9: norm1 (p1 @ G then mul sum)\ndef step_norm1():\n    p1G = torch.bmm(p1, G_tiled)\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    return norm1\nprint(f'norm1 (bmm+mul+sum+sqrt): {time_fn(step_norm1):.3f} ms')\n\nnorm1 = step_norm1()\n\n# Step 10: normm\ndef step_normm():\n    pmG = torch.bmm(p_mix, G_tiled)\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    return normm\nprint(f'normm (bmm+mul+sum+sqrt): {time_fn(step_normm):.3f} ms')\n\nnormm = step_normm()\n\n# Step 11: ratio\ndef step_ratio():\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    return ratio\n# Can't easily reuse norm1/normm for timing, just estimate\nprint(f'ratio: ~{time_fn(step_ratio):.3f} ms (approx, mutated inputs)')\n\nratio = step_ratio()\n\n# Step 12: v-proj\ndef step_v():\n    v = (xr @ wv.reshape(HD, C).T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    return v\nprint(f'v-proj: {time_fn(step_v):.3f} ms')\n\nv = step_v()\n\n# Step 13: p_mix @ v\ndef step_pmv():\n    return torch.bmm(p_mix, v)\nprint(f'p_mix @ v bmm: {time_fn(step_pmv):.3f} ms')\n\ny = step_pmv()\n\n# Step 14: output reshape\ndef step_out():\n    return y.view(B, H, L, D).transpose(1, 2).flatten(2).contiguous()\nprint(f'output reshape: {time_fn(step_out):.3f} ms')\n\nprint()\nprint(f'--- case 3: B={B}, L={L}, C={C}, H={H}, D={D} ---')\nprint(f'q+k proj: ~{time_fn(step_q)+time_fn(step_k):.3f} ms')\nprint(f'v-proj: ~{time_fn(step_v):.3f} ms')\nprint(f'logits b
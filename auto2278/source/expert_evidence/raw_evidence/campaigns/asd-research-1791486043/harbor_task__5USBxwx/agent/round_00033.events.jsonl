{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport torch\nimport time\nimport math\nimport statistics\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha = 1.05\nbeta = 7.5\nBH = B * H\nHD = H * D\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nxr = x.reshape(B * L, C)\n\nG = x @ x.transpose(-1, -2)  # (B, L, L) for B=1 it's (1, L, L)\n\np = torch.randn(BH, L, L).softmax(dim=-1)\n\ndef time_fn(fn, n=20):\n    for _ in range(3): fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return statistics.median(times)\n\n# Current: G.expand(BH, L, L).contiguous() + bmm\ndef norm_current():\n    G_tiled = G.expand(BH, L, L).contiguous()\n    pG = torch.bmm(p, G_tiled)\n    return pG.mul_(p).sum(dim=-1, keepdim=True)\n\n# 4D matmul\np4 = p.view(B, H, L, L)\nG4 = G.unsqueeze(1)  # (B, 1, L, L)\ndef norm_4d():\n    pG = p4 @ G4\n    return pG.mul_(p4).sum(dim=-1, keepdim=True).view(BH, L, 1)\n\n# What about: repeat_interleave or actual repeat?\ndef norm_repeat():\n    G_rep = G.repeat(BH // B, 1, 1)\n    pG = torch.bmm(p, G_rep)\n    return pG.mul_(p).sum(dim=-1, keepdim=True)\n\nn1 = norm_current()\nn2 = norm_4d()\nn3 = norm_repeat()\nprint(f'4D match: {torch.allclose(n1, n2)}')\nprint(f'repeat match: {torch.allclose(n1, n3)}')\nprint(f'Current: {time_fn(norm_current):.3f} ms')\nprint(f'4D: {time_fn(norm_4d):.3f} ms')\nprint(f'repeat: {time_fn(norm_repeat):.3f} ms')\n\n# How long does just the bmm take (with pre-tiled G)?\nG_tiled = G.expand(BH, L, L).contiguous()\ndef just_bmm():\n    return torch.bmm(p, G_tiled)\nprint(f'\\\\\\\\nJust bmm (pre-tiled): {time_fn(just_bmm):.3f} ms')\n\n# What about: compute p @ G for each head as (L, L) @ (L, L)\n# L=256, that's a big square matmul, might have better BLAS efficiency\ndef norm_perhead():\n    norms = torch.empty(BH, L, 1)\n    G0 = G[0]  # (L, L)\n    for h in range(BH):\n        pG = p[h] @ G0\n        norms[h, :, 0] = (pG * p[h]).sum(dim=-1)\n    return norms\nprint(f'Per-head matmul norm: {time_fn(norm_perhead):.3f} ms')\n\n# Hmm, that's a loop in Python, probably slower. Let me check.\n\n# What about using einsum? 'bij,jk,bik->bi'\ndef norm_einsum():\n    return torch.einsum('bij,jk,bik->bi', p, G[0], p).unsqueeze(-1)\nprint(f'Einsum norm: {time_fn(norm_einsum):.3f} ms')\n\n# What if B > 1? Let me check case 5 (B=2)\nB2, L2, C2, H2, D2 = 2, 128, 512, 8, 64\nBH2 = B2 * H2\nx2 = torch.randn(B2, L2, C2)\nG2 = x2 @ x2.transpose(-1, -2)  # (B2, L2, L2)\np2 = torch.randn(BH2, L2, L2).softmax(dim=-1)\n\nG2_tiled = G2.unsqueeze(1).expand(B2, H2, L2, L2).reshape(BH2, L2, L2).contiguous()\ndef norm_b2_bmm():\n    pG = torch.bmm(p2, G2_tiled)\n    return pG.mul_(p2).sum(dim=-1, keepdim=True)\n\np2_4d = p2.view(B2, H2, L2, L2)\nG2_4d = G2.unsqueeze(1)\ndef norm_b2_4d():\n    pG = p2_4d @ G2_4d\n    return pG.mul_(p2_4d).sum(dim=-1, keepdim=True).view(BH2, L2, 1)\n\nprint(f'\\\\\\\\nCase B=2: bmm={time_fn(norm_b2_bmm):.3f} ms, 4d={time_fn(norm_b2_4d):.3f} ms')\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

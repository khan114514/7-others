lly torch.softmax doesn't take out param directly\n\n# Check if torch.nn.functional.softmax is same\nimport torch.nn.functional as F\ndef f_softmax():\n    return F.softmax(logits, dim=-1)\nprint(f'F.softmax: {time_fn(f_softmax):.3f} ms')\n\n# Manual softmax for 2D\ndef manual_softmax_2d():\n    x2d = logits_2d\n    m = x2d.max(dim=-1, keepdim=True).values\n    e = (x2d - m).exp_()\n    s = e.sum(dim=-1, keepdim=True)\n    return e.div_(s)\nprint(f'manual 2d softmax: {time_fn(manual_softmax_2d):.3f} ms')\n\\\" 2>&1\n\"","aggregated_output":"softmax: 1.485 ms\nlog_softmax + exp: 2.879 ms\n2D softmax: 1.514 ms\nF.softmax: 1.499 ms\nmanual 2d softmax: 1.522 ms\n","exit_code":0,"status":"completed"}}

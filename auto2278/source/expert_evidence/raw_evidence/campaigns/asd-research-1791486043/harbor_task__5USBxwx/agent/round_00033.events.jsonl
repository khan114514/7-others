{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport torch\nimport time\nimport math\nimport statistics\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha = 1.05\nbeta = 7.5\nBH = B * H\nHD = H * D\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\nxr = x.reshape(B * L, C)\ninv_sqrt_d = 1.0 / math.sqrt(D)\n\ndef time_fn(fn, n=20):\n    for _ in range(3): fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return statistics.median(times)\n\n# Current full method (reimplemented inline for testing)\ndef current_method():\n    q = (xr @ wq.reshape(HD, C).T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    k = (xr @ wk.reshape(HD, C).T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    q.mul_(inv_sqrt_d)\n    logits = torch.bmm(q, k.transpose(1, 2))\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(1, 2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2)\n    G_tiled = G.expand(BH, L, L).contiguous()\n    p1G = torch.bmm(p1, G_tiled)\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = torch.bmm(p_mix, G_tiled)\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    v = (xr @ wv.reshape(HD, C).T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    y = torch.bmm(p_mix, v).mul_(ratio)\n    return y.view(B, H, L, D).transpose(1, 2).flatten(2).contiguous()\n\nprint(f'Current method: {time_fn(current_method):.3f} ms')\n\n# Idea: use G_tiled in 4D to avoid explicit tiling (G.unsqueeze(0) broadcasts in 4D matmul)\ndef method_4d_gram():\n    q = (xr @ wq.reshape(HD, C).T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    q.mul_(inv_sqrt_d)\n    logits = q @ k.transpose(-1, -2)  # (B, H, L, L)\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2).unsqueeze(0)  # (B, L, L) -> add head dim?\n    # Actually G is (B, L, L), we need to broadcast over H\n    p1G = p1 @ G.unsqueeze(1)  # (B, H, L, L) @ (B, 1, L, L) -> (B, H, L, L)\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G.unsqueeze(1)\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    v = (xr @ wv.reshape(HD, C).T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Verify\ny1 = current_method()\ny2 = method_4d_gram()\nprint(f'4D Gram match: {torch.allclose(y1, y2, atol=3e-5, rtol=3e-4)}')\nprint(f'4D Gram method: {time_fn(method_4d_gram):.3f} ms')\n\n# Max error check\ndiff = (y1 - y2).abs()\nprint(f'Max diff: {diff.max():.2e}, mean diff: {diff.mean():.2e}')\nprint(f'Relative max: {(diff / y1.abs().clamp(min=1e-8)).max():.2e}')\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

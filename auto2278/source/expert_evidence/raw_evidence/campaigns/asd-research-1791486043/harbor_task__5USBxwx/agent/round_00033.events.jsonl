{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/sh -lc 'cd /workspace/solution && python3 -c \"\nimport torch\nimport time\nimport math\nimport statistics\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha = 1.05\nbeta = 7.5\nBH = B * H\nHD = H * D\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\nxr = x.reshape(B * L, C)\ninv_sqrt_d = 1.0 / math.sqrt(D)\n\ndef time_fn(fn, n=20):\n    for _ in range(3): fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return statistics.median(times)\n\nq = (xr @ wq.reshape(HD, C).T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\nk = (xr @ wk.reshape(HD, C).T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\nq.mul_(inv_sqrt_d)\nlogits = torch.bmm(q, k.transpose(1, 2))\np0 = logits.softmax(dim=-1)\na_p = 0.5 * (1.0 + alpha)\na_m = 0.5 * (1.0 - alpha)\np1_logits = logits.mul(a_p)\np1_logits.add_(logits.transpose(1, 2), alpha=a_m)\np1 = p1_logits.softmax(dim=-1)\n\nG = x @ x.transpose(-1, -2)\nG_tiled = G.expand(BH, L, L).contiguous()\n\n# Current: 2 separate bmms\ndef two_bmms():\n    p1G = torch.bmm(p1, G_tiled)\n    n1 = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    # Need p_mix too\n    p_mix = torch.lerp(p0, p1, beta)\n    pmG = torch.bmm(p_mix, G_tiled)\n    nm = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    return n1, nm\n\n# Stacked approach: stack p0 and p1, one big bmm, then compute norms\ndef stacked_bmm():\n    # stack p0 and p1: (2*BH, L, L)\n    p_stacked = torch.cat([p0, p1], dim=0)  # (2*BH, L, L)\n    G_stacked = G.expand(2*BH, L, L).contiguous()\n    result = torch.bmm(p_stacked, G_stacked)  # (2*BH, L, L)\n    r0 = result[:BH]\n    r1 = result[BH:]\n    n0 = r0.mul(p0).sum(dim=-1, keepdim=True)\n    n1 = r1.mul(p1).sum(dim=-1, keepdim=True)\n    # Now compute normm using lerp identity:\n    # p_mix = (1-beta)*p0 + beta*p1\n    # normm_sq = (1-beta)''^2 * n0 + beta''^2 * n1 + 2*beta*(1-beta) * (p0@G * p1).sum(-1)\n    cross = r0.mul_(p1).sum(dim=-1, keepdim=True)  # p0@G * p1 -> dot product\n    b1 = 1.0 - beta\n    nm = b1*b1 * n0 + beta*beta * n1 + 2*beta*b1 * cross\n    return n1, nm\n\nn1a, nma = two_bmms()\nn1b, nmb = stacked_bmm()\nprint(f'\"'norm1 match: {torch.allclose(n1a, n1b, atol=1e-4)}')\nprint(f'normm match: {torch.allclose(nma, nmb, atol=1e-4)}')\nprint(f'Max diff norm1: {(n1a-n1b).abs().max():.2e}')\nprint(f'Max diff normm: {(nma-nmb).abs().max():.2e}')\n\nprint(f'\\\\\\\\nTwo BMMs: {time_fn(two_bmms):.3f} ms')\nprint(f'Stacked BMM: {time_fn(stacked_bmm):.3f} ms')\n\n# Relative diff for ratio\nratio_a = n1a.sqrt().clamp_min_(1e-6) / nma.sqrt().clamp_min_(1e-6)\nratio_a.clamp_(0.25, 4.0)\nratio_b = n1b.sqrt().clamp_min_(1e-6) / nmb.sqrt().clamp_min_(1e-6)\nratio_b.clamp_(0.25, 4.0)\nprint(f'Ratio max diff: {(ratio_a-ratio_b).abs().max():.2e}')\nprint(f'Ratio match: {torch.allclose(ratio_a, ratio_b, atol=3e-5, rtol=3e-4)}')\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

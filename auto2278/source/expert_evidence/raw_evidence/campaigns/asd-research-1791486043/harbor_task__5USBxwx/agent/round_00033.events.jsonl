{"type":"item.started","item":{"id":"item_96","type":"command_execution","command":"/bin/sh -lc 'cd /workspace/solution && python3 -c \"\nimport torch\nimport time\nimport math\nimport statistics\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C = 1, 256, 1280\nx = torch.randn(B, L, C)\n\ndef time_fn(fn, n=100):\n    for _ in range(5): fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return statistics.median(times)\n\n# Different ways to compute G = x @ x''^T\ndef g_tt():\n    return x @ x.transpose(-1, -2)\ndef g_mt():\n    return x @ x.mT\ndef g_bmm():\n    # (B, L, C) @ (B, C, L) = (B, L, L) via bmm\n    return torch.bmm(x, x.transpose(1, 2))\n\nprint(f'\"'x @ x.transpose: {time_fn(g_tt):.4f} ms')\nprint(f'x @ x.mT: {time_fn(g_mt):.4f} ms')\nprint(f'bmm: {time_fn(g_bmm):.4f} ms')\n\n# Verify same result\nr1 = g_tt()\nr2 = g_mt()\nr3 = g_bmm()\nprint(f'mT matches: {torch.allclose(r1, r2)}')\nprint(f'bmm matches: {torch.allclose(r1, r3)}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

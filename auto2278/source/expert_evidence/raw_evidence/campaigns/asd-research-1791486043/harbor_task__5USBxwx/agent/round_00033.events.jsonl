mm_time/full_time*100:.1f}%')\nprint(f'Permute+contig overhead: {full_time-mm_time:.3f} ms ({(full_time-mm_time)/full_time*100:.1f}%)')\n\\\" 2>&1\n\"","aggregated_output":"Pure matmul (BL x C @ C x HD): 3.669 ms\nFull proj (matmul+permute+contig): 3.668 ms\nMatmul+view+permute (no contig): 3.644 ms\nJust permute+contiguous: 0.016 ms\nJust contiguous (already contig): 0.000 ms\nMatmul + view (no permute): 3.764 ms\n\nMatmul fraction: 102.5%\nPermute+contig overhead: -0.092 ms (-2.5%)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch\nimport time\nimport math\nimport statistics\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 128, 1280, 20, 64\nHD = H * D\nBH = B * H\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\nxr = x.reshape(B * L, C)\n\ndef time_fn(fn, n=30):\n    for _ in range(5): fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return statistics.median(times)\n\n# One big matmul with all 3 weights stacked\nw_all = torch.cat([wq.reshape(HD, C), wk.reshape(HD, C), wv.reshape(HD, C)], dim=0)\n\ndef big_mm():\n    return xr @ w_all.T\nprint(f'1 big (3xHD) matmul: {time_fn(big_mm):.3f} ms')\n\ndef three_small_mm():\n    a = xr @ wq.reshape(HD, C).T\n    b = xr @ wk.reshape(HD, C).T\n    c = xr @ wv.reshape(HD, C).T\n    return a, b, c\nprint(f'3 separate matmuls:  {time_fn(three_small_mm):.3f} ms')\n\n# What about adding bias of the BL * 3HD output tensor allocation?\nprint(f'Output size 1 big: {B*L*3*HD*4/1024:.0f} KB')\nprint(f'Output size 3 small (total): {3*B*L*HD*4/1024:.0f} KB')\n\n# Cache considerations: The big matmul output is 3x bigger\n# For case 3: BL=128, HD=1280, 3*HD=3840\n# 128*3840*4 = 1.96 MB (fits in L2 usually)\n# 128*1280*4 * 3 = 1.96 MB (same)\n# Same total memory. But one big matmul might have better cache for weights\n# Actually weight is C * 3HD = 1280 * 3840 * 4 = 19.7 MB\n# vs 3 weights of 1280*1280*4 = 6.6 MB each\n# Hmm, for BLAS with small M, big N might be faster per op because of better pipelining\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

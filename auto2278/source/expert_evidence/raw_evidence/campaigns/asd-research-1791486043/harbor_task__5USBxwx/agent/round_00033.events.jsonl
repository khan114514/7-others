{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport torch\nimport time\nimport math\nimport statistics\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\ncases = [\n    {'B': 1, 'L': 64, 'C': 512, 'H': 8, 'D': 64, 'alpha': 1.05, 'beta': 5.0},\n    {'B': 1, 'L': 128, 'C': 640, 'H': 10, 'D': 64, 'alpha': 1.1, 'beta': 4.0},\n    {'B': 1, 'L': 128, 'C': 1280, 'H': 20, 'D': 64, 'alpha': 1.15, 'beta': 3.0},\n    {'B': 1, 'L': 256, 'C': 1280, 'H': 20, 'D': 64, 'alpha': 1.05, 'beta': 7.5},\n    {'B': 1, 'L': 256, 'C': 640, 'H': 10, 'D': 64, 'alpha': 1.2, 'beta': 5.0},\n    {'B': 2, 'L': 128, 'C': 512, 'H': 8, 'D': 64, 'alpha': 1.0, 'beta': 5.0},\n]\n\ndef run_case(B, L, C, H, D, alpha, beta, seed=42):\n    torch.manual_seed(seed)\n    x = torch.randn(B, L, C)\n    wq = torch.randn(H, D, C)\n    wk = torch.randn(H, D, C)\n    wv = torch.randn(H, D, C)\n    \n    from method import attention\n    for _ in range(3):\n        y = attention(x, wq, wk, wv, alpha, beta)\n    times = []\n    for _ in range(11):\n        t0 = time.process_time_ns()\n        y = attention(x, wq, wk, wv, alpha, beta)\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return statistics.median(times), y.shape\n\nfor i, c in enumerate(cases):\n    t, shape = run_case(c['B'], c['L'], c['C'], c['H'], c['D'], c['alpha'], c['beta'])\n    bl = c['B']*c['L']\n    hd = c['H']*c['D']\n    proj_flops = 3 * bl * c['C'] * hd  # q, k, v projections\n    attn_flops = 2 * c['B']*c['H'] * c['L']**2 * c['D']  # q@k + p@v\n    print(f'Case {i}: B={c[\\\\\\\"B\\\\\\\"]}, L={c[\\\\\\\"L\\\\\\\"]}, C={c[\\\\\\\"C\\\\\\\"]}, H={c[\\\\\\\"H\\\\\\\"]}, D={c[\\\\\\\"D\\\\\\\"]} -> {t:.2f} ms, proj/attn FLOP ratio = {proj_flops/attn_flops:.1f}')\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

):\n    q = xr @ wq.reshape(HD, C).T\n    k = xr @ wk.reshape(HD, C).T\n    v = xr @ wv.reshape(HD, C).T\n    return q, k, v\nprint(f'\\\\\\\\n3 big matmuls: {time_fn(three_big):.3f} ms')\n\n# One stacked matmul\nw_all = torch.cat([wq.reshape(HD, C), wk.reshape(HD, C), wv.reshape(HD, C)], dim=0)\ndef one_stacked():\n    return xr @ w_all.T\nprint(f'1 stacked matmul: {time_fn(one_stacked):.3f} ms')\n\n# What about: 3H per-head matmuls via bmm with 3H batch\nw_all_3h = torch.cat([wq, wk, wv], dim=0)  # (3H, D, C)\nw_all_3h_t = w_all_3h.transpose(1, 2)  # (3H, C, D)\nx_3h = x[0].expand(3*H, L, C).contiguous()  # (3H, L, C)\ndef bmm_3h():\n    return torch.bmm(x_3h, w_all_3h_t)\nprint(f'bmm 3H batch: {time_fn(bmm_3h):.3f} ms')\n\n# Now check across cases - for small L and large C, big matmul might be better\n# For large L and small C? Let me test case 0\nB2, L2, C2, H2, D2 = 1, 64, 512, 8, 64\nx2 = torch.randn(B2, L2, C2)\nw2 = torch.randn(H2, D2, C2)\nxr2 = x2.reshape(B2 * L2, C2)\nwr2 = w2.reshape(H2*D2, C2)\n\ndef big_small():\n    return xr2 @ wr2.T\n\nx_3h2 = x2[0].expand(3*H2, L2, C2).contiguous()\nw_3h2 = torch.cat([w2, w2, w2], dim=0).transpose(1, 2)\ndef bmm_small():\n    return torch.bmm(x_3h2, w_3h2)\n\nprint(f'\\\\\\\\nCase 0 size: big={time_fn(big_small):.4f} ms, bmm_3h={time_fn(bmm_small):.4f} ms')\n\\\" 2>&1\n\"","aggregated_output":"x @ w.T (big): 6.836 ms\nF.linear: 6.809 ms\ntorch.matmul: 6.816 ms\nper head @ (loop): 7.091 ms\nbmm per-head (H batch): 7.597 ms\n\n3 big matmuls: 20.571 ms\n1 stacked matmul: 21.273 ms\nbmm 3H batch: 22.983 ms\n\nCase 0 size: big=0.3252 ms, bmm_3h=0.9845 ms\n","exit_code":0,"status":"completed"}}

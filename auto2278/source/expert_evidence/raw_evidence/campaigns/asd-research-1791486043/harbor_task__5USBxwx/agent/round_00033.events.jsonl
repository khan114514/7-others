{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch\nimport time\nimport math\nimport statistics\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 128, 1280, 20, 64\nHD = H * D\nBH = B * H\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nw = torch.randn(H, D, C)\nxr = x.reshape(B * L, C)\nwr = w.reshape(HD, C)\n\ndef time_fn(fn, n=50):\n    for _ in range(3): fn()\n    times = []\n    for _ in range(n):\n        torch.manual_seed(42)  # keep things deterministic-ish\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return statistics.median(times)\n\n# Pure matmul\ndef pure_matmul():\n    return xr @ wr.T\nprint(f'Pure matmul (BL x C @ C x HD): {time_fn(pure_matmul):.3f} ms')\n\n# Matmul + view + permute + contiguous + view\ndef full_proj():\n    return (xr @ wr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\nprint(f'Full proj (matmul+permute+contig): {time_fn(full_proj):.3f} ms')\n\n# Matmul + view + permute (no contiguous)\ndef proj_nocontig():\n    return (xr @ wr.T).view(B, L, H, D).permute(0, 2, 1, 3)\nprint(f'Matmul+view+permute (no contig): {time_fn(proj_nocontig):.3f} ms')\n\n# Just permute + contiguous\nresult = (xr @ wr.T).view(B, L, H, D)\ndef just_permute():\n    return result.permute(0, 2, 1, 3).contiguous()\nprint(f'Just permute+contiguous: {time_fn(just_permute):.3f} ms')\n\n# Just contiguous on already-contiguous\nresult_c = result.contiguous()\ndef just_contig():\n    return result_c.contiguous()\nprint(f'Just contiguous (already contig): {time_fn(just_contig):.3f} ms')\n\n# Just view\ndef just_view():\n    return (xr @ wr.T).view(B, L, H, D)\nprint(f'Matmul + view (no permute): {time_fn(just_view):.3f} ms')\n\n# What fraction is matmul?\nmm_time = time_fn(pure_matmul)\nfull_time = time_fn(full_proj)\nprint(f'\\\\\\\\nMatmul fraction: {mm_time/full_time*100:.1f}%')\nprint(f'Permute+contig overhead: {full_time-mm_time:.3f} ms ({(full_time-mm_time)/full_time*100:.1f}%)')\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

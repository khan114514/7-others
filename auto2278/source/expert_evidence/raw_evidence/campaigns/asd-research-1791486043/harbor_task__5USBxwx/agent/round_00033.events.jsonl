{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport torch\nimport time\nimport math\nimport statistics\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha = 1.05\nbeta = 7.5\nBH = B * H\nHD = H * D\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\nxr = x.reshape(B * L, C)\ninv_sqrt_d = 1.0 / math.sqrt(D)\n\ndef time_fn(fn, n=20):\n    for _ in range(3): fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return statistics.median(times)\n\nq = (xr @ wq.reshape(HD, C).T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\nk = (xr @ wk.reshape(HD, C).T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\nq.mul_(inv_sqrt_d)\n\n# Can't do in-place mul + add on logits because of transpose overlap\n# But what about: p1_logits = a_p * A + a_m * A\"'^T\n# = 0.5*(A + A''^T) + 0.5*alpha*(A - A''^T)\n# Still need A and A''^T.\n\n# What about lerp in-place on p0?\nlogits = torch.bmm(q, k.transpose(1, 2))\np0 = logits.softmax(dim=-1)\na_p = 0.5 * (1.0 + alpha)\na_m = 0.5 * (1.0 - alpha)\np1_logits = logits.mul(a_p)\np1_logits.add_(logits.transpose(1, 2), alpha=a_m)\np1 = p1_logits.softmax(dim=-1)\n\n# In-place lerp on p0\ndef lerp_inplace():\n    p0_local = p0.clone()\n    p0_local.lerp_(p1, beta)\n    return p0_local\n\ndef lerp_normal():\n    return torch.lerp(p0, p1, beta)\n\nprint(f'\"'lerp normal: {time_fn(lerp_normal):.3f} ms')\nprint(f'lerp inplace: {time_fn(lerp_inplace):.3f} ms')\n\n# Now the question is: does saving a few allocations actually matter?\n# The projections are 60%+ of the time. Let me look at other optimizations.\n\n# Key insight: v-projection is the same cost as q and k.\n# Can we compute output WITHOUT v-projection using the identity:\n#   p_mix @ v = p_mix @ (x @ wv\"'^T) \n# \n# And we already have... wait, we compute norms via Gram, not via p@x.\n# What if we restructure:\n#   - Compute u1 = p1 @ x and m = p_mix @ x (direct, needed for output proj)\n#   - Compute norms directly from u1 and m (free!)\n#   - Output = (ratio * m) @ wv''^T\n# \n# Cost comparison (case 3: B=1, H=20, L=256, C=1280, D=64):\n# Current approach:\n#   - q-proj: BL*C*HD = 256*1280*1280 = 419M\n#   - k-proj: 419M  \n#   - v-proj: 419M\n#   - logits bmm: BH*L*L*D = 20*256*256*64 = 84M\n#   - p_mix@v: BH*L*L*D = 84M\n#   - Gram + 2x norm bmm: ~2*(BH*L*L*L) = 2*20*256''^3 = 671M + BL*L*C = 84M\n#   Total proj: 1258M, attention+norm: 923M\n#\n# Direct u approach:\n#   - q-proj: 419M\n#   - k-proj: 419M\n#   - p1@x: BH*L*L*C = 20*256*256*1280 = 1.68B  (way bigger!)\n#   - p_mix@x: 1.68B\n#   - m@wv''^T: BH*L*C*D = 20*256*1280*64 = 419M (same as v-proj)\n#   Total proj: 839M, attention+p@x: 4.2B\n# \n# Way worse! Gram is definitely the right approach.\n# \n# Hmm, but what about the alpha==1.0 case? Then p1=p0=p_mix, ratio=1, no extra work.\n# That'\"'s case 6. Not important for the overall average.\n\n# Let me think about other optimizations...\n# What if we use torch.baddbmm for the logits = q @ k\"'^T?\n# logits = torch.bmm(q, k.transpose(1,2)) * inv_sqrt_d\n# Can we fuse the scaling? baddbmm does add+matmul, not mul.\n\n# What about logits = q @ (k * inv_sqrt_d)''^T? Same thing.\n# We already scale q in-place which is BH*L*D = 20*256*64 = 327K elements - trivial.\n\n# Actually, what if we scale k instead? Same cost.\n# What if we scale during the matmul? No direct way.\n\n# OK let me think about this differently. The projections dominate.\n# What if we reduce the precision of projections? No, must be float32 exact.\n\n# Wait - one more idea: the weights wq, wk, wv have shape (H, D, C).\n# Currently we reshape to (HD, C) and do one big matmul.\n# But what if we do H separate matmuls of size (L, C) @ (C, D)?\n# Each one is L*C*D = 256*1280*64 = 21M, total 3*H*21M = 1260M (same FLOPS)\n# But BLAS efficiency depends on matrix size... 256x64 is quite small.\n\ndef proj_per_head(w):\n    # w: (H, D, C) -> H separate matmuls of (L, C) @ (D, C)''^T\n    out = torch.empty(B, H, L, D)\n    for h in range(H):\n        out[0, h] = x[0] @ w[h].T\n    return out.view(BH, L, D)\n\nprint(f'\"'\\\\\\\\nPer-head proj (H={H}): {time_fn(lambda: proj_per_head(wq)):.3f} ms')\nprint(f'Big matmul proj: {time_fn(lambda: (xr @ wq.reshape(HD, C).T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)):.3f} ms')\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

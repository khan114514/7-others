{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch\nimport time\nimport math\nimport statistics\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 128, 1280, 20, 64\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\ninv_sqrt_d = 1.0 / math.sqrt(D)\nHD = H * D\nBH = B * H\nxr = x.reshape(B * L, C)\n\ndef time_fn(fn, n=30):\n    for _ in range(3): fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return statistics.median(times)\n\n# Current: 3 separate projections\ndef proj_separate():\n    q = (xr @ wq.reshape(HD, C).T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    k = (xr @ wk.reshape(HD, C).T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    v = (xr @ wv.reshape(HD, C).T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    return q, k, v\n\n# Stacked: one big matmul\nw_all = torch.cat([wq.reshape(HD, C), wk.reshape(HD, C), wv.reshape(HD, C)], dim=0)  # (3*HD, C)\n\ndef proj_stacked():\n    out = xr @ w_all.T  # (BL, 3*HD)\n    out = out.view(B, L, 3, H, D).permute(2, 0, 3, 1, 4).contiguous()  # (3, B, H, L, D)\n    q = out[0].view(BH, L, D)\n    k = out[1].view(BH, L, D)\n    v = out[2].view(BH, L, D)\n    return q, k, v\n\n# Verify correctness\nq1, k1, v1 = proj_separate()\nq2, k2, v2 = proj_stacked()\nprint(f'q match: {torch.allclose(q1, q2, atol=1e-6)}')\nprint(f'k match: {torch.allclose(k1, k2, atol=1e-6)}')\nprint(f'v match: {torch.allclose(v1, v2, atol=1e-6)}')\n\nprint(f'Separate: {time_fn(proj_separate):.3f} ms')\nprint(f'Stacked:  {time_fn(proj_stacked):.3f} ms')\n\n# Also try: separate matmuls but with a pre-made transposed weight\nwq_t = wq.reshape(HD, C).T.contiguous()\nwk_t = wk.reshape(HD, C).T.contiguous()\nwv_t = wv.reshape(HD, C).T.contiguous()\n\ndef proj_separate_t():\n    q = (xr @ wq_t).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    k = (xr @ wk_t).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    v = (xr @ wv_t).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    return q, k, v\n\nprint(f'Separate T: {time_fn(proj_separate_t):.3f} ms')\n\n# Also try matmul of (C, BL) @ (BL, HD) - no that's wrong\n# Try: what if we do the matmul and skip permute by using 4D matmul later?\n# q shape (B, L, H, D) - can we do attention in this layout?\ndef proj_noperm():\n    q = (xr @ wq.reshape(HD, C).T).view(B, L, H, D)\n    k = (xr @ wk.reshape(HD, C).T).view(B, L, H, D)\n    v = (xr @ wv.reshape(HD, C).T).view(B, L, H, D)\n    return q, k, v\n\n# But then attention scores: q (B, L, H, D), k.transpose(-2, -1) (B, L, D, H)\n# Hmm no, we want (B, H, L, L) attention. We need to compare head-wise.\n# q.transpose(1, 2) (B, H, L, D) @ k.transpose(1, 2).transpose(-1, -2) (B, H, D, L)\n# This is a 4D matmul. Let me test.\nq_np, k_np, v_np = proj_noperm()\n\ndef attn_4d():\n    # q, k are (B, L, H, D)\n    q_t = q_np.transpose(1, 2)  # (B, H, L, D)\n    k_t = k_np.transpose(1, 2)  # (B, H, L, D)\n    logits = q_t @ k_t.transpose(-1, -2)  # (B, H, L, L)\n    return logits\n\ndef attn_3d():\n    qc = q_np.permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    kc = k_np.permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    logits = torch.bmm(qc, kc.transpose(1, 2))\n    return logits\n\nlogits_4d = attn_4d()\nlogits_3d = attn_3d()\nprint(f'4d vs 3d logits match: {torch.allclose(logits_4d.view(BH, L, L), logits_3d, atol=1e-5)}')\nprint(f'4d attn: {time_fn(attn_4d):.3f} ms')\nprint(f'3d attn (full): {time_fn(attn_3d):.3f} ms')\n\n# Now test: can we do everything in 4D avoiding permute+contiguous of projections?\n# The projections give (B, L, H, D). The 4D matmul gives (B, H, L, L).\n# softmax on last dim works fine.\n# p @ v: p (B, H, L, L), v.transpose(1,2) (B, H, L, D) -> (B, H, L, D)\n# This avoids permuting q,k,v but we still need to permute logits? No wait...\n\n# Actually the question is: 4D matmul vs 3D bmm + permute overhead\n# The 4D matmul internally does the same thing but with more overhead\n# Let me check sizes for case 3 and all cases\nprint()\nprint('=== Summary for case 3 ===')\nprint(f'3 separate projs + perm: {time_fn(proj_separate):.3f} ms')\nprint(f'1 stacked proj + perm:   {time_fn(proj_stacked):.3f} ms')\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

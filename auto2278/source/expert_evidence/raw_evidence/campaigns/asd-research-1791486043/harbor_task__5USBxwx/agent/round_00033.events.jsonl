 proj/attn FLOP ratio = 7.5\nCase 2: B=1, L=128, C=1280, H=20, D=64 -> 17.52 ms, proj/attn FLOP ratio = 15.0\nCase 3: B=1, L=256, C=1280, H=20, D=64 -> 54.51 ms, proj/attn FLOP ratio = 7.5\nCase 4: B=1, L=256, C=640, H=10, D=64 -> 20.06 ms, proj/attn FLOP ratio = 3.8\nCase 5: B=2, L=128, C=512, H=8, D=64 -> 5.23 ms, proj/attn FLOP ratio = 6.0\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport torch\nimport time\nimport math\nimport statistics\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n# Case 3 is the biggest and most important (dominates avg)\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha = 1.05\nbeta = 7.5\nBH = B * H\nHD = H * D\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\nxr = x.reshape(B * L, C)\ninv_sqrt_d = 1.0 / math.sqrt(D)\n\ndef time_fn(fn, n=20):\n    for _ in range(3): fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return statistics.median(times)\n\n# Profile each step for case 3\ndef step_q():\n    return (xr @ wq.reshape(HD, C).T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\nq = step_q()\nprint(f'q-proj: {time_fn(step_q):.3f} ms')\n\ndef step_k():\n    return (xr @ wk.reshape(HD, C).T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\nk = step_k()\nprint(f'k-proj: {time_fn(step_k):.3f} ms')\n\nq.mul_(inv_sqrt_d)\nlogits = torch.bmm(q, k.transpose(1, 2))\nprint(f'logits bmm: {time_fn(lambda: torch.bmm(q, k.transpose(1, 2))):.3f} ms')\n\np0 = logits.softmax(dim=-1)\nprint(f'p0 softmax: {time_fn(lambda: logits.softmax(dim=-1)):.3f} ms')\n\na_p = 0.5 * (1.0 + alpha)\na_m = 0.5 * (1.0 - alpha)\ndef step_p1_logits():\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(1, 2), alpha=a_m)\n    return p1_logits\np1_logits = step_p1_logits()\nprint(f'p1 logits: {time_fn(step_p1_logits):.3f} ms')\n\np1 = p1_logits.softmax(dim=-1)\nprint(f'p1 softmax: {time_fn(lambda: p1_logits.softmax(dim=-1)):.3f} ms')\n\np_mix = torch.lerp(p0, p1, beta)\nprint(f'p_mix lerp: {time_fn(lambda: torch.lerp(p0, p1, beta)):.3f} ms')\n\ndef step_Gram():\n    G = x @ x.transpose(-1, -2)\n    return G.expand(BH, L, L).contiguous()\nG_tiled = step_Gram()\nprint(f'Gram + tile: {time_fn(step_Gram):.3f} ms')\n\ndef step_norm1():\n    p1G = torch.bmm(p1, G_tiled)\n    n = p1G.mul_(p1).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    return n\nnorm1 = step_norm1()\nprint(f'norm1 (bmm+mul+sum+sqrt+clamp): {time_fn(step_norm1):.3f} ms')\n\ndef step_normm():\n    pmG = torch.bmm(p_mix, G_tiled)\n    n = pmG.mul_(p_mix).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    return n\nnormm = step_normm()\nprint(f'normm (bmm+mul+sum+sqrt+clamp): {time_fn(step_normm):.3f} ms')\n\nratio = norm1.div_(normm).clamp_(0.25, 4.0)\n\ndef step_v():\n    return (xr @ wv.reshape(HD, C).T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\nv = step_v()\nprint(f'v-proj: {time_fn(step_v):.3f} ms')\n\ny = torch.bmm(p_mix, v).mul_(ratio)\nprint(f'p_mix@v + mul ratio: {time_fn(lambda: torch.bmm(p_mix, v).mul_(ratio)):.3f} ms')\n\nout = y.view(B, H, L, D).transpose(1, 2).flatten(2).contiguous()\nprint(f'output reshape: {time_fn(lambda: y.view(B, H, L, D).transpose(1, 2).flatten(2).contiguous()):.3f} ms')\n\ntotal_est = sum([\n    time_fn(step_q), time_fn(step_k), \n    time_fn(lambda: torch.bmm(q, k.transpose(1, 2))),\n    time_fn(lambda: logits.softmax(dim=-1)),\n    time_fn(step_p1_logits),\n    time_fn(lambda: p1_logits.softmax(dim=-1)),\n    time_fn(lambda: torch.lerp(p0, p1, beta)),\n    time_fn(step_Gram),\n    time_fn(step_norm1),\n    time_fn(step_normm),\n    time_fn(step_v),\n    time_fn(lambda: torch.bmm(p_mix, v).mul_(ratio)),\n])\nprint(f'\\\\\\\\nEstimated total: {total_est:.3f} ms')\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

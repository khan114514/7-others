{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/sh -lc \"cat > /workspace/solution/method.py << 'PYEOF'\n\\\"\\\"\\\"Optimized multihead retrieval kernel: reshaped Gram, 4D softmax, in-place ops.\\\"\\\"\\\"\nimport math\nimport torch\n\n\n@torch.no_grad()\ndef attention(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    HL = H * L\n    xr = x.reshape(B * L, C)\n\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n\n    p0 = logits.softmax(dim=-1)\n\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1_logits = logits.mul(a_p)\n        p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n        p1 = p1_logits.softmax(dim=-1)\n\n        p_mix = torch.lerp(p0, p1, beta)\n\n        G = x @ x.transpose(-1, -2)\n\n        p1G = (p1.reshape(B, HL, L) @ G).reshape(B, H, L, L)\n        pmG = (p_mix.reshape(B, HL, L) @ G).reshape(B, H, L, L)\n\n        norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n        normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n\n        y = (p_mix @ v).mul_(ratio)\n\n    return y.transpose(1, 2).flatten(2).contiguous()\nPYEOF\necho \\\"Done\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

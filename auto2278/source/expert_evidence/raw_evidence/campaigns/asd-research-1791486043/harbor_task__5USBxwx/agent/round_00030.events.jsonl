{"type":"item.started","item":{"id":"item_63","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/all_cases_test.py << 'PYEOF'\nimport time, math\nimport torch\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\ncases = [\n    (1, 64, 512, 8, 64, 1.05, 5.0),\n    (1, 128, 640, 10, 64, 1.1, 4.0),\n    (1, 128, 1280, 20, 64, 1.15, 3.0),\n    (1, 256, 1280, 20, 64, 1.05, 7.5),\n    (1, 256, 640, 10, 64, 1.2, 5.0),\n    (2, 128, 512, 8, 64, 1.0, 5.0),\n]\n\ndef v1_original(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BHL = B * H * L\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1_logits = logits.mul(a_p)\n        p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n        p1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n        p_mix = torch.lerp(p0, p1, beta)\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        p1G = p1 @ G_exp\n        norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n        y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n\ndef v2_reshaped_gram(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    HL = H * L\n    BHL = B * H * L\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1_logits = logits.mul(a_p)\n        p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n        p1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n        p_mix = torch.lerp(p0, p1, beta)\n        G = x @ x.transpose(-1, -2)\n        p1G = (p1.reshape(B, HL, L) @ G).reshape(B, H, L, L)\n        pmG = (p_mix.reshape(B, HL, L) @ G).reshape(B, H, L, L)\n        norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n        normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n        y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n\ndef profile(fn, *args, warmup=5, repeats=31):\n    for _ in range(warmup):\n        fn(*args)\n    times = []\n    for _ in range(repeats):\n        t0 = time.perf_counter_ns()\n        fn(*args)\n        times.append(time.perf_counter_ns() - t0)\n    return sorted(times)[len(times)//2] / 1e6\n\nprint(f\\\"{'Case':>4}  {'Orig(ms)':>9}  {'Opt(ms)':>9}  {'Speedup':>7}  {'MaxDiff':>10}\\\")\nprint(\\\"-\\\" * 55)\n\ntotal_orig = total_opt = 0\nfor ci, (B, L, C, H, D, alpha, beta) in enumerate(cases):\n    torch.manual_seed(ci * 1009 + 42)\n    x = torch.randn(B, L, C)\n    wq = torch.randn(H, D, C)\n    wk = torch.randn(H, D, C)\n    wv = torch.randn(H, D, C)\n    \n    t_orig = profile(v1_original, x, wq, wk, wv, alpha, beta)\n    t_opt = profile(v2_reshaped_gram, x, wq, wk, wv, alpha, beta)\n    \n    out_orig = v1_original(x, wq, wk, wv, alpha, beta)\n    out_opt = v2_reshaped_gram(x, wq, wk, wv, alpha, beta)\n    max_diff = torch.max(torch.abs(out_orig - out_opt)).item()\n    \n    speedup = t_orig / t_opt\n    total_orig += t_orig\n    total_opt += t_opt\n    \n    print(f\\\"  {ci:2}    {t_orig:9.4f}  {t_opt:9.4f}   {speedup:.3f}x   {max_diff:.2e}\\\")\n\nprint(f\\\"\\\\nMean:    {total_orig/6:9.4f}  {total_opt/6:9.4f}   {total_orig/total_opt:.3f}x\\\")\nprint(f\\\"Improvement: {(total_orig-total_opt)/total_orig*100:.2f}%\\\")\nPYEOF\npython3 /tmp/all_cases_test.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

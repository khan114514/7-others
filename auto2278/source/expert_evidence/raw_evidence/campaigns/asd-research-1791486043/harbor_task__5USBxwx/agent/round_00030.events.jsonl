{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/profile_test.py << 'EOF'\nimport time, math\nimport torch\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n# Use largest case for profiling\nB, L, C, H, D = 1, 256, 1280, 20, 64\n\n# Generate inputs\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\nalpha = 1.05\nbeta = 7.5\n\ndef current_method(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BHL = B * H * L\n    xr = x.reshape(B * L, C)\n\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n\n    p0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n\n    p_mix = torch.lerp(p0, p1, beta)\n\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n\n    p1G = p1 @ G_exp\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n\n    y = (p_mix @ v).mul_(ratio)\n\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Warmup\nfor _ in range(3):\n    out = current_method(x, wq, wk, wv, alpha, beta)\n\n# Time full function\ntimes = []\nfor _ in range(11):\n    t0 = time.process_time_ns()\n    out = current_method(x, wq, wk, wv, alpha, beta)\n    times.append((time.process_time_ns() - t0) / 1e6)\nprint(f\\\"Full function median: {sorted(times)[5]:.2f} ms\\\")\n\n# Profile individual parts\ndef profile_section(name, fn, warmup=3, repeats=11):\n    for _ in range(warmup):\n        fn()\n    times = []\n    for _ in range(repeats):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    print(f\\\"  {name}: {sorted(times)[5]:.2f} ms\\\")\n\n# Setup common tensors\nB, L, C = x.shape\nH, D = wq.shape[0], wq.shape[1]\ninv_sqrt_d = 1.0 / math.sqrt(D)\nHD = H * D\nBHL = B * H * L\nxr = x.reshape(B * L, C)\n\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nv = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\nlogits = q @ k.transpose(-1, -2)\nlogits.mul_(inv_sqrt_d)\np0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n\na_p = 0.5 * (1.0 + alpha)\na_m = 0.5 * (1.0 - alpha)\np1_logits = logits.mul(a_p)\np1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\np1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\np_mix = torch.lerp(p0, p1, beta)\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\n\nprint(\\\"\\\\nBreakdown:\\\")\nprofile_section(\\\"q projection\\\", lambda: (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous())\nprofile_section(\\\"k projection\\\", lambda: (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous())\nprofile_section(\\\"v projection\\\", lambda: (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous())\nprofile_section(\\\"q@k.T logits\\\", lambda: q @ k.transpose(-1, -2))\nprofile_section(\\\"softmax p0\\\", lambda: logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L))\nprofile_section(\\\"p1_logits + softmax\\\", lambda: (logits.mul(a_p) + logits.transpose(-1, -2).mul(a_m)).view(BHL, L).softmax(dim=-1).view(B, H, L, L))\nprofile_section(\\\"lerp p_mix\\\", lambda: torch.lerp(p0, p1, beta))\nprofile_section(\\\"G = x@x.T\\\", lambda: x @ x.transpose(-1, -2))\nprofile_section(\\\"p1 @ G\\\", lambda: p1 @ G_exp)\nprofile_section(\\\"p_mix @ G\\\", lambda: p_mix @ G_exp)\nprofile_section(\\\"p_mix @ v\\\", lambda: p_mix @ v)\nprofile_section(\\\"norm computation\\\", lambda: (p1 @ G_exp).mul(p1).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6))\n\n# Test the stacked Gram approach\nprint(\\\"\\\\n--- Stacked Gram optimization test ---\\\")\ndef stacked_gram(p1, p_mix, G):\n    B, H, L, _ = p1.shape\n    p_stack = torch.cat([p1.reshape(B, H*L, L), p_mix.reshape(B, H*L, L)], dim=1)\n    result = p_stack @ G  # (B, 2*H*L, L)\n    p1G = result[:, :H*L, :].reshape(B, H, L, L)\n    pmG = result[:, H*L:, :].reshape(B, H, L, L)\n    return p1G, pmG\n\n# Verify correctness\np1G_orig = p1 @ G_exp\npmG_orig = p_mix @ G_exp\np1G_new, pmG_new = stacked_gram(p1, p_mix, G)\nprint(f\\\"p1G max diff: {torch.max(torch.abs(p1G_orig - p1G_new)):.2e}\\\")\nprint(f\\\"pmG max diff: {torch.max(torch.abs(pmG_orig - pmG_new)):.2e}\\\")\n\nprofile_section(\\\"2 separate p@G (broadcast)\\\", lambda: (p1 @ G_exp, p_mix @ G_exp))\nprofile_section(\\\"stacked p@G (bmm)\\\", lambda: stacked_gram(p1, p_mix, G))\n\nEOF\npython3 /tmp/profile_test.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/per_head_test.py << 'PYEOF'\nimport time, math\nimport torch\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\ndef current_method(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BHL = B * H * L\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    p1G = p1 @ G_exp\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n\ndef per_head_method(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    outputs = []\n    for b in range(B):\n        xb = x[b]\n        G = xb @ xb.T\n        head_outputs = []\n        for h in range(H):\n            q = xb @ wq[h].T\n            k = xb @ wk[h].T\n            v = xb @ wv[h].T\n            logits = q @ k.T\n            logits.mul_(inv_sqrt_d)\n            p0 = logits.softmax(dim=-1)\n            p1_logits = logits.mul(a_p)\n            p1_logits.add_(logits.T, alpha=a_m)\n            p1 = p1_logits.softmax(dim=-1)\n            p_mix = torch.lerp(p0, p1, beta)\n            p1G = p1 @ G\n            norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n            pmG = p_mix @ G\n            normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n            norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n            normm = normm_sq.sqrt_().clamp_min_(1e-6)\n            ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n            y_h = (p_mix @ v).mul_(ratio)\n            head_outputs.append(y_h)\n        outputs.append(torch.cat(head_outputs, dim=1))\n    return torch.stack(outputs, dim=0)\n\n\nout_ref = current_method(x, wq, wk, wv, alpha, beta)\nout_ph = per_head_method(x, wq, wk, wv, alpha, beta)\nprint(f\\\"Per-head vs current max diff: {torch.max(torch.abs(out_ref - out_ph)):.2e}\\\")\n\ndef profile(name, fn, warmup=5, repeats=21):\n    for _ in range(warmup):\n        fn()\n    times = []\n    for _ in range(repeats):\n        t0 = time.process_time_ns()\n        fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    med = sorted(times)[len(times)//2]\n    print(f\\\"  {name}: {med:.2f} ms\\\")\n    return med\n\nprint(\\\"\\\\nTiming:\\\")\nt_cur = profile(\\\"current method\\\", lambda: current_method(x, wq, wk, wv, alpha, beta))\nt_ph = profile(\\\"per-head method\\\", lambda: per_head_method(x, wq, wk, wv, alpha, beta))\nprint(f\\\"Speedup: {t_cur/t_ph:.3f}x\\\")\n\n# Test all case sizes\nprint(\\\"\\\\nAll cases:\\\")\ncases = [\n    (1, 64, 512, 8, 64, 1.05, 5.0),\n    (1, 128, 640, 10, 64, 1.1, 4.0),\n    (1, 128, 1280, 20, 64, 1.15, 3.0),\n    (1, 256, 1280, 20, 64, 1.05, 7.5),\n    (1, 256, 640, 10, 64, 1.2, 5.0),\n    (2, 128, 512, 8, 64, 1.0, 5.0),\n]\nfor ci, (B, L, C, H, D, alpha, beta) in enumerate(cases):\n    xt = torch.randn(B, L, C)\n    wqt = torch.randn(H, D, C)\n    wkt = torch.randn(H, D, C)\n    wvt = torch.randn(H, D, C)\n    for _ in range(3):\n        current_method(xt, wqt, wkt, wvt, alpha, beta)\n        per_head_method(xt, wqt, wkt, wvt, alpha, beta)\n    t1 = []\n    t2 = []\n    for _ in range(11):\n        t0 = time.process_time_ns()\n        current_method(xt, wqt, wkt, wvt, alpha, beta)\n        t1.append((time.process_time_ns() - t0) / 1e6)\n        t0 = time.process_time_ns()\n        per_head_method(xt, wqt, wkt, wvt, alpha, beta)\n        t2.append((time.process_time_ns() - t0) / 1e6)\n    m1 = sorted(t1)[5]\n    m2 = sorted(t2)[5]\n    print(f\\\"  case {ci}: current={m1:.2f}ms per_head={m2:.2f}ms ratio={m1/m2:.3f}\\\")\nPYEOF\npython3 /tmp/per_head_test.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/contiguous_test.py << 'PYEOF'\nimport time, math\nimport torch\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\ninv_sqrt_d = 1.0 / math.sqrt(D)\nHD = H * D\nxr = x.reshape(B * L, C)\n\n# With contiguous\nq_c = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk_c = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nv_c = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\n# Without contiguous\nq_n = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\nk_n = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\nv_n = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n\nprint(f\\\"q is contiguous: {q_c.is_contiguous()} vs {q_n.is_contiguous()}\\\")\nprint(f\\\"q strides: {q_c.stride()} vs {q_n.stride()}\\\")\n\ndef profile(name, fn, warmup=10, repeats=51):\n    for _ in range(warmup):\n        fn()\n    times = []\n    for _ in range(repeats):\n        t0 = time.perf_counter_ns()\n        fn()\n        times.append((time.perf_counter_ns() - t0) / 1e6)\n    med = sorted(times)[len(times)//2]\n    print(f\\\"  {name}: {med:.3f} ms\\\")\n    return med\n\nprint(\\\"\\\\nlogits q@k.T:\\\")\nprofile(\\\"contiguous\\\", lambda: q_c @ k_c.transpose(-1, -2))\nprofile(\\\"non-contiguous\\\", lambda: q_n @ k_n.transpose(-1, -2))\n\n# Also test with p0\nlogits_c = q_c @ k_c.transpose(-1, -2)\nlogits_c.mul_(inv_sqrt_d)\np0_c = logits_c.softmax(dim=-1)\n\nlogits_n = q_n @ k_n.transpose(-1, -2)\nlogits_n.mul_(inv_sqrt_d)\np0_n = logits_n.softmax(dim=-1)\n\nprint(\\\"\\\\np_mix @ v:\\\")\np_mix_c = p0_c.clone()\np_mix_n = p0_n.clone()\nprofile(\\\"v contiguous\\\", lambda: p_mix_c @ v_c)\nprofile(\\\"v non-contiguous\\\", lambda: p_mix_n @ v_n)\n\n# Full function test\ndef full_contig():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    return logits.softmax(dim=-1) @ v\n\ndef full_nocontig():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    return logits.softmax(dim=-1) @ v\n\nprint(\\\"\\\\nFull (proj + logits + softmax + attn):\\\")\nprofile(\\\"with contiguous\\\", full_contig)\nprofile(\\\"without contiguous\\\", full_nocontig)\n\n# Now let me test the complete function with and without the changes\ndef v_original(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BHL = B * H * L\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    p1G = p1 @ G_exp\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n\ndef v_new(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    HL = H * L\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2)\n    p1G = (p1.reshape(B, HL, L) @ G).reshape(B, H, L, L)\n    pmG = (p_mix.reshape(B, HL, L) @ G).reshape(B, H, L, L)\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Ablation: just add back contiguous\ndef v_new_contig(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    HL = H * L\n    BHL = B * H * L\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2)\n    p1G = (p1.reshape(B, HL, L) @ G).reshape(B, H, L, L)\n    pmG = (p_mix.reshape(B, HL, L) @ G).reshape(B, H, L, L)\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\nprint(\\\"\\\\n=== Full function comparison ===\\\")\nprint(f\\\"Original vs new diff: {torch.max(torch.abs(v_original(x,wq,wk,wv,alpha,beta) - v_new(x,wq,wk,wv,alpha,beta))):.2e}\\\")\nprint(f\\\"Original vs new_contig diff: {torch.max(torch.abs(v_original(x,wq,wk,wv,alpha,beta) - v_new_contig(x,wq,wk,wv,alpha,beta))):.2e}\\\")\n\nfor name, fn in [\n    (\\\"original\\\", lambda: v_original(x,wq,wk,wv,alpha,beta)),\n    (\\\"new (no contig + reshaped gram + 4D softmax)\\\", lambda: v_new(x,wq,wk,wv,alpha,beta)),\n    (\\\"new_contig (reshaped gram only)\\\", lambda: v_new_contig(x,wq,wk,wv,alpha,beta)),\n]:\n    profile(name, fn)\n\nPYEOF\npython3 /tmp/contiguous_test.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_60","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/deep_profile2.py << 'PYEOF'\nimport time, math\nimport torch\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\ninv_sqrt_d = 1.0 / math.sqrt(D)\nHD = H * D\nHL = H * L\nBHL = B * H * L\nxr = x.reshape(B * L, C)\n\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nv = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\nlogits = q @ k.transpose(-1, -2)\nlogits.mul_(inv_sqrt_d)\np0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n\na_p = 0.5 * (1.0 + alpha)\na_m = 0.5 * (1.0 - alpha)\np1_logits = logits.mul(a_p)\np1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\np1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n\np_mix = torch.lerp(p0, p1, beta)\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\n\ndef profile(name, fn, warmup=10, repeats=101):\n    for _ in range(warmup):\n        fn()\n    times = []\n    for _ in range(repeats):\n        t0 = time.perf_counter_ns()\n        fn()\n        times.append(time.perf_counter_ns() - t0)\n    med = sorted(times)[len(times)//2] / 1e6\n    print(f\\\"  {name}: {med:.4f} ms\\\")\n    return med\n\nprint(\\\"Individual operations (ms):\\\")\nprint(\\\"-\\\" * 45)\nprofile(\\\"q projection\\\", lambda: (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous())\nprofile(\\\"k projection\\\", lambda: (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous())\nprofile(\\\"v projection\\\", lambda: (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous())\nprofile(\\\"q@k.T logits\\
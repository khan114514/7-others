{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/sh -lc \"python3 -c \\\"\nimport math, torch\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 1, 128, 640, 10, 64\nalpha, beta = 1.1, 4.0\n\ntorch.manual_seed(1 * 1009 + 42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\ndef oracle(x, wq, wk, wv, alpha, beta):\n    q = torch.einsum('blc,hdc->bhld', x, wq)\n    k = torch.einsum('blc,hdc->bhld', x, wk)\n    logits = q @ k.transpose(-1, -2) / math.sqrt(wq.shape[1])\n    p0 = logits.softmax(-1)\n    p1 = (.5 * (1 + alpha) * logits + .5 * (1 - alpha) * logits.transpose(-1, -2)).softmax(-1)\n    base, modified = p0 @ x.unsqueeze(1), p1 @ x.unsqueeze(1)\n    mix = base + beta * (modified - base)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / mix.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    return torch.einsum('bhlc,hdc->bhld', mix * ratio, wv).transpose(1, 2).flatten(2).contiguous()\n\ndef current(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BHL = B * H * L\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1_logits = logits.mul(a_p)\n        p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n        p1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n        p_mix = torch.lerp(p0, p1, beta)\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        p1G = p1 @ G_exp\n        norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n        y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\nout_ref = oracle(x, wq, wk, wv, alpha, beta)\nout_cur = current(x, wq, wk, wv, alpha, beta)\nprint(f'allclose: {torch.allclose(out_ref, out_cur, atol=3e-5, rtol=3e-4)}')\nprint(f'max abs: {(out_ref - out_cur).abs().max().item():.6e}')\nprint(f'max rel: {((out_ref - out_cur).abs() / (out_ref.abs() + 1e-20)).max().item():.6e}')\n# check elementwise\ntolerance = 3e-5 + 3e-4 * out_ref.abs()\nviolations = (out_ref - out_cur).abs() > tolerance\nprint(f'num violations: {violations.sum().item()} / {out_ref.numel()}')\nif violations.any():\n    bad = (out_ref - out_cur).abs()[violations]\n    bad_tol = tolerance[violations]\n    print(f'worst violation ratio: {(bad / bad_tol).max().item():.3f}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

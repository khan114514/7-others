{"type":"item.started","item":{"id":"item_61","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/idea_test.py << 'PYEOF'\nimport time, math\nimport torch\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\ninv_sqrt_d = 1.0 / math.sqrt(D)\nHD = H * D\nHL = H * L\nxr = x.reshape(B * L, C)\n\n# Baseline: compute q and k separately\ndef baseline_qk():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    return q, k\n\n# Idea: compute as one big matmul then split in BH layout\ndef fused_qk():\n    w_qk = torch.cat([wq.reshape(HD, C), wk.reshape(HD, C)], dim=0)  # (2HD, C)\n    qk = xr @ w_qk.T  # (B*L, 2HD)\n    q_flat, k_flat = qk.split([HD, HD], dim=1)\n    q = q_flat.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = k_flat.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    return q, k\n\ndef profile(name, fn, warmup=10, repeats=101):\n    for _ in range(warmup):\n        fn()\n    times = []\n    for _ in range(repeats):\n        t0 = time.perf_counter_ns()\n        fn()\n        times.append(time.perf_counter_ns() - t0)\n    med = sorted(times)[len(times)//2] / 1e6\n    print(f\\\"  {name}: {med:.4f} ms\\\")\n    return med\n\nprint(\\\"Projection tests:\\\")\nprofile(\\\"q+k separate\\\", baseline_qk)\nprofile(\\\"q+k fused\\\", fused_qk)\n\n# Check correctness\nq1, k1 = baseline_qk()\nq2, k2 = fused_qk()\nprint(f\\\"  q diff: {torch.max(torch.abs(q1 - q2)):.2e}\\\")\nprint(f\\\"  k diff: {torch.max(torch.abs(k1 - k2)):.2e}\\\")\n\n# Idea: compute qk directly = x @ (wq.T @ wk) @ x.T / sqrt(D)?\n# No, that's H * C\"'^2 * D which is worse.\n\n# Idea: what about computing k before q, or computing them in a different order?\n# No, same cost.\n\n# Idea: what if we compute q and k in (B,L,H,D) layout then transpose for attention?\n# Wait, we already do that. The question is whether the contiguous is needed.\n\nq_nc = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\nk_nc = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n\nq_c = q_nc.contiguous()\nk_c = k_nc.contiguous()\n\nprint(\"'\"\\\\nLogits with contiguous vs non-contiguous q,k:\\\")\nprofile(\\\"contiguous q@k.T\\\", lambda: q_c @ k_c.transpose(-1, -2))\nprofile(\\\"non-contig q@k.T\\\", lambda: q_nc @ k_nc.transpose(-1, -2))\n\n# What if we compute logits directly from (B,L,H,D) layout?\n# q_blhd: (B, L, H, D) - we want per-head attention\n# We need (B, H, L, D) @ (B, H, D, L) = (B, H, L, L)\n# From (B, L, H, D) we can do: permute to (B,H,L,D) then @ then transpose back\n# Same cost.\n\n# What if we keep q,k in (B*H, L, D) layout?\nq_bmm = q_c.reshape(B*H, L, D)\nk_bmm = k_c.reshape(B*H, L, D)\nprofile(\\\"bmm q@k.T\\\", lambda: torch.bmm(q_bmm, k_bmm.transpose(-1, -2)))\n\nprint(\\\"\\\\n--- Testing full function variants ---\\\")\n\ndef v1_original(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BHL = B * H * L\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    p1G = p1 @ G_exp\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n\ndef v2_reshaped_gram(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    HL = H * L\n    BHL = B * H * L\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    p1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2)\n    p1G = (p1.reshape(B, HL, L) @ G).reshape(B, H, L, L)\n    pmG = (p_mix.reshape(B, HL, L) @ G).reshape(B, H, L, L)\n    norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n    normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n    normm = normm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n\n# Also test with bmm for p_mix @ v\ndef v3_bmm_output(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqr
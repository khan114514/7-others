{"type":"item.started","item":{"id":"item_58","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/deep_profile.py << 'PYEOF'\nimport time, math\nimport torch\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n# Test across all 6 dev cases\ncases = [\n    (1, 64, 512, 8, 64, 1.05, 5.0),\n    (1, 128, 640, 10, 64, 1.1, 4.0),\n    (1, 128, 1280, 20, 64, 1.15, 3.0),\n    (1, 256, 1280, 20, 64, 1.05, 7.5),\n    (1, 256, 640, 10, 64, 1.2, 5.0),\n    (2, 128, 512, 8, 64, 1.0, 5.0),\n]\n\ndef full_opt(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BHL = B * H * L\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1_logits = logits.mul(a_p)\n        p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n        p1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n        p_mix = torch.lerp(p0, p1, beta)\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        p1G = p1 @ G_exp\n        norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n        y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Try an idea: compute both norms via a single bmm with p stacked\n# Actually let's try computing G earlier (right after projections)\ndef opt_early_G(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BHL = B * H * L\n    HL = H * L\n    xr = x.reshape(B * L, C)\n\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\n    # Compute G early while x is still in cache\n    G = x @ x.transpose(-1, -2)\n\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n\n    p0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1_logits = logits.mul(a_p)\n        p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n        p1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n\n        p_mix = torch.lerp(p0, p1, beta)\n\n        # Reshaped Gram: (B, H*L, L) @ (B, L, L) - fewer, larger matmuls\n        p1G = (p1.reshape(B, HL, L) @ G).reshape(B, H, L, L)\n        pmG = (p_mix.reshape(B, HL, L) @ G).reshape(B, H, L, L)\n\n        norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n        normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n\n        y = (p_mix @ v).mul_(ratio)\n\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Try: compute p0@v and p1@v separately, blend - maybe saves p_mix allocation?\ndef opt_blend_output(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BHL = B * H * L\n    HL = H * L\n    xr = x.reshape(B * L, C)\n\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\n    G = x @ x.transpose(-1, -2)\n\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n\n    p0 = logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1_logits = logits.mul(a_p)\n        p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n        p1 = p1_logits.view(BHL, L).softmax(dim=-1).view(B, H, L, L)\n\n        # Compute both attention outputs and blend\n        out0 = p0 @ v\n        out1 = p1 @ v\n        # output = (1-beta)*out0 + beta*out1 = out0 + beta*(out1-out0)\n        y = torch.lerp(out0, out1, beta)\n\n        # Still need p_mix for normm... or compute from p0 and p1\n        # normm\"'^2 = (1-b)''^2 * norm0''^2 + b''^2 * norm1''^2 + 2*b*(1-b) * cross\n        # Need p0@G and p1@G\n        p0G = (p0.reshape(B, HL, L) @ G).reshape(B, H, L, L)\n        p1G = (p1.reshape(B, HL, L) @ G).reshape(B, H, L, L)\n\n        norm0_sq = p0G.mul(p0).sum(dim=-1, keepdim=True)\n        norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n        \n        # cross = (p0G * p1).sum(dim=-1, keepdim=True)\n        cross = p0G.mul(p1).sum(dim=-1, keepdim=True)\n        \n        b0 = 1.0 - beta\n        normm_sq = norm0_sq.mul(b0*b0).add_(norm1_sq, alpha=beta*beta).add_(cross, alpha=2*b0*beta)\n        \n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n\n        y.mul_(ratio)\n\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n\ndef profile(name, fn, warmup=5, repeats=31):\n    for _ in range(warmup):\n        fn()\n    times = []\n    for _ in range(repeats):\n        t0 = time.perf_counter_ns()\n        fn()\n        times.append((time.perf_counter_ns() - t0) / 1e6)\n    med = sorted(times)[len(times)//2]\n    return med\n\nprint(\"Case comparison (wall time, ms):\")\nprint(f\"{'\"'Case':>4}  {'Orig':>7}  {'EarlyG':>7}  {'Blend':>7}  {'E.Gain':>7}  {'B.Gain':>7}\\\")\nprint(\\\"-\\\" * 55)\n\ntotal_orig = total_eg = total_blend = 0\nfor ci, (B, L, C, H, D, alpha, beta) in enumerate(cases):\n    torch.manual_seed(ci * 1009 + 42)\n    x = torch.randn(B, L, C)\n    wq = torch.randn(H, D, C)\n    wk = torch.randn(H, D, C)\n    wv = torch.randn(H, D, C)\n    \n    # Correctness check\n    out_ref = full_opt(x, wq, wk, wv, alpha, beta)\n    out_eg = opt_early_G(x, wq, wk, wv, alpha, beta)\n    out_bl = opt_blend_output(x, wq, wk, wv, alpha, beta)\n    \n    d_eg = torch.max(torch.abs(out_ref - out_eg)).item()\n    d_bl = torch.max(torch.abs(out_ref - out_bl)).item()\n    \n    t_orig = profile(\\\"orig\\\", lambda: full_opt(x, wq, wk, wv, alpha, beta))\n    t_eg = profile(\\\"eg\\\", lambda: opt_early_G(x, wq, wk, wv, alpha, beta))\n    t_bl = profile(\\\"blend\\\", lambda: opt_blend_output(x, wq, wk, wv, alpha, beta))\n    \n    gain_eg = (t_orig - t_eg) / t_orig * 100\n    gain_bl = (t_orig - t_bl) / t_orig * 100\n    \n    print(f\\\"  {ci:2}    {t_orig:7.3f}  {t_eg:7.3f}  {t_bl:7.3f}  {gain_eg:+6.2f}%  {gain_bl:+6.2f}%  (d_eg={d_eg:.1e}, d_bl={d_bl:.1e})\\\")\n    \n    total_orig += t_orig\n    total_eg += t_eg\n    total_blend += t_bl\n\nn = len(cases)\nprint(f\\\"\\\\nMean:   {total_orig/n:7.3f}  {total_eg/n:7.3f}  {total_blend/n:7.3f}  {(total_orig-total_eg)/total_orig*100:+6.2f}%  {(total_orig-total_blend)/total_orig*100:+6.2f}%\\\")\nPYEOF\npython3 /tmp/deep_profile.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

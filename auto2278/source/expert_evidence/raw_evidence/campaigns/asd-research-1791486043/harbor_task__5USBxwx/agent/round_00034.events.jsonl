{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math, time\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\ndef profile_case(B, L, C, H, D, alpha, beta, name):\n    torch.manual_seed(42)\n    x = torch.randn(B, L, C)\n    wq = torch.randn(H, D, C) * 0.1\n    wk = torch.randn(H, D, C) * 0.1\n    wv = torch.randn(H, D, C) * 0.1\n    \n    def bench(fn, n=100, warmup=10):\n        for _ in range(warmup):\n            fn()\n        t0 = time.process_time_ns()\n        for _ in range(n):\n            fn()\n        t1 = time.process_time_ns()\n        return (t1 - t0) / n / 1e6\n    \n    BH = B * H\n    HD = H * D\n    xr = x.reshape(B * L, C)\n    wqr = wq.reshape(HD, C)\n    wkr = wk.reshape(HD, C)\n    wvr = wv.reshape(HD, C)\n    \n    q = (xr @ wqr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    k = (xr @ wkr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    v = (xr @ wvr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    \n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    q.mul_(inv_sqrt_d)\n    logits = torch.bmm(q, k.transpose(1, 2))\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 + 0.5 * alpha\n    a_m = 0.5 - 0.5 * alpha\n    p1_logits = logits.mul(a_p).add(logits.transpose(1, 2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    \n    G = torch.bmm(x, x.transpose(1, 2))\n    G_tiled = G.unsqueeze(1).expand(B, H, L, L).reshape(BH, L, L).contiguous()\n    p1G = torch.bmm(p1, G_tiled)\n    pmG = torch.bmm(p_mix, G_tiled)\n    \n    t_total = bench(lambda: None)  # baseline\n    t_q = bench(lambda: (xr @ wqr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D))\n    t_k = bench(lambda: (xr @ wkr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D))\n    t_v = bench(lambda: (xr @ wvr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D))\n    t_logits = bench(lambda: torch.bmm(q, k.transpose(1, 2)))\n    t_softmax = bench(lambda: logits.softmax(dim=-1))\n    t_p1logits = bench(lambda: logits.mul(a_p).add(logits.transpose(1, 2), alpha=a_m))\n    t_p1softmax = bench(lambda: p1_logits := logits.mul(a_p).add(logits.transpose(1, 2), alpha=a_m); p1_logits.softmax(dim=-1))\n    t_lerp = bench(lambda: torch.lerp(p0, p1, beta))\n    t_G = bench(lambda: torch.bmm(x, x.transpose(1, 2)))\n    t_p1G = bench(lambda: torch.bmm(p1, G_tiled))\n    t_pmG = bench(lambda: torch.bmm(p_mix, G_tiled))\n    t_pmv = bench(lambda: torch.bmm(p_mix, v))\n    \n    total = t_q + t_k + t_v + t_logits + t_softmax + t_p1logits + (t_p1softmax - t_p1logits) + t_lerp + t_G + t_p1G + t_pmG + t_pmv\n    \n    print(f'\\\\\\\\n=== {name}: B={B}, L={L}, C={C}, H={H}, D={D} ===')\n    print(f'Q proj:   {t_q:.3f} ms ({t_q/total*100:.1f}%)')\n    print(f'K proj:   {t_k:.3f} ms ({t_k/total*100:.1f}%)')\n    print(f'V proj:   {t_v:.3f} ms ({t_v/total*100:.1f}%)')\n    print(f'Logits:   {t_logits:.3f} ms ({t_logits/total*100:.1f}%)')\n    print(f'Softmax0: {t_softmax:.3f} ms ({t_softmax/total*100:.1f}%)')\n    print(f'P1 logits:{t_p1logits:.3f} ms ({t_p1logits/total*100:.1f}%)')\n    print(f'P1 sm+log:{t_p1softmax:.3f} ms ({t_p1softmax/total*100:.1f}%)')\n    print(f'Lerp:     {t_lerp:.3f} ms ({t_lerp/total*100:.1f}%)')\n    print(f'G:        {t_G:.3f} ms ({t_G/total*100:.1f}%)')\n    print(f'p1@G:     {t_p1G:.3f} ms ({t_p1G/total*100:.1f}%)')\n    print(f'pm@G:     {t_pmG:.3f} ms ({t_pmG/total*100:.1f}%)')\n    print(f'pm@v:     {t_pmv:.3f} ms ({t_pmv/total*100:.1f}%)')\n    print(f'Total approx: {total:.3f} ms')\n\nprofile_case(1, 64, 512, 8, 64, 1.05, 5.0, 'Case 1')\nprofile_case(1, 128, 1280, 20, 64, 1.15, 3.0, 'Case 3')\nprofile_case(1, 256, 1280, 20, 64, 1.05, 7.5, 'Case 4 (largest L)')\nprofile_case(2, 128, 512, 8, 64, 1.0, 5.0, 'Case 6 (alpha=1)')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"
f} ms')\nprint(f'Via einsum: {t2:.3f} ms, ratio: {t1/t2:.3f}')\n\n# Wait, einsum includes the q scaling too. Let me fair compare.\ndef logits_via_bmm_withscale():\n    q = q_blhd.permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    k = k_blhd.permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    q = q * inv_sqrt_d\n    return torch.bmm(q, k.transpose(1, 2))\n\nt1b = bench(logits_via_bmm_withscale, n=100)\nprint(f'\\\\\\\\nVia BMM (fair): {t1b:.3f} ms')\nprint(f'Via einsum: {t2:.3f} ms, ratio: {t1b/t2:.3f}')\n\\\"\n\"","aggregated_output":"Logits match: 0.00e+00\nVia BMM: 1.519 ms\nVia einsum: 1.730 ms, ratio: 0.878\n\nVia BMM (fair): 1.524 ms\nVia einsum: 1.730 ms, ratio: 0.881\n","exit_code":0,"status":"completed"}}

ross = p0G.mul_(p1).sum(dim=-1, keepdim=True)\n    # p_mix = (1-b)*p0 + b*p1\n    # ||pm@x||''^2 = (1-b)''^2*n0''^2 + b''^2*n1''^2 + 2*(1-b)*b*cross\n    b1 = 1.0 - beta\n    b2 = beta\n    nm_sq = n0_sq.mul(b1*b1).add_(n1_sq, alpha=b2*b2).add_(cross, alpha=2*b1*b2)\n    norm1 = n1_sq.sqrt_().clamp_min_(1e-6)\n    normm = nm_sq.sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    p_mix = torch.lerp(p0, p1, beta)\n    return ratio, p_mix\n\nr1, pm1 = current_norms()\nr2, pm2 = cross_norms()\nprint(f'\"'Ratio max diff: {(r1-r2).abs().max():.2e}')\nprint(f'p_mix max diff: {(pm1-pm2).abs().max():.2e}')\n\nt_curr = bench(current_norms, n=200, warmup=30)\nt_cross = bench(cross_norms, n=200, warmup=30)\nprint(f'\\\\\\\\nCurrent: {t_curr:.3f} ms')\nprint(f'Cross-term: {t_cross:.3f} ms, ratio: {t_curr/t_cross:.3f}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

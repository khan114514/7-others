{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math, time\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C) * 0.1\n\ndef bench(fn, n=200, warmup=20):\n    for _ in range(warmup):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    return (t1 - t0) / n / 1e6\n\nBH = B * H\nHD = H * D\nxr = x.reshape(B * L, C)\nwqr = wq.reshape(HD, C)\n\n# Approach 1: current\ndef proj_current():\n    q = (xr @ wqr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    return q\n\n# Approach 2: as_strided? No, forbidden.\n\n# Approach 3: directly compute in (BH, L, D) shape using bmm\n# q[b,h,l,d] = sum_c x[b,l,c] * wq[h,d,c]\n# x: (B, L, C), wq reshaped: (B*H, C, D)? No.\n# wq reshaped to (H*D, C) gives us (B*L, H*D) from x.reshape(BL, C) @ wqr.T\n\n# What about: x (B, L, C) -> expand to (B*H, L, C), wq (H*D, C) -> (B*H, C, D)?\n# Hmm, that's weird since wq doesn't vary with B.\n\n# Approach 3: just matmul + reshape, skip the contiguous check\ndef proj_view():\n    q = (xr @ wqr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    return q.view(BH, L, D)\n\n# Approach 4: compute logits directly with a different reshape\n# q in (B, L, H, D) layout; k in (B, L, H, D) layout\n# logits[b,h,i,j] = sum_d q[b,i,h,d] * k[b,j,h,d]\n# = einsum('bihd,bjhd->bhij')\n# Can we do this with bmm? For each head h, q[:,h] @ k[:,h].T\n# That's what we currently do with (BH, L, D) @ (BH, D, L)\n\n# Approach 5: what if we transpose the weight differently?\n# wq_t = wq.permute(0, 2, 1).reshape(H*C, D).contiguous()  -> (H*C, D)\n# No, we'd need x in a different layout\n\n# Let me just benchmark raw matmul vs full pipeline\nt_raw = bench(lambda: xr @ wqr.T)\nt_full = bench(proj_current)\nt_view = bench(proj_view)\nt_permute = bench(lambda: (xr @ wqr.T).view(B, L, H, D).permute(0, 2, 1, 3))\nt_contig = bench(lambda: (xr @ wqr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous())\n\nprint(f'Raw matmul: {t_raw:.3f} ms')\nprint(f'+ permute (non-contig): {t_permute:.3f} ms')\nprint(f'+ permute + contiguous: {t_contig:.3f} ms')\nprint(f'Full (with view BH): {t_full:.3f} ms')\nprint(f'Permute+contig overhead: {t_contig - t_raw:.3f} ms')\n\n# What if we do all 3 projections at once via a single (BL, C) @ (C, 3*HD)\n# but then split after?\n# Actually we already tested fused QKV and it was slower.\n# Let me test the overhead of the cat operation\ndef bench_fused_qkv():\n    w_qkv = torch.cat([wqr, wqr, wqr], dim=0)  # (3*HD, C)\n    out = xr @ w_qkv.T\n    q = out[:, :HD].view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    k = out[:, HD:2*HD].view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    v = out[:, 2*HD:].view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    return q, k, v\n\nt_fused = bench(bench_fused_qkv, n=100)\nprint(f'Fused QKV total (3 proj): {t_fused:.3f} ms')\nprint(f'Separate (3x single): {3*t_full:.3f} ms')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math, time\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n# Use case 4 dimensions (largest L)\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C) * 0.1\nwk = torch.randn(H, D, C) * 0.1\nwv = torch.randn(H, D, C) * 0.1\n\ndef attention_v1(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BH = B * H\n    xr = x.reshape(B * L, C)\n    wqr = wq.reshape(HD, C)\n    wkr = wk.reshape(HD, C)\n    wvr = wv.reshape(HD, C)\n    q = (xr @ wqr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    k = (xr @ wkr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    q.mul_(inv_sqrt_d)\n    logits = torch.bmm(q, k.transpose(1, 2))\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 + 0.5 * alpha\n    a_m = 0.5 - 0.5 * alpha\n    p1_logits = logits.mul(a_p).add_(logits.transpose(1, 2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = torch.bmm(x, x.transpose(1, 2))\n    G_tiled = G.unsqueeze(1).expand(B, H, L, L).reshape(BH, L, L)\n    p1G = torch.bmm(p1, G_tiled)\n    norm1 = p1G.mul_(p1).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    pmG = torch.bmm(p_mix, G_tiled)\n    normm = pmG.mul_(p_mix).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    v = (xr @ wvr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    y = torch.bmm(p_mix, v).mul_(ratio)\n    return y.view(B, H, L, D).transpose(1, 2).flatten(2).contiguous()\n\ndef attention_v2_fused_qkv(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BH = B * H\n    xr = x.reshape(B * L, C)\n    # Fused QKV projection\n    w_qkv = torch.cat([wq.reshape(HD, C), wk.reshape(HD, C), wv.reshape(HD, C)], dim=0)\n    qkv = xr @ w_qkv.T\n    q = qkv[:, :HD].view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    k = qkv[:, HD:2*HD].view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    v = qkv[:, 2*HD:].view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    q.mul_(inv_sqrt_d)\n    logits = torch.bmm(q, k.transpose(1, 2))\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 + 0.5 * alpha\n    a_m = 0.5 - 0.5 * alpha\n    p1_logits = logits.mul(a_p).add_(logits.transpose(1, 2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = torch.bmm(x, x.transpose(1, 2))\n    G_tiled = G.unsqueeze(1).expand(B, H, L, L).reshape(BH, L, L)\n    p1G = torch.bmm(p1, G_tiled)\n    norm1 = p1G.mul_(p1).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    pmG = torch.bmm(p_mix, G_tiled)\n    normm = pmG.mul_(p_mix).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    y = torch.bmm(p_mix, v).mul_(ratio)\n    return y.view(B, H, L, D).transpose(1, 2).flatten(2).contiguous()\n\n# Numerical check\ny1 = attention_v1(x, wq, wk, wv, alpha, beta)\ny2 = attention_v2_fused_qkv(x, wq, wk, wv, alpha, beta)\ndiff = (y1 - y2).abs()\nprint(f'Fused QKV max diff: {diff.max().item():.2e}, mean: {diff.mean().item():.2e}')\nprint(f'Relative max: {(diff / y1.abs().clamp_min(1e-8)).max().item():.2e}')\n\n# Timing\ndef bench(fn, n=50, warmup=10):\n    for _ in range(warmup):\n        fn(x, wq, wk, wv, alpha, beta)\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn(x, wq, wk, wv, alpha, beta)\n    t1 = time.process_time_ns()\n    return (t1 - t0) / n / 1e6\n\nt1 = bench(attention_v1, n=30, warmup=5)\nt2 = bench(attention_v2_fused_qkv, n=30, warmup=5)\nprint(f'v1: {t1:.2f} ms, v2_fused_qkv: {t2:.2f} ms, speedup: {t1/t2:.3f}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

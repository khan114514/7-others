{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/sh -lc 'cd /workspace && python3 -c \"\nimport torch, math, time\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C) * 0.1\nwk = torch.randn(H, D, C) * 0.1\nwv = torch.randn(H, D, C) * 0.1\n\ndef bench(fn, n=200, warmup=30):\n    for _ in range(warmup):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    return (t1 - t0) / n / 1e6\n\nBH = B * H\nHD = H * D\nHL = H * L\nxr = x.reshape(B * L, C)\nwqr = wq.reshape(HD, C)\nwkr = wk.reshape(HD, C)\nwvr = wv.reshape(HD, C)\ninv_sqrt_d = 1.0 / math.sqrt(D)\n\nq = (xr @ wqr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\nk = (xr @ wkr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\nq.mul_(inv_sqrt_d)\nlogits = torch.bmm(q, k.transpose(1, 2))\n\na_p = 0.5 + 0.5 * alpha\na_m = 0.5 - 0.5 * alpha\n\n# Current approach\ndef current_p1():\n    pl = logits.mul(a_p).add(logits.transpose(1, 2), alpha=a_m)\n    return pl.softmax(dim=-1)\n\n# Variant 1: use logits directly with scaling\ndef variant1():\n    # p1_logits = a_p * A + a_m * A''^T\n    pl = torch.addcmul(logits.transpose(1, 2), logits, a_p, value=a_m)\n    # Hmm, addcmul is: tensor + value * tensor1 * tensor2\n    # We want: a_p * logits + a_m * logits.T\n    # = a_m * logits.T + a_p * logits\n    # addcmul(input=logits*a_m? No.\n    return pl.softmax(dim=-1)\n\n# Variant 2: compute in-place\ndef variant2():\n    pl = logits.mul(a_p)\n    pl.add_(logits.transpose(1, 2), alpha=a_m)\n    return pl.softmax(dim=-1)\n\n# Variant 3: compute logits already scaled for p1\n# p1_logits = a_p/√D * qk''^T + a_m/√D * kq''^T\n# What if we scale q and k differently?\n# No, we need logits for p0 = qk''^T/√D too.\n\n# Let'\"'s benchmark\nt_curr = bench(current_p1, n=200, warmup=30)\nt_v2 = bench(variant2, n=200, warmup=30)\nprint(f'Current p1: {t_curr:.3f} ms')\nprint(f'Variant 2 (explicit): {t_v2:.3f} ms, ratio: {t_curr/t_v2:.3f}')\n\n# Let me also test softmax on different memory layouts\nlogits_c = logits.contiguous()\nlogits_t = logits.transpose(1, 2).contiguous()\n\nt_sm_c = bench(lambda: logits_c.softmax(dim=-1), n=200)\nt_sm_t = bench(lambda: logits_t.softmax(dim=-1), n=200)\nprint(f'\\\\\\\\nSoftmax on C-contiguous: {t_sm_c:.3f} ms')\nprint(f'Softmax on transposed: {t_sm_t:.3f} ms')\n\n# Softmax on dim=-2 vs dim=-1\nt_sm_d1 = bench(lambda: logits_c.softmax(dim=1), n=200)\nprint(f'Softmax on dim=1: {t_sm_d1:.3f} ms')\n\n# What about the overall function - can we rearrange to minimize memory allocation?\n# Let me count the number of allocations in current version.\n# 1. q projection\n# 2. k projection  \n# 3. logits\n# 4. p0 (softmax output)\n# 5. p1_logits (mul + add)\n# 6. p1 (softmax output)\n# 7. p_mix (lerp)\n# 8. G\n# 9. p1G\n# 10. pmG\n# 11. norm1 (with intermediate p1G*p1)\n# 12. normm\n# 13. ratio\n# 14. v projection\n# 15. y = pm @ v\n# 16. output reshape\n#\n# ~16 tensor allocations. Most are small compared to the BLAS time.\n# But for small cases, allocation overhead matters more.\n\n# Let me try: use in-place softmax? No, softmax creates a new tensor.\n# What about using logits.mul_(a_p).add_(logits.transpose(1,2), alpha=a_m).softmax_()?\n# softmax_ is in-place\"'! Let me check if it exists.\n\nprint(f'\"'\\\\\\\\nHas softmax_: {hasattr(torch.Tensor, \\\\\\\"softmax_\\\\\\\")}')\n\ndef variant_inplace_softmax():\n    pl = logits.mul(a_p).add_(logits.transpose(1, 2), alpha=a_m)\n    return pl.softmax_(dim=-1)\n\ntry:\n    r = variant_inplace_softmax()\n    t_inplace = bench(variant_inplace_softmax, n=200)\n    print(f'In-place softmax: {t_inplace:.3f} ms, ratio: {t_curr/t_inplace:.3f}')\n    print(f'Match: {(current_p1() - r).abs().max():.2e}')\nexcept Exception as e:\n    print(f'In-place softmax error: {e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

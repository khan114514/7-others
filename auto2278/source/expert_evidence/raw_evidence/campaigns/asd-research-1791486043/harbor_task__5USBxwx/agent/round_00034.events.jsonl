{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math, time\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n# Case 4 is biggest and most important\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C) * 0.1\nwk = torch.randn(H, D, C) * 0.1\nwv = torch.randn(H, D, C) * 0.1\n\ndef bench(fn, n=200, warmup=20):\n    for _ in range(warmup):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    return (t1 - t0) / n / 1e6\n\nBH = B * H\nHD = H * D\nxr = x.reshape(B * L, C)\nwqr = wq.reshape(HD, C)\nwkr = wk.reshape(HD, C)\nwvr = wv.reshape(HD, C)\n\n# Idea: can we compute p1 and pm norm in a single bmm call?\n# p1_3d = (B, H*L, L), pm_3d = (B, H*L, L)\n# Stack them: (B, 2*H*L, L) @ G = (B, 2*H*L, L)\n# Then split\n\nG = torch.bmm(x, x.transpose(1, 2))  # (B, L, L)\np1 = torch.randn(BH, L, L)\npm = torch.randn(BH, L, L)\n\ndef two_bmms():\n    p1G = torch.bmm(p1.view(B, H*L, L), G).view(BH, L, L)\n    pmG = torch.bmm(pm.view(B, H*L, L), G).view(BH, L, L)\n    return p1G, pmG\n\ndef stacked_bmm():\n    stacked = torch.cat([p1.view(B, H*L, L), pm.view(B, H*L, L)], dim=1)  # (B, 2HL, L)\n    result = torch.bmm(stacked, G)  # (B, 2HL, L)\n    n = H * L\n    return result[:, :n, :].view(BH, L, L), result[:, n:, :].view(BH, L, L)\n\nr1a, r2a = two_bmms()\nr1b, r2b = stacked_bmm()\nprint(f'Stacked match: {(r1a-r1b).abs().max():.2e}, {(r2a-r2b).abs().max():.2e}')\n\nt1 = bench(two_bmms, n=100)\nt2 = bench(stacked_bmm, n=100)\nprint(f'Two bmms: {t1:.3f} ms')\nprint(f'Stacked bmm: {t2:.3f} ms, ratio: {t1/t2:.3f}')\n\n# Idea: can we avoid the logits.transpose for p1_logits?\n# p1_logits = a_p * logits + a_m * logits\"'^T\n# This is a symmetric-like operation\n# logits.transpose is a view, so it'\"'s free.\n# But the mul+add is 2 ops. Can we do it with one fused op?\n# logits.mul(a_p).add_(logits.transpose(1,2), alpha=a_m) -- this is already 2 fused ops\n# Not much to improve there.\n\n# Idea: can we compute softmax in-place or more efficiently?\n# softmax(dim=-1) on contiguous (BH, L, L) tensor\nlogits = torch.randn(BH, L, L)\nt_sm = bench(lambda: logits.softmax(dim=-1), n=100)\nt_log_softmax = bench(lambda: logits.log_softmax(dim=-1), n=100)\nprint(f'\\\\\\\\nSoftmax: {t_sm:.3f} ms')\nprint(f'LogSoftmax: {t_log_softmax:.3f} ms')\n\n# Idea: compute logits with a different approach\n# logits = q @ k\"'^T / sqrt(D)\n# Currently: q.mul_(inv_sqrt_d) then logits = bmm(q, k.T)\n# Alternative: logits = bmm(q, k.T) * inv_sqrt_d (scale after)\n# Which is better? q is (BH, L, D), logits is (BH, L, L)\n# Scaling q: BH*L*D elements = 20*256*64 = 328K elements\n# Scaling logits: BH*L*L elements = 20*256*256 = 1.3M elements\n# So scaling q is better (4x fewer elements). We already do this.\n\n# Idea: for case 6 with alpha=1.0, skip the p1 path\n# We already do this. Good.\n\n# What about reducing tensor creation overhead?\n# Let me try: pre-allocate and use out= variants\n# Actually the source guard might not allow certain torch functions\n# Let me check what'\"'s allowed...\n# The banned attrs include _ prefix things, but addmm, bmm add_ etc should be fine.\n\n# What about using .add_ with out= parameter? That's just add_.\n\n# Idea: compute p_mix and pmG in a fused way?\n# pmG = pm @ G = ((1-beta)*p0 + beta*p1) @ G = (1-beta)*p0@G + beta*p1@G\n# We need p1@G for norm1 anyway. So if we compute p0@G too, we can compute pmG via elementwise\n# p0G + beta*(p1G - p0G), saving one bmm\"'!\n# BUT we need another bmm p0@G instead. Same total bmm count...\n# Unless p0@G is cheaper somehow... no, same size.\n\n# Wait! We compute p_mix = lerp(p0, p1, beta) which is (1-beta)*p0 + beta*p1\n# And pmG = p_mix @ G\n# \n# Alternative: compute p0G and p1G, then pmG = lerp(p0G, p1G, beta)\n# Same number of bmms (2). But saves lerp on the (BH, L, L) p tensor!\n# p is (BH, L, L) = same size, so same cost. No gain.\n\n# What if we don'\"'t materialize p_mix at all?\n# y = pm @ v = (1-beta)*p0@v + beta*p1@v\n# Then we need: p0@v, p1@v, pmG (which we can get from p0G and p1G)\n# Let me count operations:\n# Current: p0_sm, p1_sm, lerp(p0,p1) -> p_mix, p1@G, pm@G, pm@v\n# New: p0_sm, p1_sm, p0@G, p1@G, p0@v, p1@v, then compute everything via lerp\n# This replaces 1 bmm (pm@G + pm@v = 2 bmms) with (p0@G + p0@v = 2 bmms). Same count.\n# But we save the lerp on p_mix (BH*L*L elements). Small saving.\n# Actually we add: 1 extra bmm p0@v but remove pm@v. Same count.\n# Plus we save p_mix allocation. Let me try it\"'!\n\nprint()\n\nq_r = (xr @ wqr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\nk_r = (xr @ wkr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\nq_r.mul_(1.0/math.sqrt(D))\nlogits = torch.bmm(q_r, k_r.transpose(1, 2))\np0 = logits.softmax(dim=-1)\na_p = 0.5 + 0.5 * alpha\na_m = 0.5 - 0.5 * alpha\np1_logits = logits.mul(a_p).add(logits.transpose(1, 2), alpha=a_m)\np1 = p1_logits.softmax(dim=-1)\nv = (xr @ wvr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n\n# Current approach\ndef current_approach():\n    p_mix = torch.lerp(p0, p1, beta)\n    p1G = torch.bmm(p1.view(B, H*L, L), G).view(BH, L, L)\n    pmG = torch.bmm(p_mix.view(B, H*L, L), G).view(BH, L, L)\n    norm1 = p1G.mul(p1).sum(dim=-1, keepdim=True).sqrt().clamp_min(1e-6)\n    normm = pmG.mul(p_mix).sum(dim=-1, keepdim=True).sqrt().clamp_min(1e-6)\n    ratio = norm1.div(normm).clamp(0.25, 4.0)\n    y = torch.bmm(p_mix, v).mul(ratio)\n    return y\n\n# No-pmix approach\ndef nopmix_approach():\n    # Compute p0@G and p1@G\n    p0G = torch.bmm(p0.view(B, H*L, L), G).view(BH, L, L)\n    p1G = torch.bmm(p1.view(B, H*L, L), G).view(BH, L, L)\n    \n    # pmG = (1-beta)*p0G + beta*p1G\n    pmG = torch.lerp(p0G, p1G, beta)\n    \n    # Compute norms\n    norm1_sq = p1G.mul(p1).sum(dim=-1, keepdim=True)\n    # ||pm||''^2 = pmG_ii * pm_i  (elementwise pm * pmG sum over last dim)\n    # pm = (1-b)p0 + b p1\n    # pmG = (1-b)p0G + b p1G\n    # pm * pmG summed = sum_j pm_ij * pmG_ij \n    # This is NOT simply lerp of the squared norms because of cross terms!\n    # ||pm@x||''^2 = sum_jk pm_ij pm_ik G_jk = pm_i @ G @ pm_i''^T\n    # This is quadratic in pm, not linear. So we can'\"'t lerp the norms.\n    # We NEED pm * pmG summed elementwise, which requires full pmG tensor.\n    \n    # Actually wait: we DO have pmG (via lerp), we just need pm elementwise multiplied\n    # pm = (1-b)*p0 + b*p1\n    # pm * pmG = [(1-b)p0 + b p1] * [(1-b)p0G + b p1G]\n    # = (1-b)\"'^2 p0*p0G + b''^2 p1*p1G + (1-b)b (p0*p1G + p1*p0G)\n    # That'\"'s 4 elementwise muls. Might still be cheaper than pm@G bmm\n    # but let's check if we can compute pm more cheaply...\n    # pm = lerp(p0, p1, beta) is just one elementwise op, so we still need that.\n    # Total ops: lerp(p0,p1)[BHLL] + pm@G[B*HL*L*L] vs lerp(p0G,p1G)[BHLL] + pm_mul[BHLL*4]\n    # For case 4: BH*L*L = 20*256*256 = 1.3M elements, B*HL*L*L = 1*5120*256*256 = 335M MACs\n    # bmm is way more expensive. If we can avoid the pm@G bmm, that's huge\"'!\n    # But we need pmG, which IS a bmm... unless we compute it via lerp of p0G and p1G.\n    # Then we need p0@G bmm instead of pm@G bmm. Same cost!\n    # So no saving.\n    pass\n\nt_curr = bench(current_approach, n=50)\nprint(f'\"'Current approach (p_mix section): {t_curr:.3f} ms')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

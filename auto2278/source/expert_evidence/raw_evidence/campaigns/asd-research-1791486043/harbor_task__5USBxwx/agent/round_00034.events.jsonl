{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math, time\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C) * 0.1\nwk = torch.randn(H, D, C) * 0.1\n\ndef bench(fn, n=200, warmup=30):\n    for _ in range(warmup):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    return (t1 - t0) / n / 1e6\n\nHD = H * D\nBL = B * L\nxr = x.reshape(BL, C)\nwqr = wq.reshape(HD, C)\nwkr = wk.reshape(HD, C)\n\n# Current: xr @ wqr.T\nt_current = bench(lambda: xr @ wqr.T, n=300, warmup=50)\nprint(f'Current (A @ B.T): {t_current:.3f} ms')\n\n# Pre-transposed weight\nwqr_t = wqr.T.contiguous()\nt_pretransposed = bench(lambda: xr @ wqr_t, n=300, warmup=50)\nprint(f'Pre-transposed (A @ B): {t_pretransposed:.3f} ms, ratio: {t_current/t_pretransposed:.3f}')\n\n# What about x.T @ wq? Different shape, same computation\n# xr (BL, C) @ wqr.T (C, HD) = (BL, HD)\n# equivalently: wqr (HD, C) @ xr.T (C, BL) = (HD, BL) then .T\n# Just testing if there's a layout difference\nt_alt = bench(lambda: (wqr @ xr.T).T, n=200, warmup=30)\nprint(f'Alt (W @ x.T).T: {t_alt:.3f} ms, ratio: {t_current/t_alt:.3f}')\n\n# What about: can we compute both q and k with one bigger matmul?\n# We have 2 weight matrices each (HD, C). Total: (2*HD, C)\n# Output size (BL, 2*HD)\n# But we did this test before - fused was slower.\n# Why? Let me check more carefully.\n\nw_qk = torch.cat([wqr, wkr], dim=0)  # (2*HD, C)\nw_qk_t = w_qk.T.contiguous()  # (C, 2*HD)\n\ndef fused_qk():\n    out = xr @ w_qk_t  # (BL, 2*HD)\n    q = out[:, :HD]\n    k = out[:, HD:]\n    return q, k\n\ndef separate_qk():\n    q = xr @ wqr_t\n    k = xr @ wkr_t\n    return q, k\n\nwkr_t = wkr.T.contiguous()\n\nt_fused = bench(fused_qk, n=200, warmup=30)\nt_sep = bench(separate_qk, n=200, warmup=30)\nprint(f'\\\\\\\\nFused Q+K proj: {t_fused:.3f} ms')\nprint(f'Separate Q+K proj: {t_sep:.3f} ms')\nprint(f'Ratio (sep/fused): {t_sep/t_fused:.3f}')\n\n# Hmm the difference might be the cat itself. Let me pre-compute the weight and measure only matmul\nw_qk_t = w_qk.T.contiguous()\nt_fused_mm = bench(lambda: xr @ w_qk_t, n=300, warmup=50)\nt_sep_mm = bench(lambda: (xr @ wqr_t, xr @ wkr_t), n=300, warmup=50)\nprint(f'\\\\\\\\nFused matmul only: {t_fused_mm:.3f} ms')\nprint(f'Separate matmuls only: {t_sep_mm:.3f} ms')\nprint(f'Ratio (sep/fused): {t_sep_mm/t_fused_mm:.3f}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

_view = bench(proj_view)\nt_permute = bench(lambda: (xr @ wqr.T).view(B, L, H, D).permute(0, 2, 1, 3))\nt_contig = bench(lambda: (xr @ wqr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous())\n\nprint(f'Raw matmul: {t_raw:.3f} ms')\nprint(f'+ permute (non-contig): {t_permute:.3f} ms')\nprint(f'+ permute + contiguous: {t_contig:.3f} ms')\nprint(f'Full (with view BH): {t_full:.3f} ms')\nprint(f'Permute+contig overhead: {t_contig - t_raw:.3f} ms')\n\n# What if we do all 3 projections at once via a single (BL, C) @ (C, 3*HD)\n# but then split after?\n# Actually we already tested fused QKV and it was slower.\n# Let me test the overhead of the cat operation\ndef bench_fused_qkv():\n    w_qkv = torch.cat([wqr, wqr, wqr], dim=0)  # (3*HD, C)\n    out = xr @ w_qkv.T\n    q = out[:, :HD].view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    k = out[:, HD:2*HD].view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    v = out[:, 2*HD:].view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    return q, k, v\n\nt_fused = bench(bench_fused_qkv, n=100)\nprint(f'Fused QKV total (3 proj): {t_fused:.3f} ms')\nprint(f'Separate (3x single): {3*t_full:.3f} ms')\n\\\"\n\"","aggregated_output":"Raw matmul: 7.427 ms\n+ permute (non-contig): 6.929 ms\n+ permute + contiguous: 6.913 ms\nFull (with view BH): 6.939 ms\nPermute+contig overhead: -0.514 ms\nFused QKV total (3 proj): 22.964 ms\nSeparate (3x single): 20.816 ms\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math, time\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C) * 0.1\nwk = torch.randn(H, D, C) * 0.1\nwv = torch.randn(H, D, C) * 0.1\n\ndef bench(fn, n=200, warmup=30):\n    for _ in range(warmup):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    return (t1 - t0) / n / 1e6\n\nBH = B * H\nHD = H * D\nxr = x.reshape(B * L, C)\nwqr = wq.reshape(HD, C)\nwkr = wk.reshape(HD, C)\nwvr = wv.reshape(HD, C)\n\n# Just the raw matmuls\nt_q = bench(lambda: xr @ wqr.T, n=300, warmup=50)\nt_k = bench(lambda: xr @ wkr.T, n=300, warmup=50)\nt_v = bench(lambda: xr @ wvr.T, n=300, warmup=50)\nprint(f'Q raw: {t_q:.3f} ms')\nprint(f'K raw: {t_k:.3f} ms')\nprint(f'V raw: {t_v:.3f} ms')\nprint(f'Total: {t_q+t_k+t_v:.3f} ms')\n\n# What about: use torch.addmm? \n# addmm just does beta*mat + alpha*mat1@mat2, not helpful\n\n# What about: what if we could avoid separate projections altogether?\n# logits = q @ k\"'^T / sqrt(D) = (x@wq''^T) @ (x@wk''^T)''^T / sqrt(D)\n# = x @ wq''^T @ wk @ x''^T / sqrt(D)\n# Hmm, but per head. For each head:\n# logits[h] = x @ wq[h].T @ wk[h] @ x.T / sqrt(D)\n# = x @ W_qk[h] @ x.T where W_qk[h] = wq[h].T @ wk[h] / sqrt(D) (C x C)\n# That'\"'s C*C per head which is bigger than L*D+L*D+L*L when L*D*2+L*L < H*C*C+L*L*B\n# For case 4: L*D*2 + L*L = 256*64*2 + 256*256 = 32768 + 65536 = 98K per head (times H*B=20)\n# vs H*C*C = 20*1280*1280 = 32M (way bigger)\n# Not useful.\n\n# What about reordering: compute v = x @ wv\"'^T earlier and share memory? No...\n\n# Let me think about the softmax. Two softmax calls on similarly sized tensors.\n# For case 4, softmax is 2.7 + 5.2 (p1_logits + softmax) = ~8ms, which is significant.\n# Can we fuse them? No, different inputs.\n\n# What about logits computation? For case 4: 1.4ms, small compared to projections.\n\n# Let me look at the p1@G and pm@G bmms (12.6% + 12.7% = 25.3% of total).\n# Each is BH*L*L*L = 20*256*256*256 = 335M MACs\n# Can we reduce to just one?\n# We need both norm1 = ||p1@x|| and normm = ||pm@x||\n# pm = lerp(p0, p1, beta) = (1-beta)*p0 + beta*p1\n# ||pm@x||''^2 = (1-beta)''^2*||p0@x||''^2 + beta''^2*||p1@x||''^2 + 2*(1-beta)*beta * (p0@x) dot (p1@x)\n# Hmm, cross term still needs p0@G@p1''^T diagonal... not obviously cheaper\n\n# What about using v-space norms instead of x-space norms?\n# y = ratio * pm @ v, ratio = ||p1@x|| / ||pm@x||\n# But ||p1@x|| != ||p1@v||... not related\n\n# Wait, what if we compute output differently?\n# The spec says: u0 = P0 @ x, u1 = P1 @ x, m = u0 + beta*(u1-u0), r = clamp(||u1||/||m||, 0.25, 4.0)\n# Return (r * m) @ wv''^T = r * (m @ wv''^T)\n# \n# m @ wv''^T = (u0 + beta*(u1-u0)) @ wv''^T = (1-beta)*u0@wv''^T + beta*u1@wv''^T\n# = (1-beta)*(p0@x)@wv''^T + beta*(p1@x)@wv''^T\n# = (1-beta)*p0@(x@wv''^T) + beta*p1@(x@wv''^T)\n# = (1-beta)*p0@v + beta*p1@v\n# = pm @ v  (since pm = (1-beta)*p0 + beta*p1)\n# That'\"'s what we already do\"'! Good.\n# \n# For norms, we need ||p1@x|| and ||pm@x||\n# Currently using Gram method: ||p@x||''^2 = diag(p @ G @ p''^T) where G = x@x''^T\n# \n# Alternative: compute p0@x and p1@x (2 bmm of size BH*L*L*C = big), then norms are free\n# That'\"'s worse though...\n# \n# What if we use a smaller-rank approximation? No, must be exact.\n# \n# Let me think about G_tiled more carefully.\n# G is (B, L, L), we need to compute p@G for each of H heads.\n# Since G is same across heads, we're essentially doing H copies of the same bmm.\n# \n# For B=1: G is (1, L, L), p is (H, L, L)\n# We do (H, L, L) @ (H, L, L) bmm where each batch of G is the same.\n# This is H independent matmuls of size (L, L) @ (L, L).\n# \n# Could we use a different BLAS call shape that's more efficient?\n# What if we do: p reshaped to (H*L, L) @ G(L, L) -> (H*L, L) -> view (H, L, L)\n# Yes\"'! That'\"'s a regular 2D matmul instead of bmm.\n\nG = torch.bmm(x, x.transpose(1, 2))  # (B, L, L)\nG0 = G[0]  # (L, L)\n\np1_bh = torch.randn(BH, L, L)\npm_bh = torch.randn(BH, L, L)\n\n# Current: bmm approach\ndef bmm_approach(p):\n    G_tiled = G.unsqueeze(1).expand(B, H, L, L).reshape(BH, L, L).contiguous()\n    return torch.bmm(p, G_tiled)\n\n# New: 2D matmul approach for B=1\ndef matmul2d_approach(p):\n    # p: (BH, L, L), G: (L, L)\n    # result[b,i,j] = sum_k p[b,i,k] * G[k,j]\n    # = p.reshape(BH*L, L) @ G  -> (BH*L, L) -> view(BH, L, L)\n    return (p.reshape(BH * L, L) @ G[0]).view(BH, L, L)\n\n# Verify correctness\nr1 = bmm_approach(p1_bh)\nr2 = matmul2d_approach(p1_bh)\nprint(f'\\\\\\\\n2D matmul correctness: max diff = {(r1-r2).abs().max():.2e}')\n\nt_bmm = bench(lambda: bmm_approach(p1_bh), n=200)\nt_2d = bench(lambda: matmul2d_approach(p1_bh), n=200)\nprint(f'bmm approach: {t_bmm:.3f} ms')\nprint(f'2D matmul approach: {t_2d:.3f} ms, speedup: {t_bmm/t_2d:.3f}')\n\n# What about for B=2?\nB2 = 2\nBH2 = B2 * H\nG2 = torch.randn(B2, L, L)\np2 = torch.randn(BH2, L, L)\n\ndef bmm_approach_B(p):\n    G_tiled = G2.unsqueeze(1).expand(B2, H, L, L).reshape(BH2, L, L).contiguous()\n    return torch.bmm(p, G_tiled)\n\ndef matmul2d_approach_B(p):\n    # p: (BH, L, L) = (B*H, L, L)\n    # G: (B, L, L)\n    # For each batch b and head h: p[b*H+h] @ G[b]\n    # We can do: p.view(B, H*L, L) @ G  -> (B, H*L, L) -> view(B*H, L, L)\n    p_4d = p.view(B2, H * L, L)\n    result = torch.bmm(p_4d, G2)  # (B, H*L, L)\n    return result.view(BH2, L, L)\n\nr1 = bmm_approach_B(p2)\nr2 = matmul2d_approach_B(p2)\nprint(f'\\\\\\\\nB=2 correctness: max diff = {(r1-r2).abs().max():.2e}')\n\nt_bmm_b = bench(lambda: bmm_approach_B(p2), n=200)\nt_2d_b = bench(lambda: matmul2d_approach_B(p2), n=200)\nprint(f'bmm B=2: {t_bmm_b:.3f} ms')\nprint(f'2D bmm B=2: {t_2d_b:.3f} ms, speedup: {t_bmm_b/t_2d_b:.3f}')\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

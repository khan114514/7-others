t?\n# What if we do: p reshaped to (H*L, L) @ G(L, L) -> (H*L, L) -> view (H, L, L)\n# Yes\"'! That'\"'s a regular 2D matmul instead of bmm.\n\nG = torch.bmm(x, x.transpose(1, 2))  # (B, L, L)\nG0 = G[0]  # (L, L)\n\np1_bh = torch.randn(BH, L, L)\npm_bh = torch.randn(BH, L, L)\n\n# Current: bmm approach\ndef bmm_approach(p):\n    G_tiled = G.unsqueeze(1).expand(B, H, L, L).reshape(BH, L, L).contiguous()\n    return torch.bmm(p, G_tiled)\n\n# New: 2D matmul approach for B=1\ndef matmul2d_approach(p):\n    # p: (BH, L, L), G: (L, L)\n    # result[b,i,j] = sum_k p[b,i,k] * G[k,j]\n    # = p.reshape(BH*L, L) @ G  -> (BH*L, L) -> view(BH, L, L)\n    return (p.reshape(BH * L, L) @ G[0]).view(BH, L, L)\n\n# Verify correctness\nr1 = bmm_approach(p1_bh)\nr2 = matmul2d_approach(p1_bh)\nprint(f'\\\\\\\\n2D matmul correctness: max diff = {(r1-r2).abs().max():.2e}')\n\nt_bmm = bench(lambda: bmm_approach(p1_bh), n=200)\nt_2d = bench(lambda: matmul2d_approach(p1_bh), n=200)\nprint(f'bmm approach: {t_bmm:.3f} ms')\nprint(f'2D matmul approach: {t_2d:.3f} ms, speedup: {t_bmm/t_2d:.3f}')\n\n# What about for B=2?\nB2 = 2\nBH2 = B2 * H\nG2 = torch.randn(B2, L, L)\np2 = torch.randn(BH2, L, L)\n\ndef bmm_approach_B(p):\n    G_tiled = G2.unsqueeze(1).expand(B2, H, L, L).reshape(BH2, L, L).contiguous()\n    return torch.bmm(p, G_tiled)\n\ndef matmul2d_approach_B(p):\n    # p: (BH, L, L) = (B*H, L, L)\n    # G: (B, L, L)\n    # For each batch b and head h: p[b*H+h] @ G[b]\n    # We can do: p.view(B, H*L, L) @ G  -> (B, H*L, L) -> view(B*H, L, L)\n    p_4d = p.view(B2, H * L, L)\n    result = torch.bmm(p_4d, G2)  # (B, H*L, L)\n    return result.view(BH2, L, L)\n\nr1 = bmm_approach_B(p2)\nr2 = matmul2d_approach_B(p2)\nprint(f'\\\\\\\\nB=2 correctness: max diff = {(r1-r2).abs().max():.2e}')\n\nt_bmm_b = bench(lambda: bmm_approach_B(p2), n=200)\nt_2d_b = bench(lambda: matmul2d_approach_B(p2), n=200)\nprint(f'bmm B=2: {t_bmm_b:.3f} ms')\nprint(f'2D bmm B=2: {t_2d_b:.3f} ms, speedup: {t_bmm_b/t_2d_b:.3f}')\n\\\" 2>&1\n\"","aggregated_output":"Q raw: 6.663 ms\nK raw: 6.630 ms\nV raw: 6.684 ms\nTotal: 19.976 ms\n\n2D matmul correctness: max diff = 0.00e+00\nbmm approach: 6.141 ms\n2D matmul approach: 5.869 ms, speedup: 1.046\n\nB=2 correctness: max diff = 0.00e+00\nbmm B=2: 12.173 ms\n2D bmm B=2: 10.340 ms, speedup: 1.177\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_21","type":"agent_message","text":"Good finds — 2D matmul approach for Gram norms is faster (4.6% for B=1, 17.7% for B=2). Let me now implement a full optimized version and run a quick end-to-end test before the full evaluation.\n"}}
{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math, time\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\ndef attention_v1(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BH = B * H\n    xr = x.reshape(B * L, C)\n    wqr = wq.reshape(HD, C)\n    wkr = wk.reshape(HD, C)\n    wvr = wv.reshape(HD, C)\n    q = (xr @ wqr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    k = (xr @ wkr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    q.mul_(inv_sqrt_d)\n    logits = torch.bmm(q, k.transpose(1, 2))\n    p0 = logits.softmax(dim=-1)\n    if alpha == 1.0:\n        v = (xr @ wvr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n        y = torch.bmm(p0, v)\n    else:\n        a_p = 0.5 + 0.5 * alpha\n        a_m = 0.5 - 0.5 * alpha\n        p1_logits = logits.mul(a_p).add_(logits.transpose(1, 2), alpha=a_m)\n        p1 = p1_logits.softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        G = torch.bmm(x, x.transpose(1, 2))\n        G_tiled = G.unsqueeze(1).expand(B, H, L, L).reshape(BH, L, L)\n        p1G = torch.bmm(p1, G_tiled)\n        norm1 = p1G.mul_(p1).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n        pmG = torch.bmm(p_mix, G_tiled)\n        normm = pmG.mul_(p_mix).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n        v = (xr @ wvr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n        y = torch.bmm(p_mix, v).mul_(ratio)\n    return y.view(B, H, L, D).transpose(1, 2).flatten(2).contiguous()\n\ndef attention_v2(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BH = B * H\n    HLL = H * L * L\n\n    xr = x.reshape(B * L, C)\n    wqr = wq.reshape(HD, C)\n    wkr = wk.reshape(HD, C)\n    wvr = wv.reshape(HD, C)\n\n    q = (xr @ wqr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    k = (xr @ wkr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    q.mul_(inv_sqrt_d)\n\n    logits = torch.bmm(q, k.transpose(1, 2))\n    p0 = logits.softmax(dim=-1)\n\n    if alpha == 1.0:\n        v = (xr @ wvr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n        y = torch.bmm(p0, v)\n    else:\n        a_p = 0.5 + 0.5 * alpha\n        a_m = 0.5 - 0.5 * alpha\n        p1_logits = logits.mul(a_p).add_(logits.transpose(1, 2), alpha=a_m)\n        p1 = p1_logits.softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n\n        # 2D matmul approach for p@G norms\n        G = torch.bmm(x, x.transpose(1, 2))  # (B, L, L)\n        # p reshaped to (B, H*L, L) @ G -> (B, H*L, L) -> view(BH, L, L)\n        p1_3d = p1.view(B, H * L, L)\n        pm_3d = p_mix.view(B, H * L, L)\n        p1G = torch.bmm(p1_3d, G).view(BH, L, L)\n        pmG = torch.bmm(pm_3d, G).view(BH, L, L)\n\n        norm1 = p1G.mul_(p1).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n        normm = pmG.mul_(p_mix).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n\n        v = (xr @ wvr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n        y = torch.bmm(p_mix, v).mul_(ratio)\n\n    return y.view(B, H, L, D).transpose(1, 2).flatten(2).contiguous()\n\n# Test all cases\ncases = [\n    (1, 64, 512, 8, 64, 1.05, 5.0, 'Case 1'),\n    (1, 128, 640, 10, 64, 1.1, 4.0, 'Case 2'),\n    (1, 128, 1280, 20, 64, 1.15, 3.0, 'Case 3'),\n    (1, 256, 1280, 20, 64, 1.05, 7.5, 'Case 4'),\n    (1, 256, 640, 10, 64, 1.2, 5.0, 'Case 5'),\n    (2, 128, 512, 8, 64, 1.0, 5.0, 'Case 6 (alpha=1)'),\n]\n\nprint('Numerical verification:')\nall_ok = True\nfor B, L, C, H, D, alpha, beta, name in cases:\n    torch.manual_seed(101 * 1009 + hash(name) % 100)\n    x = torch.randn(B, L, C)\n    wq = torch.randn(H, D, C) * 0.1\n    wk = torch.randn(H, D, C) * 0.1\n    wv = torch.randn(H, D, C) * 0.1\n    y1 = attention_v1(x, wq, wk, wv, alpha, beta)\n    y2 = attention_v2(x, wq, wk, wv, alpha, beta)\n    diff = (y1 - y2).abs()\n    reldiff = diff / y1.abs().clamp_min(1e-8)\n    atol = diff.max().item()\n    rtol = reldiff.max().item()\n    ok = atol <= 3e-5 + 3e-4 * y1.abs().max().item()\n    all_ok = all_ok and ok\n    status = 'OK' if ok else 'FAIL'\n    print(f'  {name}: atol={atol:.2e}, rtol={rtol:.2e} [{status}]')\n\nprint(f'\\\\\\\\nAll pass: {all_ok}')\n\n# Timing comparison\nprint('\\\\\\\\nTiming (ms, median of 31):')\ndef bench(fn, args, n=31, warmup=5):\n    for _ in range(warmup):\n        fn(*args)\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn(*args)\n        t1 = time.process_time_ns()\n        times.append((t1 - t0) / 1e6)\n    times.sort()\n    return times[len(times)//2]\n\nspeedups = []\nfor B, L, C, H, D, alpha, beta, name in cases:\n    torch.manual_seed(42)\n    x = torch.randn(B, L, C)\n    wq = torch.randn(H, D, C) * 0.1\n    wk = torch.randn(H, D, C) * 0.1\n    wv = torch.randn(H, D, C) * 0.1\n    args = (x, wq, wk, wv, alpha, beta)\n    t1 = bench(attention_v1, args, n=21, warmup=3)\n    t2 = bench(attention_v2, args, n=21, warmup=3)\n    sp = t1 / t2\n    speedups.append(sp)\n    print(f'  {name}: v1={t1:.3f}ms, v2={t2:.3f}ms, speedup={sp:.3f}')\n\nimport statistics\nprint(f'\\\\\\\\nMean speedup: {statistics.mean(speedups):.3f}')\nprint(f'Min speedup: {min(speedups):.3f}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math, time\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\ndef attention_v1(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BH = B * H\n    xr = x.reshape(B * L, C)\n    wqr = wq.reshape(HD, C)\n    wkr = wk.reshape(HD, C)\n    wvr = wv.reshape(HD, C)\n    q = (xr @ wqr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    k = (xr @ wkr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    q.mul_(inv_sqrt_d)\n    logits = torch.bmm(q, k.transpose(1, 2))\n    p0 = logits.softmax(dim=-1)\n    if alpha == 1.0:\n        v = (xr @ wvr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n        y = torch.bmm(p0, v)\n    else:\n        a_p = 0.5 + 0.5 * alpha\n        a_m = 0.5 - 0.5 * alpha\n        p1_logits = logits.mul(a_p).add_(logits.transpose(1, 2), alpha=a_m)\n        p1 = p1_logits.softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        G = torch.bmm(x, x.transpose(1, 2))\n        G_tiled = G.unsqueeze(1).expand(B, H, L, L).reshape(BH, L, L)\n        p1G = torch.bmm(p1, G_tiled)\n        norm1 = p1G.mul_(p1).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n        pmG = torch.bmm(p_mix, G_tiled)\n        normm = pmG.mul_(p_mix).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n        v = (xr @ wvr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n        y = torch.bmm(p_mix, v).mul_(ratio)\n    return y.view(B, H, L, D).transpose(1, 2).flatten(2).contiguous()\n\ndef attention_v2(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BH = B * H\n    HLL = H * L * L\n\n    xr = x.reshape(B * L, C)\n    wqr = wq.reshape(HD, C)\n    wkr = wk.reshape(HD, C)\n    wvr = wv.reshape(HD, C)\n\n    q = (xr @ wqr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    k = (xr @ wkr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    q.mul_(inv_sqrt_d)\n\n    logits = torch.bmm(q, k.transpose(1, 2))\n    p0 = logits.softmax(dim=-1)\n\n    if alpha == 1.0:\n        v = (xr @ wvr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n        y = torch.bmm(p0, v)\n    else:\n        a_p = 0.5 + 0.5 * alpha\n        a_m = 0.5 - 0.5 * alpha\n        p1_logits = logits.mul(a_p).add_(logits.transpose(1, 2), alpha=a_m)\n        p1 = p1_logits.softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n\n        # 2D matmul approach for p@G norms\n        G = torch.bmm(x, x.transpose(1, 2))  # (B, L, L)\n        # p reshaped to (B, H*L, L) @ G -> (B, H*L, L) -> view(BH, L, L)\n        p1_3d = p1.view(B, H * L, L)\n        pm_3d = p_mix.view(B, H * L, L)\n        p1G = torch.bmm(p1_3d, G).view(BH, L, L)\n        pmG = torch.bmm(pm_3d, G).view(BH, L, L)\n\n        norm1 = p1G.mul_(p1).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n        normm = pmG.mul_(p_mix).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n\n        v = (xr @ wvr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n        y = torch.bmm(p_mix, v).mul_(ratio)\n\n    return y.view(B, H, L, D).transpose(1, 2).flatten(2).contiguous()\n\n# Test all cases\ncases = [\n    (1, 64, 512, 8, 64, 1.05, 5.0, 'Case 1'),\n    (1, 128, 640, 10, 64, 1.1, 4.0, 'Case 2'),\n    (1, 128, 1280, 20, 64, 1.15, 3.0, 'Case 3'),\n    (1, 256, 1280, 20, 64, 1.05, 7.5, 'Case 4'),\n    (1, 256, 640, 10, 64, 1.2, 5.0, 'Case 5'),\n    (2, 128, 512, 8, 64, 1.0, 5.0, 'Case 6 (alpha=1)'),\n]\n\nprint('Numerical verification:')\nall_ok = True\nfor B, L, C, H, D, alpha, beta, name in cases:\n    torch.manual_seed(101 * 1009 + hash(name) % 100)\n    x = torch.randn(B, L, C)\n    wq = torch.randn(H, D, C) * 0.1\n    wk = torch.randn(H, D, C) * 0.1\n    wv = torch.randn(H, D, C) * 0.1\n    y1 = attention_v1(x, wq, wk, wv, alpha, beta)\n    y2 = attention_v2(x, wq, wk, wv, alpha, beta)\n    diff = (y1 - y2).abs()\n    reldiff = diff / y1.abs().clamp_min(1e-8)\n    atol = diff.max().item()\n    rtol = reldiff.max().item()\n    ok = atol <= 3e-5 + 3e-4 * y1.abs().max().item()\n    all_ok = all_ok and ok\n    status = 'OK' if ok else 'FAIL'\n    print(f'  {name}: atol={atol:.2e}, rtol={rtol:.2e} [{status}]')\n\nprint(f'\\\\\\\\nAll pass: {all_ok}')\n\n# Timing comparison\nprint('\\\\\\\\nTiming (ms, median of 31):')\ndef bench(fn, args, n=31, warmup=5):\n    for _ in range(warmup):\n        fn(*args)\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn(*args)\n        t1 = time.process_time_ns()\n        times.append((t1 - t0) / 1e6)\n    times.sort()\n    return times[len(times)//2]\n\nspeedups = []\nfor B, L, C, H, D, alpha, beta, name in cases:\n    torch.manual_seed(42)\n    x = torch.randn(B, L, C)\n    wq = torch.randn(H, D, C) * 0.1\n    wk = torch.randn(H, D, C) * 0.1\n    wv = torch.randn(H, D, C) * 0.1\n    args = (x, wq, wk, wv, alpha, beta)\n    t1 = bench(attention_v1, args, n=21, warmup=3)\n    t2 = bench(attention_v2, args, n=21, warmup=3)\n    sp = t1 / t2\n    speedups.append(sp)\n    print(f'  {name}: v1={t1:.3f}ms, v2={t2:.3f}ms, speedup={sp:.3f}')\n\nimport statistics\nprint(f'\\\\\\\\nMean speedup: {statistics.mean(speedups):.3f}')\nprint(f'Min speedup: {min(speedups):.3f}')\n\\\"\n\"","aggregated_output":"Numerical verification:\n  Case 1: atol=0.00e+00, rtol=0.00e+00 [OK]\n  Case 2: atol=0.00e+00, rtol=0.00e+00 [OK]\n  Case 3: atol=0.00e+00, rtol=0.00e+00 [OK]\n  Case 4: atol=0.00e+00, rtol=0.00e+00 [OK]\n  Case 5: atol=0.00e+00, rtol=0.00e+00 [OK]\n  Case 6 (alpha=1): atol=0.00e+00, rtol=0.00e+00 [OK]\n\nAll pass: True\n\nTiming (ms, median of 31):\n  Case 1: v1=1.500ms, v2=1.448ms, speedup=1.036\n  Case 2: v1=5.089ms, v2=4.851ms, speedup=1.049\n  Case 3: v1=14.914ms, v2=14.685ms, speedup=1.016\n  Case 4: v1=43.061ms, v2=41.043ms, speedup=1.049\n  Case 5: v1=15.993ms, v2=15.575ms, speedup=1.027\n  Case 6 (alpha=1): v1=4.392ms, v2=4.410ms, speedup=0.996\n\nMean speedup: 1.029\nMin speedup: 0.996\n","exit_code":0,"status":"completed"}}

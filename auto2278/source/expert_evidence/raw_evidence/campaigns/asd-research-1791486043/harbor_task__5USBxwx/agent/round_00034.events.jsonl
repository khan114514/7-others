{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/sh -lc 'cd /workspace && python3 -c \"\nimport torch, math, time\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n# Case 4 (biggest)\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C) * 0.1\nwk = torch.randn(H, D, C) * 0.1\nwv = torch.randn(H, D, C) * 0.1\n\ndef bench(fn, n=200, warmup=20):\n    for _ in range(warmup):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    return (t1 - t0) / n / 1e6\n\nBH = B * H\nHD = H * D\nxr = x.reshape(B * L, C)\nwqr = wq.reshape(HD, C)\nwkr = wk.reshape(HD, C)\nwvr = wv.reshape(HD, C)\n\n# IDEA: Can we compute the Q/K projections differently to reduce permute+contiguous overhead?\n# Currently: (xr @ wqr.T) shape (B*L, H*D) -> view(B,L,H,D) -> permute(0,2,1,3) -> contiguous -> view(BH, L, D)\n# \n# What if we pre-transpose the weights differently?\n# wq shape (H, D, C). We want q[b,h,l,d] = sum_c x[b,l,c] * wq[h,d,c]\n# \n# If we reshape wq to (H, D, C) and then to (H*D, C) and compute x.reshape(BL, C) @ wqr.T\n# we get (BL, HD) which is [l0h0d0, l0h0d1, ..., l0h0dD-1, l0h1d0, ...]\n# No wait, the memory layout depends on the reshape.\n# wq.reshape(HD, C): memory is h0d0c0, h0d0c1, ..., h0d0cC-1, h0d1c0, ..., h0dD-1cC-1, h1d0c0, ...\n# So wqr.T is (C, HD), and x @ wqr.T gives (BL, HD) where the HD dim varies d fastest, then h.\n# So result[l, h*D+d] = q value for token l, head h, dim d.\n# \n# view(B, L, H, D) gives: indexing [b, l, h, d] matches correctly.\n# But we need (B, H, L, D) layout contiguous for bmm.\n# \n# Can we rearrange wq so that x @ w_new gives us data in the right order directly?\n# If we want output (BL, HD) where memory varies H first then D... no, we need (BH, L, D)\n# \n# What if we compute q as (B, H, L, D) directly?\n# For each head h, q[b,h] = x[b] @ wq[h].T = x[b] @ wq_h''^T  where wq_h is (D, C)\n# So q[b,h] has shape (L, D). Across H heads: (H, L, D) per batch.\n# \n# We can compute x.reshape(B, L, C) @ wq.reshape(H, C, D).permute(0, 2, 1)? No...\n# q[h] = x @ wq[h].T  for each head h\n# Stacked: if we have (H, C, D) weight and do bmm with broadcast...\n# x is (B, L, C), weight is (H, C, D)\n# We want per-head: (B, L, C) @ (C, D) -> (B, L, D), across H heads -> (B, H, L, D)\n# \n# torch.einsum('\"'blc,hdc->bhld', x, wq) does this but slow.\n# \n# What about: reshape x to (1, B*L, C), repeat weight to (H, C, D)? No...\n# Actually: x (B*L, C) @ wq_weight (C, H*D) -> (B*L, H*D) \n# = what we already have. The permute to BH layout is the issue.\n# \n# Alternative: can we do logits with a different q, k layout?\n# logits[b,h,i,j] = sum_d q[b,h,i,d] * k[b,h,j,d]\n# = q[b,h] @ k[b,h].T\n# \n# If q is stored as (B, L, H, D), then q[:, :, h, :] is (B, L, D) per head h.\n# For bmm, we'd need each batch to be one head.\n# \n# What if we use einops-style rearrangement differently?\n# \n# Wait - let me try: can we compute logits using einsum on already-projected data?\n# q in (B, L, H, D) layout. k in (B, L, H, D) layout.\n# logits = torch.einsum('bihd,bjhd->bhij', q, k)\n# Is this faster than permute + bmm?\n\nq_blhd = (xr @ wqr.T).view(B, L, H, D)\nk_blhd = (xr @ wkr.T).view(B, L, H, D)\ninv_sqrt_d = 1.0 / math.sqrt(D)\n\n# Method 1: current (permute + bmm)\ndef logits_via_bmm():\n    q = q_blhd.permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    k = k_blhd.permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    q.mul_(inv_sqrt_d)\n    return torch.bmm(q, k.transpose(1, 2))\n\n# Method 2: einsum\ndef logits_via_einsum():\n    q = q_blhd * inv_sqrt_d\n    return torch.einsum('bihd,bjhd->bhij', q, k_blhd)\n\nr1 = logits_via_bmm()\nr2 = logits_via_einsum()\nprint(f'Logits match: {(r1 - r2.view_as(r1)).abs().max():.2e}')\n\nt1 = bench(logits_via_bmm, n=100)\nt2 = bench(logits_via_einsum, n=50)\nprint(f'Via BMM: {t1:.3f} ms')\nprint(f'Via einsum: {t2:.3f} ms, ratio: {t1/t2:.3f}')\n\n# Wait, einsum includes the q scaling too. Let me fair compare.\ndef logits_via_bmm_withscale():\n    q = q_blhd.permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    k = k_blhd.permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    q = q * inv_sqrt_d\n    return torch.bmm(q, k.transpose(1, 2))\n\nt1b = bench(logits_via_bmm_withscale, n=100)\nprint(f'\\\\\\\\nVia BMM (fair): {t1b:.3f} ms')\nprint(f'Via einsum: {t2:.3f} ms, ratio: {t1b/t2:.3f}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

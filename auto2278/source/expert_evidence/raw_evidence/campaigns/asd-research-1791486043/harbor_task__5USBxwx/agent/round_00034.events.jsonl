{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/sh -lc 'cd /workspace && python3 -c \"\nimport torch, math, time\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n# Focus on the biggest case\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C) * 0.1\nwk = torch.randn(H, D, C) * 0.1\nwv = torch.randn(H, D, C) * 0.1\n\ndef bench(fn, n=100, warmup=20):\n    for _ in range(warmup):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    return (t1 - t0) / n / 1e6\n\nBH = B * H\nHD = H * D\nHL = H * L\nxr = x.reshape(B * L, C)\nwqr = wq.reshape(HD, C)\nwkr = wk.reshape(HD, C)\nwvr = wv.reshape(HD, C)\n\ninv_sqrt_d = 1.0 / math.sqrt(D)\n\n# Full current version\ndef attn_current():\n    q = (xr @ wqr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    k = (xr @ wkr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    q.mul_(inv_sqrt_d)\n    logits = torch.bmm(q, k.transpose(1, 2))\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 + 0.5 * alpha\n    a_m = 0.5 - 0.5 * alpha\n    p1_logits = logits.mul(a_p).add_(logits.transpose(1, 2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = torch.bmm(x, x.transpose(1, 2))\n    p1G = torch.bmm(p1.view(B, HL, L), G).view(BH, L, L)\n    pmG = torch.bmm(p_mix.view(B, HL, L), G).view(BH, L, L)\n    norm1 = p1G.mul_(p1).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    normm = pmG.mul_(p_mix).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    v = (xr @ wvr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    y = torch.bmm(p_mix, v).mul_(ratio)\n    return y.view(B, H, L, D).transpose(1, 2).flatten(2).contiguous()\n\n# IDEA: Can we avoid materializing p1_logits by doing the softmax differently?\n# No, softmax needs the full tensor.\n\n# IDEA: Can we compute G earlier (during projections) to overlap memory/compute?\n# No, single-threaded.\n\n# IDEA: What if we compute v projection earlier and use it for norms too?\n# v = x @ wv''^T. We need ||p@x|| not ||p@v||. Not directly useful.\n\n# IDEA: The permute+contiguous for Q,K,V projections. Is there a way to avoid it?\n# We did the analysis and it'\"'s already optimal.\n\n# IDEA: Can we do the output projection (y @ wv\"'^T) differently?\n# Currently: compute y = p_mix @ v (in BH, L, D space), then reshape back.\n# y shape: (BH, L, D). We reshape to (B,H,L,D) -> (B,L,H,D) -> (B,L,H*D).\n# Wait, we compute y = p_mix @ v where v is (BH, L, D).\n# The output is y reshaped back to (B, L, H*D).\n# \n# Alternative: don'\"'t permute v to head-first. Keep v in (B, L, H, D) layout.\n# Then we need: output[b, l, h, d] = sum_j p_mix[b, h, l, j] * v[b, j, h, d]\n# = einsum('bhij,bjhd->bilhd')  -- messy\n# \n# Our current approach with bmm (BH, L, L) @ (BH, L, D) is optimal for BLAS.\n\n# IDEA: What if we compute p_mix @ v using the 2D matmul trick like Gram?\n# p_mix: (BH, L, L), v: (BH, L, D)\n# bmm: (BH, L, L) @ (BH, L, D) = (BH, L, D)\n# This is BH independent (L, L) @ (L, D) matmuls.\n# \n# 2D approach: reshape p_mix to (BH*L, L), v to (L, D)... no, v varies per head.\n# Can't use 2D matmul trick here since v differs per head.\n\n# IDEA: Can we compute output in a different order to save ops?\n# Current: p_mix (BH, L, L) @ v (BH, L, D) -> y (BH, L, D)\n# \n# Also valid: y[b,h,l,:] = v_permuted[b,h,:,:].T @ p_mix[b,h,l,:].T\n# No, that's same thing.\n\n# IDEA: What about computing y in original x space and projecting at the end?\n# um = p_mix @ x (in x-space), then output = um @ wv\"'^T\n# Cost: p_mix @ x: BH*L*L*C = big. That'\"'s why we use Gram for norms.\n# For case 4: BH*L*L*C = 20*256*256*1280 = 1.68B vs pm@v: 20*256*256*64 = 84M\n# Much worse.\n\n# IDEA: Can we compute normm differently using p0 and p1 separately?\n# ||m||\"'^2 = ||(1-b)p0@x + b p1@x||''^2 \n# = (1-b)''^2 * ||p0@x||''^2 + b''^2 * ||p1@x||''^2 + 2(1-b)b * (p0@x) dot (p1@x)\n# The cross term needs <p0@x, p1@x> per position = diag(p0 @ G @ p1''^T)\n# = (p0 * (p1@G)).sum(-1) = same element pattern.\n# \n# So we'\"'d need: p0@G, p1@G, and then compute norms via formulas.\n# Same number of bmm calls (2), plus more elementwise ops. Not better.\n\n# Let me think about memory allocation overhead.\n# For a 44ms function, how much is allocator overhead?\n# Let's try pre-allocating and using out= parameters\n\n# Actually, let me try a completely different idea:\n# Can we compute v from k somehow? No, different weights.\n\n# What about: using float64 for better precision? No, would be slower.\n\n# Let me try one concrete idea: fuse the v-projection with the output matmul\n# by not permuting v to head-first layout, but using a different formulation\n# \n# v in (B, L, H, D). We want: output[b,l,h,d] = sum_j p[b,h,l,j] * v[b,j,h,d]\n# \n# Reshape: p (BH, L, L), v (BH, L, D) -- this is what we do.\n# Cost of permuting v to BH layout: ~7ms (same as projection)\n# \n# Wait - we already compute v projection in ~7ms, which includes the permute.\n# Actually the projection itself is the cost.\n\n# Let me try: compute v projection and output in one step via a different formula\n# output[b,h,l,d] = sum_j p[b,h,l,j] * sum_c x[b,j,c] * wv[h,d,c]\n# = sum_c sum_j p[b,h,l,j] * x[b,j,c] * wv[h,d,c]\n# = sum_c (sum_j p[b,h,l,j] * x[b,j,c]) * wv[h,d,c]\n# = sum_c u[b,h,l,c] * wv[h,d,c]  where u = p@x\n# \n# For each head: u[h] (L, C) @ wv[h].T (C, D) = (L, D)\n# Stacked: (BH, L, C) @ (BH, C, D) -> (BH, L, D) via bmm\n# But we'd need u = p_mix @ x_tiled which is BH*L*L*C = 1.68B (case 4)\n# vs current: v_proj (BLC * HD = 420M) + pm@v (BH*L*L*D = 84M) = 504M\n# Current approach is much better.\n\n# OK let me try one more thing: can we avoid the contiguous() call on the output?\n# y.view(B, H, L, D).transpose(1, 2).flatten(2).contiguous()\n# Maybe there's a way to produce the output in the right layout directly.\n\n# Actually let me check: what's the cost of the final reshape?\ny_t = attn_current()\nt_final = bench(lambda: y_t.clone().view(B, H, L, D).transpose(1, 2).flatten(2).contiguous(), n=500)\nprint(f'Final reshape cost: {t_final*1000:.1f} us')\n\n# Negligible. Let me focus on something bigger.\n\n# What about: the permute+contiguous after Q/K/V projection?\nq_raw = xr @ wqr.T\nt_perm = bench(lambda: q_raw.view(B, L, H, D).permute(0, 2, 1, 3).contiguous(), n=200)\nt_perm_view = bench(lambda: q_raw.view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D), n=200)\nprint(f'Q perm+contig: {t_perm*1000:.1f} us')\nprint(f'Q perm+contig+view: {t_perm_view*1000:.1f} us')\nprint(f'Projection total: {bench(lambda: xr @ wqr.T, n=200)*1000:.1f} us')\n\n# What fraction of projection time is the matmul vs permute?\n# Matmul: 6.6ms, permute+contig: ? \n# Total projection: ~6.9ms, so perm is ~0.3ms = 4.5% of projection cost.\n# Not huge.\n\n# IDEA: Can we compute softmax more efficiently by using log_softmax then exp?\n# Let's check... probably not.\n\n# IDEA: Fused softmax of p0 and p1? No, different inputs.\n\n# IDEA: What if we skip computing p0 fully and just compute p1 and p_mix?\n# Wait, we NEED p0 for p_mix = lerp(p0, p1, beta)\n# And p0 = softmax(logits). So we need both softmaxes.\n\n# What if alpha is close to 1? Then p1 ≈ p0. But alpha varies.\n\n# Let me think about the most impactful thing to try.\n# The projections are ~45% of total time. Softmax ~18%. Gram bmms ~25%.\n# Projections are hard to optimize further (BLAS is already optimal).\n# \n# Wait - what about using torch.nn.functional.linear?\n# linear(x, w) does x @ w.T + bias. Same as our matmul.\n# Probably same speed.\n\n# Actually, wait. Let me try something: use 4D tensor with matmul for Q/K/V projection\n# and see if there's a batch matrix multiply approach that's faster.\n# \n# x (B, L, C), wq (H, D, C)\n# If we reshape wq to (H, C, D) and expand x to (H, B*L, C)... no, too much memory.\n\n# Let me just try a couple more micro-optimizations:\n# 1. Remove all .contiguous() calls that aren't needed\n# 2. Use .mul_().add_() chains more aggressively\n# 3. Precompute a_p_half etc.\n\n# Actually - one important question: does logits.transpose(1,2) create a copy?\n# Let me check if it's a view.\nlogits = torch.randn(BH, L, L)\nlt = logits.transpose(1, 2)\nprint(f'\\\\\\\\nlogits.transpose is view: {lt.data_ptr() == logits.data_ptr()}')\nprint(f'logits.transpose is contiguous: {lt.is_contiguous()}')\n\n# bmm should accept non-contiguous input.\nt1 = bench(lambda: torch.bmm(q, k.transpose(1, 2)), n=200)\nk_contig = k.transpose(1, 2).contiguous()\nt2 = bench(lambda: torch.bmm(q, k_contig), n=200)\nprint(f'bmm with non-contig k: {t1:.3f} ms')\nprint(f'bmm with contig k: {t2:.3f} ms')\n\nq_bh = (xr @ wqr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\nk_bh = (xr @ wkr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\nq_bh.mul_(inv_sqrt_d)\nlogits_test = torch.bmm(q_bh, k_bh.transpose(1, 2))\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math, time\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C) * 0.1\nwk = torch.randn(H, D, C) * 0.1\nwv = torch.randn(H, D, C) * 0.1\n\ndef bench(fn, n=200, warmup=20):\n    for _ in range(warmup):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    return (t1 - t0) / n / 1e6\n\nBH = B * H\nHD = H * D\nxr = x.reshape(B * L, C)\n\n# Idea: compute Q and K with a single einsum-like operation that keeps heads in batch dim\n# by reshaping x and weights appropriately\n\n# Current: 3 independent projections with permute to head-first\nwqr = wq.reshape(HD, C)\nwkr = wk.reshape(HD, C)\nwvr = wv.reshape(HD, C)\n\n# Alternative approach: reshape weight to (H, C, D) and compute per-head\n# x (B, L, C), wq (H, C, D) -> we want (B, H, L, D)\n# This is: for each h: x @ wq[h]  -> (B, L, D) stacked to (B, H, L, D)\n\n# Can we do this with bmm by expanding x?\n# x_expanded: (B*H, L, C) = x.unsqueeze(1).expand(B, H, L, C).reshape(BH, L, C)\n# wq_reshaped: (BH, C, D) = wq.permute(0, 2, 1).reshape(HD, C)... no\n# wq is (H, D, C). We want per-head: x[b] @ wq[h].T = x[b] @ (D, C).T = (L, C) @ (C, D) = (L, D)\n# If wq reshaped to (H, C, D), then x @ wq[h] gives (L, D)\n\nwq_hcd = wq.permute(0, 2, 1).contiguous()  # (H, C, D)\nwk_hcd = wk.permute(0, 2, 1).contiguous()\nwv_hcd = wv.permute(0, 2, 1).contiguous()\n\n# Approach A: bmm with expanded x\ndef proj_expand_bmm(w_hcd):\n    x_exp = x.unsqueeze(1).expand(B, H, L, C).reshape(BH, L, C)\n    w_bmm = w_hcd.unsqueeze(0).expand(B, H, C, D).reshape(BH, C, D)\n    return torch.bmm(x_exp, w_bmm)  # (BH, L, D)\n\nt_expand = bench(lambda: proj_expand_bmm(wq_hcd), n=50)\nprint(f'Expand+BMM projection: {t_expand:.3f} ms')\n\n# Current approach\ndef proj_current():\n    q = (xr @ wqr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    return q\n\nt_current = bench(proj_current, n=100)\nprint(f'Current projection: {t_current:.3f} ms')\nprint(f'Ratio: {t_expand / t_current:.3f}')\n\n# That's probably slower due to expand + reshape overhead.\n# What about: 4D matmul: x (B, 1, L, C) @ wq (1, H, C, D) -> (B, H, L, D)\ndef proj_4dmatmul(w_hcd):\n    # x: (B, L, C) -> (B, 1, L, C)\n    # w: (H, C, D) -> (1, H, C, D)\n    # result: (B, H, L, D)\n    return x.unsqueeze(1) @ w_hcd.unsqueeze(0)\n\nt_4d = bench(lambda: proj_4dmatmul(wq_hcd), n=30)\nprint(f'4D matmul projection: {t_4d:.3f} ms, ratio: {t_current/t_4d:.3f}')\n\n# Check correctness\nq_current = proj_current()\nq_4d = proj_4dmatmul(wq_hcd).view(BH, L, D)\nprint(f'4D vs current match: {(q_current - q_4d).abs().max():.2e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/sh -lc 'cd /workspace && python3 -c \"\nimport torch, math, time\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n# Case 4: largest L and C combo\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C) * 0.1\nwk = torch.randn(H, D, C) * 0.1\nwv = torch.randn(H, D, C) * 0.1\n\n# Current best approach (v1)\ndef attention_v1(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BH = B * H\n    xr = x.reshape(B * L, C)\n    wqr = wq.reshape(HD, C)\n    wkr = wk.reshape(HD, C)\n    wvr = wv.reshape(HD, C)\n    q = (xr @ wqr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    k = (xr @ wkr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    q.mul_(inv_sqrt_d)\n    logits = torch.bmm(q, k.transpose(1, 2))\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 + 0.5 * alpha\n    a_m = 0.5 - 0.5 * alpha\n    p1_logits = logits.mul(a_p).add_(logits.transpose(1, 2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = torch.bmm(x, x.transpose(1, 2))\n    G_tiled = G.unsqueeze(1).expand(B, H, L, L).reshape(BH, L, L)\n    p1G = torch.bmm(p1, G_tiled)\n    norm1 = p1G.mul_(p1).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    pmG = torch.bmm(p_mix, G_tiled)\n    normm = pmG.mul_(p_mix).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    v = (xr @ wvr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    y = torch.bmm(p_mix, v).mul_(ratio)\n    return y.view(B, H, L, D).transpose(1, 2).flatten(2).contiguous()\n\n# Idea: compute u = p@x via bmm with expanded x, then compute norms as u.norm()\n# But instead of the Gram approach, what if we compute u1 and um directly and reuse?\n# Cost analysis for case 4: B=1, L=256, C=1280, H=20, D=64\n# Current Gram: p1@G_tiled (BH*L*L''^2=20*256*256=1.3M MACs?), no...\n# bmm with shapes (BH, L, L) @ (BH, L, L) = BH*L*L*L = 20*256*256*256 = 335M\n# p_mix@G_tiled: another 335M\n# v_proj: B*L*C*H*D = 1*256*1280*20*64 = 419M\n# p_mix@v: BH*L*L*D = 20*256*256*64 = 84M\n# Q proj: B*L*C*H*D = 419M\n# K proj: 419M\n# logits: BH*L*L*D = 84M\n# Total dominant: ~2100M\n\n# What if we replace 2 Gram bmm (335+335=670M) + v_proj(419M) + p_mix@v(84M)\n# with: p1@x (BH*L*L*C=20*256*256*1280=1677M way worse)\n\n# Gram approach is much better. What if we do Gram differently?\n# Instead of tiling G, compute G once and do something smarter?\n\n# Idea: p@G * p sum = (p* (p@G)).sum(-1) = diag(p @ G @ p''^T)\n# Since G = x@x''^T is symmetric, p@G@x = p@x@x''^T... not helpful\n\n# Wait, what about: ||p@x||''^2 = (p@x) * (p@x) summed over C \n# = (p @ x) @ (p @ x).diag... no\n# = sum_c (sum_j p_ij x_jc)''^2 = sum_j sum_k p_ij p_ik sum_c x_jc x_kc = sum_j sum_k p_ij p_ik G_jk\n# That'\"'s what we do: (p@G * p).sum(-1)\n\n# Alternative approach: compute u = p@x directly but then norms are free\n# Let me benchmark tradeoff\n# p1@x + p_mix@x: BH * L * L * C * 2 = 2*20*256*256*1280 = 3.35B MACs\n# vs Gram: G (B*L*L*C=84M) + 2*p@G (2*BH*L*L*L=670M) + p_mix@v + v_proj\n# = 84 + 670 + 84 + 419 = 1257M\n\n# Gram is better. Let's think about reducing Gram cost.\n# What if we use torch.nn.functional.scaled_dot_product_attention somehow?\n# Probably not applicable since we need both p0 and p1.\n\n# What about using the G_tiled differently?\n# Currently: G_tiled = G.unsqueeze(1).expand(B, H, L, L).reshape(BH, L, L)\n# This creates a view (expand), then contiguous copy via reshape.\n# But bmm needs contiguous... Let me check if expand-based approach works with bmm.\n\n# Actually, let me try: compute G, then p1G = p1.reshape(B,H,L,L) @ G\n# 4D matmul: (B,H,L,L) @ (B,1,L,L) - no, broadcasting doesn't work that way in matmul\n# We'd need to reshape properly\n\n# Let me try computing norms using row-wise approach without full G_tiled\n# p1G = p1 @ G_tiled  where each head has same G\n# This is equivalent to: for each head h, p1[h] @ G\n# Since G is same across heads, we can do 4D: (B, H, L, L) @ (B, 1, L, L)\n# But PyTorch 4D matmul broadcasts. Let me test.\n\ndef bench(fn, n=30, warmup=5):\n    for _ in range(warmup):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    return (t1 - t0) / n / 1e6\n\n# Setup\nBH = B * H\nHD = H * D\nxr = x.reshape(B * L, C)\nwqr = wq.reshape(HD, C)\nwkr = wk.reshape(HD, C)\nq = (xr @ wqr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\nk = (xr @ wkr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\ninv_sqrt_d = 1.0 / math.sqrt(D)\nq.mul_(inv_sqrt_d)\nlogits = torch.bmm(q, k.transpose(1, 2))\np0 = logits.softmax(dim=-1)\na_p = 0.5 + 0.5 * alpha\na_m = 0.5 - 0.5 * alpha\np1_logits = logits.mul(a_p).add(logits.transpose(1, 2), alpha=a_m)\np1 = p1_logits.softmax(dim=-1)\np_mix = torch.lerp(p0, p1, beta)\n\n# Approach 1: Current tiled G approach\ndef norm_v1():\n    G = torch.bmm(x, x.transpose(1, 2))\n    G_tiled = G.unsqueeze(1).expand(B, H, L, L).reshape(BH, L, L)\n    p1G = torch.bmm(p1, G_tiled)\n    norm1 = p1G.mul(p1).sum(dim=-1, keepdim=True).sqrt().clamp_min(1e-6)\n    pmG = torch.bmm(p_mix, G_tiled)\n    normm = pmG.mul(p_mix).sum(dim=-1, keepdim=True).sqrt().clamp_min(1e-6)\n    return norm1, normm\n\n# Approach 2: 4D matmul broadcast\ndef norm_v2():\n    G = torch.bmm(x, x.transpose(1, 2))  # (B, L, L)\n    p1_4d = p1.view(B, H, L, L)\n    pm_4d = p_mix.view(B, H, L, L)\n    G_4d = G.unsqueeze(1)  # (B, 1, L, L)\n    p1G = (p1_4d @ G_4d).view(BH, L, L)  # broadcasts B dim\n    norm1 = p1G.mul(p1).sum(dim=-1, keepdim=True).sqrt().clamp_min(1e-6)\n    pmG = (pm_4d @ G_4d).view(BH, L, L)\n    normm = pmG.mul(p_mix).sum(dim=-1, keepdim=True).sqrt().clamp_min(1e-6)\n    return norm1, normm\n\n# Approach 3: compute u1 and um in x-space directly (for comparison)\ndef norm_v3():\n    # p1 @ x: (BH, L, L) @ (BH_tiled, L, C) - need to tile x\n    x_tiled = x.unsqueeze(1).expand(B, H, L, C).reshape(BH, L, C)\n    u1 = torch.bmm(p1, x_tiled)\n    um = torch.bmm(p_mix, x_tiled)\n    norm1 = u1.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n    normm = um.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n    return norm1, normm\n\nn1_v1, nm_v1 = norm_v1()\nn1_v2, nm_v2 = norm_v2()\nn1_v3, nm_v3 = norm_v3()\nprint(f'v1 vs v2: max diff norm1={(n1_v1-n1_v2).abs().max():.2e}, normm={(nm_v1-nm_v2).abs().max():.2e}')\nprint(f'v1 vs v3: max diff norm1={(n1_v1-n1_v3).abs().max():.2e}, normm={(nm_v1-nm_v3).abs().max():.2e}')\n\nt1 = bench(norm_v1, n=50)\nt2 = bench(norm_v2, n=50)\nt3 = bench(norm_v3, n=50)\nprint(f'Norm v1 (tiled): {t1:.3f} ms')\nprint(f'Norm v2 (4D matmul): {t2:.3f} ms, ratio: {t1/t2:.3f}')\nprint(f'Norm v3 (direct): {t3:.3f} ms, ratio: {t1/t3:.3f}')\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/sh -lc 'cd /workspace && python3 -c \"\nimport torch, math, time\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n# Case 4: largest L and C combo\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C) * 0.1\nwk = torch.randn(H, D, C) * 0.1\nwv = torch.randn(H, D, C) * 0.1\n\n# Current best approach (v1)\ndef attention_v1(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BH = B * H\n    xr = x.reshape(B * L, C)\n    wqr = wq.reshape(HD, C)\n    wkr = wk.reshape(HD, C)\n    wvr = wv.reshape(HD, C)\n    q = (xr @ wqr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    k = (xr @ wkr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    q.mul_(inv_sqrt_d)\n    logits = torch.bmm(q, k.transpose(1, 2))\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 + 0.5 * alpha\n    a_m = 0.5 - 0.5 * alpha\n    p1_logits = logits.mul(a_p).add_(logits.transpose(1, 2), alpha=a_m)\n    p1 = p1_logits.softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = torch.bmm(x, x.transpose(1, 2))\n    G_tiled = G.unsqueeze(1).expand(B, H, L, L).reshape(BH, L, L)\n    p1G = torch.bmm(p1, G_tiled)\n    norm1 = p1G.mul_(p1).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    pmG = torch.bmm(p_mix, G_tiled)\n    normm = pmG.mul_(p_mix).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n    ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n    v = (xr @ wvr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    y = torch.bmm(p_mix, v).mul_(ratio)\n    return y.view(B, H, L, D).transpose(1, 2).flatten(2).contiguous()\n\n# Idea: compute u = p@x via bmm with expanded x, then compute norms as u.norm()\n# But instead of the Gram approach, what if we compute u1 and um directly and reuse?\n# Cost analysis for case 4: B=1, L=256, C=1280, H=20, D=64\n# Current Gram: p1@G_tiled (BH*L*L''^2=20*256*256=1.3M MACs?), no...\n# bmm with shapes (BH, L, L) @ (BH, L, L) = BH*L*L*L = 20*256*256*256 = 335M\n# p_mix@G_tiled: another 335M\n# v_proj: B*L*C*H*D = 1*256*1280*20*64 = 419M\n# p_mix@v: BH*L*L*D = 20*256*256*64 = 84M\n# Q proj: B*L*C*H*D = 419M\n# K proj: 419M\n# logits: BH*L*L*D = 84M\n# Total dominant: ~2100M\n\n# What if we replace 2 Gram bmm (335+335=670M) + v_proj(419M) + p_mix@v(84M)\n# with: p1@x (BH*L*L*C=20*256*256*1280=1677M way worse)\n\n# Gram approach is much better. What if we do Gram differently?\n# Instead of tiling G, compute G once and do something smarter?\n\n# Idea: p@G * p sum = (p* (p@G)).sum(-1) = diag(p @ G @ p''^T)\n# Since G = x@x''^T is symmetric, p@G@x = p@x@x''^T... not helpful\n\n# Wait, what about: ||p@x||''^2 = (p@x) * (p@x) summed over C \n# = (p @ x) @ (p @ x).diag... no\n# = sum_c (sum_j p_ij x_jc)''^2 = sum_j sum_k p_ij p_ik sum_c x_jc x_kc = sum_j sum_k p_ij p_ik G_jk\n# That'\"'s what we do: (p@G * p).sum(-1)\n\n# Alternative approach: compute u = p@x directly but then norms are free\n# Let me benchmark tradeoff\n# p1@x + p_mix@x: BH * L * L * C * 2 = 2*20*256*256*1280 = 3.35B MACs\n# vs Gram: G (B*L*L*C=84M) + 2*p@G (2*BH*L*L*L=670M) + p_mix@v + v_proj\n# = 84 + 670 + 84 + 419 = 1257M\n\n# Gram is better. Let's think about reducing Gram cost.\n# What if we use torch.nn.functional.scaled_dot_product_attention somehow?\n# Probably not applicable since we need both p0 and p1.\n\n# What about using the G_tiled differently?\n# Currently: G_tiled = G.unsqueeze(1).expand(B, H, L, L).reshape(BH, L, L)\n# This creates a view (expand), then contiguous copy via reshape.\n# But bmm needs contiguous... Let me check if expand-based approach works with bmm.\n\n# Actually, let me try: compute G, then p1G = p1.reshape(B,H,L,L) @ G\n# 4D matmul: (B,H,L,L) @ (B,1,L,L) - no, broadcasting doesn't work that way in matmul\n# We'd need to reshape properly\n\n# Let me try computing norms using row-wise approach without full G_tiled\n# p1G = p1 @ G_tiled  where each head has same G\n# This is equivalent to: for each head h, p1[h] @ G\n# Since G is same across heads, we can do 4D: (B, H, L, L) @ (B, 1, L, L)\n# But PyTorch 4D matmul broadcasts. Let me test.\n\ndef bench(fn, n=30, warmup=5):\n    for _ in range(warmup):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    return (t1 - t0) / n / 1e6\n\n# Setup\nBH = B * H\nHD = H * D\nxr = x.reshape(B * L, C)\nwqr = wq.reshape(HD, C)\nwkr = wk.reshape(HD, C)\nq = (xr @ wqr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\nk = (xr @ wkr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\ninv_sqrt_d = 1.0 / math.sqrt(D)\nq.mul_(inv_sqrt_d)\nlogits = torch.bmm(q, k.transpose(1, 2))\np0 = logits.softmax(dim=-1)\na_p = 0.5 + 0.5 * alpha\na_m = 0.5 - 0.5 * alpha\np1_logits = logits.mul(a_p).add(logits.transpose(1, 2), alpha=a_m)\np1 = p1_logits.softmax(dim=-1)\np_mix = torch.lerp(p0, p1, beta)\n\n# Approach 1: Current tiled G approach\ndef norm_v1():\n    G = torch.bmm(x, x.transpose(1, 2))\n    G_tiled = G.unsqueeze(1).expand(B, H, L, L).reshape(BH, L, L)\n    p1G = torch.bmm(p1, G_tiled)\n    norm1 = p1G.mul(p1).sum(dim=-1, keepdim=True).sqrt().clamp_min(1e-6)\n    pmG = torch.bmm(p_mix, G_tiled)\n    normm = pmG.mul(p_mix).sum(dim=-1, keepdim=True).sqrt().clamp_min(1e-6)\n    return norm1, normm\n\n# Approach 2: 4D matmul broadcast\ndef norm_v2():\n    G = torch.bmm(x, x.transpose(1, 2))  # (B, L, L)\n    p1_4d = p1.view(B, H, L, L)\n    pm_4d = p_mix.view(B, H, L, L)\n    G_4d = G.unsqueeze(1)  # (B, 1, L, L)\n    p1G = (p1_4d @ G_4d).view(BH, L, L)  # broadcasts B dim\n    norm1 = p1G.mul(p1).sum(dim=-1, keepdim=True).sqrt().clamp_min(1e-6)\n    pmG = (pm_4d @ G_4d).view(BH, L, L)\n    normm = pmG.mul(p_mix).sum(dim=-1, keepdim=True).sqrt().clamp_min(1e-6)\n    return norm1, normm\n\n# Approach 3: compute u1 and um in x-space directly (for comparison)\ndef norm_v3():\n    # p1 @ x: (BH, L, L) @ (BH_tiled, L, C) - need to tile x\n    x_tiled = x.unsqueeze(1).expand(B, H, L, C).reshape(BH, L, C)\n    u1 = torch.bmm(p1, x_tiled)\n    um = torch.bmm(p_mix, x_tiled)\n    norm1 = u1.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n    normm = um.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n    return norm1, normm\n\nn1_v1, nm_v1 = norm_v1()\nn1_v2, nm_v2 = norm_v2()\nn1_v3, nm_v3 = norm_v3()\nprint(f'v1 vs v2: max diff norm1={(n1_v1-n1_v2).abs().max():.2e}, normm={(nm_v1-nm_v2).abs().max():.2e}')\nprint(f'v1 vs v3: max diff norm1={(n1_v1-n1_v3).abs().max():.2e}, normm={(nm_v1-nm_v3).abs().max():.2e}')\n\nt1 = bench(norm_v1, n=50)\nt2 = bench(norm_v2, n=50)\nt3 = bench(norm_v3, n=50)\nprint(f'Norm v1 (tiled): {t1:.3f} ms')\nprint(f'Norm v2 (4D matmul): {t2:.3f} ms, ratio: {t1/t2:.3f}')\nprint(f'Norm v3 (direct): {t3:.3f} ms, ratio: {t1/t3:.3f}')\n\\\" 2>&1\n\"","aggregated_output":"v1 vs v2: max diff norm1=0.00e+00, normm=0.00e+00\nv1 vs v3: max diff norm1=3.43e-05, normm=6.10e-05\nNorm v1 (tiled): 12.577 ms\nNorm v2 (4D matmul): 12.622 ms, ratio: 0.996\nNorm v3 (direct): 58.134 ms, ratio: 0.216\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math, time\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C) * 0.1\nwk = torch.randn(H, D, C) * 0.1\nwv = torch.randn(H, D, C) * 0.1\n\ndef bench(fn, n=30, warmup=5):\n    for _ in range(warmup):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    return (t1 - t0) / n / 1e6\n\nBH = B * H\nHD = H * D\nxr = x.reshape(B * L, C)\nwqr = wq.reshape(HD, C)\nwkr = wk.reshape(HD, C)\nwvr = wv.reshape(HD, C)\n\n# Test if we can fuse p1G and pmG computation\n# p1G = p1 @ G, pmG = p_mix @ G\n# What if we concat p1 and p_mix and do one bmm?\nq = (xr @ wqr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\nk = (xr @ wkr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\ninv_sqrt_d = 1.0 / math.sqrt(D)\nq.mul_(inv_sqrt_d)\nlogits = torch.bmm(q, k.transpose(1, 2))\np0 = logits.softmax(dim=-1)\na_p = 0.5 + 0.5 * alpha\na_m = 0.5 - 0.5 * alpha\np1_logits = logits.mul(a_p).add(logits.transpose(1, 2), alpha=a_m)\np1 = p1_logits.softmax(dim=-1)\np_mix = torch.lerp(p0, p1, beta)\n\nG = torch.bmm(x, x.transpose(1, 2))\nG_tiled = G.unsqueeze(1).expand(B, H, L, L).reshape(BH, L, L).contiguous()\n\ndef two_bmms():\n    p1G = torch.bmm(p1, G_tiled)\n    pmG = torch.bmm(p_mix, G_tiled)\n    return p1G, pmG\n\n# Concatenated: double the batch, one bmm call\ndef fused_bmm():\n    both = torch.cat([p1, p_mix], dim=0)  # (2*BH, L, L)\n    G_double = torch.cat([G_tiled, G_tiled], dim=0)  # (2*BH, L, L)\n    result = torch.bmm(both, G_double)\n    return result[:BH], result[BH:]\n\nr1a, r2a = two_bmms()\nr1b, r2b = fused_bmm()\nprint(f'Match: {(r1a-r1b).abs().max():.2e}, {(r2a-r2b).abs().max():.2e}')\n\nt1 = bench(two_bmms, n=100)\nt2 = bench(fused_bmm, n=100)\nprint(f'Two separate: {t1:.3f} ms')\nprint(f'Fused concat: {t2:.3f} ms, ratio: {t1/t2:.3f}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math, time\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n# Let me test across all cases the full method with the 2D Gram improvement\n# and also try a variant where we fuse more things\ndef attn_v2(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BH = B * H\n    HL = H * L\n    xr = x.reshape(B * L, C)\n    wqr = wq.reshape(HD, C)\n    wkr = wk.reshape(HD, C)\n    wvr = wv.reshape(HD, C)\n    q = (xr @ wqr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    k = (xr @ wkr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n    q.mul_(inv_sqrt_d)\n    logits = torch.bmm(q, k.transpose(1, 2))\n    p0 = logits.softmax(dim=-1)\n    if alpha == 1.0:\n        v = (xr @ wvr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n        y = torch.bmm(p0, v)\n    else:\n        a_p = 0.5 + 0.5 * alpha\n        a_m = 0.5 - 0.5 * alpha\n        p1_logits = logits.mul(a_p).add_(logits.transpose(1, 2), alpha=a_m)\n        p1 = p1_logits.softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        G = torch.bmm(x, x.transpose(1, 2))\n        p1G = torch.bmm(p1.view(B, HL, L), G).view(BH, L, L)\n        pmG = torch.bmm(p_mix.view(B, HL, L), G).view(BH, L, L)\n        norm1 = p1G.mul_(p1).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n        normm = pmG.mul_(p_mix).sum(dim=-1, keepdim=True).sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n        v = (xr @ wvr.T).view(B, L, H, D).permute(0, 2, 1, 3).contiguous().view(BH, L, D)\n        y = torch.bmm(p_mix, v).mul_(ratio)\n    return y.view(B, H, L, D).transpose(1, 2).flatten(2).contiguous()\n\ncases = [\n    (1, 64, 512, 8, 64, 1.05, 5.0, 'Case 1'),\n    (1, 128, 640, 10, 64, 1.1, 4.0, 'Case 2'),\n    (1, 128, 1280, 20, 64, 1.15, 3.0, 'Case 3'),\n    (1, 256, 1280, 20, 64, 1.05, 7.5, 'Case 4'),\n    (1, 256, 640, 10, 64, 1.2, 5.0, 'Case 5'),\n    (2, 128, 512, 8, 64, 1.0, 5.0, 'Case 6'),\n]\n\n# Reference implementation\ndef reference(x, wq, wk, wv, alpha, beta):\n    q = torch.einsum('blc,hdc->bhld', x, wq)\n    k = torch.einsum('blc,hdc->bhld', x, wk)\n    logits = (q @ k.transpose(-1, -2)) / math.sqrt(wq.shape[1])\n    p0 = logits.softmax(dim=-1)\n    base = p0 @ x.unsqueeze(1)\n    if alpha == 1.0:\n        modified = base\n    else:\n        perturbed = .5 * (1 + alpha) * logits + .5 * (1 - alpha) * logits.transpose(-1, -2)\n        modified = perturbed.softmax(dim=-1) @ x.unsqueeze(1)\n    blended = base + beta * (modified - base)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    y = torch.einsum('bhlc,hdc->bhld', blended * ratio, wv)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\nprint('Numerical check against reference:')\nfor B, L, C, H, D, alpha, beta, name in cases:\n    torch.manual_seed(123)\n    x = torch.randn(B, L, C)\n    wq = torch.randn(H, D, C) * 0.1\n    wk = torch.randn(H, D, C) * 0.1\n    wv = torch.randn(H, D, C) * 0.1\n    y_ref = reference(x, wq, wk, wv, alpha, beta)\n    y_opt = attn_v2(x, wq, wk, wv, alpha, beta)\n    diff = (y_ref - y_opt).abs()\n    atol = diff.max().item()\n    rtol = (diff / y_ref.abs().clamp_min(1e-8)).max().item()\n    ok = atol <= 3e-5 + 3e-4 * y_ref.abs().max().item()\n    print(f'  {name}: atol={atol:.2e}, rtol={rtol:.2e} [{\\\\\\\"OK\\\\\\\" if ok else \\\\\\\"FAIL\\\\\\\"}]')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

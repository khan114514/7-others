{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/panelbench.py <<'PY'\nimport torch, math, time, importlib.util\nfrom pathlib import Path\ntorch.set_num_threads(1); torch.set_num_interop_threads(1)\ncases=[(1,64,512,8,64,1.05,5.),(1,128,640,10,64,1.1,4.),(1,128,1280,20,64,1.15,3.),(1,256,1280,20,64,1.05,7.5),(1,256,640,10,64,1.2,5.),(2,128,512,8,64,1.,5.)]\nfor panel in [32,40,48,56,64,80,96,128]:\n src=Path('/workspace/solution/method.py').read_text()\n # force all eligible panel values to requested constant\n src=src.replace('panel = 64 if heads >= 20 else 48',f'panel = {panel}')\n src=src.replace('panel = 48 if b == 1 and length >= 128 else 64',f'panel = {panel}')\n p=Path('/tmp/m_panel.py');p.write_text(src)\n spec=importlib.util.spec_from_file_location('m',p);m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)\n vals=[]\n for ci,(b,l,c,h,d,a,be) in enumerate(cases):\n  g=torch.Generator().manual_seed(17*1009+ci);x=torch.randn(b,l,c,generator=g);w=[torch.randn(h,d,c,generator=g)/math.sqrt(c) for _ in range(3)]\n  for _ in range(5):m.attention(x,*w,a,be)\n  ts=[]\n  for _ in range(15):\n   t=time.process_time_ns();m.attention(x,*w,a,be);ts.append((time.process_time_ns()-t)/1e6)\n  vals.append(sorted(ts)[len(ts)//2])\n print(panel, ['%.3f'%v for v in vals], 'mean %.3f'%(sum(vals)/len(vals)))\nPY\npython /tmp/panelbench.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

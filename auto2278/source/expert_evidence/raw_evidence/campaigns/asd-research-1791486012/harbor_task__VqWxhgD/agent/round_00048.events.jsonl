ueeze(1).expand(b, heads, length, channels).reshape(\n            b * heads, length, channels)\n        base = torch.bmm(p0.reshape(b * heads, length, length), features).reshape(\n            b, heads, length, channels)\n        modified = torch.bmm(p1.reshape(b * heads, length, length), features).reshape(\n            b, heads, length, channels)\n        ratio = modified.norm(dim=-1, keepdim=True).clamp_min_(1e-6)\n        modified.sub_(base)\n        base.add_(modified, alpha=beta)\n        ratio.div_(base.norm(dim=-1, keepdim=True).clamp_min_(1e-6))\n        ratio.clamp_(.25, 4.)\n        y = torch.matmul(base.mul_(ratio), wv.transpose(-1, -2))\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n0 [1.241291, 1.244209, 1.250875, 1.260041, 1.262042, 1.264417, 1.264959, 1.269333, 1.270542, 1.271458, 1.271583, 1.273625, 1.274375, 1.27575, 1.281583, 1.282334, 1.28325, 1.358291, 1.384416, 1.561334] med 1.271583\n1 [4.28675, 4.287416, 4.2895, 4.334417, 4.335833, 4.349833, 4.37075, 4.383208, 4.383333, 4.396833, 4.4145, 4.415083, 4.420708, 4.422541, 4.422833, 4.425833, 4.433917, 4.459583, 4.484625, 4.509083] med 4.4145\n2 [13.847292, 13.847542, 13.937083, 13.954334, 13.964583, 14.038208, 14.073708, 14.082333, 14.112833, 14.114543, 14.119584, 14.173708, 14.228458, 14.238209, 14.382542, 14.405584, 14.409834, 14.517333, 14.573083, 15.019125] med 14.119584\n3 [37.557374, 37.631875, 37.728208, 37.939875, 37.998125, 38.228958, 38.528166, 38.540666, 38.552166, 38.577958, 38.579458, 38.629125, 38.629833, 38.664667, 38.794917, 38.805, 38.819167, 38.919833, 39.087209, 39.317125] med 38.579458\n4 [13.494417, 13.629583, 13.65675, 13.744334, 13.754125, 13.787375, 13.855625, 13.857542, 13.866291, 13.885291, 13.9355, 13.9925, 14.012, 14.050083, 14.65575, 14.662125, 14.698125, 15.314292, 17.069416, 17.242458] med 13.9355\n5 [4.395667, 4.472792, 4.507875, 4.546791, 4.552625, 4.568, 4.570958, 4.589875, 4.603792, 4.605208, 4.630791, 4.639209, 4.654541, 4.691625, 4.710417, 4.735333, 4.7
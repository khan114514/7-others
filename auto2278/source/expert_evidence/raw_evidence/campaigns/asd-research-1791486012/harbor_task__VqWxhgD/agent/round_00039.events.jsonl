{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/bench5.py <<'PY'\nimport torch,time,math\n\ntorch.set_num_threads(1);torch.set_num_interop_threads(1)\nb,l,c,h,d=2,128,512,8,64\ng=torch.Generator().manual_seed(17);x=torch.randn(b,l,c,generator=g);w=[torch.randn(h,d,c,generator=g)/math.sqrt(c) for _ in range(3)]\nmaps=torch.cat([z.reshape(h*d,c) for z in w])\nproj=torch.mm(x.reshape(b*l,c),maps.t()).reshape(b,l,3,h,d).permute(2,0,3,1,4);q,k,v=proj.unbind(0)\nlogits=torch.matmul(q,k.transpose(-1,-2))/math.sqrt(d); p=logits.softmax(-1)\nfuncs={\n'sdpa':lambda:torch.nn.functional.scaled_dot_product_attention(q,k,v),\n'bmm':lambda:torch.matmul(p,v),\n'logits_p':lambda:torch.matmul(logits.softmax(-1),v),\n}\nfor name,f in funcs.items():\n for _ in range(4):f()\n ts=[]\n for _ in range(30):\n  t=time.process_time_ns();f();ts.append((time.process_time_ns()-t)/1e6)\n print(name, sorted(ts)[15],sum(ts)/len(ts),min(ts),max(ts))\n# full branch timing varying qkv orientation and matmul layouts\nPY\npython /tmp/bench5.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/bench2.py <<'PY'\nimport torch,time\n\ntorch.set_num_threads(1);torch.set_num_interop_threads(1)\ndef panel(coef,factor,bs):\n b,rows,l=coef.shape;sq=coef.new_zeros((b,rows,1))\n for st in range(0,l,bs):\n  en=min(st+bs,l); p=torch.bmm(coef[:,:,st:],factor[:,st:,st:en]);sq.add_(p.norm(dim=-1,keepdim=True).square_())\n return sq\n\ndef panel_direct(coef,factor,bs):\n b,rows,l=coef.shape;sq=coef.new_zeros((b,rows,1))\n for st in range(0,l,bs):\n  en=min(st+bs,l); p=torch.bmm(coef[:,:,st:],factor[:,st:,st:en]);sq.add_((p*p).sum(-1,keepdim=True))\n return sq\n\ndef full(coef,factor):\n p=torch.bmm(coef,factor);return (p*p).sum(-1,keepdim=True)\ndef fullnorm(coef,factor):\n p=torch.bmm(coef,factor);return p.norm(dim=-1,keepdim=True).square_()\ndef mmfull(coef,factor):\n p=torch.mm(coef[0],factor[0]);return (p*p).sum(-1,keepdim=True).unsqueeze(0)\ndef mmpanel(coef,factor,bs):\n sq=coef.new_zeros((coef.shape[1],1))\n for st in range(0,coef.shape[2],bs):\n  en=min(st+bs,coef.shape[2]);p=torch.mm(coef[0,:,st:],factor[0,st:,st:en]);sq.add_((p*p).sum(-1,keepdim=True))\n return sq.unsqueeze(0)\nfor l,h in [(128,10),(128,20),(256,20),(256,10)]:\n coef=torch.rand(1,2*h*l,l);A=torch.rand(l,l);fac=torch.linalg.cholesky(A@A.T+torch.eye(l)*.1).unsqueeze(0)\n print('shape',l,h)\n for fn in [panel,panel_direct,full,fullnorm,mmfull,mmpanel]:\n  for bs in ([32,48,64,96,128,256] if fn in [panel,panel_direct,mmpanel] else [None]):\n   if bs is None: f=lambda:fn(coef,fac)\n   else: f=lambda bs=bs:fn(coef,fac,bs)\n   for _ in range(3):f()\n   ts=[]\n   for _ in range(10):\n    t=time.process_time_ns();f();ts.append((time.process_time_ns()-t)/1e6)\n   print(fn.__name__,bs,round(sorted(ts)[5],3),end='; ')\n  print()\nPY\npython /tmp/bench2.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/normbench.py <<'PY'\nimport torch,time\n\ntorch.set_num_threads(1);torch.set_num_interop_threads(1)\nfor l,h in [(128,10),(128,20),(256,10),(256,20)]:\n p=torch.rand(1,h,l,l); p2=torch.rand_like(p); A=torch.rand(l,l);G=A@A.t()+torch.eye(l)*.1;F=torch.linalg.cholesky(G).unsqueeze(0)\n coef=torch.cat((p,p2),dim=1).reshape(1,2*h*l,l)\n def direct():\n  c=coef.reshape(1,2*h*l,l);return torch.bmm(c,G.unsqueeze(0)).mul_(c).sum(-1)\n def panel(bs=64):\n  sq=coef.new_zeros((1,2*h*l,1))\n  for st in range(0,l,bs):\n   en=min(st+bs,l);z=torch.bmm(coef[:,:,st:],F[:,st:,st:en]);sq.add_(z.norm(dim=-1,keepdim=True).square_())\n  return sq\n print('shape',l,h)\n for name,f in [('direct',direct),('p32',lambda:panel(32)),('p48',lambda:panel(48)),('p64',lambda:panel(64)),('p96',lambda:panel(96))]:\n  for _ in range(3):f()\n  ts=[]\n  for _ in range(20):\n   t=time.process_time_ns();f();ts.append((time.process_time_ns()-t)/1e6)\n  print(name,sorted(ts)[10],sum(ts)/20)\nPY\npython /tmp/normbench.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

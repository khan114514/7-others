{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/bench6.py <<'PY'\nimport torch,time,math\n\ntorch.set_num_threads(1);torch.set_num_interop_threads(1)\nb,l,c,h,d=2,128,512,8,64\ng=torch.Generator().manual_seed(17);x=torch.randn(b,l,c,generator=g);w=[torch.randn(h,d,c,generator=g)/math.sqrt(c) for _ in range(3)]\ndef sdpa():\n maps=torch.cat([z.reshape(h*d,c) for z in w]); projected=torch.mm(x.reshape(b*l,c),maps.t()); q,k,v=projected.reshape(b,l,3,h,d).permute(2,0,3,1,4).unbind(0); y=torch.nn.functional.scaled_dot_product_attention(q,k,v); return y.transpose(1,2).flatten(2).contiguous()\ndef expl():\n maps=torch.cat([z.reshape(h*d,c) for z in w]); projected=torch.mm(x.reshape(b*l,c),maps.t()); q,k,v=projected.reshape(b,l,3,h,d).permute(2,0,3,1,4).unbind(0); y=torch.matmul(torch.matmul(q,k.transpose(-1,-2))/math.sqrt(d),v); y=y.softmax(-2) if False else y\n # wrong softmax placement above\n return y\n\ndef expl2():\n maps=torch.cat([z.reshape(h*d,c) for z in w]); projected=torch.mm(x.reshape(b*l,c),maps.t()); q,k,v=projected.reshape(b,l,3,h,d).permute(2,0,3,1,4).unbind(0); logits=torch.matmul(q,k.transpose(-1,-2))/math.sqrt(d); y=torch.matmul(logits.softmax(-1),v); return y.transpose(1,2).flatten(2).contiguous()\ndef expl3():\n maps=torch.cat([z.reshape(h*d,c) for z in w]); projected=torch.mm(x.reshape(b*l,c),maps.t()); q,k,v=projected.reshape(b,l,3,h,d).permute(2,0,3,1,4).unbind(0); q=q.reshape(b*h,l,d);k=k.reshape(b*h,l,d);v=v.reshape(b*h,l,d); y=torch.bmm(torch.bmm(q,k.transpose(1,2)).div_(math.sqrt(d)).softmax(-1),v); return y.reshape(b,h,l,d).transpose(1,2).flatten(2).contiguous()\nfor name,f in [('sdpa',sdpa),('expl2',expl2),('expl3',expl3)]:\n for _ in range(3):f()\n ts=[]\n for _ in range(20):\n  t=time.process_time_ns();f();ts.append((time.process_time_ns()-t)/1e6)\n print(name,sorted(ts)[10],sum(ts)/len(ts), min(ts),max(ts))\n# correctness\nprint((sdpa()-expl2()).abs().max(),(sdpa()-expl3()).abs().max())\nPY\npython /tmp/bench6.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

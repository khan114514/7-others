{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport torch,time,math,importlib.util\n\ntorch.set_num_threads(1);torch.set_num_interop_threads(1)\nspec=importlib.util.spec_from_file_location('m','solution/method.py');m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)\nfor L,H,C in [(128,10,640),(256,10,640),(128,20,1280),(256,20,1280)]:\n B=1; g=torch.Generator().manual_seed(1);x=torch.randn(B,L,C,generator=g);factor=torch.linalg.cholesky(x @ x.transpose(-1,-2)); coef=torch.softmax(torch.randn(B,2*H*L,L,generator=g),-1)\n print('case',L,H,C,'rows',2*H*L)\n for typ,panel in [('orig',None),('mm48',48),('mm64',64),('mm32',32),('bmm32',32),('bmm48',48),('bmm64',64)]:\n  def fn():\n   if typ=='orig':return m.factored_norms(coef,factor)\n   mm=typ.startswith('mm'); sq=coef.new_zeros((2*H*L,1)) if mm else coef.new_zeros((B,2*H*L,1)); p=panel\n   for st in range(0,L,p):\n    en=min(st+p,L)\n    if mm: z=torch.mm(coef[0,:,st:],factor[0,st:,st:en])\n    else:z=torch.bmm(coef[:,:,st:],factor[:,st:,st:en])\n    sq.add_(z.norm(dim=-1,keepdim=True).square_())\n   return sq\n  for _ in range(3):fn()\n  ts=[]\n  for _ in range(15):\n   t=time.perf_counter_ns();z=fn();ts.append((time.perf_counter_ns()-t)/1e6)\n  print(typ,round(sorted(ts)[7],3),[round(q,2) for q in ts[:5]])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport torch,time,math\n\ntorch.set_num_threads(1);torch.set_num_interop_threads(1)\nB,L,C,H,D=1,256,640,10,64;g=torch.Generator().manual_seed(1);x=torch.randn(B,L,C,generator=g);wq,wk=[torch.randn(H,D,C,generator=g)/math.sqrt(C) for _ in range(2)]\n# Compare layouts q [B,H,L,D]\nfor typ in ['flat','bmm','einsum']:\n for _ in range(3):\n  if typ=='flat':\n   q=(x.reshape(B*L,C)@wq.reshape(H*D,C).t()).reshape(B,L,H,D).transpose(1,2); k=(x.reshape(B*L,C)@wk.reshape(H*D,C).t()).reshape(B,L,H,D).transpose(1,2); z=torch.matmul(q,k.transpose(-1,-2))\n  elif typ=='bmm':\n   q=torch.bmm(wq.reshape(H*D,C).unsqueeze(0),x.transpose(1,2)).reshape(B,H,D,L).transpose(2,3);k=torch.bmm(wk.reshape(H*D,C).unsqueeze(0),x.transpose(1,2)).reshape(B,H,D,L).transpose(2,3);z=torch.matmul(q,k.transpose(-1,-2))\n  else:q=torch.einsum('blc,hdc->bhld',x,wq);k=torch.einsum('blc,hdc->bhld',x,wk);z=torch.matmul(q,k.transpose(-1,-2))\n ts=[]\n for _ in range(10):\n  t=time.perf_counter_ns()\n  if typ=='flat':\n   q=(x.reshape(B*L,C)@wq.reshape(H*D,C).t()).reshape(B,L,H,D).transpose(1,2); k=(x.reshape(B*L,C)@wk.reshape(H*D,C).t()).reshape(B,L,H,D).transpose(1,2); z=torch.matmul(q,k.transpose(-1,-2))\n  elif typ=='bmm':\n   q=torch.bmm(wq.reshape(H*D,C).unsqueeze(0),x.transpose(1,2)).reshape(B,H,D,L).transpose(2,3);k=torch.bmm(wk.reshape(H*D,C).unsqueeze(0),x.transpose(1,2)).reshape(B,H,D,L).transpose(2,3);z=torch.matmul(q,k.transpose(-1,-2))\n  else:q=torch.einsum('blc,hdc->bhld',x,wq);k=torch.einsum('blc,hdc->bhld',x,wk);z=torch.matmul(q,k.transpose(-1,-2))\n  ts.append((time.perf_counter_ns()-t)/1e6)\n print(typ,sorted(ts)[5],[round(v,3) for v in ts])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

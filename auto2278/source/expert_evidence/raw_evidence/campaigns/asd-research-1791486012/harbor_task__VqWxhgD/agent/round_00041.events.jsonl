{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport torch,time,math,importlib.util\n\ntorch.set_num_threads(1);torch.set_num_interop_threads(1)\nspec=importlib.util.spec_from_file_location('m','solution/method.py');m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)\ng=torch.Generator().manual_seed(123);B,L,C,H,D=1,256,640,10,64\nx=torch.randn(B,L,C,generator=g);wq,wk,wv=[torch.randn(H,D,C,generator=g)/math.sqrt(C) for _ in range(3)];a,beta=1.2,5.\ndef att(kind):\n if kind=='cur': q=m.project(x,wq);k=m.project(x,wk)\n elif kind=='bmm':\n  q=torch.bmm(wq.reshape(1,H*D,C),x.transpose(1,2)).reshape(B,H,D,L).transpose(2,3)\n  k=torch.bmm(wk.reshape(1,H*D,C),x.transpose(1,2)).reshape(B,H,D,L).transpose(2,3)\n elif kind=='bmmcat':\n  z=torch.bmm(torch.cat((wq,wk),1).reshape(1,2*H*D,C),x.transpose(1,2));z=z.reshape(B,2,H,D,L).permute(0,1,2,4,3);q,k=z.unbind(1)\n logits=torch.matmul(q,k.transpose(-1,-2)).div_(math.sqrt(D));p0=logits.softmax(-1);p1=torch.lerp(logits,logits.transpose(-1,-2),.5*(1-a)).softmax(-1)\n base=torch.matmul(p0,x.unsqueeze(1));mod=torch.matmul(p1,x.unsqueeze(1));ratio=mod.norm(dim=-1,keepdim=True).clamp_min_(1e-6);mod.sub_(base);base.add_(mod,alpha=beta);ratio.div_(base.norm(dim=-1,keepdim=True).clamp_min_(1e-6));ratio.clamp_(.25,4.);y=torch.matmul(base.mul_(ratio),wv.transpose(-1,-2));return y.transpose(1,2).flatten(2).contiguous()\nfor kind in ['cur','bmm','bmmcat']:\n for _ in range(3):att(kind)\n ts=[]\n for _ in range(20):\n  t=time.perf_counter_ns();z=att(kind);ts.append((time.perf_counter_ns()-t)/1e6)\n print(kind,sorted(ts)[10],[round(v,3) for v in ts])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport importlib.util\nimport math\nimport torch\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\ndef load(path, name):\n    spec = importlib.util.spec_from_file_location(name, path)\n    module = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(module)\n    return module\ncandidate = load('/workspace/solution/method.py', 'candidate')\nstarter = load('/workspace/environment/starter/method.py', 'starter')\nfor length, channels, heads, dim, alpha, beta, zero in [\n    (128,1280,20,64,1.15,3.,False),\n    (256,1280,20,64,1.05,7.5,False),\n    (129,512,21,16,0.7,-0.5,False),\n    (128,640,20,16,1.1,4.,True),\n]:\n    g = torch.Generator().manual_seed(1729 + length)\n    x = torch.randn(1,length,channels,generator=g)\n    if zero:\n        x.zero_()\n    weights = [torch.randn(heads,dim,channels,generator=g) / math.sqrt(channels) for _ in range(3)]\n    with torch.inference_mode():\n        actual = candidate.attention(x,*weights,alpha,beta)\n        expected = starter.attention(x,*weights,alpha,beta)\n    print({'length':length,'heads':heads,'zero':zero,'shape':list(actual.shape),'max_error':float((actual-expected).abs().max()),'passed':bool(torch.allclose(actual,expected,atol=3e-5,rtol=3e-4))},flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

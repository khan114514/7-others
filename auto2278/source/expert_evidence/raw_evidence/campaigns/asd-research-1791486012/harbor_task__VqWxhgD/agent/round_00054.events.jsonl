{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/bench.py <<'PY'\nimport torch,math,time,importlib.util\nfrom pathlib import Path\ntorch.set_num_threads(1); torch.set_num_interop_threads(1)\nspec=importlib.util.spec_from_file_location('m','/workspace/solution/method.py'); m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)\ndef bench_fact(h,l,panel,n=30):\n    c=torch.randn(1,2*h*l,l); g=torch.randn(1,l,l); gram=g @ g.transpose(-1,-2)+torch.eye(l).unsqueeze(0)*1e-2\n    f=torch.linalg.cholesky(gram)\n    def fn():\n      sq=c.new_zeros((c.shape[1],1))\n      for st in range(0,l,panel):\n        en=min(st+panel,l)\n        pr=torch.mm(c[0,:,st:],f[0,st:,st:en])\n        sq.add_(pr.norm(dim=-1,keepdim=True).square_())\n      return sq\n    for _ in range(5):fn()\n    ts=[]\n    for _ in range(n):\n      a=time.process_time_ns();fn();ts.append((time.process_time_ns()-a)/1e6)\n    return sorted(ts)[len(ts)//2]\ndef bench_full(b,l,c,h,d,alpha,beta,n=20):\n g=torch.Generator().manual_seed(17+l+c+h)\n x=torch.randn(b,l,c,generator=g); ws=[torch.randn(h,d,c,generator=g)/math.sqrt(c) for _ in range(3)]\n args=(x,*ws,alpha,beta)\n for _ in range(5):m.attention(*args)\n ts=[]\n for _ in range(n):\n  a=time.process_time_ns();m.attention(*args);ts.append((time.process_time_ns()-a)/1e6)\n return sorted(ts)[len(ts)//2]\nfor h,l in [(10,256),(20,256),(10,128),(20,128)]:\n print('fact',h,l,[(p,bench_fact(h,l,p)) for p in [16,24,32,40,48,64,80,128,256]])\nfor case in [(1,256,640,10,64,1.2,5.),(1,256,1280,20,64,1.05,7.5),(1,128,640,10,64,1.1,4.),(1,128,1280,20,64,1.15,3.)]:\n print('full',case,bench_full(*case))\nPY\npython /tmp/bench.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

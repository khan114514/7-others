{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/bench_tri.py <<'PY'\nimport torch, math, time\nfrom importlib.machinery import SourceFileLoader\nm=SourceFileLoader('m','/workspace/solution/method.py').load_module();torch.set_num_threads(1);torch.set_num_interop_threads(1)\nfor case in [(1,128,640,10,64),(1,128,1280,20,64),(1,256,1280,20,64),(1,256,640,10,64)]:\n b,l,c,h,d=case;g=torch.Generator().manual_seed(123);x=torch.randn(b,l,c,generator=g);wq=torch.randn(h,d,c,generator=g)/math.sqrt(c);wk=torch.randn(h,d,c,generator=g)/math.sqrt(c);wv=torch.randn(h,d,c,generator=g)/math.sqrt(c)\n q,k,v,gram=m.project_qkv(x,wq,wk,wv,True); logits=q @ k.transpose(-1,-2)/math.sqrt(d);p0=logits.softmax(-1);p1=torch.lerp(logits,logits.transpose(-1,-2),-.05).softmax(-1);F,_=torch.linalg.cholesky_ex(gram,check_errors=False);co=torch.cat((p1,p0),1).reshape(b,2*h*l,l)\n def cur(): return m.factored_norms(co,F)\n def tri(bs):\n  def fn():\n   out=co.new_zeros((co.shape[1],1))\n   for s in range(0,l,64):\n    e=min(s+64,l); z=co.new_zeros((co.shape[1],e-s))\n    # diagonal triangular blocks by row chunks\n    for r0 in range(s,e,bs):\n     r1=min(r0+bs,e)\n     z[:,:r1-s].add_(torch.mm(co[0,:,r0:r1],F[0,r0:r1,s:r1]))\n    if e<l: z.add_(torch.mm(co[0,:,e:],F[0,e:,s:e]))\n    out.add_(z.square().sum(-1,keepdim=True))\n   return out.unsqueeze(0)\n  return fn\n print('CASE',case)\n for bs in [8,16,32,64]:\n  fn=tri(bs)\n  for _ in range(2): fn()\n  ts=[]\n  for _ in range(10): t=time.process_time_ns();y=fn();ts.append((time.process_time_ns()-t)/1e6)\n  print(bs,sum(ts)/len(ts),float((y-cur()).abs().max()))\n for fn in [cur]:\n  for _ in range(2):fn()\n  ts=[]\n  for _ in range(10):t=time.process_time_ns();y=fn();ts.append((time.process_time_ns()-t)/1e6)\n  print('cur',sum(ts)/len(ts))\nPY\npython /tmp/bench_tri.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

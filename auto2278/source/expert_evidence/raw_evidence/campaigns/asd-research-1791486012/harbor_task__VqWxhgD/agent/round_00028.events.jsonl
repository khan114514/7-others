{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/paneltest.py <<'PY'\nimport torch,time,math\nfrom importlib.machinery import SourceFileLoader\nm=SourceFileLoader('m','/workspace/solution/method.py').load_module();torch.set_num_threads(1);torch.set_num_interop_threads(1)\nfor l,h,c in [(128,10,640),(128,20,1280),(256,20,1280),(256,10,640)]:\n g=torch.Generator().manual_seed(5); x=torch.randn(1,l,c,generator=g);wq=torch.randn(h,64,c,generator=g)/math.sqrt(c);wk=torch.randn(h,64,c,generator=g);q,k,v,G=m.project_qkv(x,wq,wk,wk,True);lo=q @ k.transpose(-1,-2)/8;p0=lo.softmax(-1);p1=torch.lerp(lo,lo.transpose(-1,-2),-.05).softmax(-1);F,_=torch.linalg.cholesky_ex(G,check_errors=False);co=torch.cat((p1,p0),1).reshape(1,2*h*l,l)\n print('CASE',l,h)\n for bs in [32,48,64,96,128,256]:\n  def fn():\n   out=co.new_zeros((co.shape[1],1))\n   for s in range(0,l,bs):\n    e=min(s+bs,l); z=torch.mm(co[0,:,s:],F[0,s:,s:e]);out.add_(z.norm(dim=-1,keepdim=True).square_())\n   return out.unsqueeze(0)\n  [fn() for _ in range(3)];ts=[]\n  for _ in range(20):t=time.process_time_ns();fn();ts.append((time.process_time_ns()-t)/1e6)\n  print(bs,sum(ts)/20)\nPY\npython /tmp/paneltest.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

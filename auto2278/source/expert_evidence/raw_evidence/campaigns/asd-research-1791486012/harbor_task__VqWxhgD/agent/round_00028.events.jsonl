{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/compare.py <<'PY'\nimport torch,time,math\nfrom importlib.machinery import SourceFileLoader\nm=SourceFileLoader('m','/workspace/solution/method.py').load_module();torch.set_num_threads(1);torch.set_num_interop_threads(1)\ndef tm(fn,n=10):\n for _ in range(3):fn()\n z=[]\n for _ in range(n):t=time.process_time_ns();y=fn();z.append((time.process_time_ns()-t)/1e6)\n return sum(z)/len(z),y\nfor b,l,c,h,d in [(1,128,640,10,64),(1,128,1280,20,64),(1,256,1280,20,64),(1,256,640,10,64)]:\n g=torch.Generator().manual_seed(2);x=torch.randn(b,l,c,generator=g);wq=torch.randn(h,d,c,generator=g)/math.sqrt(c);wk=torch.randn(h,d,c,generator=g)/math.sqrt(c);wv=torch.randn(h,d,c,generator=g)/math.sqrt(c);q,k,v,G=m.project_qkv(x,wq,wk,wv,False);log=q @ k.transpose(-1,-2)/8;p0=log.softmax(-1);p1=torch.lerp(log,log.transpose(-1,-2),-.1).softmax(-1);F,_=torch.linalg.cholesky_ex(torch.bmm(x,x.transpose(-1,-2)),check_errors=False);co=torch.cat((p1,p0),1).reshape(b,2*h*l,l)\n def fact():\n  torch.lerp(p0,p1,4.,out=p0); z=m.factored_norms(torch.cat((p1,p0),1).reshape(b,2*h*l,l),F);r=z[:,:h*l].reshape(b,h,l,1).div_(z[:,h*l:].reshape(b,h,l,1)).clamp_(.0625,16).sqrt_(); y=torch.matmul(p0,v); y.mul_(r); return y\n def direct():\n  u1=torch.matmul(p1,x.unsqueeze(1)); u0=torch.matmul(p0,x.unsqueeze(1));u0.add_(u1-u0,alpha=4.);r=u1.norm(dim=-1,keepdim=True).clamp_min_(1e-6);r.div_(u0.norm(dim=-1,keepdim=True).clamp_min_(1e-6)).clamp_(.25,4.);u0.mul_(r);return torch.matmul(u0,wv.transpose(-1,-2))\n for fn in [fact,direct]:\n  t,y=tm(fn,10);print((l,c,h),fn.__name__,t)\n print('---')\nPY\npython /tmp/compare.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/mmtest.py <<'PY'\nimport torch,time,math\nfrom importlib.machinery import SourceFileLoader\nm=SourceFileLoader('m','/workspace/solution/method.py').load_module();torch.set_num_threads(1);torch.set_num_interop_threads(1)\nfor l,h,c in [(128,10,640),(128,20,1280),(256,20,1280),(256,10,640)]:\n g=torch.Generator().manual_seed(1);x=torch.randn(1,l,c,generator=g);wq=torch.randn(h,64,c,generator=g)/math.sqrt(c);wk=torch.randn(h,64,c,generator=g);q,k,v,G=m.project_qkv(x,wq,wk,wk,True);F,_=torch.linalg.cholesky_ex(G,check_errors=False);co=torch.randn(1,2*h*l,l);R=co.shape[1]\n def a():\n  out=co.new_zeros((R,1))\n  for s in range(0,l,64):\n   e=min(s+64,l); z=torch.mm(co[0,:,s:],F[0,s:,s:e]);out.add_(z.norm(dim=-1,keepdim=True).square_())\n  return out\n def b():\n  out=co.new_zeros((R,1))\n  for s in range(0,l,64):\n   e=min(s+64,l); z=torch.mm(F[0,s:,s:e].T,co[0,:,s:].T).T;out.add_(z.norm(dim=-1,keepdim=True).square_())\n  return out\n def cfn():\n  out=co.new_zeros((R,1))\n  for s in range(0,l,64):\n   e=min(s+64,l); z=torch.mm(co[0,:,s:].contiguous(),F[0,s:,s:e].contiguous());out.add_(z.norm(dim=-1,keepdim=True).square_())\n  return out\n print('case',l,h)\n for fn in [a,b,cfn]:\n  for _ in range(3):fn();ts=[]\n  for _ in range(20):t=time.process_time_ns();fn();ts.append((time.process_time_ns()-t)/1e6)\n  print(fn.__name__,sum(ts)/20)\nPY\npython /tmp/mmtest.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

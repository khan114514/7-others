{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/bench_norm.py <<'PY'\nimport torch,time,math\nfrom importlib.machinery import SourceFileLoader\nm=SourceFileLoader('m','/workspace/solution/method.py').load_module();torch.set_num_threads(1);torch.set_num_interop_threads(1)\nfor l,h in [(128,20),(256,20),(256,10),(128,10)]:\n c=1280 if h==20 else 640; g=torch.Generator().manual_seed(3); x=torch.randn(1,l,c,generator=g); wq=torch.randn(h,64,c,generator=g)/math.sqrt(c); wk=torch.randn(h,64,c,generator=g)/math.sqrt(c);wv=torch.randn(h,64,c,generator=g)/math.sqrt(c); q,k,v,G=m.project_qkv(x,wq,wk,wv,True);lo=q @ k.transpose(-1,-2)/8;p0=lo.softmax(-1);p1=torch.lerp(lo,lo.T,-.1).softmax(-1);F,_=torch.linalg.cholesky_ex(G,check_errors=False);co=torch.cat((p1,p0),1).reshape(1,2*h*l,l)\n def f_norm():\n  out=co.new_zeros((co.shape[1],1))\n  for s in range(0,l,64):\n   e=min(s+64,l); z=torch.mm(co[0,:,s:],F[0,s:,s:e]); out.add_(z.norm(dim=-1,keepdim=True).square_())\n  return out\n def f_sum():\n  out=co.new_zeros((co.shape[1],1))\n  for s in range(0,l,64):\n   e=min(s+64,l); z=torch.mm(co[0,:,s:],F[0,s:,s:e]); out.add_(z.square().sum(dim=-1,keepdim=True))\n  return out\n for f in [f_norm,f_sum]:\n  for _ in range(3):f();ts=[]\n  for _ in range(20):t=time.process_time_ns();y=f();ts.append((time.process_time_ns()-t)/1e6)\n  print(l,h,f.__name__,sum(ts)/len(ts),float((y-f_norm()).abs().max()))\nPY\npython /tmp/bench_norm.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/bench.py <<'PY'\nimport torch, math, time\nfrom importlib.machinery import SourceFileLoader\nm=SourceFileLoader('m','/workspace/solution/method.py').load_module()\ntorch.set_num_threads(1); torch.set_num_interop_threads(1)\nfor case in [(1,64,512,8,64),(1,128,640,10,64),(1,128,1280,20,64),(1,256,1280,20,64),(1,256,640,10,64)]:\n b,l,c,h,d=case; g=torch.Generator().manual_seed(123); x=torch.randn(b,l,c,generator=g); wq=torch.randn(h,d,c,generator=g)/math.sqrt(c); wk=torch.randn(h,d,c,generator=g)/math.sqrt(c); wv=torch.randn(h,d,c,generator=g)/math.sqrt(c)\n # reproduce internals\n q,k,v,gram=m.project_qkv(x,wq,wk,wv,True); logits=q @ k.transpose(-1,-2)/math.sqrt(d); p0=logits.softmax(-1); p1=torch.lerp(logits,logits.transpose(-1,-2),.5*(1-1.1)).softmax(-1)\n F,info=torch.linalg.cholesky_ex(gram,check_errors=False)\n co=torch.cat((p1,p0),1).reshape(b,2*h*l,l)\n def cur(): return m.factored_norms(co,F)\n def bmm():\n  out=co.new_zeros((b,2*h*l,1))\n  for s in range(0,l,64):\n   e=min(s+64,l); z=torch.bmm(co[:,:,s:],F[:,s:,s:e]); out.add_(z.square().sum(-1,keepdim=True))\n  return out\n def mmfull():\n  out=co.new_zeros((2*h*l,1))\n  for s in range(0,l,64):\n   e=min(s+64,l); z=torch.mm(co[0,:,s:],F[0,s:,s:e]); out.add_(z.square().sum(-1,keepdim=True))\n  return out.unsqueeze(0)\n def splitdiag():\n  out=co.new_zeros((2*h*l,1))\n  for s in range(0,l,64):\n   e=min(s+64,l); z=torch.mm(co[0,:,s:e],F[0,s:e,s:e]); out.add_(z.square().sum(-1,keepdim=True))\n   if e<l:\n    z=torch.mm(co[0,:,e:],F[0,e:,s:e]); out.add_(z.square().sum(-1,keepdim=True))\n  return out.unsqueeze(0)\n for fn in [cur,mmfull,bmm,splitdiag]:\n  for _ in range(3): fn()\n  ts=[]\n  for _ in range(20):\n   t=time.process_time_ns(); y=fn(); ts.append((time.process_time_ns()-t)/1e6)\n  print(case,fn.__name__,sum(ts)/len(ts), 'maxdiff',float((y-cur()).abs().max()))\nPY\npython /tmp/bench.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

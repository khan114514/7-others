{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/sh -lc \"PYTHONDONTWRITEBYTECODE=1 python - <<'PY'\nimport sys, json, math, time\nimport torch\nsys.path.insert(0, '/workspace/solution')\nimport method\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\nprotocol=json.load(open('/workspace/environment/public_assets/dev/protocol.json'))\n\ndef separate(x,wq,wk,wv,need_gram=False):\n    b,l,c=x.shape\n    h,d,_=wq.shape\n    xt=x.transpose(1,2)\n    result=[]\n    for w in (wq,wk,wv):\n        z=torch.matmul(w.reshape(h*d,c),xt)\n        result.append(z.reshape(b,h,d,l).transpose(2,3))\n    gram=torch.bmm(x,xt) if need_gram else None\n    return *result,gram\n\ndef left(x,wq,wk,wv,need_gram=False):\n    b,l,c=x.shape\n    h,d,_=wq.shape\n    rows=h*d\n    weights=torch.cat((wq.reshape(rows,c),wk.reshape(rows,c),wv.reshape(rows,c),x.reshape(l,c)),0)\n    z=torch.mm(x.reshape(l,c),weights.t())\n    q,k,v=z[:,:3*rows].reshape(b,l,3,h,d).permute(2,0,3,1,4).contiguous().unbind(0)\n    gram=z[:,3*rows:].unsqueeze(0)\n    return q,k,v,gram\n\nwith torch.inference_mode():\n    for idx,c in enumerate(protocol['cases'][:5]):\n        g=torch.Generator().manual_seed(17*1009+idx)\n        b,l,ch,h,d=[c[k] for k in ('batch','length','channels','heads','dim')]\n        x=torch.randn(b,l,ch,generator=g)\n        ws=[torch.randn(h,d,ch,generator=g)/math.sqrt(ch) for _ in range(3)]\n        expected=method.project_qkv(x,*ws,True)\n        record={'case':idx,'shape':[b,l,ch,h,d]}\n        for name,fn in [('fused_right',method.project_qkv),('separate_right',separate),('fused_left_copy',left)]:\n            actual=fn(x,*ws,True)\n            record[name+'_error']=max((a-e).abs().max().item() for a,e in zip(actual,expected))\n            for _ in range(3):fn(x,*ws,True)\n            times=[]\n            for _ in range(3):\n                start=time.process_time_ns()\n                for _ in range(5):fn(x,*ws,True)\n                times.append((time.process_time_ns()-start)/5e6)\n            record[name+'_ms']=sorted(times)[1]\n        print(json.dumps(record),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/sh -lc \"PYTHONDONTWRITEBYTECODE=1 python - <<'PY'\nimport sys,time,json,torch\nsys.path.insert(0,'/workspace/solution')\nimport method\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\ndef tiled(coeff,factor,block,rows_per_tile):\n    b,rows,l=coeff.shape\n    result=coeff.new_empty((b,rows,1))\n    for row_start in range(0,rows,rows_per_tile):\n        row_end=min(row_start+rows_per_tile,rows)\n        subset=coeff[:,:,row_start:row_end] if False else coeff[:,row_start:row_end,:]\n        norms=subset.new_zeros((b,row_end-row_start,1))\n        for start in range(0,l,block):\n            end=min(start+block,l)\n            p=torch.bmm(subset[:,:,start:],factor[:,start:,start:end])\n            norms.add_(p.norm(dim=-1,keepdim=True).square_())\n        result[:,row_start:row_end]=norms\n    return result.clamp_min_(1e-12)\n\nwith torch.inference_mode():\n    for h,l in [(10,128),(20,128),(20,256),(10,256)]:\n        g=torch.Generator().manual_seed(17311+h+l)\n        x=torch.randn(1,l,5*l,generator=g)\n        gram=x @ x.transpose(-1,-2)\n        factor=torch.linalg.cholesky(gram)\n        coeff=torch.randn(1,2*h*l,l,generator=g).softmax(-1)\n        reference=method.factored_norms(coeff,factor)\n        record={'heads':h,'length':l}\n        choices=[('current',lambda:method.factored_norms(coeff,factor)),('panel128',lambda:tiled(coeff,factor,128,2*h*l)),('row1024_panel64',lambda:tiled(coeff,factor,64,1024)),('row1024_panel32',lambda:tiled(coeff,factor,32,1024)),('row1024_full',lambda:tiled(coeff,factor,l,1024))]\n        for name,fn in choices:\n            record[name+'_error']=(fn()-reference).abs().max().item()\n            for _ in range(2):fn()\n            times=[]\n            for _ in range(3):\n                st=time.process_time_ns()\n                for _ in range(4):fn()\n                times.append((time.process_time_ns()-st)/4e6)\n            record[name+'_ms']=sorted(times)[1]\n        print(json.dumps(record),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/factsparse.py <<'PY'\nimport torch,time\nfrom statistics import median\ntorch.set_num_threads(1);torch.set_num_interop_threads(1)\ndef med(f,n=25):\n for _ in range(3):f()\n a=[]\n for _ in range(n):\n  s=time.process_time_ns();f();a.append((time.process_time_ns()-s)/1e6)\n return median(a)\nfor l,h,panel in [(128,10,48),(128,20,48),(256,20,48),(256,10,48),(256,20,64)]:\n c=640 if h==10 else 1280\n x=torch.randn(1,l,c);F,_=torch.linalg.cholesky_ex(torch.bmm(x,x.transpose(-1,-2)),check_errors=False);co=torch.randn(1,2*h*l,l)\n def full():\n  out=torch.zeros(2*h*l,1)\n  for st in range(0,l,panel):\n   en=min(st+panel,l);z=torch.mm(co[0,:,st:],F[0,st:,st:en]);out.add_(z.norm(dim=-1,keepdim=True).square_())\n  return out\n def split():\n  out=torch.zeros(2*h*l,1)\n  for st in range(0,l,panel):\n   en=min(st+panel,l); \n   z=torch.mm(co[0,:,st:en],F[0,st:en,st:en]);z.add_(torch.mm(co[0,:,en:],F[0,en:,st:en]));out.add_(z.norm(dim=-1,keepdim=True).square_())\n  return out\n def split2():\n  out=torch.zeros(2*h*l,1)\n  for st in range(0,l,panel):\n   en=min(st+panel,l); z=torch.mm(co[0,:,st:],F[0,st:,st:en]); out.add_(z.norm(dim=-1,keepdim=True).square_())\n  return out\n print(l,h,panel,med(full),med(split),med(split2))\nPY\npython /tmp/factsparse.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/benchops.py <<'PY'\nimport torch, math, time, importlib.util\nspec=importlib.util.spec_from_file_location('m','/workspace/solution/method.py');m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)\ntorch.set_num_threads(1);torch.set_num_interop_threads(1)\ncases=[(1,64,512,8,64),(1,128,640,10,64),(1,128,1280,20,64),(1,256,1280,20,64),(1,256,640,10,64)]\ndef med(f,n=20):\n for _ in range(3): f()\n a=[]\n for _ in range(n):\n  s=time.process_time_ns();f();a.append((time.process_time_ns()-s)/1e6)\n return sorted(a)[n//2]\nfor idx,(b,l,c,h,d) in enumerate(cases):\n g=torch.Generator().manual_seed(101+idx);x=torch.randn(b,l,c,generator=g);ws=[torch.randn(h,d,c,generator=g)/math.sqrt(c) for _ in range(3)]\n q,k,v,gram=m.project_qkv(x,*ws,True)\n logits=torch.matmul(q,k.transpose(-1,-2)).div_(math.sqrt(d))\n p0=logits.softmax(-1); p1=torch.lerp(logits,logits.transpose(-1,-2),.5*(1-1.1)).softmax(-1)\n G=torch.bmm(x,x.transpose(-1,-2)); F,info=torch.linalg.cholesky_ex(G,check_errors=False)\n coeff=torch.cat((p1,p0),dim=1)\n # methods\n def direct():\n  a=torch.matmul(p1,x.unsqueeze(1)); b0=torch.matmul(p0,x.unsqueeze(1)); return a.norm(dim=-1),b0.norm(dim=-1)\n def gram():\n  def gn(p):\n   co=p.reshape(b,h*l,l);return torch.bmm(co,G).mul_(co).sum(-1).sqrt()\n  return gn(p1),gn(p0)\n def fact(panel=64, mm2=True):\n  co=coeff.reshape(b,2*h*l,l)\n  out=co.new_zeros((b,2*h*l,1))\n  if b==1 and mm2:\n   out2=co.new_zeros((2*h*l,1))\n   for st in range(0,l,panel):\n    en=min(st+panel,l); z=torch.mm(co[0,:,st:],F[0,st:,st:en]); out2.add_(z.norm(dim=-1,keepdim=True).square_())\n   return out2\n  for st in range(0,l,panel):\n   en=min(st+panel,l);z=torch.bmm(co[:,:,st:],F[:,st:,st:en]);out.add_(z.norm(dim=-1,keepdim=True).square_())\n  return out\n print('case',idx,'prep', 'proj',med(lambda:m.project_qkv(x,*ws,True),10),'logits',med(lambda:torch.matmul(q,k.trans
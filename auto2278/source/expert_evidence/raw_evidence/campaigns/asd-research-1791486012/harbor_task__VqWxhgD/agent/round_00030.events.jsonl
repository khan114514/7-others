{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/bench_proj2.py <<'PY'\nimport torch,math,time\nfrom importlib.util import spec_from_file_location,module_from_spec\nsp=spec_from_file_location('m','/workspace/solution/method.py');m=module_from_spec(sp);sp.loader.exec_module(m)\ntorch.set_num_threads(1);torch.set_num_interop_threads(1)\ncases=[(1,64,512,8,64),(1,128,640,10,64),(1,128,1280,20,64),(1,256,1280,20,64),(1,256,640,10,64),(2,128,512,8,64)]\nfor ci,(b,l,c,h,d) in enumerate(cases[:-1]):\n g=torch.Generator().manual_seed(17*1009+ci);x=torch.randn(b,l,c,generator=g); wq=torch.randn(h,d,c,generator=g);wk=torch.randn(h,d,c,generator=g);wv=torch.randn(h,d,c,generator=g)\n def left():\n  maps=(wq.reshape(h*d,c),wk.reshape(h*d,c),wv.reshape(h*d,c)); weights=torch.cat((*maps,x.reshape(l,c)),dim=0)\n  projected=torch.mm(weights,x.reshape(l,c).t())\n  q,k,v=projected[:3*h*d].reshape(3,b,h,d,l).transpose(3,4).unbind(0)\n  gram=projected[3*h*d:].unsqueeze(0)\n  return q,k,v,gram\n def right():\n  maps=(wq.reshape(h*d,c),wk.reshape(h*d,c),wv.reshape(h*d,c)); weights=torch.cat((*maps,x.reshape(l,c)),dim=0)\n  projected=torch.mm(x.reshape(l,c),weights.t())\n  q,k,v=projected[:,:3*h*d].reshape(b,l,3,h,d).permute(2,0,3,1,4).unbind(0)\n  gram=projected[:,3*h*d:].unsqueeze(0)\n  return q,k,v,gram\n print('\\\\n',ci)\n for n,f in [('cur',lambda:m.project_qkv(x,wq,wk,wv,True)),('left',left),('right',right)]:\n  for _ in range(3):f()\n  ts=[]\n  for j in range(15):\n   t=time.process_time_ns();f();ts.append((time.process_time_ns()-t)/1e6)\n  print(n,sorted(ts)[7],sum(ts)/15)\nPY\npython /tmp/bench_proj2.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

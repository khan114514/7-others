{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/bench_paths.py <<'PY'\nimport torch, math,time,importlib.util,pathlib,statistics\nsrc=pathlib.Path('/workspace/solution/method.py').read_text()\nvariants={'cur':src,\n'nofact':src.replace('if heads >= 4 and length >= 128:', 'if False and heads >= 4 and length >= 128:'),\n'nogram':src.replace('use_gram = 2 * length + dim + channels / heads < 2 * channels','use_gram = False'),\n'gram64':src.replace('panel = 64 if heads >= 20 else 48','panel = 64').replace('panel = 48 if b == 1 and length >= 128 else 64','panel = 64'),\n'factor_all':src.replace('if heads >= 4 and length >= 128:', 'if True and length >= 128:')}\ntorch.set_num_threads(1);torch.set_num_interop_threads(1)\nmods={}\nfor n,s in variants.items():\n p='/tmp/mp_'+n+'.py';open(p,'w').write(s);sp=importlib.util.spec_from_file_location(n,p);m=importlib.util.module_from_spec(sp);sp.loader.exec_module(m);mods[n]=m\ncases=[(1,64,512,8,64,1.05,5),(1,128,640,10,64,1.1,4),(1,128,1280,20,64,1.15,3),(1,256,1280,20,64,1.05,7.5),(1,256,640,10,64,1.2,5),(2,128,512,8,64,1.,5)]\nfor ci,(b,l,c,h,d,a,be) in enumerate(cases):\n g=torch.Generator().manual_seed(170+ci*1009);x=torch.randn(b,l,c,generator=g);ws=[torch.randn(h,d,c,generator=g)/math.sqrt(c) for _ in range(3)]\n print('CASE',ci,(b,l,c,h), flush=True)\n outs={}\n for n,m in mods.items():\n  try:\n   for _ in range(3):outs[n]=m.attention(x,*ws,a,be)\n   ts=[]\n   for _ in range(20):\n    t=time.process_time_ns();o=m.attention(x,*ws,a,be);ts.append((time.process_time_ns()-t)/1e6)\n   e=(o-outs['cur']).abs().max().item() if 'cur' in outs else 0\n   print(n,'med',statistics.median(ts),'mean',statistics.mean(ts),'err',e,flush=True)\n  except Exception as e: print(n,'ERR',repr(e),flush=True)\nPY\npython /tmp/bench_paths.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

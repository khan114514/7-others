{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/bench_one.py <<'PY'\nimport torch, math,time,importlib.util,pathlib,statistics,sys\nname=sys.argv[1]; path='/tmp/ms_'+name+'.py'; sp=importlib.util.spec_from_file_location(name,path);m=importlib.util.module_from_spec(sp);sp.loader.exec_module(m)\ntorch.set_num_threads(1);torch.set_num_interop_threads(1)\ncases=[(1,64,512,8,64),(1,128,640,10,64),(1,128,1280,20,64),(1,256,1280,20,64),(1,256,640,10,64),(2,128,512,8,64)]\nci=int(sys.argv[2]);b,l,c,h,d=cases[ci];g=torch.Generator().manual_seed(1717);x=torch.randn(b,l,c,generator=g);ws=[torch.randn(h,d,c,generator=g)/math.sqrt(c)]\n# fix 3 ws\nws=[torch.randn(h,d,c,generator=g)/math.sqrt(c) for _ in range(3)]\nfor _ in range(8):m.attention(x,*ws,1.,5.)\nts=[]\nfor _ in range(100):\n t=time.process_time_ns();m.attention(x,*ws,1.,5.);ts.append((time.process_time_ns()-t)/1e6)\nprint(name,ci,'median',statistics.median(ts),'mean',statistics.mean(ts),'trim',statistics.mean(sorted(ts)[10:-10]))\nPY\nfor n in cur direct bmm; do for c in 0 1 2 3 4 5; do python /tmp/bench_one.py \"'$n $c; done; done'","aggregated_output":"","exit_code":null,"status":"in_progress"}}

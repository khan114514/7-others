{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/bench_orient_norm.py <<'PY'\nimport torch, math,time,importlib.util,pathlib,statistics\nsrc=pathlib.Path('/workspace/solution/method.py').read_text()\nold='''            projected = torch.mm(coefficients[0, :, start:], factor[0, start:, start:end])\n            # The norm kernel fuses the elementwise square and reduction,\n            # so only the short vector of panel norms needs to be squared.\n            squared.add_(projected.norm(dim=-1, keepdim=True).square_())\n'''\nnew='''            projected = torch.mm(factor[0, start:, start:end].t(),\n                                 coefficients[0, :, start:].t())\n            squared.add_(projected.square().sum(dim=0, keepdim=True).t())\n'''\nv=src.replace(old,new)\n# variant using norm along dim0\nnew2='''            projected = torch.mm(factor[0, start:, start:end].t(),\n                                 coefficients[0, :, start:].t())\n            squared.add_(projected.norm(dim=0, keepdim=True).square_().t())\n'''\nv2=src.replace(old,new2)\nvariants={'cur':src,'trans_sq':v,'trans_norm':v2}\ntorch.set_num_threads(1);torch.set_num_interop_threads(1)\nmods={}\nfor n,s in variants.items():\n p='/tmp/mn2_'+n+'.py';open(p,'w').write(s);sp=importlib.util.spec_from_file_location(n,p);m=importlib.util.module_from_spec(sp);sp.loader.exec_module(m);mods[n]=m\ncases=[(1,64,512,8,64,1.05,5),(1,128,640,10,64,1.1,4),(1,128,1280,20,64,1.15,3),(1,256,1280,20,64,1.05,7.5),(1,256,640,10,64,1.2,5),(2,128,512,8,64,1.,5)]\nfor ci,(b,l,c,h,d,a,be) in enumerate(cases):\n g=torch.Generator().manual_seed(170+ci*1009);x=torch.randn(b,l,c,generator=g);ws=[torch.randn(h,d,c,generator=g)/math.sqrt(c) for _ in range(3)]\n print('CASE',ci,(b,l,c,h), flush=True)\n outs={}\n for n,m in mods.items():\n  for _ in range(3):outs[n]=m.attention(x,*ws,a,be)\n  ts=[]\n  for _ in range(35):\n   t=time.process_time_ns();o=m.attention(x,*ws,a,be);ts.
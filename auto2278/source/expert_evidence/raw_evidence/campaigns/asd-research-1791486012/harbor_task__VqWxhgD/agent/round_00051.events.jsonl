ut.npz\"\n    # The prior input is read-only. Replace it instead of attempting to reopen it\n    # for writing when public grading runs as the unprivileged Agent user.\n    input_path.unlink(missing_ok=True)\n    arrays = {name: t.numpy() for name, t in zip((\"x\", \"wq\", \"wk\", \"wv\"), values[:4])}\n    np.savez(input_path, **arrays, alpha=values[4], beta=values[5],\n             warmup=protocol[\"warmup\"], repeats=protocol[\"timed_repeats\"])\n    input_path.chmod(0o444)\n    output_path.unlink(missing_ok=True)\n    try:\n        p = subprocess.run([sys.executable, \"-I\", str(ROOT / \"worker.py\"), str(source),\n                            str(input_path), str(output_path)], cwd=scratch,\n                           env={\"PATH\": os.environ.get(\"PATH\", \"/usr/local/bin:/usr/bin:/bin\"),\n                                \"HOME\": str(scratch), \"OMP_NUM_THREADS\": \"1\", \"OPENBLAS_NUM_THREADS\": \"1\",\n                                \"MKL_NUM_THREADS\": \"1\", \"PYTHONDONTWRITEBYTECODE\": \"1\"},\n                           preexec_fn=worker_limits, capture_output=True, text=True, timeout=120)\n    except subprocess.TimeoutExpired:\n        raise Invalid(\"timeout\", \"One case exceeded 120 seconds.\")\n    if p.returncode != 0:\n        for line in p.stdout.splitlines():\n            try:\n                report = json.loads(line)\n            except json.JSONDecodeError:\n                continue\n            if report.get(\"worker_failure\") in {\"hard_gate\", \"format_error\"}:\n                raise Invalid(report[\"worker_failure\"], report[\"message\"])\n        kind = \"resource_error\" if p.returncode < 0 else \"candidate_error\"\n        raise Invalid(kind, p.stderr[-2000:])\n    if not output_path.is_file() or output_path.is_symlink() or output_path.stat().st_size > 256 * 1024 * 1024:\n/workspace/environment/public_eval/baseline_method.py\n\"\"\"Direct, exact implementation of the published operator contract.\"\"\"\nimport math\nimport torch\n\n\n@torch.no_grad()\ndef attention(x, wq, wk, wv, alpha, beta):\n    q = torch.einsum(\"blc,hdc->bhld\", x, wq)\n    k = torch.einsum(\"blc,hdc->bhld\", x, wk)\n    logits = (q @ k.transpose(-1, -2)) / math.sqrt(wq.shape[1])\n    p0 = logits.softmax(dim=-1)\n    base = p0 @ x.unsqueeze(1)\n    if alpha == 1.0:\n        modified = base\n    else:\n        perturbed = .5 * (1 + alpha) * logits + .5 * (1 - alpha) * logits.transpose(-1, -2)\n        modified = perturbed.softmax(dim=-1) @ x.unsqueeze(1)\n    blended = base + beta * (modified - base)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    y = torch.einsum(\"bhlc,hdc->bhld\", blended * ratio, wv)\n    return y.transpose(1, 2).flatten(2).contiguous()\n/workspace/environment/public_eval/worker.py\n\"\"\"Protected subprocess launcher; candidate receives tensors, never expected outputs.\"\"\"\nimport importlib.util\nimport json\nimport os\nfrom pathlib import Path\nimport statistics\nimport sys\nimport time\nimport numpy as np\nimport torch\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\nsource, input_path, output_path = map(Path, sys.argv[1:4])\ndata = np.load(input_path, allow_pickle=False)\nvalues = [torch.from_numpy(data[name].copy()) for name in (\"x\", \"wq\", \"wk\", \"wv\")]\nvalues.extend([float(data[\"alpha\"]), float(data[\"beta\"])])\nspec = importlib.util.spec_from_file_location(\"candidate_method\", source)\nmodule = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(module)\nsamples = []\nwall_samples = []\nwith torch.inference_mode():\n    for _ in range(int(data[\"warmup\"])):\n        module.attention(*values)\n    for _ in range(int(data[\"repeats\"])):\n        start_wall = time.perf_counter_ns()\n        start = time.process_time_ns()\n        output = module.attention(*values)\n        samples.append((time.process_time_ns() - start) / 1e6)\n        wall_samples.append((time.perf_counter_ns() - start_wall) / 1e6)\n    # A fresh call with fresh tensors also rejects stale cached outputs.\n    output = module.attention(*[v.clone() if isinstance(v, torch.Tensor) else v for v in values])\ninput_unchanged = all(torch.equal(v, torch.from_numpy(data[name])) for name, v in zip((\"x\", \"wq\", \"wk\", \"wv\"), values[:4]))\nif not isinstance(output, torch.Tensor):\n    print(json.dumps({\"worker_failure\":\"format_error\",\"message\":\"attention must return a Tensor\"}),flush=True)\n    raise SystemExit(3)\nif output.dtype != torch.float32 or output.device.type != \"cpu\":\n    print(json.dumps({\"worker_failure\":\"hard_gate\",\"message\":\"output must remain float32 CPU\"}),flush=True)\n    raise SystemExit(3)\nnp.savez(output_path, output=output.detach().numpy(), samples=np.array(samples, dtype=np.float64),\n         wall_samples=np.array(wall_samples, dtype=np.float64), input_unchanged=input_unchanged)\nprint(json.dumps({\"median_ms\": statistics.median(samples), \"pid\": os.getpid()}), flush=True)\n","exit_code":0,"status":"completed"}}

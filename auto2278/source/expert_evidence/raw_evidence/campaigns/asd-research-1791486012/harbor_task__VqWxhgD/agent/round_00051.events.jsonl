{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/benchops.py <<'PY'\nimport torch,time,math,json\nfrom statistics import median\ntorch.set_num_threads(1);torch.set_num_interop_threads(1)\nfor case in json.load(open('/workspace/environment/public_assets/dev/protocol.json'))['cases']:\n g=torch.Generator().manual_seed(17); b,l,c,h,d=[case[k] for k in ('batch','length','channels','heads','dim')]; x=torch.randn(b,l,c,generator=g); ws=[torch.randn(h,d,c,generator=g)/math.sqrt(c) for _ in range(3)]; rows=h*d\n maps=[w.reshape(rows,c) for w in ws]; W=torch.cat((*maps,x.reshape(l,c)),0)\n ops={\n 'row':lambda: torch.mm(W,x.reshape(l,c).t()),\n 'col':lambda: torch.mm(x.reshape(l,c),W.t()),\n 'qkvrow':lambda: [torch.mm(w,x.reshape(l,c).t()) for w in maps],\n 'qkvcol':lambda: [torch.mm(x.reshape(l,c),w.t()) for w in maps],\n 'qvsep':lambda: [torch.mm(x.reshape(l,c),w.t()) for w in maps[:2]],\n }\n print('\\\\n',case,'W',W.shape)\n for name,f in ops.items():\n  for _ in range(5):f()\n  ts=[]\n  for i in range(30):\n   t=time.process_time_ns();f();ts.append((time.process_time_ns()-t)/1e6)\n  print(name,median(ts),sorted(ts)[:3],sorted(ts)[-3:])\nPY\npython /tmp/benchops.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

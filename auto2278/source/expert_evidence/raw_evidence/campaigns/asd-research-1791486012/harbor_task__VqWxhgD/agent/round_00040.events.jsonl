{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/sh -lc \"python -B - <<'PY'\nimport importlib.util, math, time, statistics\nimport torch\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\nspec=importlib.util.spec_from_file_location('candidate','/workspace/solution/method.py')\nm=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)\nwith torch.inference_mode():\n for length,channels,heads in ((128,640,10),(128,1280,20),(256,1280,20),(256,640,10)):\n    g=torch.Generator().manual_seed(1742)\n    x=torch.randn(1,length,channels,generator=g)\n    factor=torch.linalg.cholesky(x @ x.transpose(1,2))\n    co=torch.randn(1,2*heads*length,length,generator=g).softmax(-1)\n    expected=m.factored_norms(co,factor)\n    def inverse_solve():\n        inv=torch.linalg.solve_triangular(factor,torch.eye(length).unsqueeze(0),upper=False)\n        y=torch.linalg.solve_triangular(inv.transpose(1,2),co.transpose(1,2),upper=True).transpose(1,2)\n        return y.norm(dim=-1,keepdim=True).square_().clamp_min_(1e-12)\n    actual=inverse_solve()\n    print('shape',length,channels,heads,'relative error',float(((actual-expected).abs()/expected).max()),flush=True)\n    for name,fn in (('panels',lambda:m.factored_norms(co,factor)),('inverse_solve',inverse_solve)):\n        times=[]\n        for i in range(12):\n            start=time.process_time_ns();fn()\n            if i>=3:times.append((time.process_time_ns()-start)/1e6)\n        print(name,round(statistics.median(times),4),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.completed","item":{"id":"item_13","type":"agent_message","text":"The current method uses Gram matrices to compute retrieval norms. I’m checking whether processing a few heads at a time can reduce the large attention buffers while preserving the same algebra."}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/sh -lc \"python -B - <<'PY'\nimport importlib.util, json, math, time, statistics\nimport torch\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\nspec=importlib.util.spec_from_file_location('candidate','/workspace/solution/method.py')\nm=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)\ncases=json.load(open('/workspace/environment/public_assets/dev/protocol.json'))['cases']\n@torch.no_grad()\ndef retrieve(q,k,v,factor,a,beta,tile):\n    batch,heads,length,dim=q.shape\n    out=q.new_empty((batch,length,heads,dim))\n    for start in range(0,heads,tile):\n        end=min(start+tile,heads)\n        logits=torch.matmul(q[:,start:end], k[:,start:end].transpose(-1,-2)).div_(math.sqrt(dim))\n        p0=logits.softmax(-1)\n        p1=torch.lerp(logits,logits.transpose(-1,-2),.5*(1-a)).softmax(-1)\n        torch.lerp(p0,p1,beta,out=p0)\n        co=torch.cat((p1,p0),dim=1)\n        sq=m.factored_norms(co.reshape(batch,2*(end-start)*length,length),factor)\n        n=(end-start)*length\n        ratio=sq[:,:n].div_(sq[:,n:]).clamp_(.0625,16.).sqrt_().reshape(batch,end-start,length,1)\n        y=torch.matmul(co[:,end-start:],v[:,start:end]).mul_(ratio)\n        out[:,:,start:end]=y.transpose(1,2)\n    return out.flatten(2)\nwith torch.inference_mode():\n for i in (1,3,4):\n    c=cases[i];b,l,ch,h,d=[c[k] for k in ('batch','length','channels','heads','dim')]\n    g=torch.Generator().manual_seed(17*1009+i)\n    x=torch.randn(b,l,ch,generator=g)\n    ws=[torch.randn(h,d,ch,generator=g)/math.sqrt(ch) for _ in range(3)]\n    q,k,v,gram=m.project_qkv(x,*ws,True)\n    factor=torch.linalg.cholesky(gram)\n    expect=m.attention(x,*ws,c['alpha'],c['beta'])\n    print('case',i,flush=True)\n    for tile in (h,4,8):\n        got=retrieve(q,k,v,factor,c['alpha'],c['beta'],tile)\n        assert torch.allclose(got,expect,atol=3e-5,rtol=3e-4)\n        times=[]\n        for j in range(12):\n            start=time.process_time_ns();retrieve(q,k,v,factor,c['alpha'],c['beta'],tile)\n            if j>=3:times.append((time.process_time_ns()-start)/1e6)\n        print(tile, round(statistics.median(times),4),'error',float((got-expect).abs().max()),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

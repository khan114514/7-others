{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\n# show current exact source around factored path\nprint(open('/workspace/solution/method.py').read()[open('/workspace/solution/method.py').read().index('def factored_norms'):open('/workspace/solution/method.py').read().index('@torch.no_grad')])\nPY\"","aggregated_output":"def factored_norms(coefficients, factor):\n    b, rows, length = coefficients.shape\n    heads = rows // (2 * length)\n    if b == 1 and length >= 128 and heads >= 20:\n        # Keep the triangular reduction, but use 2-D matmuls to avoid the\n        # singleton batch overhead on the large-head path.\n        squared = coefficients.new_zeros((rows, 1))\n        for start in range(0, length, 64):\n            end = min(start + 64, length)\n            projected = torch.mm(coefficients[0, :, start:], factor[0, start:, start:end])\n            # The norm kernel fuses the elementwise square and reduction,\n            # so only the short vector of panel norms needs to be squared.\n            squared.add_(projected.norm(dim=-1, keepdim=True).square_())\n        return squared.unsqueeze(0).clamp_min_(1e-12)\n    squared = coefficients.new_zeros((b, rows, 1))\n    # G = F F^T, hence ||p x||^2 = ||p F||^2.  Only the\n    # rows on or below each diagonal block of F contribute.\n    for start in range(0, length, 64):\n        end = min(start + 64, length)\n        projected = torch.bmm(coefficients[:, :, start:],\n                              factor[:, start:, start:end])\n        squared.add_(projected.norm(dim=-1, keepdim=True).square_())\n    return squared.clamp_min_(1e-12)\n\n\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/bench.py <<'PY'\nimport torch, math, time, sys\nsys.path.insert(0,'/workspace/solution'); import method\n\ntorch.set_num_threads(1); torch.set_num_interop_threads(1)\ncases=[(1,64,512,8,64,1.05,5),(1,128,640,10,64,1.1,4),(1,128,1280,20,64,1.15,3),(1,256,1280,20,64,1.05,7.5),(1,256,640,10,64,1.2,5),(2,128,512,8,64,1,5)]\nvals=[]\nfor ci,(b,l,c,h,d,a,be) in enumerate(cases):\n g=torch.Generator().manual_seed(17*1009+ci);x=torch.randn(b,l,c,generator=g);ws=[torch.randn(h,d,c,generator=g)/math.sqrt(c) for _ in range(3)];vals.append((x,*ws,a,be))\n\ndef f_panel(coeff,factor,w):\n b,rows,length=coeff.shape;sq=coeff.new_zeros((b,rows,1))\n for st in range(0,length,w):\n  en=min(st+w,length)\n  z=torch.bmm(coeff[:,:,st:],factor[:,st:,st:en])\n  sq.add_(z.square().sum(-1,keepdim=True))\n return sq.clamp_min_(1e-12)\ndef f_mm_panel(coeff,factor,w):\n b,rows,length=coeff.shape;sq=coeff.new_zeros((b,rows,1))\n if b==1:\n  for st in range(0,length,w):\n   en=min(st+w,length);z=torch.mm(coeff[0,:,st:],factor[0,st:,st:en]);sq[0].add_(z.square().sum(-1,keepdim=True))\n else:\n  for st in range(0,length,w):\n   en=min(st+w,length);z=torch.bmm(coeff[:,:,st:],factor[:,st:,st:en]);sq.add_(z.square().sum(-1,keepdim=True))\n return sq.clamp_min_(1e-12)\ndef f_full(coeff,factor,w=None):\n b,rows,length=coeff.shape\n if b==1:z=torch.mm(coeff[0],factor[0]).unsqueeze(0)\n else:z=torch.bmm(coeff,factor)\n return z.square().sum(-1,keepdim=True).clamp_min_(1e-12)\ndef f_mm_panel2(coeff,factor,w):\n # mm after flattening b; only b1\n b,rows,length=coeff.shape;sq=coeff.new_zeros((b,rows,1))\n for st in range(0,length,w):\n  en=min(st+w,length);z=torch.mm(coeff[0,:,st:],factor[0,st:,st:en]);sq[0].add_(z.square().sum(-1,keepdim=True))\n return sq.clamp_min_(1e-12)\n\nfs={'cur':None,'bmm128':lambda c,f:f_panel(c,f,128),'bmm256':lambda c,f:f_panel(c,f,256),'mm64':lambda c,f:f_mm_panel(c,f,64),'mm128':lambda c,f:f_mm_panel(c,f,128),'mm256':lambda c,f:f_mm_panel(c,f,256),'full':lambda c,f:f_full(c,f,None)}\n# obtain factor and coefficients exactly by reimplementing up to factored path\nfor ci,v in enumerate(vals):\n x,wq,wk,wv,a,be=v;b,l,c=x.shape;h,d,_=wq.shape\n if a==1:continue\n weights=torch.cat((wq.reshape(h*d,c),wk.reshape(h*d,c),wv.reshape(h*d,c),x.reshape(l,c)),dim=0)\n pr=torch.mm(weights,x.reshape(l,c).t()); rows=h*d\n q,k,values=pr[:3*rows].reshape(3,b,h,d,l).transpose(3,4).unbind(0);gram=pr[3*rows:].unsqueeze(0)\n logits=torch.matmul(q,k.transpose(-1,-2)).div_(math.sqrt(d));p0=logits.softmax(-1);p1=torch.lerp(logits,logits.transpose(-1,-2),.5*(1-a)).softmax(-1)\n factor,info=torch.linalg.cholesky_ex(gram,check_errors=False)\n torch.lerp(p0,p1,be,out=p0);coeff=torch.cat((p1,p0),dim=1).reshape(b,2*h*l,l)\n print('\\\\ncase',ci,'coeff',coeff.shape)\n for name,fn in fs.items():\n  if fn is None: continue\n  for _ in range(5): fn(coeff,factor)\n  ts=[]\n  for _ in range(30):\n   st=time.process_time_ns(); z=fn(coeff,factor); ts.append((time.process_time_ns()-st)/1e6)\n  print(name,round(sorted(ts)[len(ts)//2],4), 'mean',round(sum(ts)/len(ts),4))\nPY\npython /tmp/bench.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

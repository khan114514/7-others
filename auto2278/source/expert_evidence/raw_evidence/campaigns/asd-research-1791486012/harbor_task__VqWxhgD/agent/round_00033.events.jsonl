{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/sh -lc \"cat >/tmp/bench_blocks.py <<'PY'\nimport torch,math,time,sys,statistics\nsys.path.insert(0,'/workspace/solution');import method\ntorch.set_num_threads(1);torch.set_num_interop_threads(1)\ndef mk(l,c,h,d,ci):\n g=torch.Generator().manual_seed(17*1009+ci);x=torch.randn(1,l,c,generator=g);ws=[torch.randn(h,d,c,generator=g)/math.sqrt(c) for _ in range(3)];rows=h*d;weights=torch.cat((*[w.reshape(rows,c) for w in ws],x.reshape(l,c)),0);pr=torch.mm(weights,x.t());q,k,v=pr[:3*rows].reshape(3,1,h,d,l).transpose(3,4).unbind(0);gr=pr[3*rows:].unsqueeze(0);f,_=torch.linalg.cholesky_ex(gr,check_errors=False);A=(q @ k.transpose(-1,-2)).div_(math.sqrt(d));p0=A.softmax(-1);p1=torch.lerp(A,A.transpose(-1,-2),.5*(1-(1.1 if l==128 else 1.05))).softmax(-1);torch.lerp(p0,p1,3,out=p0);return torch.cat((p1,p0),1).reshape(1,2*h*l,l),f\n\ndef run(co,f,w,kind):\n sq=co.new_zeros((co.shape[1],1))\n for st in range(0,co.shape[2],w):\n  en=min(st+w,co.shape[2]);z=torch.mm(co[0,:,st:],f[0,st:,st:en])\n  if kind=='norm':sq.add_(z.norm(dim=-1,keepdim=True).square_())\n  else:sq.add_(torch.linalg.vector_norm(z,dim=-1,keepdim=True).square_())\n return sq\nfor ci,args in enumerate([(128,640,10,64),(128,1280,20,64),(256,1280,20,64),(256,640,10,64)]):\n co,f=mk(*args,ci);print('case',ci)\n for kind in ['norm','linalg']:\n  for w in [16,24,32,40,48,56,64,72,80,96,112,128]:\n   for _ in range(4):run(co,f,w,kind)\n   ts=[]\n   for _ in range(18):\n    t=time.process_time_ns();run(co,f,w,kind);ts.append((time.process_time_ns()-t)/1e6)\n   print(kind,w,round(statistics.median(ts),3),end=' | ')\n  print()\nPY\npython /tmp/bench_blocks.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

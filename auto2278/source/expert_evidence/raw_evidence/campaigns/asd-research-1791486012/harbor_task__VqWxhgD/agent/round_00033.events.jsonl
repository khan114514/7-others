{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/bench_proj.py <<'PY'\nimport torch,math,time,sys,statistics\nsys.path.insert(0,'/workspace/solution');import method\n\ntorch.set_num_threads(1);torch.set_num_interop_threads(1)\ncases=[(1,64,512,8,64,1.05,5),(1,128,640,10,64,1.1,4),(1,128,1280,20,64,1.15,3),(1,256,1280,20,64,1.05,7.5),(1,256,640,10,64,1.2,5)]\nvals=[]\nfor ci,(b,l,c,h,d,a,be) in enumerate(cases):\n g=torch.Generator().manual_seed(17*1009+ci);x=torch.randn(b,l,c,generator=g);ws=[torch.randn(h,d,c,generator=g)/math.sqrt(c) for _ in range(3)];\n weights=torch.cat((*[z.reshape(h*d,c) for z in ws],x.reshape(l,c)),0);maps=weights\n vals.append((x,ws,a,be,weights))\n\ndef p_left(x,ws,weights):\n b,l,c=x.shape;h,d,_=ws[0].shape;rows=h*d;pr=torch.mm(weights,x.reshape(l,c).t());q,k,v=pr[:3*rows].reshape(3,b,h,d,l).transpose(3,4).unbind(0);return q,k,v,pr[3*rows:].unsqueeze(0)\ndef p_right(x,ws,weights):\n b,l,c=x.shape;h,d,_=ws[0].shape;rows=h*d;pr=torch.mm(x.reshape(l,c),weights.t());q,k,v=pr[:,:3*rows].reshape(b,l,3,h,d).permute(2,0,3,1,4).unbind(0);return q,k,v,pr[:,3*rows:].transpose(0,1)\nfor ci,(x,ws,a,be,w) in enumerate(vals):\n print('\\\\ncase',ci,'w',w.shape)\n for n,f in [('left',p_left),('right',p_right)]:\n  for _ in range(5):f(x,ws,w)\n  ts=[]\n  for _ in range(50):\n   t=time.process_time_ns();f(x,ws,w);ts.append((time.process_time_ns()-t)/1e6)\n  print(n,'proj',round(statistics.median(ts),4),round(statistics.mean(ts),4))\n # whole attention monkeypatch\n orig=method.project_qkv\n def pp(x2,wq,wk,wv,need_gram=False, f=f):\n  b,l,c=x2.shape;h,d,_=wq.shape;rows=h*d;maps=torch.cat((*[z.reshape(rows,c) for z in (wq,wk,wv)],x2.reshape(l,c)),0) if need_gram else torch.cat((*[z.reshape(rows,c) for z in (wq,wk,wv)],),0)\n  if need_gram:\n   q,k,v,g=f(x2,[wq,wk,wv],maps)\n   return q,k,v,g\n  # fallback same current not reached\n  return orig(x2,wq,wk,wv,need_gram)\n for n,f in [('left',p_left),(
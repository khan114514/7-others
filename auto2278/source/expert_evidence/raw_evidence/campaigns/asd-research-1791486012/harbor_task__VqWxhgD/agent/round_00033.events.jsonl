{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/bench_norm.py <<'PY'\nimport torch,time,math,sys,statistics\nsys.path.insert(0,'/workspace/solution');import method\n\ntorch.set_num_threads(1);torch.set_num_interop_threads(1)\ndef mk(ci):\n b,l,c,h,d,a,be=[(1,128,640,10,64,1.1,4),(1,128,1280,20,64,1.15,3),(1,256,1280,20,64,1.05,7.5),(1,256,640,10,64,1.2,5)][ci]\n g=torch.Generator().manual_seed(17*1009+ci);x=torch.randn(b,l,c,generator=g);w=[torch.randn(h,d,c,generator=g)/math.sqrt(c) for _ in range(3)]\n weights=torch.cat((*[z.reshape(h*d,c) for z in w],x.reshape(l,c)),0); pr=torch.mm(weights,x.reshape(l,c).t());rows=h*d\n q,k,v=pr[:3*rows].reshape(3,b,h,d,l).transpose(3,4).unbind(0);gram=pr[3*rows:].unsqueeze(0);f,_=torch.linalg.cholesky_ex(gram,check_errors=False);lo=(q @ k.transpose(-1,-2)).div_(math.sqrt(d)); p0=lo.softmax(-1); p1=torch.lerp(lo,lo.transpose(-1,-2),.5*(1-a)).softmax(-1);torch.lerp(p0,p1,be,out=p0);coef=torch.cat((p1,p0),1).reshape(b,2*h*l,l)\n return coef,f\n\ndef run(coef,f,kind):\n sq=coef.new_zeros((coef.shape[1],1))\n for st in range(0,coef.shape[2],64):\n  en=min(st+64,coef.shape[2]);z=torch.mm(coef[0,:,st:],f[0,st:,st:en])\n  if kind=='norm': q=z.norm(dim=-1,keepdim=True).square_()\n  elif kind=='linalg': q=torch.linalg.vector_norm(z,dim=-1,keepdim=True).square_()\n  elif kind=='sqsum':q=z.square().sum(-1,keepdim=True)\n  elif kind=='muladd':q=(z*z).sum(-1,keepdim=True)\n  sq.add_(q)\n return sq\nfor ci in range(4):\n co,f=mk(ci);print('case',ci,co.shape)\n outs={}\n for k in ['norm','linalg','sqsum','muladd']:\n  for _ in range(5):run(co,f,k)\n  ts=[]\n  for _ in range(40):\n   t=time.process_time_ns();o=run(co,f,k);ts.append((time.process_time_ns()-t)/1e6)\n  outs[k]=o\n  print(k,round(statistics.median(ts),4),round(statistics.mean(ts),4))\n print('maxerr sqsum norm',float((outs['sqsum']-outs['norm']).abs().max()))\nPY\npython /tmp/bench_norm.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

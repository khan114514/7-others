{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch, math\nimport sys\n\n# check more carefully - is the issue in the softmax computation?\nsys.path.insert(0, 'environment/starter')\nimport importlib.util\nspec = importlib.util.spec_from_file_location('starter_method', 'environment/starter/method.py')\nstarter = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(starter)\n\ntorch.manual_seed(42)\nB, L, C, H, D = 2, 64, 128, 4, 32\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\nalpha, beta = 1.0, 1.0\n\n# Compute step by step for solution method\nfrom method import attention\nwith torch.no_grad():\n    # solution method\n    xr = x.reshape(B*L, C)\n    HD = H*D\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    \n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(1.0/math.sqrt(D))\n    \n    p0 = logits.view(B*H*L, L).softmax(dim=-1).view(B, H, L, L)\n    \n    y = p0 @ v\n    result_sol = y.transpose(1, 2).flatten(2).contiguous()\n    \n    # starter\n    qs = torch.einsum('blc,hdc->bhld', x, wq)\n    ks = torch.einsum('blc,hdc->bhld', x, wk)\n    logits_s = (qs @ ks.transpose(-1, -2)) / math.sqrt(D)\n    p0_s = logits_s.softmax(dim=-1)\n    base_s = p0_s @ x.unsqueeze(1)\n    y_s = torch.einsum('bhlc,hdc->bhld', base_s, wv)\n    result_starter = y_s.transpose(1, 2).flatten(2).contiguous()\n    \n    print('p0 diff:', (p0 - p0_s).abs().max().item())\n    print('logits diff:', (logits - logits_s).abs().max().item())\n    print('q diff:', (q - qs).abs().max().item())\n    print('final diff:', (result_sol - result_starter).abs().max().item())\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

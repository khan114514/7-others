{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/bench_ops.py << 'PYEOF'\nimport torch, math, time\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\ndef bench(fn, n=20):\n    fn()  # warmup\n    fn()\n    fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    return (t1 - t0) / n / 1e6  # ms\n\ncases = [\n    (1, 64, 512, 8, 64, 1.05, 5.0),\n    (1, 128, 640, 10, 64, 1.1, 4.0),\n    (1, 128, 1280, 20, 64, 1.15, 3.0),\n    (1, 256, 1280, 20, 64, 1.05, 7.5),\n    (1, 256, 640, 10, 64, 1.2, 5.0),\n    (2, 128, 512, 8, 64, 1.0, 5.0),\n]\n\nfor B, L, C, H, D, alpha, beta in cases:\n    x = torch.randn(B, L, C)\n    wq = torch.randn(H, D, C)\n    wk = torch.randn(H, D, C)\n    wv = torch.randn(H, D, C)\n    \n    isd = 1.0 / math.sqrt(D)\n    \n    # Current approach: 3 separate projections\n    def current_proj():\n        xr = x.reshape(B*L, C)\n        q = (xr @ wq.reshape(H*D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n        k = (xr @ wk.reshape(H*D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n        v = (xr @ wv.reshape(H*D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n        return q, k, v\n    \n    # Fused QKV projection\n    wqkv = torch.cat([wq.reshape(H*D, C), wk.reshape(H*D, C), wv.reshape(H*D, C)], dim=0)\n    def fused_proj():\n        xr = x.reshape(B*L, C)\n        qkv = (xr @ wqkv.T).reshape(B, L, 3*H*D)\n        q, k, v = qkv.chunk(3, dim=-1)\n        q = q.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n        k = k.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n        v = v.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n        return q, k, v\n    \n    q, k, v = current_proj()\n    logits = q @ k.transpose(-1, -2) * isd\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5*(1+alpha)\n    a_m = 0.5*(1-alpha)\n    p1 = (a_p*logits + a_m*logits.transpose(-1,-2)).softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    \n    # Norm via Gram\n    def norm_gram():\n        p1G = p1 @ G_exp\n        norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n        return norm1_sq, normm_sq\n    \n    # Norm via direct p@x\n    x_exp = x.unsqueeze(1)\n    def norm_direct():\n        u1 = p1 @ x_exp\n        m = p_mix @ x_exp\n        norm1_sq = (u1 * u1).sum(dim=-1, keepdim=True)\n        normm_sq = (m * m).sum(dim=-1, keepdim=True)\n        return norm1_sq, normm_sq\n    \n    t_curr_proj = bench(current_proj, n=30)\n    t_fused_proj = bench(fused_proj, n=30)\n    t_gram = bench(norm_gram, n=30)\n    t_direct = bench(norm_direct, n=30)\n    t_logits = bench(lambda: q @ k.transpose(-1,-2), n=30)\n    t_pmv = bench(lambda: p_mix @ v, n=30)\n    t_p0 = bench(lambda: logits.softmax(dim=-1), n=30)\n    t_G = bench(lambda: x @ x.transpose(-1, -2), n=30)\n    t_p1G = bench(lambda: p1 @ G_exp, n=30)\n    \n    total = t_curr_proj + t_logits + t_p0*2 + t_gram + t_pmv + t_G\n    print(f\\\"B{B} L{L} C{C} H{H} D{D}:\\\")\n    print(f\\\"  proj(sep): {t_curr_proj:.2f}ms, proj(fused): {t_fused_proj:.2f}ms ({t_fused_proj/t_curr_proj:.3f})\\\")\n    print(f\\\"  logits: {t_logits:.2f}ms, softmax(x2): {t_p0*2:.2f}ms, p_mix@v: {t_pmv:.2f}ms\\\")\n    print(f\\\"  G: {t_G:.2f}ms, p1@G: {t_p1G:.2f}ms, gram_norm: {t_gram:.2f}ms, direct_norm: {t_direct:.2f}ms\\\")\n    print(f\\\"  est_total: {total:.2f}ms\\\")\n    print()\n\nPYEOF\npython /tmp/bench_ops.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

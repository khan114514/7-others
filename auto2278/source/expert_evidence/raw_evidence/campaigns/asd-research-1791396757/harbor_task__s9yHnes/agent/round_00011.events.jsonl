{"type":"item.completed","item":{"id":"item_13","type":"agent_message","text":"Interesting — the no-pmix approach saves one large p@G matmul but adds one p@v matmul, with mixed results. The projections (q, k, v) are actually the dominant cost. Let me try fusing QKV projections into a single GEMM and explore other micro-optimizations.\n"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/bench_opt2.py << 'PYEOF'\nimport math\nimport time\nimport torch\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\ndef ref_attention(x, wq, wk, wv, alpha, beta):\n    q = torch.einsum(\\\"blc,hdc->bhld\\\", x, wq)\n    k = torch.einsum(\\\"blc,hdc->bhld\\\", x, wk)\n    logits = (q @ k.transpose(-1, -2)) / math.sqrt(wq.shape[1])\n    p0 = logits.softmax(dim=-1)\n    base = p0 @ x.unsqueeze(1)\n    if alpha == 1.0:\n        modified = base\n    else:\n        perturbed = .5 * (1 + alpha) * logits + .5 * (1 - alpha) * logits.transpose(-1, -2)\n        modified = perturbed.softmax(dim=-1) @ x.unsqueeze(1)\n    blended = base + beta * (modified - base)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    y = torch.einsum(\\\"bhlc,hdc->bhld\\\", blended * ratio, wv)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ndef current_best(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wv.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n\n    logits = q @ k.transpose(-1, -2) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n\n        p1G = p1 @ G_exp\n        norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n\n        pmG = p_mix @ G_exp\n        normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n\n        norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n        normm = normm_sq.sqrt().clamp_min(1e-6)\n        ratio = (norm1 / normm).clamp(0.25, 4.0)\n\n        y = (p_mix @ v) * ratio\n\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ndef opt_fused_qkv(x, wq, wk, wv, alpha, beta):\n    \\\"\\\"\\\"Fuse Q, K, V projections into single GEMM via stacked weights.\\\"\\\"\\\"\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n\n    xr = x.reshape(B * L, C)\n    \n    # Stack weights: (3 * H*D, C) -> single matmul\n    w_all = torch.cat([wq.reshape(HD, C), wk.reshape(HD, C), wv.reshape(HD, C)], dim=0)\n    out_all = xr @ w_all.T  # (B*L, 3*HD)\n    \n    q = out_all[:, :HD].reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = out_all[:, HD:2*HD].reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = out_all[:, 2*HD:].reshape(B, L, H, D).permute(0, 2, 1, 3)\n\n    logits = q @ k.transpose(-1, -2) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n\n        p1G = p1 @ G_exp\n        norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n\n        pmG = p_mix @ G_exp\n        normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n\n        norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n        normm = normm_sq.sqrt().clamp_min(1e-6)\n        ratio = (norm1 / normm).clamp(0.25, 4.0)\n\n        y = (p_mix @ v) * ratio\n\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ndef opt_fused_qkv_no_lerp_pmix(x, wq, wk, wv, alpha, beta):\n    \\\"\\\"\\\"Fused QKV + compute norm from p0,p1 cross (no pmix@G matmul).\n    Only 1 p@G (for p1) + use p0 elementwise for u0 norm and cross.\n    Actually we still need p0@G too... so it's 2 p@G matmuls either way.\n    But we avoid materializing p_mix (B,H,L,L) and save one p_mix@v (replaced with lerp of p0@v and p1@v).\n    \\\"\\\"\\\"\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n\n    xr = x.reshape(B * L, C)\n    w_all = torch.cat([wq.reshape(HD, C), wk.reshape(HD, C), wv.reshape(HD, C)], dim=0)\n    out_all = xr @ w_all.T\n    \n    q = out_all[:, :HD].reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = out_all[:, HD:2*HD].reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = out_all[:, 2*HD:].reshape(B, L, H, D).permute(0, 2, 1, 3)\n\n    logits = q @ k.transpose(-1, -2) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n\n        p1G = p1 @ G_exp\n        norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n        \n        p0G = p0 @ G_exp\n        norm0_sq = (p0G * p0).sum(dim=-1, keepdim=True)\n        cross = (p0G * p1).sum(dim=-1, keepdim=True)\n\n        b1 = 1.0 - beta\n        normm_sq = b1 * b1 * norm0_sq + beta * beta * norm1_sq + 2.0 * b1 * beta * cross\n\n        norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n        normm = normm_sq.sqrt().clamp_min(1e-6)\n        ratio = (norm1 / normm).clamp(0.25, 4.0)\n\n        # Output: (p_mix @ v) * ratio where p_mix = (1-b)*p0 + b*p1\n        # = [(1-b)*p0@v + b*p1@v] * ratio\n        out0 = p0 @ v\n        out1 = p1 @ v\n        y = torch.lerp(out0, out1, beta) * ratio\n\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n\ndef bench_median(fn, n=11):\n    for _ in range(3):\n        fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        t1 = time.process_time_ns()\n        times.append((t1 - t0) / 1e6)\n    return sorted(times)[len(times) // 2]\n\ncases = [\n    (1, 64, 512, 8, 64, 1.05, 5.0),\n    (1, 128, 640, 10, 64, 1.1, 4.0),\n    (1, 128, 1280, 20, 64, 1.15, 3.0),\n    (1, 256, 1280, 20, 64, 1.05, 7.5),\n    (1, 256, 640, 10, 64, 1.2, 5.0),\n    (2, 128, 512, 8, 64, 1.0, 5.0),\n]\n\nvariants = [\n    (\\\"ref\\\", ref_attention),\n    (\\\"current\\\", current_best),\n    (\\\"fused_qkv\\\", opt_fused_qkv),\n    (\\\"fused_nopmix\\\", opt_fused_qkv_no_lerp_pmix),\n]\n\ngeomean_opt = [1.0] * (len(variants) - 1)\n\nfor B, L, C, H, D, alpha, beta in cases:\n    torch.manual_seed(42)\n    x = torch.randn(B, L, C)\n    wq = torch.randn(H, D, C)\n    wk = torch.randn(H, D, C)\n    wv = torch.randn(H, D, C)\n    \n    case_label = f\\\"B{B}L{L}C{C}H{H}\\\"\n    \n    ref_out = ref_attention(x, wq, wk, wv, alpha, beta)\n    \n    times = []\n    for name, fn in variants:\n        ms = bench_median(lambda: fn(x, wq, wk, wv, alpha, beta), n=11)\n        times.append(ms)\n        \n        if name \"'!= \"ref\":\n            out = fn(x, wq, wk, wv, alpha, beta)\n            diff = (out - ref_out).abs().max().item()\n            rel_max = ref_out.abs().max().item()\n            tol = 3e-5 + 3e-4 * rel_max\n            status = \"OK\" if diff <= tol else f\"FAIL ({diff:.2e})\"\n            if diff > tol:\n                print(f\"  {name}: max_diff={diff:.2e} {status}\")\n    \n    print(f\"{case_label:20s}  \", end=\"\")\n    for i, t in enumerate(times):\n        if i == 0:\n            print(f\"{t:8.1f}ms \", end=\"\")\n        else:\n            print(f\"{t:8.1f}ms({t/times[0]:.3f}) \", end=\"\")\n    print()\n    \n    if times[0] > 0:\n        for j in range(1, len(variants)):\n            geomean_opt[j-1] *= times[j] / times[0]\n\nprint(f\"'\"\\\\nGeometric mean ratio (vs ref):\\\")\nfor j in range(1, len(variants)):\n    print(f\\\"  {variants[j][0]:20s}: {geomean_opt[j-1]**(1/len(cases)):.4f}\\\")\nPYEOF\npython /tmp/bench_opt2.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

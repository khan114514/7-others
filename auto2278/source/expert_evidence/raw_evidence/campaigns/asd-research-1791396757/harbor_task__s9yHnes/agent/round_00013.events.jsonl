{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/sh -lc \"cat << 'PYEOF' > /tmp/profile.py\nimport time, math, torch\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\ndef bench(fn, *args, n=5):\n    for _ in range(2):\n        fn(*args)\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn(*args)\n    return (time.process_time_ns() - t0) / n / 1e6\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\nHD = H * D\nxr = x.reshape(B*L, C)\n\nn = 5\n\n# Step 1: Projections\ndef s_proj():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    return q,k,v\nq,k,v = s_proj()\nprint(f\\\"proj: {bench(s_proj, n=n):.2f} ms\\\")\n\n# Step 2: q@k\"'^T + scale\ninv_sqrt_d = 1.0/math.sqrt(D)\ndef s_logits():\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    return logits\nlogits = s_logits()\nprint(f\"q@k+scale: {bench(s_logits, n=n):.2f} ms\")\n\n# Step 3: softmax p0\ndef s_softmax0():\n    return logits.softmax(dim=-1)\np0 = s_softmax0()\nprint(f\"p0 softmax: {bench(s_softmax0, n=n):.2f} ms\")\n\n# Step 4: p1 logits\na_p = 0.5*(1+alpha); a_m = 0.5*(1-alpha)\ndef s_p1logits():\n    p1_logits = logits.mul(a_p)\n    p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n    return p1_logits\np1_logits = s_p1logits()\nprint(f\"p1 logits: {bench(s_p1logits, n=n):.2f} ms\")\n\n# Step 5: p1 softmax\ndef s_p1softmax():\n    return p1_logits.softmax(dim=-1)\np1 = s_p1softmax()\nprint(f\"p1 softmax: {bench(s_p1softmax, n=n):.2f} ms\")\n\n# Step 6: p_mix\ndef s_pmix():\n    return torch.lerp(p0, p1, beta)\np_mix = s_pmix()\nprint(f\"p_mix (lerp): {bench(s_pmix, n=n):.2f} ms\")\n\n# Step 7: G\ndef s_G():\n    return x @ x.transpose(-1, -2)\nG = s_G()\nprint(f\"G=x@x''^T: {bench(s_G, n=n):.2f} ms\")\nG_exp = G.unsqueeze(1)\n\n# Step 8: p1G + norm1_sq\ndef s_norm1():\n    p1G = p1 @ G_exp\n    norm1_sq = p1G.mul(p1).sum(dim=-1, keepdim=True)\n    return norm1_sq\nnorm1_sq = s_norm1()\nprint(f\"p1@G + norm1: {bench(s_norm1, n=n):.2f} ms\")\n\n# Step 9: pmG + normm_sq\ndef s_normm():\n    pmG = p_mix @ G_exp\n    normm_sq = pmG.mul(p_mix).sum(dim=-1, keepdim=True)\n    return normm_sq\nnormm_sq = s_normm()\nprint(f\"p_mix@G + normm: {bench(s_normm, n=n):.2f} ms\")\n\n# Step 10: ratio\ndef s_ratio():\n    n1 = norm1_sq.sqrt().clamp_min(1e-6)\n    nm = normm_sq.sqrt().clamp_min(1e-6)\n    return (n1 / nm).clamp(0.25, 4.0)\nratio = s_ratio()\nprint(f\"ratio sqrt/clamp: {bench(s_ratio, n=n):.2f} ms\")\n\n# Step 11: p_mix @ v\ndef s_pv():\n    return p_mix @ v\npv = s_pv()\nprint(f\"p_mix@v: {bench(s_pv, n=n):.2f} ms\")\n\n# Step 12: output\ndef s_out():\n    y = (p_mix @ v).mul(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\nprint(f\"final out: {bench(s_out, n=n):.2f} ms\")\n\n# Total reference\ndef full():\n    return current_attention(x, wq, wk, wv, alpha, beta)\nimport sys\nsys.path.insert(0, '\"'/workspace/solution')\nfrom method import attention as current_attention\nprint(f\\\"\\\\nTotal: {bench(current_attention, x, wq, wk, wv, alpha, beta, n=n):.2f} ms\\\")\nPYEOF\npython /tmp/profile.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

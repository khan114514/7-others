{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/sh -lc \"cat << 'PYEOF' > /tmp/opt2.py\nimport time, math, torch\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\ndef bench(fn, *args, n=5):\n    for _ in range(2):\n        fn(*args)\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn(*args)\n    return (time.process_time_ns() - t0) / n / 1e6\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\nHD = H * D\nxr = x.reshape(B*L, C)\n\n# Current projection approach\nn = 10\ndef proj_current():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    return q,k,v\nprint(f\\\"3 separate projections: {bench(proj_current, n=n):.2f} ms\\\")\n\n# Fused projection approach\ndef proj_fused():\n    W = torch.cat([wq.reshape(HD, C), wk.reshape(HD, C), wv.reshape(HD, C)], dim=0)\n    out = xr @ W.T\n    q = out[:, :HD].reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = out[:, HD:2*HD].reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = out[:, 2*HD:].reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    return q,k,v\nprint(f\\\"fused projection (with cat): {bench(proj_fused, n=n):.2f} ms\\\")\n\n# What about avoiding permute+contiguous by using bmm with different layout?\n# Compute q as (B, L, H, D) contiguous, use einsum-like approach\ndef proj_blhd():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).contiguous()\n    return q,k,v\nq_blhd, k_blhd, v_blhd = proj_blhd()\nprint(f\\\"3 proj, BLHD contiguous: {bench(proj_blhd, n=n):.2f} ms\\\")\n\n# Test softmax speed with different layouts\nq,k,v = proj_current()\nlogits = q @ k.transpose(-1, -2)\nlogits.mul_(1.0/math.sqrt(D))\nprint(f\\\"\\\\nlogits shape {logits.shape}, contiguous: {logits.is_contiguous()}\\\")\nprint(f\\\"softmax dim=-1: {bench(logits.softmax, -1, n=n):.2f} ms\\\")\n\n# Reshape to 3D\nlogits_3d = logits.reshape(B*H, L, L)\nprint(f\\\"logits 3d shape {logits_3d.shape}, contiguous: {logits_3d.is_contiguous()}\\\")\nprint(f\\\"softmax 3d dim=-1: {bench(logits_3d.softmax, -1, n=n):.2f} ms\\\")\n\n# BLHD layout logits via einsum\nlogits_blhd = torch.einsum(\\\"blhd,bkhd->bhlk\\\", q_blhd, k_blhd)\nlogits_blhd.mul_(1.0/math.sqrt(D))\n# Wait, that's (B, H, L, K) same as before...\n\n# Let's try manual softmax \ndef manual_softmax(x):\n    xm = x.max(dim=-1, keepdim=True).values\n    e = (x - xm).exp_()\n    s = e.sum(dim=-1, keepdim=True)\n    return e.div_(s)\nprint(f\\\"manual softmax: {bench(manual_softmax, logits, n=n):.2f} ms\\\")\n\n# Let's also test p@G with G reshaped properly\nG = x @ x.transpose(-1, -2)\np0 = logits.softmax(dim=-1)\nG_exp = G.unsqueeze(1)\n\ndef pG_current():\n    return p0 @ G_exp\nprint(f\\\"\\\\np@G (4D broadcast): {bench(pG_current, n=n):.2f} ms\\\")\n\np0_3d = p0.reshape(B*H, L, L)\nG_3d = G.expand(B*H, L, L)\ndef pG_bmm():\n    return torch.bmm(p0_3d, G_3d)\nprint(f\\\"p@G (bmm 3d): {bench(pG_bmm, n=n):.2f} ms\\\")\n\n# Try reshape then matmul \nG_2d = G[0]  # (L, L) since B=1\np0_2d3d = p0.reshape(B*H, L, L)\ndef pG_loop():\n    # Just matmul each head's p with G\n    return torch.matmul(p0_2d3d, G_2d)\nprint(f\\\"p@G (matmul 3d@2d): {bench(pG_loop, n=n):.2f} ms\\\")\nPYEOF\npython /tmp/opt2.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/sh -lc \"cat << 'PYEOF' > /tmp/opt4.py\nimport time, math, torch\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\ndef bench(fn, *args, n=5):\n    for _ in range(2):\n        fn(*args)\n    torch._dynamo.reset() if hasattr(torch, '_dynamo') else None\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn(*args)\n    return (time.process_time_ns() - t0) / n / 1e6\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\nHD = H * D\nxr = x.reshape(B*L, C)\nn = 5\n\n# Current projection\ndef proj_v0():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    return q,k,v\nprint(f\\\"proj v0 (BHLD contiguous): {bench(proj_v0, n=n):.2f} ms\\\")\n\n# Projection without permute+contiguous (keep BLHD)\ndef proj_blhd():\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).contiguous()\n    return q,k,v\nq_blhd, k_blhd, v_blhd = proj_blhd()\nprint(f\\\"proj BLHD: {bench(proj_blhd, n=n):.2f} ms\\\")\n\n# BLHD logits via einsum\nlogits_blhd = torch.einsum(\\\"blhd,bkhd->bhlk\\\", q_blhd, k_blhd) / math.sqrt(D)\nprint(f\\\"einsum logits BLHD: {bench(lambda: torch.einsum('blhd,bkhd->bhlk', q_blhd, k_blhd), n=n):.2f} ms\\\")\n\n# vs BHSD\nq,k,v = proj_v0()\ninv_sqrt_d = 1.0/math.sqrt(D)\ndef logits_v0():\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    return logits\nlogits = logits_v0()\nprint(f\\\"v0 logits (matmul): {bench(logits_v0, n=n):.2f} ms\\\")\n\n# Softmax comparison\nprint(f\\\"\\\\nsoftmax v0 (4D): {bench(logits.softmax, -1, n=n):.2f} ms\\\")\nlogits_2d = logits.reshape(-1, L)\nprint(f\\\"softmax 2D: {bench(logits_2d.softmax, -1, n=n):.2f} ms\\\")\nlogits_3d = logits.reshape(B*H, L, L)\nprint(f\\\"softmax 3D: {bench(logits_3d.softmax, -1, n=n):.2f} ms\\\")\n\n# What about the v-first approach with BLHD v?\n# output = p @ v where p is (B,H,L,L), v is (B,L,H,D)\n# We need: for each head h, output[b,h,i,:] = sum_j p[b,h,i,j] * v[b,j,h,:]\n# = einsum(\\\"bhij,bjhd->bihd\\\", p, v) -> reshape\n\n# Actually, let's try computing everything with BLHD v layout\np0 = logits.softmax(dim=-1)  # (B, H, L, L)\nv_bhld = v  # (B, H, L, D)\nv_blhd = v_blhd  # (B, L, H, D)\n\ndef out_v0():\n    return p0 @ v_bhld  # (B, H, L, D)\nprint(f\\\"\\\\nout v0 (p@v BHLD): {bench(out_v0, n=n):.2f} ms\\\")\n\ndef out_einsum():\n    return torch.einsum(\\\"bhij,bjhd->bhid\\\", p0, v_blhd)\nprint(f\\\"out einsum (bhij,bjhd->bhid): {bench(out_einsum, n=n):.2f} ms\\\")\n\n# Let's try: reshape p to (B*H, L, L), v to (B*H, L, D), bmm\np0_3d = p0.reshape(B*H, L, L)\nv_3d = v.reshape(B*H, L, D)\ndef out_bmm():\n    return torch.bmm(p0_3d, v_3d)\nprint(f\\\"out bmm (3D): {bench(out_bmm, n=n):.2f} ms\\\")\n\n# p@G benchmark\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)  # (B, 1, L, L)\ndef pG_4d():\n    return p0 @ G_exp\nprint(f\\\"\\\\np@G 4D broadcast: {bench(pG_4d, n=n):.2f} ms\\\")\n\n# 3D matmul approach: p0 (B*H, L, L) @ G (L, L)\n# matmul supports broadcasting: (B*H, L, L) @ (L, L) = (B*H, L, L) \ndef pG_3d2d():\n    return torch.matmul(p0_3d, G[0])\nprint(f\\\"p@G 3D@2D matmul: {bench(pG_3d2d, n=n):.2f} ms\\\")\n\n# Wait, does this work for B>1?\n# For B=2, G would be (2, L, L). p0_3d would be (2*H, L, L).\n# We'd need to match batch dims. Let's check:\n# p0 (B, H, L, L) @ G (B, 1, L, L) -> (B, H, L, L) via 4D matmul\n# vs\n# p0.reshape(B*H, L, L) @ G.view(B, 1, L, L) - no, matmul doesn't broadcast batch that way\n\n# Actually torch.matmul supports broadcasting of batch dims:\n# (B*H, L, L) @ (B, 1, L, L) -- the first has 1 batch dim, second has 2\n# PyTorch would try to broadcast the batch dims: B*H vs [B, 1] -- doesn't work.\n# We'd need to reshape p0 to (B, H, L, L) and G to (B, 1, L, L), then matmul.\n# That IS the 4D approach.\n\n# What about: for each batch, compute p0[b] @ G[b]? Looping would be slow for large B.\n# For our cases B<=2, so a loop might actually be faster\"'!\n# B=2: 2 calls of (H, L, L) @ (L, L) = (H, L, L)\n\n# Let'\"'s test with B=2\nB2 = 2\nx2 = torch.randn(B2, L, C)\nwq2 = torch.randn(H, D, C)\nxr2 = x2.reshape(B2*L, C)\nq2 = (xr2 @ wq2.reshape(HD, C).T).reshape(B2, L, H, D).permute(0, 2, 1, 3).contiguous()\nk2 = (xr2 @ wk.reshape(HD, C).T).reshape(B2, L, H, D).permute(0, 2, 1, 3).contiguous()\nlogits2 = q2 @ k2.transpose(-1, -2)\np0_2 = logits2.softmax(dim=-1)\nG2 = x2 @ x2.transpose(-1, -2)  # (2, L, L)\n\ndef pG_4d_b2():\n    return p0_2 @ G2.unsqueeze(1)\nprint(f\\\"\\\\n(B=2) p@G 4D: {bench(pG_4d_b2, n=n):.2f} ms\\\")\n\ndef pG_loop_b2():\n    results = []\n    for b in range(B2):\n        results.append(p0_2[b] @ G2[b])  # (H, L, L) @ (L, L) = (H, L, L)\n    return torch.stack(results, dim=0)\nprint(f\\\"(B=2) p@G loop: {bench(pG_loop_b2, n=n):.2f} ms\\\")\n\n# Verify correctness\nr1 = pG_4d_b2()\nr2 = pG_loop_b2()\nprint(f\\\"(B=2) loop diff: {(r1-r2).abs().max():.2e}\\\")\nPYEOF\npython /tmp/opt4.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/sh -lc \"cat << 'PYEOF' > /tmp/opt6.py\nimport time, math, torch\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\ndef bench(fn, *args, n=7):\n    for _ in range(3):\n        fn(*args)\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn(*args)\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return sorted(times)[n//2]\n\ndef current_attention(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1_logits = logits.mul(a_p)\n        p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n        p1 = p1_logits.softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        p1G = p1 @ G_exp\n        norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n        y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Key ideas:\n# 1. Avoid v permutation by computing p@v in a way that uses BLHD v directly\n# 2. Use 3D reshaping for p@G (matmul with G[0] for B=1)\n# 3. Compute both p0@G and p1@G, derive p_mix@G and cross terms from them\n#    (same 2 matmuls, but cleaner)\n\ndef attn_new(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    BH = B * H\n    xr = x.reshape(B * L, C)\n    \n    # Projections: q, k go to BHLD; v stays BLHD (no permute needed at end)\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D)  # BLHD, not contiguous yet\n    \n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    \n    if alpha == 1.0:\n        # p0 (B,H,L,L) @ v_permuted (B,H,L,D)\n        y = p0 @ v.permute(0, 2, 1, 3)\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1_logits = logits.mul(a_p)\n        p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n        p1 = p1_logits.softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        \n        G = x @ x.transpose(-1, -2)  # (B, L, L)\n        \n        # p@G: reshape p to (B*H, L, L), G to batch-expanded form\n        # For B=1: (H, L, L) @ (L, L)  - just matmul\n        p0_3d = p0.reshape(BH, L, L)\n        p1_3d = p1.reshape(BH, L, L)\n        pm_3d = p_mix.reshape(BH, L, L)\n        \n        if B == 1:\n            G0 = G[0]  # (L, L)\n            p1G = torch.matmul(p1_3d, G0).reshape(B, H, L, L)\n            pmG = torch.matmul(pm_3d, G0).reshape(B, H, L, L)\n        else:\n            # (B, H*L, L) @ (B, L, L) = (B, H*L, L)\n            p1_flat = p1.reshape(B, H * L, L)\n            pm_flat = p_mix.reshape(B, H * L, L)\n            p1G = torch.bmm(p1_flat, G).reshape(B, H, L, L)\n            pmG = torch.bmm(pm_flat, G).reshape(B, H, L, L)\n        \n        norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n        normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n        \n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n        \n        # p_mix (B,H,L,L) @ v (B,H,L,D)\n        y = (p_mix @ v.permute(0, 2, 1, 3)).mul_(ratio)\n    \n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Test all cases\ncases = [\n    (1, 64, 512, 8, 64, 1.05, 5.0),\n    (1, 128, 640, 10, 64, 1.1, 4.0),\n    (1, 128, 1280, 20, 64, 1.15, 3.0),\n    (1, 256, 1280, 20, 64, 1.05, 7.5),\n    (1, 256, 640, 10, 64, 1.2, 5.0),\n    (2, 128, 512, 8, 64, 1.0, 5.0),\n]\n\nprint(f\\\"{'Case':25s} {'cur(ms)':>8s} {'new(ms)':>8s} {'ratio':>7s} {'max_diff':>10s} {'status':>6s}\\\")\nprint(\\\"-\\\" * 70)\ngeomean = 1.0\nfor B, L, C, H, D, alpha, beta in cases:\n    torch.manual_seed(42)\n    x = torch.randn(B, L, C)\n    wq = torch.randn(H, D, C)\n    wk = torch.randn(H, D, C)\n    wv = torch.randn(H, D, C)\n    \n    ref = current_attention(x, wq, wk, wv, alpha, beta)\n    out = attn_new(x, wq, wk, wv, alpha, beta)\n    diff = (ref - out).abs().max().item()\n    maxv = ref.abs().max().item()\n    \n    t_cur = bench(current_attention, x, wq, wk, wv, alpha, beta)\n    t_new = bench(attn_new, x, wq, wk, wv, alpha, beta)\n    \n    status = \\\"OK\\\" if diff <= 3e-5 + 3e-4 * maxv else \\\"FAIL\\\"\n    case = f\\\"B{B}L{L}C{C}H{H}a{alpha}\\\"\n    print(f\\\"{case:25s} {t_cur:8.2f} {t_new:8.2f} {t_new/t_cur:7.3f} {diff:10.2e} {status:>6s}\\\")\n    geomean *= t_new / t_cur\n\nprint(f\\\"\\\\nGeometric mean ratio: {geomean**(1/len(cases)):.4f}\\\")\nPYEOF\npython /tmp/opt6.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

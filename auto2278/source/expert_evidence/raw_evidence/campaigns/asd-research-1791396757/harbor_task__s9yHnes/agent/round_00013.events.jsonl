{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/sh -lc \"cat << 'PYEOF' > /tmp/opt7.py\nimport time, math, torch\nimport torch.nn.functional as F\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\ndef bench(fn, *args, n=7):\n    for _ in range(3):\n        fn(*args)\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn(*args)\n        times.append((time.process_time_ns() - t0) / 1e6)\n    return sorted(times)[n//2]\n\ndef current_attention(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1_logits = logits.mul(a_p)\n        p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n        p1 = p1_logits.softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        p1G = p1 @ G_exp\n        norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n        y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\nHD = H * D\nxr = x.reshape(B*L, C)\n\nq = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nk = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\nv = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n\n# Test SDPA\nn = 7\ndef sdpa_test():\n    return F.scaled_dot_product_attention(q, k, v, scale=1.0/math.sqrt(D))\ndef manual_attn():\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(1.0/math.sqrt(D))\n    return logits.softmax(dim=-1) @ v\n\nprint(f\\\"manual attn (logits+softmax+v): {bench(manual_attn, n=n):.2f} ms\\\")\nprint(f\\\"sdpa: {bench(sdpa_test, n=n):.2f} ms\\\")\n\n# Check result\nr1 = manual_attn()\nr2 = sdpa_test()\nprint(f\\\"sdpa diff: {(r1-r2).abs().max():.2e}\\\")\n\n# Now the question: can we use sdpa for both p0 and p1?\n# p1 = softmax(a_p * A + a_m * A\"'^T) where A = q@k''^T/sqrt(D)\n# That'\"'s not standard attention. But can we express it as sdpa?\n# p1_logits = a_p * q@k\"'^T + a_m * k@q''^T (all scaled by 1/sqrt(D))\n# = (sqrt(a_p)*q) @ (sqrt(a_p)*k)''^T + (sqrt(a_m)*k) @ (sqrt(a_m)*q)''^T\n# Hmm, that'\"'s two separate attention logits added together.\n# Not directly expressible as sdpa.\n\n# But what if we use sdpa for p0 (since it's standard), and keep manual for p1?\n# Let's see: softmax is ~13ms, q@k\"'^T is ~3ms, total ~30ms for both\n# sdpa does it all in one call - maybe faster?\n\n# Also: can we avoid computing full p0? If we only need p0 for:\n# 1. p_mix = lerp(p0, p1, beta)\n# 2. For norm computation\n\n# Wait, we DON'\"'T need u0 = p0@v\"'! Let'\"'s re-read the problem:\n# m = u0 + beta*(u1 - u0)\n# We need m (blended), not u0 separately.\n# And m = p_mix @ x where p_mix = (1-beta)*p0 + beta*p1\n# We compute p_mix via lerp(p0, p1, beta), then p_mix @ v.\n# That's correct.\n\n# But do we need p0 for norm computation?\n# norm_m = ||m|| = ||p_mix @ x||\n# norm_1 = ||u1|| = ||p1 @ x||\n# ratio = clamp(norm1 / normm, 0.25, 4.0)\n# We DON'T need norm_0 = ||u0||.\n\n# So we need: p0 (for p_mix), p1 (for p_mix and norm1), p_mix (for normm and output)\n# We can compute normm from p_mix @ G.\n# We can compute norm1 from p1 @ G.\n# Both p@G matmuls are needed.\n\n# Let's focus on softmax optimization. What if we use 2D softmax?\nlogits = q @ k.transpose(-1, -2)\nlogits.mul_(1.0/math.sqrt(D))\ndef sm_4d():\n    return logits.softmax(dim=-1)\nlogits_2d = logits.reshape(-1, L)\ndef sm_2d():\n    return logits_2d.softmax(dim=-1).reshape(B, H, L, L)\nprint(f\\\"\\\\nsoftmax 4D: {bench(sm_4d, n=n):.2f} ms\\\")\nprint(f\\\"softmax 2D: {bench(sm_2d, n=n):.2f} ms\\\")\n\n# What about using the fact that we need TWO softmaxes?\n# Can we compute both at once?\np1_logits = 0.5*(1+alpha)*logits + 0.5*(1-alpha)*logits.transpose(-1,2)\nboth_logits = torch.stack([logits, p1_logits], dim=0)  # (2, B, H, L, L)\ndef sm_stack():\n    return both_logits.softmax(dim=-1)\nprint(f\\\"\\\\n2x stacked softmax (5D): {bench(sm_stack, n=n):.2f} ms\\\")\nprint(f\\\"(vs 2 separate: {bench(sm_4d, n=n)*2:.2f} ms)\\\")\n\n# What about v permute optimization?\n# Currently: v is computed as BLHD, then permuted to BHLD for p@v, then result permuted back.\n# Total: 1 permute for v, 1 permute for output.\n# Can we avoid this with einsum?\nv_blhd = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).contiguous()\np0_test = logits.softmax(dim=-1)  # (B,H,L,L)\n\ndef out_v0():  # permute v then matmul then permute back\n    v_bhld = v_blhd.permute(0, 2, 1, 3).contiguous()\n    y = p0_test @ v_bhld\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ndef out_einsum():  # direct einsum\n    return torch.einsum(\\\"bhij,bjhd->blhd\\\", p0_test, v_blhd).flatten(2).contiguous()\n\nprint(f\\\"\\\\nout_v0 (permute+matmul): {bench(out_v0, n=n):.2f} ms\\\")\nprint(f\\\"out_einsum: {bench(out_einsum, n=n):.2f} ms\\\")\nr1 = out_v0()\nr2 = out_einsum()\nprint(f\\\"einsum diff: {(r1-r2).abs().max():
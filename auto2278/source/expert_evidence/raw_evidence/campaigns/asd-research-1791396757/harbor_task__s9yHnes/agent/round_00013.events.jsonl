= B * H\n    xr = x.reshape(B * L, C)\n    \n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    \n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    \n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1_logits = logits.mul(a_p)\n        p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n        p1 = p1_logits.softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        \n        G = x @ x.transpose(-1, -2)  # (B, L, L)\n        \n        # Reshape to 3D for bmm\n        p1_3d = p1.reshape(BH, L, L)\n        pm_3d = p_mix.reshape(BH, L, L)\n        G_3d = G.repeat(H, 1, 1)  # (B*H, L, L) - for B=1 it's just repeat\n        \n        p1G = torch.bmm(p1_3d, G_3d)\n        norm1_sq = p1G.mul_(p1_3d).sum(dim=-1).reshape(B, H, L, 1)\n        pmG = torch.bmm(pm_3d, G_3d)\n        normm_sq = pmG.mul_(pm_3d).sum(dim=-1).reshape(B, H, L, 1)\n        \n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n        \n        y = (p_mix @ v).mul_(ratio)\n    \n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Test all cases\ncases = [\n    (1, 64, 512, 8, 64, 1.05, 5.0),\n    (1, 128, 640, 10, 64, 1.1, 4.0),\n    (1, 128, 1280, 20, 64, 1.15, 3.0),\n    (1, 256, 1280, 20, 64, 1.05, 7.5),\n    (1, 256, 640, 10, 64, 1.2, 5.0),\n    (2, 128, 512, 8, 64, 1.0, 5.0),\n]\n\nfor B, L, C, H, D, alpha, beta in cases:\n    torch.manual_seed(42)\n    x = torch.randn(B, L, C)\n    wq = torch.randn(H, D, C)\n    wk = torch.randn(H, D, C)\n    wv = torch.randn(H, D, C)\n    \n    ref = current_attention(x, wq, wk, wv, alpha, beta)\n    out = attn_opt3d(x, wq, wk, wv, alpha, beta)\n    diff = (ref - out).abs().max().item()\n    maxv = ref.abs().max().item()\n    \n    n = 10 if L < 256 else 5\n    t_cur = bench(current_attention, x, wq, wk, wv, alpha, beta, n=n)\n    t_new = bench(attn_opt3d, x, wq, wk, wv, alpha, beta, n=n)\n    \n    status = \\\"OK\\\" if diff <= 3e-5 + 3e-4 * maxv else \\\"FAIL\\\"\n    print(f\\\"B{B:1d}L{L:3d}C{C:4d}H{H:2d} a={alpha:.2f}  cur={t_cur:7.2f}ms  new={t_new:7.2f}ms  ratio={t_new/t_cur:.3f}  diff={diff:.2e} {status}\\\")\nPYEOF\npython /tmp/opt3.py\"","aggregated_output":"B1L 64C 512H 8 a=1.05  cur=   4.10ms  new=   4.04ms  ratio=0.987  diff=0.00e+00 OK\nB1L128C 640H10 a=1.10  cur=  12.40ms  new=  12.50ms  ratio=1.008  diff=0.00e+00 OK\nB1L128C1280H20 a=1.15  cur=  37.05ms  new=  40.43ms  ratio=1.091  diff=0.00e+00 OK\nB1L256C1280H20 a=1.05  cur= 115.13ms  new= 152.42ms  ratio=1.324  diff=0.00e+00 OK\nB1L256C 640H10 a=1.20  cur=  46.37ms  new=  52.42ms  ratio=1.130  diff=0.00e+00 OK\nB2L128C 512H 8 a=1.00  cur=  12.73ms  new=  11.50ms  ratio=0.903  diff=0.00e+00 OK\n","exit_code":0,"status":"completed"}}

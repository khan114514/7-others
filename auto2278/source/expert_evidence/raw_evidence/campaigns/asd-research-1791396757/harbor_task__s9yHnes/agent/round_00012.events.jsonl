{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/bench_normtrick.py << 'PYEOF'\nimport time, math, torch\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\ndef ref_attention(x, wq, wk, wv, alpha, beta):\n    q = torch.einsum(\\\"blc,hdc->bhld\\\", x, wq)\n    k = torch.einsum(\\\"blc,hdc->bhld\\\", x, wk)\n    logits = (q @ k.transpose(-1, -2)) / math.sqrt(wq.shape[1])\n    p0 = logits.softmax(dim=-1)\n    base = p0 @ x.unsqueeze(1)\n    if alpha == 1.0:\n        modified = base\n    else:\n        perturbed = .5 * (1 + alpha) * logits + .5 * (1 - alpha) * logits.transpose(-1, -2)\n        modified = perturbed.softmax(dim=-1) @ x.unsqueeze(1)\n    blended = base + beta * (modified - base)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    y = torch.einsum(\\\"bhlc,hdc->bhld\\\", blended * ratio, wv)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ndef current_attention(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wv.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    logits = q @ k.transpose(-1, -2) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        p1G = p1 @ G_exp\n        norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n        normm = normm_sq.sqrt().clamp_min(1e-6)\n        ratio = (norm1 / normm).clamp(0.25, 4.0)\n        y = (p_mix @ v) * ratio\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ndef opt_normtrick_v1(x, wq, wk, wv, alpha, beta):\n    \\\"\\\"\\\"Use p0@G + p1@G instead of p1@G + p_mix@G. Saves one p@G matmul.\\\"\\\"\\\"\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wv.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    logits = q @ k.transpose(-1, -2) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        # Two p@G matmuls instead of one, but save the p_mix@G\n        # Wait no - original has p1@G + p_mix@G = 2 matmuls\n        # This has p0@G + p1@G = 2 matmuls (same count)\n        # But we can try stacking... actually same amount of work\n        p0G = p0 @ G_exp\n        p1G = p1 @ G_exp\n        norm0_sq = (p0G * p0).sum(dim=-1, keepdim=True)\n        norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n        cross = (p0G * p1).sum(dim=-1, keepdim=True)\n        b0 = 1.0 - beta\n        normm_sq = b0*b0 * norm0_sq + beta*beta * norm1_sq + 2*b0*beta * cross\n        norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n        normm = normm_sq.sqrt().clamp_min(1e-6)\n        ratio = (norm1 / normm).clamp(0.25, 4.0)\n        y = (p_mix @ v) * ratio\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ndef opt_normtrick_v2(x, wq, wk, wv, alpha, beta):\n    \\\"\\\"\\\"Stacked single matmul: cat(p0, p1) @ G, then split.\\\"\\\"\\\"\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wv.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    logits = q @ k.transpose(-1, -2) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        # Stack along head dim: (B, 2H, L, L) @ (B, 1, L, L)\n        # Wait G_exp broadcasts across head dim, so stacking p0+p1 gives (B, 2H, L, L)\n        # and G_exp of (B, 1, L, L) broadcasts to (B, 2H, L, L) \n        # This is a single matmul call with 2H batches instead of H\n        # For H=20, this doubles the batch but it's one MKL call instead of two\n        p_both = torch.cat([p0, p1], dim=1)\n        pG_both = p_both @ G_exp\n        p0G = pG_both[:, :H]\n        p1G = pG_both[:, H:]\n        norm0_sq = (p0G * p0).sum(dim=-1, keepdim=True)\n        norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n        cross = (p0G * p1).sum(dim=-1, keepdim=True)\n        b0 = 1.0 - beta\n        normm_sq = b0*b0 * norm0_sq + beta*beta * norm1_sq + 2*b0*beta * cross\n        norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n        normm = normm_sq.sqrt().clamp_min(1e-6)\n        ratio = (norm1 / normm).clamp(0.25, 4.0)\n        y = (p_mix @ v) * ratio\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ndef bench(fn, n=15, warmup=5):\n    for _ in range(warmup):\n        fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        t1 = time.process_time_ns()\n        times.append((t1 - t0) / 1e6)\n    times.sort()\n    return times[n//2]\n\ncases = [\n    (1, 64, 512, 8, 64, 1.05, 5.0),\n    (1, 128, 640, 10, 64, 1.1, 4.0),\n    (1, 128, 1280, 20, 64, 1.15, 3.0),\n    (1, 256, 1280, 20, 64, 1.05, 7.5),\n    (1, 256, 640, 10, 64, 1.2, 5.0),\n    (2, 128, 512, 8, 64, 1.0, 5.0),\n]\n\nvariants = [\n    (\\\"ref\\\", ref_attention),\n    (\\\"current\\\", current_attention),\n    (\\\"nt_v1\\\", opt_normtrick_v1),\n    (\\\"nt_v2\\\", opt_normtrick_v2),\n]\n\nprint(f\\\"{'Case':25s}\\\", end=\\\"\\\")\nfor name, _ in variants:\n    print(f\\\" {name:>14s}\\\", end=\\\"\\\")\nprint()\n\ngeom = [1.0] * (len(variants) - 1)\nfor B, L, C, H, D, alpha, beta in cases:\n    torch.manual_seed(42)\n    x = torch.randn(B, L, C)\n    wq = torch.randn(H, D, C)\n    wk = torch.randn(H, D, C)\n    wv = torch.randn(H, D, C)\n    \n    ref_out = ref_attention(x, wq, wk, wv, alpha, beta)\n    \n    times = []\n    for name, fn in variants:\n        t = bench(lambda: fn(x, wq, wk, wv, alpha, beta), n=11)\n        times.append(t)\n        if name \"'!= \"ref\":\n            out = fn(x, wq, wk, wv, alpha, beta)\n            diff = (out - ref_out).abs().max().item()\n            max_exp = ref_out.abs().max().item()\n            tol = 3e-5 + 3e-4 * max_exp\n            if diff > tol:\n                print(f\"'\"\\\\n  FAIL {name}: max_abs={diff:.2e}, tol={tol:.2e}\\\")\n    \n    label = f\\\"B{B}L{L}C{C}H{H}\\\"\n    print(f\\\"{label:25s}\\\", end=\\\"\\\")\n    for i, t in enumerate(times):\n        if i == 0:\n            print(f\\\" {t:14.2f}\\\", end=\\\"\\\")\n        else:\n            print(f\\\" {t:7.2f}({t/times[0]:.3f})\\\", end=\\\"\\\")\n            geom[i-1] *= t / times[0]\n    print()\n\nprint(f\\\"\\\\nGeomean ratio (vs ref):\\\")\nfor i, (name, _) in enumerate(variants[1:], 1):\n    print(f\\\"  {name:20s}: {geom[i-1]**(1/len(cases)):.4f}\\\")\nPYEOF\npython /tmp/bench_normtrick.py\"","aggregated_output":"Case                                 ref        current          nt_v1          nt_v2\nB1L64C512H8                        16.44    4.73(0.288)    4.70(0.286)    4.68(0.285)\nB1L128C640H10                      35.58   12.88(0.362)   12.79(0.360)   13.01(0.366)\nB1L128C1280H20                     82.68   37.35(0.452)   37.07(0.448)   37.52(0.454)\nB1L256C1280H20                    233.68  113.55(0.486)  115.31(0.493)  115.65(0.495)\nB1L256C640H10                      62.55   47.71(0.763)   49.02(0.784)   44.27(0.708)\nB2L128C512H8                       28.38   14.45(0.509)   13.36(0.471)   13.22(0.466)\n\nGeomean ratio (vs ref):\n  current             : 0.4549\n  nt_v1               : 0.4508\n  nt_v2               : 0.4444\n","exit_code":0,"status":"completed"}}

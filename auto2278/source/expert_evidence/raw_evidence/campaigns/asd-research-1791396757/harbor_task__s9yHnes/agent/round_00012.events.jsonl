  inv_sqrt_d = 1.0 / math.sqrt(D)\n    BH = B * H\n    \n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).reshape(BH, L, D)\n    k = (xr @ wk.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).reshape(BH, L, D)\n    v = (xr @ wv.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).reshape(BH, L, D)\n    \n    logits = torch.bmm(q, k.transpose(-1, -2)) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    \n    if alpha == 1.0:\n        y = torch.bmm(p0, v)\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        \n        G = x @ x.transpose(-1, -2)\n        G_bmm = G.unsqueeze(1).expand(B, H, L, L).reshape(BH, L, L)\n        \n        # Stack p0 and p1 vertically for single bmm call\n        # Actually with bmm, we can just do two separate calls... \n        # But let's try using one call by stacking in batch dim\n        p_stack = torch.cat([p0, p1], dim=0)  # (2*BH, L, L)\n        G_stack = G_bmm.repeat(2, 1, 1)  # (2*BH, L, L)\n        pG_stack = torch.bmm(p_stack, G_stack)\n        p0G = pG_stack[:BH]\n        p1G = pG_stack[BH:]\n        \n        norm0_sq = (p0G * p0).sum(dim=-1, keepdim=True)\n        norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n        cross = (p0G * p1).sum(dim=-1, keepdim=True)\n        b0 = 1.0 - beta\n        normm_sq = b0*b0 * norm0_sq + beta*beta * norm1_sq + 2*b0*beta * cross\n        \n        norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n        normm = normm_sq.sqrt().clamp_min(1e-6)\n        ratio = (norm1 / normm).clamp(0.25, 4.0)\n        \n        y = torch.bmm(p_mix, v) * ratio\n    \n    return y.reshape(B, H, L, D).transpose(1, 2).flatten(2).contiguous()\n\ndef bench(fn, n=15, warmup=5):\n    for _ in range(warmup):\n        fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        t1 = time.process_time_ns()\n        times.append((t1 - t0) / 1e6)\n    times.sort()\n    return times[n//2]\n\ncases = [\n    (1, 64, 512, 8, 64, 1.05, 5.0),\n    (1, 128, 640, 10, 64, 1.1, 4.0),\n    (1, 128, 1280, 20, 64, 1.15, 3.0),\n    (1, 256, 1280, 20, 64, 1.05, 7.5),\n    (1, 256, 640, 10, 64, 1.2, 5.0),\n    (2, 128, 512, 8, 64, 1.0, 5.0),\n]\n\nvariants = [\n    (\\\"ref\\\", ref_attention),\n    (\\\"current\\\", current_attention),\n    (\\\"bmm\\\", opt_bmm),\n    (\\\"bmm_p0p1\\\", opt_bmm_p0p1),\n]\n\nprint(f\\\"{'Case':25s}\\\", end=\\\"\\\")\nfor name, _ in variants:\n    print(f\\\" {name:>14s}\\\", end=\\\"\\\")\nprint()\n\ngeom = [1.0] * (len(variants) - 1)\nfor B, L, C, H, D, alpha, beta in cases:\n    torch.manual_seed(42)\n    x = torch.randn(B, L, C)\n    wq = torch.randn(H, D, C)\n    wk = torch.randn(H, D, C)\n    wv = torch.randn(H, D, C)\n    \n    ref_out = ref_attention(x, wq, wk, wv, alpha, beta)\n    \n    times = []\n    for name, fn in variants:\n        t = bench(lambda: fn(x, wq, wk, wv, alpha, beta), n=11)\n        times.append(t)\n        if name \"'!= \"ref\":\n            out = fn(x, wq, wk, wv, alpha, beta)\n            diff = (out - ref_out).abs().max().item()\n            max_exp = ref_out.abs().max().item()\n            tol = 3e-5 + 3e-4 * max_exp\n            if diff > tol:\n                print(f\"'\"\\\\n  FAIL {name}: max_abs={diff:.2e}, tol={tol:.2e}\\\")\n    \n    label = f\\\"B{B}L{L}C{C}H{H}\\\"\n    print(f\\\"{label:25s}\\\", end=\\\"\\\")\n    for i, t in enumerate(times):\n        if i == 0:\n            print(f\\\" {t:14.2f}\\\", end=\\\"\\\")\n        else:\n            print(f\\\" {t:7.2f}({t/times[0]:.3f})\\\", end=\\\"\\\")\n            geom[i-1] *= t / times[0]\n    print()\n\nprint(f\\\"\\\\nGeomean ratio (vs ref):\\\")\nfor i, (name, _) in enumerate(variants[1:], 1):\n    print(f\\\"  {name:20s}: {geom[i-1]**(1/len(cases)):.4f}\\\")\nPYEOF\npython /tmp/bench_bmm.py\"","aggregated_output":"Case                                 ref        current            bmm       bmm_p0p1\nB1L64C512H8                        14.74    4.67(0.317)    4.64(0.315)    4.71(0.320)\nB1L128C640H10                      24.89   12.70(0.510)   13.75(0.552)   14.55(0.585)\nB1L128C1280H20                     88.71   37.76(0.426)   36.74(0.414)   37.02(0.417)\nB1L256C1280H20                    235.15  108.17(0.460)  109.28(0.465)  143.84(0.612)\nB1L256C640H10                      66.03   45.37(0.687)   44.22(0.670)   44.45(0.673)\nB2L128C512H8                       28.51   13.74(0.482)   10.96(0.385)   11.12(0.390)\n\nGeomean ratio (vs ref):\n  current             : 0.4679\n  bmm                 : 0.4528\n  bmm_p0p1            : 0.4820\n","exit_code":0,"status":"completed"}}

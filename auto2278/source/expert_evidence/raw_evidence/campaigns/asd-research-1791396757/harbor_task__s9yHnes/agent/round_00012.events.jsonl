{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/bench_opt.py << 'PYEOF'\nimport time, math, torch\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\ndef ref_attention(x, wq, wk, wv, alpha, beta):\n    q = torch.einsum(\\\"blc,hdc->bhld\\\", x, wq)\n    k = torch.einsum(\\\"blc,hdc->bhld\\\", x, wk)\n    logits = (q @ k.transpose(-1, -2)) / math.sqrt(wq.shape[1])\n    p0 = logits.softmax(dim=-1)\n    base = p0 @ x.unsqueeze(1)\n    if alpha == 1.0:\n        modified = base\n    else:\n        perturbed = .5 * (1 + alpha) * logits + .5 * (1 - alpha) * logits.transpose(-1, -2)\n        modified = perturbed.softmax(dim=-1) @ x.unsqueeze(1)\n    blended = base + beta * (modified - base)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    y = torch.einsum(\\\"bhlc,hdc->bhld\\\", blended * ratio, wv)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ndef current_attention(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wv.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    logits = q @ k.transpose(-1, -2) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        p1G = p1 @ G_exp\n        norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n        normm = normm_sq.sqrt().clamp_min(1e-6)\n        ratio = (norm1 / normm).clamp(0.25, 4.0)\n        y = (p_mix @ v) * ratio\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ndef opt_combined_qkv(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    \n    wqr = wq.reshape(HD, C)\n    wkr = wk.reshape(HD, C)\n    wvr = wv.reshape(HD, C)\n    w_all = torch.cat([wqr, wkr, wvr], dim=0)  # (3*HD, C)\n    \n    xr = x.reshape(B * L, C)\n    proj = xr @ w_all.T  # (B*L, 3*HD)\n    proj = proj.reshape(B, L, 3, H, D).permute(2, 0, 3, 1, 4)\n    q, k, v = proj[0], proj[1], proj[2]\n    \n    logits = q @ k.transpose(-1, -2) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        p1G = p1 @ G_exp\n        norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n        normm = normm_sq.sqrt().clamp_min(1e-6)\n        ratio = (norm1 / normm).clamp(0.25, 4.0)\n        y = (p_mix @ v) * ratio\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ndef opt_stacked_pG(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wv.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    logits = q @ k.transpose(-1, -2) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        # Stack p1 and p_mix along head dim for single batched matmul\n        p_stack = torch.cat([p1, p_mix], dim=1)  # (B, 2H, L, L)\n        pG_stack = p_stack @ G_exp  # (B, 2H, L, L)\n        p1G = pG_stack[:, :H]\n        pmG = pG_stack[:, H:]\n        norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n        normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n        normm = normm_sq.sqrt().clamp_min(1e-6)\n        ratio = (norm1 / normm).clamp(0.25, 4.0)\n        y = (p_mix @ v) * ratio\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ndef opt_p0p1_norm_trick(x, wq, wk, wv, alpha, beta):\n    \\\"\\\"\\\"Compute normm from p0, p1, G using only p0@G + p1@G, then derive normm.\\\"\\\"\\\"\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wv.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    logits = q @ k.transpose(-1, -2) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        # Stack p0 and p1\n        p_stack = torch.cat([p0, p1], dim=1)  # (B, 2H, L, L)\n        pG_stack = p_stack @ G_exp  # (B, 2H, L, L)\n        p0G = pG_stack[:, :H]  # (B, H, L, L)\n        p1G = pG_stack[:, H:]\n        norm0_sq = (p0G * p0).sum(dim=-1, keepdim=True)\n        norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n        cross = (p0G * p1).sum(dim=-1, keepdim=True)  # = diag(p0 @ G @ p1\"'^T)\n        b0 = 1.0 - beta\n        normm_sq = b0*b0 * norm0_sq + beta*beta * norm1_sq + 2*b0*beta * cross\n        norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n        normm = normm_sq.sqrt().clamp_min(1e-6)\n        ratio = (norm1 / normm).clamp(0.25, 4.0)\n        y = (p_mix @ v) * ratio\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ndef opt_full(x, wq, wk, wv, alpha, beta):\n    \"\"\"Combined QKV projection + stacked p0/p1@G + norm trick.\"\"\"\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    \n    # Single combined QKV projection\n    w_all = torch.cat([wq.reshape(HD, C), wk.reshape(HD, C), wv.reshape(HD, C)], dim=0)\n    proj = x.reshape(B * L, C) @ w_all.T\n    proj = proj.reshape(B, L, 3, H, D).permute(2, 0, 3, 1, 4)\n    q, k, v = proj.unbind(0)\n    \n    logits = q @ k.transpose(-1, -2) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        # Single stacked p@G\n        p_stack = torch.cat([p0, p1], dim=1)\n        pG_stack = p_stack @ G_exp\n        p0G = pG_stack[:, :H]\n        p1G = pG_stack[:, H:]\n        norm0_sq = (p0G * p0).sum(dim=-1, keepdim=True)\n        norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n        cross = (p0G * p1).sum(dim=-1, keepdim=True)\n        b0 = 1.0 - beta\n        normm_sq = b0*b0 * norm0_sq + beta*beta * norm1_sq + 2*b0*beta * cross\
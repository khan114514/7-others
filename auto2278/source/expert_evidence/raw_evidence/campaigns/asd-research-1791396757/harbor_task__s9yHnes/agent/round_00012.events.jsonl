dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n        normm = normm_sq.sqrt().clamp_min(1e-6)\n        ratio = (norm1 / normm).clamp(0.25, 4.0)\n        y = (p_mix @ v) * ratio\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ndef opt_best(x, wq, wk, wv, alpha, beta):\n    \\\"\\\"\\\"Contiguous q,k,v + inplace on fresh tensors.\\\"\\\"\\\"\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    xr = x.reshape(B * L, C)\n    HD = H * D\n    \n    q = (xr @ wq.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    \n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    \n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1_logits = logits.mul(a_p)\n        p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n        p1 = p1_logits.softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        \n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        \n        p1G = p1 @ G_exp\n        norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n        \n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n        \n        y = (p_mix @ v).mul_(ratio)\n    \n    return y.transpose(1, 2).flatten(2).contiguous()\n\ndef opt_combined_qkv(x, wq, wk, wv, alpha, beta):\n    \\\"\\\"\\\"Single combined QKV projection -> split -> contiguous.\\\"\\\"\\\"\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    \n    w_all = torch.cat([wq.reshape(HD, C), wk.reshape(HD, C), wv.reshape(HD, C)], dim=0)\n    proj = x.reshape(B * L, C) @ w_all.T\n    proj = proj.reshape(B, L, 3 * HD)\n    \n    # Reshape to (B, L, 3, H, D), permute to (3, B, H, L, D), unbind\n    proj = proj.reshape(B, L, 3, H, D).permute(2, 0, 3, 1, 4).contiguous()\n    q, k, v = proj[0], proj[1], proj[2]\n    # q,k,v are (B, H, L, D) and contiguous\n    \n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    \n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1_logits = logits.mul(a_p)\n        p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n        p1 = p1_logits.softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        \n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        \n        p1G = p1 @ G_exp\n        norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n        \n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n        \n        y = (p_mix @ v).mul_(ratio)\n    \n    return y.transpose(1, 2).flatten(2).contiguous()\n\ndef opt_fused_scale(x, wq, wk, wv, alpha, beta):\n    \\\"\\\"\\\"Fuse inv_sqrt_d into q weights + contiguous + inplace.\\\"\\\"\\\"\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    HD = H * D\n    \n    # Fuse the scaling into q weights\n    wq_scaled = wq.reshape(HD, C) * inv_sqrt_d\n    \n    xr = x.reshape(B * L, C)\n    q = (xr @ wq_scaled.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(HD, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n  
{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/bench_contig.py << 'PYEOF'\nimport time, math, torch\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\ndef ref_attention(x, wq, wk, wv, alpha, beta):\n    q = torch.einsum(\\\"blc,hdc->bhld\\\", x, wq)\n    k = torch.einsum(\\\"blc,hdc->bhld\\\", x, wk)\n    logits = (q @ k.transpose(-1, -2)) / math.sqrt(wq.shape[1])\n    p0 = logits.softmax(dim=-1)\n    base = p0 @ x.unsqueeze(1)\n    if alpha == 1.0:\n        modified = base\n    else:\n        perturbed = .5 * (1 + alpha) * logits + .5 * (1 - alpha) * logits.transpose(-1, -2)\n        modified = perturbed.softmax(dim=-1) @ x.unsqueeze(1)\n    blended = base + beta * (modified - base)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    y = torch.einsum(\\\"bhlc,hdc->bhld\\\", blended * ratio, wv)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ndef current_attention(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wv.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    logits = q @ k.transpose(-1, -2) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        p1G = p1 @ G_exp\n        norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n        normm = normm_sq.sqrt().clamp_min(1e-6)\n        ratio = (norm1 / normm).clamp(0.25, 4.0)\n        y = (p_mix @ v) * ratio\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ndef opt_contig(x, wq, wk, wv, alpha, beta):\n    \\\"\\\"\\\"Ensure q,k,v are contiguous for faster matmuls.\\\"\\\"\\\"\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    logits = q @ k.transpose(-1, -2) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        p1G = p1 @ G_exp\n        norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n        normm = normm_sq.sqrt().clamp_min(1e-6)\n        ratio = (norm1 / normm).clamp(0.25, 4.0)\n        y = (p_mix @ v) * ratio\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ndef opt_inplace1(x, wq, wk, wv, alpha, beta):\n    \\\"\\\"\\\"Contiguous + safe in-place operations on freshly allocated tensors.\\\"\\\"\\\"\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (xr @ wk.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    v = (xr @ wv.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        # Create p1_logits fresh (safe to modify)\n        p1_logits = logits.mul(a_p)\n        p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n        p1 = p1_logits.softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        p1G = p1 @ G_exp\n        norm1_sq = p1G.mul_(p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = pmG.mul_(p_mix).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n        y = (p_mix @ v).mul_(ratio)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ndef bench(fn, n=21, warmup=7):\n    for _ in range(warmup):\n        fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        t1 = time.process_time_ns()\n        times.append((t1 - t0) / 1e6)\n    times.sort()\n    return times[n//2]\n\ncases = [\n    (1, 64, 512, 8, 64, 1.05, 5.0),\n    (1, 128, 640, 10, 64, 1.1, 4.0),\n    (1, 128, 1280, 20, 64, 1.15, 3.0),\n    (1, 256, 1280, 20, 64, 1.05, 7.5),\n    (1, 256, 640, 10, 64, 1.2, 5.0),\n    (2, 128, 512, 8, 64, 1.0, 5.0),\n]\n\nvariants = [\n    (\\\"ref\\\", ref_attention),\n    (\\\"current\\\", current_attention),\n    (\\\"contig\\\", opt_contig),\n    (\\\"inplace1\\\", opt_inplace1),\n]\n\nprint(f\\\"{'Case':25s}\\\", end=\\\"\\\")\nfor name, _ in variants:\n    print(f\\\" {name:>14s}\\\", end=\\\"\\\")\nprint()\n\ngeom = [1.0] * (len(variants) - 1)\nfor B, L, C, H, D, alpha, beta in cases:\n    torch.manual_seed(42)\n    x = torch.randn(B, L, C)\n    wq = torch.randn(H, D, C)\n    wk = torch.randn(H, D, C)\n    wv = torch.randn(H, D, C)\n    \n    ref_out = ref_attention(x, wq, wk, wv, alpha, beta)\n    \n    times = []\n    for name, fn in variants:\n        t = bench(lambda: fn(x, wq, wk, wv, alpha, beta), n=15)\n        times.append(t)\n        if name \"'!= \"ref\":\n            out = fn(x, wq, wk, wv, alpha, beta)\n            diff = (out - ref_out).abs().max().item()\n            max_exp = ref_out.abs().max().item()\n            tol = 3e-5 + 3e-4 * max_exp\n            if diff > tol:\n                print(f\"'\"\\\\n  FAIL {name}: max_abs={diff:.2e}, tol={tol:.2e}\\\")\n    \n    label = f\\\"B{B}L{L}C{C}H{H}\\\"\n    print(f\\\"{label:25s}\\\", end=\\\"\\\")\n    for i, t in enumerate(times):\n        if i == 0:\n            print(f\\\" {t:14.2f}\\\", end=\\\"\\\")\n        else:\n            print(f\\\" {t:7.2f}({t/times[0]:.3f})\\\", end=\\\"\\\")\n            geom[i-1] *= t / times[0]\n    print()\n\nprint(f\\\"\\\\nGeomean ratio (vs ref):\\\")\nfor i, (name, _) in enumerate(variants[1:], 1):\n    print(f\\\"  {name:20s}: {geom[i-1]**(1/len(cases)):.4f}\\\")\nPYEOF\npython /tmp/bench_contig.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

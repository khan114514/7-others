, end=\\\"\\\")\n    for i, t in enumerate(times):\n        if i == 0:\n            print(f\\\" {t:14.2f}\\\", end=\\\"\\\")\n        else:\n            print(f\\\" {t:7.2f}({t/times[0]:.3f})\\\", end=\\\"\\\")\n            geom[i-1] *= t / times[0]\n    print()\n\nprint(f\\\"\\\\nGeomean ratio (vs ref):\\\")\nfor i, (name, _) in enumerate(variants[1:], 1):\n    print(f\\\"  {name:20s}: {geom[i-1]**(1/len(cases)):.4f}\\\")\nPYEOF\npython /tmp/bench_opt.py\"","aggregated_output":"Case                                 ref        current   combined_qkv     stacked_pG     p0p1_trick       full_opt\nB1L64C512H8                        16.54    4.89(0.295)    4.84(0.293)    4.61(0.278)    4.60(0.278)    4.95(0.299)\nB1L128C640H10                      26.07   12.65(0.485)   13.22(0.507)   12.62(0.484)   12.96(0.497)   14.39(0.552)\nB1L128C1280H20                     84.61   38.38(0.454)   38.21(0.452)   38.96(0.461)   37.96(0.449)   39.15(0.463)\nB1L256C1280H20                    292.23  163.99(0.561)  109.72(0.375)  113.07(0.387)  111.54(0.382)  119.11(0.408)\nB1L256C640H10                      61.13   44.12(0.722)   44.20(0.723)   43.43(0.710)   44.17(0.722)   51.46(0.842)\nB2L128C512H8                       27.45   13.31(0.485)   13.39(0.488)   13.16(0.480)   13.59(0.495)   20.40(0.743)\n\nGeomean ratio (vs ref):\n  current             : 0.4835\n  combined_qkv        : 0.4550\n  stacked_pG          : 0.4489\n  p0p1_trick          : 0.4515\n  full_opt            : 0.5187\n","exit_code":0,"status":"completed"}}

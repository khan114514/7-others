{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/sh -lc \"cat > /tmp/bench_deep.py << 'PYEOF'\nimport time, math, torch\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\ndef bench(fn, n=21, warmup=7):\n    for _ in range(warmup):\n        fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        t1 = time.process_time_ns()\n        times.append((t1 - t0) / 1e6)\n    times.sort()\n    return times[n//2]\n\n# Profile the big case in detail\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\ninv_sqrt_d = 1.0 / math.sqrt(D)\nHD = H * D\n\nxr = x.reshape(B * L, C)\nwqr = wq.reshape(HD, C)\nwkr = wk.reshape(HD, C)\nwvr = wv.reshape(HD, C)\n\n# Test: is q,k,v contiguous after permute?\nq = (xr @ wqr.T).reshape(B, L, H, D).permute(0, 2, 1, 3)\nprint(f\\\"q contiguous: {q.is_contiguous()}, shape: {q.shape}\\\")\nq_contig = q.contiguous()\nprint(f\\\"q_contig contiguous: {q_contig.is_contiguous()}\\\")\n\n# Time with and without contiguous\nt_perm_only = bench(lambda: (xr @ wqr.T).reshape(B, L, H, D).permute(0, 2, 1, 3))\nt_perm_contig = bench(lambda: (xr @ wqr.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous())\nprint(f\\\"permute only: {t_perm_only:.3f}ms, +contiguous: {t_perm_contig:.3f}ms\\\")\n\n# Time logits with permuted vs contiguous q,k\nlogits_perm = q @ q.transpose(-1, -2)\nlogits_contig = q_contig @ q_contig.transpose(-1, -2)\nprint(f\\\"logits shapes match: {(logits_perm - logits_contig).abs().max().item() < 1e-6}\\\")\nt_logits_perm = bench(lambda: q @ k.transpose(-1, -2) * inv_sqrt_d if False else q @ q.transpose(-1, -2) * inv_sqrt_d)\nt_logits_contig = bench(lambda: q_contig @ q_contig.transpose(-1, -2) * inv_sqrt_d)\nprint(f\\\"logits (permuted): {t_logits_perm:.3f}ms, logits (contig): {t_logits_contig:.3f}ms\\\")\n\n# Test: using view vs reshape for the BH,L,D reshaping\n# Try computing q as (B, L, H, D) -> (B, H, L, D) in a way that's already contiguous\n# Alternative: compute as (B, H, L, D) directly by reshaping weights differently\n\n# Try: q of shape (B*H, L, D) using bmm\nq_bmm = q.reshape(B*H, L, D)\nq_bmm_contig = q_contig.reshape(B*H, L, D)\nprint(f\\\"q_bmm contiguous: {q_bmm.is_contiguous()}\\\")\nprint(f\\\"q_bmm_contig contiguous: {q_bmm_contig.is_contiguous()}\\\")\n\nt_bmm_perm = bench(lambda: torch.bmm(q_bmm, q_bmm.transpose(-1, -2)))\nt_bmm_contig = bench(lambda: torch.bmm(q_bmm_contig, q_bmm_contig.transpose(-1, -2)))\nt_4d_perm = bench(lambda: q @ q.transpose(-1, -2))\nt_4d_contig = bench(lambda: q_contig @ q_contig.transpose(-1, -2))\nprint(f\\\"bmm (perm base): {t_bmm_perm:.3f}ms, bmm (contig base): {t_bmm_contig:.3f}ms\\\")\nprint(f\\\"4d (perm): {t_4d_perm:.3f}ms, 4d (contig): {t_4d_contig:.3f}ms\\\")\n\n# Softmax timing\nlogits = q_contig @ q_contig.transpose(-1, -2) * inv_sqrt_d\nt_sm = bench(lambda: logits.softmax(dim=-1))\nprint(f\\\"\\\\nsoftmax (4d): {t_sm:.3f}ms\\\")\n\nlogits_3d = logits.reshape(B*H, L, L)\nt_sm_3d = bench(lambda: logits_3d.softmax(dim=-1))\nprint(f\\\"softmax (3d): {t_sm_3d:.3f}ms\\\")\n\n# G = x @ x\"'^T and p@G timing\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)  # (B, 1, L, L)\np0 = logits.softmax(dim=-1)\np1 = (logits + logits.transpose(-1, -2)).softmax(dim=-1)\n\nt_pG = bench(lambda: p0 @ G_exp)\nprint(f\"'\"\\\\np0 @ G_exp (4d): {t_pG:.3f}ms\\\")\n\np0_3d = p0.reshape(B*H, L, L)\nG_3d = G.expand(B*H, L, L).contiguous()\nt_pG_bmm = bench(lambda: torch.bmm(p0_3d, G_3d))\nprint(f\\\"p0 @ G (bmm, contig G): {t_pG_bmm:.3f}ms\\\")\n\n# G not expanded - use broadcasting with 4d\n# p0: (B,H,L,L), G: (B,1,L,L) -> broadcast\nt_pG_bcast = bench(lambda: p0 @ G)\nprint(f\\\"p0 @ G (broadcast G): {t_pG_bcast:.3f}ms\\\")\n\nPYEOF\npython /tmp/bench_deep.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

im=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n        normm = normm_sq.sqrt().clamp_min(1e-6)\n        ratio = (norm1 / normm).clamp(0.25, 4.0)\n        y = (p_mix @ v) * ratio\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ndef best_candidate(x, wq, wk, wv, alpha, beta):\n    \\\"\\\"\\\"Stacked p0/p1@G norm trick + 4D approach.\\\"\\\"\\\"\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wv.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    logits = q @ k.transpose(-1, -2) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        p_both = torch.cat([p0, p1], dim=1)\n        pG_both = p_both @ G_exp\n        p0G = pG_both[:, :H]\n        p1G = pG_both[:, H:]\n        norm0_sq = (p0G * p0).sum(dim=-1, keepdim=True)\n        norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n        cross = (p0G * p1).sum(dim=-1, keepdim=True)\n        b0 = 1.0 - beta\n        normm_sq = b0*b0 * norm0_sq + beta*beta * norm1_sq + 2*b0*beta * cross\n        norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n        normm = normm_sq.sqrt().clamp_min(1e-6)\n        ratio = (norm1 / normm).clamp(0.25, 4.0)\n        y = (p_mix @ v) * ratio\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ndef best_bmm(x, wq, wk, wv, alpha, beta):\n    \\\"\\\"\\\"bmm approach with stacked p@G.\\\"\\\"\\\"\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    BH = B * H\n    \n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).reshape(BH, L, D)\n    k = (xr @ wk.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).reshape(BH, L, D)\n    v = (xr @ wv.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).reshape(BH, L, D)\n    \n    logits = torch.bmm(q, k.transpose(-1, -2))\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    \n    if alpha == 1.0:\n        y = torch.bmm(p0, v)\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1_logits = logits.mul(a_p)\n        p1_logits.add_(logits.transpose(-1, -2), alpha=a_m)\n        p1 = p1_logits.softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        \n        G = x @ x.transpose(-1, -2)\n        G_bmm = G.unsqueeze(1).expand(B, H, L, L).reshape(BH, L, L)\n        \n        p_both = torch.cat([p0, p1], dim=0)\n        G_both = G_bmm.repeat(2, 1, 1)\n        pG_both = torch.bmm(p_both, G_both)\n        p0G = pG_both[:BH]\n        p1G = pG_both[BH:]\n        \n        norm0_sq = (p0G * p0).sum(dim=-1, keepdim=True)\n        norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n        cross = (p0G * p1).sum(dim=-1, keepdim=True)\n        b0 = 1.0 - beta\n        normm_sq = b0*b0 * norm0_sq + beta*beta * norm1_sq + 2*b0*beta * cross\n        \n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = (norm1 / normm).clamp_(0.25, 4.0)\n        \n        y = torch.bmm(p_mix, v).mul_(ratio)\n    \n    return y.reshape(B, H, L, D).transpose(1, 2).flatten(2).contiguous()\n\ndef bench(fn, n=21, warmup=7):\n    for _ in range(warmup):\n        fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        t1 = time.process_time_ns()\n        times.append((t1 - t0) / 1e6)\n    times.sort()\n    return times[n//2]\n\ncases = [\n    (1, 64, 512, 8, 64, 1.05, 5.0),\n    (
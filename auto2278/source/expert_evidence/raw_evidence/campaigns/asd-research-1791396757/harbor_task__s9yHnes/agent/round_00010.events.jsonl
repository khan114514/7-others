4():\n    G_rep = G.repeat_interleave(2*H, dim=0)  # (2*BH, L, L)\n    p_stack = torch.cat([p0, p1], dim=1).reshape(B*2*H, L, L)\n    pG_stack = torch.bmm(p_stack, G_rep)\n    pG_4d = pG_stack.reshape(B, 2*H, L, L)\n    p0G = pG_4d[:, :H, :, :]\n    p1G = pG_4d[:, H:, :, :]\n    norm0_sq = (p0G * p0).sum(dim=-1, keepdim=True)\n    norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n    cross = (p0G * p1).sum(dim=-1, keepdim=True)\n    normm_sq = b0*b0 * norm0_sq + beta*beta * norm1_sq + 2*b0*beta * cross\n    return norm1_sq, normm_sq\n\n# Verify correctness\nn1a, n1b = method1()\nn2a, n2b = method2()\nn3a, n3b = method3()\nprint(f\\\"method2 diff1: {(n1a-n2a).abs().max():.2e}, diff2: {(n1b-n2b).abs().max():.2e}\\\")\nprint(f\\\"method3 diff1: {(n1a-n3a).abs().max():.2e}, diff2: {(n1b-n3b).abs().max():.2e}\\\")\n\nprint(f\\\"\\\\nmethod1 (current):  {bench(method1):8.1f} us\\\")\nprint(f\\\"method2 (algebraic): {bench(method2):8.1f} us\\\")\nprint(f\\\"method3 (stacked): {bench(method3):8.1f} us\\\")\n\n# Just the matmul part\nprint(f\\\"\\\\nJust p@G matmuls:\\\")\nprint(f\\\"  single p@G (H heads): {bench(lambda: p0 @ G_exp):8.1f} us\\\")\nprint(f\\\"  two separate: {bench(lambda: (p0 @ G_exp, p1 @ G_exp)):8.1f} us\\\")\np_stack = torch.cat([p0, p1], dim=1)\nprint(f\\\"  stacked (2H heads): {bench(lambda: p_stack @ G_exp):8.1f} us\\\")\n\nPYEOF\npython /tmp/bench_stack.py\"","aggregated_output":"=== Norm computation strategies ===\nmethod2 diff1: 0.00e+00, diff2: 1.91e-05\nmethod3 diff1: 0.00e+00, diff2: 1.91e-05\n\nmethod1 (current):   52094.7 us\nmethod2 (algebraic):  62078.5 us\nmethod3 (stacked):  47355.5 us\n\nJust p@G matmuls:\n  single p@G (H heads):  14346.8 us\n  two separate:  34643.6 us\n  stacked (2H heads):  72650.0 us\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/sh -lc \"cat << 'PYEOF' > /tmp/bench_stack2.py\nimport time, math, torch\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\ndef bench(fn, n=30, warmup=5):\n    for _ in range(warmup):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    return (time.process_time_ns() - t0) / n / 1000  # us\n\n# Test across all case sizes\ncases = [\n    (1, 256, 1280, 20, 64),\n    (1, 256, 640, 10, 64),\n    (1, 128, 1280, 20, 64),\n    (1, 128, 640, 10, 64),\n    (1, 64, 512, 8, 64),\n]\n\nfor B, L, C, H, D in cases:\n    torch.manual_seed(0)\n    x = torch.randn(B, L, C)\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    p0 = torch.randn(B, H, L, L).softmax(dim=-1)\n    p1 = torch.randn(B, H, L, L).softmax(dim=-1)\n    beta = 0.3\n    b0 = 1.0 - beta\n    \n    # Method 1 (current): p1@G + p_mix@G\n    p_mix = torch.lerp(p0, p1, beta)\n    def m1():\n        p1G = p1 @ G_exp\n        pmG = p_mix @ G_exp\n        n1 = (p1G * p1).sum(dim=-1, keepdim=True)\n        nm = (pmG * p_mix).sum(dim=-1, keepdim=True)\n        return n1, nm\n    \n    # Method 2 (stacked 2H heads + algebraic)\n    def m2():\n        ps = torch.cat([p0, p1], dim=1)\n        pgs = ps @ G_exp\n        p0G = pgs[:, :H]\n        p1G = pgs[:, H:]\n        n0 = (p0G * p0).sum(dim=-1, keepdim=True)\n        n1 = (p1G * p1).sum(dim=-1, keepdim=True)\n        cross = (p0G * p1).sum(dim=-1, keepdim=True)\n        nm = b0*b0*n0 + beta*beta*n1 + 2*b0*beta*cross\n        return n1, nm\n    \n    t1 = bench(m1)\n    t2 = bench(m2)\n    \n    n1a, nmb = m2()\n    n1r, nmr = m1()\n    diff1 = (n1a - n1r).abs().max().item()\n    diffm = (nmb - nmr).abs().max().item()\n    \n    print(f\\\"B{B}L{L:3d}C{C:4d}H{H:2d}:  m1={t1:8.1f}  m2={t2:8.1f}  ratio={t2/t1:.3f}  diff1={diff1:.1e}  diffm={diffm:.1e}\\\")\n\nPYEOF\npython /tmp/bench_stack2.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

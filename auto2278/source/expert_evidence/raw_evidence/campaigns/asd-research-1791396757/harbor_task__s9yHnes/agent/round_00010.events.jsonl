{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/sh -lc \"cat << 'PYEOF' > /workspace/solution/method.py\n\\\"\\\"\\\"Optimized multihead retrieval kernel: BH-flat bmm layout, v-first ordering, Gram-matrix norms.\\\"\\\"\\\"\nimport math\nimport torch\n\n\n@torch.no_grad()\ndef attention(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    BH = B * H\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n\n    xr = x.reshape(B * L, C)\n    wqr = wq.reshape(H * D, C)\n    wkr = wk.reshape(H * D, C)\n    wvr = wv.reshape(H * D, C)\n\n    q = (xr @ wqr.T).reshape(B, L, H, D).permute(0, 2, 1, 3).reshape(BH, L, D)\n    k = (xr @ wkr.T).reshape(B, L, H, D).permute(0, 2, 1, 3).reshape(BH, L, D)\n    v = (xr @ wvr.T).reshape(B, L, H, D).permute(0, 2, 1, 3).reshape(BH, L, D)\n\n    logits = torch.bmm(q, k.transpose(1, 2))\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n\n    if alpha == 1.0:\n        y = torch.bmm(p0, v)\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1_logits = a_p * logits + a_m * logits.transpose(1, 2)\n        p1 = p1_logits.softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n\n        G = x @ x.transpose(-1, -2)\n        G_bh = G.repeat_interleave(H, dim=0)\n\n        p1G = torch.bmm(p1, G_bh)\n        norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n        pmG = torch.bmm(p_mix, G_bh)\n        normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n\n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = (norm1 / normm).clamp_(0.25, 4.0)\n\n        y = torch.bmm(p_mix, v)\n        y.mul_(ratio)\n\n    return y.reshape(B, H, L, D).transpose(1, 2).flatten(2).contiguous()\nPYEOF\necho \\\"done\\\"\"","aggregated_output":"done\n","exit_code":0,"status":"completed"}}

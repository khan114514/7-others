{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/sh -lc \"cat << 'PYEOF' > /tmp/bench_micro2.py\nimport time, math, torch\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\ndef bench(fn, n=50, warmup=5):\n    for _ in range(warmup):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    return (time.process_time_ns() - t0) / n / 1000  # us\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\ntorch.manual_seed(0)\nx = torch.randn(B, L, C)\nxr = x.reshape(B * L, C)\n\n# --- Projection ---\nwqr = wq = torch.randn(H, D, C).reshape(H*D, C)\nwkr = torch.randn(H, D, C).reshape(H*D, C)\nwvr = torch.randn(H, D, C).reshape(H*D, C)\n\nprint(\\\"=== Projection ===\\\")\nprint(f\\\"  q single: {bench(lambda: xr @ wqr.T):8.1f} us\\\")\nprint(f\\\"  3 separate: {bench(lambda: (xr @ wqr.T, xr @ wkr.T, xr @ wvr.T)):8.1f} us\\\")\nw_all = torch.cat([wqr, wkr, wvr], dim=0)\nprint(f\\\"  fused 3x: {bench(lambda: xr @ w_all.T):8.1f} us\\\")\n\n# --- Logits ---\nq = (xr @ wqr.T).reshape(B, L, H, D).permute(0, 2, 1, 3)\nk = (xr @ wkr.T).reshape(B, L, H, D).permute(0, 2, 1, 3)\nq3d = q.reshape(B*H, L, D)\nk3d = k.reshape(B*H, L, D)\n\nprint(\\\"\\\\n=== Logits ===\\\")\nprint(f\\\"  4D q@k\"'^T: {bench(lambda: q @ k.transpose(-1, -2)):8.1f} us\")\nprint(f\"  bmm q@k''^T: {bench(lambda: torch.bmm(q3d, k3d.transpose(1, 2))):8.1f} us\")\n\nlogits_4d = q @ k.transpose(-1, -2)\nlogits_3d = logits_4d.reshape(B*H, L, L)\n\nprint(f\"'\"\\\\n=== Softmax ===\\\")\nprint(f\\\"  4D softmax: {bench(lambda: logits_4d.softmax(dim=-1)):8.1f} us\\\")\nprint(f\\\"  3D softmax: {bench(lambda: logits_3d.softmax(dim=-1)):8.1f} us\\\")\n\n# --- P1 (a_p * logits + a_m * logits\"'^T + softmax) ---\na_p, a_m = 0.75, 0.25\nprint(f\"'\"\\\\n=== P1 compute ===\\\")\nprint(f\\\"  4D full: {bench(lambda: (a_p * logits_4d + a_m * logits_4d.transpose(-1,-2)).softmax(dim=-1)):8.1f} us\\\")\nprint(f\\\"  3D full: {bench(lambda: (a_p * logits_3d + a_m * logits_3d.transpose(1,2)).softmax(dim=-1)):8.1f} us\\\")\n\n# Separate timing: fused axpby + softmax vs separate\nprint(f\\\"\\\\n=== A + A\"'^T scaling ===\")\nprint(f\"  4D axpby only: {bench(lambda: a_p * logits_4d + a_m * logits_4d.transpose(-1,-2)):8.1f} us\")\n\n# --- Attention output ---\nv = (xr @ wvr.T).reshape(B, L, H, D).permute(0, 2, 1, 3)\nv3d = v.reshape(B*H, L, D)\np = logits_4d.softmax(dim=-1)\np3d = p.reshape(B*H, L, L)\n\nprint(f\"'\"\\\\n=== Attention output p@v ===\\\")\nprint(f\\\"  4D p@v: {bench(lambda: p @ v):8.1f} us\\\")\nprint(f\\\"  bmm p@v: {bench(lambda: torch.bmm(p3d, v3d)):8.1f} us\\\")\n\n# --- Gram matrix ---\nprint(f\\\"\\\\n=== Gram G = x@x\"'^T ===\")\nprint(f\"  G = x @ x''^T: {bench(lambda: x @ x.transpose(-1,-2)):8.1f} us\")\nG = x @ x.transpose(-1, -2)\nG_exp = G.unsqueeze(1)\n\nprint(f\"'\"\\\\n=== p @ G ===\\\")\nprint(f\\\"  4D broadcast: {bench(lambda: p @ G_exp):8.1f} us\\\")\nG_rep = G.repeat_interleave(H, dim=0)\nprint(f\\\"  bmm (repeated): {bench(lambda: torch.bmm(p3d, G_rep)):8.1f} us\\\")\nG_exp_big = G_exp.expand(B, H, L, L).reshape(B*H, L, L)\nprint(f\\\"  bmm (expanded): {bench(lambda: torch.bmm(p3d, G_exp_big)):8.1f} us\\\")\n\n# --- Norm computation ---\npG = p @ G_exp\nprint(f\\\"\\\\n=== Norm from pG ===\\\")\nprint(f\\\"  (pG * p).sum(-1, keepdim): {bench(lambda: (pG * p).sum(dim=-1, keepdim=True)):8.1f} us\\\")\nprint(f\\\"  einsum diags: {bench(lambda: torch.einsum('bhij,bhij->bhi', p, pG).unsqueeze(-1)):8.1f} us\\\")\n\n# --- Lerp ---\np0 = logits_4d.softmax(dim=-1)\np1 = (a_p * logits_4d + a_m * logits_4d.transpose(-1,-2)).softmax(dim=-1)\nprint(f\\\"\\\\n=== Lerp ===\\\")\nprint(f\\\"  torch.lerp: {bench(lambda: torch.lerp(p0, p1, 0.3)):8.1f} us\\\")\nprint(f\\\"  (1-b)*p0 + b*p1: {bench(lambda: 0.7*p0 + 0.3*p1):8.1f} us\\\")\n\n# --- Full total ---\nprint(f\\\"\\\\n=== Misc ===\\\")\nprint(f\\\"  permute(0,2,1,3)+contiguous: {bench(lambda: torch.randn(B,L,H,D).permute(0,2,1,3).contiguous()):8.1f} 
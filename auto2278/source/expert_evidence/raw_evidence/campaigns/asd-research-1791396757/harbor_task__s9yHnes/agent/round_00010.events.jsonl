{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/sh -lc \"cat << 'PYEOF' > /tmp/bench_sm.py\nimport time, math, torch\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\ndef bench(fn, n=100, warmup=10):\n    for _ in range(warmup):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    return (time.process_time_ns() - t0) / n / 1000  # us\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\ntorch.manual_seed(0)\nlogits_4d = torch.randn(B, H, L, L)\n\nprint(\\\"Softmax benchmarks (BH*L rows, L columns):\\\")\nprint(f\\\"  4D softmax(-1):        {bench(lambda: logits_4d.softmax(dim=-1)):8.1f} us\\\")\n\nlogits_3d = logits_4d.reshape(B*H, L, L)\nprint(f\\\"  view->3D softmax(-1):  {bench(lambda: logits_3d.softmax(dim=-1)):8.1f} us\\\")\n\nlogits_2d = logits_4d.reshape(B*H*L, L)\nprint(f\\\"  view->2D softmax(-1):  {bench(lambda: logits_2d.softmax(dim=-1)):8.1f} us\\\")\n\n# contiguous first?\nlogits_3d_c = logits_4d.reshape(B*H, L, L).contiguous()\nprint(f\\\"  contiguous 3D sm(-1):  {bench(lambda: logits_3d_c.softmax(dim=-1)):8.1f} us\\\")\n\nlogits_2d_c = logits_4d.reshape(B*H*L, L).contiguous()\nprint(f\\\"  contiguous 2D sm(-1):  {bench(lambda: logits_2d_c.softmax(dim=-1)):8.1f} us\\\")\n\n# What about log_softmax then exp?\nprint(f\\\"  4D log_softmax.exp:    {bench(lambda: logits_4d.log_softmax(dim=-1).exp()):8.1f} us\\\")\n\n# Manual softmax?\ndef manual_softmax(x):\n    m = x.max(dim=-1, keepdim=True).values\n    e = (x - m).exp()\n    return e / e.sum(dim=-1, keepdim=True)\n\nprint(f\\\"  manual 4D softmax:     {bench(lambda: manual_softmax(logits_4d)):8.1f} us\\\")\n\n# Test on smaller case too\nB2, L2, H2 = 1, 64, 8\nlogits_small = torch.randn(B2, H2, L2, L2)\nlogits_small_2d = logits_small.reshape(B2*H2*L2, L2)\nprint(f\\\"\\\\nSmall case (L={L2}, H={H2}):\\\")\nprint(f\\\"  4D softmax(-1):        {bench(lambda: logits_small.softmax(dim=-1)):8.1f} us\\\")\nprint(f\\\"  view->2D softmax(-1):  {bench(lambda: logits_small_2d.softmax(dim=-1)):8.1f} us\\\")\n\n# Now test full pipeline with 2D softmax approach\nprint(f\\\"\\\\n=== Full pipeline test ===\\\")\nalpha, beta = 1.05, 7.5\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\ndef current():\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wv.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    logits = q @ k.transpose(-1, -2) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    p1G = p1 @ G_exp\n    norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n    normm = normm_sq.sqrt().clamp_min(1e-6)\n    ratio = (norm1 / normm).clamp(0.25, 4.0)\n    y = (p_mix @ v) * ratio\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ndef opt_2dsoftmax():\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    BH = B * H\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wv.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    logits = q @ k.transpose(-1, -2) * inv_sqrt_d  # (B, H, L, L)\n    logits_2d = logits.reshape(BH * L, L)\n    p0 = logits_2d.softmax(dim=-1).reshape(B, H, L, L)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1_logits = (a_p * logits + a_m * logits.transpose(-1, -2))\n    p1 = p1_logits.reshape(BH * L, L).softmax(dim=-1).reshape(B, H, L, L)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    p1G = p1 @ G_exp\n    norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n    normm = normm_sq.sqrt().clamp_min(1e-6)\n    ratio = (norm1 / normm).clamp(0.25, 4.0)\n    y = (p_mix @ v) * ratio\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Verify\nr1 = current()\nr2 = opt_2dsoftmax()\nprint(f\\\"  2D softmax diff: {(r1-r2).abs().max():.2e}\\\")\n\ndef bench_ms(fn, n=15):\n    for _ in range(5): fn()\n    t0 = time.process_time_ns()\n    for _ in range(n): fn()\n    return (time.process_time_ns() - t0) / n / 1e6\n\nprint(f\\\"  current:    {bench_ms(current):.2f} ms\\\")\nprint(f\\\"  2d_softmax: {bench_ms(opt_2dsoftmax):.2f} ms\\\")\n\nPYEOF\npython /tmp/bench_sm.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

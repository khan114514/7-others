{"type":"item.completed","item":{"id":"item_47","type":"agent_message","text":"The einsum projection is actually slower in the full pipeline — the projection-only benchmark was misleading because einsum was compared to a single matmul, not the three-matmul approach. The current approach is better.\n\nLet me try another angle: can we compute the logits more efficiently? The logits computation is q @ k^T * inv_sqrt_d. But what if we pre-scale q by inv_sqrt_d, i.e., `(q * inv_sqrt_d) @ k.T` vs `(q @ k.T) * inv_sqrt_d`? The first does BHLD multiplies, the second does BHLL multiplies. For L=256, D=64: BH*L*D = 20*256*64 = 328K vs BH*L*L = 20*256*256 = 1.3M. So pre-scaling q is better!\n\nLet me try this:\n</parameter>\n<parameter name=\"yield_time_ms\">\n\nLet me try pre-scaling q (cheaper than scaling the full logits matrix) and a few more small optimizations.\n<parameter name=\"yield_time_ms\">\n\n"}}
{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/sh -lc \"cat << 'PYEOF' > /tmp/bench_tweak.py\nimport time, math, torch\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\ndef bench_median(fn, n=30, warmup=5):\n    for _ in range(warmup):\n        fn()\n    times = []\n    for _ in range(n):\n        t0 = time.process_time_ns()\n        fn()\n        times.append(time.process_time_ns() - t0)\n    import statistics\n    return statistics.median(times) / 1e6\n\ndef ref(x, wq, wk, wv, alpha, beta):\n    q = torch.einsum(\\\"blc,hdc->bhld\\\", x, wq)\n    k = torch.einsum(\\\"blc,hdc->bhld\\\", x, wk)\n    logits = (q @ k.transpose(-1, -2)) / math.sqrt(wq.shape[1])\n    p0 = logits.softmax(dim=-1)\n    base = p0 @ x.unsqueeze(1)\n    if alpha == 1.0:\n        modified = base\n    else:\n        perturbed = .5 * (1 + alpha) * logits + .5 * (1 - alpha) * logits.transpose(-1, -2)\n        modified = perturbed.softmax(dim=-1) @ x.unsqueeze(1)\n    blended = base + beta * (modified - base)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    y = torch.einsum(\\\"bhlc,hdc->bhld\\\", blended * ratio, wv)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ndef current(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wv.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    logits = q @ k.transpose(-1, -2) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        p1G = p1 @ G_exp\n        norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n        normm = normm_sq.sqrt().clamp_min(1e-6)\n        ratio = (norm1 / normm).clamp(0.25, 4.0)\n        y = (p_mix @ v) * ratio\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Pre-scale q by inv_sqrt_d (fewer multiplies than scaling full logits)\ndef opt_prescale_q(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wv.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    q.mul_(inv_sqrt_d)\n    logits = q @ k.transpose(-1, -2)\n    p0 = logits.softmax(dim=-1)\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        p1G = p1 @ G_exp\n        norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n        normm = normm_sq.sqrt().clamp_min(1e-6)\n        ratio = (norm1 / normm).clamp(0.25, 4.0)\n        y = (p_mix @ v) * ratio\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Fuse wq scaling: use wq * inv_sqrt_d for projection so q is pre-scaled\ndef opt_fused_wq_scale(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    xr = x.reshape(B * L, C)\n    # Scale wq before projection (avoids separate q scaling step)\n    q = (xr @ (wq.reshape(H * D, C) * inv_sqrt_d).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wv.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    logits = q @ k.transpose(-1, -2)\n    p0 = logits.softmax(dim=-1)\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        p1G = p1 @ G_exp\n        norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n        normm = normm_sq.sqrt().clamp_min(1e-6)\n        ratio = (norm1 / normm).clamp(0.25, 4.0)\n        y = (p_mix @ v) * ratio\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Pre-scale wq weight AND use p0.unsqueeze approach for cross-term\n# Actually, the key idea: can we fold the inv_sqrt_d into the wq matmul?\n# q * inv_sqrt_d = x @ (wq * inv_sqrt_d)\"'^T. Yes!\n# So we can scale wq once and avoid the logits scaling.\n\ncases = [\n    (1, 64, 512, 8, 64, 1.05, 5.0),\n    (1, 128, 640, 10, 64, 1.1, 4.0),\n    (1, 128, 1280, 20, 64, 1.15, 3.0),\n    (1, 256, 1280, 20, 64, 1.05, 7.5),\n    (1, 256, 640, 10, 64, 1.2, 5.0),\n    (2, 128, 512, 8, 64, 1.0, 5.0),\n]\n\nvariants = [\n    (\"ref\", ref),\n    (\"current\", current),\n    (\"prescale_q\", opt_prescale_q),\n    (\"fused_wq_scale\", opt_fused_wq_scale),\n]\n\ngeo = [1.0] * (len(variants) - 1)\ncnt = 0\n\nfor B, L, C, H, D, alpha, beta in cases:\n    torch.manual_seed(0)\n    x = torch.randn(B, L, C)\n    wq = torch.randn(H, D, C)\n    wk = torch.randn(H, D, C)\n    wv = torch.randn(H, D, C)\n    \n    ref_out = ref(x, wq, wk, wv, alpha, beta)\n    times = []\n    failed = []\n    for name, fn in variants:\n        ms = bench_median(lambda: fn(x, wq, wk, wv, alpha, beta), n=25)\n        times.append(ms)\n        if name != \"ref\":\n            out = fn(x, wq, wk, wv, alpha, beta)\n            diff = (out - ref_out).abs().max().item()\n            maxe = ref_out.abs().max().item()\n            tol = 3e-5 + 3e-4 * maxe\n            if diff > tol:\n                failed.append(f\"{name}:{diff:.2e}\")\n    \n    label = f\"B{B}L{L}C{C}H{H}\"\n    print(f\"{label:18s}  ref={times[0]:7.2f}  \", end=\"\")\n    for j in range(1, len(variants)):\n        r = times[j] / times[0]\n        geo[j-1] *= r\n        print(f\"{variants[j][0]}={r:.4f}  \", end=\"\")\n    if failed:\n        print(f\"  FAIL: {failed}\")\n    else:\n        print()\n    cnt += 1\n\nprint(f\"'\"\\\\nGeometric mean ratio (vs ref):\\\")\nfor j in range(1, len(variants)):\n    print(f\\\"  {variants[j][0]:20s}: {geo[j-1]**(1/cnt):.4f}\\\")\nPYEOF\npython /tmp/bench_tweak.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

pe(B * L, C)\n    \n    q = (xr @ wq.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wv.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    \n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    \n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        \n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        \n        # Stack p0 and p1 for single matmul\n        p_stack = torch.cat([p0, p1], dim=1)\n        pG_stack = p_stack @ G_exp\n        p0G = pG_stack[:, :H, :, :]\n        p1G = pG_stack[:, H:, :, :]\n        \n        norm0_sq = (p0G * p0).sum(dim=-1, keepdim=True)\n        norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n        cross = (p0G * p1).sum(dim=-1, keepdim=True)\n        \n        b1 = 1.0 - beta\n        normm_sq = b1*b1 * norm0_sq + beta*beta * norm1_sq + 2*b1*beta * cross\n        \n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n        \n        y = p_mix @ v\n        y.mul_(ratio)\n    \n    return y.transpose(1, 2).flatten(2).contiguous()\n\ncases = [\n    (1, 64, 512, 8, 64, 1.05, 5.0),\n    (1, 128, 640, 10, 64, 1.1, 4.0),\n    (1, 128, 1280, 20, 64, 1.15, 3.0),\n    (1, 256, 1280, 20, 64, 1.05, 7.5),\n    (1, 256, 640, 10, 64, 1.2, 5.0),\n    (2, 128, 512, 8, 64, 1.0, 5.0),\n]\n\nvariants = [\n    (\"ref\", ref),\n    (\"current\", current),\n    (\"best\", opt_best),\n    (\"stacked_pG\", opt_stacked_pG),\n    (\"algebraic_norm\", opt_algebraic_norm),\n]\n\ngeo = [1.0] * (len(variants) - 1)\ncnt = 0\n\nfor B, L, C, H, D, alpha, beta in cases:\n    torch.manual_seed(0)\n    x = torch.randn(B, L, C)\n    wq = torch.randn(H, D, C)\n    wk = torch.randn(H, D, C)\n    wv = torch.randn(H, D, C)\n    \n    ref_out = ref(x, wq, wk, wv, alpha, beta)\n    times = []\n    failed = []\n    for name, fn in variants:\n        ms = bench_median(lambda: fn(x, wq, wk, wv, alpha, beta), n=25)\n        times.append(ms)\n        if name != \"ref\":\n            out = fn(x, wq, wk, wv, alpha, beta)\n            diff = (out - ref_out).abs().max().item()\n            maxe = ref_out.abs().max().item()\n            tol = 3e-5 + 3e-4 * maxe\n            if diff > tol:\n                failed.append(f\"{name}:{diff:.2e}\")\n    \n    label = f\"B{B}L{L}C{C}H{H}\"\n    print(f\"{label:18s}  ref={times[0]:7.2f}  \", end=\"\")\n    for j in range(1, len(variants)):\n        r = times[j] / times[0]\n        geo[j-1] *= r\n        print(f\"{variants[j][0]}={r:.4f}  \", end=\"\")\n    if failed:\n        print(f\"  FAIL: {failed}\")\n    else:\n        print()\n    cnt += 1\n\nprint(f\"'\"\\\\nGeometric mean ratio (vs ref):\\\")\nfor j in range(1, len(variants)):\n    print(f\\\"  {variants[j][0]:20s}: {geo[j-1]**(1/cnt):.4f}\\\")\nPYEOF\npython /tmp/bench_tweak2.py\"","aggregated_output":"B1L64C512H8         ref=  16.34  current=0.2832  best=0.2871  stacked_pG=0.2810  algebraic_norm=0.2858  \nB1L128C640H10       ref=  24.81  current=0.5318  best=0.5151  stacked_pG=0.5913  algebraic_norm=0.6004  \nB1L128C1280H20      ref=  82.08  current=0.4453  best=0.4567  stacked_pG=0.4670  algebraic_norm=0.4570  \nB1L256C1280H20      ref= 229.77  current=0.5012  best=0.5143  stacked_pG=0.4824  algebraic_norm=0.5047  \nB1L256C640H10       ref=  60.99  current=0.7324  best=0.7538  stacked_pG=0.7070  algebraic_norm=0.7320  \nB2L128C512H8        ref=  29.58  current=0.4544  best=0.4510  stacked_pG=0.4444  algebraic_norm=0.4442  \n\nGeometric mean ratio (vs ref):\n  current             : 0.4729\n  best                : 0.4772\n  stacked_pG          : 0.4769\n  
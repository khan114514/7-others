max(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        p1G = p1 @ G_exp\n        norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n        normm = normm_sq.sqrt().clamp_min(1e-6)\n        ratio = (norm1 / normm).clamp(0.25, 4.0)\n        y = (p_mix @ v) * ratio\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Best combination: prescale_q in-place + in-place sqrt/clamp + logits.mul_\ndef opt_best(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    xr = x.reshape(B * L, C)\n    \n    q = (xr @ wq.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wv.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    \n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    \n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        \n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        \n        p1G = p1 @ G_exp\n        norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n        \n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n        \n        y = p_mix @ v\n        y.mul_(ratio)\n    \n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Also try: compute both p1G and pmG in one go by stacking p1 and p_mix\ndef opt_stacked_pG(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    xr = x.reshape(B * L, C)\n    \n    q = (xr @ wq.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wv.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    \n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    \n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        \n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        \n        # Stack p1 and p_mix along H dim for single large matmul\n        p_stack = torch.cat([p1, p_mix], dim=1)  # (B, 2H, L, L)\n        pG_stack = p_stack @ G_exp\n        p1G = pG_stack[:, :H, :, :]\n        pmG = pG_stack[:, H:, :, :]\n        \n        norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n        normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n        \n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n        \n        y = p_mix @ v\n        y.mul_(ratio)\n    \n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Also try: algebraic normm_sq from p0@G and p1@G (stacked) + skip pmG\n# p_mix = (1-b)*p0 + b*p1\n# normm_sq = (1-b)\"'^2 * ||p0@x||''^2 + b''^2 * ||p1@x||''^2 + 2*(1-b)*b * (p0@x)·(p1@x)\n# = (1-b)''^2 * diag(p0@G@p0''^T) + b''^2 * diag(p1@G@p1''^T) + 2*(1-b)*b * diag(p0@G@p1''^T)\n# All computable from p0@G and p1@G\ndef opt_algebraic_norm(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    xr = x.reshape(B * L, C)\n    \n    q = (xr @ wq.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wv.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    \n    logits = q @ k.transpose(-1, -2)\n    logits.mul_(inv_sqrt_d)\n    p0 = logits.softmax(dim=-1)\n    \n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        \n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        \n        # Stack p0 and p1 for single matmul\n        p_stack = torch.cat([p0, p1], dim=1)\n        pG_stack = p_stack @ G_exp\n        p0G = pG_stack[:, :H, :, :]\n        p1G = pG_stack[:, H:, :, :]\n        \n        norm0_sq = (p0G * p0).sum(dim=-1, keepdim=True)\n        norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n        cross = (p0G * p1).sum(dim=-1, keepdim=True)\n        \n        b1 = 1.0 - beta\n        normm_sq = b1*b1 * norm0_sq + beta*beta * norm1_sq + 2*b1*beta * cross\n        \n        norm1 = norm1_sq.sqrt_().clamp_min_(1e-6)\n        normm = normm_sq.sqrt_().clamp_min_(1e-6)\n        ratio = norm1.div_(normm).clamp_(0.25, 4.0)\n        \n        y = p_mix @ v\n        y.mul_(ratio)\n    \n    return y.transpose(1, 2).flatten(2).contiguous()\n\ncases = [\n    (1, 64, 512, 8, 64, 1.05, 5.0),\n    (1, 128, 640, 10, 64, 1.1, 4.0),\n    (1, 128, 1280, 20, 64, 1.15, 3.0),\n    (1, 256, 1280, 20, 64, 1.05, 7.5),\n    (1, 256, 640, 10, 64, 1.2, 5.0),\n    (2, 128, 512, 8, 64, 1.0, 5.0),\n]\n\nvariants = [\n    (\"ref\", ref),\n    (\"current\", current),\n    (\"best\", opt_best),\n    (\"stacked_pG\", opt_stacked_pG),\n    (\"algebraic_norm\", opt_algebraic_norm),\n]\n\ngeo = [1.0] * (len(variants) - 1)\ncnt = 0\n\nfor B, L, C, H, D, alpha, beta in cases:\n    torch.manual_seed(0)\n    x = torch.randn(B, L, C)\n    wq = torch.randn(H, D, C)\n    wk = torch.randn(H, D, C)\n    wv = torch.randn(H, D, C)\n    \n    ref_out = ref(x, wq, wk, wv, alpha, beta)\n    times = []\n    failed = []\n    for name, fn in variants:\n        ms = bench_median(lambda: fn(x, wq, wk, wv, alpha, beta), n=25)\n        times.append(ms)\n        if name != \"ref\":\n            out = fn(x, wq, wk, wv, alpha, beta)\n            diff = (out - ref_out).abs().max().item()\n            maxe = ref_out.abs().max().item()\n            tol = 3e-5 + 3e-4 * maxe\n            if diff > tol:\n                failed.append(f\"{name}:{diff:.2e}\")\n    \n    label = f\"B{B}L{L}C{C}H{H}\"\n    print(f\"{label:18s}  ref={times[0]:7.2f}  \", end=\"\")\n    for j in range(1, len(variants)):\n        r = times[j] / times[0]\n        geo[j-1] *= r\n        print(f\"{variants[j][0]}={r:.4f}  \", end=\"\")\n    if failed:\n        print(f\"  FAIL: {failed}\")\n    else:\n        print()\n    cnt += 1\n\nprint(f\"'\"\\\\nGeometric mean ratio (vs ref):\\\")\nfor j in range(1, len(variants)):\n    print(f\\\"  {variants[j][0]:20s}: {geo[j-1]**(1/cnt):.4f}\\\")\nPYEOF\npython /tmp/bench_tweak2.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

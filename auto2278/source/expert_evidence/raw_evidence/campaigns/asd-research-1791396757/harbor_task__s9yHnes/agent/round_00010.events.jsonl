{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/sh -lc \"cat << 'PYEOF' > /tmp/bench_opt2.py\nimport time, math, torch\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\ndef bench(name, fn, n=20, warmup=3):\n    for _ in range(warmup):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    return (t1 - t0) / n / 1e6\n\ndef ref_attention(x, wq, wk, wv, alpha, beta):\n    q = torch.einsum(\\\"blc,hdc->bhld\\\", x, wq)\n    k = torch.einsum(\\\"blc,hdc->bhld\\\", x, wk)\n    logits = (q @ k.transpose(-1, -2)) / math.sqrt(wq.shape[1])\n    p0 = logits.softmax(dim=-1)\n    base = p0 @ x.unsqueeze(1)\n    if alpha == 1.0:\n        modified = base\n    else:\n        perturbed = .5 * (1 + alpha) * logits + .5 * (1 - alpha) * logits.transpose(-1, -2)\n        modified = perturbed.softmax(dim=-1) @ x.unsqueeze(1)\n    blended = base + beta * (modified - base)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    y = torch.einsum(\\\"bhlc,hdc->bhld\\\", blended * ratio, wv)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ndef current(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wv.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    logits = q @ k.transpose(-1, -2) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    p1G = p1 @ G_exp\n    norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n    normm = normm_sq.sqrt().clamp_min(1e-6)\n    ratio = (norm1 / normm).clamp(0.25, 4.0)\n    y = (p_mix @ v) * ratio\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# BH-last layout: compute q,k,v as (B, L, H, D) and do logits with einsum\ndef variant_bhlast(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(H * D, C).T).reshape(B, L, H, D)\n    k = (xr @ wk.reshape(H * D, C).T).reshape(B, L, H, D)\n    v = (xr @ wv.reshape(H * D, C).T).reshape(B, L, H, D)\n    # logits: (B, Lq, H, D) @ (B, Lk, H, D) -> (B, H, Lq, Lk) via einsum\n    logits = torch.einsum(\\\"bqhd,bkhd->bhqk\\\", q, k) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    p1G = p1 @ G_exp\n    norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n    normm = normm_sq.sqrt().clamp_min(1e-6)\n    ratio = (norm1 / normm).clamp(0.25, 4.0)\n    # p_mix is (B, H, L, L), v is (B, L, H, D) -> y (B, L, H, D)\n    y = torch.einsum(\\\"bhql,blhd->bqhd\\\", p_mix, v) * ratio.squeeze(-1).transpose(1, 2).unsqueeze(-1)\n    return y.flatten(2).contiguous()\n\n# (B*H, L, D) layout for logits - single large bmm\ndef variant_bhflat(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    BH = B * H\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    xr = x.reshape(B * L, C)\n    \n    # Project: (B*L, C) @ (C, H*D) -> (B*L, H*D) -> reshape to (B, L, H, D) -> (B*H, L, D)\n    q = (xr @ wq.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).reshape(BH, L, D)\n    k = (xr @ wk.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).reshape(BH, L, D)\n    v = (xr @ wv.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).reshape(BH, L, D)\n    \n    logits = torch.bmm(q, k.transpose(1, 2)) * inv_sqrt_d  # (BH, L, L)\n    p0 = logits.softmax(dim=-1)\n    \n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1 = (a_p * logits + a_m * logits.transpose(1, 2)).softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    \n    # Gram matrix: G = x @ x\"'^T per batch (B, L, L) -> repeat to (BH, L, L)\n    G = x @ x.transpose(-1, -2)  # (B, L, L)\n    G_bh = G.repeat_interleave(H, dim=0)  # (BH, L, L)\n    \n    # norms\n    p1G = torch.bmm(p1, G_bh)\n    norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n    pmG = torch.bmm(p_mix, G_bh)\n    normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n    \n    norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n    normm = normm_sq.sqrt().clamp_min(1e-6)\n    ratio = (norm1 / normm).clamp(0.25, 4.0)\n    \n    y = torch.bmm(p_mix, v) * ratio  # (BH, L, D)\n    return y.reshape(B, H, L, D).transpose(1, 2).flatten(2).contiguous()\n\n# Same as bhflat but use expand instead of repeat for G\ndef variant_bhflat_expand(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    BH = B * H\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    xr = x.reshape(B * L, C)\n    \n    q = (xr @ wq.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).reshape(BH, L, D)\n    k = (xr @ wk.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).reshape(BH, L, D)\n    v = (xr @ wv.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).reshape(BH, L, D)\n    \n    logits = torch.bmm(q, k.transpose(1, 2)) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    \n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1 = (a_p * logits + a_m * logits.transpose(1, 2)).softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    \n    G = x @ x.transpose(-1, -2)  # (B, L, L)\n    # Expand G to (BH, L, L) without copying - use view + expand\n    G_bh = G.unsqueeze(1).expand(B, H, L, L).reshape(BH, L, L)\n    \n    p1G = torch.bmm(p1, G_bh)\n    norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n    pmG = torch.bmm(p_mix, G_bh)\n    normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n    \n    norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n    normm = normm_sq.sqrt().clamp_min(1e-6)\n    ratio = (norm1 / normm).clamp(0.25, 4.0)\n    \n    y = torch.bmm(p_mix, v) * ratio\n    return y.reshape(B, H, L, D).transpose(1, 2).flatten(2).contiguous()\n\ncases = [\n    (1, 256, 1280, 20, 64, 0.5, 0.3),\n    (1, 256, 640, 10, 64, 0.5, 0.3),\n    (1, 128, 1280, 20, 64, 0.5, 0.3),\n    (1, 128, 640, 10, 64, 0.5, 0.3),\n    (1, 64, 512, 8, 64, 0.5, 0.3),\n]\n\nvariants = [\n    (\"ref\", ref_attention),\n    (\"current\", current),\n    (\"bhflat\", variant_bhflat),\n    (\"bhflat_expand\", variant_bhflat_expand),\n]\n\ngeo = [1.0] * (len(variants) - 1)\n\nfor B, L, C, H, D, alpha, beta in cases:\n    torch.manual_seed(0)\n    x = torch.randn(B, L, C)\n    wq = torch.randn(H, D, C)\n    wk = torch.randn(H, D, C)\n    wv = torch.randn(H, D, C)\n    \n    ref_out = ref_attention(x, wq, wk, wv, alpha, beta)\n    \n    times = []\n    for name, fn in variants:\n        ms = bench(name, lambda: fn(x, wq, wk, wv, alpha, beta), n=15)\n        times.append(ms)\n        \n        if name != \"ref\":\n            out = fn(x, wq, wk, wv, alpha, beta)\n            diff = (out - ref_out).abs().max().item()\n            maxe = ref_out.abs().max().item()\n            tol = 3e-5 + 3e-4 * maxe\n            if diff > tol:\n                print(f\"  {name} FAIL: max_abs={diff:.2e} tol={tol:.2e}\")\n    \n    label = f\"B{B}L{L}C{C}H{H}\"\n    print(f\"{label:18s}  ref={times[0]:8.2f}  \", end=\"\")\n    for j in rang
{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/sh -lc 'cat /workspace/environment/public_eval/worker.py'","aggregated_output":"\"\"\"Protected subprocess launcher; candidate receives tensors, never expected outputs.\"\"\"\nimport importlib.util\nimport json\nimport os\nfrom pathlib import Path\nimport statistics\nimport sys\nimport time\nimport numpy as np\nimport torch\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\nsource, input_path, output_path = map(Path, sys.argv[1:4])\ndata = np.load(input_path, allow_pickle=False)\nvalues = [torch.from_numpy(data[name].copy()) for name in (\"x\", \"wq\", \"wk\", \"wv\")]\nvalues.extend([float(data[\"alpha\"]), float(data[\"beta\"])])\nspec = importlib.util.spec_from_file_location(\"candidate_method\", source)\nmodule = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(module)\nsamples = []\nwall_samples = []\nwith torch.inference_mode():\n    for _ in range(int(data[\"warmup\"])):\n        module.attention(*values)\n    for _ in range(int(data[\"repeats\"])):\n        start_wall = time.perf_counter_ns()\n        start = time.process_time_ns()\n        output = module.attention(*values)\n        samples.append((time.process_time_ns() - start) / 1e6)\n        wall_samples.append((time.perf_counter_ns() - start_wall) / 1e6)\n    # A fresh call with fresh tensors also rejects stale cached outputs.\n    output = module.attention(*[v.clone() if isinstance(v, torch.Tensor) else v for v in values])\ninput_unchanged = all(torch.equal(v, torch.from_numpy(data[name])) for name, v in zip((\"x\", \"wq\", \"wk\", \"wv\"), values[:4]))\nif not isinstance(output, torch.Tensor):\n    print(json.dumps({\"worker_failure\":\"format_error\",\"message\":\"attention must return a Tensor\"}),flush=True)\n    raise SystemExit(3)\nif output.dtype != torch.float32 or output.device.type != \"cpu\":\n    print(json.dumps({\"worker_failure\":\"hard_gate\",\"message\":\"output must remain float32 CPU\"}),flush=True)\n    raise SystemExit(3)\nnp.savez(output_path, output=output.detach().numpy(), samples=np.array(samples, dtype=np.float64),\n         wall_samples=np.array(wall_samples, dtype=np.float64), input_unchanged=input_unchanged)\nprint(json.dumps({\"median_ms\": statistics.median(samples), \"pid\": os.getpid()}), flush=True)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/sh -lc \"cat << 'PYEOF' > /tmp/bench_full.py\nimport time, math, torch\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\ndef bench(fn, n=20, warmup=5):\n    for _ in range(warmup):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    return (time.process_time_ns() - t0) / n / 1e6  # ms\n\ndef ref_attention(x, wq, wk, wv, alpha, beta):\n    q = torch.einsum(\\\"blc,hdc->bhld\\\", x, wq)\n    k = torch.einsum(\\\"blc,hdc->bhld\\\", x, wk)\n    logits = (q @ k.transpose(-1, -2)) / math.sqrt(wq.shape[1])\n    p0 = logits.softmax(dim=-1)\n    base = p0 @ x.unsqueeze(1)\n    if alpha == 1.0:\n        modified = base\n    else:\n        perturbed = .5 * (1 + alpha) * logits + .5 * (1 - alpha) * logits.transpose(-1, -2)\n        modified = perturbed.softmax(dim=-1) @ x.unsqueeze(1)\n    blended = base + beta * (modified - base)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    y = torch.einsum(\\\"bhlc,hdc->bhld\\\", blended * ratio, wv)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ndef current(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wv.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    logits = q @ k.transpose(-1, -2) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        p1G = p1 @ G_exp\n        norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n        normm = normm_sq.sqrt().clamp_min(1e-6)\n        ratio = (norm1 / normm).clamp(0.25, 4.0)\n        y = (p_mix @ v) * ratio\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Optimization: fuse projections (q/k/v single GEMM)\ndef opt_fused_proj(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    HD = H * D\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    xr = x.reshape(B * L, C)\n    \n    # Single fused projection GEMM\n    W = torch.cat([wq.reshape(HD, C), wk.reshape(HD, C), wv.reshape(HD, C)], dim=0)\n    proj = (xr @ W.T).reshape(B, L, 3 * H, D).permute(0, 2, 1, 3)\n    q = proj[:, 0:H, :, :]\n    k = proj[:, H:2*H, :, :]\n    v = proj[:, 2*H:3*H, :, :]\n    \n    logits = q @ k.transpose(-1, -2) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    if alpha == 1.0:\n        y = p0 @ v\n    else:\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        p1G = p1 @ G_exp\n        norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n        normm = normm_sq.sqrt().clamp_min(1e-6)\n        ratio = (norm1 / normm).clamp(0.25, 4.0)\n        y = (p_mix @ v) * ratio\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Fused proj + skip p1G (compute norm1 from p_mix and cross)\n# Actually we still need p1@G for norm1. Let me think differently.\n# We need: norm1 = ||p1@x||, normm = ||p_mix@x||\n# p_mix = (1-b)*p0 + b*p1\n# If we compute p0@G and p1@G (2 matmuls), we get:\n#   norm0_sq = diag(p0@G@p0\"'^T)\n#   norm1_sq = diag(p1@G@p1''^T)\n#   cross = diag(p0@G@p1''^T) = (p0@G * p1).sum(-1)\n#   normm_sq = (1-b)''^2 * norm0_sq + b''^2 * norm1_sq + 2*(1-b)*b * cross\n# This uses same 2 matmuls as current (p1@G + p_mix@G), but gives us more info.\n# \n# But what if we compute p0@G and p_mix@G? Then:\n#   norm0_sq = diag(p0@G@p0''^T)\n#   normm_sq = diag(p_mix@G@p_mix''^T)\n#   cross = diag(p0@G@p_mix''^T)\n#   norm1_sq = ... using p1 = (p_mix - (1-b)*p0) / b\n#   = (normm_sq + (1-b)''^2 * norm0_sq - 2*(1-b)*cross) / b''^2\n# This needs b != 0.\n# Same number of matmuls.\n\n# Strategy: Use addmm for logits (q @ k''^T -> fuse scaling)\n# and use contiguous carefully.\n\n# What about computing the softmax more efficiently?\n# In PyTorch 2.5, there'\"'s _scaled_dot_product_attention but that's for q@k\"'^T + attn_mask -> softmax -> @v.\n# For CPU with fp32, sdpa might be just the same thing.\n\n# Let me try _scaled_dot_product_attention for the basic attention\ndef opt_sdpa(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wv.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    \n    # Use SDPA for p0@v\n    scale = inv_sqrt_d\n    out0 = torch.nn.functional.scaled_dot_product_attention(q, k, v, scale=scale)\n    \n    if alpha == 1.0:\n        y = out0\n    else:\n        logits = q @ k.transpose(-1, -2) * inv_sqrt_d\n        p0 = logits.softmax(dim=-1)\n        a_p = 0.5 * (1.0 + alpha)\n        a_m = 0.5 * (1.0 - alpha)\n        p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n        p_mix = torch.lerp(p0, p1, beta)\n        G = x @ x.transpose(-1, -2)\n        G_exp = G.unsqueeze(1)\n        p1G = p1 @ G_exp\n        norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n        pmG = p_mix @ G_exp\n        normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n        norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n        normm = normm_sq.sqrt().clamp_min(1e-6)\n        ratio = (norm1 / normm).clamp(0.25, 4.0)\n        y = (p_mix @ v) * ratio\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# What about making the logits calculation use bmm (BH,L,L) format?\n# 4D might be slightly slower due to broadcasting overhead.\n\ncases = [\n    (1, 64, 512, 8, 64, 1.05, 5.0),\n    (1, 128, 640, 10, 64, 1.1, 4.0),\n    (1, 128, 1280, 20, 64, 1.15, 3.0),\n    (1, 256, 1280, 20, 64, 1.05, 7.5),\n    (1, 256, 640, 10, 64, 1.2, 5.0),\n    (2, 128, 512, 8, 64, 1.0, 5.0),\n]\n\nvariants = [\n    (\"ref\", ref_attention),\n    (\"current\", current),\n    (\"fused_proj\", opt_fused_proj),\n    (\"sdpa_p0\", opt_sdpa),\n]\n\ngeo = [1.0] * (len(variants) - 1)\ngeo_count = 0\n\nfor B, L, C, H, D, alpha, beta in cases:\n    torch.manual_seed(0)\n    x = torch.randn(B, L, C)\n    wq = torch.randn(H, D, C)\n    wk = torch.randn(H, D, C)\n    wv = torch.randn(H, D, C)\n    \n    ref_out = ref_attention(x, wq, wk, wv, alpha, beta)\n    \n    times = []\n    failed = []\n    for name, fn in variants:\n        ms = bench(lambda: fn(x, wq, wk, wv, alpha, beta), n=15)\n        times.append(ms)\n        \n        if name != \"ref\":\n            out = fn(x, wq, wk, wv, alpha, beta)\n            diff = (out - ref_out).abs().max().item()\n            maxe = ref_out.abs().max().item()\n            tol = 3e-5 + 3e-4 * maxe\n            if diff > tol:\n                failed.append(f\"{name}:{diff:.2e}\")\n    \n    label = f\"B{B}L{L}C{C}H{H}\"\n    print(f\"{label:18s}  ref={times[0]:7.2f}ms  \", end=\"\")\n    for j in range(1, len(variants)):\n        r = times[j] / times[0]\n        geo[j-1] *= r\n        print(f\"{variants[j][0]}={r:.4f}  \", end=\"\")\n    if failed:\n        print(f\"  FAIL: {failed}\")\n    else:\n        print()\n    geo_count += 1\n\nprint(f\"'\"\\\\nGeometric mean ratio (vs ref):\\\")\nfor j in range(1, len(variants)):\n    print(f\\\"  {variants[j][0]:20s}: {geo[j-1]**(1/geo_count):.4f}\\\")\nPYEOF\npython /tmp/bench_full.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/sh -lc \"cat << 'PYEOF' > /tmp/bench_opt1.py\nimport time, math, torch\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\ndef bench(name, fn, n=20, warmup=3):\n    for _ in range(warmup):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(n):\n        fn()\n    t1 = time.process_time_ns()\n    ms = (t1 - t0) / n / 1e6\n    return ms\n\ndef ref_attention(x, wq, wk, wv, alpha, beta):\n    q = torch.einsum(\\\"blc,hdc->bhld\\\", x, wq)\n    k = torch.einsum(\\\"blc,hdc->bhld\\\", x, wk)\n    logits = (q @ k.transpose(-1, -2)) / math.sqrt(wq.shape[1])\n    p0 = logits.softmax(dim=-1)\n    base = p0 @ x.unsqueeze(1)\n    if alpha == 1.0:\n        modified = base\n    else:\n        perturbed = .5 * (1 + alpha) * logits + .5 * (1 - alpha) * logits.transpose(-1, -2)\n        modified = perturbed.softmax(dim=-1) @ x.unsqueeze(1)\n    blended = base + beta * (modified - base)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    y = torch.einsum(\\\"bhlc,hdc->bhld\\\", blended * ratio, wv)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ndef current(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    xr = x.reshape(B * L, C)\n    q = (xr @ wq.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    k = (xr @ wk.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    v = (xr @ wv.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    logits = q @ k.transpose(-1, -2) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    p1G = p1 @ G_exp\n    norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n    pmG = p_mix @ G_exp\n    normm_sq = (pmG * p_mix).sum(dim=-1, keepdim=True)\n    norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n    normm = normm_sq.sqrt().clamp_min(1e-6)\n    ratio = (norm1 / normm).clamp(0.25, 4.0)\n    y = (p_mix @ v) * ratio\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Fused projection + algebraic normm_sq (save 1 Gram matmul)\ndef fused_proj_gram2(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    HD = H * D\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    xr = x.reshape(B * L, C)\n    \n    # Fused q,k,v projection\n    w_all = torch.cat([wq.reshape(HD, C), wk.reshape(HD, C), wv.reshape(HD, C)], dim=0)\n    proj_all = (xr @ w_all.T).reshape(B, L, 3 * H, D)\n    # Split along H dim: first H heads = q, next H = k, last H = v\n    q = proj_all[:, :, 0:H, :].permute(0, 2, 1, 3)\n    k = proj_all[:, :, H:2*H, :].permute(0, 2, 1, 3)\n    v = proj_all[:, :, 2*H:3*H, :].permute(0, 2, 1, 3)\n    \n    logits = q @ k.transpose(-1, -2) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    \n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    \n    # Compute both p0@G and p1@G (2 matmuls) - but we can stack them\n    p_stack = torch.cat([p0, p1], dim=2)  # (B, H, 2L, L) - no, dim 2 is L\n    # Actually stack along batch dim or head dim? Let's just do 2 separate\n    p0G = p0 @ G_exp\n    p1G = p1 @ G_exp\n    \n    norm0_sq = (p0G * p0).sum(dim=-1, keepdim=True)\n    norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n    cross = (p0G * p1).sum(dim=-1, keepdim=True)  # p0@G@p1\"'^T diagonal\n    \n    b1 = 1.0 - beta\n    normm_sq = b1*b1 * norm0_sq + beta*beta * norm1_sq + 2*b1*beta * cross\n    \n    norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n    normm = normm_sq.sqrt().clamp_min(1e-6)\n    ratio = (norm1 / normm).clamp(0.25, 4.0)\n    y = (p_mix @ v) * ratio\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Same as fused_proj_gram2 but stack p0 and p1 along batch-head dim for single matmul\ndef fused_proj_gram_stacked(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[0], wq.shape[1]\n    HD = H * D\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    xr = x.reshape(B * L, C)\n    \n    w_all = torch.cat([wq.reshape(HD, C), wk.reshape(HD, C), wv.reshape(HD, C)], dim=0)\n    proj_all = (xr @ w_all.T).reshape(B, L, 3 * H, D)\n    q = proj_all[:, :, 0:H, :].permute(0, 2, 1, 3)\n    k = proj_all[:, :, H:2*H, :].permute(0, 2, 1, 3)\n    v = proj_all[:, :, 2*H:3*H, :].permute(0, 2, 1, 3)\n    \n    logits = q @ k.transpose(-1, -2) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    a_p = 0.5 * (1.0 + alpha)\n    a_m = 0.5 * (1.0 - alpha)\n    p1 = (a_p * logits + a_m * logits.transpose(-1, -2)).softmax(dim=-1)\n    p_mix = torch.lerp(p0, p1, beta)\n    \n    G = x @ x.transpose(-1, -2)\n    G_exp = G.unsqueeze(1)\n    \n    # Stack p0 and p1 to (B, 2H, L, L) for single bmm with G broadcast\n    p_stack = torch.cat([p0, p1], dim=1)  # (B, 2H, L, L)\n    pG_stack = p_stack @ G_exp  # (B, 2H, L, L)\n    p0G = pG_stack[:, :H, :, :]\n    p1G = pG_stack[:, H:, :, :]\n    \n    norm0_sq = (p0G * p0).sum(dim=-1, keepdim=True)\n    norm1_sq = (p1G * p1).sum(dim=-1, keepdim=True)\n    cross = (p0G * p1).sum(dim=-1, keepdim=True)\n    \n    b1 = 1.0 - beta\n    normm_sq = b1*b1 * norm0_sq + beta*beta * norm1_sq + 2*b1*beta * cross\n    \n    norm1 = norm1_sq.sqrt().clamp_min(1e-6)\n    normm = normm_sq.sqrt().clamp_min(1e-6)\n    ratio = (norm1 / normm).clamp(0.25, 4.0)\n    y = (p_mix @ v) * ratio\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ncases = [\n    (1, 256, 1280, 20, 64, 0.5, 0.3),\n    (1, 256, 640, 10, 64, 0.5, 0.3),\n    (1, 128, 1280, 20, 64, 0.5, 0.3),\n    (1, 128, 640, 10, 64, 0.5, 0.3),\n    (1, 64, 512, 8, 64, 0.5, 0.3),\n]\n\nvariants = [\n    (\"ref\", ref_attention),\n    (\"current\", current),\n    (\"fused+gram2\", fused_proj_gram2),\n    (\"fused+stacked\", fused_proj_gram_stacked),\n]\n\ngeomean_opt = [1.0] * (len(variants) - 1)\n\nfor B, L, C, H, D, alpha, beta in cases:\n    torch.manual_seed(0)\n    x = torch.randn(B, L, C)\n    wq = torch.randn(H, D, C)\n    wk = torch.randn(H, D, C)\n    wv = torch.randn(H, D, C)\n    \n    ref_out = ref_attention(x, wq, wk, wv, alpha, beta)\n    \n    times = []\n    for name, fn in variants:\n        ms = bench(name, lambda: fn(x, wq, wk, wv, alpha, beta), n=15)\n        times.append(ms)\n        \n        if name != \"ref\":\n            out = fn(x, wq, wk, wv, alpha, beta)\n            diff = (out - ref_out).abs().max().item()\n            maxe = ref_out.abs().max().item()\n            tol = 3e-5 + 3e-4 * maxe\n            if diff > tol:\n                print(f\"  {name} FAIL: max_abs={diff:.2e} tol={tol:.2e}\")\n    \n    case_label = f\"B{B}L{L}C{C}H{H}\"\n    print(f\"{case_label:18s}  \", end=\"\")\n    for t in times:\n        print(f\"{t:10.2f} \", end=\"\")\n    print(f\"  ratios: \", end=\"\")\n    for j in range(1, len(variants)):\n        r = times[j] / times[0]\n        geomean_opt[j-1] *= r\n        print(f\"{r:.4f} \", end=\"\")\n    print()\n\nprint(f\"'\"\\\\nGeometric mean ratio (vs ref):\\\")\nfor j in range(1, len(variants)):\n    print(f\\\"  {variants[j][0]:20s}: {geomean_opt[j-1]**(1/len(cases)):.4f}\\\")\nPYEOF\npython /tmp/bench_opt1.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

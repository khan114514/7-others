{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/sh -lc 'cat /workspace/environment/public_eval/worker.py /workspace/environment/public_eval/baseline_method.py /workspace/environment/public_eval/solve.sh'","aggregated_output":"\"\"\"Protected subprocess launcher; candidate receives tensors, never expected outputs.\"\"\"\nimport importlib.util\nimport json\nimport os\nfrom pathlib import Path\nimport statistics\nimport sys\nimport time\nimport numpy as np\nimport torch\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\nsource, input_path, output_path = map(Path, sys.argv[1:4])\ndata = np.load(input_path, allow_pickle=False)\nvalues = [torch.from_numpy(data[name].copy()) for name in (\"x\", \"wq\", \"wk\", \"wv\")]\nvalues.extend([float(data[\"alpha\"]), float(data[\"beta\"])])\nspec = importlib.util.spec_from_file_location(\"candidate_method\", source)\nmodule = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(module)\nsamples = []\nwall_samples = []\nwith torch.inference_mode():\n    for _ in range(int(data[\"warmup\"])):\n        module.attention(*values)\n    for _ in range(int(data[\"repeats\"])):\n        start_wall = time.perf_counter_ns()\n        start = time.process_time_ns()\n        output = module.attention(*values)\n        samples.append((time.process_time_ns() - start) / 1e6)\n        wall_samples.append((time.perf_counter_ns() - start_wall) / 1e6)\n    # A fresh call with fresh tensors also rejects stale cached outputs.\n    output = module.attention(*[v.clone() if isinstance(v, torch.Tensor) else v for v in values])\ninput_unchanged = all(torch.equal(v, torch.from_numpy(data[name])) for name, v in zip((\"x\", \"wq\", \"wk\", \"wv\"), values[:4]))\nif not isinstance(output, torch.Tensor):\n    print(json.dumps({\"worker_failure\":\"format_error\",\"message\":\"attention must return a Tensor\"}),flush=True)\n    raise SystemExit(3)\nif output.dtype != torch.float32 or output.device.type != \"cpu\":\n    print(json.dumps({\"worker_failure\":\"hard_gate\",\"message\":\"output must remain float32 CPU\"}),flush=True)\n    raise SystemExit(3)\nnp.savez(output_path, output=output.detach().numpy(), samples=np.array(samples, dtype=np.float64),\n         wall_samples=np.array(wall_samples, dtype=np.float64), input_unchanged=input_unchanged)\nprint(json.dumps({\"median_ms\": statistics.median(samples), \"pid\": os.getpid()}), flush=True)\n\"\"\"Direct, exact implementation of the published operator contract.\"\"\"\nimport math\nimport torch\n\n\n@torch.no_grad()\ndef attention(x, wq, wk, wv, alpha, beta):\n    q = torch.einsum(\"blc,hdc->bhld\", x, wq)\n    k = torch.einsum(\"blc,hdc->bhld\", x, wk)\n    logits = (q @ k.transpose(-1, -2)) / math.sqrt(wq.shape[1])\n    p0 = logits.softmax(dim=-1)\n    base = p0 @ x.unsqueeze(1)\n    if alpha == 1.0:\n        modified = base\n    else:\n        perturbed = .5 * (1 + alpha) * logits + .5 * (1 - alpha) * logits.transpose(-1, -2)\n        modified = perturbed.softmax(dim=-1) @ x.unsqueeze(1)\n    blended = base + beta * (modified - base)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    y = torch.einsum(\"bhlc,hdc->bhld\", blended * ratio, wv)\n    return y.transpose(1, 2).flatten(2).contiguous()\n#!/bin/sh\nset -eu\nexec python /workspace/environment/public_eval/grader.py --method /workspace/solution/method.py --output /workspace/public-results/result.json \"$@\"\n","exit_code":0,"status":"completed"}}

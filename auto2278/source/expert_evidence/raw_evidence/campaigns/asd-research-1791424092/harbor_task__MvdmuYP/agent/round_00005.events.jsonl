{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport importlib.util, json, time, statistics, torch\nspec=importlib.util.spec_from_file_location('current','/workspace/solution/method.py')\nm=importlib.util.module_from_spec(spec); spec.loader.exec_module(m)\ntorch.set_num_threads(1); torch.set_num_interop_threads(1)\ncases=json.load(open('/workspace/environment/public_assets/dev/protocol.json'))['cases']\ndef median(fn):\n    for _ in range(2): fn()\n    times=[]\n    for _ in range(7):\n        t=time.process_time_ns(); fn(); times.append((time.process_time_ns()-t)/1e6)\n    return statistics.median(times)\ndef norms(p,f,block):\n    b,rows,l=p.shape\n    squared=p.new_zeros((b,rows,1))\n    for start in range(0,l,block):\n        end=min(start+block,l)\n        z=torch.bmm(p[:,:,start:],f[:,start:,start:end])\n        squared.add_(z.square_().sum(-1,keepdim=True))\n    return squared\nwith torch.inference_mode():\n    for case in cases:\n        b,l,c,h,d=[case[k] for k in ('batch','length','channels','heads','dim')]\n        x=torch.randn(b,l,c); weights=[torch.randn(h,d,c) for _ in range(3)]\n        def separate(): return tuple(m.project(x,w) for w in weights)\n        def fused():\n            w=torch.cat(weights,0)\n            projected=m.project(x,w)\n            return projected.split(h,1)\n        def interleaved():\n            w=torch.cat(weights,1)\n            projected=m.project(x,w)\n            return projected.split(d,-1)\n        timing={'separate_ms':median(separate),'fused_ms':median(fused),'interleaved_ms':median(interleaved)}\n        if case['alpha']\"'!=1.0:\n            p=torch.randn(b,2*h*l,l).softmax(-1)\n            f=torch.linalg.cholesky(x @ x.transpose(-1,-2))\n            timing['\"'norms_by_block_ms']={str(block):median(lambda block=block:norms(p,f,block)) for block in (16,32,64,128)}\n        print(json.dumps({'length':l,'channels':c,'heads':h,'batch':b,**timing}),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

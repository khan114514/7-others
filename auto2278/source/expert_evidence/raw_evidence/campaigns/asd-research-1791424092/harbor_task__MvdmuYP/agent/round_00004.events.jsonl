{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport torch, time, statistics, importlib.util\nspec=importlib.util.spec_from_file_location('method','/workspace/solution/method.py')\nmodule=importlib.util.module_from_spec(spec); spec.loader.exec_module(module)\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\ndef factor_norms(coefficients, factor):\n    b, n, length = coefficients.shape\n    squared=coefficients.new_zeros((b,n,1))\n    for start in range(0,length,64):\n        end=min(start+64,length)\n        projected=torch.bmm(coefficients[:,:,start:],factor[:,start:,start:end])\n        squared.add_(projected.square_().sum(-1,keepdim=True))\n    return squared.clamp_min_(1e-12)\nwith torch.inference_mode():\n    for length,channels,heads in [(64,512,8),(128,640,10),(128,1280,20),(256,1280,20),(256,640,10)]:\n        g=torch.Generator().manual_seed(length+channels)\n        x=torch.randn(1,length,channels,generator=g)\n        ps=torch.randn(1,2*heads,length,length,generator=g).softmax(-1)\n        gram=torch.bmm(x,x.transpose(1,2))\n        factor,info=torch.linalg.cholesky_ex(gram)\n        expected=torch.matmul(ps,x.unsqueeze(1)).square_().sum(-1,keepdim=True)\n        actual=factor_norms(ps.reshape(1,2*heads*length,length),factor).reshape_as(expected)\n        print('shape',length,channels,heads,'factor_info',info.tolist(),'max_norm_relative_error',((actual-expected).abs()/expected.clamp_min(1e-12)).max().item())\n        def previous():\n            a=module.gram_norm_squared(ps[:,:heads],gram)\n            b=module.gram_norm_squared(ps[:,heads:],gram)\n            return a,b\n        def proposed():\n            f,i=torch.linalg.cholesky_ex(gram)\n            return factor_norms(ps.reshape(1,2*heads*length,length),f)\n        timings=[]\n        for fn in (previous,proposed):\n            for _ in range(3): fn()\n            samples=[]\n            for _ in range(11):\n                start=time.process_time_ns(); fn(); samples.append((time.process_time_ns()-start)/1e6)\n            timings.append(statistics.median(samples))\n        print('norm_cpu_ms_old_new',timings)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

ength, channels, heads in [(64,512,8),(128,640,10),(128,1280,20),(256,1280,20),(256,640,10)]:\n        x = torch.randn(1,length,channels)\n        weights = [torch.randn(heads,64,channels) / math.sqrt(channels) for _ in range(3)]\n        print('shape',length,channels,heads,flush=True)\n        expected = module.project_qkv(x,*weights,True)\n        for name, func in [('fused', lambda x,q,k,v: module.project_qkv(x,q,k,v,True)), ('separate',separate),('token_major',token_major),('column_packed',column_packed)]:\n            for _ in range(2):\n                actual=func(x,*weights)\n            times=[]\n            for _ in range(5):\n                start=time.process_time_ns()\n                actual=func(x,*weights)\n                times.append((time.process_time_ns()-start)/1e6)\n            error = max(float((a-b).abs().max()) for a,b in zip(actual,expected))\n            print(name,round(statistics.median(times),5),error,flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

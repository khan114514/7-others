{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport torch, math, time, statistics, json\n\ntorch.set_num_threads(1); torch.set_num_interop_threads(1)\ncases=json.load(open('/workspace/environment/public_assets/dev/protocol.json'))['cases']\n\ndef base(x,wq,wk,wv,a,b):\n q=torch.einsum('blc,hdc->bhld',x,wq); k=torch.einsum('blc,hdc->bhld',x,wk)\n logits=(q @ k.transpose(-1,-2))/math.sqrt(wq.shape[1]); p0=logits.softmax(-1); u0=p0 @ x.unsqueeze(1)\n if a==1.0: u1=u0\n else:\n  pert=.5*(1+a)*logits+.5*(1-a)*logits.transpose(-1,-2); u1=pert.softmax(-1)@x.unsqueeze(1)\n m=u0+b*(u1-u0); r=(u1.norm(dim=-1,keepdim=True).clamp_min(1e-6)/m.norm(dim=-1,keepdim=True).clamp_min(1e-6)).clamp(.25,4.)\n return torch.einsum('bhlc,hdc->bhld',m*r,wv).transpose(1,2).flatten(2).contiguous()\n\ndef mm(x,wq,wk,wv,a,b):\n xt=x.unsqueeze(1)\n q=torch.matmul(xt,wq.transpose(-1,-2)); k=torch.matmul(xt,wk.transpose(-1,-2))\n logits=torch.matmul(q,k.transpose(-1,-2))/math.sqrt(wq.shape[1]); p0=logits.softmax(-1); u0=torch.matmul(p0,xt)\n if a==1.0: u1=u0\n else:\n  pert=.5*(1+a)*logits+.5*(1-a)*logits.transpose(-1,-2); u1=torch.matmul(pert.softmax(-1),xt)\n m=u0+b*(u1-u0); r=(u1.norm(dim=-1,keepdim=True).clamp_min(1e-6)/m.norm(dim=-1,keepdim=True).clamp_min(1e-6)).clamp(.25,4.)\n return torch.matmul(m*r,wv.transpose(-1,-2)).transpose(1,2).flatten(2).contiguous()\n\ndef inplace(x,wq,wk,wv,a,b):\n xt=x.unsqueeze(1)\n q=torch.matmul(xt,wq.transpose(-1,-2)); k=torch.matmul(xt,wk.transpose(-1,-2))\n logits=torch.matmul(q,k.transpose(-1,-2))/math.sqrt(wq.shape[1]); p0=logits.softmax(-1); u0=torch.matmul(p0,xt)\n if a==1.0: u1=u0\n else:\n  logits.mul_(.5*(1+a)).add_(logits.transpose(-1,-2),alpha=.5*(1-a)); u1=torch.matmul(logits.softmax(-1),xt)\n if a==1.0: m=u0\n else:\n  un=u1.norm(dim=-1,keepdim=True).clamp_min(1e-6); u1.sub_(u0); u0.add_(u1,alpha=b); m=u0\n  r=(un/m.norm(dim=-1,keepdim=True).clamp_min(1e-6)).clamp(.25,4.)\n  re
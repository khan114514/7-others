80208,\n            86.933125,\n            67.991125,\n            72.992916\n          ],\n          \"relative_cpu_time\": 0.9951891313366281,\n          \"case_index\": 4\n        },\n        {\n          \"latency_ms\": 34.936749,\n          \"samples_ms\": [\n            54.026833,\n            28.964208,\n            30.003583,\n            25.999542,\n            33.899708,\n            36.002833,\n            38.029167,\n            36.963041,\n            34.99825,\n            33.028584,\n            34.936749\n          ],\n          \"wall_latency_ms\": 34.439416,\n          \"wall_samples_ms\": [\n            53.878958,\n            28.983,\n            29.994292,\n            25.929791,\n            37.278292,\n            35.914458,\n            38.3795,\n            37.063875,\n            34.374666,\n            33.602583,\n            34.439416\n          ],\n          \"max_abs_error\": 0.0,\n          \"control_latency_ms\": 28.990958,\n          \"control_samples_ms\": [\n            28.932375,\n            27.844875,\n            29.000417,\n            28.000333,\n            28.99975,\n            28.990958,\n            30.264542,\n            26.736541,\n            29.999167,\n            37.984958,\n            21.994333\n          ],\n          \"relative_cpu_time\": 1.2050912218906322,\n          \"case_index\": 5\n        }\n      ]\n    }\n  ],\n  \"quality_gates_passed\": true,\n  \"method_sha256\": \"dfe9194dc9754a70324890ecd603bf860e7c0266f4ba8bb7dca973263def36e5\",\n  \"protocol_sha256\": \"e22d4f05e7e41efb171a5d6cd6ca3c1e3ca1ae76acaf33ef04aacccde9944d59\",\n  \"protocol\": \"attention-exact-cpu-v2\",\n  \"torch\": \"2.5.1\",\n  \"start_unix\": 1791382598.8322427,\n  \"end_unix\": 1791382908.923033,\n  \"training\": \"NOT_APPLICABLE\"\n}\n--- baseline ---\n\"\"\"Direct, exact implementation of the published operator contract.\"\"\"\nimport math\nimport torch\n\n\n@torch.no_grad()\ndef attention(x, wq, wk, wv, alpha, beta):\n    q = torch.einsum(\"blc,hdc->bhld\", x, wq)\n    k = torch.einsum(\"blc,hdc->bhld\", x, wk)\n    logits = (q @ k.transpose(-1, -2)) / math.sqrt(wq.shape[1])\n    p0 = logits.softmax(dim=-1)\n    base = p0 @ x.unsqueeze(1)\n    if alpha == 1.0:\n        modified = base\n    else:\n        perturbed = .5 * (1 + alpha) * logits + .5 * (1 - alpha) * logits.transpose(-1, -2)\n        modified = perturbed.softmax(dim=-1) @ x.unsqueeze(1)\n    blended = base + beta * (modified - base)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    y = torch.einsum(\"bhlc,hdc->bhld\", blended * ratio, wv)\n    return y.transpose(1, 2).flatten(2).contiguous()\n","exit_code":0,"status":"completed"}}

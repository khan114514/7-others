{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/sh -lc \"python - <<'PY'\nimport torch, math, time, statistics, importlib.util, json\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\nspec=importlib.util.spec_from_file_location('current','/workspace/solution/method.py')\ncurrent=importlib.util.module_from_spec(spec); spec.loader.exec_module(current)\n\n@torch.no_grad()\ndef gram(x,wq,wk,wv,alpha,beta):\n    b,l,c=x.shape; h,d,_=wq.shape\n    xt=x.unsqueeze(1)\n    q=torch.matmul(xt,wq.transpose(-1,-2))\n    k=torch.matmul(xt,wk.transpose(-1,-2))\n    logits=torch.matmul(q,k.transpose(-1,-2)) / math.sqrt(d)\n    v=torch.matmul(xt,wv.transpose(-1,-2))\n    p0=logits.softmax(-1)\n    if alpha == 1.0:\n        return torch.matmul(p0,v).transpose(1,2).flatten(2).contiguous()\n    logits1=logits.mul(.5*(1+alpha))\n    logits1.add_(logits.transpose(-1,-2),alpha=.5*(1-alpha))\n    p1=logits1.softmax(-1)\n    g=torch.matmul(x,x.transpose(-1,-2)).unsqueeze(1)\n    n1=(torch.matmul(p1,g)*p1).sum(-1,keepdim=True).clamp_min_(1e-12)\n    p1.sub_(p0)\n    p0.add_(p1,alpha=beta)\n    nm=(torch.matmul(p0,g)*p0).sum(-1,keepdim=True).clamp_min_(1e-12)\n    n1.div_(nm).clamp_(.0625,16.).sqrt_()\n    y=torch.matmul(p0,v)\n    y.mul_(n1)\n    return y.transpose(1,2).flatten(2).contiguous()\n\nprotocol=json.load(open('/workspace/environment/public_assets/dev/protocol.json'))\nwith torch.inference_mode():\n    for i,case in enumerate(protocol['cases']):\n        b,l,c,h,d=[case[k] for k in ('batch','length','channels','heads','dim')]\n        g=torch.Generator().manual_seed(17171+i)\n        x=torch.randn(b,l,c,generator=g)\n        ws=[torch.randn(h,d,c,generator=g)/math.sqrt(c) for _ in range(3)]\n        args=(x,*ws,case['alpha'],case['beta'])\n        ref=current.attention(*args); out=gram(*args)\n        timings={}\n        for name,f in [('current',current.attention),('gram',gram)]:\n            for _ in range(3): f(*args)\n       
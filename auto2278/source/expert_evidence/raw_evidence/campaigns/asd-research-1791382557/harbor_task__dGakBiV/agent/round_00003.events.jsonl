{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/sh -lc \"OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 python - <<'PY'\nimport json,math,time,statistics,torch\nfrom solution.method import attention as old\n\ndef project(x,w):\n b,l,c=x.shape; h,d,_=w.shape\n return torch.mm(x.reshape(b*l,c),w.reshape(h*d,c).t()).reshape(b,l,h,d).transpose(1,2)\n\ndef candidate(x,wq,wk,wv,alpha,beta):\n b,l,c=x.shape; h,d,_=wq.shape\n q=project(x,wq);k=project(x,wk)\n logits=torch.matmul(q,k.transpose(-1,-2)).div_(math.sqrt(d))\n p0=logits.softmax(-1)\n if alpha==1.:\n  y=torch.matmul(p0,project(x,wv)) if d<c else torch.matmul(torch.matmul(p0,x.unsqueeze(1)),wv.transpose(-1,-2))\n  return y.transpose(1,2).flatten(2).contiguous()\n perturbed=logits.mul(.5*(1+alpha)).add_(logits.transpose(-1,-2),alpha=.5*(1-alpha))\n p1=perturbed.softmax(-1)\n if 2*l+d+c/h<2*c:\n  gram=torch.bmm(x,x.transpose(-1,-2))\n  norm1=torch.bmm(p1.reshape(b,h*l,l),gram).reshape(b,h,l,l).mul_(p1).sum(-1,keepdim=True).clamp_min_(1e-12)\n  p1.sub_(p0);p0.add_(p1,alpha=beta)\n  norm_mix=torch.bmm(p0.reshape(b,h*l,l),gram).reshape(b,h,l,l).mul_(p0).sum(-1,keepdim=True).clamp_min_(1e-12)\n  ratio=norm1.div_(norm_mix).clamp_(.0625,16.).sqrt_()\n  y=torch.matmul(p0,project(x,wv)).mul_(ratio)\n else:\n  base=torch.matmul(p0,x.unsqueeze(1)); modified=torch.matmul(p1,x.unsqueeze(1))\n  ratio=modified.norm(dim=-1,keepdim=True).clamp_min_(1e-6)\n  modified.sub_(base);base.add_(modified,alpha=beta)\n  ratio.div_(base.norm(dim=-1,keepdim=True).clamp_min_(1e-6)).clamp_(.25,4.)\n  y=torch.matmul(base.mul_(ratio),wv.transpose(-1,-2))\n return y.transpose(1,2).flatten(2).contiguous()\n\nwith torch.inference_mode():\n for c in json.load(open('/workspace/environment/public_assets/dev/protocol.json'))['cases']:\n  b,l,ch,h,d=[c[k] for k in ('batch','length','channels','heads','dim')]\n  x=torch.randn(b,l,ch);weights=[torch.randn(h,d,ch)/math.sqrt(ch) for _ in range(3)]\n  args=(x
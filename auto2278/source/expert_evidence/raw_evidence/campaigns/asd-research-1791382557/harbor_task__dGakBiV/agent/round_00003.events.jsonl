{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/sh -lc \"OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 python - <<'PY'\nimport math,json,time,statistics,torch\ncases=json.load(open('/workspace/environment/public_assets/dev/protocol.json'))['cases']\nwith torch.inference_mode():\n for c in cases:\n  b,l,ch,h,d=[c[k] for k in ('batch','length','channels','heads','dim')]\n  x=torch.randn(b,l,ch)\n  weights=[torch.randn(h,d,ch) / math.sqrt(ch) for _ in range(3)]\n  def split_bmm():\n   return [torch.matmul(x.unsqueeze(1),w.transpose(-1,-2)) for w in weights]\n  def split_mm():\n   return [torch.mm(x.reshape(b*l,ch),w.reshape(h*d,ch).t()).reshape(b,l,h,d).transpose(1,2) for w in weights]\n  def fused_mm():\n   out=torch.mm(x.reshape(b*l,ch),torch.cat(weights,0).reshape(3*h*d,ch).t()).reshape(b,l,3,h,d)\n   return [out[:,:,i].transpose(1,2) for i in range(3)]\n  timings={}\n  for f in (split_bmm,split_mm,fused_mm):\n   f();f()\n   ts=[]\n   for _ in range(7):\n    t=time.process_time_ns(); f();ts.append((time.process_time_ns()-t)/1e6)\n   timings[f.__name__]=round(statistics.median(ts),3)\n  err=(split_bmm()[0]-fused_mm()[0]).abs().max().item()\n  print((b,l,ch,h,d),timings,'max_error',err,flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

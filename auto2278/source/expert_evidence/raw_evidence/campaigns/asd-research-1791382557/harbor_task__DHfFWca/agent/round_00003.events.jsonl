{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/sh -lc \"cat << 'PYEOF' > /tmp/profile.py\nimport time, math, torch\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n# Use case 3 (likely biggest): batch=1, length=128, channels=1280, heads=20, dim=64\nB, L, C, H, D = 1, 128, 1280, 20, 64\nalpha, beta = 1.15, 3.0\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\ndef time_step(name, fn, warmup=3, repeats=11):\n    for _ in range(warmup):\n        fn()\n    times = []\n    for _ in range(repeats):\n        t0 = time.process_time_ns()\n        result = fn()\n        times.append((time.process_time_ns() - t0) / 1e6)\n    print(f\\\"  {name}: {sorted(times)[5]:.3f} ms (median of {repeats})\\\")\n    return result\n\nprint(f\\\"Case: B={B}, L={L}, C={C}, H={H}, D={D}\\\")\nprint(f\\\"  Total FLOPs estimate: attention ~ O(B*H*L\"'^2*D + B*H*L''^2*C + B*H*L*C*D)\")\n\ninv_sqrt_d = 1.0 / math.sqrt(D)\n\n# Step 1: q, k computation\ndef compute_qk_einsum():\n    q = torch.einsum(\"blc,hdc->bhld\", x, wq)\n    k = torch.einsum(\"blc,hdc->bhld\", x, wk)\n    return q, k\n\ndef compute_qk_gemm():\n    x2 = x.reshape(B*L, C)\n    q = (x2 @ wq.reshape(H*D, C).t()).view(B, L, H, D).permute(0,2,1,3).contiguous()\n    k = (x2 @ wk.reshape(H*D, C).t()).view(B, L, H, D).permute(0,2,1,3).contiguous()\n    return q, k\n\nq, k = compute_qk_einsum()\nprint(\"Step 1: q,k projection\")\ntime_step(\"einsum\", compute_qk_einsum)\ntime_step(\"gemm+reshape\", compute_qk_gemm)\nq2, k2 = compute_qk_gemm()\nprint(f\"  q diff: {(q-q2).abs().max():.2e}\")\n\n# Step 2: logits\ndef compute_logits():\n    return (q @ k.transpose(-1, -2)) * inv_sqrt_d\n\ndef compute_logits_bmm():\n    qr = q.reshape(B*H, L, D)\n    kr = k.reshape(B*H, L, D)\n    return (qr @ kr.transpose(-1, -2)).view(B, H, L, L) * inv_sqrt_d\n\nlogits = compute_logits()\nprint(\"Step 2: logits (q@k''^T/sqrt(D))\")\ntime_step(\"@+transpose\", compute_logits)\ntime_step(\"bmm+reshape\", compute_logits_bmm)\nprint(f\"  logits diff: {(logits-compute_logits_bmm()).abs().max():.2e}\")\n\n# Step 3: softmax p0\nprint(\"Step 3: softmax p0\")\ntime_step(\"softmax\", lambda: logits.softmax(dim=-1))\np0 = logits.softmax(dim=-1)\n\n# Step 4: base = p0 @ x\ndef base_broadcast():\n    return p0 @ x.unsqueeze(1)\n\ndef base_einsum():\n    return torch.einsum(\"bhjk,bkc->bhjc\", p0, x)\n\ndef base_bmm():\n    p0r = p0.reshape(B*H, L, L)\n    xr = x.unsqueeze(1).expand(B, H, L, C).reshape(B*H, L, C)\n    return (p0r @ xr).view(B, H, L, C)\n\nprint(\"Step 4: base = p0 @ x\")\ntime_step(\"broadcast matmul\", base_broadcast)\ntime_step(\"einsum\", base_einsum)\ntime_step(\"bmm reshape\", base_bmm)\nbase = base_broadcast()\nprint(f\"  broadcast vs einsum: {(base-base_einsum()).abs().max():.2e}\")\nprint(f\"  broadcast vs bmm: {(base-base_bmm()).abs().max():.2e}\")\n\n# Step 5: perturbed logits + softmax + modified\na_p = 0.5 * (1 + alpha)\na_m = 0.5 * (1 - alpha)\n\ndef modified_full():\n    perturbed = a_p * logits + a_m * logits.transpose(-1, -2)\n    p1 = perturbed.softmax(dim=-1)\n    return p1 @ x.unsqueeze(1)\n\nprint(\"Step 5: modified (perturbed softmax @ x)\")\ntime_step(\"full\", modified_full)\nmodified = modified_full()\n\n# Step 6: blend + ratio + final projection\ndef final_steps():\n    blended = base.lerp(modified, beta)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    y = torch.einsum(\"bhlc,hdc->bhld\", blended * ratio, wv)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ndef final_gemm():\n    blended = base.lerp(modified, beta)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    out = blended * ratio  # (B,H,L,C)\n    # (B,H,L,C) @ (H,D,C)''^T -> (B,H,L,D)\n    out2 = out.reshape(B*H, L, C)\n    wv2 = wv.reshape(H*D, C)\n    # Need to do this per-head or reshaped\n    # out[b,h,l,:] @ wv[h,:,:].T -> (B,H,L,D)\n    # Reshape approach: \n    y = (out.permute(0,2,1,3).reshape(B*L, H*C) @ ... no that doesn'\"'t work\n    # Better: for each head, different weight matrix\n    # Use bmm: (B*H, L, C) @ (H*D, C).T -> need per-head\n    # Actually we can do: out reshaped to (B*H, L, C), wv reshaped (H, D, C)\n    # We want: for each h: out[h] @ wv[h].T\n    # Use bmm with broadcasting:\n    wv_b = wv.unsqueeze(0).expand(B, H, D, C).reshape(B*H, D, C)\n    y = (out2 @ wv_b.transpose(-1, -2)).view(B, H, L, D)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\nprint(\\\"Step 6: blend + ratio + final projection\\\")\ntime_step(\\\"einsum\\\", final_steps)\ntime_step(\\\"gemm+bmm\\\", final_gemm)\nprint(f\\\"  diff: {(final_steps()-final_gemm()).abs().max():.2e}\\\")\n\n# Total\nprint(\\\"\\\\nTotal current method:\\\")\ndef current_method():\n    q = torch.einsum(\\\"blc,hdc->bhld\\\", x, wq)\n    k = torch.einsum(\\\"blc,hdc->bhld\\\", x, wk)\n    logits = (q @ k.transpose(-1, -2)) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    base = torch.einsum(\\\"bhjk,bkc->bhjc\\\", p0, x)\n    perturbed = a_p * logits + a_m * logits.transpose(-1, -2)\n    p1 = perturbed.softmax(dim=-1)\n    modified = torch.einsum(\\\"bhjk,bkc->bhjc\\\", p1, x)\n    blended = base.lerp(modified, beta)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    y = torch.einsum(\\\"bhlc,hdc->bhld\\\", blended * ratio, wv)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ntime_step(\\\"current\\\", current_method)\nPYEOF\npython /tmp/profile.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

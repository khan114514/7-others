{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport time\nimport math\nimport torch\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 2, 512, 256, 8, 32\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\nalpha = 0.5\nbeta = 0.3\n\ndef time_step(name, fn, warmup=5, reps=20):\n    for _ in range(warmup):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(reps):\n        fn()\n    t1 = time.process_time_ns()\n    ms = (t1 - t0) / reps / 1e6\n    print(f'{name:55s} {ms:8.2f} ms')\n    return ms\n\nH, D, C = wq.shape\nB = x.shape[0]\nL = x.shape[1]\nBH = B * H\nBL = B * L\n\n# Precompute\nq = torch.einsum('blc,hdc->bhld', x, wq)\nk = torch.einsum('blc,hdc->bhld', x, wk)\nlogits = (q @ k.transpose(-1, -2)) / math.sqrt(D)\np0 = logits.softmax(dim=-1)\na_p = 0.5 * (1 + alpha)\na_m = 0.5 * (1 - alpha)\nperturbed = a_p * logits + a_m * logits.transpose(-1, -2)\np1 = perturbed.softmax(dim=-1)\n\nx_bmm = x.unsqueeze(1).expand(B, H, L, C).reshape(BH, L, C)\nbase = torch.bmm(p0.reshape(BH, L, L), x_bmm).reshape(B, H, L, C)\nmodified = torch.bmm(p1.reshape(BH, L, L), x_bmm).reshape(B, H, L, C)\nblended = base.lerp(modified, beta)\nratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6) / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n\nprint('=== Final projection alternatives ===')\n# Current: einsum\ntime_step('einsum bhlc,hdc->bhld', lambda: torch.einsum('bhlc,hdc->bhld', blended * ratio, wv))\n\n# bmm approach: (BH, L, C) @ (BH, D, C).T -> (BH, L, D)\ndef final_bmm():\n    br = (blended * ratio).reshape(BH, L, C)\n    wve = wv.unsqueeze(0).expand(B, H, D, C).reshape(BH, D, C)\n    return torch.bmm(br, wve.transpose(1, 2)).reshape(B, H, L, D)\ntime_step('bmm (expand wv)', final_bmm)\n\n# Verify\nr_ein = torch.einsum('bhlc,hdc->bhld', blended * ratio, wv)\nr_bmm = final_bmm()\nprint(f'  diff: {(r_ein - r_bmm).abs().max():.2e}')\n\n# What about per-head? Small gemms. Probably not better.\n\n# Try: matmul with reshaped\n# (B*H*L, C) @ (C, D) per head... no\n# Actually: wv is (H, D, C). If we reshape blended*ratio to (B*L, H, C) \n# and do something...\n\n# Alternative: use torch.matmul with broadcasting\n# (B, H, L, C) @ (H, C, D) - does this broadcast?\ndef final_bmm2():\n    # (B,H,L,C) @ (1,H,C,D) -> (B,H,L,D) via broadcast bmm\n    return torch.matmul(blended * ratio, wv.transpose(1, 2).unsqueeze(0))\ntime_step('matmul broadcast (B,H,L,C) @ (1,H,C,D)', final_bmm2)\nr_mm = final_bmm2()\nprint(f'  diff: {(r_ein - r_mm).abs().max():.2e}')\n\nprint()\nprint('=== Perturbed logits alternatives ===')\ntime_step('a_p * A + a_m * A.T', lambda: a_p * logits + a_m * logits.transpose(-1, -2))\n\ndef inplace1():\n    out = logits.clone()\n    out.mul_(a_p)\n    out.add_(logits.transpose(-1, -2), alpha=a_m)\n    return out\ntime_step('inplace: clone().mul_(a_p).add_(A.T, a_m)', inplace1)\n\n# addcmul: A + a_m * (A.T - A) -- probably slower since 2 ops\n# But addcmul: A.addcmul(a_m, A.T - A)? No, addcmul is tensor1 + value*tensor2*tensor3\n\n# Try: A.T * a_m + A * a_p via a different formulation\n# = (A + A.T) * 0.5 * 2*a_m + ... nah\n# Actually a_p + a_m = 1 always, since a_p = (1+alpha)/2, a_m = (1-alpha)/2\n# So a_p * A + a_m * A.T = A + a_m * (A.T - A)\n# But we saw this is slower because subtraction + addition\n\n# What about using lerp? lerp(A.T, A, a_p) -> not right\n# lerp(A, A.T, a_m) = A + a_m * (A.T - A) = a_p*A + a_m*A.T\n# Yes\"'! Exactly.\ntime_step('\"'lerp(A, A.T, a_m)', lambda: logits.lerp(logits.transpose(-1, -2), a_m))\nr_lerp = logits.lerp(logits.transpose(-1, -2), a_m)\nr_ref = a_p * logits + a_m * logits.transpose(-1, -2)\nprint(f'  lerp diff: {(r_lerp - r_ref).abs().max():.2e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

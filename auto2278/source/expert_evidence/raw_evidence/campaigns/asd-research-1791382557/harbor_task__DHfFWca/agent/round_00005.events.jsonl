{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport time\nimport math\nimport torch\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 2, 512, 256, 8, 32\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\nalpha = 0.5\nbeta = 0.3\n\ndef time_step(name, fn, warmup=3, reps=10):\n    for _ in range(warmup):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(reps):\n        fn()\n    t1 = time.process_time_ns()\n    ms = (t1 - t0) / reps / 1e6\n    print(f'{name:50s} {ms:8.2f} ms')\n    return ms\n\n# Test full optimized version\ndef optimized_v1(x, wq, wk, wv, alpha, beta):\n    D = wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    \n    # Projections via gemm\n    BL = x.shape[0] * x.shape[1]\n    C = x.shape[2]\n    H = wq.shape[0]\n    \n    xf = x.reshape(BL, C)\n    q = (xf @ wq.reshape(H * D, C).T).reshape(x.shape[0], x.shape[1], H, D).permute(0, 2, 1, 3)\n    k = (xf @ wk.reshape(H * D, C).T).reshape(x.shape[0], x.shape[1], H, D).permute(0, 2, 1, 3)\n    \n    logits = (q @ k.transpose(-1, -2)) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    \n    # p @ x via bmm\n    BH = x.shape[0] * H\n    x_bmm = x.unsqueeze(1).expand(x.shape[0], H, x.shape[1], C).reshape(BH, x.shape[1], C)\n    base = torch.bmm(p0.reshape(BH, x.shape[1], x.shape[1]), x_bmm).reshape(x.shape[0], H, x.shape[1], C)\n    \n    if alpha == 1.0:\n        modified = base\n    else:\n        a_p = 0.5 * (1 + alpha)\n        a_m = 0.5 * (1 - alpha)\n        perturbed = logits.clone()\n        perturbed.mul_(a_p)\n        perturbed.add_(logits.transpose(-1, -2), alpha=a_m)\n        p1 = perturbed.softmax(dim=-1)\n        modified = torch.bmm(p1.reshape(BH, x.shape[1], x.shape[1]), x_bmm).reshape(x.shape[0], H, x.shape[1], C)\n    \n    blended = base.lerp(modified, beta)\n    \n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    \n    # Final projection via gemm\n    y = (blended * ratio).permute(0, 2, 1, 3).reshape(BL, H * C) @ wv.reshape(H * D, C).T\n    return y.reshape(x.shape[0], x.shape[1], H, D).flatten(2).contiguous()\n\n# Correctness check\ndef current_method(x, wq, wk, wv, alpha, beta):\n    D = wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    q = torch.einsum('blc,hdc->bhld', x, wq)\n    k = torch.einsum('blc,hdc->bhld', x, wk)\n    logits = (q @ k.transpose(-1, -2)) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    base = torch.einsum('bhjk,bkc->bhjc', p0, x)\n    if alpha == 1.0:\n        modified = base\n    else:\n        a_p = 0.5 * (1 + alpha)\n        a_m = 0.5 * (1 - alpha)\n        perturbed = a_p * logits + a_m * logits.transpose(-1, -2)\n        p1 = perturbed.softmax(dim=-1)\n        modified = torch.einsum('bhjk,bkc->bhjc', p1, x)\n    blended = base.lerp(modified, beta)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    y = torch.einsum('bhlc,hdc->bhld', blended * ratio, wv)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\nr1 = current_method(x, wq, wk, wv, alpha, beta)\nr2 = optimized_v1(x, wq, wk, wv, alpha, beta)\nprint(f'Correctness: max diff = {(r1 - r2).abs().max():.2e}')\nprint(f'Shape: {r2.shape}')\nprint()\n\ntime_step('Current method', lambda: current_method(x, wq, wk, wv, alpha, beta))\ntime_step('Optimized v1 (bmm + gemm)', lambda: optimized_v1(x, wq, wk, wv, alpha, beta))\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport time\nimport math\nimport torch\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n# Typical case sizes from the eval\nB, L, C, H, D = 2, 512, 256, 8, 32\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\nalpha = 0.5\nbeta = 0.3\n\ndef current_method(x, wq, wk, wv, alpha, beta):\n    D = wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    q = torch.einsum('blc,hdc->bhld', x, wq)\n    k = torch.einsum('blc,hdc->bhld', x, wk)\n    logits = (q @ k.transpose(-1, -2)) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    base = torch.einsum('bhjk,bkc->bhjc', p0, x)\n    if alpha == 1.0:\n        modified = base\n    else:\n        a_p = 0.5 * (1 + alpha)\n        a_m = 0.5 * (1 - alpha)\n        perturbed = a_p * logits + a_m * logits.transpose(-1, -2)\n        p1 = perturbed.softmax(dim=-1)\n        modified = torch.einsum('bhjk,bkc->bhjc', p1, x)\n    blended = base.lerp(modified, beta)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    y = torch.einsum('bhlc,hdc->bhld', blended * ratio, wv)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Time breakdown\nimport time\n\ndef time_step(name, fn, warmup=3, reps=10):\n    for _ in range(warmup):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(reps):\n        fn()\n    t1 = time.process_time_ns()\n    ms = (t1 - t0) / reps / 1e6\n    print(f'{name:40s} {ms:8.2f} ms')\n    return ms\n\nDv = wq.shape[1]\ninv_sqrt_d = 1.0 / math.sqrt(Dv)\n\n# Warmup\nfor _ in range(3):\n    current_method(x, wq, wk, wv, alpha, beta)\n\nprint('=== Current method breakdown ===')\nq = torch.einsum('blc,hdc->bhld', x, wq)\nk = torch.einsum('blc,hdc->bhld', x, wk)\nlogits = (q @ k.transpose(-1, -2)) * inv_sqrt_d\np0 = logits.softmax(dim=-1)\nbase = torch.einsum('bhjk,bkc->bhjc', p0, x)\na_p = 0.5 * (1 + alpha)\na_m = 0.5 * (1 - alpha)\nperturbed = a_p * logits + a_m * logits.transpose(-1, -2)\np1 = perturbed.softmax(dim=-1)\nmodified = torch.einsum('bhjk,bkc->bhjc', p1, x)\nblended = base.lerp(modified, beta)\nratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6) / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\ny = torch.einsum('bhlc,hdc->bhld', blended * ratio, wv)\n\ntime_step('q projection (einsum)', lambda: torch.einsum('blc,hdc->bhld', x, wq))\ntime_step('k projection (einsum)', lambda: torch.einsum('blc,hdc->bhld', x, wk))\ntime_step('logits = q @ k.T', lambda: (q @ k.transpose(-1, -2)) * inv_sqrt_d)\ntime_step('softmax p0', lambda: logits.softmax(dim=-1))\ntime_step('base = p0 @ x (einsum)', lambda: torch.einsum('bhjk,bkc->bhjc', p0, x))\ntime_step('perturbed logits', lambda: a_p * logits + a_m * logits.transpose(-1, -2))\ntime_step('softmax p1', lambda: perturbed.softmax(dim=-1))\ntime_step('modified = p1 @ x (einsum)', lambda: torch.einsum('bhjk,bkc->bhjc', p1, x))\ntime_step('blend + ratio', lambda: (base.lerp(modified, beta), (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6) / base.lerp(modified, beta).norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)))\ntime_step('final projection (einsum)', lambda: torch.einsum('bhlc,hdc->bhld', blended * ratio, wv))\ntime_step('output rearrange', lambda: y.transpose(1, 2).flatten(2).contiguous())\nprint()\ntime_step('FULL current method', lambda: current_method(x, wq, wk, wv, alpha, beta))\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

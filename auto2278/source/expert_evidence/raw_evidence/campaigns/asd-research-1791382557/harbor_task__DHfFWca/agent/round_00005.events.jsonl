{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch\nimport math\nimport time\n\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 2, 512, 256, 8, 32\n\ndef opt_bmm_matmul(x, wq, wk, wv, alpha, beta):\n    H, D, C = wq.shape\n    B, L, _ = x.shape\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    BH = B * H\n    \n    q = torch.einsum('blc,hdc->bhld', x, wq)\n    k = torch.einsum('blc,hdc->bhld', x, wk)\n    logits = (q @ k.transpose(-1, -2)) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    \n    x_bmm = x.unsqueeze(1).expand(B, H, L, C).reshape(BH, L, C)\n    base = torch.bmm(p0.reshape(BH, L, L), x_bmm).reshape(B, H, L, C)\n    \n    if alpha == 1.0:\n        modified = base\n    else:\n        a_p = 0.5 * (1 + alpha)\n        a_m = 0.5 * (1 - alpha)\n        perturbed = a_p * logits + a_m * logits.transpose(-1, -2)\n        p1 = perturbed.softmax(dim=-1)\n        modified = torch.bmm(p1.reshape(BH, L, L), x_bmm).reshape(B, H, L, C)\n    \n    blended = base.lerp(modified, beta)\n    \n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    \n    y = torch.matmul(blended * ratio, wv.transpose(1, 2).unsqueeze(0))\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ndef reference(x, wq, wk, wv, alpha, beta):\n    D = wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    q = torch.einsum('blc,hdc->bhld', x, wq)\n    k = torch.einsum('blc,hdc->bhld', x, wk)\n    logits = (q @ k.transpose(-1, -2)) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    base = torch.einsum('bhjk,bkc->bhjc', p0, x)\n    if alpha == 1.0:\n        modified = base\n    else:\n        a_p = 0.5 * (1 + alpha)\n        a_m = 0.5 * (1 - alpha)\n        perturbed = a_p * logits + a_m * logits.transpose(-1, -2)\n        p1 = perturbed.softmax(dim=-1)\n        modified = torch.einsum('bhjk,bkc->bhjc', p1, x)\n    blended = base.lerp(modified, beta)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    y = torch.einsum('bhlc,hdc->bhld', blended * ratio, wv)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Correctness - should be exact\nprint('Numerical check...')\nviolations_total = 0\nfor seed in range(20):\n    torch.manual_seed(seed)\n    for a in [0.0, 0.3, 0.7, 1.0]:\n        for b in [0.0, 0.5, 1.0]:\n            x = torch.randn(B, L, C)\n            wq = torch.randn(H, D, C)\n            wk = torch.randn(H, D, C)\n            wv = torch.randn(H, D, C)\n            r1 = reference(x, wq, wk, wv, a, b)\n            r2 = opt_bmm_matmul(x, wq, wk, wv, a, b)\n            diff = (r1 - r2).abs()\n            if diff.max() > 0:\n                tol = 3e-5 + 3e-4 * r1.abs()\n                v = (diff > tol).sum().item()\n                if v > 0:\n                    violations_total += v\n                    print(f'  seed={seed} a={a} b={b}: max diff={diff.max():.2e} viol={v}')\nif violations_total == 0:\n    print('  All within tolerance (no violations).')\nprint()\n\n# Timing\ndef time_fn(name, fn, warmup=5, reps=15):\n    for _ in range(warmup):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(reps):\n        fn()\n    t1 = time.process_time_ns()\n    ms = (t1 - t0) / reps / 1e6\n    print(f'{name:40s} {ms:8.2f} ms')\n    return ms\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\nalpha = 0.5\nbeta = 0.3\n\ntime_fn('Reference', lambda: reference(x, wq, wk, wv, alpha, beta))\ntime_fn('BMM + matmul', lambda: opt_bmm_matmul(x, wq, wk, wv, alpha, beta))\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

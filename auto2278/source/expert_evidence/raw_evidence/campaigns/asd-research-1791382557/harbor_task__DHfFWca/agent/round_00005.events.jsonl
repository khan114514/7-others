{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch\nimport math\nimport time\n\ntorch.set_num_threads(1)\n\n# Biggest case\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha = 0.5\nbeta = 0.3\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\ninv_sqrt_d = 1.0 / math.sqrt(D)\n\ndef time_fn(name, fn, warmup=3, reps=11):\n    for _ in range(warmup):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(reps):\n        fn()\n    t1 = time.process_time_ns()\n    ms = (t1 - t0) / reps / 1e6\n    print(f'{name:45s} {ms:8.2f} ms')\n    return ms\n\nq = torch.einsum('blc,hdc->bhld', x, wq)\nk = torch.einsum('blc,hdc->bhld', x, wk)\nlogits = (q @ k.transpose(-1, -2)) * inv_sqrt_d\np0 = logits.softmax(dim=-1)\nbase = torch.einsum('bhjk,bkc->bhjc', p0, x)\na_p = 0.5 * (1 + alpha)\na_m = 0.5 * (1 - alpha)\nperturbed = a_p * logits + a_m * logits.transpose(-1, -2)\np1 = perturbed.softmax(dim=-1)\nmodified = torch.einsum('bhjk,bkc->bhjc', p1, x)\nblended = base.lerp(modified, beta)\nratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6) / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n\nprint('=== Biggest case breakdown ===')\ntime_fn('q projection einsum', lambda: torch.einsum('blc,hdc->bhld', x, wq))\ntime_fn('k projection einsum', lambda: torch.einsum('blc,hdc->bhld', x, wk))\ntime_fn('logits = q @ k.T * scale', lambda: (q @ k.transpose(-1, -2)) * inv_sqrt_d)\ntime_fn('softmax p0', lambda: logits.softmax(dim=-1))\ntime_fn('base = p0 @ x (einsum)', lambda: torch.einsum('bhjk,bkc->bhjc', p0, x))\ntime_fn('perturbed logits', lambda: a_p * logits + a_m * logits.transpose(-1, -2))\ntime_fn('softmax p1', lambda: perturbed.softmax(dim=-1))\ntime_fn('modified = p1 @ x (einsum)', lambda: torch.einsum('bhjk,bkc->bhjc', p1, x))\ntime_fn('blend + ratio', lambda: (base.lerp(modified, beta), (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)/base.lerp(modified,beta).norm(dim=-1,keepdim=True).clamp_min(1e-6)).clamp(.25,4.)))\ntime_fn('final projection einsum', lambda: torch.einsum('bhlc,hdc->bhld', blended * ratio, wv))\nprint()\n\n# Now test alternatives for the biggest cost centers\nBH = B * H\nBL = B * L\n\n# p@x alternatives\nprint('=== p@x alternatives ===')\ntime_fn('einsum p0@x', lambda: torch.einsum('bhjk,bkc->bhjc', p0, x))\n\ndef bmm_expand():\n    x_bmm = x.unsqueeze(1).expand(B, H, L, C).reshape(BH, L, C)\n    return torch.bmm(p0.reshape(BH, L, L), x_bmm).reshape(B, H, L, C)\ntime_fn('bmm (expand each time)', bmm_expand)\n\n# Projection alternatives\nprint()\nprint('=== Projection alternatives ===')\ntime_fn('einsum q', lambda: torch.einsum('blc,hdc->bhld', x, wq))\n\ndef proj_gemm():\n    return (x.reshape(BL, C) @ wq.reshape(H*D, C).T).reshape(B, L, H, D).permute(0,2,1,3).contiguous()\ntime_fn('gemm + permute', proj_gemm)\n\n# Final projection alternatives\nprint()\nprint('=== Final projection ===')\ntime_fn('einsum final', lambda: torch.einsum('bhlc,hdc->bhld', blended * ratio, wv))\n\ndef final_gemm_permute():\n    # (B,H,L,C) -> (B,L,H,C) -> reshape (BL, H*C) - no, different structure\n    # einsum 'bhlc,hdc->bhld' = for each head h: (B,L,C) @ (D,C).T -> (B,L,D)\n    # Using matmul: (B,H,L,C) @ (H,C,D) broadcast\n    return torch.matmul(blended * ratio, wv.transpose(1,2).unsqueeze(0))\ntime_fn('matmul broadcast', final_gemm_permute)\n\n# Also test: doing (blended * ratio) in-place fused with the matmul\ndef final_fused():\n    br = blended.mul(ratio)\n    return torch.matmul(br, wv.transpose(1,2).unsqueeze(0))\ntime_fn('matmul + pre-mul', final_fused)\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

us()\n    xf = x.unsqueeze(1).expand(B, H, L, C).contiguous().reshape(B * H, L, C)\n    return torch.bmm(pf, xf).reshape(B, H, L, C)\ntime_step('bmm (contiguous + expand)', p_at_x_bmm_contig)\n\n# Try with x pre-expanded (if we can reuse)\nx_exp = x.unsqueeze(1).expand(B, H, L, C).contiguous().reshape(B * H, L, C)\ndef p_at_x_bmm_pre():\n    pf = p.reshape(B * H, L, L)\n    return torch.bmm(pf, x_exp).reshape(B, H, L, C)\ntime_step('bmm (x pre-expanded)', p_at_x_bmm_pre)\nprint()\n\n# ---- Softmax alternatives ----\nprint('=== Softmax alternatives ===')\nlogits = torch.randn(B, H, L, L)\n\ntime_step('softmax dim=-1 (default)', lambda: logits.softmax(dim=-1))\ntime_step('softmax dim=-1 contiguous', lambda: logits.contiguous().softmax(dim=-1))\n\n# Try with reshape to 2D\ntime_step('softmax 2D reshape', lambda: logits.reshape(B * H * L, L).softmax(dim=-1).reshape(B, H, L, L))\nprint()\n\n# ---- Perturbed logits alternatives ----\nprint('=== Perturbed logits ===')\nlogits_c = logits.clone()\na_p, a_m = 0.5 * 1.5, 0.5 * 0.5  # alpha=0.5\n\ntime_step('a_p*logits + a_m*logits.T', lambda: a_p * logits + a_m * logits.transpose(-1, -2))\n# Can we use addcmul or something?\ndef perturbed_inplace():\n    out = logits.clone()\n    out.mul_(a_p)\n    out.add_(logits.transpose(-1, -2), alpha=a_m)\n    return out\ntime_step('inplace mul+add', perturbed_inplace)\n\nr1 = a_p * logits + a_m * logits.transpose(-1, -2)\nr2 = perturbed_inplace()\nprint(f'  diff: {(r1 - r2).abs().max():.2e}')\n\n# Using add (logits + a_m*(A.T - A))\n# a_p*A + a_m*A.T = A + a_m*(A.T - A)  since a_p = 1 - a_m\ndef perturbed_v2():\n    return logits + a_m * (logits.transpose(-1, -2) - logits)\ntime_step('A + a_m*(A.T - A)', perturbed_v2)\nr3 = perturbed_v2()\nprint(f'  diff v2: {(r1 - r3).abs().max():.2e}')\n\\\"\n\"","aggregated_output":"=== Projection alternatives ===\neinsum blc,hdc->bhld                              2.43 ms\ngemm + reshape + permute                          2.58 ms\n  diff: 0.00e+00\n\n
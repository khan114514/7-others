{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport time\nimport math\nimport torch\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 2, 512, 256, 8, 32\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\n\ndef time_step(name, fn, warmup=3, reps=10):\n    for _ in range(warmup):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(reps):\n        fn()\n    t1 = time.process_time_ns()\n    ms = (t1 - t0) / reps / 1e6\n    print(f'{name:45s} {ms:8.2f} ms')\n    return ms\n\n# ---- Projection alternatives ----\nprint('=== Projection alternatives ===')\n# Einsum\ntime_step('einsum blc,hdc->bhld', lambda: torch.einsum('blc,hdc->bhld', x, wq))\n\n# reshape + linear (gemm): x:(B*L,C) @ wq:(H*D,C).T -> (B*L,H*D) -> (B,L,H,D) -> (B,H,L,D)\ndef proj_gemm():\n    BL = B * L\n    xf = x.reshape(BL, C)\n    wf = wq.reshape(H * D, C)\n    out = xf @ wf.T  # (BL, H*D)\n    return out.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\ntime_step('gemm + reshape + permute', proj_gemm)\n\n# Verify\nr_ein = torch.einsum('blc,hdc->bhld', x, wq)\nr_gem = proj_gemm()\nprint(f'  diff: {(r_ein - r_gem).abs().max():.2e}')\nprint()\n\n# ---- p @ x alternatives ----\nprint('=== p@x alternatives ===')\np = torch.randn(B, H, L, L).softmax(dim=-1)\n\ntime_step('einsum bhjk,bkc->bhjc', lambda: torch.einsum('bhjk,bkc->bhjc', p, x))\n\n# bmm: p:(B*H,L,L) @ x_expanded:(B*H,L,C)\ndef p_at_x_bmm():\n    pf = p.reshape(B * H, L, L)\n    xf = x.unsqueeze(1).expand(B, H, L, C).reshape(B * H, L, C)\n    return torch.bmm(pf, xf).reshape(B, H, L, C)\ntime_step('bmm (expand+reshape)', p_at_x_bmm)\n\nr1 = torch.einsum('bhjk,bkc->bhjc', p, x)\nr2 = p_at_x_bmm()\nprint(f'  diff: {(r1 - r2).abs().max():.2e}')\n\n# bmm with contiguous\ndef p_at_x_bmm_contig():\n    pf = p.reshape(B * H, L, L).contiguous()\n    xf = x.unsqueeze(1).expand(B, H, L, C).contiguous().reshape(B * H, L, C)\n    return torch.bmm(pf, xf).reshape(B, H, L, C)\ntime_step('bmm (contiguous + expand)', p_at_x_bmm_contig)\n\n# Try with x pre-expanded (if we can reuse)\nx_exp = x.unsqueeze(1).expand(B, H, L, C).contiguous().reshape(B * H, L, C)\ndef p_at_x_bmm_pre():\n    pf = p.reshape(B * H, L, L)\n    return torch.bmm(pf, x_exp).reshape(B, H, L, C)\ntime_step('bmm (x pre-expanded)', p_at_x_bmm_pre)\nprint()\n\n# ---- Softmax alternatives ----\nprint('=== Softmax alternatives ===')\nlogits = torch.randn(B, H, L, L)\n\ntime_step('softmax dim=-1 (default)', lambda: logits.softmax(dim=-1))\ntime_step('softmax dim=-1 contiguous', lambda: logits.contiguous().softmax(dim=-1))\n\n# Try with reshape to 2D\ntime_step('softmax 2D reshape', lambda: logits.reshape(B * H * L, L).softmax(dim=-1).reshape(B, H, L, L))\nprint()\n\n# ---- Perturbed logits alternatives ----\nprint('=== Perturbed logits ===')\nlogits_c = logits.clone()\na_p, a_m = 0.5 * 1.5, 0.5 * 0.5  # alpha=0.5\n\ntime_step('a_p*logits + a_m*logits.T', lambda: a_p * logits + a_m * logits.transpose(-1, -2))\n# Can we use addcmul or something?\ndef perturbed_inplace():\n    out = logits.clone()\n    out.mul_(a_p)\n    out.add_(logits.transpose(-1, -2), alpha=a_m)\n    return out\ntime_step('inplace mul+add', perturbed_inplace)\n\nr1 = a_p * logits + a_m * logits.transpose(-1, -2)\nr2 = perturbed_inplace()\nprint(f'  diff: {(r1 - r2).abs().max():.2e}')\n\n# Using add (logits + a_m*(A.T - A))\n# a_p*A + a_m*A.T = A + a_m*(A.T - A)  since a_p = 1 - a_m\ndef perturbed_v2():\n    return logits + a_m * (logits.transpose(-1, -2) - logits)\ntime_step('A + a_m*(A.T - A)', perturbed_v2)\nr3 = perturbed_v2()\nprint(f'  diff v2: {(r1 - r3).abs().max():.2e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

                 3.78 ms\nbmm (expand wv)                                             2.63 ms\n  diff: 0.00e+00\nmatmul broadcast (B,H,L,C) @ (1,H,C,D)                      2.70 ms\n  diff: 0.00e+00\n\n=== Perturbed logits alternatives ===\na_p * A + a_m * A.T                                        31.94 ms\ninplace: clone().mul_(a_p).add_(A.T, a_m)                  25.55 ms\nlerp(A, A.T, a_m)                                          19.07 ms\n  lerp diff: 1.22e-04\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport torch\nimport math\n\ntorch.set_num_threads(1)\n\nB, L, C, H, D = 2, 512, 256, 8, 32\n\ntorch.manual_seed(42)\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\nalpha = 0.5\nbeta = 0.3\n\ndef method_with_lerp(x, wq, wk, wv, alpha, beta):\n    D = wq.shape[1]\n    H = wq.shape[0]\n    B = x.shape[0]\n    L = x.shape[1]\n    C = x.shape[2]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    BH = B * H\n    \n    q = torch.einsum('blc,hdc->bhld', x, wq)\n    k = torch.einsum('blc,hdc->bhld', x, wk)\n    logits = (q @ k.transpose(-1, -2)) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    \n    x_bmm = x.unsqueeze(1).expand(B, H, L, C).reshape(BH, L, C)\n    base = torch.bmm(p0.reshape(BH, L, L), x_bmm).reshape(B, H, L, C)\n    \n    if alpha == 1.0:\n        modified = base\n    else:\n        a_m = 0.5 * (1 - alpha)\n        # perturbed = a_p*A + a_m*A.T = A.lerp(A.T, a_m)\n        perturbed = logits.lerp(logits.transpose(-1, -2), a_m)\n        p1 = perturbed.softmax(dim=-1)\n        modified = torch.bmm(p1.reshape(BH, L, L), x_bmm).reshape(B, H, L, C)\n    \n    blended = base.lerp(modified, beta)\n    \n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6) / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n    ratio.clamp_(.25, 4.)\n    \n    y = torch.matmul(blended * ratio, wv.transpose(1, 2).unsqueeze(0))\n    return y.transpose(1, 2).flatten(2).contiguous()\n\ndef reference(x, wq, wk, wv, alpha, beta):\n    D = wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    q = torch.einsum('blc,hdc->bhld', x, wq)\n    k = torch.einsum('blc,hdc->bhld', x, wk)\n    logits = (q @ k.transpose(-1, -2)) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    base = torch.einsum('bhjk,bkc->bhjc', p0, x)\n    if alpha == 1.0:\n        modified = base\n    else:\n        a_p = 0.5 * (1 + alpha)\n        a_m = 0.5 * (1 - alpha)\n        perturbed = a_p * logits + a_m * logits.transpose(-1, -2)\n        p1 = perturbed.softmax(dim=-1)\n        modified = torch.einsum('bhjk,bkc->bhjc', p1, x)\n    blended = base.lerp(modified, beta)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    y = torch.einsum('bhlc,hdc->bhld', blended * ratio, wv)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\nr1 = reference(x, wq, wk, wv, alpha, beta)\nr2 = method_with_lerp(x, wq, wk, wv, alpha, beta)\n\ndiff = (r1 - r2).abs()\ntol = 3e-5 + 3e-4 * r1.abs()\nviolations = (diff > tol).sum().item()\nprint(f'Max diff: {diff.max():.2e}')\nprint(f'Max rel diff: {(diff / r1.abs().clamp_min(1e-10).max():.2e}')\nprint(f'Violations: {violations} / {r1.numel()}')\nprint(f'Max diff vs tol: {(diff - tol).max():.2e}')\n\n# Try more cases\nprint()\nprint('Testing multiple alphas and seeds')\nfor seed in [0, 1, 2:\n    torch.manual_seed(seed)\n    for a in [0.1, 0.5, 0.9]:\n        for b in [0.2, 0.5, 0.8]:\n            x = torch.randn(B, L, C)\n            wq = torch.randn(H, D, C)\n            wk = torch.randn(H, D, C)\n            wv = torch.randn(H, D, C)\n            r1 = reference(x, wq, wk, wv, a, b)\n            r2 = method_with_lerp(x, wq, wk, wv, a, b)\n            diff = (r1 - r2).abs()\n            tol = 3e-5 + 3e-4 * r1.abs()\n            max_viol = (diff - tol).max().item()\n            if max_viol > 0:\n                print(f'  seed={seed} alpha={a} beta={b}: max viol={diff.max():.2e} viol_count={(diff>tol).sum().item()}')\nprint('Done.')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

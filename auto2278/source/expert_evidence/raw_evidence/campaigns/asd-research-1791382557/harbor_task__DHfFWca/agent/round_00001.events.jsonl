{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/sh -lc 'cd /workspace && python -c \"\nimport torch, math, time\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 128, 640, 10, 64\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C) / math.sqrt(C)\nwk = torch.randn(H, D, C) / math.sqrt(C)\nwv = torch.randn(H, D, C) / math.sqrt(C)\nalpha, beta = 1.1, 4.0\n\nwith torch.inference_mode():\n    # Full optimized version v2\n    # Key ideas:\n    # 1. Reshaped matmul for Q/K projections (faster than einsum)\n    # 2. Fused blend: p_blend = (1-beta)*p0 + beta*p1, then one matmul for blended\n    # 3. Compute modified norm efficiently\n    # 4. Better memory layout for final projection\n    \n    # Wait, we still need modified for the norm. \n    # But what if we compute modified norm as ||p1 @ x|| = sqrt(sum over tokens of (p1@x)[b,h,l,:]''^2)\n    # = sqrt(diag((p1@x) @ (p1@x).T)) = sqrt(diag(p1 @ x @ x.T @ p1.T))\n    # That'\"'s more expensive...\n    \n    # Let's try the approach of: \n    # - compute base = p0 @ x\n    # - compute p_diff = p1 - p0\n    # - compute diff = p_diff @ x  \n    # - modified = base + diff\n    # - blended = base + beta * diff\n    # This still has 2 matmuls but one is on a difference matrix\n    # Actually p_diff @ x is same cost as p1 @ x since it's same shape\n    \n    # Better idea: do both p0 and p1 matmul as a single batched op?\n    # Stack p0 and p1 -> (B, 2, H, L, L) -> (B*2*H, L, L) \n    # Stack x twice -> (B*2*H, L, C)\n    # bmm -> (B*2*H, L, C) -> reshape back\n    # This is 2 matmuls either way, but might have better cache behavior\n    \n    q = (x.reshape(B*L, C) @ wq.reshape(H*D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (x.reshape(B*L, C) @ wk.reshape(H*D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    logits = (q @ k.transpose(-1, -2)) / math.sqrt(D)\n    p0 = logits.softmax(dim=-1)\n    a_plus = 0.5 * (1 + alpha)\n    a_minus = 0.5 * (1 - alpha)\n    perturbed = a_plus * logits + a_minus * logits.transpose(-1, -2)\n    p1 = perturbed.softmax(dim=-1)\n    \n    # Stack approach\n    def stacked_attention():\n        p_stack = torch.stack([p0, p1], dim=1)  # (B, 2, H, L, L)\n        p_stack = p_stack.reshape(B * 2 * H, L, L)\n        x_stack = x.unsqueeze(1).unsqueeze(1).expand(B, 2, H, L, C).reshape(B * 2 * H, L, C)\n        out_stack = torch.bmm(p_stack, x_stack)\n        out_stack = out_stack.reshape(B, 2, H, L, C)\n        return out_stack[:, 0], out_stack[:, 1]  # base, modified\n    \n    # Two broadcast matmuls\n    def two_matmuls():\n        base = p0 @ x.unsqueeze(1)\n        modified = p1 @ x.unsqueeze(1)\n        return base, modified\n    \n    def time_fn(name, fn, n=11):\n        for _ in range(3): fn()\n        t0 = time.process_time_ns()\n        for _ in range(n): fn()\n        t1 = time.process_time_ns()\n        print(f'{name}: {(t1-t0)/n/1e6:.3f} ms')\n    \n    time_fn('two broadcast matmuls', two_matmuls)\n    time_fn('stacked bmm', stacked_attention)\n    \n    b1, m1 = two_matmuls()\n    b2, m2 = stacked_attention()\n    print(f'base diff: {(b1-b2).abs().max():.6e}')\n    print(f'modified diff: {(m1-m2).abs().max():.6e}')\n    \n    # Also test: compute in-place to save memory\n    # p_blend = p0 (reuse memory)\n    # blend in-place\n    def inplace_blend():\n        p_blend = p0.clone()\n        p_blend.lerp_(p1, beta)  # (1-beta)*p0 + beta*p1\n        blended = p_blend @ x.unsqueeze(1)\n        return blended\n    \n    # But we still need modified for the norm...\n    \n    # What about this: we need ||modified||. \n    # modified = p1 @ x\n    # ||modified||_2 per position = [REDACTED_SECRET] (modified[b,h,l,c])\"'^2)\n    # If we compute modified = p1 @ x, we get the full (B,H,L,C) tensor.\n    # There'\"'s no shortcut that's faster on CPU.\n    \n    # Let me try another approach: instead of p0 @ x.unsqueeze(1), \n    # reshape x to (B*H, L, C) and use bmm with reshaped p0\n    def bmm_approach():\n        p0_r = p0.reshape(B*H, L, L)\n        p1_r = p1.reshape(B*H, L, L)\n        x_r = x.unsqueeze(1).expand(B, H, L, C).reshape(B*H, L, C)\n        base = torch.bmm(p0_r, x_r).reshape(B, H, L, C)\n        modified = torch.bmm(p1_r, x_r).reshape(B, H, L, C)\n        return base, modified\n    \n    time_fn('bmm approach (expand x)', bmm_approach)\n    b3, m3 = bmm_approach()\n    print(f'bmm base diff: {(b1-b3).abs().max():.6e}')\n    print(f'bmm modified diff: {(m1-m3).abs().max():.6e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

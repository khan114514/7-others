{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python -c \\\"\nimport torch, math, time\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 128, 640, 10, 64\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C) / math.sqrt(C)\nwk = torch.randn(H, D, C) / math.sqrt(C)\nwv = torch.randn(H, D, C) / math.sqrt(C)\nalpha, beta = 1.1, 4.0\n\nwith torch.inference_mode():\n    # Correct broadcast approach:\n    # x: (B, L, C) unsqueeze(1) -> (B, 1, L, C)\n    # wq: (H, D, C) transpose(-1,-2) -> (H, C, D) unsqueeze(0) -> (1, H, C, D)\n    # result: (B, H, L, D)\n    q_ref = torch.einsum('blc,hdc->bhld', x, wq)\n    \n    # Method 1: x.unsqueeze(1) @ wq.mT  (broadcast over H)\n    q1 = x.unsqueeze(1) @ wq.mT  # (B,1,L,C) @ (H,C,D) -> (B,H,L,D)\n    print(f'broadcast matmul diff: {(q_ref - q1).abs().max():.6e}')\n    \n    # Method 2: reshape matmul\n    q2 = (x.reshape(B*L, C) @ wq.reshape(H*D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    print(f'reshaped matmul diff: {(q_ref - q2).abs().max():.6e}')\n    \n    def time_fn(name, fn, n=20):\n        for _ in range(3): fn()\n        t0 = time.process_time_ns()\n        for _ in range(n): fn()\n        t1 = time.process_time_ns()\n        print(f'{name}: {(t1-t0)/n/1e6:.3f} ms')\n    \n    time_fn('einsum q', lambda: torch.einsum('blc,hdc->bhld', x, wq))\n    time_fn('broadcast q', lambda: x.unsqueeze(1) @ wq.mT)\n    time_fn('reshaped q', lambda: (x.reshape(B*L, C) @ wq.reshape(H*D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous())\n    \n    # Also test the p0 @ x step\n    q = torch.einsum('blc,hdc->bhld', x, wq)\n    k = torch.einsum('blc,hdc->bhld', x, wk)\n    logits = (q @ k.transpose(-1, -2)) / math.sqrt(D)\n    p0 = logits.softmax(dim=-1)\n    \n    # p0: (B, H, L, L), x: (B, L, C)\n    # p0 @ x.unsqueeze(1) -> (B, H, L, C)\n    base_ref = p0 @ x.unsqueeze(1)\n    \n    # Alternative: reshape p0 to (B*H, L, L), x expand to (B*H, L, C), bmm\n    base1 = torch.bmm(p0.reshape(B*H, L, L), x.unsqueeze(1).expand(B, H, L, C).reshape(B*H, L, C))\n    base1 = base1.reshape(B, H, L, C)\n    print(f'bmm base diff: {(base_ref - base1).abs().max():.6e}')\n    \n    time_fn('p0@x (broadcast)', lambda: p0 @ x.unsqueeze(1))\n    time_fn('p0@x (bmm)', lambda: torch.bmm(p0.reshape(B*H, L, L), x.unsqueeze(1).expand(B, H, L, C).reshape(B*H, L, C)).reshape(B, H, L, C))\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python -c \\\"\nimport torch, math, time\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 128, 640, 10, 64\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C) / math.sqrt(C)\nwk = torch.randn(H, D, C) / math.sqrt(C)\nwv = torch.randn(H, D, C) / math.sqrt(C)\nalpha, beta = 1.1, 4.0\n\nwith torch.inference_mode():\n    # Correct broadcast approach:\n    # x: (B, L, C) unsqueeze(1) -> (B, 1, L, C)\n    # wq: (H, D, C) transpose(-1,-2) -> (H, C, D) unsqueeze(0) -> (1, H, C, D)\n    # result: (B, H, L, D)\n    q_ref = torch.einsum('blc,hdc->bhld', x, wq)\n    \n    # Method 1: x.unsqueeze(1) @ wq.mT  (broadcast over H)\n    q1 = x.unsqueeze(1) @ wq.mT  # (B,1,L,C) @ (H,C,D) -> (B,H,L,D)\n    print(f'broadcast matmul diff: {(q_ref - q1).abs().max():.6e}')\n    \n    # Method 2: reshape matmul\n    q2 = (x.reshape(B*L, C) @ wq.reshape(H*D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n    print(f'reshaped matmul diff: {(q_ref - q2).abs().max():.6e}')\n    \n    def time_fn(name, fn, n=20):\n        for _ in range(3): fn()\n        t0 = time.process_time_ns()\n        for _ in range(n): fn()\n        t1 = time.process_time_ns()\n        print(f'{name}: {(t1-t0)/n/1e6:.3f} ms')\n    \n    time_fn('einsum q', lambda: torch.einsum('blc,hdc->bhld', x, wq))\n    time_fn('broadcast q', lambda: x.unsqueeze(1) @ wq.mT)\n    time_fn('reshaped q', lambda: (x.reshape(B*L, C) @ wq.reshape(H*D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous())\n    \n    # Also test the p0 @ x step\n    q = torch.einsum('blc,hdc->bhld', x, wq)\n    k = torch.einsum('blc,hdc->bhld', x, wk)\n    logits = (q @ k.transpose(-1, -2)) / math.sqrt(D)\n    p0 = logits.softmax(dim=-1)\n    \n    # p0: (B, H, L, L), x: (B, L, C)\n    # p0 @ x.unsqueeze(1) -> (B, H, L, C)\n    base_ref = p0 @ x.unsqueeze(1)\n    \n    # Alternative: reshape p0 to (B*H, L, L), x expand to (B*H, L, C), bmm\n    base1 = torch.bmm(p0.reshape(B*H, L, L), x.unsqueeze(1).expand(B, H, L, C).reshape(B*H, L, C))\n    base1 = base1.reshape(B, H, L, C)\n    print(f'bmm base diff: {(base_ref - base1).abs().max():.6e}')\n    \n    time_fn('p0@x (broadcast)', lambda: p0 @ x.unsqueeze(1))\n    time_fn('p0@x (bmm)', lambda: torch.bmm(p0.reshape(B*H, L, L), x.unsqueeze(1).expand(B, H, L, C).reshape(B*H, L, C)).reshape(B, H, L, C))\n\\\"\n\"","aggregated_output":"broadcast matmul diff: 0.000000e+00\nreshaped matmul diff: 0.000000e+00\neinsum q: 3.807 ms\nbroadcast q: 2.786 ms\nreshaped q: 1.813 ms\nbmm base diff: 0.000000e+00\np0@x (broadcast): 5.045 ms\np0@x (bmm): 9.815 ms\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python -c \\\"\nimport torch, math, time\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 128, 640, 10, 64\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C) / math.sqrt(C)\nwk = torch.randn(H, D, C) / math.sqrt(C)\nwv = torch.randn(H, D, C) / math.sqrt(C)\nalpha, beta = 1.1, 4.0\n\nwith torch.inference_mode():\n    # Let's test a full optimized version\n    # Key ideas:\n    # 1. Replace einsum with reshaped matmul for q,k,v projections\n    # 2. Fuse operations where possible\n    # 3. Avoid unnecessary contiguous calls\n    \n    @torch.no_grad()\n    def attention_opt(x, wq, wk, wv, alpha, beta):\n        B, L, C = x.shape\n        H, D = wq.shape[:2]\n        \n        # Reshape for efficient matmul: (B*L, C) @ (H*D, C).T -> (B*L, H*D)\n        x_bl = x.reshape(B * L, C)\n        wq_hd = wq.reshape(H * D, C)\n        wk_hd = wk.reshape(H * D, C)\n        wv_hd = wv.reshape(H * D, C)\n        \n        q = (x_bl @ wq_hd.T).reshape(B, L, H, D).permute(0, 2, 1, 3)  # (B, H, L, D)\n        k = (x_bl @ wk_hd.T).reshape(B, L, H, D).permute(0, 2, 1, 3)  # (B, H, L, D)\n        \n        logits = (q @ k.transpose(-1, -2)) / math.sqrt(D)\n        p0 = logits.softmax(dim=-1)\n        base = p0 @ x.unsqueeze(1)  # (B, H, L, C)\n        \n        if alpha == 1.0:\n            modified = base\n        else:\n            a_plus = 0.5 * (1 + alpha)\n            a_minus = 0.5 * (1 - alpha)\n            perturbed = a_plus * logits + a_minus * logits.transpose(-1, -2)\n            modified = perturbed.softmax(dim=-1) @ x.unsqueeze(1)\n        \n        blended = base + beta * (modified - base)\n        ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n                 / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n        \n        # (B, H, L, C) * (B, H, L, 1) -> (B, H, L, C)\n        # Project: (B, H, L, C) @ (H, D, C).T -> (B, H, L, D)\n        # Use reshaped matmul again\n        scaled = (blended * ratio).permute(0, 2, 1, 3).reshape(B * L, H * C)  # (B*L, H*C)\n        # wv is (H, D, C), we need per-head projection\n        # Reshape to (B*L*H, C) @ (H*D, C).T ... no, each head has its own wv\n        # Better: (B, H, L, C) -> (B*H, L, C) @ (H*D, C).T reshaped per-head\n        # Actually: for each head h: (B, L, C) @ (D, C).T = (B, L, D)\n        # Let's do: (B*H, L, C) @ (C, D) per head...\n        \n        # Simple approach: use the broadcast matmul\n        y = (blended * ratio) @ wv.mT  # (B,H,L,C) @ (H,C,D) -> (B,H,L,D)\n        \n        return y.transpose(1, 2).flatten(2).contiguous()\n    \n    @torch.no_grad()\n    def attention_ref(x, wq, wk, wv, alpha, beta):\n        q = torch.einsum('blc,hdc->bhld', x, wq)\n        k = torch.einsum('blc,hdc->bhld', x, wk)\n        logits = (q @ k.transpose(-1, -2)) / math.sqrt(wq.shape[1])\n        p0 = logits.softmax(dim=-1)\n        base = p0 @ x.unsqueeze(1)\n        if alpha == 1.0:\n            modified = base\n        else:\n            perturbed = .5 * (1 + alpha) * logits + .5 * (1 - alpha) * logits.transpose(-1, -2)\n            modified = perturbed.softmax(dim=-1) @ x.unsqueeze(1)\n        blended = base + beta * (modified - base)\n        ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n                 / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n        y = torch.einsum('bhlc,hdc->bhld', blended * ratio, wv)\n        return y.transpose(1, 2).flatten(2).contiguous()\n    \n    # Verify correctness\n    out_ref = attention_ref(x, wq, wk, wv, alpha, beta)\n    out_opt = attention_opt(x, wq, wk, wv, alpha, beta)\n    print(f'Correctness check: max diff = {(out_ref - out_opt).abs().max():.6e}')\n    print(f'Shapes: ref={out_ref.shape}, opt={out_opt.shape}')\n    \n    # Time both\n    def time_fn(name, fn, n=11):\n        for _ in range(3): fn()\n        t0 = time.process_time_ns()\n        for _ in range(n): fn()\n        t1 = time.process_time_ns()\n        print(f'{name}: {(t1-t0)/n/1e6:.3f} ms')\n    \n    time_fn('reference', lambda: attention_ref(x, wq, wk, wv, alpha, beta))\n    time_fn('optimized', lambda: attention_opt(x, wq, wk, wv, alpha, beta))\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

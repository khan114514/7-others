{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python -c \\\"\nimport torch, math, time\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 128, 640, 10, 64\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C) / math.sqrt(C)\nwk = torch.randn(H, D, C) / math.sqrt(C)\nwv = torch.randn(H, D, C) / math.sqrt(C)\nalpha, beta = 1.1, 4.0\n\nwith torch.inference_mode():\n    # Setup intermediate tensors\n    x_bl = x.reshape(B * L, C)\n    wq_hd = wq.reshape(H * D, C)\n    wk_hd = wk.reshape(H * D, C)\n    q = (x_bl @ wq_hd.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (x_bl @ wk_hd.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    logits = (q @ k.transpose(-1, -2)) / math.sqrt(D)\n    p0 = logits.softmax(dim=-1)\n    a_plus = 0.5 * (1 + alpha)\n    a_minus = 0.5 * (1 - alpha)\n    perturbed = a_plus * logits + a_minus * logits.transpose(-1, -2)\n    p1 = perturbed.softmax(dim=-1)\n    \n    base = p0 @ x.unsqueeze(1)  # (B, H, L, C)\n    modified = p1 @ x.unsqueeze(1)\n    blended = base + beta * (modified - base)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    scaled = blended * ratio  # (B, H, L, C)\n    \n    # Test wv projection strategies\n    # 1. einsum\n    y1 = torch.einsum('bhlc,hdc->bhld', scaled, wv)\n    \n    # 2. broadcast matmul\n    y2 = scaled @ wv.mT  # (B,H,L,C) @ (H,C,D) -> (B,H,L,D)\n    print(f'broadcast wv diff: {(y1-y2).abs().max():.6e}')\n    \n    # 3. reshaped approach: (B*H*L, C) @ (C, H*D)? No, per-head weights\n    # Actually: scaled (B,H,L,C) -> (B*H, L, C) \n    # wv (H,D,C) -> (H,C,D) -> (H,C,D)\n    # We need per-head matmul\n    # (B*H, L, C) bmm (B*H, C, D) -> but wv is shared across batch\n    # Better: (B*H, L, C) @ (C, D) per head... no different weights per head\n    \n    # 4. reshape to (B*H, L, C) and use bmm with (H, C, D) broadcast?\n    # No, bmm doesn't broadcast. Let's try unfolded approach\n    # (B*H, L, C) @ (C, D) - but each head has different D...\n    # Actually D is same for all heads, but weight matrix differs\n    \n    # Try: reshape scaled to (B*H, L*C), wv to (H*D, C)...\n    # We want: out[b,h,l,d] = sum_c scaled[b,h,l,c] * wv[h,d,c]\n    # Reshape scaled: (B, H, L, C) -> (B, L, H, C) -> (B*L, H*C)\n    # wv: (H, D, C) -> can we make a block-diagonal? No, that's huge\n    \n    # 5. Use view and loop over heads? No, that would be slower.\n    \n    def time_fn(name, fn, n=20):\n        for _ in range(3): fn()\n        t0 = time.process_time_ns()\n        for _ in range(n): fn()\n        t1 = time.process_time_ns()\n        print(f'{name}: {(t1-t0)/n/1e6:.3f} ms')\n    \n    time_fn('einsum wv', lambda: torch.einsum('bhlc,hdc->bhld', scaled, wv))\n    time_fn('broadcast wv', lambda: scaled @ wv.mT)\n    \n    # Also test: what if we do per-head with bmm?\n    def wv_bmm():\n        s = scaled.reshape(B*H, L, C)  # (B*H, L, C)\n        w = wv.mT.unsqueeze(0).expand(B, H, C, D).reshape(B*H, C, D)  # (B*H, C, D)\n        return torch.bmm(s, w).reshape(B, H, L, D)\n    time_fn('bmm wv', lambda: wv_bmm())\n    print(f'bmm wv diff: {(y1-wv_bmm()).abs().max():.6e}')\n    \n    # What about transposing scaled for better memory layout?\n    # scaled is (B, H, L, C) -> transpose to (B, L, H, C) contiguous\n    def wv_reshaped():\n        # (B, H, L, C) -> (B, L, H, C) -> (B*L, H, C)\n        s = scaled.transpose(1, 2).contiguous().reshape(B*L, H, C)\n        # wv: (H, D, C) -> (H, C, D)\n        w = wv.transpose(-1, -2)\n        # (B*L, H, C) @ (H, C, D) -> (B*L, H, D) via batched matmul\n        return torch.bmm(s, w).reshape(B, L, H, D)\n    y3 = wv_reshaped()\n    y3_ref = y1.transpose(1, 2)  # (B, L, H, D)\n    print(f'reshaped wv diff: {(y3_ref - y3).abs().max():.6e}')\n    time_fn('reshaped bmm wv', lambda: wv_reshaped())\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python -c \\\"\nimport torch, math, time\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 128, 640, 10, 64\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C) / math.sqrt(C)\nwk = torch.randn(H, D, C) / math.sqrt(C)\nwv = torch.randn(H, D, C) / math.sqrt(C)\nalpha, beta = 1.1, 4.0\n\nwith torch.inference_mode():\n    # Let's think about another optimization:\n    # We have p0 and p1, both (B,H,L,L) attention matrices\n    # base = p0 @ x, modified = p1 @ x\n    # blended = base + beta*(modified - base) = (1-beta)*base + beta*modified\n    # = (1-beta)*p0@x + beta*p1@x = ((1-beta)*p0 + beta*p1) @ x\n    # This fuses two matmuls into one\"'!\n    \n    x_bl = x.reshape(B * L, C)\n    wq_hd = wq.reshape(H * D, C)\n    wk_hd = wk.reshape(H * D, C)\n    q = (x_bl @ wq_hd.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (x_bl @ wk_hd.T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    logits = (q @ k.transpose(-1, -2)) / math.sqrt(D)\n    p0 = logits.softmax(dim=-1)\n    a_plus = 0.5 * (1 + alpha)\n    a_minus = 0.5 * (1 - alpha)\n    perturbed = a_plus * logits + a_minus * logits.transpose(-1, -2)\n    p1 = perturbed.softmax(dim=-1)\n    \n    # Approach 1: two separate matmuls\n    t0 = time.process_time_ns()\n    for _ in range(11):\n        base = p0 @ x.unsqueeze(1)\n        modified = p1 @ x.unsqueeze(1)\n        blended = base + beta * (modified - base)\n    t1 = time.process_time_ns()\n    print(f'\"'Two matmuls + blend: {(t1-t0)/11/1e6:.3f} ms')\n    \n    # Approach 2: fused matmul\n    t0 = time.process_time_ns()\n    for _ in range(11):\n        p_blend = (1 - beta) * p0 + beta * p1\n        blended2 = p_blend @ x.unsqueeze(1)\n    t1 = time.process_time_ns()\n    print(f'Fused p_blend + one matmul: {(t1-t0)/11/1e6:.3f} ms')\n    \n    base = p0 @ x.unsqueeze(1)\n    modified = p1 @ x.unsqueeze(1)\n    blended_ref = base + beta * (modified - base)\n    p_blend = (1 - beta) * p0 + beta * p1\n    blended2 = p_blend @ x.unsqueeze(1)\n    print(f'Blend diff: {(blended_ref - blended2).abs().max():.6e}')\n    \n    # Hmm, but we still need 'modified' for the ratio computation...\n    # Let's check if we can compute modified norm from something else\n    # ratio = ||modified|| / ||blended||, and we need modified for that\n    # So we can't completely avoid computing modified\n    \n    # But we could compute only the norm of modified without the full matrix?\n    # No, ||p1 @ x|| is not easily computable from p1 alone\n    \n    # Wait: we need:\n    # - modified = p1 @ x (full matrix, for ratio numerator norm)\n    # - blended = (1-beta)*p0@x + beta*p1@x (full matrix, for output)\n    # We need both full matrices. So we still need 2 matmuls.\n    \n    # But what if we do:\n    # base = p0 @ x\n    # diff = (p1 - p0) @ x   [one matmul on diff matrix]\n    # modified = base + diff\n    # blended = base + beta * diff\n    \n    t0 = time.process_time_ns()\n    for _ in range(11):\n        base = p0 @ x.unsqueeze(1)\n        diff = (p1 - p0) @ x.unsqueeze(1)\n        modified = base + diff\n        blended3 = base + beta * diff\n    t1 = time.process_time_ns()\n    print(f'Base + diff approach: {(t1-t0)/11/1e6:.3f} ms')\n    \n    print(f'Diff approach correctness (modified): {(modified - (base + diff)).abs().max():.6e}')\n    print(f'Diff approach correctness (blended): {(blended_ref - (base + beta*diff)).abs().max():.6e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

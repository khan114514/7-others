{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python -c \\\"\nimport torch, math, time\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n# Test case 1 in detail: B=1, L=128, C=640, H=10, D=64\nB, L, C, H, D = 1, 128, 640, 10, 64\nx = torch.randn(B, L, C)\np0 = torch.randn(B, H, L, L).softmax(dim=-1)\n\nwith torch.inference_mode():\n    # Method 1: broadcast matmul\n    def m1():\n        return p0 @ x.unsqueeze(1)\n    \n    # Method 2: bmm with expand + reshape (may be non-contiguous)\n    def m2():\n        x_exp = x.unsqueeze(1).expand(B, H, L, C).reshape(B * H, L, C)\n        return torch.bmm(p0.reshape(B*H, L, L), x_exp).reshape(B, H, L, C)\n    \n    # Method 3: bmm with expand + reshape + contiguous\n    def m3():\n        x_exp = x.unsqueeze(1).expand(B, H, L, C).reshape(B * H, L, C).contiguous()\n        return torch.bmm(p0.reshape(B*H, L, L), x_exp).reshape(B, H, L, C)\n    \n    # Method 4: bmm with repeat (definitely contiguous)\n    def m4():\n        x_exp = x.unsqueeze(1).repeat(1, H, 1, 1).reshape(B * H, L, C)\n        return torch.bmm(p0.reshape(B*H, L, L), x_exp).reshape(B, H, L, C)\n    \n    # Check contiguity\n    x_exp1 = x.unsqueeze(1).expand(B, H, L, C).reshape(B * H, L, C)\n    print(f'expand+reshape contiguous: {x_exp1.is_contiguous()}')\n    x_exp2 = x.unsqueeze(1).expand(B, H, L, C).reshape(B * H, L, C).contiguous()\n    print(f'expand+reshape+contig contiguous: {x_exp2.is_contiguous()}')\n    x_exp3 = x.unsqueeze(1).repeat(1, H, 1, 1).reshape(B * H, L, C)\n    print(f'repeat contiguous: {x_exp3.is_contiguous()}')\n    \n    def time_fn(name, fn, n=20):\n        for _ in range(5): fn()\n        t0 = time.process_time_ns()\n        for _ in range(n): fn()\n        t1 = time.process_time_ns()\n        print(f'{name}: {(t1-t0)/n/1e6:.3f} ms')\n    \n    time_fn('broadcast matmul', m1)\n    time_fn('bmm (expand+reshape)', m2)\n    time_fn('bmm (expand+reshape+contig)', m3)\n    time_fn('bmm (repeat)', m4)\n    \n    # Verify correctness\n    r1 = m1()\n    r2 = m2()\n    r3 = m3()\n    r4 = m4()\n    print(f'diff 1-2: {(r1-r2).abs().max():.2e}')\n    print(f'diff 1-3: {(r1-r3).abs().max():.2e}')\n    print(f'diff 1-4: {(r1-r4).abs().max():.2e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

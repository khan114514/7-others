{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python -c \\\"\nimport torch, math, time\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n# Test multiple case sizes\ncases = [\n    (1, 64, 512, 8, 64),\n    (1, 128, 640, 10, 64),\n    (1, 128, 1280, 20, 64),\n    (1, 256, 1280, 20, 64),\n    (1, 256, 640, 10, 64),\n    (2, 128, 512, 8, 64),\n]\n\nfor B, L, C, H, D in cases:\n    x = torch.randn(B, L, C)\n    wq = torch.randn(H, D, C) / math.sqrt(C)\n    wk = torch.randn(H, D, C) / math.sqrt(C)\n    wv = torch.randn(H, D, C) / math.sqrt(C)\n    alpha, beta = 1.1, 4.0\n    \n    with torch.inference_mode():\n        # Benchmark: combined QK projection\n        def bench_combined_qk():\n            # Concatenate wq and wk: (2*H, D, C)\n            wqk = torch.cat([wq, wk], dim=0)  # (2H, D, C)\n            wqk_flat = wqk.reshape(2 * H * D, C)\n            x_bl = x.reshape(B * L, C)\n            qk = x_bl @ wqk_flat.T  # (B*L, 2*H*D)\n            qk = qk.reshape(B, L, 2 * H, D).permute(0, 2, 1, 3)  # (B, 2H, L, D)\n            q, k = qk[:, :H], qk[:, H:]\n            return q, k\n        \n        def bench_separate_qk():\n            x_bl = x.reshape(B * L, C)\n            q = (x_bl @ wq.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n            k = (x_bl @ wk.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3)\n            return q, k\n        \n        for _ in range(3): bench_combined_qk()\n        for _ in range(3): bench_separate_qk()\n        \n        t0 = time.process_time_ns()\n        for _ in range(11): bench_separate_qk()\n        t_sep = (time.process_time_ns() - t0) / 11 / 1e6\n        \n        t0 = time.process_time_ns()\n        for _ in range(11): bench_combined_qk()\n        t_comb = (time.process_time_ns() - t0) / 11 / 1e6\n        \n        q1, k1 = bench_separate_qk()\n        q2, k2 = bench_combined_qk()\n        dq = (q1-q2).abs().max()\n        dk = (k1-k2).abs().max()\n        \n        print(f'B={B} L={L} C={C} H={H} D={D}: sep={t_sep:.2f}ms comb={t_comb:.2f}ms dq={dq:.1e} dk={dk:.1e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

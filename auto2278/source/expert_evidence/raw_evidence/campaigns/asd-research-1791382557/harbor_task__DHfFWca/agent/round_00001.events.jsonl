(20):\n        q3 = (x.unsqueeze(1) @ wq.transpose(-1, -2)).transpose(1, 2)\n    t1 = time.process_time_ns()\n    print(f'broadcast matmul q: {(t1-t0)/20/1e6:.3f} ms')\n    print(f'Max diff: {(q1-q3).abs().max():.6e}')\n\\\"\n\"","aggregated_output":"Traceback (most recent call last):\n  File \"<string>\", line 55, in <module>\nRuntimeError: The size of tensor a (128) must match the size of tensor b (10) at non-singleton dimension 2\neinsum q: 3.546 ms\nreshaped matmul q: 1.666 ms\nMax diff: 0.000000e+00\nbroadcast matmul q: 1.775 ms\n","exit_code":1,"status":"failed"}}

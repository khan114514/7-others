        dk = (k1-k2).abs().max()\n        \n        print(f'B={B} L={L} C={C} H={H} D={D}: sep={t_sep:.2f}ms comb={t_comb:.2f}ms dq={dq:.1e} dk={dk:.1e}')\n\\\"\n\"","aggregated_output":"B=1 L=64 C=512 H=8 D=64: sep=1.30ms comb=1.86ms dq=0.0e+00 dk=0.0e+00\nB=1 L=128 C=640 H=10 D=64: sep=3.63ms comb=5.97ms dq=0.0e+00 dk=0.0e+00\nB=1 L=128 C=1280 H=20 D=64: sep=14.80ms comb=15.60ms dq=0.0e+00 dk=0.0e+00\nB=1 L=256 C=1280 H=20 D=64: sep=28.11ms comb=32.41ms dq=0.0e+00 dk=0.0e+00\nB=1 L=256 C=640 H=10 D=64: sep=6.59ms comb=6.17ms dq=0.0e+00 dk=0.0e+00\nB=2 L=128 C=512 H=8 D=64: sep=4.36ms comb=4.45ms dq=0.0e+00 dk=0.0e+00\n","exit_code":0,"status":"completed"}}

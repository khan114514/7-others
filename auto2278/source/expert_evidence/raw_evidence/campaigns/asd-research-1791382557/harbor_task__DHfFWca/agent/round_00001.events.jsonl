{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python -c \\\"\nimport torch, math, time\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 128, 640, 10, 64\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C) / math.sqrt(C)\nwk = torch.randn(H, D, C) / math.sqrt(C)\nwv = torch.randn(H, D, C) / math.sqrt(C)\nalpha, beta = 1.1, 4.0\n\n# Compare einsum vs reshaped matmul for q projection\nwith torch.inference_mode():\n    # Warmup\n    for _ in range(5):\n        q1 = torch.einsum('blc,hdc->bhld', x, wq)\n    \n    t0 = time.process_time_ns()\n    for _ in range(20):\n        q1 = torch.einsum('blc,hdc->bhld', x, wq)\n    t1 = time.process_time_ns()\n    print(f'einsum q: {(t1-t0)/20/1e6:.3f} ms')\n\n    # Reshaped matmul approach: x:(B,L,C) -> (B*L, C), wq:(H,D,C)->(H*D, C)\n    # result: (B*L, H*D) -> (B,L,H,D) -> (B,H,L,D)\n    for _ in range(5):\n        q2 = x.reshape(B*L, C) @ wq.reshape(H*D, C).T\n        q2 = q2.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    \n    t0 = time.process_time_ns()\n    for _ in range(20):\n        q2 = x.reshape(B*L, C) @ wq.reshape(H*D, C).T\n        q2 = q2.reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    t1 = time.process_time_ns()\n    print(f'reshaped matmul q: {(t1-t0)/20/1e6:.3f} ms')\n    print(f'Max diff: {(q1-q2).abs().max():.6e}')\n\n    # Another approach: unfold x to 4D and use bmm\n    # x: (B, L, C) unsqueeze(1) -> (B, 1, L, C) expand to (B, H, L, C)\n    # wq: (H, D, C) -> (H, C, D)\n    # Then batch matmul (B*H, L, C) @ (B*H, C, D) = (B*H, L, D)\n    for _ in range(5):\n        xh = x.unsqueeze(1).expand(B, H, L, C).reshape(B*H, L, C)\n        q3 = xh @ wq.reshape(H*D, C).T.reshape(B*H, C, D)  # wait this isn't right\n        # Actually need per-head matmul\n        q3 = (x.unsqueeze(1) @ wq.transpose(-1, -2)).transpose(1, 2)  # (B,H,L,D)\n    \n    t0 = time.process_time_ns()\n    for _ in range(20):\n        q3 = (x.unsqueeze(1) @ wq.transpose(-1, -2)).transpose(1, 2)\n    t1 = time.process_time_ns()\n    print(f'broadcast matmul q: {(t1-t0)/20/1e6:.3f} ms')\n    print(f'Max diff: {(q1-q3).abs().max():.6e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

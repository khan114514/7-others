{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python -c \\\"\nimport torch, math, time\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n# Test all cases\ncases = [\n    (1, 64, 512, 8, 64, 1.05, 5.0),\n    (1, 128, 640, 10, 64, 1.1, 4.0),\n    (1, 128, 1280, 20, 64, 1.15, 3.0),\n    (1, 256, 1280, 20, 64, 1.05, 7.5),\n    (1, 256, 640, 10, 64, 1.2, 5.0),\n    (2, 128, 512, 8, 64, 1.0, 5.0),\n]\n\n@torch.no_grad()\ndef attention_ref(x, wq, wk, wv, alpha, beta):\n    q = torch.einsum('blc,hdc->bhld', x, wq)\n    k = torch.einsum('blc,hdc->bhld', x, wk)\n    logits = (q @ k.transpose(-1, -2)) / math.sqrt(wq.shape[1])\n    p0 = logits.softmax(dim=-1)\n    base = p0 @ x.unsqueeze(1)\n    if alpha == 1.0:\n        modified = base\n    else:\n        perturbed = .5 * (1 + alpha) * logits + .5 * (1 - alpha) * logits.transpose(-1, -2)\n        modified = perturbed.softmax(dim=-1) @ x.unsqueeze(1)\n    blended = base + beta * (modified - base)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    y = torch.einsum('bhlc,hdc->bhld', blended * ratio, wv)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n@torch.no_grad()\ndef attention_opt(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[:2]\n    \n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    x_bl = x.reshape(B * L, C)\n    \n    # Q, K projections via reshaped matmul\n    q = (x_bl @ wq.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (x_bl @ wk.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    \n    # Attention logits\n    logits = (q @ k.transpose(-1, -2)) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    \n    if alpha == 1.0:\n        modified_bmm = None  # won't be used\n        blended_bmm = p0.reshape(B * H, L, L)\n        modified_norm = None\n    else:\n        a_plus = 0.5 * (1.0 + alpha)\n        a_minus = 0.5 * (1.0 - alpha)\n        perturbed = a_plus * logits + a_minus * logits.transpose(-1, -2)\n        p1 = perturbed.softmax(dim=-1)\n        \n        # Reshape for bmm\n        p0_r = p0.reshape(B * H, L, L)\n        p1_r = p1.reshape(B * H, L, L)\n        \n        # Expand x for batch matmul\n        x_expanded = x.unsqueeze(1).expand(B, H, L, C).reshape(B * H, L, C)\n        \n        # Compute base and modified via bmm\n        base_bmm = torch.bmm(p0_r, x_expanded).reshape(B, H, L, C)\n        modified_bmm = torch.bmm(p1_r, x_expanded).reshape(B, H, L, C)\n        \n        blended = base_bmm + beta * (modified_bmm - base_bmm)\n        ratio = (modified_bmm.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n                 / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(0.25, 4.0)\n        scaled = blended * ratio\n        \n        # Final projection\n        y = scaled @ wv.mT\n        return y.transpose(1, 2).flatten(2).contiguous()\n    \n    # alpha == 1.0 path\n    x_expanded = x.unsqueeze(1).expand(B, H, L, C).reshape(B * H, L, C)\n    blended_bmm = torch.bmm(blended_bmm, x_expanded).reshape(B, H, L, C)\n    ratio = (blended_bmm.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended_bmm.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(0.25, 4.0)\n    scaled = blended_bmm * ratio\n    y = scaled @ wv.mT\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Test all cases\nprint('Testing correctness and speedup per case:')\nfor i, (B, L, C, H, D, alpha, beta) in enumerate(cases):\n    g = torch.Generator().manual_seed(42 + i)\n    x = torch.randn(B, L, C, generator=g)\n    wq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n    wk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n    wv = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n    \n    out_ref = attention_ref(x, wq, wk, wv, alpha, beta)\n    out_opt = attention_opt(x, wq, wk, wv, alpha, beta)\n    \n    max_diff = (out_ref - out_opt).abs().max().item()\n    \n    # Time\n    with torch.inference_mode():\n        for _ in range(3):\n            attention_ref(x, wq, wk, wv, alpha, beta)\n            attention_opt(x, wq, wk, wv, alpha, beta)\n        \n        n = 11\n        t0 = time.process_time_ns()\n        for _ in range(n):\n            attention_ref(x, wq, wk, wv, alpha, beta)\n        t_ref = (time.process_time_ns() - t0) / n / 1e6\n        \n        t0 = time.process_time_ns()\n        for _ in range(n):\n            attention_opt(x, wq, wk, wv, alpha, beta)\n        t_opt = (time.process_time_ns() - t0) / n / 1e6\n    \n    ratio = t_opt / t_ref\n    ok = 'OK' if max_diff < 3e-5 + 3e-4 * abs(out_ref.abs().max().item()) else 'FAIL'\n    print(f'  Case {i}: B={B} L={L} C={C} H={H} alpha={alpha} -> {ratio:.3f}x (max_diff={max_diff:.2e}) {ok}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python -c \\\"\nimport torch, math, time\n\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\n# Test all cases\ncases = [\n    (1, 64, 512, 8, 64, 1.05, 5.0),\n    (1, 128, 640, 10, 64, 1.1, 4.0),\n    (1, 128, 1280, 20, 64, 1.15, 3.0),\n    (1, 256, 1280, 20, 64, 1.05, 7.5),\n    (1, 256, 640, 10, 64, 1.2, 5.0),\n    (2, 128, 512, 8, 64, 1.0, 5.0),\n]\n\n@torch.no_grad()\ndef attention_ref(x, wq, wk, wv, alpha, beta):\n    q = torch.einsum('blc,hdc->bhld', x, wq)\n    k = torch.einsum('blc,hdc->bhld', x, wk)\n    logits = (q @ k.transpose(-1, -2)) / math.sqrt(wq.shape[1])\n    p0 = logits.softmax(dim=-1)\n    base = p0 @ x.unsqueeze(1)\n    if alpha == 1.0:\n        modified = base\n    else:\n        perturbed = .5 * (1 + alpha) * logits + .5 * (1 - alpha) * logits.transpose(-1, -2)\n        modified = perturbed.softmax(dim=-1) @ x.unsqueeze(1)\n    blended = base + beta * (modified - base)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    y = torch.einsum('bhlc,hdc->bhld', blended * ratio, wv)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n@torch.no_grad()\ndef attention_opt(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D = wq.shape[:2]\n    \n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    x_bl = x.reshape(B * L, C)\n    \n    # Q, K projections via reshaped matmul\n    q = (x_bl @ wq.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (x_bl @ wk.reshape(H * D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    \n    # Attention logits\n    logits = (q @ k.transpose(-1, -2)) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    \n    if alpha == 1.0:\n        modified_bmm = None  # won't be used\n        blended_bmm = p0.reshape(B * H, L, L)\n        modified_norm = None\n    else:\n        a_plus = 0.5 * (1.0 + alpha)\n        a_minus = 0.5 * (1.0 - alpha)\n        perturbed = a_plus * logits + a_minus * logits.transpose(-1, -2)\n        p1 = perturbed.softmax(dim=-1)\n        \n        # Reshape for bmm\n        p0_r = p0.reshape(B * H, L, L)\n        p1_r = p1.reshape(B * H, L, L)\n        \n        # Expand x for batch matmul\n        x_expanded = x.unsqueeze(1).expand(B, H, L, C).reshape(B * H, L, C)\n        \n        # Compute base and modified via bmm\n        base_bmm = torch.bmm(p0_r, x_expanded).reshape(B, H, L, C)\n        modified_bmm = torch.bmm(p1_r, x_expanded).reshape(B, H, L, C)\n        \n        blended = base_bmm + beta * (modified_bmm - base_bmm)\n        ratio = (modified_bmm.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n                 / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(0.25, 4.0)\n        scaled = blended * ratio\n        \n        # Final projection\n        y = scaled @ wv.mT\n        return y.transpose(1, 2).flatten(2).contiguous()\n    \n    # alpha == 1.0 path\n    x_expanded = x.unsqueeze(1).expand(B, H, L, C).reshape(B * H, L, C)\n    blended_bmm = torch.bmm(blended_bmm, x_expanded).reshape(B, H, L, C)\n    ratio = (blended_bmm.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended_bmm.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(0.25, 4.0)\n    scaled = blended_bmm * ratio\n    y = scaled @ wv.mT\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Test all cases\nprint('Testing correctness and speedup per case:')\nfor i, (B, L, C, H, D, alpha, beta) in enumerate(cases):\n    g = torch.Generator().manual_seed(42 + i)\n    x = torch.randn(B, L, C, generator=g)\n    wq = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n    wk = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n    wv = torch.randn(H, D, C, generator=g) / math.sqrt(C)\n    \n    out_ref = attention_ref(x, wq, wk, wv, alpha, beta)\n    out_opt = attention_opt(x, wq, wk, wv, alpha, beta)\n    \n    max_diff = (out_ref - out_opt).abs().max().item()\n    \n    # Time\n    with torch.inference_mode():\n        for _ in range(3):\n            attention_ref(x, wq, wk, wv, alpha, beta)\n            attention_opt(x, wq, wk, wv, alpha, beta)\n        \n        n = 11\n        t0 = time.process_time_ns()\n        for _ in range(n):\n            attention_ref(x, wq, wk, wv, alpha, beta)\n        t_ref = (time.process_time_ns() - t0) / n / 1e6\n        \n        t0 = time.process_time_ns()\n        for _ in range(n):\n            attention_opt(x, wq, wk, wv, alpha, beta)\n        t_opt = (time.process_time_ns() - t0) / n / 1e6\n    \n    ratio = t_opt / t_ref\n    ok = 'OK' if max_diff < 3e-5 + 3e-4 * abs(out_ref.abs().max().item()) else 'FAIL'\n    print(f'  Case {i}: B={B} L={L} C={C} H={H} alpha={alpha} -> {ratio:.3f}x (max_diff={max_diff:.2e}) {ok}')\n\\\"\n\"","aggregated_output":"Testing correctness and speedup per case:\n  Case 0: B=1 L=64 C=512 H=8 alpha=1.05 -> 0.356x (max_diff=0.00e+00) OK\n  Case 1: B=1 L=128 C=640 H=10 alpha=1.1 -> 2.132x (max_diff=0.00e+00) OK\n  Case 2: B=1 L=128 C=1280 H=20 alpha=1.15 -> 0.682x (max_diff=0.00e+00) OK\n  Case 3: B=1 L=256 C=1280 H=20 alpha=1.05 -> 1.251x (max_diff=0.00e+00) OK\n  Case 4: B=1 L=256 C=640 H=10 alpha=1.2 -> 1.064x (max_diff=0.00e+00) OK\n  Case 5: B=2 L=128 C=512 H=8 alpha=1.0 -> 0.856x (max_diff=0.00e+00) OK\n","exit_code":0,"status":"completed"}}

{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport time, math\nimport torch\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\ncases = [\n    (1, 64, 512, 8, 64, 1.05, 5.0),\n    (1, 128, 640, 10, 64, 1.1, 4.0),\n    (1, 128, 1280, 20, 64, 1.15, 3.0),\n    (1, 256, 1280, 20, 64, 1.05, 7.5),\n    (1, 256, 640, 10, 64, 1.2, 5.0),\n    (2, 128, 512, 8, 64, 1.0, 5.0),\n]\n\n@torch.no_grad()\ndef attention_v1(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D, _ = wq.shape\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    \n    # Input projections: expand + bmm\n    xu = x.unsqueeze(1).expand(B, H, L, C).contiguous().view(B*H, L, C)\n    wqt = wq.transpose(-1, -2).contiguous().expand(B, H, C, D).view(B*H, C, D)\n    wkt = wk.transpose(-1, -2).contiguous().expand(B, H, C, D).view(B*H, C, D)\n    \n    q = (xu @ wqt).view(B, H, L, D)\n    k = (xu @ wkt).view(B, H, L, D)\n    \n    logits = (q @ k.transpose(-1, -2)) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    base = torch.einsum('bhjk,bkc->bhjc', p0, x)\n    \n    if alpha == 1.0:\n        modified = base\n    else:\n        a_p = 0.5 * (1 + alpha)\n        a_m = 0.5 * (1 - alpha)\n        perturbed = a_p * logits + a_m * logits.transpose(-1, -2)\n        p1 = perturbed.softmax(dim=-1)\n        modified = torch.einsum('bhjk,bkc->bhjc', p1, x)\n    \n    blended = base.lerp(modified, beta)\n    \n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6) \\\\\n            / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n    ratio = ratio.clamp(.25, 4.)\n    \n    # Output projection via expand+bmm\n    wvt = wv.transpose(-1, -2).contiguous().expand(B, H, C, D).view(B*H, C, D)\n    br = (blended * ratio).contiguous().view(B*H, L, C)\n    y = (br @ wvt).view(B, H, L, D)\n    \n    return y.transpose(1, 2).flatten(2).contiguous()\n\n@torch.no_grad()\ndef attention_orig(x, wq, wk, wv, alpha, beta):\n    q = torch.einsum('blc,hdc->bhld', x, wq)\n    k = torch.einsum('blc,hdc->bhld', x, wk)\n    logits = (q @ k.transpose(-1, -2)) / math.sqrt(wq.shape[1])\n    p0 = logits.softmax(dim=-1)\n    base = p0 @ x.unsqueeze(1)\n    if alpha == 1.0:\n        modified = base\n    else:\n        perturbed = .5 * (1 + alpha) * logits + .5 * (1 - alpha) * logits.transpose(-1, -2)\n        modified = perturbed.softmax(dim=-1) @ x.unsqueeze(1)\n    blended = base + beta * (modified - base)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    y = torch.einsum('bhlc,hdc->bhld', blended * ratio, wv)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\nprint(f'{\\\\\\\"Case\\\\\\\":6s} {\\\\\\\"MaxDiff\\\\\\\":>10s} {\\\\\\\"MaxDiff/Tol\\\\\\\":>12s} {\\\\\\\"V1 ms\\\\\\\":>8s} {\\\\\\\"Orig ms\\\\\\\":>8s} {\\\\\\\"Ratio\\\\\\\":>7s}')\nfor i, (B, L, C, H, D, alpha, beta) in enumerate(cases):\n    torch.manual_seed(42 + i)\n    x = torch.randn(B, L, C)\n    wq = torch.randn(H, D, C)\n    wk = torch.randn(H, D, C)\n    wv = torch.randn(H, D, C)\n    \n    out_v1 = attention_v1(x, wq, wk, wv, alpha, beta)\n    out_orig = attention_orig(x, wq, wk, wv, alpha, beta)\n    \n    diff = (out_v1 - out_orig).abs()\n    tol = 3e-5 + 3e-4 * out_orig.abs()\n    max_ratio = (diff / tol).max().item()\n    \n    # timing (warmup 3, measure 7\n    for _ in range(3):\n        attention_v1(x, wq, wk, wv, alpha, beta)\n        attention_orig(x, wq, wk, wv, alpha, beta)\n    \n    tv1 = []\n    torig = []\n    for _ in range(7):\n        s = time.process_time_ns()\n        attention_v1(x, wq, wk, wv, alpha, beta)\n        tv1.append((time.process_time_ns() - s) / 1e6)\n        s = time.process_time_ns()\n        attention_orig(x, wq, wk, wv, alpha, beta)\n        torig.append((time.process_time_ns() - s) / 1e6)\n    \n    v1_ms = sorted(tv1)[3]\n    orig_ms = sorted(torig)[3]\n    print(f'{i:6d} {diff.max():10.2e} {max_ratio:12.3f} {v1_ms:8.2f} {orig_ms:8.2f} {v1_ms/orig_ms:7.3f}')\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

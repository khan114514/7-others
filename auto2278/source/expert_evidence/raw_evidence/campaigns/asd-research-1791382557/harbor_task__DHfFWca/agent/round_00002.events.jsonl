{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport time, math\nimport torch\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\nalpha, beta = 1.15, 3.0\nscale = 1.0 / math.sqrt(D)\n\n# Setup intermediate tensors\nq = x.unsqueeze(1) @ wq.transpose(-1, -2)\nk = x.unsqueeze(1) @ wk.transpose(-1, -2)\nlogits = (q @ k.transpose(-1, -2)) * scale\np0 = logits.softmax(dim=-1)\nperturbed = 0.5*(1+alpha)*logits + 0.5*(1-alpha)*logits.transpose(-1,-2)\np1 = perturbed.softmax(dim=-1)\n\ndef time_step(name, fn, n=7):\n    fn()\n    times = []\n    for _ in range(n):\n        s = time.process_time_ns()\n        result = fn()\n        times.append((time.process_time_ns() - s) / 1e6)\n    print(f'{name}: {sorted(times)[len(times)//2]:.2f} ms')\n    return result\n\n# Value projection: p0 @ x.unsqueeze(1) vs bmm\ndef value_broadcast():\n    return p0 @ x.unsqueeze(1)\n\ndef value_bmm():\n    # reshape p0: (B,H,L,L) -> (B*H, L, L)\n    # x: (B,L,C) -> (B*H, L, C) via expand+reshape\n    p0_flat = p0.reshape(B*H, L, L)\n    x_exp = x.expand(B*H, L, C)  # expand doesn't copy\n    return (p0_flat @ x_exp).reshape(B, H, L, C)\n\ndef value_einsum():\n    return torch.einsum('bhll,blc->bhlc', p0, x)\n\nr1 = time_step('value broadcast matmul', value_broadcast)\nr2 = time_step('value bmm', value_bmm)\nr3 = time_step('value einsum', value_einsum)\nprint(f'broadcast-bmm diff: {(r1-r2).abs().max():.2e}')\nprint(f'broadcast-einsum diff: {(r1-r3).abs().max():.2e}')\n\n# Output projection: einsum vs matmul\nbr = p0 @ x.unsqueeze(1)\nratio = torch.rand(B, H, L, 1)\nscaled = br * ratio\n\ndef out_einsum():\n    return torch.einsum('bhlc,hdc->bhld', scaled, wv)\n\ndef out_matmul():\n    # scaled: (B,H,L,C), wv: (H,D,C)\n    # -> (B,H,L,D)\n    return scaled @ wv.transpose(-1, -2)\n\nr1 = time_step('out einsum', out_einsum)\nr2 = time_step('out matmul', out_matmul)\nprint(f'out diff: {(r1-r2).abs().max():.2e}')\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

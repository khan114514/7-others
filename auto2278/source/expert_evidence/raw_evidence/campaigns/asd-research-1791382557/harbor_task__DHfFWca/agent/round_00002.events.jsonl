{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport time, math\nimport torch\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 2, 128, 512, 8, 64\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\nalpha, beta = 1.0, 5.0\nscale = 1.0 / math.sqrt(D)\n\ndef time_step(name, fn, n=11):\n    fn()\n    times = []\n    for _ in range(n):\n        s = time.process_time_ns()\n        result = fn()\n        times.append((time.process_time_ns() - s) / 1e6)\n    print(f'{name}: {sorted(times)[5]:.3f} ms')\n    return result\n\nxu = x.unsqueeze(1)\nq = xu @ wq.transpose(-1,-2)\nk = xu @ wk.transpose(-1,-2)\nlogits = (q @ k.transpose(-1, -2)) * scale\np0 = logits.softmax(dim=-1)\n\nprint('Value projection comparison (B=2):')\ntime_step('broadcast matmul', lambda: p0 @ x.unsqueeze(1))\ntime_step('einsum bhjk,bkc->bhjc', lambda: torch.einsum('bhjk,bkc->bhjc', p0, x))\n\n# Also check input projection\nprint()\nprint('Input projection comparison (B=2):')\ntime_step('einsum q', lambda: torch.einsum('blc,hdc->bhld', x, wq))\ntime_step('matmul q', lambda: x.unsqueeze(1) @ wq.transpose(-1,-2))\n\n# Output projection\nbase = p0 @ x.unsqueeze(1)\nratio = torch.rand(B, H, L, 1)\nbr = base * ratio\nprint()\nprint('Output projection comparison (B=2):')\ntime_step('einsum out', lambda: torch.einsum('bhlc,hdc->bhld', br, wv))\ntime_step('matmul out', lambda: br @ wv.transpose(-1,-2))\n\n# Try bmm approach for value\ndef value_bmm2():\n    p0_flat = p0.reshape(B*H, L, L)\n    x_exp = x.unsqueeze(1).expand(B, H, L, C).reshape(B*H, L, C)\n    return (p0_flat @ x_exp).reshape(B, H, L, C)\n\ntime_step('bmm value', value_bmm2)\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport time, math\nimport torch\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\nalpha, beta = 1.15, 3.0\nscale = 1.0 / math.sqrt(D)\n\n@torch.no_grad()\ndef attention_opt(x, wq, wk, wv, alpha, beta):\n    inv_sqrt_d = 1.0 / math.sqrt(wq.shape[1])\n    wt_q = wq.transpose(-1, -2)  # (H,C,D)\n    wt_k = wk.transpose(-1, -2)\n    wt_v = wv.transpose(-1, -2)\n    xu = x.unsqueeze(1)  # (B,1,L,C)\n    q = xu @ wt_q  # (B,H,L,D)\n    k = xu @ wt_k\n    logits = (q @ k.transpose(-1, -2)) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    base = torch.einsum('bhjk,bkc->bhjc', p0, x)\n    if alpha == 1.0:\n        modified = base\n    else:\n        a_p = 0.5 * (1 + alpha)\n        a_m = 0.5 * (1 - alpha)\n        perturbed = a_p * logits + a_m * logits.transpose(-1, -2)\n        p1 = perturbed.softmax(dim=-1)\n        modified = torch.einsum('bhjk,bkc->bhjc', p1, x)\n    blended = base.lerp(modified, beta)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    y = (blended * ratio) @ wt_v\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n@torch.no_grad()\ndef attention_orig(x, wq, wk, wv, alpha, beta):\n    q = torch.einsum('blc,hdc->bhld', x, wq)\n    k = torch.einsum('blc,hdc->bhld', x, wk)\n    logits = (q @ k.transpose(-1, -2)) / math.sqrt(wq.shape[1])\n    p0 = logits.softmax(dim=-1)\n    base = p0 @ x.unsqueeze(1)\n    if alpha == 1.0:\n        modified = base\n    else:\n        perturbed = .5 * (1 + alpha) * logits + .5 * (1 - alpha) * logits.transpose(-1, -2)\n        modified = perturbed.softmax(dim=-1) @ x.unsqueeze(1)\n    blended = base + beta * (modified - base)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    y = torch.einsum('bhlc,hdc->bhld', blended * ratio, wv)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Correctness\nout_opt = attention_opt(x, wq, wk, wv, alpha, beta)\nout_orig = attention_orig(x, wq, wk, wv, alpha, beta)\ndiff = (out_opt - out_orig).abs()\nprint(f'Max diff: {diff.max():.2e}')\nprint(f'Relative diff: {(diff / out_orig.abs().clamp_min(1e-8)).max():.2e}')\n\n# Timing\nfor _ in range(3):\n    attention_opt(x, wq, wk, wv, alpha, beta)\ntimes = []\nfor _ in range(11):\n    s = time.process_time_ns()\n    attention_opt(x, wq, wk, wv, alpha, beta)\n    times.append((time.process_time_ns() - s) / 1e6)\nprint(f'Opt median: {sorted(times)[5]:.2f} ms')\n\nfor _ in range(3):\n    attention_orig(x, wq, wk, wv, alpha, beta)\ntimes = []\nfor _ in range(11):\n    s = time.process_time_ns()\n    attention_orig(x, wq, wk, wv, alpha, beta)\n    times.append((time.process_time_ns() - s) / 1e6)\nprint(f'Orig median: {sorted(times)[5]:.2f} ms')\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport time, math\nimport torch\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nx = torch.randn(B, L, C)\nwq = torch.randn(H, D, C)\nwk = torch.randn(H, D, C)\nwv = torch.randn(H, D, C)\nalpha, beta = 1.15, 3.0\n\n@torch.no_grad()\ndef attention_opt(x, wq, wk, wv, alpha, beta):\n    inv_sqrt_d = 1.0 / math.sqrt(wq.shape[1])\n    wt_q = wq.transpose(-1, -2)\n    wt_k = wk.transpose(-1, -2)\n    wt_v = wv.transpose(-1, -2)\n    xu = x.unsqueeze(1)\n    q = xu @ wt_q\n    k = xu @ wt_k\n    logits = (q @ k.transpose(-1, -2)) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    base = torch.einsum('bhjk,bkc->bhjc', p0, x)\n    if alpha == 1.0:\n        modified = base\n    else:\n        a_p = 0.5 * (1 + alpha)\n        a_m = 0.5 * (1 - alpha)\n        perturbed = a_p * logits + a_m * logits.transpose(-1, -2)\n        p1 = perturbed.softmax(dim=-1)\n        modified = torch.einsum('bhjk,bkc->bhjc', p1, x)\n    blended = base.lerp(modified, beta)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    y = (blended * ratio) @ wt_v\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n@torch.no_grad()\ndef attention_orig(x, wq, wk, wv, alpha, beta):\n    q = torch.einsum('blc,hdc->bhld', x, wq)\n    k = torch.einsum('blc,hdc->bhld', x, wk)\n    logits = (q @ k.transpose(-1, -2)) / math.sqrt(wq.shape[1])\n    p0 = logits.softmax(dim=-1)\n    base = p0 @ x.unsqueeze(1)\n    if alpha == 1.0:\n        modified = base\n    else:\n        perturbed = .5 * (1 + alpha) * logits + .5 * (1 - alpha) * logits.transpose(-1, -2)\n        modified = perturbed.softmax(dim=-1) @ x.unsqueeze(1)\n    blended = base + beta * (modified - base)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    y = torch.einsum('bhlc,hdc->bhld', blended * ratio, wv)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\nout_opt = attention_opt(x, wq, wk, wv, alpha, beta)\nout_orig = attention_orig(x, wq, wk, wv, alpha, beta)\n\n# Find where the error is\n# Let's compare intermediate values\ninv_sqrt_d = 1.0 / math.sqrt(D)\nxu = x.unsqueeze(1)\nq = xu @ wq.transpose(-1,-2)\nk = xu @ wk.transpose(-1,-2)\nlogits = (q @ k.transpose(-1, -2)) * inv_sqrt_d\np0 = logits.softmax(dim=-1)\nbase = torch.einsum('bhjk,bkc->bhjc', p0, x)\n\na_p = 0.5 * (1 + alpha)\na_m = 0.5 * (1 - alpha)\nperturbed = a_p * logits + a_m * logits.transpose(-1, -2)\np1 = perturbed.softmax(dim=-1)\nmodified = torch.einsum('bhjk,bkc->bhjc', p1, x)\n\n# Test lerp vs formula\nblended_lerp = base.lerp(modified, beta)\nblended_formula = base + beta * (modified - base)\nprint(f'blended diff (lerp vs formula): {(blended_lerp-blended_formula).abs().max():.2e}')\n\n# Check ratio\nratio_1 = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6) / blended_lerp.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\nratio_2 = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6) / blended_formula.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\nprint(f'ratio diff: {(ratio_1-ratio_2).abs().max():.2e}')\n\n# Output projection\nwt_v = wv.transpose(-1,-2)\ny1 = (blended_lerp * ratio_1) @ wt_v\ny2 = torch.einsum('bhlc,hdc->bhld', blended_formula * ratio_2, wv)\nprint(f'y diff: {(y1-y2).abs().max():.2e}')\nprint(f'y1 shape: {y1.shape}')\n\n# Wait - the output proj in opt uses matmul, but in orig uses einsum. Let's check with same blended*ratio input\nbr = blended_formula * ratio_2\ny_mat = br @ wt_v\ny_ein = torch.einsum('bhlc,hdc->bhld', br, wv)\nprint(f'out proj mat vs ein same input: {(y_mat-y_ein).abs().max():.2e}')\n\\\" 2>&1\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

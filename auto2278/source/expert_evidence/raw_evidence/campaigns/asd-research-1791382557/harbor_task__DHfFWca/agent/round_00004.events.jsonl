{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport time, math, torch\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\ng = torch.Generator().manual_seed(17)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) * 0.1\nwk = torch.randn(H, D, C, generator=g) * 0.1\nwv = torch.randn(H, D, C, generator=g) * 0.1\n\ndef time_step(name, fn, warmup=3, repeats=11):\n    for _ in range(warmup):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(repeats):\n        fn()\n    t1 = time.process_time_ns()\n    ms = (t1-t0)/1e6/repeats\n    print(f'{name:55s} {ms:8.2f} ms')\n    return ms\n\n# Test final projection alternatives\n# Current: einsum('bhlc,hdc->bhld', blended * ratio, wv)\n# Output needed: (B,L,H*D) contiguous\n\nblended = torch.randn(B, H, L, D)  # wait, blended is (B,H,L,C)? No...\n# Wait let me re-read: base = p0 @ x with shape (B,H,L,C)\n# blended has shape (B,H,L,C)\n# wv has shape (H,D,C)\n# output: (B,H,L,D)\n# Then transpose(1,2).flatten(2) -> (B,L,H*D)\n\nblended_r = torch.randn(B, H, L, C)  # (B,H,L,C)\nratio = torch.randn(B, H, L, 1)\nscaled = blended_r * ratio  # (B,H,L,C)\n\nprint('=== Final projection alternatives ===')\ntime_step('einsum bhlc,hdc->bhld', lambda: torch.einsum('bhlc,hdc->bhld', scaled, wv))\n\n# Option: reshape scaled to (B*H, L, C), wv to (H, D, C), then bmm or batch matmul\n# Hmm, wv is per-head so we need (H, D, C) and scaled is (B*H, L, C)\n# bmm((B*H, L, C), (B*H, C, D)) = (B*H, L, D) -> reshape (B,H,L,D)\ndef bmm_final():\n    s = scaled.reshape(B*H, L, C)  # (B*H, L, C)\n    w = wv.unsqueeze(0).expand(B, H, D, C).reshape(B*H, D, C)  # (B*H, D, C)\n    return (s @ w.transpose(-1, -2)).reshape(B, H, L, D)\n\ntime_step('bmm: (B*H,L,C) @ (B*H,C,D)', bmm_final)\n\n# Verify\nr1 = torch.einsum('bhlc,hdc->bhld', scaled, wv)\nr2 = bmm_final
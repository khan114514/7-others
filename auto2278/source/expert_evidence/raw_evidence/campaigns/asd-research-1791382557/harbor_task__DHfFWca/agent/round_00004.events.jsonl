{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport time, math, torch\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\ng = torch.Generator().manual_seed(17)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) * 0.1\nwk = torch.randn(H, D, C, generator=g) * 0.1\nwv = torch.randn(H, D, C, generator=g) * 0.1\n\ndef time_step(name, fn, warmup=3, repeats=11):\n    for _ in range(warmup):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(repeats):\n        fn()\n    t1 = time.process_time_ns()\n    ms = (t1-t0)/1e6/repeats\n    print(f'{name:50s} {ms:8.2f} ms')\n    return ms\n\n# Now test q,k projection optimization\n# Current: einsum('blc,hdc->bhld', x, wq)\n# Alternative: reshape wq to (H*D, C), do x @ wq.T -> (B, L, H*D), reshape to (B, L, H, D), transpose to (B, H, L, D)\n\nprint('=== Q,K projection alternatives ===')\ntime_step('einsum blc,hdc->bhld', lambda: torch.einsum('blc,hdc->bhld', x, wq))\n\ndef gemm_proj():\n    # wq: (H, D, C) -> (H*D, C)\n    wq_flat = wq.reshape(H*D, C)\n    # x @ wq_flat.T: (B, L, C) @ (C, H*D) -> (B, L, H*D)\n    out = x @ wq_flat.T\n    # reshape to (B, L, H, D), then transpose to (B, H, L, D)\n    return out.reshape(B, L, H, D).transpose(1, 2).contiguous()\n\ntime_step('gemm: x @ wq_flat.T + reshape+trans', gemm_proj)\n\n# Check correctness\nr1 = torch.einsum('blc,hdc->bhld', x, wq)\nr2 = gemm_proj()\nprint(f'diff: {(r1-r2).abs().max():.2e}')\n\n# What about without contiguous? (just view if possible)\ndef gemm_proj_nocontig():\n    wq_flat = wq.reshape(H*D, C)\n    out = x @ wq_flat.T\n    return out.reshape(B, L, H, D).permute(0, 2, 1, 3)\n\ntime_step('gemm no contiguous (permute)', gemm_proj_nocontig)\n\nr3 = gemm_proj_nocontig()\nprint(f'diff nocontig: {(r1-r3).abs().max():.2e}')\n\n# For q@kT we need (B,H,L,D) @ (B,H,D,L) -> (B,H,L,L)\n# Non-contiguous q/k might be fine for matmul... let's check\nprint()\nprint('=== q @ kT with different layouts ===')\nq1 = torch.einsum('blc,hdc->bhld', x, wq)\nk1 = torch.einsum('blc,hdc->bhld', x, wk)\nq2 = gemm_proj_nocontig()\nk2 = gemm_proj_nocontig().transpose(-1, -2)\n\ntime_step('q1@k1.T (einsum inputs)', lambda: q1 @ k1.transpose(-1, -2))\ntime_step('q2@k2.T (gemm inputs)', lambda: q2 @ k2.transpose(-1, -2))\n\nr_a = q1 @ k1.transpose(-1, -2)\nr_b = q2 @ k2.transpose(-1, -2)\nprint(f'diff: {(r_a-r_b).abs().max():.2e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

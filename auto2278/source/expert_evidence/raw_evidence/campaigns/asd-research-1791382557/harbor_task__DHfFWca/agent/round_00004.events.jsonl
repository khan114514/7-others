{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport time, math, torch\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\ng = torch.Generator().manual_seed(17)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) * 0.1\nwk = torch.randn(H, D, C, generator=g) * 0.1\nwv = torch.randn(H, D, C, generator=g) * 0.1\n\ndef time_fn(name, fn, warmup=3, repeats=11):\n    for _ in range(warmup):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(repeats):\n        fn()\n    t1 = time.process_time_ns()\n    ms = (t1-t0)/1e6/repeats\n    print(f'{name:50s} {ms:8.2f} ms')\n    return ms\n\n# Reference implementation (current solution)\ndef attention_ref(x, wq, wk, wv, alpha, beta):\n    D = wq.shape[1]\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    q = torch.einsum('blc,hdc->bhld', x, wq)\n    k = torch.einsum('blc,hdc->bhld', x, wk)\n    logits = (q @ k.transpose(-1, -2)) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    base = torch.einsum('bhjk,bkc->bhjc', p0, x)\n    if alpha == 1.0:\n        modified = base\n    else:\n        a_p = 0.5 * (1 + alpha)\n        a_m = 0.5 * (1 - alpha)\n        perturbed = a_p * logits + a_m * logits.transpose(-1, -2)\n        p1 = perturbed.softmax(dim=-1)\n        modified = torch.einsum('bhjk,bkc->bhjc', p1, x)\n    blended = base.lerp(modified, beta)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    y = torch.einsum('bhlc,hdc->bhld', blended * ratio, wv)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Optimized: all gemm, fused qk projection\ndef attention_opt1(x, wq, wk, wv, alpha, beta):\n    H, D, C = wq.shape\n    B, L, _ = x.shape\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    \n    # Fused q,k projection: (H*2*D, C) -> x @ (qk_weight).T -> (B, L, H*2*D)\n    qk_w = torch.cat([wq.reshape(H*D, C), wk.reshape(H*D, C)], dim=0)  # (2*H*D, C)\n    qk = x @ qk_w.T  # (B, L, 2*H*D)\n    q = qk[:, :, :H*D].reshape(B, L, H, D).permute(0, 2, 1, 3)  # (B, H, L, D)\n    k = qk[:, :, H*D:].reshape(B, L, H, D).permute(0, 2, 1, 3)  # (B, H, L, D)\n    \n    logits = (q @ k.transpose(-1, -2)) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    base = torch.einsum('bhjk,bkc->bhjc', p0, x)\n    \n    if alpha == 1.0:\n        modified = base\n    else:\n        a_p = 0.5 * (1 + alpha)\n        a_m = 0.5 * (1 - alpha)\n        perturbed = a_p * logits + a_m * logits.transpose(-1, -2)\n        p1 = perturbed.softmax(dim=-1)\n        modified = torch.einsum('bhjk,bkc->bhjc', p1, x)\n    \n    blended = base.lerp(modified, beta)\n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    y = torch.einsum('bhlc,hdc->bhld', blended * ratio, wv)\n    return y.transpose(1, 2).flatten(2).contiguous()\n\n# Verify correctness\nref = attention_ref(x, wq, wk, wv, alpha, beta)\nopt = attention_opt1(x, wq, wk, wv, alpha, beta)\nprint(f'opt1 diff: {(ref-opt).abs().max():.2e}')\n\ntime_fn('reference', lambda: attention_ref(x, wq, wk, wv, alpha, beta))\ntime_fn('opt1 (fused qk proj)', lambda: attention_opt1(x, wq, wk, wv, alpha, beta))\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

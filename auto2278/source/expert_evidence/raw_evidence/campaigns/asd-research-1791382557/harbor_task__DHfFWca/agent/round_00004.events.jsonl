{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport time, math, torch\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\ng = torch.Generator().manual_seed(17)\nx = torch.randn(B, L, C, generator=g)\np0 = torch.randn(B, H, L, L).softmax(dim=-1)\n\ndef time_step(name, fn, warmup=3, repeats=11):\n    for _ in range(warmup):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(repeats):\n        fn()\n    t1 = time.process_time_ns()\n    ms = (t1-t0)/1e6/repeats\n    print(f'{name:55s} {ms:8.2f} ms')\n    return ms\n\nprint('=== p0 @ x alternatives ===')\n\n# Current best in solution: einsum or broadcast matmul\ntime_step('einsum bhjk,bkc->bhjc', lambda: torch.einsum('bhjk,bkc->bhjc', p0, x))\ntime_step('p0 @ x.unsqueeze(1)', lambda: p0 @ x.unsqueeze(1))\n\n# bmm approach with contiguous x\ndef bmm_contig():\n    p0f = p0.reshape(B*H, L, L)\n    xf = x.unsqueeze(1).expand(B, H, L, C).contiguous().reshape(B*H, L, C)\n    return (p0f @ xf).reshape(B, H, L, C)\ntime_step('bmm: contiguous expand', bmm_contig)\n\n# bmm approach without explicit contiguous (let bmm handle it)\ndef bmm_view():\n    p0f = p0.reshape(B*H, L, L)\n    xf = x.expand(B, H, L, C).reshape(B*H, L, C)\n    return (p0f @ xf).reshape(B, H, L, C)\ntime_step('bmm: view expand (no contig)', bmm_view)\n\n# Check if x.unsqueeze(1).expand gives correct shape for matmul\nr1 = p0 @ x.unsqueeze(1)\nr2 = bmm_view()\nprint(f'diff: {(r1-r2).abs().max():.2e}')\n\n# What about the output - do we need contiguous output for downstream ops?\n# Let's check what happens with non-contiguous output\nout = p0 @ x.unsqueeze(1)\nprint(f'p0@x is_contiguous: {out.is_contiguous()}')\nprint(f'p0@x strides: {out.stride()}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

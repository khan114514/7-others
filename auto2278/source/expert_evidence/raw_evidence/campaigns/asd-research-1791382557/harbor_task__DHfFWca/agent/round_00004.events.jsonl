{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport time, math, torch\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\ng = torch.Generator().manual_seed(17)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) * 0.1\nwk = torch.randn(H, D, C, generator=g) * 0.1\nwv = torch.randn(H, D, C, generator=g) * 0.1\n\ndef time_fn(name, fn, warmup=3, repeats=11):\n    for _ in range(warmup):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(repeats):\n        fn()\n    t1 = time.process_time_ns()\n    ms = (t1-t0)/1e6/repeats\n    print(f'{name:50s} {ms:8.2f} ms')\n    return ms\n\n# Let me check softmax optimization. The two softmax calls add up (6.6 + 11.6 = ~18ms\n# Also: (B,H,L,L) softmax - L=256, H=20, B=1 -> 20 * 256 * 256 softmax ops\n\n# Let me try different softmax variants\nlogits = torch.randn(B, H, L, L)\ntime_fn('softmax dim=-1', lambda: logits.softmax(dim=-1))\ntime_fn('log_softmax dim=-1', lambda: logits.log_softmax(dim=-1))\n\n# What about using functional form?\n# softmax(x)_manual -\n# Let me also test with different memory layouts\nlogits_t = logits.transpose(-1, -2).contiguous()\ntime_fn('softmax contiguous then contiguous()', lambda: logits_t.softmax(dim=-1))\n\n# How about manual softmax for stability\ndef manual_softmax(inp):\n    m = inp.max(dim=-1, keepdim=True).values\n    e = (inp - m).exp_()\n    s = e.sum(dim=-1, keepdim=True)\n    return e / s\ntime_fn('manual softmax inplace', lambda: manual_softmax(logits.clone()))\n\n# Let me try float64\nprint()\nprint('=== Full optimized version:')\n\n# I want to see if we can avoid the separate softmax+proj as one pass\n# Also check if there's a way to fuse p0@x and p1@x \n# Hmm, but p0 and p1 are different softmaxes\n\n# What about: instead of computing p0 = softmax(A), base = p0 @ x\n# Can we do: base = softmax(A) @ x -- this is a standard attention operation\n# Flash attention equivalent on CPU? Not really for float32 single thread.\n\n# Let me think about this more carefully. The total time breakdown:\n# q proj: 22ms\n# k proj: 22ms  \n# logits: 5ms\n# softmax0: 7ms\n# p0@x: 58ms  <-- biggest\n# perturbed: 4ms\n# softmax1: 12ms\n# p1@x: 58ms  <-- second biggest\n# blend+ratio: 4ms\n# final proj: 22ms\n# Total: ~214ms\n\n# The two p@x operations are ~55% of total. \n# These are (B,H,L,L) @ (B,L,C) = (B,H,L,C)\n# For B=1,H=20,L=256,C=1280: \n#   FLOPS = H * L * L * C = 20 * 256 * 256 * 1280 = 1.68 GFLOP\n#   At 2GHz single-thread: 1.68 GFLOP / 2GHz = 0.84s if 1 FLOP/cycle\n# But with SIMD (AVX2 256-bit = 8 float32 per cycle): 1.68G / (2G*8) = 0.105s = 105ms\n# Hmm, we're at 58ms so actually not bad - ~18 GFLOPS\n\n# Wait: 1.68e9 FLOP / 0.058s = 29 GFLOPS. That's actually quite good for single thread.\n\n# Let me think about what else we can optimize:\n# 1. Compute p0@x and p1@x more efficiently\n# 2. Reduce memory layout changes\n# 3. Fuse operations\n# 4. Use in-place ops\n\n# One idea: since alpha is a scalar, perturbed = a_p * logits + a_m * logits\"'^T\n# We could compute p1 more efficiently somehow?\n# Not really - it'\"'s a different softmax.\n\n# What if we compute both softmax output directly?\n# No, we need both p0@x and p1@x separately.\n\n# Key insight: both base = softmax(A) @ x and modified = softmax(a_p*A + a_m*A\"'^T) @ x\n# Both are attention-weighted averages of x.\n# Both use the same x.\n\n# Let me try: using torch.nn.functional.scaled_dot_product_attention\n# But SDPA computes softmax(QK''^T/sqrt(d)) @ V, where V is x in this case\n# Wait: SDPA(query=x? No, Q=x, V=x\n# q has shape (B,H,L,D), but x has shape (B,L,C)\n# Hmm V needs to be (B,H,L,D_head) typically\n\n# Actually wait - in standard attention:\n# Q = x @ Wq''^T  (B,L,H*D)\n# K = x @ Wk''^T  (B,L,H*D)\n# V = x @ Wv''^T  (B,L,H*D)\n# attn = softmax(QK''^T/sqrt(d)) @ V\n# \n# In our case:\n# p0 @ x is NOT the same as standard attention output\n# Standard attention V is per-head projected values\n# Here p0 @ x gives back in C dimensions, not D\n\n# Actually wait, I see the final output is (r*m) @ Wv''^T\n# where m = blended attention output in (B,H,L,C)\n# and final is (B,H,L,D)\n\n# So the full pipeline:\n# p0 @ x  -> (B,H,L,C) \n# then (r*m) @ wv''^T -> (B,H,L,D)\n# \n# We could fuse these two:\n# p0 @ x @ wv''^T -> (B,H,L,D)\n# No, because we need the ratio calculation in the middle.\n\n# Let'\"'s see: what if we compute:\n# y0 = p0 @ x (B,H,L,C)\n# y1 = p1 @ x (B,H,L,C)\n# blended = lerp(y0, y1, beta) (B,H,L,C)\n# ratio = ||y1|| / ||blended||  (scalar per head per token)\n# output = (ratio * blended) @ wv\"'^T  (B,H,L,D)\n# \n# Can we avoid materialize y0 and y1 in C space? No we need them for ratio.\n# C is 1280, D is 64. D is much smaller.\n# But ratio uses norms are per-token norms of y1 and blended, which are in C space.\n# So we need y0 and y1 for the norm calculation.\n\n# Hmm, what about this:\n# norm of y0 (B,H,L) - scalar per head per token\n# norm of y1 (B,H,L) - scalar per head per token\n# We need these for the ratio.\n# \n# Can we compute norms without materializing the full (B,H,L,C)?\n# ||softmax(A) @ x|| - not easily...\n# = sqrt(sum_c (sum_k p[j,k] * x[k,c])''^2)\n# = sqrt( sum_c y_j''^T y_j) where y_j = p_j @ x\n# = ||p_j @ x||_F ... that'\"'s the Frobenius norm of p_j @ x\n# = ||x\"'^T p_j''^T||...\n# Hmm, not obvious.\n\n# Let me think about other optimizations:\n# - Reuse memory / in-place operations\n# - Better memory layout\n\n# Let'\"'s try a version with all the known optimizations:\n\ndef attention_v2(x, wq, wk, wv, alpha, beta):\n    B, L, C = x.shape\n    H, D, _ = wq.shape\n    inv_sqrt_d = 1.0 / math.sqrt(D)\n    \n    # Q, K projection via GEMM + reshape\n    # wq: (H,D,C) -> (H*D, C)\n    q = (x @ wq.reshape(H*D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    k = (x @ wk.reshape(H*D, C).T).reshape(B, L, H, D).permute(0, 2, 1, 3).contiguous()\n    \n    logits = (q @ k.transpose(-1, -2)) * inv_sqrt_d\n    p0 = logits.softmax(dim=-1)\n    base = torch.einsum('bhjk,bkc->bhjc', p0, x)\n    \n    if alpha == 1.0:\n        modified = base\n    else:\n        a_p = 0.5 * (1 + alpha)\n        a_m = 0.5 * (1 - alpha)\n        perturbed = a_p * logits + a_m * logits.transpose(-1, -2)\n        p1 = perturbed.softmax(dim=-1)\n        modified = torch.einsum('bhjk,bkc->bhjc', p1, x)\n    \n    blended = base.lerp(modified, beta)\n    \n    ratio = (modified.norm(dim=-1, keepdim=True).clamp_min(1e-6)\n             / blended.norm(dim=-1, keepdim=True).clamp_min(1e-6)).clamp(.25, 4.)\n    \n    # Final projection via bmm\n    # scaled: (B,H,L,C), wv: (H,D,C) -> (H,C,D)\n    # output: (B,H,L,D)\n    scaled = blended * ratio\n    # bmm: (B*H, L, C) @ (B*H, C, D) = (B*H, L, D)\n    y = torch.bmm(\n        scaled.reshape(B*H, L, C),\n        wv.transpose(-1, -2).unsqueeze(0).expand(B, H, C, D).reshape(B*H, C, D)\n    ).reshape(B, H, L, D)\n    \n    return y.transpose(1, 2).flatten(2).contiguous()\n\nref_fn = lambda: attention_v2(x, wq, wk, wv, alpha, beta)\ntime_fn('v2 (gemm proj + bmm final', ref_fn)\n\n# reference\nfrom solution.method import attention as attn_ref\ntime_fn('current solution', lambda: attn_ref(x, wq, wk, wv, alpha, beta))\n\n# verify\nr1 = attn_ref(x, wq, wk, wv, alpha, beta)\nr2 = attention_v2(x, wq, wk, wv, alpha, beta)\nprint(f'diff: {(r1-r2).abs().max():.2e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport time, math, torch\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\ng = torch.Generator().manual_seed(17)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) * 0.1\nwk = torch.randn(H, D, C, generator=g) * 0.1\nwv = torch.randn(H, D, C, generator=g) * 0.1\n\ndef time_fn(name, fn, warmup=3, repeats=11):\n    for _ in range(warmup):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(repeats):\n        fn()\n    t1 = time.process_time_ns()\n    ms = (t1-t0)/1e6/repeats\n    print(f'{name:55s} {ms:8.2f} ms')\n    return ms\n\n# Test: what if we use x.contiguous() explicitly? (it already is)\n# What about: doing q and k projection in one big matmul?\n# (qk_w: (2*H*D, C), x @ qk_w.T -> (B, L, 2*H*D))\n\nwq_flat = wq.reshape(H*D, C)\nwk_flat = wk.reshape(H*D, C)\n\ntime_fn('separate q and k gemm', lambda: (x @ wq_flat.T, x @ wk_flat.T))\n\ndef fused_qk():\n    qk_w = torch.cat([wq_flat, wk_flat], dim=0)  # (2*H*D, C)\n    qk = x @ qk_w.T\n    q = qk[:, :, :H*D]\n    k = qk[:, :, H*D:]\n    return q, k\n\ntime_fn('fused qk gemm + slice', fused_qk)\n\n# The issue with fused is that cat has overhead, but for multiple calls it would be cached.\n# Since we can't cache weights, cat overhead is per-call.\n# Let's measure the cat overhead separately:\ntime_fn('just cat of weights', lambda: torch.cat([wq_flat, wk_flat], dim=0))\n\n# What about: x has shape (B,L,C), wq (H,D,C), we want (B,H,L,D)\n# Alternative approach: (B, L, C) @ (C, H*D) = (B, L, H*D) -> view (B, L, H, D) -> permute\n# This is what we have.\n\n# Another idea: what if we avoid the permute+contiguous by changing how we compute logits?\n# logits = q @ k\"'^T where q,k are (B,H,L,D)\n# If q is (B,L,H,D), can we compute logits differently?\n# logits[b,h,i,j] = sum_
{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport time, math, torch\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\ng = torch.Generator().manual_seed(17)\nx = torch.randn(B, L, C, generator=g)\n\ndef time_step(name, fn, warmup=3, repeats=11):\n    for _ in range(warmup):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(repeats):\n        fn()\n    t1 = time.process_time_ns()\n    ms = (t1-t0)/1e6/repeats\n    print(f'{name:55s} {ms:8.2f} ms')\n    return ms\n\n# Single matmul reference\nm1 = torch.randn(L, L)\nm2 = torch.randn(L, C)\ntime_step('single (L,L)@(L,C) matmul', lambda: m1 @ m2)\n\n# H matmuls loop\ndef loop_matmul():\n    p = torch.randn(H, L, L).softmax(dim=-1)\n    out = torch.empty(H, L, C)\n    for h in range(H):\n        out[h] = p[h] @ x[0]\n    return out\ntime_step('python loop H matmuls', loop_matmul)\n\n# What about x.T @ p.T approach?\n# output[h,l,c] = sum_k p[h,l,k] * x[k,c]\n# output[h,:,:].T = x.T @ p[h,:,:].T -> (C, L) = (C, L) @ (L, L)\n# Hmm not helpful.\n\n# What about: stack all p0 heads into (H, L, L) and do bmm\n# With B=1: p (H, L, L), x (L, C) -> bmm requires (H, L, L) @ (H, L, C) \n# So we need to expand x to (H, L, C)\ndef bmm_h():\n    p = torch.randn(H, L, L).softmax(dim=-1)\n    xe = x[0].unsqueeze(0).expand(H, L, C)\n    return torch.bmm(p, xe)\ntime_step('bmm H heads (expand x)', bmm_h)\n\n# What about using torch.matmul with proper broadcast?\n# p: (H, L, L), x: (1, L, C) -> broadcast matmul\ndef matmul_bcast():\n    p = torch.randn(H, L, L).softmax(dim=-1)\n    return p @ x  # (H, L, L) @ (1, L, C) -> (H, L, C)... wait x is (B,L,C)=(1,256,1280)\ntime_step('matmul broadcast (H,L,L) @ (1,L,C)', matmul_bcast)\n\nr1 = torch.einsum('hjk,kc->hjc', torch.randn(H, L, L).softmax(dim=-1), x[0])\nr2 = matmul_bcast()\nprint(f'shape: {r2.shape}')\nprint(f'diff: {(r1-r2).abs().max():.2e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

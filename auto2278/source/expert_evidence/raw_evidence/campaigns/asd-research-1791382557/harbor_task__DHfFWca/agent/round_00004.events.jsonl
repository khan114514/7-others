{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport time, math, torch\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\ng = torch.Generator().manual_seed(17)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) * 0.1\nwk = torch.randn(H, D, C, generator=g) * 0.1\nwv = torch.randn(H, D, C, generator=g) * 0.1\n\ndef time_fn(name, fn, warmup=3, repeats=11):\n    for _ in range(warmup):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(repeats):\n        fn()\n    t1 = time.process_time_ns()\n    ms = (t1-t0)/1e6/repeats\n    print(f'{name:55s} {ms:8.2f} ms')\n    return ms\n\nwq_flat = wq.reshape(H*D, C)\nwk_flat = wk.reshape(H*D, C)\n\n# Check: q as (B,L,H,D) vs (B,H,L,D) for downstream ops\nq_blhd = (x @ wq_flat.T).reshape(B, L, H, D)  # (B,L,H,D) contiguous\nk_blhd = (x @ wk_flat.T).reshape(B, L, H, D)\n\n# Option A: permute + contiguous + matmul (current v3)\ndef opt_a():\n    q = q_blhd.permute(0, 2, 1, 3).contiguous()\n    k = k_blhd.permute(0, 2, 1, 3).contiguous()\n    return q @ k.transpose(-1, -2)\ntime_fn('A: permute+contig + matmul', opt_a)\n\n# Option B: einsum directly from (B,L,H,D)\ndef opt_b():\n    return torch.einsum('bihd,bjhd->bhij', q_blhd, k_blhd)\ntime_fn('B: einsum bihd,bjhd->bhij', opt_b)\n\n# Option C: matmul with permute (no contiguous)\ndef opt_c():\n    q = q_blhd.permute(0, 2, 1, 3)\n    k = k_blhd.permute(0, 2, 1, 3)\n    return (q @ k.transpose(-1, -2)).contiguous()\ntime_fn('C: permute + matmul (no contig q/k)', opt_c)\n\n# What about softmax on non-contiguous?\nlogits_a = opt_a()\nlogits_b = opt_b()\nprint(f'logits diff: {(logits_a-logits_b).abs().max():.2e}')\nprint(f'logits_a contiguous: {logits_a.is_contiguous()}')\nprint(f'logits_b contiguous: {logits_b.is_contiguous()}')\n\ntime_fn('softmax on A (contiguous bhij)', lambda: logits_a.softmax(dim=-1))\ntime_fn('softmax on B (einsum bhij)', lambda: logits_b.softmax(dim=-1))\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport time, math, torch\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\nalpha, beta = 1.05, 7.5\ng = torch.Generator().manual_seed(17)\nx = torch.randn(B, L, C, generator=g)\nwq = torch.randn(H, D, C, generator=g) * 0.1\nwk = torch.randn(H, D, C, generator=g) * 0.1\nwv = torch.randn(H, D, C, generator=g) * 0.1\n\ndef time_step(name, fn, warmup=3, repeats=11):\n    for _ in range(warmup):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(repeats):\n        fn()\n    t1 = time.process_time_ns()\n    ms = (t1-t0)/1e6/repeats\n    print(f'{name:50s} {ms:8.2f} ms')\n    return ms\n\n# Current: einsum bhjk,bkc->bhjc\np0 = torch.randn(B, H, L, L).softmax(dim=-1)\n\ntime_step('einsum bhjk,bkc->bhjc', lambda: torch.einsum('bhjk,bkc->bhjc', p0, x))\n\n# Option 1: bmm with reshape\n# p0: (B,H,L,L) -> (B*H, L, L)\n# x: (B, L, C) -> (B, 1, L, C) -> (B*H, L, C) via expand\n# result: (B*H, L, C) -> (B, H, L, C)\ndef bmm_approach():\n    p0_flat = p0.reshape(B*H, L, L)\n    x_exp = x.expand(B, H, L, C).reshape(B*H, L, C)\n    return (p0_flat @ x_exp).reshape(B, H, L, C)\n\ntime_step('bmm (reshape+expand+p0@x)', bmm_approach)\n\n# Option 2: use bmm but avoid expand cost by using broadcast via unsqueeze\n# Wait, bmm doesn't broadcast. We need actual (B*H, L, C) tensor.\n# But we can use einsum with optimized path... or try x.unsqueeze(1).expand(B,H,L,C).reshape(B*H,L,C)\n\n# Option 3: What about p0.transpose(0,1) approach? \n# p0: (B, H, L, L), x: (B, L, C)\n# We want output (B, H, L, C)\n# This is like: for each h, p0[:,h,:,:] @ x = (B, L, L) @ (B, L, C) = (B, L, C)\n# So bmm with p0 reshaped to (B, H*L, L) won't work directly.\n# Best is probably to reshape p0 to (B*H, L, L) and x to (B*H, L, C)\n\n# Let's check if using x.unsqueeze(1) and then matmul with broadcasting works\n# p0: (B, H, L, L), x.unsqueeze(1): (B, 1, L, C)\n# matmul: (B, H, L, L) @ (B, 1, L, C) -> should broadcast to (B, H, L, C)\ndef matmul_broadcast():\n    return p0 @ x.unsqueeze(1)\n\ntime_step('matmul broadcast p0 @ x.unsqueeze(1)', matmul_broadcast)\n\n# Verify correctness\nr1 = torch.einsum('bhjk,bkc->bhjc', p0, x)\nr2 = bmm_approach()\nr3 = matmul_broadcast()\nprint(f'einsum vs bmm diff: {(r1-r2).abs().max():.2e}')\nprint(f'einsum vs broadcast diff: {(r1-r3).abs().max():.2e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

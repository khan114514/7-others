{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport time, math, torch\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 2, 128, 512, 8, 64  # case 6: alpha=1.0\ng = torch.Generator().manual_seed(17)\nx = torch.randn(B, L, C, generator=g)\n\ndef time_step(name, fn, warmup=3, repeats=11):\n    for _ in range(warmup):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(repeats):\n        fn()\n    t1 = time.process_time_ns()\n    ms = (t1-t0)/1e6/repeats\n    print(f'{name:55s} {ms:8.2f} ms')\n    return ms\n\np = torch.randn(B, H, L, L).softmax(dim=-1)\n\n# Test various approaches for B=2\ntime_step('einsum bhjk,bkc->bhjc', lambda: torch.einsum('bhjk,bkc->bhjc', p, x))\n\ndef reshape_bmm():\n    # (B, H*L, L) @ (B, L, C) = (B, H*L, C)\n    return (p.reshape(B, H*L, L) @ x).reshape(B, H, L, C)\ntime_step('reshape (B,H*L,L) @ x', reshape_bmm)\n\ndef bmm_flat():\n    # (B*H, L, L) @ (B*H, L, C) -> need x tiled\n    pf = p.reshape(B*H, L, L)\n    xf = x.unsqueeze(1).expand(B, H, L, C).reshape(B*H, L, C).contiguous()\n    return (pf @ xf).reshape(B, H, L, C)\ntime_step('bmm flat (B*H,L,L) @ (B*H,L,C)', bmm_flat)\n\n# For comparison: the biggest case\nB2, L2, C2, H2 = 1, 256, 1280, 20\nx2 = torch.randn(B2, L2, C2, generator=g)\np2 = torch.randn(B2, H2, L2, L2).softmax(dim=-1)\n\nprint()\nprint(f'=== B={B2} L={L2} C={C2} H={H2} ===')\ntime_step('einsum bhjk,bkc->bhjc', lambda: torch.einsum('bhjk,bkc->bhjc', p2, x2))\n\ndef reshape_bmm2():\n    return (p2.reshape(B2, H2*L2, L2) @ x2).reshape(B2, H2, L2, C2)\ntime_step('reshape (B,H*L,L) @ x', reshape_bmm2)\n\nr1 = torch.einsum('bhjk,bkc->bhjc', p2, x2)\nr2 = reshape_bmm2()\nprint(f'diff: {(r1-r2).abs().max():.2e}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

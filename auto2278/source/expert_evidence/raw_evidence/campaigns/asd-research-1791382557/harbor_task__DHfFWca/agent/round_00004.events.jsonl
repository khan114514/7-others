max():.2e}')\n\\\"\n\"","aggregated_output":"single (L,L)@(L,C) matmul                                   2.68 ms\npython loop H matmuls                                      86.34 ms\nbmm H heads (expand x)                                     89.39 ms\nmatmul broadcast (H,L,L) @ (1,L,C)                        110.87 ms\nshape: torch.Size([20, 256, 1280])\ndiff: 1.45e+00\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/sh -lc \"cd /workspace && python3 -c \\\"\nimport time, math, torch\ntorch.set_num_threads(1)\ntorch.set_num_interop_threads(1)\n\nB, L, C, H, D = 1, 256, 1280, 20, 64\ng = torch.Generator().manual_seed(17)\nx = torch.randn(B, L, C, generator=g)\n\ndef time_step(name, fn, warmup=3, repeats=11):\n    for _ in range(warmup):\n        fn()\n    t0 = time.process_time_ns()\n    for _ in range(repeats):\n        fn()\n    t1 = time.process_time_ns()\n    ms = (t1-t0)/1e6/repeats\n    print(f'{name:55s} {ms:8.2f} ms')\n    return ms\n\np = torch.randn(B, H, L, L).softmax(dim=-1).softmax(dim=-1)  # (B,H,L,L)\n\n# Let me think about this differently.\n# einsum bhjk,bkc->bhjc\n# This is essentially: for each batch b, head h, token j, channel c: sum_k p[b,h,j,k] * x[b,k,c]\n# \n# For B=1: (H, L, L) @ (L, C)\n# But x is (1, L, C) -> broadcast\n# \n# The einsum handles this efficiently with  for B> B B\n#\n# Let's try: reshape p to (B*H*L, L), x to (L, C), then simple matmul\ndef reshape_matmul():\n    # p_flat = p.reshape(B*H*L, L)  # (B*H*L, L)\n    # x_flat = x.reshape(L, C)  # wait x is (B, L, C), so we need per-batch\n    # No, B=1 case is special. Let me be general.\n    # p: (B,H,L,L), x: (B,L,C)\n    # Output: (B,H,L,C)\n    # Reshape: (B, H*L, L) @ (B, L, C) = (B, H*L, C) -> (B, H, L, C)\n    pr = p.reshape(B, H*L, L)\n    return (pr @ x).reshape(B, H, L, C)\n\ntime_step('reshape (B,H*L,L) @ (B,L,C)', reshape_matmul)\n\nr1 = torch.einsum('bhjk,bkc->bhjc', p, x)\nr2 = reshape_matmul()\nprint(f'diff: {(r1-r2).abs().max():.2e}')\n\n# shape check\nprint(f'shape r1: {r1.shape}, shape r2: {r2.shape}')\n\\\"\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/sh -lc \"OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 python - <<'PY'\nimport torch,time,importlib.util\n\ntorch.set_num_threads(1)\nspec=importlib.util.spec_from_file_location('candidate','/workspace/solution/method.py');m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)\nwith torch.inference_mode():\n    for length,heads in [(128,10),(128,20),(256,10),(256,20)]:\n        a=torch.randn(1,2*heads*length,length)\n        x=torch.randn(1,length,1280)\n        f=torch.linalg.cholesky(x @ x.transpose(1,2))\n        expected=m.factored_norms(a,f)\n        def transposed():\n            squared=a.new_zeros((1,a.shape[1],1))\n            for start in range(0,length,64):\n                end=min(start+64,length)\n                v=torch.mm(f[0,start:,start:end].t(),a[0,:,start:].t())\n                squared[0,:,0].add_(v.norm(dim=0).square_())\n            return squared.clamp_min_(1e-12)\n        def fulltransposed():\n            v=torch.mm(f[0].t(),a[0].t())\n            return v.norm(dim=0).square_().reshape(1,-1,1).clamp_min_(1e-12)\n        def panel_einsum():\n            squared=a.new_zeros((1,a.shape[1],1))\n            for start in range(0,length,64):\n                end=min(start+64,length)\n                v=torch.mm(f[0,start:,start:end].t(),a[0,:,start:].t())\n                squared[0,:,0].add_(torch.einsum('ir,ir->r',v,v))\n            return squared.clamp_min_(1e-12)\n        print('shape',length,heads,flush=True)\n        for name,fn in [('panels',lambda:m.factored_norms(a,f)),('transposed',transposed),('fulltransposed',fulltransposed),('einsum',panel_einsum)]:\n            actual=fn()\n            print(name,'relerror',((actual-expected).abs()/expected).max().item(),end=' ',flush=True)\n            for _ in range(3):fn()\n            ts=[]\n            for _ in range(7):\n                t=time.process_time_ns();fn();ts.append((time.process_time_ns()-t)/1e6)\n            print(sorted(ts)[3],flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

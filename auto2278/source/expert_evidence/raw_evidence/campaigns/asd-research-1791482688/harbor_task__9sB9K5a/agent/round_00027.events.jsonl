{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/sh -lc \"OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 python - <<'PY'\nimport torch, time, importlib.util\n\ntorch.set_num_threads(1)\nspec=importlib.util.spec_from_file_location('candidate','/workspace/solution/method.py')\nm=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)\nwith torch.inference_mode():\n    for length,heads in [(128,10),(128,20),(256,10),(256,20)]:\n        a=torch.randn(1,2*heads*length,length)\n        f=torch.randn(1,length,length).tril()\n        expected=m.factored_norms(a,f)\n        print('shape',length,heads,flush=True)\n        funcs=[('panels',lambda:m.factored_norms(a,f))]\n        for block in [16,32,64]:\n            def sparse_norm(block=block):\n                ft=f[0].t().to_sparse_bsr((block,block))\n                v=torch.sparse.mm(ft,a[0].t())\n                return v.norm(dim=0).square_().reshape(1,-1,1).clamp_min_(1e-12)\n            funcs.append(('sparse'+str(block),sparse_norm))\n        for name,fn in funcs:\n            try:\n                actual=fn()\n                print(name,'relerror',((actual-expected).abs()/expected).max().item(),end=' ',flush=True)\n                for _ in range(3):fn()\n                ts=[]\n                for _ in range(5):\n                    t=time.process_time_ns();fn();ts.append((time.process_time_ns()-t)/1e6)\n                print(sorted(ts)[2],flush=True)\n            except Exception as e:print(type(e).__name__,str(e),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

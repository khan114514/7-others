{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/sh -lc \"OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 python - <<'PY'\nimport torch,time,importlib.util\n\ntorch.set_num_threads(1)\nspec=importlib.util.spec_from_file_location('candidate','/workspace/solution/method.py');m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)\nwith torch.inference_mode():\n    for length,channels,heads in [(64,512,8),(128,640,10),(128,1280,20),(256,1280,20),(256,640,10)]:\n        x=torch.randn(1,length,channels)\n        w=[torch.randn(heads,64,channels) for _ in range(3)]\n        def head_packed():\n            weights=torch.cat(w,dim=1)\n            projected=torch.bmm(weights,x[0].t().expand(heads,-1,-1))\n            q,k,v=projected.reshape(heads,3,64,length).permute(1,0,3,2).unbind(0)\n            return q.unsqueeze(0),k.unsqueeze(0),v.unsqueeze(0),torch.bmm(x,x.transpose(-1,-2))\n        def grouped_packed():\n            group=2\n            weights=torch.cat(w,dim=1).reshape(heads//group,group*3*64,channels)\n            projected=torch.bmm(weights,x[0].t().expand(heads//group,-1,-1))\n            q,k,v=projected.reshape(heads,3,64,length).permute(1,0,3,2).unbind(0)\n            return q.unsqueeze(0),k.unsqueeze(0),v.unsqueeze(0),torch.bmm(x,x.transpose(-1,-2))\n        expected=m.project_qkv(x,*w,True)\n        print('shape',length,channels,heads,flush=True)\n        for name,fn in [('packed',lambda:m.project_qkv(x,*w,True)),('head_packed',head_packed),('grouped_packed',grouped_packed)]:\n            out=fn()\n            print(name,'maxerror',max((a-b).abs().max().item() for a,b in zip(out,expected)),end=' ',flush=True)\n            for _ in range(3):fn()\n            ts=[]\n            for _ in range(7):\n                t=time.process_time_ns();fn();ts.append((time.process_time_ns()-t)/1e6)\n            print(sorted(ts)[3],flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

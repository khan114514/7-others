{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/sh -lc \"OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 python - <<'PY'\nimport torch,time,importlib.util\n\ntorch.set_num_threads(1)\nspec=importlib.util.spec_from_file_location('candidate','/workspace/solution/method.py');m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)\nwith torch.inference_mode():\n    for length,channels,heads in [(64,512,8),(128,640,10),(128,1280,20),(256,1280,20),(256,640,10)]:\n        x=torch.randn(1,length,channels)\n        w=[torch.randn(heads,64,channels) for _ in range(3)]\n        def native_linear():\n            weights=torch.cat((*[v.reshape(-1,channels) for v in w],x[0]))\n            p=torch.nn.functional.linear(x[0].to_mkldnn(),weights).to_dense()\n            q,k,v=p[:,:3*heads*64].reshape(1,length,3,heads,64).permute(2,0,3,1,4).unbind(0)\n            return q,k,v,p[:,3*heads*64:].unsqueeze(0)\n        def convolution():\n            weights=torch.cat((*[v.reshape(-1,channels) for v in w],x[0])).unsqueeze(-1)\n            p=torch.nn.functional.conv1d(x.transpose(1,2),weights)\n            q,k,v=p[:,:3*heads*64].reshape(1,3,heads,64,length).permute(1,0,2,4,3).unbind(0)\n            return q,k,v,p[:,3*heads*64:]\n        expected=m.project_qkv(x,*w,True)\n        print('shape',length,channels,heads,flush=True)\n        for name,fn in [('packed',lambda:m.project_qkv(x,*w,True)),('mkldnn_linear',native_linear),('conv1d',convolution)]:\n            actual=fn()\n            print(name,'maxerror',max((a-b).abs().max().item() for a,b in zip(actual,expected)),end=' ',flush=True)\n            for _ in range(2):fn()\n            ts=[]\n            for _ in range(5):\n                t=time.process_time_ns();fn();ts.append((time.process_time_ns()-t)/1e6)\n            print(sorted(ts)[2],flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}

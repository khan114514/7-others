2)[:,:,None] - 2*torch.bmm(A,B.transpose(1,2)) + (B*B).sum(2)[:,None,:])/2\n    amask = torch.arange(nmax)[None,:] < an[:,None]\n    bmask = torch.arange(mmax)[None,:] < bn[:,None]\n    C.masked_fill_(~(amask[:,:,None] & bmask[:,None,:]), float('inf'))\n    valid=amask[:,:,None]&bmask[:,None,:]\n    aw=torch.zeros((100,nmax));bw=torch.zeros((100,mmax))\n    for i,(_,w,_) in enumerate(ac):aw[i*10:(i+1)*10,:len(w)]=w\n    for j,(_,w,_) in enumerate(bc):bw[j::10,:len(w)]=w\n    lwa=torch.where(amask,aw.log(),0.);lwb=torch.where(bmask,bw.log(),0.)\n    K=None;pe=None;shift=None;rs=None;cs=None;pa=None\n    def direct(f,g,eps):\n        R=(C-f[:,:,None]).sub_(g[:,None,:])\n        if float(eps.max())<=8.:\n            ft=f+(R-eps[:,None,None]*lwb[:,None,:]).amin(2)\n            gt=g+(R-eps[:,None,None]*lwa[:,:,None]).amin(1)\n            return torch.where(amask,ft,0.),torch.where(bmask,gt,0.),None,None,None,None\n        rm=R.amin((1,2))\n        K=R.sub_(rm[:,None,None]).mul_((-1.4426950408889634/eps)[:,None,None]).exp2_()\n        rs=torch.bmm(K,bw[:,:,None]).squeeze(2);cs=torch.bmm(K.transpose(1,2),aw[:,:,None]).squeeze(2)\n        check=torch.minimum(torch.where(amask,rs,float('inf')).amin(1),torch.where(bmask,cs,float('inf')).amin(1))\n        if float((check/torch.maximum(rs.amax(1),cs.amax(1))).min())>2e-22:\n            ft=f+rm[:,None]-eps[:,None]*rs.log()\n            gt=g+rm[:,None]-eps[:,None]*cs.log()\n            return torch.where(amask,ft,0.),torch.where(bmask,gt,0.),K,rm,rs,cs\n        v=(g[:,None,:]-C)/eps[:,None,None]+lwb[:,None,:]\n        ft=-eps[:,None]*v.logsumexp(2)\n        v=(f[:,:,None]-C)/eps[:,None,None]+lwa[:,:,None]\n        gt=-eps[:,None]*v.logsumexp(1)\n        return torch.where(amask,ft,0.),torch.where(bmask,gt,0.),None,None,None,None\n    eps=torch.tensor([z[0] for z in schedules])\n    f,g,K,shift,rs,cs=direct(torch.zeros((100,nmax)),torch.zeros((100,mmax)),eps)\n    pe=eps;pa=torch.ones((100,1),dtype=torch.bool);full=True\n    for t
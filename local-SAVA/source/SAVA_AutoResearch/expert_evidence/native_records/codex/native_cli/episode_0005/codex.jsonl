{"type": "item.started", "item": {"id": "item_20", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/research_history/build_episode5_approx.py <<'PY'\nfrom pathlib import Path\nroot=Path('/tmp/research_history');base=(root/'162_precomputed_norm_geometry/method.py').read_text()\nfor scope,dtype,name in [('point','float16','176_half_point_kernel'),('class','float16','177_half_class_kernel'),('both','float16','178_half_both_kernel'),('point','bfloat16','179_bfloat_point_kernel')]:\n s=base\n beg=s.index('def _dual(');end=s.index('\\\\n\\\\ndef _label_cost(',beg)\n if scope in ('point','both'):\n  blk=s[beg:end]\n  blk=blk.replace('rs=R.sum(1);cs=R.sum(0)','rs=R.sum(1);cs=R.sum(0)')\n  blk=blk.replace(',R,rm,rs,cs',',R.to(torch.'+dtype+'),rm,rs,cs')\n  blk=blk.replace('rs=K.sum(1);cs=K.sum(0)','rs=K.sum(1,dtype=torch.float32);cs=K.sum(0,dtype=torch.float32)')\n  s=s[:beg]+blk+s[end:]\n if scope in ('class','both'):\n  beg=s.index('def _label_cost(');end=s.index('\\\\n\\\\ndef _expectation(',beg)\n  blk=s[beg:end].replace(',K,rm,rs,cs',',K.to(torch.'+dtype+'),rm,rs,cs')\n  blk=blk.replace('rs=K.sum(2);cs=K.sum(1)','rs=K.sum(2,dtype=torch.float32);cs=K.sum(1,dtype=torch.float32)')\n  s=s[:beg]+blk+s[end:]\n p=root/name;p.mkdir(exist_ok=True);(p/'method.py').write_text(s)\ncoarse='''def _coarse_setup(a,b,ya,yb,W,degree):\n    A=torch.from_numpy(a);B=torch.from_numpy(b)\n    center=(A.mean(0)+B.mean(0))/2\n    A=A-center;B=B-center\n    an=A.square().sum(1)/2;bn=B.square().sum(1)/2\n    ia=torch.from_numpy(ya);ib=torch.from_numpy(yb)\n    onea=torch.ones((len(a),1));oneb=torch.ones((len(b),1))\n    if degree==1:\n        PA=torch.cat((onea,A),1);PB=torch.cat((oneb,B),1)\n        powers=torch.tensor([0.]+[1.]*10)\n    else:\n        qi=torch.triu_indices(A.shape[1],A.shape[1])\n        fac=torch.where(qi[0]==qi[1],2.**.5,1.)\n        PA=torch.cat((onea,A,A[:,qi[0]]*A[:,qi[1]]/fac),1)\n        PB=torch.cat((oneb,B,B[:,qi[0]]*B[:,qi[1]]/fac),1)\n        powers=torch.tensor([0.]+[1.]*10+[2.]*len(fac))\n    labels=torch.from_numpy(W[:10,10:])/2\n    def grouped(T,idx):\n        out=torch.zeros((10,T.shape[1]))\n        out.scatter_add_(0,idx[:,None].expand_as(T),T)\n        return out\n    def transform(f,g,eps):\n        alpha=eps**(-powers)\n        L=torch.exp(-labels/eps)\n        fm=f.max();gm=g.max()\n        ua=torch.exp((f-fm-an)/eps);vb=torch.exp((g-gm-bn)/eps)\n        mb=grouped(PB*vb[:,None],ib);ma=grouped(PA*ua[:,None],ia)\n        dena=(PA*((L @ mb)[ia]*alpha)).sum(1)\n        denb=(PB*((L.T @ ma)[ib]*alpha)).sum(1)\n        if float(torch.minimum(dena.min(),denb.min()))<=0.:return None\n        return an-gm-eps*(dena/len(b)).log(),bn-fm-eps*(denb/len(a)).log()\n    return transform\n\n'''\nfor degree,steps,name in [(1,2,'180_moment1_coarse2'),(2,2,'181_moment2_coarse2'),(2,3,'182_moment2_coarse3'),(2,4,'183_moment2_coarse4')]:\n s=base.replace('def _dual(C, schedule):','def _dual(C, schedule, a,b,ya,yb,W):')\n s=s.replace('    f,g,K,shift,rs,cs=direct(torch.zeros(n),torch.zeros(m),schedule[0])\\\\n    pe=schedule[0];full=True\\\\n    for eps in schedule[2:-3]:', '''    coarse=_coarse_setup(a,b,ya,yb,W,DEGREE)\n    fg=coarse(torch.zeros(n),torch.zeros(m),schedule[0])\n    if fg is None:\n        f,g,K,shift,rs,cs=direct(torch.zeros(n),torch.zeros(m),schedule[0])\n    else:f,g=fg;K=None\n    pe=schedule[0];full=True\n    for step,eps in enumerate(schedule[2:-3],1):\n        if step<STEPS:\n            fg=coarse(f,g,eps)\n            if fg is not None:\n                ft,gt=fg;f=(f+ft)*.5;g=(g+gt)*.5;pe=eps;full=False;K=None\n                continue'''.replace('DEGREE',str(degree)).replace('STEPS',str(steps)))\n s=s.replace('\\\\ndef _dual(', '\\\\n'+coarse+'\\\\ndef _dual(')\n s=s.replace('_dual(T,_schedule(z1,z2))','_dual(T,_schedule(z1,z2),a,b,y[idx],ry[jdx],W)')\n p=root/name;p.mkdir(exist_ok=True);(p/'method.py').write_text(s)\nwith (root/'episode_5_working_notes.md').open('a') as f:\n f.write('\\\\n176-1
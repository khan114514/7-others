,bn,B))\n    moment=grouped((PB[:,:,None]*fields[:,None,:]*(bk*v)[:,None,None]).flatten(1),ib)\n    contractions=((L @ moment)[ia].reshape(n,k,12)*PA[:,:,None]).sum(1)\n    zeroth=contractions[:,0]\n    numerator=an*zeroth+contractions[:,1]-(A*contractions[:,2:]).sum(1)\n    moment=grouped(PB*(bk*v)[:,None],ib)\n    numerator+=(PA*((L*labels) @ moment)[ia]).sum(1)\n    return float((numerator/zeroth).mean())\n'''\nstart=base.index('def _expectation(');end=base.index('\\n\\ndef _outer(',start)\ns=base[:start]+base[start:end].replace('def _expectation','def _dense_expectation')+'\\n\\n'+new+base[end:]\ns=s.replace('import numpy as np','import numpy as np\\nimport math\\nfrom itertools import combinations_with_replacement')\ns=s.replace('_expectation(T)/(len(idx)+len(jdx))','_expectation(T,a,b,y[idx],ry[jdx],W)/(len(idx)+len(jdx))')\nfor d in [1,2,3]:\n name={1:'166_taylor_coupling_degree1',2:'167_taylor_coupling_degree2',3:'168_taylor_coupling_degree3'}[d]\n p=root/name;p.mkdir(exist_ok=True);(p/'method.py').write_text(s.replace('DEGREE',str(d)))\nfrom pathlib import Path\nroot=Path('/tmp/research_history')\nfor degree,name in [(2,'169_taylor2_class_matmul'),(3,'170_taylor3_class_matmul')]:\n s=(root/('167_taylor_coupling_degree2' if degree==2 else '168_taylor_coupling_degree3')/'method.py').read_text()\n old='''    contractions=((L @ moment)[ia].reshape(n,k,12)*PA[:,:,None]).sum(1)\n'''\n new='''    moment=(L @ moment).reshape(10,k,12)\n    contractions=torch.empty((n,12))\n    for i in range(10):\n        mask=ia==i\n        contractions[mask]=PA[mask] @ moment[i]\n'''\n s=s.replace(old,new)\n p=root/name;p.mkdir(exist_ok=True);(p/'method.py').write_text(s)\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_15", "type": "command_execution", "command": "/bin/sh -lc 'cat /tmp/research_history/040_active_edges_2_final/method.py /tmp/research_history/146_stream_hard_reductions/method.py'", "aggregated_output": "\"\"\"Hierarchical transport with reusable costs and explicit annealed dual solves.\"\"\"\nimport numpy as np\nimport torch\nimport ot\nfrom scipy.spatial.distance import cdist\n\n\ndef _schedule(a, b):\n    lo = torch.minimum(a.amin(0), b.amin(0))\n    hi = torch.maximum(a.amax(0), b.amax(0))\n    diameter = float(torch.linalg.vector_norm(hi - lo))\n    return [diameter**2] + [float(np.exp(e)) for e in np.arange(2*np.log(diameter), np.log(.1), 2*np.log(.5))] + [.1]\n\n\ndef _dual(C, schedule):\n    D=C.T.contiguous()\n    n,m=C.shape\n    la=float(np.log(np.float32(1./n)))\n    lb=float(np.log(np.float32(1./m)))\n    cmin=float(C.min()); span=float(C.max())-cmin\n    base=cmin-C\n    kernel=None; kernel_eps=None; edges=None\n    def lse(T,h,eps,lw):\n        return -eps*(h[None,:]/eps+lw-T/eps).logsumexp(1)\n    def transforms(f,g,eps):\n        nonlocal kernel,kernel_eps,edges\n        if eps<=8.:\n            if edges is None:\n                R=C-f[:,None]-g[None,:]\n                ri=R.topk(2,dim=1,largest=False,sorted=False).indices;ci=R.topk(2,dim=0,largest=False,sorted=False).indices\n                rows=torch.cat((torch.arange(n).repeat_interleave(2),ci.reshape(-1)))\n                cols=torch.cat((ri.reshape(-1),torch.arange(m).repeat(2)))\n                edge_cost=C[rows,cols]\n                edges=rows,cols,edge_cost\n            rows,cols,edge_cost=edges\n            ft=torch.full((n,),float('inf'))\n            gt=torch.full((m,),float('inf'))\n            ft.scatter_reduce_(0,rows,edge_cost-g[cols],reduce='amin')\n            gt.scatter_reduce_(0,cols,edge_cost-f[rows],reduce='amin')\n            return ft-eps*lb,gt-eps*la\n        if span/eps<60.:\n            key=float(np.float32(eps))\n            if kernel_eps!=key:\n                kernel=torch.exp(base/eps);kernel_eps=key\n            K=kernel\n            fm=float(f.max());gm=float(g.max())\n            ft=cmin-gm-eps*((K @ torch.exp((g-gm)/eps)).log()+lb)\n            gt=cmin-fm-eps*((K.T @ torch.exp((f-fm)/eps)).log()+la)\n            if bool(torch.isfinite(ft).all()) and bool(torch.isfinite(gt).all()):\n                return ft,gt\n        return lse(C,g,eps,lb),lse(D,f,eps,la)\n    eps=schedule[0]\n    f,g=transforms(torch.zeros(n),torch.zeros(m),eps)\n    for eps in schedule:\n        ft,gt=transforms(f,g,eps)\n        f,g=(f+ft)*.5,(g+gt)*.5\n    return C.sub(g[None,:]).amin(1)-eps*lb, D.sub(f[None,:]).amin(1)-eps*la\n\n\ndef _label_cost(x, y, r, ry):\n    aa = [torch.from_numpy(x[y == i]) for i in range(10)]\n    bb = [torch.from_numpy(r[ry == j]) for j in range(10)]\n    pairs = [(a, b) for a in aa for b in bb]\n    nmax = max(len(a) for a in aa)\n    mmax = max(len(b) for b in bb)\n    A = torch.zeros((100, nmax, x.shape[1]))\n    B = torch.zeros((100, mmax, r.shape[1]))\n    an = torch.tensor([len(a) for a, b in pairs])\n    bn = torch.tensor([len(b) for a, b in pairs])\n    schedules = []\n    for k, (a, b) in enumerate(pairs):\n        A[k, :len(a)] = a\n        B[k, :len(b)] = b\n        schedules.append(_schedule(a, b))\n    C = ((A*A).sum(2)[:,:,None] - 2*torch.bmm(A,B.transpose(1,2)) + (B*B).sum(2)[:,None,:])/2\n    amask = torch.arange(nmax)[None,:] < an[:,None]\n    bmask = torch.arange(mmax)[None,:] < bn[:,None]\n    C.masked_fill_(~(amask[:,:,None] & bmask[:,None,:]), float('inf'))\n    D = C.transpose(1,2).contiguous()\n    la = (1/an.float()).log()[:,None]\n    lb = (1/bn.float()).log()[:,None]\n    cmin=C.amin((1,2))\n    span=torch.where(amask[:,:,None]&bmask[:,None,:],C,0.).amax((1,2))-cmin\n    base=cmin[:,None,None]-C\n    kernel=None;kernel_eps=None\n    def transform(T,h,eps,lw,outmask):\n        v=(h[:,None,:]-T)/eps[:,None,None]\n        out=-eps[:,None]*v.logsumexp(2)-eps[:,None]*lw\n        return torch.where(outmask,out,0.)\n    def transforms(f,g,eps):\n        nonlocal kernel,kernel_eps\n        if float(eps.max())<=8.:\n            R=C-f[:,:,None]-g[:,None,:]\n            ft=f+R.amin(2)-eps[:,None]*lb\n            gt=g+R.amin(1)-eps[:,None]*la\n            return torch.where(amask,ft,0.),torch.where(bmask,gt,0.)\n        if float((span/eps).max())<60.:\n            if kernel_eps is None or not torch.equal(eps,kernel_eps):\n                kernel=torch.exp(base/eps[:,None,None]);kernel_eps=eps\n            K=kernel\n            fm=f.amax(1);gm=g.amax(1)\n            gv=torch.exp((g-gm[:,None])/eps[:,None])*bmask\n            fv=torch.exp((f-fm[:,None])/eps[:,None])*amask\n            ft=cmin[:,None]-gm[:,None]-eps[:,None]*(torch.bmm(K,gv[:,:,None]).squeeze(2).log()+lb)\n            gt=cmin[:,None]-fm[:,None]-eps[:,None]*(torch.bmm(K.transpose(1,2),fv[:,:,None]).squeeze(2).log()+la)\n            ft=torch.where(amask,ft,0.);gt=torch.where(bmask,gt,0.)\n            if bool(torch.isfinite(ft).all()) and bool(torch.isfinite(gt).all()):\n                return ft,gt\n        return transform(C,g,eps,lb,amask),transform(D,f,eps,la,bmask)\n    eps=torch.tensor([z[0] for z in schedules])\n    f,g=transforms(torch.zeros((100,nmax)),torch.zeros((100,mmax)),eps)\n    for t in range(max(len(z) for z in schedules)):\n        eps=torch.tensor([z[t] if t<len(z) else .1 for z in schedules])\n        active=torch.tensor([t<len(z) for z in schedules])[:,None]\n        ft,gt=transforms(f,g,eps)\n        f=torch.where(active,(f+ft)*.5,f)\n        g=torch.where(active,(g+gt)*.5,g)\n    eps=torch.full((100,),.1)\n    ft,gt=transforms(f,g,eps)\n    costs=(ft/an[:,None]).sum(1)+(gt/bn[:,None]).sum(1)\n    W=np.zeros((20,20),np.float32)\n    W[:10,10:]=costs.numpy().reshape(10,10)\n    W[10:,:10]=W[:10,10:].T\n    return W\n\n\ndef _expectation(C):\n    n,m=C.shape\n    K=torch.exp(C/(-.1*float(C.max())))\n    u=torch.full((n,),1./n)\n    v=torch.full((m,),1./m)\n    D=K.T.contiguous()\n    for it in range(3):\n        v=(1./m)/(D @ u)\n        u=(1./n)/(K @ v)\n    return float(torch.dot(u,(K*C) @ v))\n\n\ndef value(x, y, r, ry, seed=17, batch_size=1024):\n    torch.set_num_threads(2)\n    x=np.asarray(x,np.float32); r=np.asarray(r,np.float32)\n    y=np.asarray(y,np.int64); ry=np.asarray(ry,np.int64)\n    tx=[np.arange(i,min(i+batch_size,len(x))) for i in range(0,len(x),batch_size)]\n    tr=[np.arange(i,min(i+batch_size,len(r))) for i in range(0,len(r),batch_size)]\n    with torch.inference_mode():\n        W=_label_cost(x[tx[0]],y[tx[0]],r[tr[0]],ry[tr[0]])\n        F={}; batchcost=np.zeros((len(tx),len(tr)))\n        for i,idx in enumerate(tx):\n            for j,jdx in enumerate(tr):\n                a=x[idx]; b=r[jdx]\n                T=torch.cdist(torch.from_numpy(a),torch.from_numpy(b)).square()/2\n                T+=torch.from_numpy(W)[y[idx,None],ry[jdx][None,:]+10]/2\n                batchcost[i,j]=_expectation(T)/(len(idx)+len(jdx))\n                z1=torch.tensor(np.column_stack([a,y[idx]]),dtype=torch.float32)\n                z2=torch.tensor(np.column_stack([b,ry[jdx]+10]),dtype=torch.float32)\n                # Reuse the same empirical geometry for coupling and point potentials.\n                f,_=_dual(T,_schedule(z1,z2))\n                f=f.numpy().ravel().astype(float)\n                F[i,j]=(f-f.mean())*len(f)/(len(f)-1)\n    Q=ot.sinkhorn(ot.unif(len(tx)),ot.unif(len(tr)),batchcost/max(float(batchcost.max()),1e-12),.01,numItermax=10000,stopThr=1e-10)\n    values=np.zeros(len(x))\n    for i,idx in enumerate(tx): values[idx]=sum(Q[i,j]*F[i,j] for j in range(len(tr)))\n    return values\n\"\"\"Hierarchical transport with reusable costs and explicit annealed dual solves.\"\"\"\nimport numpy as np\nimport torch\nimport ot\nfrom scipy.spatial.distance import cdist\n\n\ndef _schedule(a, b):\n    lo = torch.minimum(a.amin(0), b.amin(0))\n    hi = torch.maximum(a.amax(0), b.amax(0))\n    diameter = float(torch.linalg.vector_norm(hi - lo))\n    return [diameter**2] + [float(np.exp(e)) for e in np.arange(2*np.log(diameter), np.log(.1), 2*np.log(.5))] + [.1]\n\n\ndef _dual(C, schedule):\n    n,m=C.shape\n    la=float(np.log(np.float32(1./n)));lb=float(np.log(np.float32(1./m)))\n    K=None; pe=None; shift=0.\n    def direct(f,g,eps):\n        if eps<=2.:\n            ft=torch.empty(n);gt=torch.full((m,),float('inf'))\n            for i in range(0,n,128):\n                R=C[i:i+128]-f[i:i+128,None];R-=g[None,:]\n                ft[i:i+128]=f[i:i+128]+R.amin(1)-eps*lb\n                gt=torch.minimum(gt,R.amin(0))\n            return ft,g+gt-eps*la,None,0.,None,None\n        R=C-f[:,None];R-=g[None,:]\n        rm=float(R.min());R-=rm;R*=(-1./eps)\n        R.clamp_(min=-80.).exp_()\n        rs=R.sum(1);cs=R.sum(0)\n        if min(float(rs.min()),float(cs.min()))<=2e-22:\n            R=C-f[:,None];R-=g[None,:];R*=(-1./eps)\n            rowmax=R.amax(1);colmax=R.amax(0)\n            rr=torch.exp(R-rowmax[:,None]).sum(1);cc=torch.exp(R-colmax[None,:]).sum(0)\n            return f-eps*(rowmax+rr.log()+lb),g-eps*(colmax+cc.log()+la),None,0.,None,None\n        return f+rm-eps*(rs.log()+lb),g+rm-eps*(cs.log()+la),R,rm,rs,cs\n    f,g,K,shift,rs,cs=direct(torch.zeros(n),torch.zeros(m),schedule[0])\n    pe=schedule[0];full=True\n    for eps in schedule[2:-3]:\n        if K is None or eps<=2.:\n            ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        else:\n            old_shift=shift\n            if full:\n                K.mul_((m/rs)[:,None]).mul_((n/cs)[None,:])\n            else:\n                K.mul_((m/rs).sqrt()[:,None]).mul_((n/cs).sqrt()[None,:])\n            if abs(pe/eps-4.)<1e-5:\n                K.square_().square_()\n            else:K.pow_(pe/eps)\n            shift=-old_shift if full else 0.\n            rs=K.sum(1);cs=K.sum(0)\n            if min(float(rs.min()/rs.max()),float(cs.min()/cs.max()))>2e-22:\n                ft=f+shift-eps*(rs.log()+lb);gt=g+shift-eps*(cs.log()+la)\n            else:ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        f=(f+ft)*.5;g=(g+gt)*.5;pe=eps;full=False\n    return (C-g[None,:]).amin(1)-.1*lb,None\n\n\ndef _label_cost(x, y, r, ry):\n    aa = [torch.from_numpy(x[y == i]) for i in range(10)]\n    bb = [torch.from_numpy(r[ry == j]) for j in range(10)]\n    pairs = [(a, b) for a in aa for b in bb]\n    nmax = max(len(a) for a in aa)\n    mmax = max(len(b) for b in bb)\n    A = torch.zeros((100, nmax, x.shape[1]))\n    B = torch.zeros((100, mmax, r.shape[1]))\n    an = torch.tensor([len(a) for a, b in pairs])\n    bn = torch.tensor([len(b) for a, b in pairs])\n    schedules = []\n    for k, (a, b) in enumerate(pairs):\n        A[k, :len(a)] = a\n        B[k, :len(b)] = b\n        schedules.append(_schedule(a, b))\n    C = ((A*A).sum(2)[:,:,None] - 2*torch.bmm(A,B.transpose(1,2)) + (B*B).sum(2)[:,None,:])/2\n    amask = torch.arange(nmax)[None,:] < an[:,None]\n    bmask = torch.arange(mmax)[None,:] < bn[:,None]\n    C.masked_fill_(~(amask[:,:,None] & bmask[:,None,:]), float('inf'))\n    valid=amask[:,:,None]&bmask[:,None,:]\n    la=(1/an.float()).log()[:,None];lb=(1/bn.float()).log()[:,None]\n    K=None;pe=None;shift=None;rs=None;cs=None;pa=None\n    def direct(f,g,eps):\n        R=(C-f[:,:,None]).sub_(g[:,None,:])\n        if float(eps.max())<=8.:\n            ft=f+R.amin(2)-eps[:,None]*lb\n            gt=g+R.amin(1)-eps[:,None]*la\n            return torch.where(amask,ft,0.),torch.where(bmask,gt,0.),None,None,None,None\n        rm=R.amin((1,2))\n        K=R.sub_(rm[:,None,None]).div_(eps[:,None,None]).neg_().clamp_(min=-80.).exp_()\n        K.masked_fill_(~valid,0.)\n        rs=K.sum(2);cs=K.sum(1)\n        check=torch.minimum(torch.where(amask,rs,float('inf')).amin(1),torch.where(bmask,cs,float('inf')).amin(1))\n        if float((check/torch.maximum(rs.amax(1),cs.amax(1))).min())>2e-22:\n            ft=f+rm[:,None]-eps[:,None]*(rs.log()+lb)\n            gt=g+rm[:,None]-eps[:,None]*(cs.log()+la)\n            return torch.where(amask,ft,0.),torch.where(bmask,gt,0.),K,rm,rs,cs\n        v=(g[:,None,:]-C)/eps[:,None,None]\n        ft=-eps[:,None]*(v.logsumexp(2)+lb)\n        v=(f[:,:,None]-C)/eps[:,None,None]\n        gt=-eps[:,None]*(v.logsumexp(1)+la)\n        return torch.where(amask,ft,0.),torch.where(bmask,gt,0.),None,None,None,None\n    eps=torch.tensor([z[0] for z in schedules])\n    f,g,K,shift,rs,cs=direct(torch.zeros((100,nmax)),torch.zeros((100,mmax)),eps)\n    pe=eps;pa=torch.ones((100,1),dtype=torch.bool);full=True\n    for t in range(2,max(map(len,schedules))):\n        eps=torch.tensor([z[t] if t<len(z) else .1 for z in schedules])\n        active=torch.tensor([t<len(z) for z in schedules])[:,None]\n        if K is None or float(eps.max())<=8.:\n            ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        else:\n            if full:\n                ar=torch.where(amask,rs/bn[:,None],1.)\n                bc=torch.where(bmask,cs/an[:,None],1.)\n            else:\n                ar=torch.where(amask & pa,(rs/bn[:,None]).sqrt(),1.)\n                bc=torch.where(bmask & pa,(cs/an[:,None]).sqrt(),1.)\n            K.mul_(ar.reciprocal()[:,:,None]).mul_(bc.reciprocal()[:,None,:])\n            q=pe/eps\n            if bool(torch.all(torch.abs(q-4.)<1e-4)):K.square_().square_()\n            else:K.pow_(q[:,None,None])\n            shift=-shift if full else torch.where(pa[:,0],0.,shift)\n            rs=K.sum(2);cs=K.sum(1)\n            check=torch.minimum(torch.where(amask,rs,float('inf')).amin(1),torch.where(bmask,cs,float('inf')).amin(1))\n            if float((check/torch.maximum(rs.amax(1),cs.amax(1))).min())>2e-22:\n                ft=f+shift[:,None]-eps[:,None]*(rs.log()+lb)\n                gt=g+shift[:,None]-eps[:,None]*(cs.log()+la)\n                ft=torch.where(amask,ft,0.);gt=torch.where(bmask,gt,0.)\n            else:ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        f=torch.where(active,(f+ft)*.5,f);g=torch.where(active,(g+gt)*.5,g)\n        pe=eps;pa=active;full=False\n    ft,gt,_,_,_,_=direct(f,g,torch.full((100,),.1))\n    costs=(ft/an[:,None]).sum(1)+(gt/bn[:,None]).sum(1)\n    W=np.zeros((20,20),np.float32)\n    W[:10,10:]=costs.numpy().reshape(10,10);W[10:,:10]=W[:10,10:].T\n    return W\n\n\ndef _expectation(C):\n    n,m=C.shape\n    K=torch.exp(C/(-.1*float(C.max())))\n    v=(n/m)/K.sum(0)\n    u=(1./n)/(K*v[None,:]).sum(1)\n    v=(1./m)/(K*u[:,None]).sum(0)\n    den=(K*v[None,:]).sum(1)\n    K.mul_(C)\n    return float(((K*v[None,:]).sum(1)/den).mean())\n\n\ndef _outer(batchcost):\n    n,m=batchcost.shape\n    cost=batchcost/max(float(batchcost.max()),1e-12)\n    if m!=2:\n        return ot.sinkhorn(ot.unif(n),ot.unif(m),cost,.01,numItermax=10000,stopThr=1e-10)\n    d=(cost[:,1]-cost[:,0])/.01\n    lo=-float(d.max())-40.;hi=-float(d.min())+40.\n    z=-float(d.mean())\n    for it in range(50):\n        s=1./(1.+np.exp(-np.clip(d+z,-700.,700.)))\n        err=float(s.mean())-.5\n        if abs(err)<1e-13:break\n        if err>0.:hi=z\n        else:lo=z\n        deriv=float((s*(1.-s)).mean())\n        next_z=z-err/max(deriv,1e-30)\n        z=next_z if lo<next_z<hi else (lo+hi)/2.\n    return np.column_stack((s,1.-s))/n\n\n\ndef value(x, y, r, ry, seed=17, batch_size=1024):\n    torch.set_flush_denormal(True)\n    torch.set_num_threads(2)\n    x=np.asarray(x,np.float32); r=np.asarray(r,np.float32)\n    y=np.asarray(y,np.int64); ry=np.asarray(ry,np.int64)\n    tx=[np.arange(i,min(i+batch_size,len(x))) for i in range(0,len(x),batch_size)]\n    tr=[np.arange(i,min(i+batch_size,len(r))) for i in range(0,len(r),batch_size)]\n    with torch.inference_mode():\n        W=_label_cost(x[tx[0]],y[tx[0]],r[tr[0]],ry[tr[0]])\n        F={}; batchcost=np.zeros((len(tx),len(tr)))\n        for i,idx in enumerate(tx):\n            for j,jdx in enumerate(tr):\n                a=x[idx]; b=r[jdx]\n                T=torch.cdist(torch.from_numpy(a),torch.from_numpy(b)).square()/2\n                T+=torch.from_numpy(W)[y[idx,None],ry[jdx][None,:]+10]/2\n                batchcost[i,j]=_expectation(T)/(len(idx)+len(jdx))\n                z1=torch.tensor(np.column_stack([a,y[idx]]),dtype=torch.float32)\n                z2=torch.tensor(np.column_stack([b,ry[jdx]+10]),dtype=torch.float32)\n                # Reuse the same empirical geometry for coupling and point potentials.\n                f,_=_dual(T,_schedule(z1,z2))\n                f=f.numpy().ravel().astype(float)\n                F[i,j]=(f-f.mean())*len(f)/(len(f)-1)\n    Q=_outer(batchcost)\n    values=np.zeros(len(x))\n    for i,idx in enumerate(tx): values[idx]=sum(Q[i,j]*F[i,j] for j in range(len(tr)))\n    return values\n", "exit_code": 0, "status": "completed"}}

ean_local_time=sum(v['time'] for v in t)/len(t))\n if (p.parent/'result.json').exists():\n  a=json.loads((p.parent/'result.json').read_text());row['official']={k:a[k] for k in ['raw_metric','score','quality_valid','method_sha256']}\n rows.append(row)\n(root/'episode_5_index.json').write_text(json.dumps(rows,indent=2))\nfinal={'best_variant':best.name,'raw_metric':raw,'score':z['score'],'method_sha256':z['method_sha256'],'cases':len(z['cases']),'worst_nrmse':max(v['normalized_rmse'] for v in q),'min_spearman':min(v['spearman'] for v in q),'min_top':min(v['top_quartile_overlap'] for v in q),'source_attempts':len(rows),'all30_local_valid':sum(r.get('local_valid')==30 for r in rows),'official_runs':sum('official' in r for r in rows)}\n(root/'episode_5_final_selection.json').write_text(json.dumps(final,indent=2))\nprint(json.dumps(final,indent=2))\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

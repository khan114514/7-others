{"type": "item.started", "item": {"id": "item_75", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/research_history/build_episode5_analytic_initial.py <<'PY'\nfrom pathlib import Path\nroot=Path('/tmp/research_history');base=(root/'224_mean_initial/method.py').read_text()\nhelper='''def _initial_mean(a,b,ya,yb,W):\n    A=torch.from_numpy(a);B=torch.from_numpy(b)\n    ia=torch.from_numpy(ya);ib=torch.from_numpy(yb)\n    an=A.square().sum(1)/2;bn=B.square().sum(1)/2\n    labels=torch.from_numpy(W[:10,10:])/2\n    aw=torch.bincount(ia,minlength=10).float()/len(a)\n    bw=torch.bincount(ib,minlength=10).float()/len(b)\n    f=an+bn.mean()-A @ B.mean(0)+(labels @ bw)[ia]\n    g=bn+an.mean()-B @ A.mean(0)+(aw @ labels)[ib]\n    return f,g\n\n'''\ns=base.replace('def _dual(C, schedule):','def _dual(C, schedule, initial):').replace('    f=C.mean(1);g=C.mean(0)','    f,g=initial')\ns=s.replace('\\\\ndef _dual(', '\\\\n'+helper+'\\\\ndef _dual(')\ns=s.replace('_dual(T,_schedule(z1,z2))','_dual(T,_schedule(z1,z2),_initial_mean(a,b,y[idx],ry[jdx],W))')\np=root/'230_analytic_initial_means';p.mkdir(exist_ok=True);(p/'method.py').write_text(s)\nfor parent,skip,late,name in [\n ('224_mean_initial',3,0,'231_mean_skip3'),\n ('225_meanvariance_initial',3,0,'232_variance_skip3'),\n ('224_mean_initial',2,2,'233_mean_classlate2'),\n ('224_mean_initial',2,3,'234_mean_classlate3'),\n]:\n s=(root/parent/'method.py').read_text()\n if skip\"'!=2:s=s.replace('\"'schedule[2:-3]','schedule['+str(skip)+':-3]')\n if late:s=s.replace('range(2,max(map(len,schedules)))','range(2,max(map(len,schedules))-'+str(late)+')')\n p=root/name;p.mkdir(exist_ok=True);(p/'method.py').write_text(s)\n# Remove rowsums and unused candidate dual at last recurrent update.\ns=base.replace('    for eps in schedule[2:-3]:','    point_steps=schedule[2:-3]\\\\n    for step,eps in enumerate(point_steps):')\ns=s.replace('''        if K is None or eps<=2.:\n            ft,gt,K,shift,rs,cs=direct(f,g,eps)''',''
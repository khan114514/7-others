{"type": "item.started", "item": {"id": "item_43", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/research_history/build_episode5_coreset.py <<'PY'\nfrom pathlib import Path\nroot=Path('/tmp/research_history');base=(root/'190_fuse_direct_both/method.py').read_text()\nhelper='''def _compress_class(A,k):\n    k=min(k,len(A))\n    if k==len(A):return A,torch.full((len(A),),1./len(A)),0.\n    centers=A[torch.linspace(0,len(A)-1,k).round().long()].clone()\n    an=A.square().sum(1)\n    for step in range(2):\n        D=an[:,None]+centers.square().sum(1)[None,:]-2*(A @ centers.T)\n        idx=D.argmin(1)\n        counts=torch.bincount(idx,minlength=k)\n        sums=torch.zeros_like(centers)\n        sums.scatter_add_(0,idx[:,None].expand_as(A),A)\n        centers=sums/counts.clamp_min(1)[:,None]\n    error=float((A-centers[idx]).square().sum(1).mean())/2\n    mask=counts>0\n    return centers[mask],counts[mask].float()/len(A),error\n\n'''\nstart=base.index('def _label_cost(');end=base.index('\\\\n\\\\ndef _expectation(',start)\nblk=base[start:end]\nold='''    aa = [torch.from_numpy(x[y == i]) for i in range(10)]\n    bb = [torch.from_numpy(r[ry == j]) for j in range(10)]'''\nnew='''    aa0 = [torch.from_numpy(x[y == i]) for i in range(10)]\n    bb0 = [torch.from_numpy(r[ry == j]) for j in range(10)]\n    ac=[_compress_class(a,CLUSTERS) for a in aa0];bc=[_compress_class(b,CLUSTERS) for b in bb0]\n    aa=[z[0] for z in ac];bb=[z[0] for z in bc]'''\nblk=blk.replace(old,new)\nblk=blk.replace('for a in aa]);ah=', 'for a in aa0]);ah=').replace('for a in aa])\\\\n    bl=', 'for a in aa0])\\\\n    bl=')\nblk=blk.replace('for b in bb]);bh=', 'for b in bb0]);bh=').replace('for b in bb])\\\\n    diam=', 'for b in bb0])\\\\n    diam=')\nold='    la=(1/an.float()).log()[:,None];lb=(1/bn.float()).log()[:,None]'\nnew='''    aw=torch.zeros((100,nmax));bw=torch.zeros((100,mmax))\n    for i,(_,w,_) in enumerate(ac):aw[i*10:(i+1)*10,:len(w)]=w\n    for j,(_,w,_) in enumerate(bc):bw[j::10,:len(w)]=w\n    lwa=torch.where(amask,aw.log(),0.);lwb=torch.where(bmask,bw.log(),0.)'''\nblk=blk.replace(old,new)\nblk=blk.replace('ft=f+R.amin(2)-eps[:,None]*lb','ft=f+(R-eps[:,None,None]*lwb[:,None,:]).amin(2)')\nblk=blk.replace('gt=g+R.amin(1)-eps[:,None]*la','gt=g+(R-eps[:,None,None]*lwa[:,:,None]).amin(1)')\nblk=blk.replace('rs=K.sum(2);cs=K.sum(1)','rs=torch.bmm(K,bw[:,:,None]).squeeze(2);cs=torch.bmm(K.transpose(1,2),aw[:,:,None]).squeeze(2)')\nblk=blk.replace('(rs.log()+lb)','rs.log()').replace('(cs.log()+la)','cs.log()')\nblk=blk.replace('v=(g[:,None,:]-C)/eps[:,None,None]','v=(g[:,None,:]-C)/eps[:,None,None]+lwb[:,None,:]')\nblk=blk.replace('v=(f[:,:,None]-C)/eps[:,None,None]','v=(f[:,:,None]-C)/eps[:,None,None]+lwa[:,:,None]')\nblk=blk.replace('(v.logsumexp(2)+lb)','v.logsumexp(2)').replace('(v.logsumexp(1)+la)','v.logsumexp(1)')\nblk=blk.replace('rs/bn[:,None]','rs').replace('cs/an[:,None]','cs')\nblk=blk.replace('ft=torch.where(amask,f+C.amin(2)-.1*lb,0.)','ft=torch.where(amask,f+(C-.1*lwb[:,None,:]).amin(2),0.)')\nblk=blk.replace('gt=torch.where(bmask,g+C.amin(1)-.1*la,0.)','gt=torch.where(bmask,g+(C-.1*lwa[:,:,None]).amin(1),0.)')\nblk=blk.replace('costs=(ft/an[:,None]).sum(1)+(gt/bn[:,None]).sum(1)','costs=(ft*aw).sum(1)+(gt*bw).sum(1)\\\\n    CORRECTION')\nfor k,correct,name in [(64,False,'206_coreset64'),(64,True,'207_coreset64_variance'),(32,False,'208_coreset32'),(32,True,'209_coreset32_variance'),(16,True,'210_coreset16_variance')]:\n b=blk.replace('CLUSTERS',str(k)).replace('CORRECTION','costs+=torch.tensor([a[2]+b[2] for a in ac for b in bc])' if correct else '')\n s=base[:start]+helper+b+base[end:]\n p=root/name;p.mkdir(exist_ok=True);(p/'method.py').write_text(s)\nwith (root/'episode_5_working_notes.md').open('a') as f:f.write('\\\\n206-210 new full-support coreset hypothesis: compress each class into64/32/16 weighted barycenters using2 deterministic Lloyd steps, preserving original class means exactly throughcountweights. Weighted dual geometry uses all supplied classpoint counts/masses, sameoriginalbboxannealing schedule, weightedhard/softtransforms, and weightedfinalexpectations. Compare with/without squared-distance withincluster variance correction. No encoder/modeltraining or persistent learnedstate. Sources prepared during190 official evaluation, not screened.\\\\n')\nPY\npython /tmp/research_history/build_episode5_coreset.py\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

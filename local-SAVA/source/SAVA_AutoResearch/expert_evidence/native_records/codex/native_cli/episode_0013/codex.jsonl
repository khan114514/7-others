{"type": "item.completed", "item": {"id": "item_5", "type": "command_execution", "command": "/bin/sh -lc 'cat method.py'", "aggregated_output": "\"\"\"Hierarchical transport with reusable costs and explicit annealed dual solves.\"\"\"\nimport numpy as np\nimport torch\nimport ot\n\n\ndef _schedule(a, b):\n    lo = torch.minimum(a.amin(0), b.amin(0))\n    hi = torch.maximum(a.amax(0), b.amax(0))\n    diameter = float(torch.linalg.vector_norm(hi - lo))\n    return [diameter**2] + [float(np.exp(e)) for e in np.arange(2*np.log(diameter), np.log(.1), 2*np.log(.5))] + [.1]\n\n\ndef _dual(C, schedule, initial):\n    n,m=C.shape\n    la=float(np.log(np.float32(1./n)));lb=float(np.log(np.float32(1./m)))\n    shift=0.\n    def direct(f,g,eps):\n        R=C-f[:,None];R-=g[None,:]\n        if eps<=2.:\n            return f+R.amin(1)-eps*lb,g+R.amin(0)-eps*la,None,0.,None,None\n        if step==0 and (float(f.max())+float(g.max()))/eps<60.:\n            rm=0.\n            R.mul_(-1.4426950408889634/eps).exp2_()\n        else:\n            rm=float(R.min());R-=rm;R.mul_(-1.4426950408889634/eps).exp2_()\n        rs=R.sum(1);cs=(R.T @ torch.ones((n,1)))[:,0]\n        if min(float(rs.min()),float(cs.min()))<=2e-22:\n            R=C-f[:,None];R-=g[None,:];R*=(-1./eps)\n            rowmax=R.amax(1);colmax=R.amax(0)\n            rr=torch.exp(R-rowmax[:,None]).sum(1);cc=torch.exp(R-colmax[None,:]).sum(0)\n            return f-eps*(rowmax+rr.log()+lb),g-eps*(colmax+cc.log()+la),None,0.,None,None\n        return f+rm-eps*(rs.log()+lb),g+rm-eps*(cs.log()+la),R,rm,rs,cs\n    f,g=initial\n    \n    K=None;rs=None;cs=None\n    restore=None\n    pe=schedule[0]\n    point_steps=schedule[3:-3]\n    for step,eps in enumerate(point_steps):\n        last=step==len(point_steps)-1\n        if last and (K is None or eps<=2.):\n            if eps<=2.:\n                C.sub_(f[:,None]);restore=f\n                g=(g+C.amin(0)-eps*la)*.5\n            else:g=(g-eps*(((f[:,None]-C)/eps).logsumexp(0)+la))*.5\n            break\n        if K is None or eps<=2.:\n            ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        else:\n            if last:\n                q=pe/eps\n                logfactor=.5*q*(float(np.log(n))-cs.log())\n                K.mul_((m/rs).sqrt()[:,None])\n                if abs(q-4.)<1e-5:K.square_().square_()\n                else:K.pow_(q)\n                sums=(K.T @ torch.ones((n,1)))[:,0]\n                if float(sums.min())>0.:\n                    logmass=sums.log()+logfactor\n                    g.add_(logmass+la,alpha=-.5*eps)\n                else:g=(g-eps*(((f[:,None]-C)/eps).logsumexp(0)+la))*.5\n                break\n            K.mul_((m/rs).sqrt()[:,None]).mul_((n/cs).sqrt()[None,:])\n            if abs(pe/eps-4.)<1e-5:\n                K.square_().square_()\n            else:K.pow_(pe/eps)\n            shift=0.\n            if last:\n                cs=(K.T @ torch.ones((n,1)))[:,0]\n                if float(cs.min())>1e-34:g=(g+g+shift-eps*(cs.log()+la))*.5\n                else:g=(g-eps*(((f[:,None]-C)/eps).logsumexp(0)+la))*.5\n                break\n            rs=K.sum(1);cs=(K.T @ torch.ones((n,1)))[:,0]\n            if min(float(rs.min()),float(cs.min()))>1e-34:\n                f.add_(rs.log()+lb,alpha=-.5*eps)\n                g.add_(cs.log()+la,alpha=-.5*eps)\n                if shift:\n                    f.add_(.5*shift);g.add_(.5*shift)\n                pe=eps\n                continue\n            else:ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        f=(f+ft)*.5;g=(g+gt)*.5;pe=eps\n    result=C.sub_(g[None,:]).amin(1)\n    if restore is not None:result.add_(restore)\n    return result-.1*lb,None\n\n\ndef _label_cost(x, y, r, ry):\n    aa = [torch.from_numpy(x[y == i]) for i in range(10)]\n    bb = [torch.from_numpy(r[ry == j]) for j in range(10)]\n    pairs = [(a, b) for a in aa for b in bb]\n    nmax = max(len(a) for a in aa)\n    mmax = max(len(b) for b in bb)\n    A = torch.zeros((100, nmax, x.shape[1]))\n    B = torch.zeros((100, mmax, r.shape[1]))\n    an = torch.tensor([len(a) for a, b in pairs])\n    bn = torch.tensor([len(b) for a, b in pairs])\n    al=torch.stack([a.amin(0) for a in aa]);ah=torch.stack([a.amax(0) for a in aa])\n    bl=torch.stack([b.amin(0) for b in bb]);bh=torch.stack([b.amax(0) for b in bb])\n    diam=torch.linalg.vector_norm(torch.maximum(ah[:,None,:],bh[None,:,:])-torch.minimum(al[:,None,:],bl[None,:,:]),dim=2).flatten().tolist()\n    ds=np.asarray(diam,np.float64)\n    logs=2*np.log(ds);delta=2*np.log(.5)\n    count=np.ceil((np.log(.1)-logs)/delta).astype(np.int64)\n    length=count+2\n    steps=np.arange(int(length.max()))[:,None]\n    effective=(logs+delta)-logs\n    temperatures=np.exp(logs[None,:]+(steps-1)*effective[None,:])\n    temperatures=np.where((steps>=1)&(steps<=count[None,:]),temperatures,.1)\n    temperatures[0]=ds*ds\n    etable=torch.from_numpy(temperatures.astype(np.float32))\n    atable=torch.from_numpy(steps<length[None,:])\n    hard=(temperatures.astype(np.float32).max(1)<=256.).tolist()\n    end=int(length.max())-3\n    for i,a in enumerate(aa):A[i*10:(i+1)*10,:len(a)]=a\n    for j,b in enumerate(bb):B[j::10,:len(b)]=b\n    C=torch.bmm(B,A.transpose(1,2)).transpose(1,2)\n    C.mul_(-1.).add_(A.square().sum(2)[:,:,None]/2).add_(B.square().sum(2)[:,None,:]/2)\n    amask = torch.arange(nmax)[None,:] < an[:,None]\n    bmask = torch.arange(mmax)[None,:] < bn[:,None]\n    C.masked_fill_(~(amask[:,:,None] & bmask[:,None,:]), float('inf'))\n    la=(1/an.float()).log()[:,None];lb=(1/bn.float()).log()[:,None]\n    def direct(f,g,eps):\n        R=(C-f[:,:,None]).sub_(g[:,None,:])\n        if hard[t]:\n            ft=f+R.amin(2)-eps[:,None]*lb\n            gt=g+R.amin(1)-eps[:,None]*la\n            return torch.where(amask,ft,0.),torch.where(bmask,gt,0.),None,None,None,None\n        if t==2 and float(((f.amax(1)+g.amax(1))/eps).max())<60.:\n            rm=torch.zeros(100)\n            K=R.mul_((-1.4426950408889634/eps)[:,None,None]).exp2_()\n        else:\n            rm=R.amin((1,2))\n            K=R.sub_(rm[:,None,None]).mul_((-1.4426950408889634/eps)[:,None,None]).exp2_()\n        rs=K.sum(2);cs=K.sum(1)\n        check=torch.minimum(torch.where(amask,rs,float('inf')).amin(1),torch.where(bmask,cs,float('inf')).amin(1))\n        if float(check.min())>1e-34:\n            ft=f+rm[:,None]-eps[:,None]*(rs.log()+lb)\n            gt=g+rm[:,None]-eps[:,None]*(cs.log()+la)\n            return torch.where(amask,ft,0.),torch.where(bmask,gt,0.),K,rm,rs,cs\n        v=(g[:,None,:]-C)/eps[:,None,None]\n        ft=-eps[:,None]*(v.logsumexp(2)+lb)\n        v=(f[:,:,None]-C)/eps[:,None,None]\n        gt=-eps[:,None]*(v.logsumexp(1)+la)\n        return torch.where(amask,ft,0.),torch.where(bmask,gt,0.),None,None,None,None\n    amean=A.sum(1)/an[:,None];bmean=B.sum(1)/bn[:,None]\n    asq=A.square().sum(2)/2;bsq=B.square().sum(2)/2\n    f=torch.where(amask,asq+bsq.sum(1)[:,None]/bn[:,None]-(A*bmean[:,None,:]).sum(2),0.)\n    g=torch.where(bmask,bsq+asq.sum(1)[:,None]/an[:,None]-(B*amean[:,None,:]).sum(2),0.)\n    K=None;shift=None;rs=None;cs=None\n    pe=None;pa=torch.ones((100,1),dtype=torch.bool)\n    hard_start=None\n    for t in range(2,end):\n        eps=etable[t]\n        active=atable[t,:,None]\n        if hard[t]:\n            hard_start=t\n            break\n        if K is None or hard[t]:\n            ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        else:\n            ar=torch.where(amask & pa,(rs/bn[:,None]).sqrt(),1.)\n            bc=torch.where(bmask & pa,(cs/an[:,None]).sqrt(),1.)\n            K.mul_(ar.reciprocal()[:,:,None]).mul_(bc.reciprocal()[:,None,:])\n            q=pe/eps\n            if bool(torch.all(torch.abs(q-4.)<1e-4)):K.square_().square_()\n            else:K.pow_(q[:,None,None])\n            shift=torch.where(pa[:,0],0.,shift)\n            rs=K.sum(2);cs=K.sum(1)\n            check=torch.minimum(torch.where(amask,rs,float('inf')).amin(1),torch.where(bmask,cs,float('inf')).amin(1))\n            if float(check.min())>1e-34:\n                ft=f+shift[:,None]-eps[:,None]*(rs.log()+lb)\n                gt=g+shift[:,None]-eps[:,None]*(cs.log()+la)\n                ft=torch.where(amask,ft,0.);gt=torch.where(bmask,gt,0.)\n            else:ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        df=torch.where(active,ft-f,0.)\n        dg=torch.where(active,gt-g,0.)\n        f.add_(df,alpha=.5)\n        g.add_(dg,alpha=.5)\n        pe=eps;pa=active\n    if hard_start is not None:\n        C.sub_(f[:,:,None]).sub_(g[:,None,:])\n        for t in range(hard_start,end):\n            eps=etable[t,:,None];active=atable[t,:,None]\n            df=torch.where(amask & active,C.amin(2)-eps*lb,0.)\n            dg=torch.where(bmask & active,C.amin(1)-eps*la,0.)\n            f.add_(df,alpha=.5);g.add_(dg,alpha=.5)\n            if t<end-1:\n                C.sub_(df[:,:,None],alpha=.5).sub_(dg[:,None,:],alpha=.5)\n        C.sub_(df[:,:,None],alpha=.5).sub_(dg[:,None,:],alpha=.75)\n        g.add_(dg,alpha=.25)\n    else:\n        g.add_(dg,alpha=.25)\n        C.sub_(f[:,:,None]).sub_(g[:,None,:])\n    ft=torch.where(amask,f+C.amin(2)-.1*lb,0.)\n    gt=torch.where(bmask,g+C.amin(1)-.1*la,0.)\n    costs=(ft/an[:,None]).sum(1)+(gt/bn[:,None]).sum(1)\n    W=np.zeros((20,20),np.float32)\n    W[:10,10:]=costs.numpy().reshape(10,10);W[10:,:10]=W[:10,10:].T\n    return W\n\n\ndef _expectation(C):\n    n,m=C.shape\n    K=(C*(-14.426950408889634/float(C.max()))).exp2_()\n    v=(1./m)/K.sum(0)\n    u=(1./n)/(K @ v[:,None])[:,0]\n    col=v*(K.T @ u[:,None])[:,0]\n    w=v*(2.-m*col).clamp_(min=.01)\n    rowmass=(K @ w[:,None])[:,0]\n    energy=(K.mul_(C) @ w[:,None])[:,0]\n    return float((energy/rowmass).mean())\n\n\ndef _outer(batchcost):\n    n,m=batchcost.shape\n    cost=batchcost/max(float(batchcost.max()),1e-12)\n    if m!=2:\n        return ot.sinkhorn(ot.unif(n),ot.unif(m),cost,.01,numItermax=10000,stopThr=1e-10)\n    d=(cost[:,1]-cost[:,0])/.01\n    lo=-float(d.max())-40.;hi=-float(d.min())+40.\n    z=-float(d.mean())\n    for it in range(50):\n        s=1./(1.+np.exp(-np.clip(d+z,-700.,700.)))\n        err=float(s.mean())-.5\n        if abs(err)<1e-13:break\n        if err>0.:hi=z\n        else:lo=z\n        deriv=float((s*(1.-s)).mean())\n        next_z=z-err/max(deriv,1e-30)\n        z=next_z if lo<next_z<hi else (lo+hi)/2.\n    return np.column_stack((s,1.-s))/n\n\n\ndef value(x, y, r, ry, seed=17, batch_size=1024):\n    torch.set_flush_denormal(True)\n    torch.set_num_threads(2)\n    x=np.asarray(x,np.float32); r=np.asarray(r,np.float32)\n    y=np.asarray(y,np.int64); ry=np.asarray(ry,np.int64)\n    tx=[np.arange(i,min(i+batch_size,len(x))) for i in range(0,len(x),batch_size)]\n    tr=[np.arange(i,min(i+batch_size,len(r))) for i in range(0,len(r),batch_size)]\n    with torch.inference_mode():\n        W=_label_cost(x[tx[0]],y[tx[0]],r[tr[0]],ry[tr[0]])\n        WL=W[:10,10:].copy()/2\n        X=torch.from_numpy(x);R=torch.from_numpy(r)\n        xn=(X*X).sum(1)/2;rn=(R*R).sum(1)/2\n        am=torch.stack([X[idx].mean(0) for idx in tx]);bm=torch.stack([R[idx].mean(0) for idx in tr])\n        amn=torch.stack([xn[idx].mean() for idx in tx]);bmn=torch.stack([rn[idx].mean() for idx in tr])\n        aw=np.stack([np.bincount(y[idx],minlength=10)/len(idx) for idx in tx]).astype(np.float32)\n        bw=np.stack([np.bincount(ry[idx],minlength=10)/len(idx) for idx in tr]).astype(np.float32)\n        fm=xn[:,None]+bmn[None,:]-X @ bm.T+torch.from_numpy((WL @ bw.T)[y])\n        gm=rn[:,None]+amn[None,:]-R @ am.T+torch.from_numpy((aw @ WL).T[ry])\n        Ax=torch.zeros((len(x),22));Br=torch.zeros((len(r),22))\n        Ax[:,:10]=-X;Ax[:,10]=xn;Ax[:,11]=1.\n        Ax[:,12:]=torch.from_numpy(WL[y])\n        Br[:,:10]=R;Br[:,10]=1.;Br[:,11]=rn\n        Br[torch.arange(len(r)),12+torch.from_numpy(ry)]=1.\n        allcost=Ax @ Br.T\n        F={}; batchcost=np.zeros((len(tx),len(tr)))\n        for i,idx in enumerate(tx):\n            for j,jdx in enumerate(tr):\n                a=x[idx]; b=r[jdx]\n                aa=X[i*batch_size:i*batch_size+len(idx)];bb=R[j*batch_size:j*batch_size+len(jdx)]\n                T=allcost[i*batch_size:i*batch_size+len(idx),j*batch_size:j*batch_size+len(jdx)].contiguous()\n                batchcost[i,j]=_expectation(T)/(len(idx)+len(jdx))\n                # Reuse the same empirical geometry for coupling and point potentials.\n                lo=np.minimum(a.min(0),b.min(0));hi=np.maximum(a.max(0),b.max(0))\n                yl=int(y[idx].min());yh=int(y[idx].max());rl=int(ry[jdx].min())+10;rh=int(ry[jdx].max())+10\n                d2=float(np.sum((hi-lo)**2)) + float((max(yh,rh)-min(yl,rl))**2)\n                diameter=np.sqrt(d2)\n                schedule=[diameter**2]+[float(np.exp(e)) for e in np.arange(2*np.log(diameter),np.log(.1),2*np.log(.5))]+[.1]\n                f,_=_dual(T,schedule,(fm[idx,j],gm[jdx,i]))\n                f=f.numpy().ravel().astype(float)\n                F[i,j]=(f-f.mean())*len(f)/(len(f)-1)\n    Q=_outer(batchcost)\n    values=np.zeros(len(x))\n    for i,idx in enumerate(tx): values[idx]=sum(Q[i,j]*F[i,j] for j in range(len(tr)))\n    return values\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_6", "type": "command_execution", "command": "/bin/sh -lc 'cat /tmp/research_history/episode12_derivations.md /tmp/research_history/episode11_derivations.md'", "aggregated_output": "# Episode 12 mechanisms\n\nEvery computation below is derived from the supplied arrays, preserving all first-batch empirical supports and the original contiguous point batch partition. Local screens use own canonical public-array calculations saved in previous research, never protected targets. Official evaluation is only through the frozen launcher.\n\n## Implicit separable kernel factors\n\nIf the explicit kernel is K=diag(u) H diag(v), a finite parallel update at temperature ratio q has Knew=(K * sqrt(m/rs)[:,None] * sqrt(n/cs)[None,:])**q. It can instead update Hnew=H**q, unew=(u*sqrt(m/rs))**q, vnew=(v*sqrt(n/cs))**q, then obtain rs=unew*(Hnew @ vnew), cs=vnew*(Hnew.T @ unew). Holding only u or only v implicitly saves one dense multiplication; the other scaling is still applied to H before powers. Both factors can be normalized by maxima, merging the compensating scalar into H before powers. Logarithmic and purely algebraic normalization controls are archived. Stable direct transforms reset implicit factors to ones when marginals are nonfinite or too small.\n\nThe final point stage only needs the reference update. The previous column balancing factor is moved into q*log(v)+.5*q*(log(n)-log(cs)), while remaining row factors are raised to q and contracted with H**q. This preserves the selected finite recipe; it is a representation change, not a converged Sinkhorn substitute.\n\n## Shared empirical first-batch geometry\n\nFull first candidate/reference feature geometry is G=-X @ R.T+||X||²/2+||R||²/2, equivalently a 12-dimensional homogeneous product. Padded class-pair indices gather G while preserving every support's input order. The original G can later be used for the first point pair before adding empirical label costs. Controls use Torch advanced indexing, two-axis np.take, or reconstruct unpadded G from the original class BMM instead. The latter trades a product for permutations and indexed copies.\n\n## Grouped exact coupling contractions\n\nEach original point pair retains its own beta=max(C)/10 and independent uniform marginals. After building a full kernel whose blocks have their own beta, blocked response columns encode each pair's v/u/w values with zeros outside the appropriate supports. GEMMs produce the same row, column and weighted-energy contractions as independent scalar response GEMMs. A global6-column version multiplies many zeros; a blocked variant uses2 reference responses per candidate block and3 candidate responses per reference block. Pair cost expectations and n+m divisors are unchanged. Original point-potential loops run after coupling on untouched full costs copied per pair.\n\n## Full hard-suffix cache blocking\n\nAfter soft class stages, form resident reduced cost R=C-f-g. All class pairs are independent. Loop interchange runs every retained hard stage and both final transforms within one block of10/20/25/50/100 pairs before advancing to the next block. Each uses df=rowmin(R)-eps*lb, dg=colmin(R)-eps*la and the same parallel dual increments. It preserves all masks, per-pair temperatures, final .25 reference extrapolation and final empirical objective. This differs from earlier per-stage kernel tiling: the entire late suffix remains in a block's working set.\n\n## Native fused final contractions\n\nThe final point kernel is discarded after a column sum. A NumPy einsum with four identical operands computes sum_i H_ij^4 in one native contraction after row balancing, eliminating dense squared-kernel writes. A five-operand version also includes (m/rs_i)^2, avoiding the dense row-balancing write. Weight-first and float64 accumulation controls distinguish multiplication-order/range effects. Nonfinite or zero sums retain the existing logsumexp fallback. Coupling energy similarly contracts K_ij*C_ij*w_j using a native three-operand einsum, avoiding a dense K*=C pass. These are exact algebraic identities with float32 reduction-order differences.\n\n## Fused intermediate recurrence\n\nThe traced public303Gaussian016 case performs five ordinary dyadic kernel recurrences per point pair, with positive marginals throughout, then a hard final reference transform. Thus final-only power fusion cannot address its repeated hot loop. For q=4, Knew=K**4*(m/rs)**2[:,None]*(n/cs)**2[None,:]. A native four-operand einsum can instead form B=K**2*(m/rs)[:,None]*(n/cs)[None,:] in one pass, then Knew=B**2 in one more. A six-operand version computes Knew in one contraction. Controls fuse only the original two sqrt balancing factors; write to an aliasing output vs a separate allocated result; or apply the same class recurrence with padded inactive factors. Finite-marginal direct fallbacks are preserved. These change actual intermediate recurrences, unlike the final-only contractions.\n\n## Disposable terminal hard costs\n\nAt a terminal hard reference update, gnew=.5*(g+colmin(C-f)-eps*la). C is disposable because coupling was already computed. Mutating C-=f avoids a dense temporary. The final candidate c-transform becomes f+rowmin(C-gnew)-.1*lb. Both Torch and zero-copy NumPy controls restore that exact unary f contribution before existing point calibration. Full cost construction copies each original point-pair slice, so in-place mutation never corrupts other batches.\n\n## NumPy complete hard cache blocks\n\nEarlier NumPy controls traversed the complete class matrix at every hard stage. Here loop interchange and entry-shift localization permit a complete10/25/50-pair block to remain in cache across every hard refinement, final g extrapolation and both final transforms. NumPy minima and in-place broadcasts operate on shared Torch-backed float32 residual/potential views; all masks, temperatures and class objective divisors stay identical. This isolates NumPy dispatch in a cache-resident suffix instead of repeating the old entire-matrix sweep.\n# Episode 11 mechanisms\n\nAll mechanisms derive geometry from the supplied arrays and preserve every first-batch empirical class support and every point batch. Local quality diagnostics use own canonical public-array computations saved by earlier episodes. They never access protected targets.\n\n## Persistent hard class reduced costs\nAt the first globally hard class stage define `R = C - f[:,None] - g[None,:]`. A parallel hard update has residual increments `df = rowmin(R) - eps*log(1/m)` and `dg = colmin(R) - eps*log(1/n)`. Thus `f_new=f+.5*df`, `g_new=g+.5*dg`, and `R_new=R-.5*df[:,None]-.5*dg[None,:]`. Keeping R across the contiguous hard suffix eliminates full dense residual allocations and subtraction of large absolute duals at every stage. Active/mask controls are preserved. The final reference extrapolation is `g += .25*dg`, so the last residual shift can combine `.5` and `.25` into `.75*dg`. Final objective is unchanged: mean(f+rowmin(R)-.1*lb)+mean(g+colmin(R)-.1*la). Variations include ordinary in-place updates, fused rank-two BMM, and scalar-only mean-dual tracking.\n\n## Rank-two residual construction\n`f[:,None]+g[None,:] = [f,ones]  @  [ones,g]`. Torch addmm/baddbmm applies the additive residual in one native call. Column-major class storage uses the transposed product `[g,ones]  @  [ones,f]`. This saves dense passes in principle but multiplication dispatch can cost more than broadcasting. Keep controls with separate output allocation and in-place output aliasing.\n\n## One-sided padded class geometry\nSort actual reference supports by observed labels and retain only candidate-side padding. Potentials f have `(candidate_label,candidate_point,reference_label)` shape, g have `(candidate_label,actual_reference_point)` shape. Segmented row transforms operate on contiguous reference label segments. Native column reductions operate over candidate points, eliminating one of the two segmented reductions used in episode 9. This layout removes reference padding but still needs dense expansion of reference-label-specific candidate potentials.\n\n## Direct dual increments\nWhenever transformed dual `ft=f+shift-eps*(log(rowmass)+lb)` is immediately followed by `df=ft-f`, compute df directly. For point kernels the analogous update is `f += -.5*eps*(log(rowmass)+lb)`, and similarly g. Fallbacks retain stable direct transforms. Only floating reduction/addition order changes.\n\n## Fused final point powers/reduction\nIn the reference-only final stage, K after row balancing is raised to q=4, then summed by column. The final K is never used again. `sum(K**4) = norm_4(K)**4 = norm_2(K**2)**2`. Native vector norms may fuse a power and reduction, avoiding dense write/read passes. The root can cancel directly in logs: `log(sum(K**4))=4*log(norm_4(K))=2*log(norm_2(K**2))`. Sum positivity retains the stable logsumexp fallback. A square-root kernel storage control adapts dual balancing factors to fourth roots and obtains all marginals via norm2 squared.\n\n## Direct centered class residual geometry\nInitial class duals are f0_i=||a_i||²/2 + E||b||²/2 - a_i dot E(b), and similarly g0_j. Therefore R0=C-f0-g0 = -(a_i-Ea) dot (b_j-Eb) + Ea dot Eb - E||a||²/2 - E||b||²/2. The scalar offset is negative mean(C). Solve using R0 and zero initial duals, then restore mean(f0)+mean(g0)=2mean(C) to the pair objective. Computing the centered product skips original dense unary costs and first-stage subtraction. Original-temperature geometry and masks remain. A control forms the gauge via original geometry before subtraction; another centers the twenty unique supports once before packing and derives offsets from their unique means/norms. The first unshifted exponential is allowed only if the actual maximum residual exponent is below60, with original stable shifted fallback otherwise.\n", "exit_code": 0, "status": "completed"}}

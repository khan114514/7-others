{"type": "item.completed", "item": {"id": "item_31", "type": "command_execution", "command": "/bin/sh -lc \"sed -n '/def _expectation/,/def _outer/p' /tmp/research_history/125_numpy_coupling_reductions/method.py\nsed -n '/def _dual/,/def _label_cost/p' /tmp/research_history/137_numpy_point_recurrence/method.py\"", "aggregated_output": "def _expectation(C):\n    C=C.numpy()\n    n,m=C.shape\n    K=np.multiply(C,-1./(.1*float(C.max())))\n    np.exp(K,out=K)\n    u=np.full(n,1./n,np.float32);v=np.full(m,1./m,np.float32)\n    for it in range(2):\n        v=(1./m)/(K*u[:,None]).sum(0)\n        u=(1./n)/(K*v[None,:]).sum(1)\n    return float((u*((K*C)*v[None,:]).sum(1)).sum())\n\n\ndef _outer(batchcost):\ndef _dual(C, schedule):\n    C=C.numpy();n,m=C.shape\n    la=float(np.log(np.float32(1./n)));lb=float(np.log(np.float32(1./m)))\n    def direct(f,g,eps):\n        R=C-f[:,None];R-=g[None,:]\n        if eps<=2.:\n            return f+R.min(1)-eps*lb,g+R.min(0)-eps*la,None,0.,None,None\n        rm=float(R.min());R-=rm;R*=(-1./eps)\n        np.maximum(R,-80.,out=R);np.exp(R,out=R)\n        rs=R.sum(1);cs=R.sum(0)\n        if min(float(rs.min()),float(cs.min()))<=2e-22:\n            R=C-f[:,None];R-=g[None,:];R*=(-1./eps)\n            rmv=R.max(1);cmv=R.max(0)\n            rr=np.exp(R-rmv[:,None]).sum(1);cc=np.exp(R-cmv[None,:]).sum(0)\n            return f-eps*(rmv+np.log(rr)+lb),g-eps*(cmv+np.log(cc)+la),None,0.,None,None\n        return f+rm-eps*(np.log(rs)+lb),g+rm-eps*(np.log(cs)+la),R,rm,rs,cs\n    f,g,K,shift,rs,cs=direct(np.zeros(n,np.float32),np.zeros(m,np.float32),schedule[0])\n    pe=schedule[0];full=True\n    for eps in schedule[2:-3]:\n        if K is None or eps<=2.:ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        else:\n            old_shift=shift\n            if full:\n                K*=(m/rs)[:,None];K*=(n/cs)[None,:]\n            else:\n                K*=np.sqrt(m/rs)[:,None];K*=np.sqrt(n/cs)[None,:]\n            if abs(pe/eps-4.)<1e-5:\n                np.sq
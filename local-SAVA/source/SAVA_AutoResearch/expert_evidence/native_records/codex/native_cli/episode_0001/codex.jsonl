{"type": "item.started", "item": {"id": "item_23", "type": "command_execution", "command": "/bin/sh -lc \"mkdir -p /tmp/research_history/004_batched_labels\npython - <<'PY'\nfrom pathlib import Path\ns=Path('/tmp/research_history/003_late_min/method.py').read_text()\na=s.index('def _label_cost('); b=s.index('\\\\n\\\\ndef value(',a)\nnew='''def _label_cost(x, y, r, ry):\n    aa = [torch.from_numpy(x[y == i]) for i in range(10)]\n    bb = [torch.from_numpy(r[ry == j]) for j in range(10)]\n    pairs = [(a, b) for a in aa for b in bb]\n    nmax = max(len(a) for a in aa)\n    mmax = max(len(b) for b in bb)\n    A = torch.zeros((100, nmax, x.shape[1]))\n    B = torch.zeros((100, mmax, r.shape[1]))\n    an = torch.tensor([len(a) for a, b in pairs])\n    bn = torch.tensor([len(b) for a, b in pairs])\n    schedules = []\n    for k, (a, b) in enumerate(pairs):\n        A[k, :len(a)] = a\n        B[k, :len(b)] = b\n        schedules.append(_schedule(a, b))\n    C = ((A*A).sum(2)[:,:,None] - 2*torch.bmm(A,B.transpose(1,2)) + (B*B).sum(2)[:,None,:])/2\n    amask = torch.arange(nmax)[None,:] < an[:,None]\n    bmask = torch.arange(mmax)[None,:] < bn[:,None]\n    C.masked_fill_(~(amask[:,:,None] & bmask[:,None,:]), float('inf'))\n    D = C.transpose(1,2).contiguous()\n    la = (1/an.float()).log()[:,None]\n    lb = (1/bn.float()).log()[:,None]\n    def transform(T, h, eps, lw, outmask):\n        v = h[:,None,:] / eps[:,None,None] + lw[:,:,None] - T / eps[:,None,None]\n        out = -eps[:,None] * v.logsumexp(2)\n        return torch.where(outmask, out, 0.)\n    eps = torch.tensor([z[0] for z in schedules])\n    f=transform(C,torch.zeros((100,mmax)),eps,lb,amask)\n    g=transform(D,torch.zeros((100,nmax)),eps,la,bmask)\n    for t in range(max(len(z) for z in schedules)):\n        eps=torch.tensor([z[t] if t < len(z) else .1 for z in schedules])\n        active=torch.tensor([t < len(z) for z in schedules])[:,None]\n        ft=transform(C,g,eps,lb,amask)\n        gt=transform(D,f,eps,la,bmask)\n        f=torch.where(active,(f+ft)*.5,f)\n        g=torch.where(active,(g+gt)*.5,g)\n    eps=torch.full((100,),.1)\n    ft=transform(C,g,eps,lb,amask)\n    gt=transform(D,f,eps,la,bmask)\n    costs=(ft/an[:,None]).sum(1)+(gt/bn[:,None]).sum(1)\n    W=np.zeros((20,20),np.float32)\n    W[:10,10:]=costs.numpy().reshape(10,10)\n    W[10:,:10]=W[:10,10:].T\n    return W\n'''\ns=s[:a]+new+s[b:]\nPath('/tmp/research_history/004_batched_labels/method.py').write_text(s)\nPY\nps -eo pid,comm,etime,pcpu --sort=-pcpu\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

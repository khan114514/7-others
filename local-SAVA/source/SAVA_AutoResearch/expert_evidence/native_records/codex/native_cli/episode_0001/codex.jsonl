'ry', (2000,)), ('seed', ())]\nseed_303_gaussian_016.npz [('x', (3000, 10)), ('y', (3000,)), ('r', (2000, 10)), ('ry', (2000,)), ('seed', ())]\nseed_303_gaussian_024.npz [('x', (3000, 10)), ('y', (3000,)), ('r', (2000, 10)), ('ry', (2000,)), ('seed', ())]\nseed_303_mixed.npz [('x', (3000, 10)), ('y', (3000,)), ('r', (2000, 10)), ('ry', (2000,)), ('seed', ())]\nseed_303_uniform_labels.npz [('x', (3000, 10)), ('y', (3000,)), ('r', (2000, 10)), ('ry', (2000,)), ('seed', ())]\nseed_404_asymmetric_labels.npz [('x', (3000, 10)), ('y', (3000,)), ('r', (2000, 10)), ('ry', (2000,)), ('seed', ())]\nseed_404_gaussian_008.npz [('x', (3000, 10)), ('y', (3000,)), ('r', (2000, 10)), ('ry', (2000,)), ('seed', ())]\nseed_404_gaussian_016.npz [('x', (3000, 10)), ('y', (3000,)), ('r', (2000, 10)), ('ry', (2000,)), ('seed', ())]\nseed_404_gaussian_024.npz [('x', (3000, 10)), ('y', (3000,)), ('r', (2000, 10)), ('ry', (2000,)), ('seed', ())]\nseed_404_mixed.npz [('x', (3000, 10)), ('y', (3000,)), ('r', (2000, 10)), ('ry', (2000,)), ('seed', ())]\nseed_404_uniform_labels.npz [('x', (3000, 10)), ('y', (3000,)), ('r', (2000, 10)), ('ry', (2000,)), ('seed', ())]\nseed_505_asymmetric_labels.npz [('x', (3000, 10)), ('y', (3000,)), ('r', (2000, 10)), ('ry', (2000,)), ('seed', ())]\nseed_505_gaussian_008.npz [('x', (3000, 10)), ('y', (3000,)), ('r', (2000, 10)), ('ry', (2000,)), ('seed', ())]\nseed_505_gaussian_016.npz [('x', (3000, 10)), ('y', (3000,)), ('r', (2000, 10)), ('ry', (2000,)), ('seed', ())]\nseed_505_gaussian_024.npz [('x', (3000, 10)), ('y', (3000,)), ('r', (2000, 10)), ('ry', (2000,)), ('seed', ())]\nseed_505_mixed.npz [('x', (3000, 10)), ('y', (3000,)), ('r', (2000, 10)), ('ry', (2000,)), ('seed', ())]\nseed_505_uniform_labels.npz [('x', (3000, 10)), ('y', (3000,)), ('r', (2000, 10)), ('ry', (2000,)), ('seed', ())]\n", "exit_code": 0, "status": "completed"}}

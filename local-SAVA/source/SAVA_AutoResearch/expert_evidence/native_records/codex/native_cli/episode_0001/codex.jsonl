{"type": "item.started", "item": {"id": "item_91", "type": "command_execution", "command": "/bin/sh -lc \"mkdir -p /tmp/research_history/033_numpy_labels\npython - <<'PY'\nfrom pathlib import Path\ns=Path('/tmp/research_history/032_numpy_dual/method.py').read_text()\na=s.index('def _label_cost(');b=s.index('\\\\n\\\\ndef _expectation(',a)\nnew='''def _label_cost(x,y,r,ry):\n    aa=[x[y==i] for i in range(10)]\n    bb=[r[ry==j] for j in range(10)]\n    pairs=[(a,b) for a in aa for b in bb]\n    an=np.array([len(a) for a,b in pairs],np.float32)\n    bn=np.array([len(b) for a,b in pairs],np.float32)\n    nmax=int(an.max());mmax=int(bn.max())\n    A=np.zeros((100,nmax,x.shape[1]),np.float32)\n    B=np.zeros((100,mmax,r.shape[1]),np.float32)\n    schedules=[]\n    for k,(a,b) in enumerate(pairs):\n        A[k,:len(a)]=a;B[k,:len(b)]=b\n        schedules.append(_schedule(torch.from_numpy(a),torch.from_numpy(b)))\n    C=((A*A).sum(2)[:,:,None]-2*(A @ B.transpose(0,2,1))+(B*B).sum(2)[:,None,:])/2\n    amask=np.arange(nmax)[None,:]<an[:,None]\n    bmask=np.arange(mmax)[None,:]<bn[:,None]\n    valid=amask[:,:,None]&bmask[:,None,:]\n    C[~valid]=np.inf\n    D=C.transpose(0,2,1).copy()\n    la=np.log(1/an)[:,None];lb=np.log(1/bn)[:,None]\n    cmin=C.min((1,2))\n    span=np.where(valid,C,0).max((1,2))-cmin\n    base=cmin[:,None,None]-C\n    kernel=None;kernel_eps=None\n    def transforms(f,g,eps):\n        nonlocal kernel,kernel_eps\n        if eps.max()<=8.:\n            R=C-f[:,:,None]-g[:,None,:]\n            ft=f+R.min(2)-eps[:,None]*lb\n            gt=g+R.min(1)-eps[:,None]*la\n            return np.where(amask,ft,0),np.where(bmask,gt,0)\n        if (span/eps).max()<60.:\n            if kernel_eps is None or not np.array_equal(eps,kernel_eps):\n                kernel=np.exp(base/eps[:,None,None]);kernel_eps=eps\n            fm=f.max(1);gm=g.max(1)\n            gv=np.exp((g-gm[:,None])/eps[:,None])*bmask\n            fv=np.exp((f-fm[:,None])/eps[:,None])*amask\n            kd=(kernel @ gv[:,:,None]).squeeze(2)\n            ktd=(kernel.transpose(0,2,1) @ fv[:,:,None]).squeeze(2)\n            with np.errstate(divide='ignore'):\n                ft=cmin[:,None]-gm[:,None]-eps[:,None]*(np.log(np.where(amask,kd,1))+lb)\n                gt=cmin[:,None]-fm[:,None]-eps[:,None]*(np.log(np.where(bmask,ktd,1))+la)\n            ft=np.where(amask,ft,0);gt=np.where(bmask,gt,0)\n            if np.isfinite(ft).all() and np.isfinite(gt).all():\n                return ft,gt\n        ft=-eps[:,None]*logsumexp((g[:,None,:]-C)/eps[:,None,None],axis=2)-eps[:,None]*lb\n        gt=-eps[:,None]*logsumexp((f[:,None,:]-D)/eps[:,None,None],axis=2)-eps[:,None]*la\n        return np.where(amask,ft,0),np.where(bmask,gt,0)\n    eps=np.array([z[0] for z in schedules],np.float32)\n    f,g=transforms(np.zeros((100,nmax),np.float32),np.zeros((100,mmax),np.float32),eps)\n    for t in range(max(len(z) for z in schedules)):\n        eps=np.array([z[t] if t<len(z) else .1 for z in schedules],np.float32)\n        active=np.array([t<len(z) for z in schedules])[:,None]\n        ft,gt=transforms(f,g,eps)\n        f=np.where(active,(f+ft)*.5,f);g=np.where(active,(g+gt)*.5,g)\n    ft,gt=transforms(f,g,np.full((100,),.1,np.float32))\n    costs=(ft/an[:,None]).sum(1)+(gt/bn[:,None]).sum(1)\n    W=np.zeros((20,20),np.float32)\n    W[:10,10:]=costs.reshape(10,10);W[10:,:10]=W[:10,10:].T\n    return W\n'''\ns=s[:a]+new+s[b:]\nPath('/tmp/research_history/033_numpy_labels/method.py').write_text(s)\nPY\nOPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=2 python /tmp/research_history/screen_all.py /tmp/research_history/000_baseline/method.py /tmp/research_history/033_numpy_labels/method.py > /tmp/research_history/screen_all_033.log 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

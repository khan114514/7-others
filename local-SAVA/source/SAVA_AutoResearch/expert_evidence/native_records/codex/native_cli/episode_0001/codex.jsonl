{"type": "item.started", "item": {"id": "item_41", "type": "command_execution", "command": "/bin/sh -lc \"mkdir -p /tmp/research_history/011_sparse_labels\npython - <<'PY'\nfrom pathlib import Path\ns=Path('/tmp/research_history/010_sparse_late/method.py').read_text()\na=s.index('    def transform(T, h, eps, lw, outmask):');b=s.index('    eps = torch.tensor([z[0]',a)\ns=s[:a]+'''    neighbors={}\n    def transform(T,h,eps,lw,outmask,key):\n        if float(eps.max())<=32.:\n            if key not in neighbors:\n                idx=(T-h[:,None,:]).topk(min(32,h.shape[1]),dim=2,largest=False).indices\n                neighbors[key]=(idx,T.gather(2,idx))\n            idx,cost=neighbors[key]\n            selected=h.gather(1,idx.reshape(100,-1)).reshape(idx.shape)\n            out=-eps[:,None]*((selected-cost)/eps[:,None,None]+lw[:,:,None]).logsumexp(2)\n            return torch.where(outmask,out,0.)\n        v=h[:,None,:]/eps[:,None,None]+lw[:,:,None]-T/eps[:,None,None]\n        out=-eps[:,None]*v.logsumexp(2)\n        return torch.where(outmask,out,0.)\n'''+s[b:]\ns=s.replace('eps,lb,amask)','eps,lb,amask,0)').replace('eps,la,bmask)','eps,la,bmask,1)')\nPath('/tmp/research_history/011_sparse_labels/method.py').write_text(s)\nfor num,k in [(12,8),(13,4)]:\n d=Path('/tmp/research_history/'+str(num).zfill(3)+'_sparse_'+str(k));d.mkdir(exist_ok=True)\n t=s.replace('min(32,m)',f'min({k},m)').replace('min(32,n)',f'min({k},n)').replace('min(32,h.shape[1])',f'min({k},h.shape[1])')\n (d/'method.py').write_text(t)\nPY\nOPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=2 python /tmp/research_history/screen.py /tmp/research_history/000_baseline/method.py /tmp/research_history/011_sparse_labels/method.py /tmp/research_history/012_sparse_8/method.py /tmp/research_history/013_sparse_4/method.py > /tmp/research_history/screen_011_013.log 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

{"type": "item.started", "item": {"id": "item_28", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/research_history/screen.py <<'PY'\nimport importlib.util, sys, time\nfrom pathlib import Path\nimport numpy as np\nfrom scipy.stats import spearmanr\nmods=[]\nfor path in sys.argv[1:]:\n spec=importlib.util.spec_from_file_location('m'+str(len(mods)),path)\n m=importlib.util.module_from_spec(spec); spec.loader.exec_module(m); mods.append((path,m))\nfor case in ['seed_101_uniform_labels','seed_101_asymmetric_labels','seed_101_gaussian_008','seed_101_gaussian_016','seed_101_gaussian_024','seed_101_mixed']:\n z=np.load('/workspace/environment/public_assets/dev/'+case+'.npz')\n target_path=Path('/tmp/research_history/'+case+'_canonical.npy')\n if target_path.exists(): target=np.load(target_path)\n else:\n  t=time.perf_counter(); target=mods[0][1].value(z['x'],z['y'],z['r'],z['ry'],int(z['seed'])); np.save(target_path,target)\n  print(case,'canonical',time.perf_counter()-t,flush=True)\n for path,m in mods[1:]:\n  t=time.perf_counter(); out=m.value(z['x'],z['y'],z['r'],z['ry'],int(z['seed'])); elapsed=time.perf_counter()-t\n  n=len(out); a=np.argsort(-out,kind='stable')[:n//4];b=np.argsort(-target,kind='stable')[:n//4]\n  print(case,Path(path).parent.name,'time',round(elapsed,4),'nrmse',np.sqrt(np.mean((out-target)**2))/target.std(),'rho',spearmanr(out,target).statistic,'top',len(set(a)&set(b))/(n//4),flush=True)\nPY\nOPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=2 python /tmp/research_history/screen.py /tmp/research_history/000_baseline/method.py /tmp/research_history/001_cross_only/method.py /tmp/research_history/002_reuse_cost/method.py /tmp/research_history/003_late_min/method.py /tmp/research_history/004_batched_labels/method.py > /tmp/research_history/screen_001_004.log 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

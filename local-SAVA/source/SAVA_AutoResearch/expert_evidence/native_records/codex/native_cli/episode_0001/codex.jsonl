{"type": "item.started", "item": {"id": "item_36", "type": "command_execution", "command": "/bin/sh -lc \"mkdir -p /tmp/research_history/009_gibbs_early\npython - <<'PY'\nfrom pathlib import Path\ns=Path('/tmp/research_history/006_min_8/method.py').read_text()\na=s.index('def _dual(');b=s.index('\\\\n\\\\ndef _label_cost(',a)\nnew='''def _dual(C, schedule):\n    D=C.T.contiguous()\n    n,m=C.shape\n    la=float(np.log(np.float32(1./n)))\n    lb=float(np.log(np.float32(1./m)))\n    cmin=float(C.min()); span=float(C.max())-cmin\n    def lse(T,h,eps,lw):\n        return -eps*(h[None,:]/eps+lw-T/eps).logsumexp(1)\n    def transforms(f,g,eps):\n        if eps<=8.:\n            return (C-g[None,:]).amin(1)-eps*lb, (D-f[None,:]).amin(1)-eps*la\n        if span/eps<60.:\n            K=torch.exp((cmin-C)/eps)\n            fm=float(f.max());gm=float(g.max())\n            ft=cmin-gm-eps*((K @ torch.exp((g-gm)/eps)).log()+lb)\n            gt=cmin-fm-eps*((K.T @ torch.exp((f-fm)/eps)).log()+la)\n            if bool(torch.isfinite(ft).all()) and bool(torch.isfinite(gt).all()):\n                return ft,gt\n        return lse(C,g,eps,lb),lse(D,f,eps,la)\n    eps=schedule[0]\n    f,g=transforms(torch.zeros(n),torch.zeros(m),eps)\n    for eps in schedule:\n        ft,gt=transforms(f,g,eps)\n        f,g=(f+ft)*.5,(g+gt)*.5\n    return transforms(f,g,eps)\n'''\ns=s[:a]+new+s[b:]\nPath('/tmp/research_history/009_gibbs_early/method.py').write_text(s)\nPY\nOPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=2 python /tmp/research_history/screen.py /tmp/research_history/000_baseline/method.py /tmp/research_history/009_gibbs_early/method.py > /tmp/research_history/screen_009.log 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

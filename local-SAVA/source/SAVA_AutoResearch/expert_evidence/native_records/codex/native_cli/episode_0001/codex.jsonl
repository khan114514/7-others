{"type": "item.started", "item": {"id": "item_46", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/research_history/screen_all.py <<'PY'\nimport importlib.util,sys,time\nfrom pathlib import Path\nimport numpy as np\nfrom scipy.stats import spearmanr\nmods=[]\nfor path in sys.argv[1:]:\n spec=importlib.util.spec_from_file_location('m'+str(len(mods)),path)\n m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m);mods.append((path,m))\nfor p in sorted(Path('/workspace/environment/public_assets/dev').glob('*.npz')):\n z=np.load(p); args=(z['x'],z['y'],z['r'],z['ry'],int(z['seed']))\n cache=Path('/tmp/research_history/'+p.stem+'_canonical.npy')\n if cache.exists():target=np.load(cache)\n else:\n  target=mods[0][1].value(*args);np.save(cache,target)\n for path,m in mods[1:]:\n  t=time.perf_counter();out=m.value(*args);dt=time.perf_counter()-t\n  n=len(out);a=np.argsort(-out,kind='stable')[:n//4];b=np.argsort(-target,kind='stable')[:n//4]\n  nr=np.sqrt(np.mean((out-target)**2))/target.std();rho=spearmanr(out,target).statistic;top=len(set(a)&set(b))/(n//4)\n  print(p.stem,Path(path).parent.name,'time',round(dt,4),'nrmse',nr,'rho',rho,'top',top,'valid',nr<=.01 and rho>=.999 and top>=.98,flush=True)\nPY\nOPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=2 python /tmp/research_history/screen_all.py /tmp/research_history/000_baseline/method.py /tmp/research_history/006_min_8/method.py /tmp/research_history/014_sparse_16/method.py /tmp/research_history/015_sparse_8_later/method.py > /tmp/research_history/screen_all_006_014_015.log 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

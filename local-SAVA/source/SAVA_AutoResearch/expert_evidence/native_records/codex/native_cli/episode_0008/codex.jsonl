{"type": "item.started", "item": {"id": "item_21", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/research_history/episode8_screen.py <<'PY'\nimport importlib.util,json,sys,time,hashlib\nfrom pathlib import Path\nimport numpy as np\nfrom scipy.stats import spearmanr\nroot=Path('/tmp/research_history')\nmanifest=root/sys.argv[1]\nentries=json.loads(manifest.read_text());records=[];mods=[]\nfor k,e in enumerate(entries):\n p=root/e['name']/'method.py'\n spec=importlib.util.spec_from_file_location('episode8_'+str(k),p)\n mod=importlib.util.module_from_spec(spec);spec.loader.exec_module(mod)\n mods.append((e,mod))\nfor p in sorted(Path('/workspace/environment/public_assets/dev').glob('*.npz')):\n z=np.load(p);args=z['x'],z['y'],z['r'],z['ry'],int(z['seed'])\n target=np.load(root/(p.stem+'_canonical.npy'))\n b=np.argsort(-target,kind='stable')[:len(target)//4]\n for e,mod in mods:\n  t=time.perf_counter()\n  try:\n   out=np.asarray(mod.value(*args));elapsed=time.perf_counter()-t\n   nr=float(np.sqrt(np.mean((out-target)**2))/target.std())\n   rho=float(spearmanr(out,target).statistic)\n   a=np.argsort(-out,kind='stable')[:len(out)//4]\n   top=len(set(a)&set(b))/(len(out)//4)\n   valid=out.shape==target.shape and np.isfinite(out).all() and nr<=.01 and rho>=.999 and top>=.98\n   rec={'name':e['name'],'case':p.stem,'seconds':elapsed,'nrmse':nr,'rho':rho,'top':top,'valid':bool(valid)}\n  except Exception as exc:\n   rec={'name':e['name'],'case':p.stem,'seconds':time.perf_counter()-t,'valid':False,'error':repr(exc)}\n  records.append(rec)\n  print(json.dumps(rec),flush=True)\nsummary=[]\nfor e in entries:\n rr=[r for r in records if r['name']==e['name']]\n nr=[r.get('nrmse',float('inf')) for r in rr]\n s={'name':e['name'],'sha256':e['sha256'],'cases':len(rr),'valid':all(r['valid'] for r in rr),'failures':sum(not r['valid'] for r in rr),'worst_nrmse':max(nr),'mean_seconds':float(np.mean([r['seconds'] for r in rr]))}\n summary.append(s)\n print('SUMMARY',json.dumps(s),flush=True)\nmanifest.with_name(manifest.stem+'_screen.json').write_text(json.dumps({'summary':summary,'records':records},indent=2))\nPY\ncat > /tmp/research_history/episode8_read_report.py <<'PY'\nimport json,sys\nfrom pathlib import Path\nfor p in sys.argv[1:]:\n j=json.loads(Path(p).read_text());q=[v for c in j.get('cases',[]) for v in c['quality']]\n print(json.dumps({k:j[k] for k in ['status','quality_valid','raw_metric','score','method_sha256'] if k in j},indent=2))\n print('Cases',len(j.get('cases',[])),'quality records',len(q))\n if q:print('Worst nRMSE',max(v['normalized_rmse'] for v in q),'minimum rho',min(v['spearman'] for v in q),'minimum top',min(v['top_quartile_overlap'] for v in q))\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

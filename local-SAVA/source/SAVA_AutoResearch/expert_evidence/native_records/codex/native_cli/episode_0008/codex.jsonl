umulant ablation tests whether covariance correction is needed with current schedule.')\ndc=cl.replace(setup,'''    mu=(f.sum(1)/an)[:,None]\n    residual=C-f[:,:,None]-g[:,None,:]+mu[:,:,None]\n    residual.masked_fill_(~(amask[:,:,None]&bmask[:,None,:]),0.)\n    residual.square_()\n    vr=residual.sum(2)/bn[:,None];vc=residual.sum(1)/an[:,None]\n''')\nsave('488_episode8_class_dense_variance_control',base[:a]+dc+base[b:],'Dense residual variance checks analytic shared-covariance transformation and approximation separately.')\n(root/'episode8_round8_manifest.json').write_text(json.dumps(entries,indent=2));print('\\\\n'.join(e['name'] for e in entries))\nPY\npython /tmp/research_history/episode8_build_round8.py\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

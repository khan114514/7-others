{"type": "item.started", "item": {"id": "item_49", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/research_history/episode8_build_round6.py <<'PY'\nfrom pathlib import Path\nimport json,hashlib\nroot=Path('/tmp/research_history');entries=[]\nbase=(root/'470_episode8_class_virtual_final_dense/method.py').read_text()\n# Build exact certificates from two nearest reduced-cost neighbors in the last dense stage.\na=base.index('def _label_cost');b=base.index('def _expectation');cl=base[a:b]\ncl=cl.replace('''            if final:\n                rv,ri=R.min(2);cv,ci=R.min(1)\n            else:rv=R.amin(2);cv=R.amin(1)''','''            if final:\n                rtop,ri=R.topk(min(2,mmax),dim=2,largest=False,sorted=True)\n                ctop,ci=R.topk(min(2,nmax),dim=1,largest=False,sorted=True)\n                rv=rtop[:,:,0];cv=ctop[:,0,:]\n            else:rv=R.amin(2);cv=R.amin(1)''')\ncl=cl.replace('''        nonlocal ri,ci''','''        nonlocal ri,ci,rtop,ctop''')\ncl=cl.replace('''    ri=None;ci=None''','''    ri=None;ci=None;rtop=None;ctop=None''')\ncl=cl.replace('''        eps=torch.tensor([z[t] if t<len(z) else .1 for z in schedules])''','''        if final:source_f=f.clone();source_g=g.clone()\n        eps=torch.tensor([z[t] if t<len(z) else .1 for z in schedules])''')\nstart=cl.index('    if ri is not None:\\\\n        next_eps=');end=cl.index('    g.add_(dg,alpha=0.25)',start)\nvirtual='''    if ri is not None:\n        rowcost=C.gather(2,ri);colcost=C.gather(1,ci)\n    for u in range(t+1,max(map(len,schedules))-3):\n        next_eps=torch.tensor([z[u] if u<len(z) else .1 for z in schedules])[:,None]\n        next_active=torch.tensor([u<len(z) for z in schedules])[:,None]\n        if ri is not None:\n            rvalues=rowcost-g.gather(1,ri.reshape(100,-1)).reshape(ri.shape)\n            cvalues=colcost-f.gather(1,ci.reshape(100,-1)).reshape(ci.shape)\n            rm=rvalues.amin(2);cm=cvalues.amin(1)\n            lower_r=source_f+rtop[:,:,-1]+torch.where(bmask,source_g-g,float('inf')).amin(1)[:,None]\n            lower_c=source_g+ctop[:,-1,:]+torch.where(amask,source_f-f,float('inf')).amin(1)[:,None]\n            uncertain_r=amask & (rm>lower_r)\n            uncertain_c=bmask & (cm>lower_c)\n            bi,ii=uncertain_r.nonzero(as_tuple=True)\n            if len(bi):rm[bi,ii]=(C[bi,ii,:]-g[bi,:]).amin(1)\n            bj,jj=uncertain_c.nonzero(as_tuple=True)\n            if len(bj):cm[bj,jj]=(C[bj,:,jj]-f[bj,:]).amin(1)\n            ft=torch.where(amask,rm-next_eps*lb,0.)\n            gt=torch.where(bmask,cm-next_eps*la,0.)\n        else:ft,gt,K,shift,rs,cs=direct(f,g,next_eps[:,0])\n        df=torch.where(next_active,ft-f,0.)\n        dg=torch.where(next_active,gt-g,0.)\n        f.add_(df,alpha=.5);g.add_(dg,alpha=.5)\n'''\ncl=cl[:start]+virtual+cl[end:]\nfor num,steps in [(480,1),(481,2),(482,3)]:\n v=cl.replace('range(2,max(map(len,schedules))-4)',f'range(2,max(map(len,schedules))-{3+steps})').replace('final=t==max(map(len,schedules))-5',f'final=t==max(map(len,schedules))-{4+steps}')\n src=base[:a]+v+base[b:];name=f'{num}_episode8_class_adaptive{steps}_top2'\n p=root/name;p.mkdir(exist_ok=True);(p/'method.py').write_text(src)\n entries.append({'name':name,'hypothesis':'Certify class virtual transforms using outside-neighbor lower bounds; exact dense fallback for uncertain rows/columns.','sha256':hashlib.sha256(src.encode()).hexdigest()})\n(root/'episode8_round6_manifest.json').write_text(json.dumps(entries,indent=2));print('\\\\n'.join(e['name'] for e in entries))\nPY\npython /tmp/research_history/episode8_build_round6.py\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

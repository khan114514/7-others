{"type": "item.started", "item": {"id": "item_69", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/research_history/episode8_shuffle_stress.py <<'PY'\nimport hashlib,importlib.util,json,time\nfrom pathlib import Path\nimport numpy as np\nfrom scipy.stats import spearmanr\nroot=Path('/tmp/research_history')\nnames=['432_episode7_schedule_bounds','473_episode8_virtual_combine_point_last_logcolumn','490_episode8_mean_first_combine_shared_point_logcolumn','491_episode8_mean_first_combine_point_foldcol']\nmods=[]\nfor i,name in enumerate(['000_baseline']+names):\n spec=importlib.util.spec_from_file_location('stress'+str(i),root/name/'method.py')\n m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m);mods.append(m)\nrecords=[]\nfor seed in [101,505]:\n for corruption in ['uniform_labels','gaussian_016','mixed']:\n  p=Path('/workspace/environment/public_assets/dev')/f'seed_{seed}_{corruption}.npz'\n  z=np.load(p)\n  for trial in [1,2,3]:\n   shuffle_seed=10000+100*seed+trial\n   rng=np.random.default_rng(shuffle_seed)\n   ix=rng.permutation(len(z['x']));ir=rng.permutation(len(z['r']))\n   args=z['x'][ix],z['y'][ix],z['r'][ir],z['ry'][ir],int(z['seed'])\n   target=mods[0].value(*args)\n   quarter=len(target)//4;b=np.argsort(-target,kind='stable')[:quarter]\n   for name,m in zip(names,mods[1:]):\n    start=time.perf_counter();out=np.asarray(m.value(*args));seconds=time.perf_counter()-start\n    nr=float(np.sqrt(np.mean((out-target)**2))/target.std());rho=float(spearmanr(out,target).statistic)\n    a=np.argsort(-out,kind='stable')[:quarter];top=len(set(a)&set(b))/quarter\n    r={'source':name,'public_source':p.stem,'shuffle_seed':shuffle_seed,'seconds':seconds,'nrmse':nr,'rho':rho,'top':top,'valid':bool(np.isfinite(out).all() and nr<=.01 and rho>=.999 and top>=.98)}\n    records.append(r);print(json.dumps(r),flush=True)\nsummary=[]\nfor name in names:\n rr=[r for r in records if r['source']==name]\n s={'source':name,'cases':len(rr),'failures':sum(not r['valid'] for r in rr),'worst_nrmse':max(r['nrmse'] for r in rr),'min_rho':min(r['rho'] for r in rr),'min_top':min(r['top'] for r in rr)}\n summary.append(s);print('SUMMARY',json.dumps(s),flush=True)\n(root/'episode8_shuffle_stress.json').write_text(json.dumps({'explanation':'Diagnostic synthetic reorders of public arrays; targets computed from canonical initial source, not protected targets. Not an evaluator score.','summary':summary,'records':records},indent=2))\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

{"type": "item.started", "item": {"id": "item_55", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/research_history/build_episode6_conditional_point.py <<'PY'\nfrom pathlib import Path\nroot=Path('/tmp/research_history');base=(root/'265_mean_skip3_linear_column/method.py').read_text()\ndef save(name,s):\n d=root/name;d.mkdir(exist_ok=True);(d/'method.py').write_text(s)\nfor k,mode,earlier in [(329,'pooled',False),(330,'class',False),(331,'means',False),(332,'pooled',True),(333,'class',True)]:\n helper='''def _point_conditional(a,b,ya,yb,L):\n    A=torch.from_numpy(a);B=torch.from_numpy(b)\n    ay=torch.from_numpy(ya);by=torch.from_numpy(yb)\n    ac=A-A.mean(0);bc=B-B.mean(0)\n    an=torch.bincount(ay,minlength=10).float();bn=torch.bincount(by,minlength=10).float()\n    aw=an/len(a);bw=bn/len(b)\n    am=torch.zeros((10,10));bm=torch.zeros((10,10))\n    am.index_add_(0,ay,ac);bm.index_add_(0,by,bc)\n    am/=an.clamp(min=1)[:,None];bm/=bn.clamp(min=1)[:,None]\n    LL=torch.from_numpy(L);q=LL-(LL @ bw)[:,None]-(aw @ LL)[None,:]+aw @ LL @ bw\n    row=ac @ bm.T-q[ay];col=bc @ am.T-q.T[by]\n'''\n if mode=='pooled':helper+='''    aci=ac-am[ay];bci=bc-bm[by]\n    va=aci.T @ aci/len(a);vb=bci.T @ bci/len(b)\n    rv=((ac @ vb)*ac).sum(1);cv=((bc @ va)*bc).sum(1)\n'''\n elif mode=='class':helper+='''    aci=ac-am[ay];bci=bc-bm[by]\n    va=torch.stack([aci[ay==i].T @ aci[ay==i]/an[i].clamp(min=1) for i in range(10)])\n    vb=torch.stack([bci[by==j].T @ bci[by==j]/bn[j].clamp(min=1) for j in range(10)])\n    rv=(torch.matmul(ac,vb)*ac[None,:,:]).sum(2).T\n    cv=(torch.matmul(bc,va)*bc[None,:,:]).sum(2).T\n'''\n if mode=='means':helper+='''    def transform(eps):\n        ft=-eps*(row/eps+bw.log()[None,:]).logsumexp(1)\n        gt=-eps*(col/eps+aw.log()[None,:]).logsumexp(1)\n        return ft,gt\n    return transform\n\n'''\n elif mode=='pooled':helper+='''    def transform(eps):\n        ft=-eps*(row/eps+bw.log()[None,:]).logsumexp(1)-rv/(2*eps)\n        gt=-eps*(col/eps+aw.log()[None,:]).logsumexp(1)-cv/(2*eps)\n        return ft,gt\n    return transform\n\n'''\n else:helper+='''    def transform(eps):\n        ft=-eps*(row/eps+rv/(2*eps*eps)+bw.log()[None,:]).logsumexp(1)\n        gt=-eps*(col/eps+cv/(2*eps*eps)+aw.log()[None,:]).logsumexp(1)\n        return ft,gt\n    return transform\n\n'''\n s=base.replace('def _dual(C, schedule):','def _dual(C, schedule, conditional):').replace('    f=C.mean(1);g=C.mean(0)','    f=C.mean(1);g=C.mean(0)\\\\n    mu=-f.mean()')\n s=s.replace('\\\\ndef _dual(', '\\\\n'+helper+'\\\\ndef _dual(')\n s=s.replace('_dual(T,_schedule(z1,z2))','_dual(T,_schedule(z1,z2),_point_conditional(a,b,y[idx],ry[jdx],WL))')\n s=s.replace('''    for eps in schedule[3:-3]:\n        if K is None or eps<=2.:''','''    point_steps=schedule[3:-3]\n    for step,eps in enumerate(point_steps):\n        if step==0:\n            df,dg=conditional(eps)\n            f+=.5*(mu+df);g+=.5*(mu+dg)\n            pe=eps;full=False\n            continue\n        if K is None or eps<=2.:''')\n if earlier:s=s.replace('schedule[3:-3]','schedule[2:-3]')\n save(f'{k}_point_conditional_{mode}_early{int(earlier)}',s)\nPY\npython /tmp/research_history/build_episode6_conditional_point.py\ncat >> /tmp/research_history/episode_6_working_notes.md <<'TXT'\n\n321-328 test increasinglyhard-onlyclassannealing withsamefullsupportsandschedules, includingminimalexplicit allhardclasssolver328. Conditionalpointfamily329-333 replacesfirstretainedpointtransform withanalytic class-conditional Gaussianfeaturemoments andexactlabelmixture atall10observedlabels;comparepooledwithinclasscovariance,class-specificcovariance,andmeans-only,atretainedt3andearliercoarse2. Unlikeglobalcumulant310, thesecomputeexactlog-sum-expacrosslabels andcapturebetweenclassfeaturemeans. No training orstoredparameters;derivedfreshfromarrays. Preparedwhile303officialrunning,numericalscreensstillpending.\nTXT\ntail -c 2000 /tmp/research_history/303_combo_hard64_late2_skip2_last0/evaluator.log\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

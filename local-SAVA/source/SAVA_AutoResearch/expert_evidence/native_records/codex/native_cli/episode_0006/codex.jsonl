v/seed_101_mixed.npz\n/workspace/environment/public_assets/dev/seed_303_asymmetric_labels.npz\n/workspace/environment/public_assets/dev/seed_303_uniform_labels.npz\n/workspace/environment/public_assets/dev/seed_505_gaussian_016.npz\n/workspace/environment/public_assets/dev/seed_404_uniform_labels.npz\n/workspace/environment/public_assets/dev/seed_101_gaussian_008.npz\n/workspace/environment/public_assets/dev/seed_202_uniform_labels.npz\nimport importlib.util,sys,time\nfrom pathlib import Path\nimport numpy as np\nfrom scipy.stats import spearmanr\nmods=[]\nfor path in sys.argv[1:]:\n spec=importlib.util.spec_from_file_location('m'+str(len(mods)),path)\n m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m);mods.append((path,m))\nfor p in sorted(Path('/workspace/environment/public_assets/dev').glob('*.npz')):\n z=np.load(p); args=(z['x'],z['y'],z['r'],z['ry'],int(z['seed']))\n cache=Path('/tmp/research_history/'+p.stem+'_canonical.npy')\n if cache.exists():target=np.load(cache)\n else:\n  target=mods[0][1].value(*args);np.save(cache,target)\n for path,m in mods[1:]:\n  t=time.perf_counter();out=m.value(*args);dt=time.perf_counter()-t\n  n=len(out);a=np.argsort(-out,kind='stable')[:n//4];b=np.argsort(-target,kind='stable')[:n//4]\n  nr=np.sqrt(np.mean((out-target)**2))/target.std();rho=spearmanr(out,target).statistic;top=len(set(a)&set(b))/(n//4)\n  print(p.stem,Path(path).parent.name,'time',round(dt,4),'nrmse',nr,'rho',rho,'top',top,'valid',nr<=.01 and rho>=.999 and top>=.98,flush=True)\nimport subprocess,sys,json\nfrom pathlib import Path\nimport numpy as np\npaths=sys.argv[1:]\nchild='''import importlib.util,sys,time,json\nimport numpy as np\np=sys.argv[1];spec=importlib.util.spec_from_file_location('m',p);m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)\nz=np.load('/workspace/environment/public_assets/dev/seed_303_gaussian_016.npz');args=(z['x'],z['y'],z['r'],z['ry'],int(z['seed']))\nt=time.perf_counter();v=m.value(*args);dt=time.per
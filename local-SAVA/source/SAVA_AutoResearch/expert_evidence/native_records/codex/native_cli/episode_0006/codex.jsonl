{"type": "item.started", "item": {"id": "item_19", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/research_history/build_episode6_first.py <<'PY'\nfrom pathlib import Path\nroot=Path('/tmp/research_history')\nbase=(root/'265_mean_skip3_linear_column/method.py').read_text()\ndef save(name,s):\n d=root/name;d.mkdir(exist_ok=True);(d/'method.py').write_text(s)\n# Hybrid class hard-refinement, retaining exactly the same updates.\ns=base\nneedle='''        if K is None or float(eps.max())<=8.:\n            ft,gt,K,shift,rs,cs=direct(f,g,eps)'''\nreplacement='''        if float(eps.max())<=8.:\n            cn=C.numpy();fn=f.numpy().copy();gn=g.numpy().copy()\n            am=amask.numpy();bm=bmask.numpy();lan=la.numpy();lbn=lb.numpy()\n            residual=np.empty_like(cn)\n            for u in range(t,max(map(len,schedules))):\n                ep=np.asarray([z[u] if u<len(z) else .1 for z in schedules],np.float32)[:,None]\n                ac=np.asarray([u<len(z) for z in schedules])[:,None]\n                np.subtract(cn,fn[:,:,None],out=residual);residual-=gn[:,None,:]\n                nf=np.where(am,fn+residual.min(2)-ep*lbn,0.)\n                ng=np.where(bm,gn+residual.min(1)-ep*lan,0.)\n                fn=np.where(ac,(fn+nf)*.5,fn);gn=np.where(ac,(gn+ng)*.5,gn)\n            f=torch.from_numpy(fn);g=torch.from_numpy(gn)\n            break\n        if K is None:\n            ft,gt,K,shift,rs,cs=direct(f,g,eps)'''\nassert needle in s;s=s.replace(needle,replacement)\nsave('267_numpy_hard_class',s)\n# Split class hard transforms so both reduce contiguous last dimensions.\ns=base;start=s.index('def _label_cost');a=s[:start];b=s[start:]\nb=b.replace('''    K=None;pe=None;shift=None;rs=None;cs=None;pa=None''','''    D=C.transpose(1,2).contiguous()\n    K=None;pe=None;shift=None;rs=None;cs=None;pa=None''')\nb=b.replace('''        R=(C-f[:,:,None]).sub_(g[:,None,:])\n        if float(eps.max())<=8.:\n            ft=f+R.amin(2)-eps[:,None]*lb\n            gt=g+R.amin(1)-eps[:,None]*la''','''        if float(eps.max())<=8.:\n            ft=(C-g[:,None,:]).amin(2)-eps[:,None]*lb\n            gt=(D-f[:,None,:]).amin(2)-eps[:,None]*la''')\nb=b.replace('''        rm=R.amin((1,2))''','''        R=(C-f[:,:,None]).sub_(g[:,None,:])\n        rm=R.amin((1,2))''',1)\nsave('268_contiguous_hard_class',a+b)\n# Exact in-place vector updates reduce small Torch allocations.\ns=base;s=s.replace('''        f=torch.where(active,(f+ft)*.5,f);g=torch.where(active,(g+gt)*.5,g)''','''        f.add_(torch.where(active,ft-f,0.),alpha=.5)\n        g.add_(torch.where(active,gt-g,0.),alpha=.5)''')\nsave('269_inplace_class_duals',s)\n# Class moment transform, centered at pair means; exact radial weighting.\nfor k,steps in [(270,1),(271,2),(272,3)]:\n s=base\n needle='''    K=None;shift=None;rs=None;cs=None\n    pe=eps;pa=torch.ones((100,1),dtype=torch.bool);full=True'''\n repl='''    center=(amean+bmean)/2\n    ac=(A-center[:,None,:])*amask[:,:,None];bc=(B-center[:,None,:])*bmask[:,:,None]\n    ar=ac.square().sum(2)/2;br=bc.square().sum(2)/2\n    qi=torch.triu_indices(10,10);fac=torch.where(qi[0]==qi[1],2.**.5,1.)\n    AP=torch.cat((torch.ones((100,nmax,1)),ac,ac[:,:,qi[0]]*ac[:,:,qi[1]]/fac),2)\n    BP=torch.cat((torch.ones((100,mmax,1)),bc,bc[:,:,qi[0]]*bc[:,:,qi[1]]/fac),2)\n    powers=torch.tensor([0.]+[1.]*10+[2.]*len(fac))\n    def moments(f,g,ep):\n        fm=f.amax(1);gm=g.amax(1)\n        ua=((f-fm[:,None]-ar)/ep[:,None]).exp()*amask\n        vb=((g-gm[:,None]-br)/ep[:,None]).exp()*bmask\n        ma=(AP*ua[:,:,None]).sum(1);mb=(BP*vb[:,:,None]).sum(1)\n        alpha=ep[:,None].pow(-powers)\n        ra=(AP*(mb*alpha)[:,None,:]).sum(2).clamp_(min=1e-30)\n        rb=(BP*(ma*alpha)[:,None,:]).sum(2).clamp_(min=1e-30)\n        ft=ar-gm[:,None]-ep[:,None]*(ra.log()+lb)\n        gt=br-fm[:,None]-ep[:,None]*(rb.log()+la)\n        return torch.where(amask,ft,0.),torch.where(bmask,gt,0.)\n    K=None;shift=None;rs=None;cs=None\n    pe=eps;pa=torch.ones((100,1),dtype=torch.bool);full=True'''\n assert needle in s;s=s.replace(needle,repl)\n needle='''        if K is None or float(eps.max())<=8.:\n            ft,gt,K,shift,rs,cs=direct(f,g,eps)'''\n repl=f'''        if t<{2+steps}:\n            ft,gt=moments(f,g,eps)\n            f=torch.where(active,(f+ft)*.5,f);g=torch.where(active,(g+gt)*.5,g)\n            K=None;pe=eps;pa=active;full=False\n            continue\n        if K is None or float(eps.max())<=8.:\n            ft,gt,K,shift,rs,cs=direct(f,g,eps)'''\n assert needle in s;s=s.replace(needle,repl)\n save(f'{k}_class_moment2_{steps}',s)\n# Reusable sparse min-plus class neighborhoods at the hard-transform switch.\nfor k,neighbors in [(273,1),(274,2),(275,4),(276,8)]:\n s=base\n s=s.replace('''    K=None;pe=None;shift=None;rs=None;cs=None;pa=None\n    def direct(f,g,eps):''','''    K=None;pe=None;shift=None;rs=None;cs=None;pa=None\n    edges=None\n    def sparse(f,g,eps):\n        nonlocal edges\n        if edges is None:\n            residual=(C-f[:,:,None]).sub_(g[:,None,:])\n            ri=residual.topk(NEIGHBORS,dim=2,largest=False,sorted=False).indices\n            ci=residual.topk(NEIGHBORS,dim=1,largest=False,sorted=False).indices.transpose(1,2).contiguous()\n            rc=C.gather(2,ri);cc=C.transpose(1,2).gather(2,ci)\n            edges=ri,ci,rc,cc\n        ri,ci,rc,cc=edges\n        rg=g.gather(1,ri.reshape(100,-1)).reshape(ri.shape)\n        cf=f.gather(1,ci.reshape(100,-1)).reshape(ci.shape)\n        ft=(rc-rg).amin(2)-eps[:,None]*lb\n        gt=(cc-cf).amin(2)-eps[:,None]*la\n        return torch.where(amask,ft,0.),torch.where(bmask,gt,0.)\n    def direct(f,g,eps):'''.replace('NEIGHBORS',str(neighbors)))\n s=s.replace('''        R=(C-f[:,:,None]).sub_(g[:,None,:])\n        if float(eps.max())<=8.:\n            ft=f+R.amin(2)-eps[:,None]*lb\n            gt=g+R.amin(1)-eps[:,None]*la\n            return torch.where(amask,ft,0.),torch.where(bmask,gt,0.),None,None,None,None\n        rm=R.amin((1,2))''','''        if float(eps.max())<=8.:\n            ft,gt=sparse(f,g,eps)\n            return ft,gt,None,None,None,None\n        R=(C-f[:,:,None]).sub_(g[:,None,:])\n        rm=R.amin((1,2))''')\n # final dense transform checks all edges regardless of refinement neighborhood\n save(f'{k}_sparse_class_hard{neighbors}',s)\nPY\npython /tmp/research_history/build_episode6_first.py\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

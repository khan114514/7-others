{"type": "item.completed", "item": {"id": "item_9", "type": "command_execution", "command": "/bin/sh -lc 'cat /tmp/research_history/011_sparse_labels/method.py && cat /tmp/research_history/017_fused_reductions/method.py'", "aggregated_output": "\"\"\"Hierarchical transport with reusable costs and explicit annealed dual solves.\"\"\"\nimport numpy as np\nimport torch\nimport ot\nfrom scipy.spatial.distance import cdist\n\n\ndef _schedule(a, b):\n    lo = torch.minimum(a.amin(0), b.amin(0))\n    hi = torch.maximum(a.amax(0), b.amax(0))\n    diameter = float(torch.linalg.vector_norm(hi - lo))\n    return [diameter**2] + [float(np.exp(e)) for e in np.arange(2*np.log(diameter), np.log(.1), 2*np.log(.5))] + [.1]\n\n\ndef _dual(C, schedule):\n    D=C.T.contiguous()\n    n,m=C.shape\n    la=float(np.log(np.float32(1./n)))\n    lb=float(np.log(np.float32(1./m)))\n    cmin=float(C.min()); span=float(C.max())-cmin\n    row_index=None; col_index=None; row_cost=None; col_cost=None\n    def lse(T,h,eps,lw):\n        return -eps*(h[None,:]/eps+lw-T/eps).logsumexp(1)\n    def transforms(f,g,eps):\n        nonlocal row_index,col_index,row_cost,col_cost\n        if eps<=32.:\n            if row_index is None:\n                row_index=(C-g[None,:]).topk(min(32,m),dim=1,largest=False).indices\n                col_index=(D-f[None,:]).topk(min(32,n),dim=1,largest=False).indices\n                row_cost=C.gather(1,row_index)\n                col_cost=D.gather(1,col_index)\n            ft=-eps*((g[row_index]-row_cost)/eps+lb).logsumexp(1)\n            gt=-eps*((f[col_index]-col_cost)/eps+la).logsumexp(1)\n            return ft,gt\n        if span/eps<60.:\n            K=torch.exp((cmin-C)/eps)\n            fm=float(f.max());gm=float(g.max())\n            ft=cmin-gm-eps*((K @ torch.exp((g-gm)/eps)).log()+lb)\n            gt=cmin-fm-eps*((K.T @ torch.exp((f-fm)/eps)).log()+la)\n            if bool(torch.isfinite(ft).all()) and bool(torch.isfinite(gt).all()):\n                return ft,gt\n        return lse(C,g,eps,lb),lse(D,f,eps,la)\n    eps=schedule[0]\n    f,g=transforms(torch.zeros(n),torch.zeros(m),eps)\n    for eps in schedule:\n        ft,gt=transforms(f,g,eps)\n        f,g=(f+ft)*.5,(g+gt)*.5\n    return transforms(f,g,eps)\n\n\ndef _label_cost(x, y, r, ry):\n    aa = [torch.from_numpy(x[y == i]) for i in range(10)]\n    bb = [torch.from_numpy(r[ry == j]) for j in range(10)]\n    pairs = [(a, b) for a in aa for b in bb]\n    nmax = max(len(a) for a in aa)\n    mmax = max(len(b) for b in bb)\n    A = torch.zeros((100, nmax, x.shape[1]))\n    B = torch.zeros((100, mmax, r.shape[1]))\n    an = torch.tensor([len(a) for a, b in pairs])\n    bn = torch.tensor([len(b) for a, b in pairs])\n    schedules = []\n    for k, (a, b) in enumerate(pairs):\n        A[k, :len(a)] = a\n        B[k, :len(b)] = b\n        schedules.append(_schedule(a, b))\n    C = ((A*A).sum(2)[:,:,None] - 2*torch.bmm(A,B.transpose(1,2)) + (B*B).sum(2)[:,None,:])/2\n    amask = torch.arange(nmax)[None,:] < an[:,None]\n    bmask = torch.arange(mmax)[None,:] < bn[:,None]\n    C.masked_fill_(~(amask[:,:,None] & bmask[:,None,:]), float('inf'))\n    D = C.transpose(1,2).contiguous()\n    la = (1/an.float()).log()[:,None]\n    lb = (1/bn.float()).log()[:,None]\n    neighbors={}\n    def transform(T,h,eps,lw,outmask,key):\n        if float(eps.max())<=32.:\n            if key not in neighbors:\n                idx=(T-h[:,None,:]).topk(min(32,h.shape[1]),dim=2,largest=False).indices\n                neighbors[key]=(idx,T.gather(2,idx))\n            idx,cost=neighbors[key]\n            selected=h.gather(1,idx.reshape(100,-1)).reshape(idx.shape)\n            out=-eps[:,None]*((selected-cost)/eps[:,None,None]+lw[:,:,None]).logsumexp(2)\n            return torch.where(outmask,out,0.)\n        v=h[:,None,:]/eps[:,None,None]+lw[:,:,None]-T/eps[:,None,None]\n        out=-eps[:,None]*v.logsumexp(2)\n        return torch.where(outmask,out,0.)\n    eps = torch.tensor([z[0] for z in schedules])\n    f=transform(C,torch.zeros((100,mmax)),eps,lb,amask,0)\n    g=transform(D,torch.zeros((100,nmax)),eps,la,bmask,1)\n    for t in range(max(len(z) for z in schedules)):\n        eps=torch.tensor([z[t] if t < len(z) else .1 for z in schedules])\n        active=torch.tensor([t < len(z) for z in schedules])[:,None]\n        ft=transform(C,g,eps,lb,amask,0)\n        gt=transform(D,f,eps,la,bmask,1)\n        f=torch.where(active,(f+ft)*.5,f)\n        g=torch.where(active,(g+gt)*.5,g)\n    eps=torch.full((100,),.1)\n    ft=transform(C,g,eps,lb,amask,0)\n    gt=transform(D,f,eps,la,bmask,1)\n    costs=(ft/an[:,None]).sum(1)+(gt/bn[:,None]).sum(1)\n    W=np.zeros((20,20),np.float32)\n    W[:10,10:]=costs.numpy().reshape(10,10)\n    W[10:,:10]=W[:10,10:].T\n    return W\n\n\ndef _expectation(C):\n    n,m=C.shape\n    K=torch.exp(C/(-.1*float(C.max())))\n    u=torch.full((n,),1./n)\n    v=torch.full((m,),1./m)\n    D=K.T.contiguous()\n    for it in range(200):\n        v=(1./m)/(D @ u)\n        u=(1./n)/(K @ v)\n        if it%10==0 and float(torch.linalg.vector_norm(v*(D @ u)-1./m))<1e-7:\n            break\n    return float(torch.dot(u,(K*C) @ v))\n\n\ndef value(x, y, r, ry, seed=17, batch_size=1024):\n    torch.set_num_threads(2)\n    x=np.asarray(x,np.float32); r=np.asarray(r,np.float32)\n    y=np.asarray(y,np.int64); ry=np.asarray(ry,np.int64)\n    tx=[np.arange(i,min(i+batch_size,len(x))) for i in range(0,len(x),batch_size)]\n    tr=[np.arange(i,min(i+batch_size,len(r))) for i in range(0,len(r),batch_size)]\n    with torch.inference_mode():\n        W=_label_cost(x[tx[0]],y[tx[0]],r[tr[0]],ry[tr[0]])\n        F={}; batchcost=np.zeros((len(tx),len(tr)))\n        for i,idx in enumerate(tx):\n            for j,jdx in enumerate(tr):\n                a=x[idx]; b=r[jdx]\n                C=cdist(a,b,'sqeuclidean')/2+W[y[idx,None],ry[jdx][None,:]+10]/2\n                T=torch.from_numpy(C).float()\n                batchcost[i,j]=_expectation(T)/(len(idx)+len(jdx))\n                z1=torch.tensor(np.column_stack([a,y[idx]]),dtype=torch.float32)\n                z2=torch.tensor(np.column_stack([b,ry[jdx]+10]),dtype=torch.float32)\n                # Reuse the same empirical geometry for coupling and point potentials.\n                f,_=_dual(T,_schedule(z1,z2))\n                f=f.numpy().ravel().astype(float)\n                F[i,j]=(f-f.mean())*len(f)/(len(f)-1)\n    Q=ot.sinkhorn(ot.unif(len(tx)),ot.unif(len(tr)),batchcost/max(float(batchcost.max()),1e-12),.01,numItermax=10000,stopThr=1e-10)\n    values=np.zeros(len(x))\n    for i,idx in enumerate(tx): values[idx]=sum(Q[i,j]*F[i,j] for j in range(len(tr)))\n    return values\n\"\"\"Hierarchical transport with reusable costs and explicit annealed dual solves.\"\"\"\nimport numpy as np\nimport torch\nimport ot\nfrom scipy.spatial.distance import cdist\n\n\ndef _schedule(a, b):\n    lo = torch.minimum(a.amin(0), b.amin(0))\n    hi = torch.maximum(a.amax(0), b.amax(0))\n    diameter = float(torch.linalg.vector_norm(hi - lo))\n    return [diameter**2] + [float(np.exp(e)) for e in np.arange(2*np.log(diameter), np.log(.1), 2*np.log(.5))] + [.1]\n\n\ndef _dual(C, schedule):\n    D = C.T.contiguous()\n    la = float(np.log(np.float32(1.0 / C.shape[0])))\n    lb = float(np.log(np.float32(1.0 / C.shape[1])))\n    def transform(A, h, eps, lw):\n        if eps <= 8.0:\n            return (A - h[None, :]).amin(1) - eps * lw\n        return -eps * ((h[None, :] - A) / eps).logsumexp(1) - eps * lw\n    eps = schedule[0]\n    f = transform(C, torch.zeros(C.shape[1]), eps, lb)\n    g = transform(D, torch.zeros(C.shape[0]), eps, la)\n    for eps in schedule:\n        ft = transform(C, g, eps, lb)\n        gt = transform(D, f, eps, la)\n        f, g = (f + ft) * .5, (g + gt) * .5\n    return transform(C, g, eps, lb), transform(D, f, eps, la)\n\n\ndef _label_cost(x, y, r, ry):\n    aa = [torch.from_numpy(x[y == i]) for i in range(10)]\n    bb = [torch.from_numpy(r[ry == j]) for j in range(10)]\n    pairs = [(a, b) for a in aa for b in bb]\n    nmax = max(len(a) for a in aa)\n    mmax = max(len(b) for b in bb)\n    A = torch.zeros((100, nmax, x.shape[1]))\n    B = torch.zeros((100, mmax, r.shape[1]))\n    an = torch.tensor([len(a) for a, b in pairs])\n    bn = torch.tensor([len(b) for a, b in pairs])\n    schedules = []\n    for k, (a, b) in enumerate(pairs):\n        A[k, :len(a)] = a\n        B[k, :len(b)] = b\n        schedules.append(_schedule(a, b))\n    C = ((A*A).sum(2)[:,:,None] - 2*torch.bmm(A,B.transpose(1,2)) + (B*B).sum(2)[:,None,:])/2\n    amask = torch.arange(nmax)[None,:] < an[:,None]\n    bmask = torch.arange(mmax)[None,:] < bn[:,None]\n    C.masked_fill_(~(amask[:,:,None] & bmask[:,None,:]), float('inf'))\n    D = C.transpose(1,2).contiguous()\n    la = (1/an.float()).log()[:,None]\n    lb = (1/bn.float()).log()[:,None]\n    def transform(T, h, eps, lw, outmask):\n        if float(eps.max()) <= 8.0:\n            out=(T-h[:,None,:]).amin(2)-eps[:,None]*lw\n            return torch.where(outmask,out,0.)\n        v = (h[:,None,:] - T) / eps[:,None,None]\n        out = -eps[:,None] * v.logsumexp(2) - eps[:,None] * lw\n        return torch.where(outmask, out, 0.)\n    eps = torch.tensor([z[0] for z in schedules])\n    f=transform(C,torch.zeros((100,mmax)),eps,lb,amask)\n    g=transform(D,torch.zeros((100,nmax)),eps,la,bmask)\n    for t in range(max(len(z) for z in schedules)):\n        eps=torch.tensor([z[t] if t < len(z) else .1 for z in schedules])\n        active=torch.tensor([t < len(z) for z in schedules])[:,None]\n        ft=transform(C,g,eps,lb,amask)\n        gt=transform(D,f,eps,la,bmask)\n        f=torch.where(active,(f+ft)*.5,f)\n        g=torch.where(active,(g+gt)*.5,g)\n    eps=torch.full((100,),.1)\n    ft=transform(C,g,eps,lb,amask)\n    gt=transform(D,f,eps,la,bmask)\n    costs=(ft/an[:,None]).sum(1)+(gt/bn[:,None]).sum(1)\n    W=np.zeros((20,20),np.float32)\n    W[:10,10:]=costs.numpy().reshape(10,10)\n    W[10:,:10]=W[:10,10:].T\n    return W\n\n\ndef _expectation(C):\n    n,m=C.shape\n    K=torch.exp(C/(-.1*float(C.max())))\n    u=torch.full((n,),1./n)\n    v=torch.full((m,),1./m)\n    D=K.T.contiguous()\n    for it in range(200):\n        v=(1./m)/(D @ u)\n        u=(1./n)/(K @ v)\n        if it%10==0 and float(torch.linalg.vector_norm(v*(D @ u)-1./m))<1e-7:\n            break\n    return float(torch.dot(u,(K*C) @ v))\n\n\ndef value(x, y, r, ry, seed=17, batch_size=1024):\n    torch.set_num_threads(2)\n    x=np.asarray(x,np.float32); r=np.asarray(r,np.float32)\n    y=np.asarray(y,np.int64); ry=np.asarray(ry,np.int64)\n    tx=[np.arange(i,min(i+batch_size,len(x))) for i in range(0,len(x),batch_size)]\n    tr=[np.arange(i,min(i+batch_size,len(r))) for i in range(0,len(r),batch_size)]\n    with torch.inference_mode():\n        W=_label_cost(x[tx[0]],y[tx[0]],r[tr[0]],ry[tr[0]])\n        F={}; batchcost=np.zeros((len(tx),len(tr)))\n        for i,idx in enumerate(tx):\n            for j,jdx in enumerate(tr):\n                a=x[idx]; b=r[jdx]\n                C=cdist(a,b,'sqeuclidean')/2+W[y[idx,None],ry[jdx][None,:]+10]/2\n                T=torch.from_numpy(C).float()\n                batchcost[i,j]=_expectation(T)/(len(idx)+len(jdx))\n                z1=torch.tensor(np.column_stack([a,y[idx]]),dtype=torch.float32)\n                z2=torch.tensor(np.column_stack([b,ry[jdx]+10]),dtype=torch.float32)\n                # Reuse the same empirical geometry for coupling and point potentials.\n                f,_=_dual(T,_schedule(z1,z2))\n                f=f.numpy().ravel().astype(float)\n                F[i,j]=(f-f.mean())*len(f)/(len(f)-1)\n    Q=ot.sinkhorn(ot.unif(len(tx)),ot.unif(len(tr)),batchcost/max(float(batchcost.max()),1e-12),.01,numItermax=10000,stopThr=1e-10)\n    values=np.zeros(len(x))\n    for i,idx in enumerate(tx): values[idx]=sum(Q[i,j]*F[i,j] for j in range(len(tr)))\n    return values\n", "exit_code": 0, "status": "completed"}}

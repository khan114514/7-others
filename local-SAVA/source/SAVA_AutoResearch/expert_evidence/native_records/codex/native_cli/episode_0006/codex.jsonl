{"type": "item.completed", "item": {"id": "item_23", "type": "command_execution", "command": "/bin/sh -lc 'cat /tmp/research_history/129_packed_class_geometry/method.py && cat /tmp/research_history/build_episode5_class_truncation.py && cat /tmp/research_history/build_episode5_class_initial.py'", "aggregated_output": "\"\"\"Hierarchical transport with reusable costs and explicit annealed dual solves.\"\"\"\nimport numpy as np\nimport torch\nimport ot\nfrom scipy.spatial.distance import cdist\n\n\ndef _schedule(a, b):\n    lo = torch.minimum(a.amin(0), b.amin(0))\n    hi = torch.maximum(a.amax(0), b.amax(0))\n    diameter = float(torch.linalg.vector_norm(hi - lo))\n    return [diameter**2] + [float(np.exp(e)) for e in np.arange(2*np.log(diameter), np.log(.1), 2*np.log(.5))] + [.1]\n\n\ndef _dual(C, schedule):\n    n,m=C.shape\n    la=float(np.log(np.float32(1./n)));lb=float(np.log(np.float32(1./m)))\n    K=None; pe=None; shift=0.\n    def direct(f,g,eps):\n        R=C-f[:,None];R-=g[None,:]\n        if eps<=2.:\n            return f+R.amin(1)-eps*lb,g+R.amin(0)-eps*la,None,0.,None,None\n        rm=float(R.min());R-=rm;R*=(-1./eps)\n        R.clamp_(min=-80.).exp_()\n        rs=R.sum(1);cs=R.sum(0)\n        if min(float(rs.min()),float(cs.min()))<=2e-22:\n            R=C-f[:,None];R-=g[None,:];R*=(-1./eps)\n            rowmax=R.amax(1);colmax=R.amax(0)\n            rr=torch.exp(R-rowmax[:,None]).sum(1);cc=torch.exp(R-colmax[None,:]).sum(0)\n            return f-eps*(rowmax+rr.log()+lb),g-eps*(colmax+cc.log()+la),None,0.,None,None\n        return f+rm-eps*(rs.log()+lb),g+rm-eps*(cs.log()+la),R,rm,rs,cs\n    f,g,K,shift,rs,cs=direct(torch.zeros(n),torch.zeros(m),schedule[0])\n    pe=schedule[0];full=True\n    for eps in schedule[2:-3]:\n        if K is None or eps<=2.:\n            ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        else:\n            old_shift=shift\n            if full:\n                K.mul_((m/rs)[:,None]).mul_((n/cs)[None,:])\n            else:\n                K.mul_((m/rs).sqrt()[:,None]).mul_((n/cs).sqrt()[None,:])\n            if abs(pe/eps-4.)<1e-5:\n                K.square_().square_()\n            else:K.pow_(pe/eps)\n            shift=-old_shift if full else 0.\n            rs=K.sum(1);cs=K.sum(0)\n            if min(float(rs.min()/rs.max()),float(cs.min()/cs.max()))>2e-22:\n                ft=f+shift-eps*(rs.log()+lb);gt=g+shift-eps*(cs.log()+la)\n            else:ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        f=(f+ft)*.5;g=(g+gt)*.5;pe=eps;full=False\n    return (C-g[None,:]).amin(1)-.1*lb,None\n\n\ndef _label_cost(x, y, r, ry):\n    aa = [torch.from_numpy(x[y == i]) for i in range(10)]\n    bb = [torch.from_numpy(r[ry == j]) for j in range(10)]\n    pairs = [(a, b) for a in aa for b in bb]\n    nmax = max(len(a) for a in aa)\n    mmax = max(len(b) for b in bb)\n    an = torch.tensor([len(a) for a, b in pairs])\n    bn = torch.tensor([len(b) for a, b in pairs])\n    al=torch.stack([a.amin(0) for a in aa]);ah=torch.stack([a.amax(0) for a in aa])\n    bl=torch.stack([b.amin(0) for b in bb]);bh=torch.stack([b.amax(0) for b in bb])\n    diam=torch.linalg.vector_norm(torch.maximum(ah[:,None,:],bh[None,:,:])-torch.minimum(al[:,None,:],bl[None,:,:]),dim=2).flatten().tolist()\n    schedules=[[d*d]+[float(np.exp(e)) for e in np.arange(2*np.log(d),np.log(.1),2*np.log(.5))]+[.1] for d in diam]\n    A=torch.zeros((10,nmax,x.shape[1]));B=torch.zeros((10,mmax,r.shape[1]))\n    for i,a in enumerate(aa):A[i,:len(a)]=a\n    for j,b in enumerate(bb):B[j,:len(b)]=b\n    A=A.flatten(0,1);B=B.flatten(0,1)\n    C=((A*A).sum(1)[:,None]-2*(A @ B.T)+(B*B).sum(1)[None,:])/2\n    C=C.reshape(10,nmax,10,mmax).permute(0,2,1,3).contiguous().reshape(100,nmax,mmax)\n    amask = torch.arange(nmax)[None,:] < an[:,None]\n    bmask = torch.arange(mmax)[None,:] < bn[:,None]\n    C.masked_fill_(~(amask[:,:,None] & bmask[:,None,:]), float('inf'))\n    valid=amask[:,:,None]&bmask[:,None,:]\n    la=(1/an.float()).log()[:,None];lb=(1/bn.float()).log()[:,None]\n    K=None;pe=None;shift=None;rs=None;cs=None;pa=None\n    def direct(f,g,eps):\n        R=(C-f[:,:,None]).sub_(g[:,None,:])\n        if float(eps.max())<=8.:\n            ft=f+R.amin(2)-eps[:,None]*lb\n            gt=g+R.amin(1)-eps[:,None]*la\n            return torch.where(amask,ft,0.),torch.where(bmask,gt,0.),None,None,None,None\n        rm=R.amin((1,2))\n        K=R.sub_(rm[:,None,None]).div_(eps[:,None,None]).neg_().clamp_(min=-80.).exp_()\n        K.masked_fill_(~valid,0.)\n        rs=K.sum(2);cs=K.sum(1)\n        check=torch.minimum(torch.where(amask,rs,float('inf')).amin(1),torch.where(bmask,cs,float('inf')).amin(1))\n        if float((check/torch.maximum(rs.amax(1),cs.amax(1))).min())>2e-22:\n            ft=f+rm[:,None]-eps[:,None]*(rs.log()+lb)\n            gt=g+rm[:,None]-eps[:,None]*(cs.log()+la)\n            return torch.where(amask,ft,0.),torch.where(bmask,gt,0.),K,rm,rs,cs\n        v=(g[:,None,:]-C)/eps[:,None,None]\n        ft=-eps[:,None]*(v.logsumexp(2)+lb)\n        v=(f[:,:,None]-C)/eps[:,None,None]\n        gt=-eps[:,None]*(v.logsumexp(1)+la)\n        return torch.where(amask,ft,0.),torch.where(bmask,gt,0.),None,None,None,None\n    eps=torch.tensor([z[0] for z in schedules])\n    f,g,K,shift,rs,cs=direct(torch.zeros((100,nmax)),torch.zeros((100,mmax)),eps)\n    pe=eps;pa=torch.ones((100,1),dtype=torch.bool);full=True\n    for t in range(2,max(map(len,schedules))):\n        eps=torch.tensor([z[t] if t<len(z) else .1 for z in schedules])\n        active=torch.tensor([t<len(z) for z in schedules])[:,None]\n        if K is None or float(eps.max())<=8.:\n            ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        else:\n            if full:\n                ar=torch.where(amask,rs/bn[:,None],1.)\n                bc=torch.where(bmask,cs/an[:,None],1.)\n            else:\n                ar=torch.where(amask & pa,(rs/bn[:,None]).sqrt(),1.)\n                bc=torch.where(bmask & pa,(cs/an[:,None]).sqrt(),1.)\n            K.mul_(ar.reciprocal()[:,:,None]).mul_(bc.reciprocal()[:,None,:])\n            q=pe/eps\n            if bool(torch.all(torch.abs(q-4.)<1e-4)):K.square_().square_()\n            else:K.pow_(q[:,None,None])\n            shift=-shift if full else torch.where(pa[:,0],0.,shift)\n            rs=K.sum(2);cs=K.sum(1)\n            check=torch.minimum(torch.where(amask,rs,float('inf')).amin(1),torch.where(bmask,cs,float('inf')).amin(1))\n            if float((check/torch.maximum(rs.amax(1),cs.amax(1))).min())>2e-22:\n                ft=f+shift[:,None]-eps[:,None]*(rs.log()+lb)\n                gt=g+shift[:,None]-eps[:,None]*(cs.log()+la)\n                ft=torch.where(amask,ft,0.);gt=torch.where(bmask,gt,0.)\n            else:ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        f=torch.where(active,(f+ft)*.5,f);g=torch.where(active,(g+gt)*.5,g)\n        pe=eps;pa=active;full=False\n    ft,gt,_,_,_,_=direct(f,g,torch.full((100,),.1))\n    costs=(ft/an[:,None]).sum(1)+(gt/bn[:,None]).sum(1)\n    W=np.zeros((20,20),np.float32)\n    W[:10,10:]=costs.numpy().reshape(10,10);W[10:,:10]=W[:10,10:].T\n    return W\n\n\ndef _expectation(C):\n    n,m=C.shape\n    K=torch.exp(C/(-.1*float(C.max())))\n    u=torch.full((n,),1./n)\n    v=torch.full((m,),1./m)\n    D=K.T.contiguous()\n    for it in range(2):\n        v=(1./m)/(D @ u)\n        u=(1./n)/(K @ v)\n    return float(torch.dot(u,(K*C) @ v))\n\n\ndef _outer(batchcost):\n    n,m=batchcost.shape\n    cost=batchcost/max(float(batchcost.max()),1e-12)\n    if m!=2:\n        return ot.sinkhorn(ot.unif(n),ot.unif(m),cost,.01,numItermax=10000,stopThr=1e-10)\n    d=(cost[:,1]-cost[:,0])/.01\n    lo=-float(d.max())-40.;hi=-float(d.min())+40.\n    z=-float(d.mean())\n    for it in range(50):\n        s=1./(1.+np.exp(-np.clip(d+z,-700.,700.)))\n        err=float(s.mean())-.5\n        if abs(err)<1e-13:break\n        if err>0.:hi=z\n        else:lo=z\n        deriv=float((s*(1.-s)).mean())\n        next_z=z-err/max(deriv,1e-30)\n        z=next_z if lo<next_z<hi else (lo+hi)/2.\n    return np.column_stack((s,1.-s))/n\n\n\ndef value(x, y, r, ry, seed=17, batch_size=1024):\n    torch.set_flush_denormal(True)\n    torch.set_num_threads(2)\n    x=np.asarray(x,np.float32); r=np.asarray(r,np.float32)\n    y=np.asarray(y,np.int64); ry=np.asarray(ry,np.int64)\n    tx=[np.arange(i,min(i+batch_size,len(x))) for i in range(0,len(x),batch_size)]\n    tr=[np.arange(i,min(i+batch_size,len(r))) for i in range(0,len(r),batch_size)]\n    with torch.inference_mode():\n        W=_label_cost(x[tx[0]],y[tx[0]],r[tr[0]],ry[tr[0]])\n        F={}; batchcost=np.zeros((len(tx),len(tr)))\n        for i,idx in enumerate(tx):\n            for j,jdx in enumerate(tr):\n                a=x[idx]; b=r[jdx]\n                T=torch.cdist(torch.from_numpy(a),torch.from_numpy(b)).square()/2\n                T+=torch.from_numpy(W)[y[idx,None],ry[jdx][None,:]+10]/2\n                batchcost[i,j]=_expectation(T)/(len(idx)+len(jdx))\n                z1=torch.tensor(np.column_stack([a,y[idx]]),dtype=torch.float32)\n                z2=torch.tensor(np.column_stack([b,ry[jdx]+10]),dtype=torch.float32)\n                # Reuse the same empirical geometry for coupling and point potentials.\n                f,_=_dual(T,_schedule(z1,z2))\n                f=f.numpy().ravel().astype(float)\n                F[i,j]=(f-f.mean())*len(f)/(len(f)-1)\n    Q=_outer(batchcost)\n    values=np.zeros(len(x))\n    for i,idx in enumerate(tx): values[idx]=sum(Q[i,j]*F[i,j] for j in range(len(tr)))\n    return values\nfrom pathlib import Path\nroot=Path('/tmp/research_history');base=(root/'162_precomputed_norm_geometry/method.py').read_text()\nfor late,name in [(1,'184_class_late1'),(2,'185_class_late2'),(3,'186_class_late3'),(4,'187_class_late4')]:\n s=base.replace('range(2,max(map(len,schedules)))','range(2,max(map(len,schedules))-'+str(late)+')')\n p=root/name;p.mkdir(exist_ok=True);(p/'method.py').write_text(s)\nwith (root/'episode_5_working_notes.md').open('a') as f:f.write('\\n184-187 controlled ablation of last1/2/3/4 class symmetric refinements, retaining final calibrated hard transforms and all input supports. Prior point schedule experiments did not resolve this independent class schedule effect. Not screened yet.\\n')\nfrom pathlib import Path\nroot=Path('/tmp/research_history');base=(root/'224_mean_initial/method.py').read_text()\nold='    f,g,K,shift,rs,cs=direct(torch.zeros((100,nmax)),torch.zeros((100,mmax)),eps)'\nfor mode,name in [('dense','236_mean_point_class'),('analytic','237_analytic_class_mean')]:\n if mode=='dense':new='''    CC=torch.where(valid,C,0.)\n    f=torch.where(amask,CC.sum(2)/bn[:,None],0.)\n    g=torch.where(bmask,CC.sum(1)/an[:,None],0.)\n    K=None;shift=None;rs=None;cs=None'''\n else:new='''    amean=A.sum(1)/an[:,None];bmean=B.sum(1)/bn[:,None]\n    asq=A.square().sum(2)/2;bsq=B.square().sum(2)/2\n    f=torch.where(amask,asq+bsq.sum(1)[:,None]/bn[:,None]-(A*bmean[:,None,:]).sum(2),0.)\n    g=torch.where(bmask,bsq+asq.sum(1)[:,None]/an[:,None]-(B*amean[:,None,:]).sum(2),0.)\n    K=None;shift=None;rs=None;cs=None'''\n s=base.replace(old,new)\n p=root/name;p.mkdir(exist_ok=True);(p/'method.py').write_text(s)\nfor threshold,name in [(16,'238_class_hard16_mean'),(32,'239_class_hard32_mean')]:\n s=base.replace('float(eps.max())<=8.','float(eps.max())<='+str(threshold)+'.')\n p=root/name;p.mkdir(exist_ok=True);(p/'method.py').write_text(s)\nwith (root/'episode_5_working_notes.md').open('a') as f:f.write('\\n236/237 replacealsofirstclasssofttransformswithmeanpotentialseitherdensereeductionoranalyticalclassfeaturemeans. Preserveempiricalsupports andfiniteannealing;resumeexactstabletransformsfirstreducedtemperature.238/239increaseclasshardthreshold16/32withmeanpointinitial toboundearlyhard-minaccuracy andspeed. Not screened.\\n')\n", "exit_code": 0, "status": "completed"}}

{"type": "item.started", "item": {"id": "item_37", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/research_history/build_episode6_covariance.py <<'PY'\nfrom pathlib import Path\nroot=Path('/tmp/research_history');base=(root/'265_mean_skip3_linear_column/method.py').read_text()\ndef save(name,s):\n d=root/name;d.mkdir(exist_ok=True);(d/'method.py').write_text(s)\n# Exact first residual mean and variance from feature covariance tensors.\nfor k,mode in [(295,'torch'),(296,'numpy')]:\n s=base\n needle='''    K=None;shift=None;rs=None;cs=None\n    pe=eps;pa=torch.ones((100,1),dtype=torch.bool);full=True'''\n if mode=='torch':\n  repl='''    ac=(A-amean[:,None,:])*amask[:,:,None];bc=(B-bmean[:,None,:])*bmask[:,:,None]\n    va=torch.bmm(ac.transpose(1,2),ac)/an[:,None,None]\n    vb=torch.bmm(bc.transpose(1,2),bc)/bn[:,None,None]\n    rowvar=(torch.bmm(ac,vb)*ac).sum(2)\n    colvar=(torch.bmm(bc,va)*bc).sum(2)\n    residualmean=(amean*bmean).sum(1)-asq.sum(1)/an-bsq.sum(1)/bn\n    K=None;shift=None;rs=None;cs=None\n    pe=eps;pa=torch.ones((100,1),dtype=torch.bool);full=True'''\n else:\n  repl='''    av=A.numpy();bv=B.numpy();ac=(av-amean.numpy()[:,None,:])*amask.numpy()[:,:,None];bc=(bv-bmean.numpy()[:,None,:])*bmask.numpy()[:,:,None]\n    va=np.matmul(ac.transpose(0,2,1),ac)/an.numpy()[:,None,None]\n    vb=np.matmul(bc.transpose(0,2,1),bc)/bn.numpy()[:,None,None]\n    rowvar=torch.from_numpy((np.matmul(ac,vb)*ac).sum(2).astype(np.float32))\n    colvar=torch.from_numpy((np.matmul(bc,va)*bc).sum(2).astype(np.float32))\n    residualmean=(amean*bmean).sum(1)-asq.sum(1)/an-bsq.sum(1)/bn\n    K=None;shift=None;rs=None;cs=None\n    pe=eps;pa=torch.ones((100,1),dtype=torch.bool);full=True'''\n assert needle in s;s=s.replace(needle,repl)\n needle='''        if K is None or float(eps.max())<=8.:\n            ft,gt,K,shift,rs,cs=direct(f,g,eps)'''\n repl='''        if t==2:\n            ft=torch.where(amask,f+residualmean[:,None]-rowvar/(2*eps[:,None]),0.)\n            gt=torch.where(bmask,g+residualmean[:,None]-colvar/(2*eps[:,None]),0.)\n            f=torch.where(active,(f+ft)*.5,f);g=torch.where(active,(g+gt)*.5,g)\n            K=None;pe=eps;pa=active;full=False\n            continue\n        if K is None or float(eps.max())<=8.:\n            ft,gt,K,shift,rs,cs=direct(f,g,eps)'''\n assert needle in s;s=s.replace(needle,repl)\n save(f'{k}_class_covariance_{mode}',s)\n# Feature moments with cheaper first-order transform isolated from setup overhead.\ns=(root/'270_class_moment2_1/method.py').read_text()\ns=s.replace('''    qi=torch.triu_indices(10,10);fac=torch.where(qi[0]==qi[1],2.**.5,1.)\n    AP=torch.cat((torch.ones((100,nmax,1)),ac,ac[:,:,qi[0]]*ac[:,:,qi[1]]/fac),2)\n    BP=torch.cat((torch.ones((100,mmax,1)),bc,bc[:,:,qi[0]]*bc[:,:,qi[1]]/fac),2)\n    powers=torch.tensor([0.]+[1.]*10+[2.]*len(fac))''','''    AP=torch.cat((torch.ones((100,nmax,1)),ac),2)\n    BP=torch.cat((torch.ones((100,mmax,1)),bc),2)\n    powers=torch.tensor([0.]+[1.]*10)''')\nsave('297_class_moment1_1',s)\nPY\npython /tmp/research_history/build_episode6_covariance.py\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

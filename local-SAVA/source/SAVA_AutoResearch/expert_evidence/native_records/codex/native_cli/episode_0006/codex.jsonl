{"type": "item.started", "item": {"id": "item_61", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/research_history/build_episode6_group_point.py <<'PY'\nfrom pathlib import Path\nroot=Path('/tmp/research_history');base=(root/'265_mean_skip3_linear_column/method.py').read_text()\nhelper='''def _group_expectation(C,an,bn,valid):\n    K=(C*(-14.426950408889634/C.amax((1,2)))[:,None,None]).exp2_()\n    K.mul_(valid)\n    col=K.sum(1);row=K.sum(2)\n    bm=torch.arange(C.shape[2])[None,:]<bn[:,None]\n    am=torch.arange(C.shape[1])[None,:]<an[:,None]\n    K.mul_(torch.where(bm,(1./bn[:,None])/col,0.)[:,None,:])\n    K.mul_(torch.where(am,(1./an[:,None])/K.sum(2),0.)[:,:,None])\n    ratio=(2.-bn[:,None]*K.sum(1)).clamp_(min=.01)\n    K.mul_(ratio[:,None,:])\n    K.mul_(torch.where(am,(1./an[:,None])/K.sum(2),0.)[:,:,None])\n    return (K*C).sum((1,2))\n\n\ndef _group_dual(C,schedules,an,bn,valid):\n    k,nmax,mmax=C.shape\n    amask=torch.arange(nmax)[None,:]<an[:,None]\n    bmask=torch.arange(mmax)[None,:]<bn[:,None]\n    la=(1/an.float()).log()[:,None];lb=(1/bn.float()).log()[:,None]\n    f=C.sum(2)/bn[:,None];g=C.sum(1)/an[:,None]\n    f=torch.where(amask,f,0.);g=torch.where(bmask,g,0.)\n    C.masked_fill_(~valid,float('inf'))\n    def direct(f,g,eps):\n        R=(C-f[:,:,None]).sub_(g[:,None,:])\n        if float(eps.max())<=2.:\n            ft=f+R.amin(2)-eps[:,None]*lb\n            gt=g+R.amin(1)-eps[:,None]*la\n            return torch.where(amask,ft,0.),torch.where(bmask,gt,0.),None,None,None,None\n        rm=R.amin((1,2))\n        R.sub_(rm[:,None,None]).mul_((-1.4426950408889634/eps)[:,None,None]).exp2_()\n        rs=R.sum(2);cs=R.sum(1)\n        check=torch.minimum(torch.where(amask,rs,float('inf')).amin(1),torch.where(bmask,cs,float('inf')).amin(1))\n        if float((check/torch.maximum(rs.amax(1),cs.amax(1))).min())>2e-22:\n            ft=f+rm[:,None]-eps[:,None]*(rs.log()+lb)\n            gt=g+rm[:,None]-eps[:,None]*(cs.log()+la)\n            K=R\n        else:\n            v=(g[:,None,:]-C)/eps[:,None,None]\n            ft=-eps[:,None]*(v.logsumexp(2)+lb)\n            v=(f[:,:,None]-C)/eps[:,None,None]\n            gt=-eps[:,None]*(v.logsumexp(1)+la)\n            K=None\n        if bool((eps<=2.).any()):\n            small=(eps<=2.)[:,None]\n            ft=torch.where(small,(C-g[:,None,:]).amin(2)-eps[:,None]*lb,ft)\n            gt=torch.where(small,(C-f[:,:,None]).amin(1)-eps[:,None]*la,gt)\n            K=None\n        return torch.where(amask,ft,0.),torch.where(bmask,gt,0.),K,rm,rs,cs\n    steps=[z[3:-3] for z in schedules]\n    K=None;shift=None;rs=None;cs=None;pe=None\n    pa=torch.ones((k,1),dtype=torch.bool)\n    for t in range(max(map(len,steps))):\n        eps=torch.tensor([z[t] if t<len(z) else z[-1] for z in steps])\n        active=torch.tensor([t<len(z) for z in steps])[:,None]\n        if K is None or bool((eps<=2.).any()):\n            ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        else:\n            ar=torch.where(amask&pa,(rs/bn[:,None]).sqrt(),1.)\n            bc=torch.where(bmask&pa,(cs/an[:,None]).sqrt(),1.)\n            K.mul_(ar.reciprocal()[:,:,None]).mul_(bc.reciprocal()[:,None,:])\n            q=pe/eps\n            if bool(torch.all(torch.abs(q-4.)<1e-4)):K.square_().square_()\n            else:K.pow_(q[:,None,None])\n            shift=torch.where(pa[:,0],0.,shift)\n            rs=K.sum(2);cs=K.sum(1)\n            check=torch.minimum(torch.where(amask,rs,float('inf')).amin(1),torch.where(bmask,cs,float('inf')).amin(1))\n            if float((check/torch.maximum(rs.amax(1),cs.amax(1))).min())>2e-22:\n                ft=f+shift[:,None]-eps[:,None]*(rs.log()+lb)\n                gt=g+shift[:,None]-eps[:,None]*(cs.log()+la)\n                ft=torch.where(amask,ft,0.);gt=torch.where(bmask,gt,0.)\n            else:ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        f=torch.where(active,(f+ft)*.5,f);g=torch.where(active,(g+gt)*.5,g)\n        pe=eps;pa=active\n    return C.sub_(g[:,None,:]).amin(2)-.1*lb\n\n'''\nvalue='''def value(x,y,r,ry,seed=17,batch_size=1024):\n    torch.set_flush_denormal(True);torch.set_num_threads(2)\n    x=np.asarray(x,np.float32);r=np.asarray(r,np.float32)\n    y=np.asarray(y,np.int64);ry=np.asarray(ry,np.int64)\n    tx=[np.arange(i,min(i+batch_size,len(x))) for i in range(0,len(x),batch_size)]\n    tr=[np.arange(j,min(j+batch_size,len(r))) for j in range(0,len(r),batch_size)]\n    with torch.inference_mode():\n        W=_label_cost(x[tx[0]],y[tx[0]],r[tr[0]],ry[tr[0]])\n        WL=W[:10,10:].copy()/2\n        pairs=[(i,j) for i in range(len(tx)) for j in range(len(tr))]\n        F={};batchcost=np.zeros((len(tx),len(tr)))\n        for start in range(0,len(pairs),GROUP):\n            ps=pairs[start:start+GROUP];k=len(ps)\n            an=torch.tensor([len(tx[i]) for i,j in ps]);bn=torch.tensor([len(tr[j]) for i,j in ps])\n            nmax=int(an.max());mmax=int(bn.max())\n            A=torch.zeros((k,nmax,10));B=torch.zeros((k,mmax,10));LC=np.zeros((k,nmax,mmax),np.float32)\n            schedules=[]\n            for q,(i,j) in enumerate(ps):\n                a=x[tx[i]];b=r[tr[j]]\n                A[q,:len(a)]=torch.from_numpy(a);B[q,:len(b)]=torch.from_numpy(b)\n                LC[q,:len(a),:len(b)]=np.take(WL[y[tx[i]]],ry[tr[j]],axis=1)\n                z1=torch.tensor(np.column_stack([a,y[tx[i]]]),dtype=torch.float32)\n                z2=torch.tensor(np.column_stack([b,ry[tr[j]]+10]),dtype=torch.float32)\n                schedules.append(_schedule(z1,z2))\n            C=torch.bmm(A,B.transpose(1,2))\n            C.mul_(-1.).add_(A.square().sum(2)[:,:,None]/2).add_(B.square().sum(2)[:,None,:]/2).add_(torch.from_numpy(LC))\n            am=torch.arange(nmax)[None,:]<an[:,None];bm=torch.arange(mmax)[None,:]<bn[:,None]\n            valid=am[:,:,None]&bm[:,None,:]\n            C.masked_fill_(~valid,0.)\n            bc=_group_expectation(C,an,bn,valid).numpy()\n            f=_group_dual(C,schedules,an,bn,valid).numpy()\n            f
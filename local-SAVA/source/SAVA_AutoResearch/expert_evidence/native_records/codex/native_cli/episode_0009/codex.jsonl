nPY\"", "aggregated_output": "{\"source\": \"564_episode9_coupling_lowrank_cost_energy_label_fields\", \"cases\": 18, \"valid\": true, \"worst_nrmse\": 0.008513112284773203, \"min_rho\": 0.999954046217116, \"min_top\": 0.9946666666666667}\n", "exit_code": 0, "status": "completed"}}

None,:])\n            if abs(pe/eps-4.)<1e-5:\n                K.square_().square_()\n            else:K.pow_(pe/eps)\n            shift=-old_shift if full else 0.\n            rs=K.sum(1);cs=K.sum(0)\n            if min(float(rs.min()/rs.max()),float(cs.min()/cs.max()))>2e-22:\n                ft=f+shift-eps*(rs.log()+lb);gt=g+shift-eps*(cs.log()+la)\n            else:ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        f=(f+ft)*.5;g=(g+gt)*.5;pe=eps;full=False\n    return C.sub_(g[None,:]).amin(1)-.1*lb,None\n\n\ndef _label_cost(x,y,r,ry):\n    # Sorted supports let segmented reductions solve all 100 empirical pairs.\n    ix=np.argsort(y,kind='stable');ir=np.argsort(ry,kind='stable')\n    A=x[ix];B=r[ir];ay=y[ix];by=ry[ir]\n    an=np.bincount(ay,minlength=10);bn=np.bincount(by,minlength=10)\n    ap=np.concatenate(([0],np.cumsum(an)[:-1]));bp=np.concatenate(([0],np.cumsum(bn)[:-1]))\n    amin=np.minimum.reduceat(A,ap,axis=0);amax=np.maximum.reduceat(A,ap,axis=0)\n    bmin=np.minimum.reduceat(B,bp,axis=0);bmax=np.maximum.reduceat(B,bp,axis=0)\n    diam=np.sqrt(((np.maximum(amax[:,None,:],bmax[None,:,:])-np.minimum(amin[:,None,:],bmin[None,:,:]))**2).sum(2))\n    schedules=[[float(d*d)]+[float(np.exp(e)) for e in np.arange(2*np.log(float(d)),np.log(.1),2*np.log(.5))]+[.1] for d in diam.ravel()]\n    la=np.log(1/an.astype(np.float32));lb=np.log(1/bn.astype(np.float32))\n    C=((A*A).sum(1)[:,None]-2*(A @ B.T)+(B*B).sum(1)[None,:])/2\n    f=np.add.reduceat(C,bp,axis=1)/bn\n    g=np.add.reduceat(C,ap,axis=0)/an[:,None]\n    f=f.astype(np.float32);g=g.astype(np.float32)\n    K=None;previous=None\n    def expand(v):return v[ay[:,None],by[None,:]]\n    def residual(f,g):return C-f[:,by]-g[ay,:]\n    def direct(f,g,eps):\n        R=residual(f,g)\n        if eps.max()<=8.:\n            ft=f+np.minimum.reduceat(R,bp,axis=1)-eps[ay]*lb\n            gt=g+np.minimum.reduceat(R,ap,axis=0)-eps[:,by]*la[:,None]\n            return ft,gt,None,None,None,None\n        rm=np.minimum.reduceat(n
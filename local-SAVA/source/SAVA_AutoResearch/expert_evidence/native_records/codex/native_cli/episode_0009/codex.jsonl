{"type": "item.started", "item": {"id": "item_62", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/research_history/episode9_stress.py <<'PY'\nimport importlib.util,json,time,sys\nfrom pathlib import Path\nimport numpy as np\nfrom scipy.stats import spearmanr\nroot=Path('/tmp/research_history');names=sys.argv[1:];mods=[]\nfor k,name in enumerate(['000_baseline']+names):\n spec=importlib.util.spec_from_file_location('episode9stress'+str(k),root/name/'method.py')\n m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m);mods.append(m)\nrecords=[]\nfor seed in [101,505]:\n for corruption in ['uniform_labels','gaussian_016','mixed']:\n  p=Path('/workspace/environment/public_assets/dev')/f'seed_{seed}_{corruption}.npz';z=np.load(p)\n  for trial in [1,2,3]:\n   rng_seed=20000+100*seed+trial;rng=np.random.default_rng(rng_seed)\n   ix=rng.permutation(len(z['x']));ir=rng.permutation(len(z['r']))\n   args=z['x'][ix],z['y'][ix],z['r'][ir],z['ry'][ir],int(z['seed'])\n   target=mods[0].value(*args);quarter=len(target)//4;b=np.argsort(-target,kind='stable')[:quarter]\n   for name,m in zip(names,mods[1:]):\n    start=time.perf_counter();out=np.asarray(m.value(*args));seconds=time.perf_counter()-start\n    nr=float(np.sqrt(np.mean((out-target)**2))/target.std());rho=float(spearmanr(out,target).statistic)\n    a=np.argsort(-out,kind='stable')[:quarter];top=len(set(a)&set(b))/quarter\n    rec={'source':name,'public_source':p.stem,'shuffle_seed':rng_seed,'seconds':seconds,'nrmse':nr,'rho':rho,'top':top,'valid':bool(out.shape==target.shape and np.isfinite(out).all() and nr<=.01 and rho>=.999 and top>=.98)}\n    records.append(rec);print(json.dumps(rec),flush=True)\nsummary=[]\nfor name in names:\n rr=[r for r in records if r['source']==name]\n s={'source':name,'cases':len(rr),'valid':all(r['valid'] for r in rr),'failures':sum(not r['valid'] for r in rr),'worst_nrmse':max(r['nrmse'] for r in rr),'min_rho':min(r['rho'] for r in rr),'min_top':min(r['top'] for r in rr)}\n summary.append(s);print('SUMMARY',json.dumps(s),flush=True)\n(root/'episode9_shuffle_stress.json').write_text(json.dumps({'explanation':'Diagnostic synthetic permutations of public arrays. Targets computed using saved initial canonical source; no protected targets. Not a score.','summary':summary,'records':records},indent=2))\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

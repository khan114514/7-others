 _outer')\nimpl='''def _expectation(C):\n    n,m=C.shape\n    K=(C*(-14.426950408889634/float(C.max()))).exp2_()\n    v=(1./m)/K.sum(0)\n    u=(1./n)/(K*v[None,:]).sum(1)\n    col=v*(K.T @ u[:,None])[:,0]\n    w=v*(2.-m*col).clamp_(min=.01)\n    K.mul_(w[None,:])\n    rowmass=K.sum(1)\n    energy=K.mul_(C).sum(1)\n    return float((energy/rowmass).mean())\n\n\n'''\nsave(558,'shared_coupling_cancel_hybrid_gemm',s[:a]+impl+s[b:],'Isolate only column weighted reduction as GEMM; row weighted reductions stay parallel Torch sums, first row scaling cancels exactly.')\n(root/'episode9_round11_manifest.json').write_text(json.dumps(entries,indent=2));print(json.dumps(entries,indent=2))\nPY\npython /tmp/research_history/episode9_build_round11.py\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

(r)\n        xn=(X*X).sum(1)/2;rn=(R*R).sum(1)/2\n        F={}; batchcost=np.zeros((len(tx),len(tr)))\n        for i,idx in enumerate(tx):\n            for j,jdx in enumerate(tr):\n                a=x[idx]; b=r[jdx]\n                aa=X[i*batch_size:i*batch_size+len(idx)];bb=R[j*batch_size:j*batch_size+len(jdx)]\n                T=aa @ bb.T\n                T.mul_(-1.).add_(xn[i*batch_size:i*batch_size+len(idx),None]).add_(rn[None,j*batch_size:j*batch_size+len(jdx)])\n                T.add_(torch.from_numpy(np.take(WL[y[idx]],ry[jdx],axis=1)))\n                batchcost[i,j]=_expectation(T)/(len(idx)+len(jdx))\n                z1=torch.tensor(np.column_stack([a,y[idx]]),dtype=torch.float32)\n                z2=torch.tensor(np.column_stack([b,ry[jdx]+10]),dtype=torch.float32)\n                # Reuse the same empirical geometry for coupling and point potentials.\n                f,_=_dual(T,_schedule(z1,z2))\n                f=f.numpy().ravel().astype(float)\n                F[i,j]=(f-f.mean())*len(f)/(len(f)-1)\n    Q=_outer(batchcost)\n    values=np.zeros(len(x))\n    for i,idx in enumerate(tx): values[idx]=sum(Q[i,j]*F[i,j] for j in range(len(tr)))\n    return values\n\"\"\"Hierarchical transport with reusable costs and explicit annealed dual solves.\"\"\"\nimport numpy as np\nimport torch\nimport ot\n\n\ndef _schedule(a, b):\n    lo = torch.minimum(a.amin(0), b.amin(0))\n    hi = torch.maximum(a.amax(0), b.amax(0))\n    diameter = float(torch.linalg.vector_norm(hi - lo))\n    return [diameter**2] + [float(np.exp(e)) for e in np.arange(2*np.log(diameter), np.log(.1), 2*np.log(.5))] + [.1]\n\n\ndef _dual(C, schedule, initial):\n    n,m=C.shape\n    la=float(np.log(np.float32(1./n)));lb=float(np.log(np.float32(1./m)))\n    shift=0.\n    def direct(f,g,eps):\n        R=C-f[:,None];R-=g[None,:]\n        if eps<=2.:\n            return f+R.amin(1)-eps*lb,g+R.amin(0)-eps*la,None,0.,None,None\n        rm=float(R.min());R-=rm;R.mul_(-1.4426950408889634/eps).exp2_()\n        rs=R.sum(1);cs=R.sum(0)\n        if min(float(rs.min()),float(cs.min()))<=2e-22:\n            R=C-f[:,None];R-=g[None,:];R*=(-1./eps)\n            rowmax=R.amax(1);colmax=R.amax(0)\n            rr=torch.exp(R-rowmax[:,None]).sum(1);cc=torch.exp(R-colmax[None,:]).sum(0)\n            return f-eps*(rowmax+rr.log()+lb),g-eps*(colmax+cc.log()+la),None,0.,None,None\n        return f+rm-eps*(rs.log()+lb),g+rm-eps*(cs.log()+la),R,rm,rs,cs\n    f,g=initial\n    \n    K=None;rs=None;cs=None\n    pe=schedule[0]\n    point_steps=schedule[3:-3]\n    for step,eps in enumerate(point_steps):\n        last=step==len(point_steps)-1\n        if last and (K is None or eps<=2.):\n            if eps<=2.:g=(g+(C-f[:,None]).amin(0)-eps*la)*.5\n            else:g=(g-eps*(((f[:,None]-C)/eps).logsumexp(0)+la))*.5\n            break\n        if K is None or eps<=2.:\n            ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        else:\n            if last:\n                q=pe/eps\n                logfactor=.5*q*(float(np.log(n))-cs.log())\n                K.mul_((m/rs).sqrt()[:,None])\n                if abs(q-4.)<1e-5:K.square_().square_()\n                else:K.pow_(q)\n                sums=K.sum(0)\n                if float(sums.min())>0.:\n                    logmass=sums.log()+logfactor\n                    g.add_(logmass+la,alpha=-.5*eps)\n                else:g=(g-eps*(((f[:,None]-C)/eps).logsumexp(0)+la))*.5\n                break\n            K.mul_((m/rs).sqrt()[:,None]).mul_((n/cs).sqrt()[None,:])\n            if abs(pe/eps-4.)<1e-5:\n                K.square_().square_()\n            else:K.pow_(pe/eps)\n            shift=0.\n            if last:\n                cs=K.sum(0)\n                if float(cs.min())>1e-34:g=(g+g+shift-eps*(cs.log()+la))*.5\n                else:g=(g-eps*(((f[:,None]-C)/eps).logsumexp(0)+la))*.5\n                break\n            rs=K.sum(1);cs=K.sum(0)\n            if min(float(rs.min()),float(cs.min()))>1e-34:\n                ft=f+shift-eps*(rs.log()+lb);gt=g+shift-eps*(cs.log()+la)\n            else:ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        f=(f+ft)*.5;g=(g+gt)*.5;pe=eps\n    return C.sub_(g[None,:]).amin(1)-.1*lb,None\n\n\ndef _label_cost(x, y, r, ry):\n    aa = [torch.from_numpy(x[y == i]) for i in range(10)]\n    bb = [torch.from_numpy(r[ry == j]) for j in range(10)]\n    pairs = [(a, b) for a in aa for b in bb]\n    nmax = max(len(a) for a in aa)\n    mmax = max(len(b) for b in bb)\n    A = torch.zeros((100, nmax, x.shape[1]))\n    B = torch.zeros((100, mmax, r.shape[1]))\n    an = torch.tensor([len(a) for a, b in pairs])\n    bn = torch.tensor([len(b) for a, b in pairs])\n    al=torch.stack([a.amin(0) for a in aa]);ah=torch.stack([a.amax(0) for a in aa])\n    bl=torch.stack([b.amin(0) for b in bb]);bh=torch.stack([b.amax(0) for b in bb])\n    diam=torch.linalg.vector_norm(torch.maximum(ah[:,None,:],bh[None,:,:])-torch.minimum(al[:,None,:],bl[None,:,:]),dim=2).flatten().tolist()\n    schedules=[[d*d]+[float(np.exp(e)) for e in np.arange(2*np.log(d),np.log(.1),2*np.log(.5))]+[.1] for d in diam]\n    for i,a in enumerate(aa):A[i*10:(i+1)*10,:len(a)]=a\n    for j,b in enumerate(bb):B[j::10,:len(b)]=b\n    C = ((A*A).sum(2)[:,:,None] - 2*torch.bmm(A,B.transpose(1,2)) + (B*B).sum(2)[:,None,:])/2\n    amask = torch.arange(nmax)[None,:] < an[:,None]\n    bmask = torch.arange(mmax)[None,:] < bn[:,None]\n    C.masked_fill_(~(amask[:,:,None] & bmask[:,None,:]), float('inf'))\n    la=(1/an.float()).log()[:,None];lb=(1/bn.float()).log()[:,None]\n    def direct(f,g,eps):\n        R=(C-f[:,:,None]).sub_(g[:,None,:])\n        if float(eps.max())<=256.:\n            ft=f+R.amin(2)-eps[:,None]*lb\n            gt=g+R.amin(1)-eps[:,None]*la\n            return torch.where(amask,ft,0.),torch.where(bmask,gt,0.),None,None,None,None\n        rm=R.amin((1,2))\n        K=R.sub_(rm[:,None,None]).mul_((-1.4426950408889634/eps)[:,None,None]).exp2_()\n        rs=K.sum(2);cs=K.sum(1)\n        check=torch.minimum(torch.where(amask,rs,float('inf')).amin(1),torch.where(bmask,cs,float('inf')).amin(1))\n        if float(check.min())>1e-34:\n            ft=f+rm[:,None]-eps[:,None]*(rs.log()+lb)\n            gt=g+rm[:,None]-eps[:,None]*(cs.log()+la)\n            return torch.where(amask,ft,0.),torch.where(bmask,gt,0.),K,rm,rs,cs\n        v=(g[:,None,:]-C)/eps[:,None,None]\n        ft=-eps[:,None]*(v.logsumexp(2)+lb)\n        v=(f[:,:,None]-C)/eps[:,None,None]\n        gt=-eps[:,None]*(v.logsumexp(1)+la)\n        return torch.where(amask,ft,0.),torch.where(bmask,gt,0.),None,None,None,None\n    amean=A.sum(1)/an[:,None];bmean=B.sum(1)/bn[:,None]\n    asq=A.square().sum(2)/2;bsq=B.square().sum(2)/2\n    f=torch.where(amask,asq+bsq.sum(1)[:,None]/bn[:,None]-(A*bmean[:,None,:]).sum(2),0.)\n    g=torch.where(bmask,bsq+asq.sum(1)[:,None]/an[:,None]-(B*amean[:,None,:]).sum(2),0.)\n    mu=(f.sum(1)/an)[:,None]\n    K=None;shift=None;rs=None;cs=None\n    pe=None;pa=torch.ones((100,1),dtype=torch.bool)\n    for t in range(2,max(map(len,schedules))-3):\n        eps=torch.tensor([z[t] if t<len(z) else .1 for z in schedules])\n        active=torch.tensor([t<len(z) for z in schedules])[:,None]\n        if t==2:\n            ft=torch.where(amask,f-mu,0.)\n            gt=torch.where(bmask,g-mu,0.)\n        elif K is None or float(eps.max())<=256.:\n            ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        else:\n            ar=torch.where(amask & pa,(rs/bn[:,None]).sqrt(),1.)\n            bc=torch.where(bmask & pa,(cs/an[:,None]).sqrt(),1.)\n            K.mul_(ar.reciprocal()[:,:,None]).mul_(bc.reciprocal()[:,None,:])\n            q=pe/eps\n            if bool(torch.all(torch.abs(q-4.)<1e-4)):K.square_().square_()\n            else:K.pow_(q[:,None,None])\n            shift=torch.where(pa[:,0],0.,shift)\n            rs=K.sum(2);cs=K.sum(1)\n            check=torch.minimum(torch.where(amask,rs,float('inf')).amin(1),torch.where(bmask,cs,float('inf')).amin(1))\n            if float(check.min())>1e-34:\n                ft=f+shift[:,None]-eps[:,None]*(rs.log()+lb)\n                gt=g+shift[:,None]-eps[:,None]*(cs.log()+la)\n                ft=torch.where(amask,ft,0.);gt=torch.where(bmask,gt,0.)\n            else:ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        df=torch.where(active,ft-f,0.)\n        dg=torch.where(active,gt-g,0.)\n        f.add_(df,alpha=.5)\n        g.add_(dg,alpha=.5)\n        pe=eps;pa=active\n    g.add_(dg,alpha=0.25)\n    C.sub_(f[:,:,None]).sub_(g[:,None,:])\n    ft=torch.where(amask,f+C.amin(2)-.1*lb,0.)\n    gt=torch.where(bmask,g+C.amin(1)-.1*la,0.)\n    costs=(ft/an[:,None]).sum(1)+(gt/bn[:,None]).sum(1)\n    W=np.zeros((20,20),np.float32)\n    W[:10,10:]=costs.numpy().reshape(10,10);W[10:,:10]=W[:10,10:].T\n    return W\n\n\ndef _expectation(C):\n    n,m=C.shape\n    K=(C*(-14.426950408889634/float(C.max()))).exp2_()\n    K.mul_(((1./m)/K.sum(0))[None,:])\n    K.mul_(((1./n)/K.sum(1))[:,None])\n    ratio=(2.-m*K.sum(0)).clamp_(min=.01)\n    K.mul_(ratio[None,:])\n    rowmass=K.sum(1)\n    energy=K.mul_(C).sum(1)\n    return float((energy/rowmass).mean())\n\n\ndef _outer(batchcost):\n    n,m=batchcost.shape\n    cost=batchcost/max(float(batchcost.max()),1e-12)\n    if m!=2:\n        return ot.sinkhorn(ot.unif(n),ot.unif(m),cost,.01,numItermax=10000,stopThr=1e-10)\n    d=(cost[:,1]-cost[:,0])/.01\n    lo=-float(d.max())-40.;hi=-float(d.min())+40.\n    z=-float(d.mean())\n    for it in range(50):\n        s=1./(1.+np.exp(-np.clip(d+z,-700.,700.)))\n        err=float(s.mean())-.5\n        if abs(err)<1e-13:break\n        if err>0.:hi=z\n        else:lo=z\n        deriv=float((s*(1.-s)).mean())\n        next_z=z-err/max(deriv,1e-30)\n        z=next_z if lo<next_z<hi else (lo+hi)/2.\n    return np.column_stack((s,1.-s))/n\n\n\ndef value(x, y, r, ry, seed=17, batch_size=1024):\n    torch.set_flush_denormal(True)\n    torch.set_num_threads(2)\n    x=np.asarray(x,np.float32); r=np.asarray(r,np.float32)\n    y=np.asarray(y,np.int64); ry=np.asarray(ry,np.int64)\n    tx=[np.arange(i,min(i+batch_size,len(x))) for i in range(0,len(x),batch_size)]\n    tr=[np.arange(i,min(i+batch_size,len(r))) for i in range(0,len(r),batch_size)]\n    with torch.inference_mode():\n        W=_label_cost(x[tx[0]],y[tx[0]],r[tr[0]],ry[tr[0]])\n        WL=W[:10,10:].copy()/2\n        X=torch.from_numpy(x);R=torch.from_numpy(r)\n        xn=(X*X).sum(1)/2;rn=(R*R).sum(1)/2\n        am=torch.stack([X[idx].mean(0) for idx in tx]);bm=torch.stack([R[idx].mean(0) for idx in tr])\n        amn=torch.stack([xn[idx].mean() for idx in tx]);bmn=torch.stack([rn[idx].mean() for idx in tr])\n        aw=np.stack([np.bincount(y[idx],minlength=10)/len(idx) for idx in tx]).astype(np.float32)\n        bw=np.stack([np.bincount(ry[idx],minlength=10)/len(idx) for idx in tr]).astype(np.float32)\n        fm=xn[:,None]+bmn[None,:]-X @ bm.T+torch.from_numpy((WL @ bw.T)[y])\n        gm=rn[:,None]+amn[None,:]-R @ am.T+torch.from_numpy((aw @ WL).T[ry])\n        F={}; batchcost=np.zeros((len(tx),len(tr)))\n        for i,idx in enumerate(tx):\n            for j,jdx in enumerate(tr):\n                a=x[idx]; b=r[jdx]\n                aa=X[i*batch_size:i*batch_size+len(idx)];bb=R[j*batch_size:j*batch_size+len(jdx)]\n                T=aa @ bb.T\n                T.mul_(-1.).add_(xn[i*batch_size:i*batch_size+len(idx),None]).add_(rn[None,j*batch_size:j*batch_size+len(jdx)])\n                T.add_(torch.from_numpy(np.take(WL[y[idx]],ry[jdx],axis=1)))\n                batchcost[i,j]=_expectation(T)/(len(idx)+len(jdx))\n                # Reuse the same empirical geometry for coupling and point potentials.\n                lo=np.minimum(a.min(0),b.min(0));hi=np.maximum(a.max(0),b.max(0))\n                yl=int(y[idx].min());yh=int(y[idx].max());rl=int(ry[jdx].min())+10;rh=int(ry[jdx].max())+10\n                d2=float(np.sum((hi-lo)**2)) + float((max(yh,rh)-min(yl,rl))**2)\n                diameter=np.sqrt(d2)\n                schedule=[diameter**2]+[float(np.exp(e)) for e in np.arange(2*np.log(diameter),np.log(.1),2*np.log(.5))]+[.1]\n                f,_=_dual(T,schedule,(fm[idx,j],gm[jdx,i]))\n                f=f.numpy().ravel().astype(float)\n                F[i,j]=(f-f.mean())*len(f)/(len(f)-1)\n    Q=_outer(batchcost)\n    values=np.zeros(len(x))\n    for i,idx in enumerate(tx): values[idx]=sum(Q[i,j]*F[i,j] for j in range(len(tr)))\n    return values\n", "exit_code": 0, "status": "completed"}}
{"type": "item.started", "item": {"id": "item_19", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/research_history/episode9_build_round1.py <<'PY'\nfrom pathlib import Path\nimport json,hashlib\nroot=Path('/tmp/research_history')\nbase=(root/'432_episode7_schedule_bounds/method.py').read_text()\nentries=[]\ndef save(num,name,source,hypothesis):\n d=root/(str(num)+'_episode9_'+name);d.mkdir(exist_ok=True);(d/'method.py').write_text(source)\n entries.append({'name':d.name,'sha256':hashlib.sha256(source.encode()).hexdigest(),'hypothesis':hypothesis})\nseg='''def _label_cost(x,y,r,ry):\n    ix=np.argsort(y,kind='stable');ir=np.argsort(ry,kind='stable')\n    A=torch.from_numpy(x[ix]);B=torch.from_numpy(r[ir])\n    ay=torch.from_numpy(y[ix]);by=torch.from_numpy(ry[ir])\n    an=torch.bincount(ay,minlength=10);bn=torch.bincount(by,minlength=10)\n    aa=[A[ay==i] for i in range(10)];bb=[B[by==j] for j in range(10)]\n    al=torch.stack([a.amin(0) for a in aa]);ah=torch.stack([a.amax(0) for a in aa])\n    bl=torch.stack([b.amin(0) for b in bb]);bh=torch.stack([b.amax(0) for b in bb])\n    diam=torch.linalg.vector_norm(torch.maximum(ah[:,None,:],bh[None,:,:])-torch.minimum(al[:,None,:],bl[None,:,:]),dim=2).flatten().tolist()\n    schedules=[[d*d]+[float(np.exp(e)) for e in np.arange(2*np.log(d),np.log(.1),2*np.log(.5))]+[.1] for d in diam]\n    C=((A*A).sum(1)[:,None]-2*(A @ B.T)+(B*B).sum(1)[None,:])/2\n    anr=an.repeat(len(B));bnr=bn.repeat(len(A))\n    def rowreduce(R,op):\n        return torch.segment_reduce(R.reshape(-1),op,lengths=bnr,unsafe=True).reshape(len(A),10)\n    def colreduce(R,op):\n        return torch.segment_reduce(R.T.contiguous().reshape(-1),op,lengths=anr,unsafe=True).reshape(len(B),10).T\n    def expand(v):return v.index_select(0,ay).index_select(1,by)\n    def residual(f,g):return C-f.index_select(1,by)-g.index_select(0,ay)\n    la=(1/an.float()).log()[:,None];lb=(1/bn.float()).log()[None,:]\n    amean=torch.stack([a.mean(0) for a in aa]);bmean=torch.stack([b.mean(0) for b in bb])\n    asq=(A*A).sum(1)/2;bsq=(B*B).sum(1)/2\n    amn=torch.stack([asq[ay==i].mean() for i in range(10)]);bmn=torch.stack([bsq[by==j].mean() for j in range(10)])\n    f=asq[:,None]+bmn[None,:]-A @ bmean.T\n    g=bsq[None,:]+amn[:,None]-amean @ B.T\n    def direct(f,g,eps):\n        R=residual(f,g)\n        if float(eps.max())<=256.:\n            ft=f+rowreduce(R,'min')-eps.index_select(0,ay)*lb\n            gt=g+colreduce(R,'min')-eps.index_select(1,by)*la\n            return ft,gt,None,None,None,None\n        rm=torch.segment_reduce(rowreduce(R,'min').T.contiguous(), 'min',lengths=an.expand(10,-1),axis=1,unsafe=True).T\n        K=R.sub_(expand(rm)).mul_(expand(-1.4426950408889634/eps)).exp2_()\n        rs=rowreduce(K,'sum');cs=colreduce(K,'sum')\n        if min(float(rs.min()),float(cs.min()))>1e-34:\n            ft=f+rm.index_select(0,ay)-eps.index_select(0,ay)*(rs.log()+lb)\n            gt=g+rm.index_select(1,by)-eps.index_select(1,by)*(cs.log()+la)\n            return ft,gt,K,rm,rs,cs\n        v=-residual(f,g)/expand(eps)\n        mxr=rowreduce(v,'max');mxc=colreduce(v,'max')\n        rr=rowreduce((v-mxr.index_select(1,by)).exp(),'sum')\n        cc=colreduce((v-mxc.index_select(0,ay)).exp(),'sum')\n        return f-eps.index_select(0,ay)*(mxr+rr.log()+lb),g-eps.index_select(1,by)*(mxc+cc.log()+la),None,None,None,None\n    K=None;shift=None;rs=None;cs=None;pe=None;pa=torch.ones((10,10),dtype=torch.bool)\n    for t in range(2,max(map(len,schedules))-3):\n        eps=torch.tensor([z[t] if t<len(z) else .1 for z in schedules]).reshape(10,10)\n        active=torch.tensor([t<len(z) for z in schedules]).reshape(10,10)\n        if K is None or float(eps.max())<=256.:\n            ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        else:\n            ar=torch.where(pa.index_select(0,ay),(rs/bn).sqrt(),1.).reciprocal()\n            bc=torch.where(pa.index_select(1,by),(cs/an[:,None]).sqrt(),1.).reciprocal()\n            K.mul_(ar.index_select(1,by)).mul_(bc.index_select(0,ay))\n            q=pe/eps\n            if bool(torch.all(torch.abs(q-4.)<1e-4)):K.square_().square_()\n            else:K.pow_(expand(q))\n            shift=torch.where(pa,0.,shift)\n            rs=rowreduce(K,'sum');cs=colreduce(K,'sum')\n            if min(float(rs.min()),float(cs.min()))>1e-34:\n                ft=f+shift.index_select(0,ay)-eps.index_select(0,ay)*(rs.log()+lb)\n                gt=g+shift.index_select(1,by)-eps.index_select(1,by)*(cs.log()+la)\n            else:ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        df=torch.where(active.index_select(0,ay),ft-f,0.)\n        dg=torch.where(active.index_select(1,by),gt-g,0.)\n        f.add_(df,alpha=.5);g.add_(dg,alpha=.5)\n        pe=eps;pa=active\n    g.add_(dg,alpha=.25)\n    R=residual(f,g)\n    ft=f+rowreduce(R,'min')-.1*lb\n    gt=g+colreduce(R,'min')-.1*la\n    costs=torch.segment_reduce(ft.T.contiguous(),'sum',lengths=an.expand(10,-1),axis=1,unsafe=True).T/an[:,None]\n    costs+=torch.segment_reduce(gt,'sum',lengths=bn.expand(10,-1),axis=1,unsafe=True)/bn\n    W=np.zeros((20,20),np.float32)\n    W[:10,10:]=costs.numpy();W[10:,:10]=W[:10,10:].T\n    return W\n\n\n'''\nsave(498,'torch_segment_class',base[:base.index('def _label_cost')]+seg+base[base.index('def _expectation'):],'Unpadded full empirical Torch segment reductions; same class finite schedule.')\n# Separate global scatter reductions as a controlled kernel ablation.\nscatter=seg.replace(\\\"return torch.segment_reduce(R.reshape(-1),op,lengths=bnr,unsafe=True).reshape(len(A),10)\\\",\\\"return torch.zeros((len(A),10)).scatter_reduce_(1,by.expand(len(A),-1),R,reduce={'min':'amin','max':'amax','sum':'sum'}[op],include_self=False)\\\").replace(\\\"return torch.segment_reduce(R.T.contiguous().reshape(-1),op,lengths=anr,unsafe=True).reshape(len(B),10).T\\\",\\\"return torch.zeros((10,len(B))).scatter_reduce_(0,ay[:,None].expand(-1,len(B)),R,reduce={'min':'amin','max':'amax','sum':'sum'}[op],include_self=False)\\\")\nsave(499,'torch_scatter_class',base[:base.index('def _label_cost')]+scatter+base[base.index('def _expectation'):],'Full unpadded class matrix with scatter reductions; isolate segmentation kernel.')\n# Skip the final class half row update while doing its exact column update.\nfor num,mode in [(500,'gonly'),(501,'fonly'),(502,'bothfinalonly')]:\n source=base\n old='''        if K is None or float(eps.max())<=256.:\n            ft,gt,K,shift,rs,cs=direct(f,g,eps)'''\n if mode=='gonly':new='''        if t==max(map(len,schedules))-4:\n            gt=(C-f[:,:,None]).amin(1)-eps[:,None]*la\n            dg=torch.where(active,gt-g,0.)\n            g.add_(dg,alpha=.5)\n            break\n        if K is None or float(eps.max())<=256.:\n            ft,gt,K,shift,rs,cs=direct(f,g,eps)'''\n elif mode=='fonly':new='''        if t==max(map(len,schedules))-4:\n            ft=(C-g[:,None,:]).amin(2)-eps[:,None]*lb\n            df=torch.where(active,ft-f,0.)\n            f.add_(df,alpha=.5)\n            dg=torch.zeros_like(g)\n            break\n        if K is None or float(eps.max())<=256.:\n            ft,gt,K,shift,rs,cs=direct(f,g,eps)'''\n else:new='''        if t==max(map(len,schedules))-4:\n            ft=(C-g[:,None,:]).amin(2)-eps[:,None]*lb\n            gt=(C-f[:,:,None]).amin(1)-eps[:,None]*la\n            df=torch.where(active,ft-f,0.);dg=torch.where(active,gt-g,0.)\n            f.add_(df,alpha=.5);g.add_(dg,alpha=.5)\n            break\n        if K is None or float(eps.max())<=256.:\n            ft,gt,K,shift,rs,cs=direct(f,g,eps)'''\n assert old in source\n source=source.replace(old,new)\n save(num,'class_last_'+mode,source,'Controlled last retained hard class stage: '+mode+'; preserved final dense transforms.')\n(root/'episode9_round1_manifest.json').write_text(json.dumps(entries,indent=2))\nprint(json.dumps(entries,indent=2))\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

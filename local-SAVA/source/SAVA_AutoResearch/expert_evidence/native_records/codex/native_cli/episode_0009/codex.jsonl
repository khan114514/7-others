{"type": "item.started", "item": {"id": "item_122", "type": "command_execution", "command": "/bin/sh -lc \"python - <<'PY'\nfrom pathlib import Path\nimport importlib.util,json,time\nimport numpy as np\nfrom scipy.stats import spearmanr\nroot=Path('/tmp/research_history');mods=[]\nfor i,name in enumerate(['000_baseline','564_episode9_coupling_lowrank_cost_energy_label_fields']):\n s=importlib.util.spec_from_file_location('ep9laststress'+str(i),root/name/'method.py');m=importlib.util.module_from_spec(s);s.loader.exec_module(m);mods.append(m)\nrecords=[]\nfor seed in [101,505]:\n for setting in ['uniform_labels','gaussian_016','mixed']:\n  z=np.load('/workspace/environment/public_assets/dev/seed_'+str(seed)+'_'+setting+'.npz')\n  for trial in [1,2,3]:\n   k=20000+100*seed+trial;rng=np.random.default_rng(k);ix=rng.permutation(len(z['x']));ir=rng.permutation(len(z['r']))\n   args=z['x'][ix],z['y'][ix],z['r'][ir],z['ry'][ir],int(z['seed']);target=mods[0].value(*args);out=mods[1].value(*args)\n   nr=float(np.sqrt(np.mean((target-out)**2))/target.std());rho=float(spearmanr(target,out).statistic);q=len(target)//4\n   top=len(set(np.argsort(-target,kind='stable')[:q])&set(np.argsort(-out,kind='stable')[:q]))/q\n   records.append({'source':'564_episode9_coupling_lowrank_cost_energy_label_fields','public_source':f'seed_{seed}_{setting}','shuffle_seed':k,'nrmse':nr,'rho':rho,'top':top,'valid':bool(nr<=.01 and rho>=.999 and top>=.98 and np.isfinite(out).all())})\nsummary={'source':'564_episode9_coupling_lowrank_cost_energy_label_fields','cases':len(records),'valid':all(r['valid'] for r in records),'worst_nrmse':max(r['nrmse'] for r in records),'min_rho':min(r['rho'] for r in records),'min_top':min(r['top'] for r in records)}\n(root/'episode9_energy_shuffle_stress.json').write_text(json.dumps({'explanation':'Public input permutation diagnostics against freshly computed canonical source000; not a score.','summary':summary,'records':records},indent=2));print(json.dumps(summary))\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

{"type": "item.completed", "item": {"id": "item_72", "type": "command_execution", "command": "/bin/sh -lc 'cat /tmp/research_history/finalize_episode7.py /tmp/research_history/episode_8_final_selection.json'", "aggregated_output": "from pathlib import Path\nfrom collections import defaultdict\nimport hashlib\nimport json\nimport math\nimport shutil\n\nroot = Path('/tmp/research_history')\nrecords = defaultdict(list)\nfor p in sorted(root.glob('episode7_*.log')):\n    for line in p.read_text().splitlines():\n        a = line.split()\n        if len(a) != 12 or a[2] != 'time' or a[4] != 'nrmse':\n            continue\n        metrics = [float(a[i]) for i in [3, 5, 7, 9]]\n        metrics = [v if math.isfinite(v) else None for v in metrics]\n        records[a[1]].append(dict(case_id=a[0], seconds=metrics[0], nrmse=metrics[1],\n                                 spearman=metrics[2], top=metrics[3], valid=a[11] == 'True',\n                                 log=p.name))\n\nindex = {}\nofficial = []\nfor p in sorted(root.glob('*/method.py')):\n    name = p.parent.name\n    if '_episode7_' not in name and not name.startswith('episode7_'):\n        continue\n    data = p.read_bytes()\n    entry = dict(method_sha256=hashlib.sha256(data).hexdigest(), source_bytes=len(data),\n                 local_records=records[name])\n    cases = {q['case_id']: q for q in records[name]}\n    if cases:\n        q = list(cases.values())\n        finite = [r['nrmse'] for r in q if r['nrmse'] is not None]\n        entry['local_summary'] = dict(count=len(q), valid=sum(r['valid'] for r in q),\n                                      worst_nrmse=max(finite) if len(finite) == len(q) else None,\n                                      nonfinite_nrmse_cases=len(q)-len(finite))\n    report = p.parent / 'result.json'\n    if report.exists():\n        d = json.loads(report.read_text())\n        assert d['method_sha256'] == entry['method_sha256']\n        q = [q for case in d['cases'] for q in case['quality']]\n        entry['official'] = dict(raw_metric=d['raw_metric'], score=d['score'],\n                                 quality_valid=d['quality_valid'], method_sha256=d['method_sha256'],\n                                 cases=len(d['cases']), quality_records=len(q),\n                                 worst_nrmse=max(r['normalized_rmse'] for r in q),\n                                 min_spearman=min(r['spearman'] for r in q),\n                                 min_top=min(r['top_quartile_overlap'] for r in q))\n        official.append(dict(variant=name, **entry['official']))\n    index[name] = entry\n\nvalid = [d for d in official if d['quality_valid'] and d['cases'] == 30]\nbest = min(valid, key=lambda d: d['raw_metric'])\nassert best['variant'] == '432_episode7_schedule_bounds'\nshutil.copyfile(root / best['variant'] / 'method.py', '/workspace/solution/method.py')\nassert hashlib.sha256(Path('/workspace/solution/method.py').read_bytes()).hexdigest() == best['method_sha256']\nassert hashlib.sha256(Path('/workspace/solution/solve.sh').read_bytes()).hexdigest() == 'bca6ef61c3a1bc0ded2aa6b2da4734b62072846def679d12a2d7ae669fc88bd1'\ncache = Path('/workspace/solution/__pycache__')\nif cache.exists():\n    shutil.rmtree(cache)\n(root / 'episode_7_index.json').write_text(json.dumps(index, indent=2, allow_nan=False) + '\\n')\n(root / 'episode7_official_summary.json').write_text(json.dumps(official, indent=2) + '\\n')\n(root / 'episode_7_final_selection.json').write_text(json.dumps(best, indent=2) + '\\n')\nprint('source snapshots', len(index))\nprint('complete local screens', sum(x.get('local_summary', {}).get('count', 0) == 30 for x in index.values()))\nprint('all30 local valid', sum(x.get('local_summary', {}).get('valid', 0) == 30 for x in index.values()))\nprint('official evaluations', len(official))\nprint(json.dumps(best, indent=2))\n{\n  \"best\": {\n    \"name\": \"432_episode7_schedule_bounds\",\n    \"valid\": true,\n    \"raw_metric\": 0.03942903473265081,\n    \"score
{"type": "item.started", "item": {"id": "item_64", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/research_history/build_episode4_taylor.py <<'PY'\nfrom pathlib import Path\nroot=Path('/tmp/research_history');base=(root/'145_inplace_matrix_scaling/method.py').read_text()\nnew='''def _expectation(C,a,b,ya,yb,W):\n    n,m=C.shape;beta=.1*float(C.max())\n    A=torch.from_numpy(a);B=torch.from_numpy(b)\n    center=(A.mean(0)+B.mean(0))/2\n    A=A-center;B=B-center\n    an=A.square().sum(1)/2;bn=B.square().sum(1)/2\n    ak=torch.exp(-an/beta);bk=torch.exp(-bn/beta)\n    ia=torch.from_numpy(ya);ib=torch.from_numpy(yb)\n    def poly(Z):\n        Z=Z/(beta**.5)\n        cols=[torch.ones(len(Z))]\n        for d in range(1,DEGREE+1):\n            for comb in combinations_with_replacement(range(10),d):\n                v=Z[:,comb[0]].clone();fac=1\n                for c in comb[1:]:v.mul_(Z[:,c])\n                for c in set(comb):fac*=math.factorial(comb.count(c))\n                cols.append(v/(fac**.5))\n        return torch.stack(cols,dim=1)\n    PA=poly(A);PB=poly(B);k=PA.shape[1]\n    labels=torch.from_numpy(W[:10,10:])/2\n    L=torch.exp(-labels/beta)\n    def grouped(T,idx):\n        out=torch.zeros((10,T.shape[1]))\n        out.scatter_add_(0,idx[:,None].expand_as(T),T)\n        return out\n    def mv_left(v):\n        moments=grouped(PB*(bk*v)[:,None],ib)\n        out=(PA*(L @ moments)[ia]).sum(1)*ak\n        return out\n    def mv_right(u):\n        moments=grouped(PA*(ak*u)[:,None],ia)\n        return (PB*(L.T @ moments)[ib]).sum(1)*bk\n    u=torch.full((n,),1./n);v=torch.full((m,),1./m)\n    for t in range(2):\n        den=mv_right(u)\n        if float(den.min())<=1e-30:return _dense_expectation(C)\n        v=(1./m)/den\n        den=mv_left(v)\n        if float(den.min())<=1e-30:return _dense_expectation(C)\n        u=(1./n)/den\n    fields=torch.column_stack((torch.ones(m),bn,B))\n    moment=grouped((PB[:,:,None]*fields[:,None,:]*(bk*v)[:,None,None]).flatten(1),ib)\n    contractions=((L @ moment)[ia].reshape(n,k,12)*PA[:,:,None]).sum(1)\n    zeroth=contractions[:,0]\n    numerator=an*zeroth+contractions[:,1]-(A*contractions[:,2:]).sum(1)\n    moment=grouped(PB*(bk*v)[:,None],ib)\n    numerator+=(PA*((L*labels) @ moment)[ia]).sum(1)\n    return float((numerator/zeroth).mean())\n'''\nstart=base.index('def _expectation(');end=base.index('\\\\n\\\\ndef _outer(',start)\ns=base[:start]+base[start:end].replace('def _expectation','def _dense_expectation')+'\\\\n\\\\n'+new+base[end:]\ns=s.replace('import numpy as np','import numpy as np\\\\nimport math\\\\nfrom itertools import combinations_with_replacement')\ns=s.replace('_expectation(T)/(len(idx)+len(jdx))','_expectation(T,a,b,y[idx],ry[jdx],W)/(len(idx)+len(jdx))')\nfor d in [1,2,3]:\n name={1:'166_taylor_coupling_degree1',2:'167_taylor_coupling_degree2',3:'168_taylor_coupling_degree3'}[d]\n p=root/name;p.mkdir(exist_ok=True);(p/'method.py').write_text(s.replace('DEGREE',str(d)))\nPY\npython /tmp/research_history/build_episode4_taylor.py\ncat >> /tmp/research_history/episode_4_working_notes.md <<'MD'\n\nFresh round4 medians145 .0784119,151 .0650074,153 .0744342,155 .0675195,161 .0682905,162 .0632217,163 .0654291,165 .0645664.162 selected for third full official evaluation, session45472. Current method162 temporarily; restore best145 if measured slower/invalid. No numerical concurrency during formal timing.\n\n166/167/168 new algorithmic hypothesis prepared during162: expand exp(centered_x dot centered_r/beta) todegree1/2/3 polynomial features, preserve exact Gaussian radial factors and all100 label kernel coefficients. Kernel applications use grouped moment sums per observed class. Final transport energy contracts exact low-rank cost (norms, feature dot, empirical label cost) against polynomial kernel. Center computed from current feature means. Dense fallback only on nonpositive denominator. Allsupports retained, no learned constants/lookup/input caching. This explores structuredlowrank vs prior CUR failure. Not screened yet.\nMD\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

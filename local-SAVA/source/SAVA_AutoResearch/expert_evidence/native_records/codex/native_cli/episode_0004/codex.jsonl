{"type": "item.started", "item": {"id": "item_15", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/research_history/build_episode4_round1.py <<'PY'\nfrom pathlib import Path\nbase=Path('/tmp/research_history/123_flush_reciprocal_relative_check/method.py').read_text()\nroot=Path('/tmp/research_history')\ndef save(name,s):\n p=root/name;p.mkdir(exist_ok=True);(p/'method.py').write_text(s)\n# Vectorize the 100 bounding boxes and populate repeated padded arrays once per class.\nstart=base.index('    schedules = []\\\\n')\nend=base.index('    amask = ',start)\nprep='''    al=torch.stack([a.amin(0) for a in aa]);ah=torch.stack([a.amax(0) for a in aa])\n    bl=torch.stack([b.amin(0) for b in bb]);bh=torch.stack([b.amax(0) for b in bb])\n    diam=torch.linalg.vector_norm(torch.maximum(ah[:,None,:],bh[None,:,:])-torch.minimum(al[:,None,:],bl[None,:,:]),dim=2).flatten().tolist()\n    schedules=[[d*d]+[float(np.exp(e)) for e in np.arange(2*np.log(d),np.log(.1),2*np.log(.5))]+[.1] for d in diam]\n    for i,a in enumerate(aa):A[i*10:(i+1)*10,:len(a)]=a\n    for j,b in enumerate(bb):B[j::10,:len(b)]=b\n    C = ((A*A).sum(2)[:,:,None] - 2*torch.bmm(A,B.transpose(1,2)) + (B*B).sum(2)[:,None,:])/2\n'''\ns=base[:start]+prep+base[end:];save('126_vectorized_class_setup',s)\n# Reuse distances for first point pair: gather them into the padded class pair grid.\ns=s.replace('def _label_cost(x, y, r, ry):','def _label_cost(x, y, r, ry, D):')\ns=s.replace('    A = torch.zeros((100, nmax, x.shape[1]))\\\\n    B = torch.zeros((100, mmax, r.shape[1]))\\\\n','')\npos=s.index('    for i,a in enumerate(aa):');e=s.index('    amask = ',pos)\ns=s[:pos]+'''    ai=torch.zeros((10,nmax),dtype=torch.long);bi=torch.zeros((10,mmax),dtype=torch.long)\n    for i in range(10):\n        ids=np.flatnonzero(y==i);ai[i,:len(ids)]=torch.from_numpy(ids)\n        ids=np.flatnonzero(ry==i);bi[i,:len(ids)]=torch.from_numpy(ids)\n    C=D[ai.flatten()][:,bi.flatten()].reshape(10,nmax,10,mmax).permute(0,2,1,3).contiguous().reshape(100,nmax,mmax)\n'''+s[e:]\ns=s.replace('        W=_label_cost(x[tx[0]],y[tx[0]],r[tr[0]],ry[tr[0]])','        D0=torch.cdist(torch.from_numpy(x[tx[0]]),torch.from_numpy(r[tr[0]])).square()/2\\\\n        W=_label_cost(x[tx[0]],y[tx[0]],r[tr[0]],ry[tr[0]],D0)')\ns=s.replace('                T=torch.cdist(torch.from_numpy(a),torch.from_numpy(b)).square()/2','                T=D0 if i==0 and j==0 else torch.cdist(torch.from_numpy(a),torch.from_numpy(b)).square()/2')\nsave('127_reuse_first_geometry',s)\n# All feature distances in one mm, share both class and all point geometry.\ns=s.replace('        D0=torch.cdist(torch.from_numpy(x[tx[0]]),torch.from_numpy(r[tr[0]])).square()/2','        X=torch.from_numpy(x);R=torch.from_numpy(r)\\\\n        D=(X*X).sum(1)[:,None]-2*(X @ R.T)+(R*R).sum(1)[None,:]\\\\n        D.mul_(.5)\\\\n        D0=D[:len(tx[0]),:len(tr[0])]')\ns=s.replace('                T=D0 if i==0 and j==0 else torch.cdist(torch.from_numpy(a),torch.from_numpy(b)).square()/2','                T=D[i*batch_size:i*batch_size+len(idx),j*batch_size:j*batch_size+len(jdx)].contiguous()')\nsave('128_global_geometry',s)\n# No geometry sharing, but one matrix multiply rather than one hundred repeats.\ns=base[:start]+prep+base[end:]\npos=s.index('    for i,a in enumerate(aa):');e=s.index('    amask = ',pos)\ns=s[:pos]+'''    A=torch.zeros((10,nmax,x.shape[1]));B=torch.zeros((10,mmax,r.shape[1]))\n    for i,a in enumerate(aa):A[i,:len(a)]=a\n    for j,b in enumerate(bb):B[j,:len(b)]=b\n    A=A.flatten(0,1);B=B.flatten(0,1)\n    C=((A*A).sum(1)[:,None]-2*(A @ B.T)+(B*B).sum(1)[None,:])/2\n    C=C.reshape(10,nmax,10,mmax).permute(0,2,1,3).contiguous().reshape(100,nmax,mmax)\n'''+s[e:]\ns=s.replace('    A = torch.zeros((100, nmax, x.shape[1]))\\\\n    B = torch.zeros((100, mmax, r.shape[1]))\\\\n','')\nsave('129_packed_class_geometry',s)\n# Avoid an allocated kernel-cost product in expectation.\ns=base.replace('(K*C) @ v','K.mul_(C) @ v');save('130_inplace_coupling_energy',s)\n# Scale kernel in place by both marginals, then total energy reduction.\ns=base.replace('    return float(torch.dot(u,(K*C) @ v))','    K.mul_(v[None,:]).mul_(u[:,None]).mul_(C)\\\\n    return float(K.sum())');save('131_inplace_coupling_mass',s)\nPY\npython /tmp/research_history/build_episode4_round1.py\npython /tmp/research_history/screen_all.py /tmp/research_history/000_baseline/method.py /tmp/research_history/126_vectorized_class_setup/method.py /tmp/research_history/127_reuse_first_geometry/method.py /tmp/research_history/128_global_geometry/method.py /tmp/research_history/129_packed_class_geometry/method.py /tmp/research_history/130_inplace_coupling_energy/method.py /tmp/research_history/131_inplace_coupling_mass/method.py > /tmp/research_history/screen_all_126_131.log\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

{"type": "item.completed", "item": {"id": "item_9", "type": "command_execution", "command": "/bin/sh -lc 'cat /tmp/research_history/000_baseline/method.py; cat /tmp/research_history/screen_all.py'", "aggregated_output": "\"\"\"Canonical initial numerical method. All geometry is computed from inputs.\"\"\"\nimport numpy as np\nimport torch\nimport ot\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\n\ndef _label_cost(x,y,r,ry):\n    xx=torch.tensor(np.concatenate([x,r]),dtype=torch.float32)\n    yy=np.concatenate([y,ry+10])\n    W=np.zeros((20,20),dtype=np.float32)\n    loss=SamplesLoss('sinkhorn',p=2,blur=np.sqrt(.1),debias=False,backend='tensorized')\n    with torch.inference_mode():\n        for i in range(20):\n            for j in range(i+1,20):\n                if not (yy==i).any() or not (yy==j).any():\n                    raise ValueError('Initial batch lacks a label support')\n                W[i,j]=W[j,i]=float(loss(xx[yy==i],xx[yy==j]))\n    return W\n\ndef value(x,y,r,ry,seed=17,batch_size=1024):\n    torch.set_num_threads(2)\n    x=np.asarray(x,np.float32); r=np.asarray(r,np.float32)\n    y=np.asarray(y,np.int64); ry=np.asarray(ry,np.int64)\n    tx=[np.arange(i,min(i+batch_size,len(x))) for i in range(0,len(x),batch_size)]\n    tr=[np.arange(i,min(i+batch_size,len(r))) for i in range(0,len(r),batch_size)]\n    W=_label_cost(x[tx[0]],y[tx[0]],r[tr[0]],ry[tr[0]])\n    def cost(z1,z2):\n        d=torch.cdist(z1[:,:,:-1],z2[:,:,:-1]).square()/2\n        return d+torch.as_tensor(W)[z1[:,:,-1].long().unsqueeze(2),z2[:,:,-1].long().unsqueeze(1)]/2\n    potential=SamplesLoss('sinkhorn',p=2,blur=np.sqrt(.1),debias=False,\n                         potentials=True,cost=cost,backend='tensorized')\n    F={}; batchcost=np.zeros((len(tx),len(tr)))\n    for i,idx in enumerate(tx):\n        for j,jdx in enumerate(tr):\n            a=x[idx];b=r[jdx]\n            C=cdist(a,b,'sqeuclidean')/2+W[y[idx,None],ry[jdx][None,:]+10]/2\n            P=ot.sinkhorn(ot.unif(len(idx)),ot.unif(len(jdx)),C/max(float(C.max()),1e-12),.1)\n            batchcost[i,j]=float(np.sum(P*C))/(len(idx)+len(jdx))\n            z1=torch.tensor(np.column_stack([a,y[idx]]),dtype=torch.float32)[None]\n            z2=torch.tensor(np.column_stack([b,ry[jdx]+10]),dtype=torch.float32)[None]\n            with torch.inference_mode(): f,_=potential(z1,z2)\n            f=f.numpy().ravel().astype(float)\n            F[i,j]=(f-f.mean())*len(f)/(len(f)-1)\n    Q=ot.sinkhorn(ot.unif(len(tx)),ot.unif(len(tr)),\n                  batchcost/max(float(batchcost.max()),1e-12),.01,\n                  numItermax=10000,stopThr=1e-10)\n    residual=max(np.max(np.abs(Q.sum(1)-ot.unif(len(tx)))),\n                 np.max(np.abs(Q.sum(0)-ot.unif(len(tr)))))\n    if residual>1e-6: raise ValueError(f'Unconverged batch transport: {residual}')\n    values=np.zeros(len(x))\n    for i,idx in enumerate(tx): values[idx]=sum(Q[i,j]*F[i,j] for j in range(len(tr)))\n    return values\nimport importlib.util,sys,time\nfrom pathlib import Path\nimport numpy as np\nfrom scipy.stats import spearmanr\nmods=[]\nfor path in sys.argv[1:]:\n spec=importlib.util.spec_from_file_location('m'+str(len(mods)),path)\n m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m);mods.append((path,m))\nfor p in sorted(Path('/workspace/environment/public_assets/dev').glob('*.npz')):\n z=np.load(p); args=(z['x'],z['y'],z['r'],z['ry'],int(z['seed']))\n cache=Path('/tmp/research_history/'+p.stem+'_canonical.npy')\n if cache.exists():target=np.load(cache)\n else:\n  target=mods[0][1].value(*args);np.save(cache,target)\n for path,m in mods[1:]:\n  t=time.perf_counter();out=m.value(*args);dt=time.perf_counter()-t\n  n=len(out);a=np.argsort(-out,kind='stable')[:n//4];b=np.argsort(-target,kind='stable')[:n//4]\n  nr=np.sqrt(np.mean((out-target)**2))/target.std();rho=spearmanr(out,target).statistic;top=len(set(a)&set(b))/(n//4)\n  print(p.stem,Path(path).parent.name,'time',round(dt,4),'nrmse',nr,'rho',rho,'top',top,'valid',nr<=.01 and rho>=.999 and top>=.98,flush=True)\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_10", "type": "command_execution", "command": "/bin/sh -lc 'sha256sum method.py solve.sh; cat /tmp/research_history/125_numpy_coupling_reductions/method.py'", "aggregated_output": "011e216f7713a4e107d99beedc0a24c769c46e7b53a7e657463191a50d6ac4cc  method.py\nbca6ef61c3a1bc0ded2aa6b2da4734b62072846def679d12a2d7ae669fc88bd1  solve.sh\n\"\"\"Hierarchical transport with reusable costs and explicit annealed dual solves.\"\"\"\nimport numpy as np\nimport torch\nimport ot\nfrom scipy.spatial.distance import cdist\n\n\ndef _schedule(a, b):\n    lo = torch.minimum(a.amin(0), b.amin(0))\n    hi = torch.maximum(a.amax(0), b.amax(0))\n    diameter = float(torch.linalg.vector_norm(hi - lo))\n    return [diameter**2] + [float(np.exp(e)) for e in np.arange(2*np.log(diameter), np.log(.1), 2*np.log(.5))] + [.1]\n\n\ndef _dual(C, schedule):\n    n,m=C.shape\n    la=float(np.log(np.float32(1./n)));lb=float(np.log(np.float32(1./m)))\n    K=None; pe=None; shift=0.\n    def direct(f,g,eps):\n        R=C-f[:,None];R-=g[None,:]\n        if eps<=2.:\n            return f+R.amin(1)-eps*lb,g+R.amin(0)-eps*la,None,0.,None,None\n        rm=float(R.min());R-=rm;R*=(-1./eps)\n        R.clamp_(min=-80.).exp_()\n        rs=R.sum(1);cs=R.sum(0)\n        if min(float(rs.min()),float(cs.min()))<=2e-22:\n            R=C-f[:,None];R-=g[None,:];R*=(-1./eps)\n            rowmax=R.amax(1);colmax=R.amax(0)\n            rr=torch.exp(R-rowmax[:,None]).sum(1);cc=torch.exp(R-colmax[None,:]).sum(0)\n            return f-eps*(rowmax+rr.log()+lb),g-eps*(colmax+cc.log()+la),None,0.,None,None\n        return f+rm-eps*(rs.log()+lb),g+rm-eps*(cs.log()+la),R,rm,rs,cs\n    f,g,K,shift,rs,cs=direct(torch.zeros(n),torch.zeros(m),schedule[0])\n    pe=schedule[0];full=True\n    for eps in schedule[2:-3]:\n        if K is None or eps<=2.:\n            ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        else:\n            old_shift=shift\n            if full:\n                K.mul_((m/r
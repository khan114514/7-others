{"type": "item.started", "item": {"id": "item_29", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/research_history/build_episode4_segmented.py <<'PY'\nfrom pathlib import Path\nroot=Path('/tmp/research_history');base=(root/'123_flush_reciprocal_relative_check/method.py').read_text()\nnew='''def _label_cost(x,y,r,ry):\n    ix=np.argsort(y,kind='stable');jx=np.argsort(ry,kind='stable')\n    y=y[ix];ry=ry[jx];x=x[ix];r=r[jx]\n    an=np.bincount(y,minlength=10);bn=np.bincount(ry,minlength=10)\n    sa=np.r_[0,np.cumsum(an)[:-1]];sb=np.r_[0,np.cumsum(bn)[:-1]]\n    al=np.minimum.reduceat(x,sa,axis=0);ah=np.maximum.reduceat(x,sa,axis=0)\n    bl=np.minimum.reduceat(r,sb,axis=0);bh=np.maximum.reduceat(r,sb,axis=0)\n    diam=torch.linalg.vector_norm(torch.from_numpy(np.maximum(ah[:,None,:],bh[None,:,:])-np.minimum(al[:,None,:],bl[None,:,:])),dim=2).numpy()\n    schedules=[[(d:=float(v))**2]+[float(np.exp(e)) for e in np.arange(2*np.log(d),np.log(.1),2*np.log(.5))]+[.1] for v in diam.ravel()]\n    A=torch.from_numpy(x);B=torch.from_numpy(r)\n    C=(((A*A).sum(1)[:,None]-2*(A @ B.T)+(B*B).sum(1)[None,:])/2).numpy()\n    la=np.log(1/an.astype(np.float32));lb=np.log(1/bn.astype(np.float32))\n    def rowmin(R):return np.minimum.reduceat(R,sb,axis=1)\n    def colmin(R):return np.minimum.reduceat(R,sa,axis=0)\n    def rowsum(K):return np.add.reduceat(K,sb,axis=1)\n    def colsum(K):return np.add.reduceat(K,sa,axis=0)\n    def direct(f,g,eps):\n        R=C-f[:,ry];R-=g[y,:]\n        if eps.max()<=8.:\n            return f+rowmin(R)-eps[y,:]*lb[None,:],g+colmin(R)-eps[:,ry]*la[:,None],None,None,None,None\n        rm=colmin(rowmin(R));R-=rm[y[:,None],ry[None,:]];R/=eps[y[:,None],ry[None,:]];R*=-1.\n        np.maximum(R,-80.,out=R);np.exp(R,out=R)\n        rs=rowsum(R);cs=colsum(R)\n        check=np.minimum(np.minimum.reduceat(rs,sa,axis=0),np.minimum.reduceat(cs,sb,axis=1))\n        scale=np.maximum(np.maximum.reduceat(rs,sa,axis=0),np.maximum.reduceat(cs,sb,axis=1))\n        if (check/scale).min()>2e-22:\n            ft=f+rm[y,:]-eps[y,:]*(np.log(rs)+lb[None,:]);gt=g+rm[:,ry]-eps[:,ry]*(np.log(cs)+la[:,None])\n            return ft,gt,R,rm,rs,cs\n        Z=C-f[:,ry];Z-=g[y,:];Z/=-eps[y[:,None],ry[None,:]]\n        rmax=np.maximum.reduceat(Z,sb,axis=1);cmax=np.maximum.reduceat(Z,sa,axis=0)\n        rr=rowsum(np.exp(Z-rmax[:,ry]));cc=colsum(np.exp(Z-cmax[y,:]))\n        return f-eps[y,:]*(rmax+np.log(rr)+lb[None,:]),g-eps[:,ry]*(cmax+np.log(cc)+la[:,None]),None,None,None,None\n    eps=np.array([z[0] for z in schedules],np.float32).reshape(10,10)\n    f,g,K,shift,rs,cs=direct(np.zeros((len(x),10),np.float32),np.zeros((10,len(r)),np.float32),eps)\n    pe=eps;pa=np.ones((10,10),bool);full=True\n    for t in range(2,max(map(len,schedules))):\n        eps=np.array([z[t] if t<len(z) else .1 for z in schedules],np.float32).reshape(10,10)\n        active=np.array([t<len(z) for z in schedules]).reshape(10,10)\n        if K is None or eps.max()<=8.:ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        else:\n            if full:\n                ar=rs/bn[None,:];bc=cs/an[:,None]\n            else:\n                ar=np.where(pa[y,:],np.sqrt(rs/bn[None,:]),1.);bc=np.where(pa[:,ry],np.sqrt(cs/an[:,None]),1.)\n            K*=np.reciprocal(ar)[:,ry];K*=np.reciprocal(bc)[y,:]\n            q=pe/eps\n            if np.all(np.abs(q-4.)<1e-4):np.square(K,out=K);np.square(K,out=K)\n            else:np.power(K,q[y[:,None],ry[None,:]],out=K)\n            shift=-shift if full else np.where(pa,0.,shift)\n            rs=rowsum(K);cs=colsum(K)\n            check=np.minimum(np.minimum.reduceat(rs,sa,axis=0),np.minimum.reduceat(cs,sb,axis=1))\n            scale=np.maximum(np.maximum.reduceat(rs,sa,axis=0),np.maximum.reduceat(cs,sb,axis=1))\n            if (check/scale).min()>2e-22:\n                ft=f+shift[y,:]-eps[y,:]*(np.log(rs)+lb[None,:]);gt=g+shift[:,ry]-eps[:,ry]*(np.log(cs)+la[:,None])\n            else:ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        f=np.where(active[y,:],(f+ft)*.5,f);g=np.where(active[:,ry],(g+gt)*.5,g)\n        pe=eps;pa=active;full=False\n    ft,gt,_,_,_,_=direct(f,g,np.full((10,10),.1,np.float32))\n    costs=np.add.reduceat(ft,sa,axis=0)/an[:,None]+np.add.reduceat(gt,sb,axis=1)/bn[None,:]\n    W=np.zeros((20,20),np.float32);W[:10,10:]=costs;W[10:,:10]=costs.T\n    return W\n'''\nstart=base.index('def _label_cost(');end=base.index('\\\\n\\\\ndef _expectation',start)\ns=base[:start]+new+base[end:]\np=root/'140_segmented_class_solver';p.mkdir(exist_ok=True);(p/'method.py').write_text(s)\nPY\npython /tmp/research_history/build_episode4_segmented.py\ncat /tmp/research_history/136_all_torch_reductions/evaluator.log\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

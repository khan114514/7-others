{"type": "item.started", "item": {"id": "item_25", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/research_history/build_episode4_numpy.py <<'PY'\nfrom pathlib import Path\nroot=Path('/tmp/research_history');base=(root/'123_flush_reciprocal_relative_check/method.py').read_text()\ndef save(n,s):\n p=root/n;p.mkdir(exist_ok=True);(p/'method.py').write_text(s)\nstart=base.index('def _dual(C, schedule):');end=base.index('\\\\n\\\\ndef _label_cost(',start)\nnew='''def _dual(C, schedule):\n    C=C.numpy();n,m=C.shape\n    la=float(np.log(np.float32(1./n)));lb=float(np.log(np.float32(1./m)))\n    def direct(f,g,eps):\n        R=C-f[:,None];R-=g[None,:]\n        if eps<=2.:\n            return f+R.min(1)-eps*lb,g+R.min(0)-eps*la,None,0.,None,None\n        rm=float(R.min());R-=rm;R*=(-1./eps)\n        np.maximum(R,-80.,out=R);np.exp(R,out=R)\n        rs=R.sum(1);cs=R.sum(0)\n        if min(float(rs.min()),float(cs.min()))<=2e-22:\n            R=C-f[:,None];R-=g[None,:];R*=(-1./eps)\n            rmv=R.max(1);cmv=R.max(0)\n            rr=np.exp(R-rmv[:,None]).sum(1);cc=np.exp(R-cmv[None,:]).sum(0)\n            return f-eps*(rmv+np.log(rr)+lb),g-eps*(cmv+np.log(cc)+la),None,0.,None,None\n        return f+rm-eps*(np.log(rs)+lb),g+rm-eps*(np.log(cs)+la),R,rm,rs,cs\n    f,g,K,shift,rs,cs=direct(np.zeros(n,np.float32),np.zeros(m,np.float32),schedule[0])\n    pe=schedule[0];full=True\n    for eps in schedule[2:-3]:\n        if K is None or eps<=2.:ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        else:\n            old_shift=shift\n            if full:\n                K*=(m/rs)[:,None];K*=(n/cs)[None,:]\n            else:\n                K*=np.sqrt(m/rs)[:,None];K*=np.sqrt(n/cs)[None,:]\n            if abs(pe/eps-4.)<1e-5:\n                np.square(K,out=K);np.square(K,out=K)\n            else:np.power(K,pe/eps,out=K)\n            shift=-old_shift if full else 0.\n            rs=K.sum(1);cs=K.sum(0)\n            if min(float(rs.min()/rs.max()),float(cs.min()/cs.max()))>2e-22:\n                ft=f+shift-eps*(np.log(rs)+lb);gt=g+shift-eps*(np.log(cs)+la)\n            else:ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        f=(f+ft)*.5;g=(g+gt)*.5;pe=eps;full=False\n    return (C-g[None,:]).min(1)-.1*lb,None\n'''\ns=base[:start]+new+base[end:];s=s.replace('f=f.numpy().ravel().astype(float)','f=np.asarray(f).ravel().astype(float)');save('137_numpy_point_recurrence',s)\n# NumPy class recurrence with original Torch geometry and schedules.\nlabelstart=base.index('    valid=amask[:,:,None]&bmask[:,None,:]');labelend=base.index('    W=np.zeros',labelstart)\nnew='''    C=C.numpy();amask=amask.numpy();bmask=bmask.numpy();an=an.numpy();bn=bn.numpy()\n    valid=amask[:,:,None]&bmask[:,None,:]\n    la=np.log(1/an.astype(np.float32))[:,None];lb=np.log(1/bn.astype(np.float32))[:,None]\n    def direct(f,g,eps):\n        R=C-f[:,:,None];R-=g[:,None,:]\n        if eps.max()<=8.:\n            ft=f+R.min(2)-eps[:,None]*lb;gt=g+R.min(1)-eps[:,None]*la\n            return np.where(amask,ft,0.),np.where(bmask,gt,0.),None,None,None,None\n        rm=R.min((1,2));R-=rm[:,None,None];R/=eps[:,None,None];R*=-1.\n        np.maximum(R,-80.,out=R);np.exp(R,out=R);R[~valid]=0.\n        rs=R.sum(2);cs=R.sum(1)\n        check=np.minimum(np.where(amask,rs,np.inf).min(1),np.where(bmask,cs,np.inf).min(1))\n        if (check/np.maximum(rs.max(1),cs.max(1))).min()>2e-22:\n            ft=f+rm[:,None]-eps[:,None]*(np.log(np.maximum(rs,1e-38))+lb)\n            gt=g+rm[:,None]-eps[:,None]*(np.log(np.maximum(cs,1e-38))+la)\n            return np.where(amask,ft,0.),np.where(bmask,gt,0.),R,rm,rs,cs\n        v=(g[:,None,:]-C)/eps[:,None,None];ft=-eps[:,None]*(logsumexp(v,axis=2)+lb)\n        v=(f[:,:,None]-C)/eps[:,None,None];gt=-eps[:,None]*(logsumexp(v,axis=1)+la)\n        return np.where(amask,ft,0.),np.where(bmask,gt,0.),None,None,None,None\n    eps=np.array([z[0] for z in schedules],np.float32)\n    f,g,K,shift,rs,cs=direct(np.zeros((100,nmax),np.float32),np.zeros((100,mmax),np.float32),eps)\n    pe=eps;pa=np.ones((100,1),bool);full=True\n    for t in range(2,max(map(len,schedules))):\n        eps=np.array([z[t] if t<len(z) else .1 for z in schedules],np.float32)\n        active=np.array([t<len(z) for z in schedules])[:,None]\n        if K is None or eps.max()<=8.:ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        else:\n            if full:\n                ar=np.where(amask,rs/bn[:,None],1.);bc=np.where(bmask,cs/an[:,None],1.)\n            else:\n                ar=np.where(amask & pa,np.sqrt(rs/bn[:,None]),1.);bc=np.where(bmask & pa,np.sqrt(cs/an[:,None]),1.)\n            K*=np.reciprocal(ar)[:,:,None];K*=np.reciprocal(bc)[:,None,:]\n            q=pe/eps\n            if np.all(np.abs(q-4.)<1e-4):np.square(K,out=K);np.square(K,out=K)\n            else:np.power(K,q[:,None,None],out=K)\n            shift=-shift if full else np.where(pa[:,0],0.,shift)\n            rs=K.sum(2);cs=K.sum(1)\n            check=np.minimum(np.where(amask,rs,np.inf).min(1),np.where(bmask,cs,np.inf).min(1))\n            if (check/np.maximum(rs.max(1),cs.max(1))).min()>2e-22:\n                ft=f+shift[:,None]-eps[:,None]*(np.log(np.maximum(rs,1e-38))+lb)\n                gt=g+shift[:,None]-eps[:,None]*(np.log(np.maximum(cs,1e-38))+la)\n                ft=np.where(amask,ft,0.);gt=np.where(bmask,gt,0.)\n            else:ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        f=np.where(active,(f+ft)*.5,f);g=np.where(active,(g+gt)*.5,g)\n        pe=eps;pa=active;full=False\n    ft,gt,_,_,_,_=direct(f,g,np.full(100,.1,np.float32))\n    costs=(ft/an[:,None]).sum(1)+(gt/bn[:,None]).sum(1)\n'''\nt=base[:labelstart]+new+base[labelend:];t=t.replace('costs.numpy().reshape','costs.reshape');t=t.replace('from scipy.spatial.distance import cdist','from scipy.spatial.distance import cdist\\\\nfrom scipy.special import logsumexp');save('138_numpy_class_recurrence',t)\nstart=t.index('def _dual(C, schedule):');end=t.index('\\\\n\\\\ndef _label_cost(',start)\ndual=s[s.index('def _dual('):s.index('\\\\n\\\\ndef _label_cost(')]\nt=t[:start]+dual+t[end:];t=t.replace('f=f.numpy().ravel().astype(float)','f=np.asarray(f).ravel().astype(float)');save('139_numpy_both_recurrence',t)\nPY\npython /tmp/research_history/build_episode4_numpy.py\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

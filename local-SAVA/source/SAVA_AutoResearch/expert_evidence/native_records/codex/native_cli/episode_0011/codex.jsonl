{"type": "item.completed", "item": {"id": "item_8", "type": "command_execution", "command": "/bin/sh -lc 'cat /tmp/research_history/episode8_screen.py /tmp/research_history/episode10_bench.py /tmp/research_history/episode10_index.py'", "aggregated_output": "import importlib.util,json,sys,time,hashlib\nfrom pathlib import Path\nimport numpy as np\nfrom scipy.stats import spearmanr\nroot=Path('/tmp/research_history')\nmanifest=root/sys.argv[1]\nentries=json.loads(manifest.read_text());records=[];mods=[]\nfor k,e in enumerate(entries):\n p=root/e['name']/'method.py'\n spec=importlib.util.spec_from_file_location('episode8_'+str(k),p)\n try:\n  mod=importlib.util.module_from_spec(spec);spec.loader.exec_module(mod)\n  mods.append((e,mod))\n except Exception as exc:mods.append((e,repr(exc)))\nfor p in sorted(Path('/workspace/environment/public_assets/dev').glob('*.npz')):\n z=np.load(p);args=z['x'],z['y'],z['r'],z['ry'],int(z['seed'])\n target=np.load(root/(p.stem+'_canonical.npy'))\n b=np.argsort(-target,kind='stable')[:len(target)//4]\n for e,mod in mods:\n  t=time.perf_counter()\n  try:\n   if isinstance(mod,str):raise RuntimeError(mod)\n   out=np.asarray(mod.value(*args));elapsed=time.perf_counter()-t\n   nr=float(np.sqrt(np.mean((out-target)**2))/target.std())\n   rho=float(spearmanr(out,target).statistic)\n   a=np.argsort(-out,kind='stable')[:len(out)//4]\n   top=len(set(a)&set(b))/(len(out)//4)\n   valid=out.shape==target.shape and np.isfinite(out).all() and nr<=.01 and rho>=.999 and top>=.98\n   rec={'name':e['name'],'case':p.stem,'seconds':elapsed,'nrmse':nr,'rho':rho,'top':top,'valid':bool(valid)}\n  except Exception as exc:\n   rec={'name':e['name'],'case':p.stem,'seconds':time.perf_counter()-t,'valid':False,'error':repr(exc)}\n  records.append(rec)\n  print(json.dumps(rec),flush=True)\nsummary=[]\nfor e in entries:\n rr=[r for r in records if r['name']==e['name']]\n nr=[r.get('nrmse',float('inf')) for r in rr]\n s={'name':e['name'],'sha256':e['sha256'],'cases':len(rr),'valid':all(r['valid'] for r in rr),'failures':sum(not r['valid'] for r in rr),'worst_nrmse':max(nr),'mean_seconds':float(np.mean([r['seconds'] for r in rr]))}\n summary.append(s)\n print('SUMMARY',json.dumps(s),flush=True)\nmanifest.with_name(manifest.stem+'_screen.json').write_text(json.dumps({'summary':summary,'records':records},indent=2))\nimport subprocess,sys,json\nfrom pathlib import Path\nimport numpy as np\nroot=Path('/tmp/research_history');names=sys.argv[2:];roundname=sys.argv[1]\nchild='''import importlib.util,sys,time,json\nimport numpy as np\np=sys.argv[1];spec=importlib.util.spec_from_file_location('candidate',p);m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)\nz=np.load('/workspace/environment/public_assets/dev/'+sys.argv[2]+'.npz');args=(z['x'],z['y'],z['r'],z['ry'],int(z['seed']))\nt=time.perf_counter();v=m.value(*args);dt=time.perf_counter()-t\nprint(json.dumps({'time':dt,'std':float(v.std())}))\n'''\nrecords=[];cases=['seed_303_gaussian_016','seed_202_uniform_labels','seed_505_mixed']\nfor t in range(6):\n for k in (range(len(names)) if t%2==0 else range(len(names)-1,-1,-1)):\n  case=cases[t%3];z=json.loads(subprocess.run([sys.executable,'-c',child,str(root/names[k]/'method.py'),case],check=True,capture_output=True,text=True).stdout)\n  records.append({'name':names[k],'round':t,'case':case,**z})\n  print(json.dumps(records[-1]),flush=True)\nsummary=[{'name':n,'median':float(np.median([r['time'] for r in records if r['name']==n])),'mean':float(np.mean([r['time'] for r in records if r['name']==n]))} for n in names]\nfor r in summary:print('SUMMARY',json.dumps(r),flush=True)\n(root/(roundname+'.json')).write_text(json.dumps({'records':records,'summary':summary},indent=2))\nfrom pathlib import Path\nimport hashlib,json,math,shutil,sys\nroot=Path('/tmp/research_history');index={};official=[]\ndef clean(obj):\n if isinstance(obj,float) and not math.isfinite(obj):return None\n if isinstance(obj,dict):return {k:clean(v) for k,v in obj.items()}\n if isinstance(obj,list):return [clean(v) for v in obj]\n return obj\nfor p in sorted(root.glob('episode10_round*_manifest.json')):\n manifest=json.loads(p.read_text());screenpath=p.with_name(p.stem+'_screen.json')\n screen=json.loads(screenpath.read_text()) if screenpath.exists() else {'summary':[],'records':[]}\n for entry in manifest:\n  name=entry['name'];data=(root/name/'method.py').read_bytes();digest=hashlib.sha256(data).hexdigest()\n  assert digest==entry['sha256']\n  index[name]={**entry,'source_bytes':len(data),'manifest':p.name,'local_records':[r for r in screen['records'] if r['name']==name]}\n  sums=[q for q in screen['summary'] if q['name']==name]\n  if sums:index[name]['local_summary']=sums[0]\nfor p in sorted(root.glob('*_episode10_*/method.py')):\n name=p.parent.name;data=p.read_bytes();digest=hashlib.sha256(data).hexdigest()\n index.setdefault(name,{'name':name,'sha256':digest,'source_bytes':len(data)})\n report=p.parent/'result.json'\n if report.exists():\n  z=json.loads(report.read_text());assert z['method_sha256']==digest\n  qs=[q for c in z['cases'] for q in c['quality']]\n  rec={'name':name,'raw_metric':z['raw_metric'],'score':z['score'],'quality_valid':z['quality_valid'],'method_sha256':z['method_sha256'],'cases':len(z['cases']),'quality_records':len(qs),'worst_nrmse':max(q['normalized_rmse'] for q in qs),'min_spearman':min(q['spearman'] for q in qs),'min_top_overlap':min(q['top_quartile_overlap'] for q in qs)}\n  index[name]['official']=rec;official.append(rec)\nz=json.loads((root/'554_episode9_shared_coupling_cancel_gemm_columns/result.json').read_text());qs=[q for c in z['cases'] for q in c['quality']]\nhist={'name':'554_episode9_shared_coupling_cancel_gemm_columns','raw_metric':z['raw_metric'],'score':z['score'],'quality_valid':z['quality_valid'],'method_sha256':z['method_sha256'],'cases':len(z['cases']),'quality_records':len(qs),'worst_nrmse':max(q['normalized_rmse'] for q in qs),'min_spearman':min(q['spearman'] for q in qs),'min_top_overlap':min(q['top_quartile_overlap'] for q in qs)}\ncomparison=[hist]+official\nvalid=[q for q in comparison if q['quality_valid'] and q['cases']==30 and q['quality_records']==270 and math.isfinite(q['raw_metric']) and math.isfinite(q['score'])]\nbest=min(valid,key=lambda q:q['raw_metric'])\nlauncher=hashlib.sha256(Path('/workspace/solution/solve.sh').read_bytes()).hexdigest();assert launcher=='bca6ef61c3a1bc0ded2aa6b2da4734b62072846def679d12a2d7ae669fc88bd1'\nif '--restore' in sys.argv:\n shutil.copyfile(root/best['name']/'method.py','/workspace/solution/method.py')\n assert hashlib.sha256(Path('/workspace/solution/method.py').read_bytes()).hexdigest()==best['method_sha256']\n cache=Path('/workspace/solution/__pycache__')\n if cache.exists():shutil.rmtree(cache)\n(root/'episode_10_index.json').write_text(json.dumps(clean(index),indent=2,allow_nan=False)+'\\n')\n(root/'episode10_official_summary.json').write_text(json.dumps(official,indent=2,allow_nan=False)+'\\n')\n(root/'episode_10_final_selection.json').write_text(json.dumps({'best':best,'comparison':comparison,'solve_sha256':launcher,'selection_rule':'Fastest complete official quality-valid raw aggregate including historical best. No local timings treated as scores.'},indent=2)+'\\n')\nprint(json.dumps({'snapshots':len(index),'complete_local_screens':sum(len(v.get('local_records',[]))==30 for v in index.values()),'valid_local_sources':sum(v.get('local_summary',{}).get('valid',False) for v in index.values()),'failed_local_sources':sum(v.get('local_summary',{}).get('valid') is False for v in index.values()),'official_evaluations':len(official),'best':best},indent=2))\n", "exit_code": 0, "status": "completed"}}

{"type": "item.started", "item": {"id": "item_53", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/research_history/episode11_stress.py <<'PY'\nfrom pathlib import Path\nimport json,importlib.util,sys,time\nimport numpy as np\nfrom scipy.stats import spearmanr\nroot=Path('/tmp/research_history')\ndef load(name):\n spec=importlib.util.spec_from_file_location(name,root/name/'method.py');mod=importlib.util.module_from_spec(spec);spec.loader.exec_module(mod);return mod\ncanonical=load('000_baseline');names=sys.argv[1:];mods=[load(n) for n in names];records=[]\nfor seed in [202,505]:\n for setting in ['uniform_labels','gaussian_016','mixed']:\n  case='seed_'+str(seed)+'_'+setting\n  z=np.load('/workspace/environment/public_assets/dev/'+case+'.npz')\n  for repeat in range(3):\n   rngseed=110000+seed*10+repeat;rng=np.random.default_rng(rngseed)\n   ix=rng.permutation(len(z['x']));ir=rng.permutation(len(z['r']))\n   args=z['x'][ix],z['y'][ix],z['r'][ir],z['ry'][ir],int(z['seed'])\n   target=np.asarray(canonical.value(*args));best=np.argsort(-target,kind='stable')[:len(target)//4]\n   for name,mod in zip(names,mods):\n    start=time.perf_counter();out=np.asarray(mod.value(*args));dt=time.perf_counter()-start\n    nr=float(np.sqrt(np.mean((out-target)**2))/target.std());rho=float(spearmanr(out,target).statistic)\n    chosen=np.argsort(-out,kind='stable')[:len(out)//4];top=len(set(best)&set(chosen))/(len(target)//4)\n    r={'source':name,'case':case,'repeat':repeat,'rng_seed':rngseed,'seconds':dt,'nrmse':nr,'rho':rho,'top':top,'valid':bool(np.isfinite(out).all() and out.shape==target.shape and nr<=.01 and rho>=.999 and top>=.98)}\n    records.append(r);print(json.dumps(r),flush=True)\nsummary=[{'source':name,'cases':len([r for r in records if r['source']==name]),'valid':all(r['valid'] for r in records if r['source']==name),'worst_nrmse':max(r['nrmse'] for r in records if r['source']==name),'min_rho':min(r['rho'] for r in records if r['source']==name),'min_top
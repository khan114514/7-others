{"type": "item.started", "item": {"id": "item_27", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/research_history/episode11_build_round2.py <<'PY'\nfrom pathlib import Path\nimport hashlib,json\nroot=Path('/tmp/research_history');base=(root/'644_episode11_start554_repeat/method.py').read_text();entries=[]\ncl='''def _label_cost(x,y,r,ry):\n    aa=[torch.from_numpy(x[y==i]) for i in range(10)]\n    bb=[torch.from_numpy(r[ry==j]) for j in range(10)]\n    nmax=max(map(len,aa));m=len(r)\n    A=torch.zeros((10,nmax,x.shape[1]))\n    for i,a in enumerate(aa):A[i,:len(a)]=a\n    B=torch.cat(bb)\n    an=torch.tensor([len(a) for a in aa]);bn=torch.tensor([len(b) for b in bb])\n    by=torch.repeat_interleave(torch.arange(10),bn)\n    amask=torch.arange(nmax)[None,:]<an[:,None]\n    lengths=bn.expand(10,nmax,-1).contiguous()\n    glengths=bn.expand(10,-1).contiguous()\n    def rowreduce(R,op):\n        return torch.segment_reduce(R.contiguous(),op,lengths=lengths,axis=2,unsafe=True)\n    def greduce(g,op):\n        return torch.segment_reduce(g.contiguous(),op,lengths=glengths,axis=1,unsafe=True)\n    al=torch.stack([a.amin(0) for a in aa]);ah=torch.stack([a.amax(0) for a in aa])\n    bl=torch.stack([b.amin(0) for b in bb]);bh=torch.stack([b.amax(0) for b in bb])\n    ds=np.asarray(torch.linalg.vector_norm(torch.maximum(ah[:,None],bh[None])-torch.minimum(al[:,None],bl[None]),dim=2).flatten().tolist(),np.float64)\n    logs=2*np.log(ds);delta=2*np.log(.5);count=np.ceil((np.log(.1)-logs)/delta).astype(np.int64);length=count+2\n    steps=np.arange(int(length.max()))[:,None];effective=(logs+delta)-logs\n    temperatures=np.exp(logs[None,:]+(steps-1)*effective[None,:])\n    temperatures=np.where((steps>=1)&(steps<=count[None,:]),temperatures,.1);temperatures[0]=ds*ds\n    etable=torch.from_numpy(temperatures.astype(np.float32)).reshape(-1,10,10)\n    atable=torch.from_numpy(steps<length[None,:]).reshape(-1,10,10)\n    hard=(temperatures.astype(np.float32).max(1)<=256.).tolist();end=int(length.max())-3\n    C=torch.matmul(A,B.T).mul_(-1.)\n    asq=A.square().sum(2)/2;bsq=B.square().sum(1)/2\n    C.add_(asq[:,:,None]).add_(bsq[None,None,:])\n    C.masked_fill_(~amask[:,:,None],float('inf'))\n    la=(1/an.float()).log()[:,None];lb=(1/bn.float()).log()[None,None,:]\n    amean=A.sum(1)/an[:,None];bmean=torch.stack([b.mean(0) for b in bb])\n    amn=asq.sum(1)/an;bmn=torch.tensor([float(b.square().sum(1).mean()/2) for b in bb])\n    f=torch.where(amask[:,:,None],asq[:,:,None]+bmn[None,None,:]-A @ bmean.T,0.)\n    g=bsq[None,:]+amn[:,None]-amean @ B.T\n    def residual(f,g):return (C-f.index_select(2,by)).sub_(g[:,None,:])\n    def direct(f,g,eps):\n        R=residual(f,g)\n        if hard[t]:\n            ft=f+rowreduce(R,'min')-eps[:,None,:]*lb\n            gt=g+R.amin(1)-eps.index_select(1,by)*la\n            return torch.where(amask[:,:,None],ft,0.),gt,None,None,None,None\n        if t==2 and float(((f.amax(1)+greduce(g,'max'))/eps).max())<60.:\n            rm=torch.zeros((10,10))\n        else:\n            rm=rowreduce(R,'min').amin(1);R.sub_(rm.index_select(1,by)[:,None,:])\n        K=R.mul_((-1.4426950408889634/eps).index_select(1,by)[:,None,:]).exp2_()\n        rs=rowreduce(K,'sum');cs=K.sum(1)\n        check=min(float(torch.where(amask[:,:,None],rs,float('inf')).min()),float(cs.min()))\n        if check>1e-34:\n            ft=f+rm[:,None,:]-eps[:,None,:]*(rs.log()+lb)\n            gt=g+rm.index_select(1,by)-eps.index_select(1,by)*(cs.log()+la)\n            return torch.where(amask[:,:,None],ft,0.),gt,K,rm,rs,cs\n        v=-residual(f,g)/eps.index_select(1,by)[:,None,:]\n        mxr=rowreduce(v,'max');mxc=v.amax(1)\n        rr=rowreduce((v-mxr.index_select(2,by)).exp(),'sum');cc=(v-mxc[:,None,:]).exp().sum(1)\n        ft=f-eps[:,None,:]*(mxr+rr.log()+lb);gt=g-eps.index_select(1,by)*(mxc+cc.log()+la)\n        return torch.where(amask[:,:,None],ft,0.),gt,None,None,None,None\n    K=None;shift=None;rs=None;cs=None;pe=None;pa=torch.ones((10,10),dtype=torch.bool)\n    for t in range(2,end):\n        eps=etable[t];active=atable[t]\n        if K is None or hard[t]:ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        else:\n            ar=torch.where(amask[:,:,None] & pa[:,None,:],(rs/bn).sqrt(),1.).reciprocal()\n            bc=torch.where(pa.index_select(1,by),(cs/an[:,None]).sqrt(),1.).reciprocal()\n            K.mul_(ar.index_select(2,by)).mul_(bc[:,None,:])\n            q=pe/eps\n            if bool(torch.all(torch.abs(q-4.)<1e-4)):K.square_().square_()\n            else:K.pow_(q.index_select(1,by)[:,None,:])\n            shift=torch.where(pa,0.,shift)\n            rs=rowreduce(K,'sum');cs=K.sum(1)\n            check=min(float(torch.where(amask[:,:,None],rs,float('inf')).min()),float(cs.min()))\n            if check>1e-34:\n                ft=torch.where(amask[:,:,None],f+shift[:,None,:]-eps[:,None,:]*(rs.log()+lb),0.)\n                gt=g+shift.index_select(1,by)-eps.index_select(1,by)*(cs.log()+la)\n            else:ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        df=torch.where(active[:,None,:],ft-f,0.);dg=torch.where(active.index_select(1,by),gt-g,0.)\n        f.add_(df,alpha=.5);g.add_(dg,alpha=.5);pe=eps;pa=active\n    g.add_(dg,alpha=.25)\n    R=residual(f,g)\n    ft=torch.where(amask[:,:,None],f+rowreduce(R,'min')-.1*lb,0.)\n    gt=g+R.amin(1)-.1*la\n    costs=ft.sum(1)/an[:,None]+greduce(gt,'sum')/bn\n    W=np.zeros((20,20),np.float32);W[:10,10:]=costs.numpy();W[10:,:10]=W[:10,10:].T\n    return W\n\n\n'''\nfor num,name,c,h in [\n (652,'class_half_padded_segments',cl,'Pad only candidate supports; contiguous reference labels use segmented row transforms and native column reductions.'),\n (653,'class_half_padded_column_segments',cl.replace('C=torch.matmul(A,B.T).mul_(-1.)','C=torch.matmul(B[None,:,:],A.transpose(1,2)).transpose(1,2).mul_(-1.)'),'One-sided padding with column-major geometry; isolate class layout cost.')]:\n src=base[:base.index('def _label_cost')]+c+base[base.index('def _expectation'):];d=root/(str(num)+'_episode11_'+name);d.mkdir(exist_ok=True);(d/'method.py').write_text(src)\n entries.append({'name':d.name,'sha256':hashlib.sha256(src.encode()).hexdigest(),'hypothesis':h})\n(root/'episode11_round2_manifest.json').write_text(json.dumps(entries,indent=2));print(json.dumps(entries,indent=2))\nPY\npython /tmp/research_history/episode11_build_round2.py\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

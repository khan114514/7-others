re(pa.index_select(1,by),(cs/an[:,None]).sqrt(),1.).reciprocal()\n            K.mul_(ar.index_select(1,by)).mul_(bc.index_select(0,ay))\n            q=pe/eps\n            if bool(torch.all(torch.abs(q-4.)<1e-4)):K.square_().square_()\n            else:K.pow_(expand(q))\n            shift=torch.where(pa,0.,shift)\n            rs=rowreduce(K,'sum');cs=colreduce(K,'sum')\n            if min(float(rs.min()),float(cs.min()))>1e-34:\n                ft=f+shift.index_select(0,ay)-eps.index_select(0,ay)*(rs.log()+lb)\n                gt=g+shift.index_select(1,by)-eps.index_select(1,by)*(cs.log()+la)\n            else:ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        df=torch.where(active.index_select(0,ay),ft-f,0.)\n        dg=torch.where(active.index_select(1,by),gt-g,0.)\n        f.add_(df,alpha=.5);g.add_(dg,alpha=.5)\n        pe=eps;pa=active\n    g.add_(dg,alpha=.25)\n    R=residual(f,g)\n    ft=f+rowreduce(R,'min')-.1*lb\n    gt=g+colreduce(R,'min')-.1*la\n    costs=torch.segment_reduce(ft.T.contiguous(),'sum',lengths=an.expand(10,-1),axis=1,unsafe=True).T/an[:,None]\n    costs+=torch.segment_reduce(gt,'sum',lengths=bn.expand(10,-1),axis=1,unsafe=True)/bn\n    W=np.zeros((20,20),np.float32)\n    W[:10,10:]=costs.numpy();W[10:,:10]=W[:10,10:].T\n    return W\n\n\n'''\nsave(498,'torch_segment_class',base[:base.index('def _label_cost')]+seg+base[base.index('def _expectation'):],'Unpadded full empirical Torch segment reductions; same class finite schedule.')\n# Separate global scatter reductions as a controlled kernel ablation.\nscatter=seg.replace(\"return torch.segment_reduce(R.reshape(-1),op,lengths=bnr,unsafe=True).reshape(len(A),10)\",\"return torch.zeros((len(A),10)).scatter_reduce_(1,by.expand(len(A),-1),R,reduce={'min':'amin','max':'amax','sum':'sum'}[op],include_self=False)\").replace(\"return torch.segment_reduce(R.T.contiguous().reshape(-1),op,lengths=anr,unsafe=True).reshape(len(B),10).T\",\"return torch.zeros((10,len(B))).scatter_reduce_(0,ay[:,None].expand(-1,len(B)),R,reduce={'min':'amin','max':'amax','sum':'sum'}[op],include_self=False)\")\nsave(499,'torch_scatter_class',base[:base.index('def _label_cost')]+scatter+base[base.index('def _expectation'):],'Full unpadded class matrix with scatter reductions; isolate segmentation kernel.')\n# Skip the final class half row update while doing its exact column update.\nfor num,mode in [(500,'gonly'),(501,'fonly'),(502,'bothfinalonly')]:\n source=base\n old='''        if K is None or float(eps.max())<=256.:\n            ft,gt,K,shift,rs,cs=direct(f,g,eps)'''\n if mode=='gonly':new='''        if t==max(map(len,schedules))-4:\n            gt=torch.where(bmask,(C-f[:,:,None]).amin(1)-eps[:,None]*la,0.)\n            dg=torch.where(active,gt-g,0.)\n            g.add_(dg,alpha=.5)\n            break\n        if K is None or float(eps.max())<=256.:\n            ft,gt,K,shift,rs,cs=direct(f,g,eps)'''\n elif mode=='fonly':new='''        if t==max(map(len,schedules))-4:\n            ft=torch.where(amask,(C-g[:,None,:]).amin(2)-eps[:,None]*lb,0.)\n            df=torch.where(active,ft-f,0.)\n            f.add_(df,alpha=.5)\n            dg=torch.zeros_like(g)\n            break\n        if K is None or float(eps.max())<=256.:\n            ft,gt,K,shift,rs,cs=direct(f,g,eps)'''\n else:new='''        if t==max(map(len,schedules))-4:\n            ft=torch.where(amask,(C-g[:,None,:]).amin(2)-eps[:,None]*lb,0.)\n            gt=torch.where(bmask,(C-f[:,:,None]).amin(1)-eps[:,None]*la,0.)\n            df=torch.where(active,ft-f,0.);dg=torch.where(active,gt-g,0.)\n            f.add_(df,alpha=.5);g.add_(dg,alpha=.5)\n            break\n        if K is None or float(eps.max())<=256.:\n            ft,gt,K,shift,rs,cs=direct(f,g,eps)'''\n assert old in source\n source=source.replace(old,new)\n save(num,'class_last_'+mode,source,'Controlled last retained hard class stage: '+mode+'; preserved final dense transforms.')\n(root/'episode9_round1_manifest.json').write_text(json.dumps(entries,indent=2))\nprint(json.dumps(entries,indent=2))\n\"\"\"Hierarchical transport with reusable costs and explicit annealed dual solves.\"\"\"\nimport numpy as np\nimport torch\nimport ot\n\n\ndef _schedule(a, b):\n    lo = torch.minimum(a.amin(0), b.amin(0))\n    hi = torch.maximum(a.amax(0), b.amax(0))\n    diameter = float(torch.linalg.vector_norm(hi - lo))\n    return [diameter**2] + [float(np.exp(e)) for e in np.arange(2*np.log(diameter), np.log(.1), 2*np.log(.5))] + [.1]\n\n\ndef _dual(C, schedule):\n    n,m=C.shape\n    la=float(np.log(np.float32(1./n)));lb=float(np.log(np.float32(1./m)))\n    shift=0.\n    def direct(f,g,eps):\n        R=C-f[:,None];R-=g[None,:]\n        if eps<=2.:\n            return f+R.amin(1)-eps*lb,g+R.amin(0)-eps*la,None,0.,None,None\n        rm=float(R.min());R-=rm;R.mul_(-1.4426950408889634/eps).exp2_()\n        rs=R.sum(1);cs=R.sum(0)\n        if min(float(rs.min()),float(cs.min()))<=2e-22:\n            R=C-f[:,None];R-=g[None,:];R*=(-1./eps)\n            rowmax=R.amax(1);colmax=R.amax(0)\n            rr=torch.exp(R-rowmax[:,None]).sum(1);cc=torch.exp(R-colmax[None,:]).sum(0)\n            return f-eps*(rowmax+rr.log()+lb),g-eps*(colmax+cc.log()+la),None,0.,None,None\n        return f+rm-eps*(rs.log()+lb),g+rm-eps*(cs.log()+la),R,rm,rs,cs\n    f=C.mean(1);g=C.mean(0)\n    \n    K=None;rs=None;cs=None\n    pe=schedule[0]\n    point_steps=schedule[3:-3]\n    for step,eps in enumerate(point_steps):\n        last=step==len(point_steps)-1\n        if last and (K is None or eps<=2.):\n            if eps<=2.:g=(g+(C-f[:,None]).amin(0)-eps*la)*.5\n            else:g=(g-eps*(((f[:,None]-C)/eps).logsumexp(0)+la))*.5\n            break\n        if K is None or eps<=2.:\n            ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        else:\n            K.mul_((m/rs).sqrt()[:,None]).mul_((n/cs).sqrt()[None,:])\n            if abs(pe/eps-4.)<1e-5:\n                K.square_().square_()\n            else:K.pow_(pe/eps)\n            shift=0.\n            if last:\n                cs=K.sum(0)\n                if float(cs.min())>1e-34:g=(g+g+shift-eps*(cs.log()+la))*.5\n                else:g=(g-eps*(((f[:,None]-C)/eps).logsumexp(0)+la))*.5\n                break\n            rs=K.sum(1);cs=K.sum(0)\n            if min(float(rs.min()),float(cs.min()))>1e-34:\n                ft=f+shift-eps*(rs.log()+lb);gt=g+shift-eps*(cs.log()+la)\n            else:ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        f=(f+ft)*.5;g=(g+gt)*.5;pe=eps\n    return C.sub_(g[None,:]).amin(1)-.1*lb,None\n\n\ndef _class_block(aa,bb,schedules,hard,end):\n    pairs=[(a,b) for a in aa for b in bb]\n    p=len(pairs)\n    nmax=max(len(a) for a in aa);mmax=max(len(b) for b in bb)\n    A=torch.zeros((p,nmax,aa[0].shape[1]));B=torch.zeros((p,mmax,bb[0].shape[1]))\n    an=torch.tensor([len(a) for a,b in pairs]);bn=torch.tensor([len(b) for a,b in pairs])\n    for i,a in enumerate(aa):A[i*10:(i+1)*10,:len(a)]=a\n    for j,b in enumerate(bb):B[j::10,:len(b)]=b\n    C=torch.bmm(B,A.transpose(1,2)).transpose(1,2)\n    C.mul_(-1.).add_(A.square().sum(2)[:,:,None]/2).add_(B.square().sum(2)[:,None,:]/2)\n    amask = torch.arange(nmax)[None,:] < an[:,None]\n    bmask = torch.arange(mmax)[None,:] < bn[:,None]\n    C.masked_fill_(~(amask[:,:,None] & bmask[:,None,:]), float('inf'))\n    la=(1/an.float()).log()[:,None];lb=(1/bn.float()).log()[:,None]\n    def direct(f,g,eps):\n        R=(C-f[:,:,None]).sub_(g[:,None,:])\n        if use_hard:\n            ft=f+R.amin(2)-eps[:,None]*lb\n            gt=g+R.amin(1)-eps[:,None]*la\n            return torch.where(amask,ft,0.),torch.where(bmask,gt,0.),None,None,None,None\n        rm=R.amin((1,2))\n        K=R.sub_(rm[:,None,None]).mul_((-1.4426950408889634/eps)[:,None,None]).exp2_()\n        rs=K.sum(2);cs=K.sum(1)\n        check=torch.minimum(torch.where(amask,rs,float('inf')).amin(1),torch.where(bmask,cs,float('inf')).amin(1))\n        if float(check.min())>1e-34:\n            ft=f+rm[:,None]-eps[:,None]*(rs.log()+lb)\n            gt=g+rm[:,None]-eps[:,None]*(cs.log()+la)\n            return torch.where(amask,ft,0.),torch.where(bmask,gt,0.),K,rm,rs,cs\n        v=(g[:,None,:]-C)/eps[:,None,None]\n        ft=-eps[:,None]*(v.logsumexp(2)+lb)\n        v=(f[:,:,None]-C)/eps[:,None,None]\n        gt=-eps[:,None]*(v.logsumexp(1)+la)\n        return torch.where(amask,ft,0.),torch.where(bmask,gt,0.),None,None,None,None\n    amean=A.sum(1)/an[:,None];bmean=B.sum(1)/bn[:,None]\n    asq=A.square().sum(2)/2;bsq=B.square().sum(2)/2\n    f=torch.where(amask,asq+bsq.sum(1)[:,None]/bn[:,None]-(A*bmean[:,None,:]).sum(2),0.)\n    g=torch.where(bmask,bsq+asq.sum(1)[:,None]/an[:,None]-(B*amean[:,None,:]).sum(2),0.)\n    K=None;shift=None;rs=None;cs=None\n    pe=None;pa=torch.ones((p,1),dtype=torch.bool)\n    for t in range(2,end):\n        use_hard=hard[t]\n        eps=torch.tensor([z[t] if t<len(z) else .1 for z in schedules])\n        active=torch.tensor([t<len(z) for z in schedules])[:,None]\n        if K is None or use_hard:\n            ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        else:\n            ar=torch.where(amask & pa,(rs/bn[:,None]).sqrt(),1.)\n            bc=torch.where(bmask & pa,(cs/an[:,None]).sqrt(),1.)\n            K.mul_(ar.reciprocal()[:,:,None]).mul_(bc.reciprocal()[:,None,:])\n            q=pe/eps\n            if bool(torch.all(torch.abs(q-4.)<1e-4)):K.square_().square_()\n            else:K.pow_(q[:,None,None])\n            shift=torch.where(pa[:,0],0.,shift)\n            rs=K.sum(2);cs=K.sum(1)\n            check=torch.minimum(torch.where(amask,rs,float('inf')).amin(1),torch.where(bmask,cs,float('inf')).amin(1))\n            if float(check.min())>1e-34:\n                ft=f+shift[:,None]-eps[:,None]*(rs.log()+lb)\n                gt=g+shift[:,None]-eps[:,None]*(cs.log()+la)\n                ft=torch.where(amask,ft,0.);gt=torch.where(bmask,gt,0.)\n            else:ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        df=torch.where(active,ft-f,0.)\n        dg=torch.where(active,gt-g,0.)\n        f.add_(df,alpha=.5)\n        g.add_(dg,alpha=.5)\n        pe=eps;pa=active\n    g.add_(dg,alpha=0.25)\n    C.sub_(f[:,:,None]).sub_(g[:,None,:])\n    ft=torch.where(amask,f+C.amin(2)-.1*lb,0.)\n    gt=torch.where(bmask,g+C.amin(1)-.1*la,0.)\n    costs=(ft/an[:,None]).sum(1)+(gt/bn[:,None]).sum(1)\n    return costs\n\n\ndef _label_cost(x,y,r,ry):\n    aa=[torch.from_numpy(x[y==i]) for i in range(10)]\n    bb=[torch.from_numpy(r[ry==j]) for j in range(10)]\n    al=torch.stack([a.amin(0) for a in aa]);ah=torch.stack([a.amax(0) for a in aa])\n    bl=torch.stack([b.amin(0) for b in bb]);bh=torch.stack([b.amax(0) for b in bb])\n    diam=torch.linalg.vector_norm(torch.maximum(ah[:,None,:],bh[None,:,:])-torch.minimum(al[:,None,:],bl[None,:,:]),dim=2).flatten().tolist()\n    schedules=[[d*d]+[float(np.exp(e)) for e in np.arange(2*np.log(d),np.log(.1),2*np.log(.5))]+[.1] for d in diam]\n    end=max(map(len,schedules))-3\n    hard=[max(z[t] if t<len(z) else .1 for z in schedules)<=256. for t in range(end)]\n    order=np.argsort([len(a) for a in aa],kind='stable')\n    groups=(2 if max(map(len,aa))>1.2*np.mean(list(map(len,aa))) else 1)\n    W=np.zeros((20,20),np.float32)\n    for ids in np.array_split(order,groups):\n        costs=_class_block([aa[i] for i in ids],bb,[schedules[i*10+j] for i in ids for j in range(10)],hard,end)\n        W[ids,10:]=costs.numpy().reshape(len(ids),10)\n    W[10:,:10]=W[:10,10:].T\n    return W\n\n\ndef _expectation(C):\n    n,m=C.shape\n    K=(C*(-14.426950408889634/float(C.max()))).exp2_()\n    K.mul_(((1./m)/K.sum(0))[None,:])\n    K.mul_(((1./n)/K.sum(1))[:,None])\n    ratio=(2.-m*K.sum(0)).clamp_(min=.01)\n    K.mul_(ratio[None,:])\n    rowmass=K.sum(1)\n    energy=K.mul_(C).sum(1)\n    return float((energy/rowmass).mean())\n\n\ndef _outer(batchcost):\n    n,m=batchcost.shape\n    cost=batchcost/max(float(batchcost.max()),1e-12)\n    if m!=2:\n        return ot.sinkhorn(ot.unif(n),ot.unif(m),cost,.01,numItermax=10000,stopThr=1e-10)\n    d=(cost[:,1]-cost[:,0])/.01\n    lo=-float(d.max())-40.;hi=-float(d.min())+40.\n    z=-float(d.mean())\n    for it in range(50):\n        s=1./(1.+np.exp(-np.clip(d+z,-700.,700.)))\n        err=float(s.mean())-.5\n        if abs(err)<1e-13:break\n        if err>0.:hi=z\n        else:lo=z\n        deriv=float((s*(1.-s)).mean())\n        next_z=z-err/max(deriv,1e-30)\n        z=next_z if lo<next_z<hi else (lo+hi)/2.\n    return np.column_stack((s,1.-s))/n\n\n\ndef value(x, y, r, ry, seed=17, batch_size=1024):\n    torch.set_flush_denormal(True)\n    torch.set_num_threads(2)\n    x=np.asarray(x,np.float32); r=np.asarray(r,np.float32)\n    y=np.asarray(y,np.int64); ry=np.asarray(ry,np.int64)\n    tx=[np.arange(i,min(i+batch_size,len(x))) for i in range(0,len(x),batch_size)]\n    tr=[np.arange(i,min(i+batch_size,len(r))) for i in range(0,len(r),batch_size)]\n    with torch.inference_mode():\n        W=_label_cost(x[tx[0]],y[tx[0]],r[tr[0]],ry[tr[0]])\n        WL=W[:10,10:].copy()/2\n        X=torch.from_numpy(x);R=torch.from_numpy(r)\n        xn=(X*X).sum(1)/2;rn=(R*R).sum(1)/2\n        F={}; batchcost=np.zeros((len(tx),len(tr)))\n        for i,idx in enumerate(tx):\n            for j,jdx in enumerate(tr):\n                a=x[idx]; b=r[jdx]\n                aa=X[i*batch_size:i*batch_size+len(idx)];bb=R[j*batch_size:j*batch_size+len(jdx)]\n                T=aa @ bb.T\n                T.mul_(-1.).add_(xn[i*batch_size:i*batch_size+len(idx),None]).add_(rn[None,j*batch_size:j*batch_size+len(jdx)])\n                T.add_(torch.from_numpy(np.take(WL[y[idx]],ry[jdx],axis=1)))\n                batchcost[i,j]=_expectation(T)/(len(idx)+len(jdx))\n                # Reuse the same empirical geometry for coupling and point potentials.\n                lo=np.minimum(a.min(0),b.min(0));hi=np.maximum(a.max(0),b.max(0))\n                yl=int(y[idx].min());yh=int(y[idx].max());rl=int(ry[jdx].min())+10;rh=int(ry[jdx].max())+10\n                d2=float(np.sum((hi-lo)**2)) + float((max(yh,rh)-min(yl,rl))**2)\n                diameter=np.sqrt(d2)\n                schedule=[diameter**2]+[float(np.exp(e)) for e in np.arange(2*np.log(diameter),np.log(.1),2*np.log(.5))]+[.1]\n                f,_=_dual(T,schedule)\n                f=f.numpy().ravel().astype(float)\n                F[i,j]=(f-f.mean())*len(f)/(len(f)-1)\n    Q=_outer(batchcost)\n    values=np.zeros(len(x))\n    for i,idx in enumerate(tx): values[idx]=sum(Q[i,j]*F[i,j] for j in range(len(tr)))\n    return values\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_19", "type": "command_execution", "command": "/bin/sh -lc 'tail -n 40 /tmp/research_history/episode_9_continuing_notes.md'", "aggregated_output": "| 554_episode9_shared_coupling_cancel_gemm_columns | 0.037601041732220133 | 0.92789754637728683 | a73d8c270d13c6defb541b70facabbcf7f909dd3911b6a774e200d531691823d |\n| 564_episode9_coupling_lowrank_cost_energy_label_fields | 0.061441357034103326 | 0.88218218453581054 | cec185be3b526a4ac4beb2d90522f8f89d08d13022ae21f1ccdac22f06d9ee73 |\n\nAll reports passed all 30 cases. Original evaluator stdout and reports are archived unchanged inside each source directory. No own numerical work ran concurrently with official evaluations. The baseline repeat497 used exactly the saved432 source.\n\n## Retained mechanisms and numerical recipe\n\nAll empirical supports, contiguous1024 point batches, class/point finite annealing, late class extrapolation, and the linearized second coupling column refinement remain derived from supplied arrays. No learned parameters, output tables or input caches are used.\n\n547 combines column-major class geometry (batched matrix product with reversed physical axes), in-place distance assembly, vectorized annealing schedules/active flags, guarded initial soft-kernel shift removal, shared analytic point initialization, and exact final point column-factor cancellation in vector logarithms. Schedule construction uses the effective np.arange step `(start+delta)-start` and float32 temperatures. The initial unshifted exponential is allowed only when `(max(f)+max(g))/epsilon<60`; positive-support checks retain stable dense fallbacks.\n\n554 adds exact first coupling row-scale cancellation. Let K=exp(-10*C/max(C)), v=1/(m*column_sum(K)), u=1/(n*(K @ v)), and w=v*clamp(2-m*v*(K.T @ u),.01). The exact current expectation equals mean(((K*C) @ w)/(K @ w)), because the first row factor cancels in final row normalization. Two-dimensional right operands invoke faster GEMM kernels; bare GEMV and single-batch BMM were much slower. Full derivation is in episode9_coupling_cancellation_derivation.md.\n\n564 computes the same numerator using the exact low-rank cost factors. One 22-column response holds weighted mass, reference squared norm, ten feature coordinates and ten label-cost fields. Energy is candidate_norm*mass + reference_norm_response - candidate dot feature_response + observed_label_response. The kernel and supports stay exact; only float32 reduction order changes. Its final complete official result was raw 0.061441357034103326, score 0.8821821845358105. It passes quality but is slower, so it is rejected; source 554 remains selected.\n\n## Hypotheses and controlled ablations\n\n- **498/499, unpadded Torch segmented/scatter class reductions:** all 30 pass with base accuracy. Means0.0608/0.0719 seconds are slower; reject for speed. Prior segmented NumPy failures were already covered in episodes4/6.\n- **500–502, final retained class stage:** g-only fails one case (worst0.010111); f-only fails five (0.012131). Separate exact transforms on both sides pass but have no established speed gain. Initial pre-screen padding-mask mistakes are preserved as method_initial.py and initial builder; corrected measured sources retain valid masks.\n- **503–507/512, initial scalar shift removal and gauge controls:** all 30 pass. Recentered point costs506 and virtual cached class507 also pass, with507 worst0.007261. Guard512 preserves fallback outside the high-temperature bound. Freshround1/2/3 favored512 at times, but it was not retained without complete official measurement.\n- **508–511/520–524, twenty unique supports and setup combinations:** packed global geometry, unique means/norms, repeated bmm geometry and in-place class assembly all pass. One class first-cumulant stage passes with worst0.007173; two first-cumulant stages525 fail11 cases (0.013614). Unique setup is not consistently faster than original means.\n- **513–519, physical layout and row energy controls:** point column-major variants pass but are not compelling. Class column-major515 passed official raw 0.0400488, better than today’s baseline repeat but slower than historical best 432. Row energy einsum/bmm/vecdot are accurate but slower.\n- **526–529, direct support-size buckets:** all 30 pass while preserving global class hard-switch and ending stage. Building geometry directly per bucket avoids the previous full-pad-then-crop setup, but repeated dispatch loses the hoped-for gain.\n- **530–536/543–547, exact layout/schedule/initialization combinations:** all 30 pass. Vectorized schedule534 matches515 quality at printed precision. Freshround2 selected547; its official raw 0.0385948 became the first new best.\n- **537–542, cached empirical point variance and budget reallocation:** restoring an earlier coarse point update with exact variance statistics improves worst nRMSE  to0.006117. Hard8/16 variants pass0.008646. Pointlate4 fails22, hard8late4 fails13. Classlate4 variant542 passes0.008906 but statistics and extra work remain slower; reject for speed.\n- **548–558, exact coupling cancellation and kernel dispatch:** all 30 pass. Bare GEMV548–552 was very slow and variable. Two-dimensional GEMM 553–555 restores speed; shared554 passes official raw 0.0376010 and becomes new best. Single-batch BMM556/557 and hybrid558 are slower.\n- **559–561, actual column-major coupling storage:** all 30 pass, but fresh medians0.0496/0.0531 lose to5540.0426. A stride diagnostic showed transpose-only555 keeps original row-major strides; preserve it as a unary-expression control, not a physical layout change. Explicit `empty((m,n)).T` plus out= creates the real column layout.\n- **562–564, exact low-rank cost energy:** all 30 pass with worst nRMSE 0.00702565–0.00702570. One 22-column GEMM is faster than splitting 12+10. Freshround5 medians5540.042632,5620.042365,5640.041586 justified one final complete official564 evaluation.\n\n## Validation, artifacts and continuation\n\nSynthetic checks use18 permutations of public arrays (two public seeds, three settings, three independent permutations), with canonical targets freshly computed by saved initial source 000. Sources432/547/512/554/555 all pass18 with worst nRMSE  about0.00851313, minimumrho0.99995404 and top overlap 0.994667. 564 also passes18, with its original records in episode9_energy_shuffle_stress.json. These are diagnostics, not protected targets or evaluator scores; no tuning was done against them.\n\n- **68 source snapshots**, **67 complete all 30 local screens**, **62 valid sources**, **5 failed sources**, and **5 complete official evaluations**.\n- Builders1–13, manifests, per-case screenJSON/logs, five alternating fresh-process benchmark rounds, stress scripts/results, starting/final profiles, failed sources and original reports remain in `/tmp/research_history`.\n- episode_9_index.json contains every source/hash and local/official evidence; episode9_official_summary.json and episode_9_final_selection.json preserve exact source selection. Run `python /tmp/research_history/episode9_index.py --restore` to reproduce best-source restoration.\n- A final profile excludes NPZ reads by loading all arguments before timing. It measured 0.128227 seconds (point dual 0.058, class 0.021, coupling 0.020), much slower than the formal aggregate. This is diagnostic only; no formal score should be inferred from it. Point kernel operations remain a major cost.\n- Next research should begin from the selected exact source and profile it. Kernel dispatch, matrix layout and cost-energy factorization are productive exact mechanisms. More aggressive finite-schedule truncation, frozen class graphs, Gaussian class geometry, generic grouping and polynomial coupling already have extensive failures or slow controls in prior notes. Read those summaries before revisiting them.\n\nNo protected assets, evaluator code, protected targets, private cases, credentials, environment variables, other trajectories, network, external packages or subagents were accessed. Only method.py changed in the submission. Frozen solve.sh remains byte-identical, and the submission directory contains exactly these two ordinary files; pre-existing protected infrastructure directories are untouched.\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_20", "type": "command_execution", "command": "/bin/sh -lc 'cat /tmp/research_history/498_episode9_torch_segment_class/method.py'", "aggregated_output": "\"\"\"Hierarchical transport with reusable costs and explicit annealed dual solves.\"\"\"\nimport numpy as np\nimport torch\nimport ot\n\n\ndef _schedule(a, b):\n    lo = torch.minimum(a.amin(0), b.amin(0))\n    hi = torch.maximum(a.amax(0), b.amax(0))\n    diameter = float(torch.linalg.vector_norm(hi - lo))\n    return [diameter**2] + [float(np.exp(e)) for e in np.arange(2*np.log(diameter), np.log(.1), 2*np.log(.5))] + [.1]\n\n\ndef _dual(C, schedule):\n    n,m=C.shape\n    la=float(np.log(np.float32(1./n)));lb=float(np.log(np.float32(1./m)))\n    shift=0.\n    def direct(f,g,eps):\n        R=C-f[:,None];R-=g[None,:]\n        if eps<=2.:\n            return f+R.amin(1)-eps*lb,g+R.amin(0)-eps*la,None,0.,None,None\n        rm=float(R.min());R-=rm;R.mul_(-1.4426950408889634/eps).exp2_()\n        rs=R.sum(1);cs=R.sum(0)\n        if min(float(rs.min()),float(cs.min()))<=2e-22:\n            R=C-f[:,None];R-=g[None,:];R*=(-1./eps)\n            rowmax=R.amax(1);colmax=R.amax(0)\n            rr=torch.exp(R-rowmax[:,None]).sum(1);cc=torch.exp(R-colmax[None,:]).sum(0)\n            return f-eps*(rowmax+rr.log()+lb),g-eps*(colmax+cc.log()+la),None,0.,None,None\n        return f+rm-eps*(rs.log()+lb),g+rm-eps*(cs.log()+la),R,rm,rs,cs\n    f=C.mean(1);g=C.mean(0)\n    \n    K=None;rs=None;cs=None\n    pe=schedule[0]\n    point_steps=schedule[3:-3]\n    for step,eps in enumerate(point_steps):\n        last=step==len(point_steps)-1\n        if last and (K is None or eps<=2.):\n            if eps<=2.:g=(g+(C-f[:,None]).amin(0)-eps*la)*.5\n            else:g=(g-eps*(((f[:,None]-C)/eps).logsumexp(0)+la))*.5\n            break\n        if K is None or eps<=2.:\n            ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        else:\n            K.mul_((m/rs).sqrt()[:,None]).mul_((n/cs).sqrt()[None,:])\n            if abs(pe/eps-4.)<1e-5:\n                K.square_().square_()\n            else:K.pow_(pe/eps)\n            shift=0.\n            if last:\n                cs=K.sum(0)\n                if float(cs.min())>1e-34:g=(g+g+shift-eps*(cs.log()+la))*.5\n                else:g=(g-eps*(((f[:,None]-C)/eps).logsumexp(0)+la))*.5\n                break\n            rs=K.sum(1);cs=K.sum(0)\n            if min(float(rs.min()),float(cs.min()))>1e-34:\n                ft=f+shift-eps*(rs.log()+lb);gt=g+shift-eps*(cs.log()+la)\n            else:ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        f=(f+ft)*.5;g=(g+gt)*.5;pe=eps\n    return C.sub_(g[None,:]).amin(1)-.1*lb,None\n\n\ndef _label_cost(x,y,r,ry):\n    ix=np.argsort(y,kind='stable');ir=np.argsort(ry,kind='stable')\n    A=torch.from_numpy(x[ix]);B=torch.from_numpy(r[ir])\n    ay=torch.from_numpy(y[ix]);by=torch.from_numpy(ry[ir])\n    an=torch.bincount(ay,minlength=10);bn=torch.bincount(by,minlength=10)\n    aa=[A[ay==i] for i in range(10)];bb=[B[by==j] for j in range(10)]\n    al=torch.stack([a.amin(0) for a in aa]);ah=torch.stack([a.amax(0) for a in aa])\n    bl=torch.stack([b.amin(0) for b in bb]);bh=torch.stack([b.amax(0) for b in bb])\n    diam=torch.linalg.vector_norm(torch.maximum(ah[:,None,:],bh[None,:,:])-torch.minimum(al[:,None,:],bl[None,:,:]),dim=2).flatten().tolist()\n    schedules=[[d*d]+[float(np.exp(e)) for e in np.arange(2*np.log(d),np.log(.1),2*np.log(.5))]+[.1] for d in diam]\n    C=((A*A).sum(1)[:,None]-2*(A @ B.T)+(B*B).sum(1)[None,:])/2\n    anr=an.repeat(len(B));bnr=bn.repeat(len(A))\n    def rowreduce(R,op):\n        return torch.segment_reduce(R.reshape(-1),op,lengths=bnr,unsafe=True).reshape(len(A),10)\n    def colreduce(R,op):\n        return torch.segment_reduce(R.T.contiguous().reshape(-1),op,lengths=anr,unsafe=True).reshape(len(B),10).T\n    def expand(v):return v.index_select(0,ay).index_select(1,by)\n    def residual(f,g):return C-f.index_select(1,by)-g.index_select(0,ay)\n    la=(1/an.float()).log()[:,None];lb=(1/bn.float()).log()[None,:]\n    amean=torch.stack([a.mean(0) for a in aa]);bmean=torch.stack([b.mean(0) for b in bb])\n    asq=(A*A).sum(1)/2;bsq=(B*B).sum(1)/2\n    amn=torch.stack([asq[ay==i].mean() for i in range(10)]);bmn=torch.stack([bsq[by==j].mean() for j in range(10)])\n    f=asq[:,None]+bmn[None,:]-A @ bmean.T\n    g=bsq[None,:]+amn[:,None]-amean @ B.T\n    def direct(f,g,eps):\n        R=residual(f,g)\n        if float(eps.max())<=256.:\n            ft=f+rowreduce(R,'min')-eps.index_select(0,ay)*lb\n            gt=g+colreduce(R,'min')-eps.index_select(1,by)*la\n            return ft,gt,None,None,None,None\n        rm=torch.segment_reduce(rowreduce(R,'min').T.contiguous(), 'min',lengths=an.expand(10,-1),axis=1,unsafe=True).T\n        K=R.sub_(expand(rm)).mul_(expand(-1.4426950408889634/eps)).exp2_()\n        rs=rowreduce(K,'sum');cs=colreduce(K,'sum')\n        if min(float(rs.min()),float(cs.min()))>1e-34:\n            ft=f+rm.index_select(0,ay)-eps.index_select(0,ay)*(rs.log()+lb)\n            gt=g+rm.index_select(1,by)-eps.index_select(1,by)*(cs.log()+la)\n            return ft,gt,K,rm,rs,cs\n        v=-residual(f,g)/expand(eps)\n        mxr=rowreduce(v,'max');mxc=colreduce(v,'max')\n        rr=rowreduce((v-mxr.index_select(1,by)).exp(),'sum')\n        cc=colreduce((v-mxc.index_select(0,ay)).exp(),'sum')\n        return f-eps.index_select(0,ay)*(mxr+rr.log()+lb),g-eps.index_select(1,by)*(mxc+cc.log()+la),None,None,None,None\n    K=None;shift=None;rs=None;cs=None;pe=None;pa=torch.ones((10,10),dtype=torch.bool)\n    for t in range(2,max(map(len,schedules))-3):\n        eps=torch.tensor([z[t] if t<len(z) else .1 for z in schedules]).reshape(10,10)\n        active=torch.tensor([t<len(z) for z in schedules]).reshape(10,10)\n        if K is None or float(eps.max())<=256.:\n            ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        else:\n            ar=torch.where(pa.index_select(0,ay),(rs/bn).sqrt(),1.).reciprocal()\n            bc=torch.where(pa.index_select(1,by),(cs/an[:,None]).sqrt(),1.).reciprocal()\n            K.mul_(ar.index_select(1,by)).mul_(bc.index_select(0,ay))\n            q=pe/eps\n            if bool(torch.all(torch.abs(q-4.)<1e-4)):K.square_().square_()\n            else:K.pow_(expand(q))\n            shift=torch.where(pa,0.,shift)\n            rs=rowreduce(K,'sum');cs=colreduce(K,'sum')\n            if min(float(rs.min()),float(cs.min()))>1e-34:\n                ft=f+shift.index_select(0,ay)-eps.index_select(0,ay)*(rs.log()+lb)\n                gt=g+shift.index_select(1,by)-eps.index_select(1,by)*(cs.log()+la)\n            else:ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        df=torch.where(active.index_select(0,ay),ft-f,0.)\n        dg=torch.where(active.index_select(1,by),gt-g,0.)\n        f.add_(df,alpha=.5);g.add_(dg,alpha=.5)\n        pe=eps;pa=active\n    g.add_(dg,alpha=.25)\n    R=residual(f,g)\n    ft=f+rowreduce(R,'min')-.1*lb\n    gt=g+colreduce(R,'min')-.1*la\n    costs=torch.segment_reduce(ft.T.contiguous(),'sum',lengths=an.expand(10,-1),axis=1,unsafe=True).T/an[:,None]\n    costs+=torch.segment_reduce(gt,'sum',lengths=bn.expand(10,-1),axis=1,unsafe=True)/bn\n    W=np.zeros((20,20),np.float32)\n    W[:10,10:]=costs.numpy();W[10:,:10]=W[:10,10:].T\n    return W\n\n\ndef _expectation(C):\n    n,m=C.shape\n    K=(C*(-14.426950408889634/float(C.max()))).exp2_()\n    K.mul_(((1./m)/K.sum(0))[None,:])\n    K.mul_(((1./n)/K.sum(1))[:,None])\n    ratio=(2.-m*K.sum(0)).clamp_(min=.01)\n    K.mul_(ratio[None,:])\n    rowmass=K.sum(1)\n    energy=K.mul_(C).sum(1)\n    return float((energy/rowmass).mean())\n\n\ndef _outer(batchcost):\n    n,m=batchcost.shape\n    cost=batchcost/max(float(batchcost.max()),1e-12)\n    if m!=2:\n        return ot.sinkhorn(ot.unif(n),ot.unif(m),cost,.01,numItermax=10000,stopThr=1e-10)\n    d=(cost[:,1]-cost[:,0])/.01\n    lo=-float(d.max())-40.;hi=-float(d.min())+40.\n    z=-float(d.mean())\n    for it in range(50):\n        s=1./(1.+np.exp(-np.clip(d+z,-700.,700.)))\n        err=float(s.mean())-.5\n        if abs(err)<1e-13:break\n        if err>0.:hi=z\n        else:lo=z\n        deriv=float((s*(1.-s)).mean())\n        next_z=z-err/max(deriv,1e-30)\n        z=next_z if lo<next_z<hi else (lo+hi)/2.\n    return np.column_stack((s,1.-s))/n\n\n\ndef value(x, y, r, ry, seed=17, batch_size=1024):\n    torch.set_flush_denormal(True)\n    torch.set_num_threads(2)\n    x=np.asarray(x,np.float32); r=np.asarray(r,np.float32)\n    y=np.asarray(y,np.int64); ry=np.asarray(ry,np.int64)\n    tx=[np.arange(i,min(i+batch_size,len(x))) for i in range(0,len(x),batch_size)]\n    tr=[np.arange(i,min(i+batch_size,len(r))) for i in range(0,len(r),batch_size)]\n    with torch.inference_mode():\n        W=_label_cost(x[tx[0]],y[tx[0]],r[tr[0]],ry[tr[0]])\n        WL=W[:10,10:].copy()/2\n        X=torch.from_numpy(x);R=torch.from_numpy(r)\n        xn=(X*X).sum(1)/2;rn=(R*R).sum(1)/2\n        F={}; batchcost=np.zeros((len(tx),len(tr)))\n        for i,idx in enumerate(tx):\n            for j,jdx in enumerate(tr):\n                a=x[idx]; b=r[jdx]\n                aa=X[i*batch_size:i*batch_size+len(idx)];bb=R[j*batch_size:j*batch_size+len(jdx)]\n                T=aa @ bb.T\n                T.mul_(-1.).add_(xn[i*batch_size:i*batch_size+len(idx),None]).add_(rn[None,j*batch_size:j*batch_size+len(jdx)])\n                T.add_(torch.from_numpy(np.take(WL[y[idx]],ry[jdx],axis=1)))\n                batchcost[i,j]=_expectation(T)/(len(idx)+len(jdx))\n                # Reuse the same empirical geometry for coupling and point potentials.\n                lo=np.minimum(a.min(0),b.min(0));hi=np.maximum(a.max(0),b.max(0))\n                yl=int(y[idx].min());yh=int(y[idx].max());rl=int(ry[jdx].min())+10;rh=int(ry[jdx].max())+10\n                d2=float(np.sum((hi-lo)**2)) + float((max(yh,rh)-min(yl,rl))**2)\n                diameter=np.sqrt(d2)\n                schedule=[diameter**2]+[float(np.exp(e)) for e in np.arange(2*np.log(diameter),np.log(.1),2*np.log(.5))]+[.1]\n                f,_=_dual(T,schedule)\n                f=f.numpy().ravel().astype(float)\n                F[i,j]=(f-f.mean())*len(f)/(len(f)-1)\n    Q=_outer(batchcost)\n    values=np.zeros(len(x))\n    for i,idx in enumerate(tx): values[idx]=sum(Q[i,j]*F[i,j] for j in range(len(tr)))\n    return values\n", "exit_code": 0, "status": "completed"}}

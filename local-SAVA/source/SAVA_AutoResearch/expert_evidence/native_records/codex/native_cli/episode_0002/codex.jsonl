{"type": "item.started", "item": {"id": "item_30", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/research_history/batched_point_impl.txt <<'PY'\ndef _batch_dual(matrices, schedules):\n    p=len(matrices)\n    an=torch.tensor([c.shape[0] for c in matrices])\n    bn=torch.tensor([c.shape[1] for c in matrices])\n    n=int(an.max());m=int(bn.max())\n    C=torch.full((p,n,m),float('inf'))\n    for k,c in enumerate(matrices):C[k,:len(c),:c.shape[1]]=c\n    amask=torch.arange(n)[None,:]<an[:,None]\n    bmask=torch.arange(m)[None,:]<bn[:,None]\n    la=(1/an.float()).log()[:,None];lb=(1/bn.float()).log()[:,None]\n    cmin=C.amin((1,2))\n    span=torch.where(torch.isfinite(C),C,0.).amax((1,2))-cmin\n    base=cmin[:,None,None]-C\n    kernel=None;kernel_eps=None\n    def transforms(f,g,eps):\n        nonlocal kernel,kernel_eps\n        if bool((eps>8.).all()) and bool((span/eps<60.).all()):\n            if kernel_eps is None or not torch.equal(eps,kernel_eps):\n                kernel=torch.exp(base/eps[:,None,None]);kernel_eps=eps\n            fm=f.amax(1);gm=g.amax(1)\n            fv=torch.exp((f-fm[:,None])/eps[:,None])*amask\n            gv=torch.exp((g-gm[:,None])/eps[:,None])*bmask\n            ft=cmin[:,None]-gm[:,None]-eps[:,None]*(torch.bmm(kernel,gv[:,:,None]).squeeze(2).log()+lb)\n            gt=cmin[:,None]-fm[:,None]-eps[:,None]*(torch.bmm(kernel.transpose(1,2),fv[:,:,None]).squeeze(2).log()+la)\n            return torch.where(amask,ft,0.),torch.where(bmask,gt,0.)\n        R=C-f[:,:,None]-g[:,None,:]\n        if bool((eps<=8.).all()):\n            ft=f+R.amin(2)-eps[:,None]*lb\n            gt=g+R.amin(1)-eps[:,None]*la\n            return torch.where(amask,ft,0.),torch.where(bmask,gt,0.)\n        rm=R.amin((1,2))\n        K=((rm[:,None,None]-R)/eps[:,None,None]).clamp_(min=-80.).exp_()\n        rs=K.sum(2);cs=K.sum(1)\n        check=torch.minimum(torch.where(amask,rs,float('inf')).amin(1),torch.where(bmask,cs,float('inf')).amin(1))\n        if float(check.min())>2e-22:\n            ft=f+rm[:,None]-eps[:,None]*(rs.log()+lb)\n            gt=g+rm[:,None]-eps[:,None]*(cs.log()+la)\n        else:\n            Z=-R/eps[:,None,None]\n            ft=f-eps[:,None]*(Z.logsumexp(2)+lb)\n            gt=g-eps[:,None]*(Z.logsumexp(1)+la)\n        low=eps[:,None]<=8.\n        if bool(low.any()):\n            ft=torch.where(low,f+R.amin(2)-eps[:,None]*lb,ft)\n            gt=torch.where(low,g+R.amin(1)-eps[:,None]*la,gt)\n        return torch.where(amask,ft,0.),torch.where(bmask,gt,0.)\n    eps=torch.tensor([s[0] for s in schedules])\n    f,g=transforms(torch.zeros((p,n)),torch.zeros((p,m)),eps)\n    for t in range(max(map(len,schedules))):\n        eps=torch.tensor([s[t] if t<len(s) else .1 for s in schedules])\n        active=torch.tensor([t<len(s) for s in schedules])[:,None]\n        ft,gt=transforms(f,g,eps)\n        f=torch.where(active,(f+ft)*.5,f);g=torch.where(active,(g+gt)*.5,g)\n    ft=(C-g[:,None,:]).amin(2)-.1*lb\n    return [ft[k,:int(an[k])].numpy().astype(float) for k in range(p)]\n\n\ndef value(x, y, r, ry, seed=17, batch_size=1024):\n    torch.set_num_threads(2)\n    x=np.asarray(x,np.float32);r=np.asarray(r,np.float32)\n    y=np.asarray(y,np.int64);ry=np.asarray(ry,np.int64)\n    tx=[np.arange(i,min(i+batch_size,len(x))) for i in range(0,len(x),batch_size)]\n    tr=[np.arange(i,min(i+batch_size,len(r))) for i in range(0,len(r),batch_size)]\n    with torch.inference_mode():\n        W=_label_cost(x[tx[0]],y[tx[0]],r[tr[0]],ry[tr[0]])\n        tw=torch.from_numpy(W)\n        batchcost=np.zeros((len(tx),len(tr)))\n        pairs=[];costs=[];schedules=[]\n        for i,idx in enumerate(tx):\n            for j,jdx in enumerate(tr):\n                a=torch.from_numpy(x[idx]);b=torch.from_numpy(r[jdx])\n                C=(a.square().sum(1)[:,None]+b.square().sum(1)[None,:])/2-a @ b.T\n                C+=tw[y[idx,None],ry[jdx][None,:]+10]/2\n                batchcost[i,j]=_expectation(C)/(len(idx)+len(jdx))\n                z1=torch.tensor(np.column_stack([x[idx],y[idx]]),dtype=torch.float32)\n                z2=torch.tensor(np.column_stack([r[jdx],ry[jdx]+10]),dtype=torch.float32)\n                pairs.append((i,j));costs.append(C);schedules.append(_schedule(z1,z2))\n        F={}\n        for k in range(0,len(pairs),2):\n            potentials=_batch_dual(costs[k:k+2],schedules[k:k+2])\n            for pair,f in zip(pairs[k:k+2],potentials):F[pair]=(f-f.mean())*len(f)/(len(f)-1)\n    Q=ot.sinkhorn(ot.unif(len(tx)),ot.unif(len(tr)),batchcost/max(float(batchcost.max()),1e-12),.01,numItermax=10000,stopThr=1e-10)\n    values=np.zeros(len(x))\n    for i,idx in enumerate(tx):values[idx]=sum(Q[i,j]*F[i,j] for j in range(len(tr)))\n    return values\nPY\npython - <<'PY'\nfrom pathlib import Path\nbase=Path('/tmp/research_history/050_no_point_transpose/method.py').read_text()\nhelper=Path('/tmp/research_history/batched_point_impl.txt').read_text()\ntext=base[:base.index('def value(')]+helper\nfor name,src in [('053_group_point_2',text),('054_group_point_6',text.replace('range(0,len(pairs),2)','range(0,len(pairs),6)').replace('k:k+2','k:k+6'))]:\n d=Path('/tmp/research_history')/name;d.mkdir(exist_ok=True);(d/'method.py').write_text(src)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

{"type": "item.started", "item": {"id": "item_68", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/research_history/numpy_shared_point.txt <<'PY'\ndef _dual(C, schedule):\n    C=C.numpy()\n    n,m=C.shape\n    la=float(np.log(np.float32(1./n)));lb=float(np.log(np.float32(1./m)))\n    def transforms(f,g,eps):\n        R=np.subtract(C,f[:,None]);R-=g[None,:]\n        if eps<=2.:\n            return f+R.min(1)-eps*lb,g+R.min(0)-eps*la\n        rm=float(R.min())\n        R-=rm;R*=(-1./eps)\n        np.maximum(R,-80.,out=R);np.exp(R,out=R)\n        rs=R.sum(1);cs=R.sum(0)\n        if min(float(rs.min()),float(cs.min()))>2e-22:\n            return f+rm-eps*(np.log(rs)+lb),g+rm-eps*(np.log(cs)+la)\n        R=np.subtract(C,f[:,None]);R-=g[None,:];R*=(-1./eps)\n        rowmax=R.max(1);colmax=R.max(0)\n        rs=np.exp(R-rowmax[:,None]).sum(1)\n        cs=np.exp(R-colmax[None,:]).sum(0)\n        return f-eps*(rowmax+np.log(rs)+lb),g-eps*(colmax+np.log(cs)+la)\n    f,g=transforms(np.zeros(n,np.float32),np.zeros(m,np.float32),schedule[0])\n    for eps in schedule[2:-3]:\n        ft,gt=transforms(f,g,eps)\n        f=(f+ft)*.5;g=(g+gt)*.5\n    return torch.from_numpy((C-g[None,:]).min(1)-.1*lb),None\n\n\nPY\npython - <<'PY'\nfrom pathlib import Path\nbase=Path('/tmp/research_history/075_scalar_outer/method.py').read_text()\ntext=base[:base.index('def _dual(')]+Path('/tmp/research_history/numpy_shared_point.txt').read_text()+base[base.index('def _label_cost('):]\nd=Path('/tmp/research_history/076_numpy_shared_point');d.mkdir(exist_ok=True);(d/'method.py').write_text(text)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

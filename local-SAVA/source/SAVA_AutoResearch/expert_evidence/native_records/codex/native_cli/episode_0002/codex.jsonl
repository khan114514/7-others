{"type": "item.started", "item": {"id": "item_73", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/research_history/numpy_shared_label.txt <<'PY'\n    C=C.numpy()\n    an=an.numpy().astype(np.float32);bn=bn.numpy().astype(np.float32)\n    amask=amask.numpy();bmask=bmask.numpy()\n    la=np.log(1./an)[:,None];lb=np.log(1./bn)[:,None]\n    def transforms(f,g,eps):\n        R=np.subtract(C,f[:,:,None]);R-=g[:,None,:]\n        if float(eps.max())<=8.:\n            ft=f+R.min(2)-eps[:,None]*lb\n            gt=g+R.min(1)-eps[:,None]*la\n            return np.where(amask,ft,0.),np.where(bmask,gt,0.)\n        rm=R.min((1,2))\n        R-=rm[:,None,None];R/=-eps[:,None,None]\n        np.maximum(R,-80.,out=R);np.exp(R,out=R)\n        rs=R.sum(2);cs=R.sum(1)\n        check=min(float(np.where(amask,rs,np.inf).min()),float(np.where(bmask,cs,np.inf).min()))\n        if check>2e-22:\n            ft=f+rm[:,None]-eps[:,None]*(np.log(rs)+lb)\n            gt=g+rm[:,None]-eps[:,None]*(np.log(cs)+la)\n        else:\n            R=np.subtract(C,f[:,:,None]);R-=g[:,None,:];R/=-eps[:,None,None]\n            rm=R.max(2);cm=R.max(1)\n            rs=np.exp(R-rm[:,:,None]).sum(2);cs=np.exp(R-cm[:,None,:]).sum(1)\n            ft=f-eps[:,None]*(rm+np.log(rs)+lb)\n            gt=g-eps[:,None]*(cm+np.log(cs)+la)\n        return np.where(amask,ft,0.),np.where(bmask,gt,0.)\n    eps=np.asarray([s[0] for s in schedules],np.float32)\n    f,g=transforms(np.zeros((100,nmax),np.float32),np.zeros((100,mmax),np.float32),eps)\n    for t in range(2,max(map(len,schedules))):\n        eps=np.asarray([s[t] if t<len(s) else .1 for s in schedules],np.float32)\n        active=np.asarray([t<len(s) for s in schedules])[:,None]\n        ft,gt=transforms(f,g,eps)\n        f=np.where(active,(f+ft)*.5,f);g=np.where(active,(g+gt)*.5,g)\n    ft,gt=transforms(f,g,np.full((100,),.1,np.float32))\n    costs=(ft/an[:,None]).sum(1)+(gt/bn[:,None]).sum(1)\n    W=np.zeros((20,20),np.float32)\n    W[:10,10:]=costs.reshape(10,10);W[10:,:10]=W[:10,10:].T\n    return W\n\n\nPY\ncat > /tmp/research_history/numpy_coupling.txt <<'PY'\ndef _expectation(C):\n    C=C.numpy()\n    n,m=C.shape\n    K=np.multiply(C,-1./(.1*float(C.max())))\n    np.exp(K,out=K)\n    u=np.full(n,1./n,np.float32);v=np.full(m,1./m,np.float32)\n    for it in range(3):\n        v=(1./m)/(K*u[:,None]).sum(0)\n        u=(1./n)/(K*v[None,:]).sum(1)\n    return float((u*((K*C)*v[None,:]).sum(1)).sum())\n\n\nPY\npython - <<'PY'\nfrom pathlib import Path\nbase=Path('/tmp/research_history/076_numpy_shared_point/method.py').read_text()\nlabel_start=base.index('    D = C.transpose(1,2)',base.index('def _label_cost('))\nlabel_end=base.index('def _expectation(')\ntext=base[:label_start]+Path('/tmp/research_history/numpy_shared_label.txt').read_text()+base[label_end:]\nd=Path('/tmp/research_history/077_numpy_shared_labels');d.mkdir(exist_ok=True);(d/'method.py').write_text(text)\nfor number,source in [(78,base),(79,text)]:\n start=source.index('def _expectation(');end=source.index('def _outer(')\n src=source[:start]+Path('/tmp/research_history/numpy_coupling.txt').read_text()+source[end:]\n d=Path('/tmp/research_history')/f'{number:03d}_numpy_coupling';d.mkdir(exist_ok=True);(d/'method.py').write_text(src)\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

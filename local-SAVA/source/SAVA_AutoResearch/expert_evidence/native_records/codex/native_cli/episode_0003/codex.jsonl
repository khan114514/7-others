{"type": "item.started", "item": {"id": "item_57", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/research_history/make_episode3_index.py <<'PY'\nfrom pathlib import Path\nimport json,hashlib\nfrom collections import defaultdict\nroot=Path('/tmp/research_history');rows=[]\nlocal=defaultdict(list)\nfor p in sorted(root.glob('screen_all_*.log')):\n try:\n  first=int(p.stem.split('_')[2])\n except (ValueError,IndexError):continue\n if first<85:continue\n for line in p.read_text().splitlines():\n  z=line.split()\n  if len(z)==13 and z[2]=='time':local[z[1]].append({'case':z[0],'time':float(z[3]),'nrmse':float(z[5]),'rho':float(z[7]),'top':float(z[9]),'valid':z[12]=='True','log':p.name})\n  elif len(z)==12 and z[2]=='time':local[z[1]].append({'case':z[0],'time':float(z[3]),'nrmse':float(z[5]),'rho':float(z[7]),'top':float(z[9]),'valid':z[11]=='True','log':p.name})\nfor p in sorted(root.glob('[0-9][0-9][0-9]_*/method.py')):\n n=int(p.parent.name[:3])\n if n<85:continue\n row={'variant':p.parent.name,'source_sha256':hashlib.sha256(p.read_bytes()).hexdigest()}\n ls=local.get(p.parent.name)\n if ls:row['local']={'cases':len(ls),'passes':sum(z['valid'] for z in ls),'worst_nrmse':max(z['nrmse'] for z in ls),'min_rho':min(z['rho'] for z in ls),'min_top':min(z['top'] for z in ls),'mean_time':sum(z['time'] for z in ls)/len(ls),'logs':list(dict.fromkeys(z['log'] for z in ls))}\n report=p.parent/'result.json'\n if report.exists():\n  z=json.loads(report.read_text());row['formal']={k:z[k] for k in ['status','raw_metric','score','quality_valid','method_sha256']}\n  row['formal']['cases']=len(z['cases'])\n rows.append(row)\n(root/'episode_3_index.json').write_text(json.dumps(rows,indent=2)+'\\\\n')\nfor z in rows:\n if 'formal' in z:print(z['variant'],z['formal'])\nPY\npython /tmp/research_history/make_episode3_index.py\ncat >> /tmp/research_history/episode_3_working_notes.md <<'EOF'\n\n118/119 replace two dense divisions with two multiplications by vector reciproca
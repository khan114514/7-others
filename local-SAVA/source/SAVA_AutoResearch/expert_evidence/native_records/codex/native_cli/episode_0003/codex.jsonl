{"type": "item.started", "item": {"id": "item_22", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/research_history/build_more_episode3.py <<'PY'\nfrom pathlib import Path\nroot=Path('/tmp/research_history')\nbase=(root/'086_recurrent_torch_kernel/method.py').read_text()\ndef save(name,src):\n d=root/name;d.mkdir(exist_ok=True);(d/'method.py').write_text(src)\n# Keep the high-temperature initialization kernel; subsequent full update uses row/column powers1.\ns=base.replace('    f,g,_,_=direct(torch.zeros(n),torch.zeros(m),schedule[0])','''    f,g,K,shift=direct(torch.zeros(n),torch.zeros(m),schedule[0])\n    pe=schedule[0];full=True\n    if K is not None:rs=K.sum(1);cs=K.sum(0)''')\ns=s.replace('            K/=(rs/m).sqrt()[:,None];K/=(cs/n).sqrt()[None,:]','''            old_shift=shift\n            if full:\n                K/=(rs/m)[:,None];K/=(cs/n)[None,:]\n            else:\n                K/=(rs/m).sqrt()[:,None];K/=(cs/n).sqrt()[None,:]''')\ns=s.replace('km=float(K.max());K/=km;shift=-eps*np.log(km)','km=float(K.max());K/=km;shift=(-old_shift if full else 0.)-eps*np.log(km)')\ns=s.replace('f=(f+ft)*.5;g=(g+gt)*.5;pe=eps','f=(f+ft)*.5;g=(g+gt)*.5;pe=eps;full=False')\nsave('090_reuse_initial_kernel',s)\nlabel=base[base.index('def _label_cost'):base.index('def _expectation')]\nlabel=label[:label.index('    D = C.transpose')]+'''    valid=amask[:,:,None]&bmask[:,None,:]\n    la=(1/an.float()).log()[:,None];lb=(1/bn.float()).log()[:,None]\n    K=None;pe=None;shift=None;rs=None;cs=None;pa=None\n    def direct(f,g,eps):\n        R=(C-f[:,:,None]).sub_(g[:,None,:])\n        if float(eps.max())<=8.:\n            ft=f+R.amin(2)-eps[:,None]*lb\n            gt=g+R.amin(1)-eps[:,None]*la\n            return torch.where(amask,ft,0.),torch.where(bmask,gt,0.),None,None,None,None\n        rm=R.amin((1,2))\n        K=R.sub_(rm[:,None,None]).div_(eps[:,None,None]).neg_().clamp_(min=-80.).exp_()\n        K.masked_fill_(~valid,0.)\n        rs=K.sum(2);cs=K.sum(1)\n        check=torch.minimum(torch.where(amask,rs,float('inf')).amin(1),torch.where(bmask,cs,float('inf')).amin(1))\n        if float(check.min())>2e-22:\n            ft=f+rm[:,None]-eps[:,None]*(rs.log()+lb)\n            gt=g+rm[:,None]-eps[:,None]*(cs.log()+la)\n            return torch.where(amask,ft,0.),torch.where(bmask,gt,0.),K,rm,rs,cs\n        v=(g[:,None,:]-C)/eps[:,None,None]\n        ft=-eps[:,None]*(v.logsumexp(2)+lb)\n        v=(f[:,:,None]-C)/eps[:,None,None]\n        gt=-eps[:,None]*(v.logsumexp(1)+la)\n        return torch.where(amask,ft,0.),torch.where(bmask,gt,0.),None,None,None,None\n    eps=torch.tensor([z[0] for z in schedules])\n    f,g,_,_,_,_=direct(torch.zeros((100,nmax)),torch.zeros((100,mmax)),eps)\n    for t in range(2,max(map(len,schedules))):\n        eps=torch.tensor([z[t] if t<len(z) else .1 for z in schedules])\n        active=torch.tensor([t<len(z) for z in schedules])[:,None]\n        if K is None or float(eps.max())<=8.:\n            ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        else:\n            ar=torch.where(amask & pa,(rs/bn[:,None]).sqrt(),1.)\n            bc=torch.where(bmask & pa,(cs/an[:,None]).sqrt(),1.)\n            K.div_(ar[:,:,None]).div_(bc[:,None,:]).pow_((pe/eps)[:,None,None])\n            km=K.amax((1,2));K.div_(km[:,None,None])\n            shift=torch.where(pa[:,0],0.,shift)-eps*km.log()\n            rs=K.sum(2);cs=K.sum(1)\n            check=torch.minimum(torch.where(amask,rs,float('inf')).amin(1),torch.where(bmask,cs,float('inf')).amin(1))\n            if float(check.min())>2e-22:\n                ft=f+shift[:,None]-eps[:,None]*(rs.log()+lb)\n                gt=g+shift[:,None]-eps[:,None]*(cs.log()+la)\n                ft=torch.where(amask,ft,0.);gt=torch.where(bmask,gt,0.)\n            else:ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        f=torch.where(active,(f+ft)*.5,f);g=torch.where(active,(g+gt)*.5,g)\n        pe=eps;pa=active\n    ft,gt,_,_,_,_=direct(f,g,torch.full((100,),.1))\n    costs=(ft/an[:,None]).sum(1)+(gt/bn[:,None]).sum(1)\n    W=np.zeros((20,20),np.float32)\n    W[:10,10:]=costs.numpy().reshape(10,10);W[10:,:10]=W[:10,10:].T\n    return W\n\n\n'''\nsave('091_recurrent_label_kernel',base[:base.index('def _label_cost')]+label+base[base.index('def _expectation'):])\nsave('092_recurrent_both',s[:s.index('def _label_cost')]+label+s[s.index('def _expectation'):])\n# Coupling exponentiation replaced by rational binomial kernel, raising accuracy with order.\nfor num,k in [(93,32),(94,128),(95,512)]:\n s=base.replace('    K=torch.exp(C/(-.1*float(C.max())))',f'''    K=C/(-.1*float(C.max())*{k})\n    K.add_(1.)\n    for it in range({k.bit_length()-1}):K.square_()''')\n save(f'{num:03d}_binomial_coupling_{k}',s)\nPY\npython /tmp/research_history/build_more_episode3.py\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

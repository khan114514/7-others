{"type": "item.started", "item": {"id": "item_15", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/research_history/build_episode3.py <<'PY'\nfrom pathlib import Path\nroot=Path('/tmp/research_history')\nbase=(root/'075_scalar_outer/method.py').read_text()\ndef save(name,src):\n d=root/name;d.mkdir(exist_ok=True);(d/'method.py').write_text(src)\ndef replace_dual(src,s):\n return src[:src.index('def _dual(')]+s+'\\\\n\\\\n'+src[src.index('def _label_cost('):]\nnpdual='''def _dual(C, schedule):\n    C=C.numpy()\n    n,m=C.shape\n    la=float(np.log(np.float32(1./n)));lb=float(np.log(np.float32(1./m)))\n    K=None; pe=None; shift=0.\n    def direct(f,g,eps):\n        R=np.subtract(C,f[:,None]);R-=g[None,:]\n        if eps<=2.:\n            return f+R.min(1)-eps*lb,g+R.min(0)-eps*la,None,0.\n        rm=float(R.min());R-=rm;R*=(-1./eps)\n        np.maximum(R,-80.,out=R);np.exp(R,out=R)\n        rs=R.sum(1);cs=R.sum(0)\n        if min(float(rs.min()),float(cs.min()))<=2e-22:\n            R=np.subtract(C,f[:,None]);R-=g[None,:];R*=(-1./eps)\n            rowmax=R.max(1);colmax=R.max(0)\n            rr=np.exp(R-rowmax[:,None]).sum(1);cc=np.exp(R-colmax[None,:]).sum(0)\n            return f-eps*(rowmax+np.log(rr)+lb),g-eps*(colmax+np.log(cc)+la),None,0.\n        return f+rm-eps*(np.log(rs)+lb),g+rm-eps*(np.log(cs)+la),R,rm\n    f,g,_,_=direct(np.zeros(n,np.float32),np.zeros(m,np.float32),schedule[0])\n    for eps in schedule[2:-3]:\n        if K is None or eps<=2.:\n            ft,gt,K,shift=direct(f,g,eps)\n        else:\n            K/=np.sqrt(rs/m)[:,None];K/=np.sqrt(cs/n)[None,:]\n            if abs(pe/eps-4.)<1e-5:\n                np.square(K,out=K);np.square(K,out=K)\n            else:np.power(K,pe/eps,out=K)\n            km=float(K.max());K/=km;shift=-eps*np.log(km)\n            rs=K.sum(1);cs=K.sum(0)\n            if min(float(rs.min()),float(cs.min()))>2e-22:\n                ft=f+shift-eps*(np.log(rs)+lb);gt=g+shift-eps*(np.log(cs)+la)\n            else:ft,gt,K,shift=direct(f,g,eps)\n        if K is not None:rs=K.sum(1);cs=K.sum(0)\n        f=(f+ft)*.5;g=(g+gt)*.5;pe=eps\n    return torch.from_numpy((C-g[None,:]).min(1)-.1*lb),None\n'''\nsave('085_recurrent_numpy_kernel',replace_dual(base,npdual))\ntdual=npdual.replace('    C=C.numpy()\\\\n','')\ntdual=tdual.replace('np.subtract(C,f[:,None])','C-f[:,None]').replace('R.min(1)','R.amin(1)').replace('R.min(0)','R.amin(0)')\ntdual=tdual.replace('np.maximum(R,-80.,out=R);np.exp(R,out=R)','R.clamp_(min=-80.).exp_()')\ntdual=tdual.replace('np.exp(R-rowmax[:,None]).sum(1)','torch.exp(R-rowmax[:,None]).sum(1)').replace('np.exp(R-colmax[None,:]).sum(0)','torch.exp(R-colmax[None,:]).sum(0)')\ntdual=tdual.replace('rowmax=R.max(1);colmax=R.max(0)','rowmax=R.amax(1);colmax=R.amax(0)')\ntdual=tdual.replace('np.log(rs)','rs.log()').replace('np.log(cs)','cs.log()').replace('np.log(rr)','rr.log()').replace('np.log(cc)','cc.log()')\ntdual=tdual.replace('np.zeros(n,np.float32),np.zeros(m,np.float32)','torch.zeros(n),torch.zeros(m)')\ntdual=tdual.replace('np.sqrt(rs/m)','(rs/m).sqrt()').replace('np.sqrt(cs/n)','(cs/n).sqrt()')\ntdual=tdual.replace('np.square(K,out=K);np.square(K,out=K)','K.square_().square_()').replace('np.power(K,pe/eps,out=K)','K.pow_(pe/eps)')\ntdual=tdual.replace('torch.from_numpy((C-g[None,:]).min(1)-.1*lb)','(C-g[None,:]).amin(1)-.1*lb')\nsave('086_recurrent_torch_kernel',replace_dual(base,tdual))\n# Coupling evaluates dense empirical matrices on deterministically stratified supports.\nfor num,stride in [(87,2),(88,4),(89,8)]:\n src=base.replace('    n,m=C.shape\\\\n    K=torch.exp(C/',f'    C=C[::{stride},::{stride}].contiguous()\\\\n    n,m=C.shape\\\\n    K=torch.exp(C/')\n save(f'{num:03d}_subsample_coupling_{stride}',src)\nPY\npython /tmp/research_history/build_episode3.py\npython /tmp/research_history/screen_all.py /tmp/research_history/000_baseline/method.py /tmp/research_history/085_recurrent_numpy_kernel/method.py /tmp/research_history/086_recurre
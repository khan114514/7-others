{"type": "item.started", "item": {"id": "item_29", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/research_history/build_lowrank_double.py <<'PY'\nfrom pathlib import Path\nroot=Path('/tmp/research_history')\nfor num,old,k in [(100,96,32),(101,97,64),(102,98,96)]:\n s=(root/f'{old:03d}_lowrank_coupling_{k}/method.py').read_text()\n start=s.index('    kc=torch.exp(C[:,jj]/(-eps))');end=s.index('    return float(((L.T @ ',start)\n s=s[:start]+'''    A=torch.from_numpy(a).double();B=torch.from_numpy(b).double()\n    E=torch.cat(((A*A).sum(1)[:,None]/2,torch.ones((n,1),dtype=torch.float64),A,torch.from_numpy(W)[torch.from_numpy(yl),10:].double()/2),1)\n    H=torch.cat((torch.ones((m,1),dtype=torch.float64),(B*B).sum(1)[:,None]/2,-B,torch.nn.functional.one_hot(torch.from_numpy(rl),10).double()),1)\n    kc=torch.exp((E @ H[jj,:].T)/(-eps))\n    kr=torch.exp((E[ii,:] @ H.T)/(-eps))\n    core=kc[ii,:]\n    L=kc @ torch.linalg.pinv(core,rtol=1e-10)\n    R=kr\n    u=torch.full((n,),1./n,dtype=torch.float64);v=torch.full((m,),1./m,dtype=torch.float64)\n    for it in range(3):\n        vm=R.T @ (L.T @ u)\n        if float(vm.min())<=0.:return _dense_expectation(C)\n        v=(1./m)/vm\n        um=L @ (R @ v)\n        if float(um.min())<=0.:return _dense_expectation(C)\n        u=(1./n)/um\n'''+s[end:]\n d=root/f'{num:03d}_double_lowrank_coupling_{k}';d.mkdir(exist_ok=True);(d/'method.py').write_text(s)\nPY\npython /tmp/research_history/build_lowrank_double.py\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

{"type": "item.completed", "item": {"id": "item_20", "type": "command_execution", "command": "/bin/sh -lc 'cat /tmp/research_history/086_recurrent_torch_kernel/method.py'", "aggregated_output": "\"\"\"Hierarchical transport with reusable costs and explicit annealed dual solves.\"\"\"\nimport numpy as np\nimport torch\nimport ot\nfrom scipy.spatial.distance import cdist\n\n\ndef _schedule(a, b):\n    lo = torch.minimum(a.amin(0), b.amin(0))\n    hi = torch.maximum(a.amax(0), b.amax(0))\n    diameter = float(torch.linalg.vector_norm(hi - lo))\n    return [diameter**2] + [float(np.exp(e)) for e in np.arange(2*np.log(diameter), np.log(.1), 2*np.log(.5))] + [.1]\n\n\ndef _dual(C, schedule):\n    n,m=C.shape\n    la=float(np.log(np.float32(1./n)));lb=float(np.log(np.float32(1./m)))\n    K=None; pe=None; shift=0.\n    def direct(f,g,eps):\n        R=C-f[:,None];R-=g[None,:]\n        if eps<=2.:\n            return f+R.amin(1)-eps*lb,g+R.amin(0)-eps*la,None,0.\n        rm=float(R.min());R-=rm;R*=(-1./eps)\n        R.clamp_(min=-80.).exp_()\n        rs=R.sum(1);cs=R.sum(0)\n        if min(float(rs.min()),float(cs.min()))<=2e-22:\n            R=C-f[:,None];R-=g[None,:];R*=(-1./eps)\n            rowmax=R.amax(1);colmax=R.amax(0)\n            rr=torch.exp(R-rowmax[:,None]).sum(1);cc=torch.exp(R-colmax[None,:]).sum(0)\n            return f-eps*(rowmax+rr.log()+lb),g-eps*(colmax+cc.log()+la),None,0.\n        return f+rm-eps*(rs.log()+lb),g+rm-eps*(cs.log()+la),R,rm\n    f,g,_,_=direct(torch.zeros(n),torch.zeros(m),schedule[0])\n    for eps in schedule[2:-3]:\n        if K is None or eps<=2.:\n            ft,gt,K,shift=direct(f,g,eps)\n        else:\n            K/=(rs/m).sqrt()[:,None];K/=(cs/n).sqrt()[None,:]\n            if abs(pe/eps-4.)<1e-5:\n                K.square_().square_()\n            else:K.pow_(pe/eps)\n            km=float(K.max());K/=km;shift=-eps*np.log(km)\n            rs=K.sum(1);cs=K.sum(0)\n            if min(float(rs.min()),float(cs.min()))>2e-22:\n                ft=f+shift-eps*(rs.log()+lb);gt=g+shift-eps*(cs.log()+la)\n            else:ft,gt,K,shift=direct(f,g,eps)\n        if K is not None:rs=K.sum(1);cs=K.sum(0)\n        f=(f+ft)*.5;g=(g+gt)*.5;pe=eps\n    return (C-g[None,:]).amin(1)-.1*lb,None\n\n\ndef _label_cost(x, y, r, ry):\n    aa = [torch.from_numpy(x[y == i]) for i in range(10)]\n    bb = [torch.from_numpy(r[ry == j]) for j in range(10)]\n    pairs = [(a, b) for a in aa for b in bb]\n    nmax = max(len(a) for a in aa)\n    mmax = max(len(b) for b in bb)\n    A = torch.zeros((100, nmax, x.shape[1]))\n    B = torch.zeros((100, mmax, r.shape[1]))\n    an = torch.tensor([len(a) for a, b in pairs])\n    bn = torch.tensor([len(b) for a, b in pairs])\n    schedules = []\n    for k, (a, b) in enumerate(pairs):\n        A[k, :len(a)] = a\n        B[k, :len(b)] = b\n        schedules.append(_schedule(a, b))\n    C = ((A*A).sum(2)[:,:,None] - 2*torch.bmm(A,B.transpose(1,2)) + (B*B).sum(2)[:,None,:])/2\n    amask = torch.arange(nmax)[None,:] < an[:,None]\n    bmask = torch.arange(mmax)[None,:] < bn[:,None]\n    C.masked_fill_(~(amask[:,:,None] & bmask[:,None,:]), float('inf'))\n    D = C.transpose(1,2)\n    la = (1/an.float()).log()[:,None]\n    lb = (1/bn.float()).log()[:,None]\n    cmin=C.amin((1,2))\n    span=torch.where(amask[:,:,None]&bmask[:,None,:],C,0.).amax((1,2))-cmin\n    base=cmin[:,None,None]-C\n    kernel=None;kernel_eps=None\n    def transform(T,h,eps,lw,outmask):\n        v=(h[:,None,:]-T)/eps[:,None,None]\n        out=-eps[:,None]*v.logsumexp(2)-eps[:,None]*lw\n        return torch.where(outmask,out,0.)\n    def transforms(f,g,eps):\n        nonlocal kernel,kernel_eps\n        if float(eps.max())<=8.:\n            R=(C-f[:,:,None]).sub_(g[:,None,:])\n            ft=f+R.amin(2)-eps[:,None]*lb\n            gt=g+R.amin(1)-eps[:,None]*la\n            return torch.where(amask,ft,0.),torch.where(bmask,gt,0.)\n        if float((span/eps).max())<60. and kernel_eps is None:\n            if kernel_eps is None or not torch.equal(eps,kernel_eps):\n                kernel=torch.exp(base/eps[:,None,None]);kernel_eps=eps\n            K=kernel\n            fm=f.amax(1);gm=g.amax(1)\n            gv=torch.exp((g-gm[:,None])/eps[:,None])*bmask\n            fv=torch.exp((f-fm[:,None])/eps[:,None])*amask\n            ft=cmin[:,None]-gm[:,None]-eps[:,None]*(torch.bmm(K,gv[:,:,None]).squeeze(2).log()+lb)\n            gt=cmin[:,None]-fm[:,None]-eps[:,None]*(torch.bmm(K.transpose(1,2),fv[:,:,None]).squeeze(2).log()+la)\n            ft=torch.where(amask,ft,0.);gt=torch.where(bmask,gt,0.)\n            if bool(torch.isfinite(ft).all()) and bool(torch.isfinite(gt).all()):\n                return ft,gt\n        R=(C-f[:,:,None]).sub_(g[:,None,:])\n        rm=R.amin((1,2))\n        K=R.sub_(rm[:,None,None]).div_(eps[:,None,None]).neg_().clamp_(min=-80.).exp_()\n        rs=K.sum(2);cs=K.sum(1)\n        check=torch.minimum(torch.where(amask,rs,float('inf')).amin(1),torch.where(bmask,cs,float('inf')).amin(1))\n        if float(check.min())>2e-22:\n            ft=f+rm[:,None]-eps[:,None]*(rs.log()+lb)\n            gt=g+rm[:,None]-eps[:,None]*(cs.log()+la)\n            return torch.where(amask,ft,0.),torch.where(bmask,gt,0.)\n        return transform(C,g,eps,lb,amask),transform(D,f,eps,la,bmask)\n    eps=torch.tensor([z[0] for z in schedules])\n    f,g=transforms(torch.zeros((100,nmax)),torch.zeros((100,mmax)),eps)\n    for t in range(2,max(len(z) for z in schedules)):\n        eps=torch.tensor([z[t] if t<len(z) else .1 for z in schedules])\n        active=torch.tensor([t<len(z) for z in schedules])[:,None]\n        ft,gt=transforms(f,g,eps)\n        f=torch.where(active,(f+ft)*.5,f)\n        g=torch.where(active,(g+gt)*.5,g)\n    eps=torch.full((100,),.1)\n    ft,gt=transforms(f,g,eps)\n    costs=(ft/an[:,None]).sum(1)+(gt/bn[:,None]).sum(1)\n    W=np.zeros((20,20),np.float32)\n    W[:10,10:]=costs.numpy().reshape(10,10)\n    W[10:,:10]=W[:10,10:].T\n    return W\n\n\ndef _expectation(C):\n    n,m=C.shape\n    K=torch.exp(C/(-.1*float(C.max())))\n    u=torch.full((n,),1./n)\n    v=torch.full((m,),1./m)\n    D=K.T.contiguous()\n    for it in range(3):\n        v=(1./m)/(D @ u)\n        u=(1./n)/(K @ v)\n    return float(torch.dot(u,(K*C) @ v))\n\n\ndef _outer(batchcost):\n    n,m=batchcost.shape\n    cost=batchcost/max(float(batchcost.max()),1e-12)\n    if m!=2:\n        return ot.sinkhorn(ot.unif(n),ot.unif(m),cost,.01,numItermax=10000,stopThr=1e-10)\n    d=(cost[:,1]-cost[:,0])/.01\n    lo=-float(d.max())-40.;hi=-float(d.min())+40.\n    z=-float(d.mean())\n    for it in range(50):\n        s=1./(1.+np.exp(-np.clip(d+z,-700.,700.)))\n        err=float(s.mean())-.5\n        if abs(err)<1e-13:break\n        if err>0.:hi=z\n        else:lo=z\n        deriv=float((s*(1.-s)).mean())\n        next_z=z-err/max(deriv,1e-30)\n        z=next_z if lo<next_z<hi else (lo+hi)/2.\n    return np.column_stack((s,1.-s))/n\n\n\ndef value(x, y, r, ry, seed=17, batch_size=1024):\n    torch.set_num_threads(2)\n    x=np.asarray(x,np.float32); r=np.asarray(r,np.float32)\n    y=np.asarray(y,np.int64); ry=np.asarray(ry,np.int64)\n    tx=[np.arange(i,min(i+batch_size,len(x))) for i in range(0,len(x),batch_size)]\n    tr=[np.arange(i,min(i+batch_size,len(r))) for i in range(0,len(r),batch_size)]\n    with torch.inference_mode():\n        W=_label_cost(x[tx[0]],y[tx[0]],r[tr[0]],ry[tr[0]])\n        F={}; batchcost=np.zeros((len(tx),len(tr)))\n        for i,idx in enumerate(tx):\n            for j,jdx in enumerate(tr):\n                a=x[idx]; b=r[jdx]\n                T=torch.cdist(torch.from_numpy(a),torch.from_numpy(b)).square()/2\n                T+=torch.from_numpy(W)[y[idx,None],ry[jdx][None,:]+10]/2\n                batchcost[i,j]=_expectation(T)/(len(idx)+len(jdx))\n                z1=torch.tensor(np.column_stack([a,y[idx]]),dtype=torch.float32)\n                z2=torch.tensor(np.column_stack([b,ry[jdx]+10]),dtype=torch.float32)\n                # Reuse the same empirical geometry for coupling and point potentials.\n                f,_=_dual(T,_schedule(z1,z2))\n                f=f.numpy().ravel().astype(float)\n                F[i,j]=(f-f.mean())*len(f)/(len(f)-1)\n    Q=_outer(batchcost)\n    values=np.zeros(len(x))\n    for i,idx in enumerate(tx): values[idx]=sum(Q[i,j]*F[i,j] for j in range(len(tr)))\n    return values\n", "exit_code": 0, "status": "completed"}}

.square().numpy();cb=(n/cs).square().numpy()\n                np.einsum('i,j,ij,ij,ij,ij->ij',rb,cb,kn,kn,kn,kn,out=kn,optimize=False)\n            else:\n                K.mul_((m/rs).sqrt()[:,None]).mul_((n/cs).sqrt()[None,:]).pow_(pe/eps)'''\n s=pt.replace(old,new)\n s=s.replace('''            if min(float(rs.min()),float(cs.min()))>1e-34:''','''            if bool(torch.isfinite(rs).all() & torch.isfinite(cs).all()) and min(float(rs.min()),float(cs.min()))>1e-34:''')\n save(num,'point_fused_recurrence_'+mode,base[:a]+s+base[b:],'Native NumPy einsum fuses broadcast balancing '+mode+' in every nonfinal point recurrence, where kernels are actually reused; direct fallback guards range.')\nco='''            K.mul_(ar.reciprocal()[:,:,None]).mul_(bc.reciprocal()[:,None,:])\n            q=pe/eps\n            if bool(torch.all(torch.abs(q-4.)<1e-4)):K.square_().square_()\n            else:K.pow_(q[:,None,None])'''\nfor num,mode in [(731,'balance'),(732,'balanced_square'),(733,'weighted_fourth')]:\n if mode=='balance':\n  new='''            kn=K.numpy();rb=ar.reciprocal().numpy();cb=bc.reciprocal().numpy()\n            np.einsum('knm,kn,km->knm',kn,rb,cb,out=kn,optimize=False)\n            q=pe/eps\n            if bool(torch.all(torch.abs(q-4.)<1e-4)):K.square_().square_()\n            else:K.pow_(q[:,None,None])'''\n elif mode=='balanced_square':\n  new='''            q=pe/eps\n            if bool(torch.all(torch.abs(q-4.)<1e-4)):\n                kn=K.numpy();rb=ar.reciprocal().square().numpy();cb=bc.reciprocal().square().numpy()\n                np.einsum('kn,km,knm,knm->knm',rb,cb,kn,kn,out=kn,optimize=False)\n                K.square_()\n            else:\n                K.mul_(ar.reciprocal()[:,:,None]).mul_(bc.reciprocal()[:,None,:]).pow_(q[:,None,None])'''\n else:\n  new='''            q=pe/eps\n            if bool(torch.all(torch.abs(q-4.)<1e-4)):\n                kn=K.numpy();rb=ar.reciprocal().square().square().numpy();cb=bc.reciprocal().square().square().num
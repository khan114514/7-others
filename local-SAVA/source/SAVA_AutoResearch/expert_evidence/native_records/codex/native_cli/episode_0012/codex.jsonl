{"type": "item.completed", "item": {"id": "item_26", "type": "command_execution", "command": "/bin/sh -lc 'cat /tmp/research_history/634_episode10_full_augmented_class_geometry/method.py'", "aggregated_output": "\"\"\"Hierarchical transport with reusable costs and explicit annealed dual solves.\"\"\"\nimport numpy as np\nimport torch\nimport ot\n\n\ndef _schedule(a, b):\n    lo = torch.minimum(a.amin(0), b.amin(0))\n    hi = torch.maximum(a.amax(0), b.amax(0))\n    diameter = float(torch.linalg.vector_norm(hi - lo))\n    return [diameter**2] + [float(np.exp(e)) for e in np.arange(2*np.log(diameter), np.log(.1), 2*np.log(.5))] + [.1]\n\n\ndef _dual(C, schedule, initial):\n    n,m=C.shape\n    la=float(np.log(np.float32(1./n)));lb=float(np.log(np.float32(1./m)))\n    shift=0.\n    def direct(f,g,eps):\n        R=C-f[:,None];R-=g[None,:]\n        if eps<=2.:\n            return f+R.amin(1)-eps*lb,g+R.amin(0)-eps*la,None,0.,None,None\n        if step==0 and (float(f.max())+float(g.max()))/eps<60.:\n            rm=0.\n            R.mul_(-1.4426950408889634/eps).exp2_()\n        else:\n            rm=float(R.min());R-=rm;R.mul_(-1.4426950408889634/eps).exp2_()\n        rs=R.sum(1);cs=R.sum(0)\n        if min(float(rs.min()),float(cs.min()))<=2e-22:\n            R=C-f[:,None];R-=g[None,:];R*=(-1./eps)\n            rowmax=R.amax(1);colmax=R.amax(0)\n            rr=torch.exp(R-rowmax[:,None]).sum(1);cc=torch.exp(R-colmax[None,:]).sum(0)\n            return f-eps*(rowmax+rr.log()+lb),g-eps*(colmax+cc.log()+la),None,0.,None,None\n        return f+rm-eps*(rs.log()+lb),g+rm-eps*(cs.log()+la),R,rm,rs,cs\n    f,g=initial\n    \n    K=None;rs=None;cs=None\n    pe=schedule[0]\n    point_steps=schedule[3:-3]\n    for step,eps in enumerate(point_steps):\n        last=step==len(point_steps)-1\n        if last and (K is None or eps<=2.):\n            if eps<=2.:g=(g+(C-f[:,None]).amin(0)-eps*la)*.5\n            else:g=(g-eps*(((f[:,None]-C)/eps).logsumexp(0)+la))*.5\n            break\n        if K is None or eps<=2.:\n            ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        else:\n            if last:\n                q=pe/eps\n                logfactor=.5*q*(float(np.log(n))-cs.log())\n                K.mul_((m/rs).sqrt()[:,None])\n                if abs(q-4.)<1e-5:K.square_().square_()\n                else:K.pow_(q)\n                sums=K.sum(0)\n                if float(sums.min())>0.:\n                    logmass=sums.log()+logfactor\n                    g.add_(logmass+la,alpha=-.5*eps)\n                else:g=(g-eps*(((f[:,None]-C)/eps).logsumexp(0)+la))*.5\n                break\n            K.mul_((m/rs).sqrt()[:,None]).mul_((n/cs).sqrt()[None,:])\n            if abs(pe/eps-4.)<1e-5:\n                K.square_().square_()\n            else:K.pow_(pe/eps)\n            shift=0.\n            if last:\n                cs=K.sum(0)\n                if float(cs.min())>1e-34:g=(g+g+shift-eps*(cs.log()+la))*.5\n                else:g=(g-eps*(((f[:,None]-C)/eps).logsumexp(0)+la))*.5\n                break\n            rs=K.sum(1);cs=K.sum(0)\n            if min(float(rs.min()),float(cs.min()))>1e-34:\n                ft=f+shift-eps*(rs.log()+lb);gt=g+shift-eps*(cs.log()+la)\n            else:ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        f=(f+ft)*.5;g=(g+gt)*.5;pe=eps\n    return C.sub_(g[None,:]).amin(1)-.1*lb,None\n\n\ndef _label_cost(x, y, r, ry):\n    aa = [torch.from_numpy(x[y == i]) for i in range(10)]\n    bb = [torch.from_numpy(r[ry == j]) for j in range(10)]\n    pairs = [(a, b) for a in aa for b in bb]\n    nmax = max(len(a) for a in aa)\n    mmax = max(len(b) for b in bb)\n    A = torch.zeros((100, nmax, x.shape[1]))\n    B = torch.zeros((100, mmax, r.shape[1]))\n    an = torch.tensor([len(a) for a, b in pairs])\n    bn = torch.tensor([len(b) for a, b in pairs])\n    al=torch.stack([a.amin(0) for a in aa]);ah=torch.stack([a.amax(0) for a in aa])\n    bl=torch.stack([b.amin(0) for b in bb]);bh=torch.stack([b.amax(0) for b in bb])\n    diam=torch.linalg.vector_norm(torch.maximum(ah[:,None,:],bh[None,:,:])-torch.minimum(al[:,None,:],bl[None,:,:]),dim=2).flatten().tolist()\n    ds=np.asarray(diam,np.float64)\n    logs=2*np.log(ds);delta=2*np.log(.5)\n    count=np.ceil((np.log(.1)-logs)/delta).astype(np.int64)\n    length=count+2\n    steps=np.arange(int(length.max()))[:,None]\n    effective=(logs+delta)-logs\n    temperatures=np.exp(logs[None,:]+(steps-1)*effective[None,:])\n    temperatures=np.where((steps>=1)&(steps<=count[None,:]),temperatures,.1)\n    temperatures[0]=ds*ds\n    etable=torch.from_numpy(temperatures.astype(np.float32))\n    atable=torch.from_numpy(steps<length[None,:])\n    hard=(temperatures.astype(np.float32).max(1)<=256.).tolist()\n    end=int(length.max())-3\n    for i,a in enumerate(aa):A[i*10:(i+1)*10,:len(a)]=a\n    for j,b in enumerate(bb):B[j::10,:len(b)]=b\n    ca=torch.empty((100,nmax,12));cb=torch.empty((100,mmax,12))\n    ca[:,:,:10]=-A;ca[:,:,10]=A.square().sum(2)/2;ca[:,:,11]=1.\n    cb[:,:,:10]=B;cb[:,:,10]=1.;cb[:,:,11]=B.square().sum(2)/2\n    C=torch.bmm(cb,ca.transpose(1,2)).transpose(1,2)\n    amask = torch.arange(nmax)[None,:] < an[:,None]\n    bmask = torch.arange(mmax)[None,:] < bn[:,None]\n    C.masked_fill_(~(amask[:,:,None] & bmask[:,None,:]), float('inf'))\n    la=(1/an.float()).log()[:,None];lb=(1/bn.float()).log()[:,None]\n    def direct(f,g,eps):\n        R=(C-f[:,:,None]).sub_(g[:,None,:])\n        if hard[t]:\n            ft=f+R.amin(2)-eps[:,None]*lb\n            gt=g+R.amin(1)-eps[:,None]*la\n            return torch.where(amask,ft,0.),torch.where(bmask,gt,0.),None,None,None,None\n        if t==2 and float(((f.amax(1)+g.amax(1))/eps).max())<60.:\n            rm=torch.zeros(100)\n            K=R.mul_((-1.4426950408889634/eps)[:,None,None]).exp2_()\n        else:\n            rm=R.amin((1,2))\n            K=R.sub_(rm[:,None,None]).mul_((-1.4426950408889634/eps)[:,None,None]).exp2_()\n        rs=K.sum(2);cs=K.sum(1)\n        check=torch.minimum(torch.where(amask,rs,float('inf')).amin(1),torch.where(bmask,cs,float('inf')).amin(1))\n        if float(check.min())>1e-34:\n            ft=f+rm[:,None]-eps[:,None]*(rs.log()+lb)\n            gt=g+rm[:,None]-eps[:,None]*(cs.log()+la)\n            return torch.where(amask,ft,0.),torch.where(bmask,gt,0.),K,rm,rs,cs\n        v=(g[:,None,:]-C)/eps[:,None,None]\n        ft=-eps[:,None]*(v.logsumexp(2)+lb)\n        v=(f[:,:,None]-C)/eps[:,None,None]\n        gt=-eps[:,None]*(v.logsumexp(1)+la)\n        return torch.where(amask,ft,0.),torch.where(bmask,gt,0.),None,None,None,None\n    amean=A.sum(1)/an[:,None];bmean=B.sum(1)/bn[:,None]\n    asq=A.square().sum(2)/2;bsq=B.square().sum(2)/2\n    f=torch.where(amask,asq+bsq.sum(1)[:,None]/bn[:,None]-(A*bmean[:,None,:]).sum(2),0.)\n    g=torch.where(bmask,bsq+asq.sum(1)[:,None]/an[:,None]-(B*amean[:,None,:]).sum(2),0.)\n    K=None;shift=None;rs=None;cs=None\n    pe=None;pa=torch.ones((100,1),dtype=torch.bool)\n    for t in range(2,end):\n        eps=etable[t]\n        active=atable[t,:,None]\n        if K is None or hard[t]:\n            ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        else:\n            ar=torch.where(amask & pa,(rs/bn[:,None]).sqrt(),1.)\n            bc=torch.where(bmask & pa,(cs/an[:,None]).sqrt(),1.)\n            K.mul_(ar.reciprocal()[:,:,None]).mul_(bc.reciprocal()[:,None,:])\n            q=pe/eps\n            if bool(torch.all(torch.abs(q-4.)<1e-4)):K.square_().square_()\n            else:K.pow_(q[:,None,None])\n            shift=torch.where(pa[:,0],0.,shift)\n            rs=K.sum(2);cs=K.sum(1)\n            check=torch.minimum(torch.where(amask,rs,float('inf')).amin(1),torch.where(bmask,cs,float('inf')).amin(1))\n            if float(check.min())>1e-34:\n                ft=f+shift[:,None]-eps[:,None]*(rs.log()+lb)\n                gt=g+shift[:,None]-eps[:,None]*(cs.log()+la)\n                ft=torch.where(amask,ft,0.);gt=torch.where(bmask,gt,0.)\n            else:ft,gt,K,shift,rs,cs=direct(f,g,eps)\n        df=torch.where(active,ft-f,0.)\n        dg=torch.where(active,gt-g,0.)\n        f.add_(df,alpha=.5)\n        g.add_(dg,alpha=.5)\n        pe=eps;pa=active\n    g.add_(dg,alpha=0.25)\n    C.sub_(f[:,:,None]).sub_(g[:,None,:])\n    ft=torch.where(amask,f+C.amin(2)-.1*lb,0.)\n    gt=torch.where(bmask,g+C.amin(1)-.1*la,0.)\n    costs=(ft/an[:,None]).sum(1)+(gt/bn[:,None]).sum(1)\n    W=np.zeros((20,20),np.float32)\n    W[:10,10:]=costs.numpy().reshape(10,10);W[10:,:10]=W[:10,10:].T\n    return W\n\n\ndef _expectation(C):\n    n,m=C.shape\n    K=(C*(-14.426950408889634/float(C.max()))).exp2_()\n    v=(1./m)/K.sum(0)\n    u=(1./n)/(K @ v[:,None])[:,0]\n    col=v*(K.T @ u[:,None])[:,0]\n    w=v*(2.-m*col).clamp_(min=.01)\n    rowmass=(K @ w[:,None])[:,0]\n    energy=(K.mul_(C) @ w[:,None])[:,0]\n    return float((energy/rowmass).mean())\n\n\ndef _outer(batchcost):\n    n,m=batchcost.shape\n    cost=batchcost/max(float(batchcost.max()),1e-12)\n    if m!=2:\n        return ot.sinkhorn(ot.unif(n),ot.unif(m),cost,.01,numItermax=10000,stopThr=1e-10)\n    d=(cost[:,1]-cost[:,0])/.01\n    lo=-float(d.max())-40.;hi=-float(d.min())+40.\n    z=-float(d.mean())\n    for it in range(50):\n        s=1./(1.+np.exp(-np.clip(d+z,-700.,700.)))\n        err=float(s.mean())-.5\n        if abs(err)<1e-13:break\n        if err>0.:hi=z\n        else:lo=z\n        deriv=float((s*(1.-s)).mean())\n        next_z=z-err/max(deriv,1e-30)\n        z=next_z if lo<next_z<hi else (lo+hi)/2.\n    return np.column_stack((s,1.-s))/n\n\n\ndef value(x, y, r, ry, seed=17, batch_size=1024):\n    torch.set_flush_denormal(True)\n    torch.set_num_threads(2)\n    x=np.asarray(x,np.float32); r=np.asarray(r,np.float32)\n    y=np.asarray(y,np.int64); ry=np.asarray(ry,np.int64)\n    tx=[np.arange(i,min(i+batch_size,len(x))) for i in range(0,len(x),batch_size)]\n    tr=[np.arange(i,min(i+batch_size,len(r))) for i in range(0,len(r),batch_size)]\n    with torch.inference_mode():\n        W=_label_cost(x[tx[0]],y[tx[0]],r[tr[0]],ry[tr[0]])\n        WL=W[:10,10:].copy()/2\n        X=torch.from_numpy(x);R=torch.from_numpy(r)\n        xn=(X*X).sum(1)/2;rn=(R*R).sum(1)/2\n        am=torch.stack([X[idx].mean(0) for idx in tx]);bm=torch.stack([R[idx].mean(0) for idx in tr])\n        amn=torch.stack([xn[idx].mean() for idx in tx]);bmn=torch.stack([rn[idx].mean() for idx in tr])\n        aw=np.stack([np.bincount(y[idx],minlength=10)/len(idx) for idx in tx]).astype(np.float32)\n        bw=np.stack([np.bincount(ry[idx],minlength=10)/len(idx) for idx in tr]).astype(np.float32)\n        fm=xn[:,None]+bmn[None,:]-X @ bm.T+torch.from_numpy((WL @ bw.T)[y])\n        gm=rn[:,None]+amn[None,:]-R @ am.T+torch.from_numpy((aw @ WL).T[ry])\n        Ax=torch.zeros((len(x),22));Br=torch.zeros((len(r),22))\n        Ax[:,:10]=-X;Ax[:,10]=xn;Ax[:,11]=1.\n        Ax[:,12:]=torch.from_numpy(WL[y])\n        Br[:,:10]=R;Br[:,10]=1.;Br[:,11]=rn\n        Br[torch.arange(len(r)),12+torch.from_numpy(ry)]=1.\n        allcost=Ax @ Br.T\n        F={}; batchcost=np.zeros((len(tx),len(tr)))\n        for i,idx in enumerate(tx):\n            for j,jdx in enumerate(tr):\n                a=x[idx]; b=r[jdx]\n                aa=X[i*batch_size:i*batch_size+len(idx)];bb=R[j*batch_size:j*batch_size+len(jdx)]\n                T=allcost[i*batch_size:i*batch_size+len(idx),j*batch_size:j*batch_size+len(jdx)].contiguous()\n                batchcost[i,j]=_expectation(T)/(len(idx)+len(jdx))\n                # Reuse the same empirical geometry for coupling and point potentials.\n                lo=np.minimum(a.min(0),b.min(0));hi=np.maximum(a.max(0),b.max(0))\n                yl=int(y[idx].min());yh=int(y[idx].max());rl=int(ry[jdx].min())+10;rh=int(ry[jdx].max())+10\n                d2=float(np.sum((hi-lo)**2)) + float((max(yh,rh)-min(yl,rl))**2)\n                diameter=np.sqrt(d2)\n                schedule=[diameter**2]+[float(np.exp(e)) for e in np.arange(2*np.log(diameter),np.log(.1),2*np.log(.5))]+[.1]\n                f,_=_dual(T,schedule,(fm[idx,j],gm[jdx,i]))\n                f=f.numpy().ravel().astype(float)\n                F[i,j]=(f-f.mean())*len(f)/(len(f)-1)\n    Q=_outer(batchcost)\n    values=np.zeros(len(x))\n    for i,idx in enumerate(tx): values[idx]=sum(Q[i,j]*F[i,j] for j in range(len(tr)))\n    return values\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_27", "type": "command_execution", "command": "/bin/sh -lc 'cat /tmp/research_history/episode10_build_round12.py /tmp/research_history/episode_1_continuing_notes.md /tmp/research_history/episode_2_continuing_notes.md'", "aggregated_output": "from pathlib import Path\nimport json,hashlib\nroot=Path('/tmp/research_history');entries=[]\ndef read(name):return (root/name/'method.py').read_text()\ndef part(s,start,end):return s[s.index('def '+start):s.index('def '+end)]\ndef replace(s,origin,start,end):return s.replace(part(s,start,end),part(origin,start,end))\ndef save(num,name,s,h):\n d=root/f'{num}_episode10_{name}';d.mkdir(exist_ok=True);(d/'method.py').write_text(s)\n compile(s,str(d/'method.py'),'exec')\n entries.append({'name':d.name,'sha256':hashlib.sha256(s.encode()).hexdigest(),'hypothesis':h})\nbase=read('627_episode10_augmented_full_cost_contiguous_pairs')\nfor num,name,origin in [(634,'full_augmented_class_geometry','619_episode10_class_augmented_geometry12'),(635,'full_augmented_class_buffer','605_episode10_class_reuse_direct_buffer'),(636,'full_augmented_class_tile20','583_episode10_class_recurrence_tile20')]:\n s=replace(base,read(origin),'_label_cost','_expectation');save(num,name,s,'Combine exact fullaugmentedcostGEMM and contiguous originalpairs with independent class geometry/buffer/tile changes; retain numericalrecipe.')\ns=replace(base,read('613_episode10_both_reuse_direct_buffers_fixed'),'_dual','_label_cost');s=replace(s,read('613_episode10_both_reuse_direct_buffers_fixed'),'_label_cost','_expectation')\nsave(637,'full_augmented_both_buffers_point_gemm',s,'Combine fullcostaugmentedGEMM, exactpointcolumnGEMM and both residualbuffers; same contiguous batchpartition.')\n# Avoid copying each fullcost pair before expectation/dual: C has strided rows but dense residual/K allocations may be contiguous.\ns=base.replace('''j*batch_size:j*batch_size+len(jdx)].contiguous()''','''j*batch_size:j*batch_size+len(jdx)]''')\nassert s!=base\nsave(638,'full_augmented_strided_cost_pairs',s,'Keep pair views of the exact fullcostmatrix without contiguouscopies; test whether residual allocation still makes fastcontiguous kernels while savingcostcopy.')\n# Compute fullcost after loop-scheduling sizes in rows aligned to original batch multiple but retain outputrowstride M.\ns=base.replace('''        allcost=Ax @ Br.T''','''        allcost=torch.empty((len(x),len(r)))\n        for start in range(0,len(x),batch_size*2):\n            stop=min(start+batch_size*2,len(x))\n            torch.mm(Ax[start:stop],Br.T,out=allcost[start:stop])''')\nsave(639,'full_augmented_block_gemm2048',s,'Build fullaugmentedcostmatrix in2048candidate-rowGEMMblocks; retaincontiguouspaircopies, testingdispatch/cachecontrolwithout supportchange.')\n(root/'episode10_round12_manifest.json').write_text(json.dumps(entries,indent=2));print(json.dumps(entries,indent=2))\n# Continuing research notes: episode 1\n\n## Rules and state\n- Task: numerical approximation of canonical hierarchical transport. Only `/workspace/solution/method.py` is editable submission; frozen `solve.sh` unchanged.\n- Read instruction, canonical source, public manifest and all public array schemas. No private/hidden targets, evaluator source, credentials, environment variables, network, or other trajectories accessed.\n- Launcher mode0444 prevents direct execution; use `sh ./solve.sh` (unchanged bytes). Launcher SHA256 `bca6ef61c3a1bc0ded2aa6b2da4734b62072846def679d12a2d7ae669fc88bd1`.\n- Full logs, exact reported hashes, method snapshots, successful/worse/failed variants are under `/tmp/research_history`. `result.json` files are untouched copies of reports from evaluator-supplied result paths. Expanded chronological notes saved as `episode_1_working_notes.md`.\n- **Best fully measured and restored: 030_torch_geometry**, raw .20901791953365317, score .599194486237406, all30 valid. Source hash `b92818cc1bb2e79042a1d59c7bf57eba0f5bc18597b8d94c8ed3e1fe82230e73`.\n- Current method.py exactly matches fully evaluated030. Source and launcher hashes verified; only method.py and solve.sh are present in submission directory. Episode1 complete after35 archived sources, numerous controlled local measurements, and6 complete official evaluations. No evaluation is pending.\n\n## Full evaluator results (all quality valid so far)\n| Variant | Raw seconds | Score | Worst nRMSE | Exact evaluator-reported SHA256 |\n|---|---:|---:|---:|---|\n| 000_baseline | 0.716864103102 | -0.374633743283 | 0.000000599 | 92b12caf57128aac8eb7ca32c0e9e3d6f0fb45ec479b78a8243c093922bc5993 |\n| 001_cross_only | 0.524686492000 | -0.006120620947 | 0.000000599 | f855f22591fb86743419256f78afae10b9b36baa4f4f3de50d4df270a38fe504 |\n| 009_gibbs_early | 0.271582475132 | 0.479222864158 | 0.005723606 | ea63f829bbdba097fc488d3a5115108125e09949410e77f09cc2151420a43ba5 |\n| 015_sparse_8_later | 0.304177083401 | 0.416720573721 | 0.002259987 | 494783a939f65bbd7cd6654e3cfb44ae0d7c26028aa05dca54fb3179b543389e |\n| 023_coupling_3 | 0.259020773768 | 0.503310747055 | 0.005776985 | fb46e5d3b5dc019ba7d3858876ad64af9a951d943f9e5d0229b19707e0e99ad0 |\n| 030_torch_geometry | 0.209017919534 | 0.599194486237 | 0.005777037 | b92818cc1bb2e79042a1d59c7bf57eba0f5bc18597b8d94c8ed3e1fe82230e73 |\n\n## Canonical recipe and main findings\n- Inputs x(N,10), r(M,10), labels0..9; public N3000,M2000 across5 seeds x6 settings. Contiguous1024 batches gives3 candidate x2 reference batches. Seed unused by canonical; retain deterministic calculations from arrays.\n- Canonical W20x20 computes190 class-pair OT values, but only100 cross candidate/reference costs used. Removing90 within-side solves is exact (001).\n- GeomLoss label OT and point potentials are **finite symmetric epsilon-scaling**, not fully converged OT: initial softmin, repeated coarse temperatures, scaling.5, target epsilon.1, final full softmin extrapolation. Need preserve schedule per pair (diameter includes appended labels for point potentials).\n- Batch C = squared Euclidean/2 + W/2. Inner coupling uses epsilon=.1 after C/max(C); expectation/(n+m) forms outer costs. Outer3x2 POT uses regularization.01, max normalization,10000 iterations,tol1e-10. Center point potentials and multiply n/(n-1); aggregate outer-weighted per batch.\n- Hybrid approximation: high temperatures use explicit Gibbs kernel + matvec whenever cost span/eps<60, otherwise log-domain; eps<=8 uses hard minima. At these units this passes all30: nRMSE~.00572, rank>=.999978, overlap>=.993333. Class costs batched100 padded with masks; each own schedule. Reuse kernel at repeated coarse temperatures; share C-f-g for row/column minima. All kernels per call from actual arrays.\n- Normalized inner coupling sufficiently regularized:3 scaling iterations adds little error. 023 has max nRMSE .0057769853, min rank .9999779964, overlap .9933333.2 iterations locally pass but less margin;1 iteration fails8 public cases.\n- 030 additionally uses same Torch cdist float32 C for coupling and potentials, avoiding double SciPy geometry. Locally all30 pass with same error as023. Full result best among6 official evaluations. Max nRMSE .0057770371, min Spearman .9999779964, min overlap .9933333.\n\n## Controlled ablations and rejected branches\n- 002 explicit dual solver/cost reuse: local six cases nRMSE<5e-7.003 hard min eps<=2,004 batched labels,005 float32 inner coupling: local errors<.000751; slower than min8 branch.\n- 006 min8: all30 local max.005723;007 min32 and008 min128 fail RMSE (max.0312/.1326); do not submit.009 early Gibbs matvec full valid and faster; archived predecessor best.\n- 010 graph32 at eps<=32,011 also sparse labels: six-case error<=.0014 but graph selection slower.012 graph8/entry32 and013 graph4/entry32 fail RMSE.014 graph16/entry32 all30 local valid max.006543.015 graph8/entry8 improves accuracy max.002260, but full aggregate worse (.304177 vs009 .271582); reverted.016 graph4/entry2 locally valid but not faster.\n- 017
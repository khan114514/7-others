{"type": "item.started", "item": {"id": "item_75", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/research_history/episode12_index.py <<'PY'\nfrom pathlib import Path\nimport json,hashlib,sys,shutil\nroot=Path('/tmp/research_history');index={}\nfor d in sorted(root.glob('*_episode12_*')):\n if not d.is_dir() or not (d/'method.py').exists():continue\n src=(d/'method.py').read_bytes();index[d.name]={'name':d.name,'sha256':hashlib.sha256(src).hexdigest(),'bytes':len(src)}\nfor p in sorted(root.glob('episode12_round*_manifest.json')):\n for e in json.loads(p.read_text()):index[e['name']].update(e,manifest=p.name)\nfor p in sorted(root.glob('episode12_round*_manifest_screen.json')):\n data=json.loads(p.read_text())\n for s in data['summary']:\n  e=index[s['name']];e['local_summary']=s;e['local_records']=[r for r in data['records'] if r['name']==s['name']]\nofficial=[]\nfor name,e in index.items():\n d=root/name;p=d/'result.json'\n if not p.exists():continue\n z=json.loads(p.read_text());stdout=json.loads((d/'evaluator.log').read_text())\n assert e['sha256']==z['method_sha256']==stdout['method_sha256']\n cases=z['cases'];metrics=[m for c in cases for m in c['quality_runs']]\n s={'name':name,'raw_metric':z['raw_metric'],'score':z['score'],'quality_valid':z['quality_valid'],'method_sha256':z['method_sha256'],'cases':len(cases),'quality_records':len(metrics),'worst_nrmse':max(m['nrmse'] for m in metrics),'min_spearman':min(m['spearman'] for m in metrics),'min_top_overlap':min(m['top_quarter_overlap'] for m in metrics)}\n e['official']=s;official.append(s);(d/'official_summary.json').write_text(json.dumps(s,indent=2))\n(root/'episode_12_index.json').write_text(json.dumps(index,indent=2))\n(root/'episode12_official_summary.json').write_text(json.dumps(official,indent=2))\nbest=min((s for s in official if s['quality_valid'] and s['cases']==30 and s['quality_records']==270),key=lambda s:s['raw_metric'])\n# Include retained historical source671 if a new episode ever has no improved repeat.\nhistorical=json.loads((root/'671_episode11_point_gemm_columns_point_recurrence_residual_increments/official_summary.json').read_text())\nif historical['raw_metric']<best['raw_metric']:best=historical\n(root/'episode_12_final_selection.json').write_text(json.dumps(best,indent=2))\nif '--restore' in sys.argv:shutil.copyfile(root/best['name']/'method.py','/workspace/solution/method.py')\nprint(json.dumps({'sources':len(index),'screened':sum('local_summary' in e for e in index.values()),'local_valid':sum(e.get('local_summary',{}).get('valid',False) for e in index.values()),'official':official,'selected':best},indent=2))\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

ion in a native five-operand einsum; stable logsumexp fallback for float32 range failures.')\noldenergy='''    energy=(K.mul_(C) @ w[:,None])[:,0]'''\nnewenergy='''    energy=torch.from_numpy(np.einsum('ij,ij,j->i',K.numpy(),C.numpy(),w.numpy(),optimize=False))'''\ns3=base.replace(oldenergy,newenergy)\nsave(717,'coupling_fused_numpy_energy',s3,'Fuse the weighted cost-energy contraction in a native NumPy three-operand einsum while retaining GEMM marginal and rowmass calculations.')\nsave(718,'point_fourth_and_coupling_energy',s.replace(oldenergy,newenergy),'Combine native fused final point powers and coupling energy contractions; same complete empirical kernels.')\n# Make operand order explicit: weighted contraction may multiply the small row scale before large powers.\nnew3='''                if abs(q-4.)<1e-5:\n                    kn=K.numpy();weights=(m/rs).square().numpy()\n                    sums=torch.from_numpy(np.einsum('i,ij,ij,ij,ij->j',weights,kn,kn,kn,kn,optimize=False))\n                else:\n                    K.mul_((m/rs).sqrt()[:,None]).pow_(q)\n                    sums=(K.T @ torch.ones((n,1)))[:,0]'''\ns4=base.replace(old,new3)\ns4=s4.replace('''                if float(sums.min())>0.:''','''                if bool(torch.isfinite(sums).all()) and float(sums.min())>0.:''')\nsave(719,'final_point_fused_weight_first',s4,'Control native operand multiplication order by applying squared row scaling before fourth powers, reducing overflow risk without a dense balancing write.')\n# Double accumulation only for the final weighted contraction: range-safe but may cost more.\ns5=s2.replace('''kn,kn,kn,kn,weights,optimize=False)''','''kn,kn,kn,kn,weights,optimize=False,dtype=np.float64,casting='unsafe')''')\nsave(720,'final_point_fused_weighted_double',s5,'Double-precision weighted einsum contraction isolates intermediate dynamic-range failures from the five-operand fusion algorithm.')\n(root/'episode12_round6_manifest.json').write_text(json.dumps(entries,in
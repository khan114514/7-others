{"type": "item.started", "item": {"id": "item_44", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/research_history/episode12_build_round4.py <<'PY'\nfrom pathlib import Path\nimport hashlib,json\nroot=Path('/tmp/research_history');base=(root/'689_episode12_start671_repeat/method.py').read_text();entries=[]\ndef save(num,name,src,h):\n d=root/f'{num}_episode12_{name}';d.mkdir(exist_ok=True);(d/'method.py').write_text(src);compile(src,str(d/'method.py'),'exec')\n entries.append({'name':d.name,'sha256':hashlib.sha256(src.encode()).hexdigest(),'hypothesis':h})\nsetup='''        Ax=torch.zeros((len(x),22));Br=torch.zeros((len(r),22))\n        Ax[:,:10]=-X;Ax[:,10]=xn;Ax[:,11]=1.\n        Ax[:,12:]=torch.from_numpy(WL[y])\n        Br[:,:10]=R;Br[:,10]=1.;Br[:,11]=rn\n        Br[torch.arange(len(r)),12+torch.from_numpy(ry)]=1.\n        allcost=Ax @ Br.T\n'''\ns=base.replace('''        F={}; batchcost=np.zeros((len(tx),len(tr)))''',setup+'''        F={}; batchcost=np.zeros((len(tx),len(tr)))''')\nold='''                T=aa @ bb.T\n                T.mul_(-1.).add_(xn[i*batch_size:i*batch_size+len(idx),None]).add_(rn[None,j*batch_size:j*batch_size+len(jdx)])\n                T.add_(torch.from_numpy(np.take(WL[y[idx]],ry[jdx],axis=1)))'''\nnew='''                T=allcost[i*batch_size:i*batch_size+len(idx),j*batch_size:j*batch_size+len(jdx)].contiguous()'''\ns=s.replace(old,new)\nsave(705,'full_cost_control_current_recipe',s,'Exact full augmented cost construction with the currently retained class and point recipe, controlling cost dataflow before grouped coupling.')\nhelper='''def _all_expectation(C, tx, tr):\n    ni=len(tx);mj=len(tr);N,M=C.shape\n    K=torch.empty_like(C)\n    for i,idx in enumerate(tx):\n        ii=slice(int(idx[0]),int(idx[-1])+1)\n        for j,jdx in enumerate(tr):\n            jj=slice(int(jdx[0]),int(jdx[-1])+1)\n            torch.mul(C[ii,jj],-14.426950408889634/float(C[ii,jj].max()),out=K[ii,jj])\n            K[ii,jj].exp2_()\n    v=torch.empty((ni,M))\n    for i,idx in enumerate(tx):\n        ii=slice(int(idx[0]),int(idx[-1])+1)\n        v[i]=K[ii].sum(0).reciprocal()\n        for j,jdx in enumerate(tr):v[i,jdx]/=len(jdx)\n    U=torch.zeros((N,ni*mj));W=torch.zeros((M,ni*mj))\n    for i,idx in enumerate(tx):\n        for j,jdx in enumerate(tr):W[jdx,j*ni+i]=v[i,jdx]\n    row=K @ W\n    for i,idx in enumerate(tx):\n        for j,jdx in enumerate(tr):U[idx,j*ni+i]=(1./len(idx))/row[idx,j*ni+i]\n    col=K.T @ U\n    W.zero_()\n    for i,idx in enumerate(tx):\n        for j,jdx in enumerate(tr):\n            vv=v[i,jdx]\n            W[jdx,j*ni+i]=vv*(2.-len(jdx)*vv*col[jdx,j*ni+i]).clamp_(min=.01)\n    mass=K @ W\n    K.mul_(C)\n    energy=K @ W\n    result=np.empty((ni,mj))\n    for i,idx in enumerate(tx):\n        for j,jdx in enumerate(tr):\n            result[i,j]=float((energy[idx,j*ni+i]/mass[idx,j*ni+i]).mean())/(len(idx)+len(jdx))\n    return result\n\n\n'''\ns2=s[:s.index('def _outer')]+helper+s[s.index('def _outer'):]\ns2=s2.replace('''        F={}; batchcost=np.zeros((len(tx),len(tr)))''','''        F={}; batchcost=_all_expectation(allcost,tx,tr)''')\ns2=s2.replace('''                batchcost[i,j]=_expectation(T)/(len(idx)+len(jdx))\\\\n''','')\nsave(706,'global_coupling_block_responses',s2,'Group all exact inner coupling contractions as full GEMMs with block response columns; preserves each pair cost maximum, normalized marginals and final exact row expectation.')\n# Smaller GEMMs over candidate and reference blocks avoid multiplying by most of the zero RHS entries.\nhelper2='''def _all_expectation(C, tx, tr):\n    ni=len(tx);mj=len(tr);N,M=C.shape\n    K=torch.empty_like(C)\n    for i,idx in enumerate(tx):\n        ii=slice(int(idx[0]),int(idx[-1])+1)\n        for j,jdx in enumerate(tr):\n            jj=slice(int(jdx[0]),int(jdx[-1])+1)\n            torch.mul(C[ii,jj],-14.426950408889634/float(C[ii,jj].max()),out=K[ii,jj])\n            K[ii,jj].exp2_()\n    v=torch.empty((ni,M));U=torch.zeros((N,ni,mj))\n    for i,idx in enumerate(tx):\n        ii=slice(int(idx[0]),int(idx[-1])+1)\n        v[i]=K[ii].sum(0).reciprocal()\n        W=torch.zeros((M,mj))\n        for j,jdx in enumerate(tr):\n            v[i,jdx]/=len(jdx);W[jdx,j]=v[i,jdx]\n        row=K[ii] @ W\n        U[ii,i,:]=(1./len(idx))/row\n    for j,jdx in enumerate(tr):\n        jj=slice(int(jdx[0]),int(jdx[-1])+1)\n        col=K[:,jj].T @ U[:,:,j]\n        v[:,jj].mul_((2.-len(jdx)*v[:,jj]*col.T).clamp_(min=.01))\n    result=np.empty((ni,mj))\n    for i,idx in enumerate(tx):\n        ii=slice(int(idx[0]),int(idx[-1])+1)\n        W=torch.zeros((M,mj))\n        for j,jdx in enumerate(tr):W[jdx,j]=v[i,jdx]\n        mass=K[ii] @ W\n        K[ii].mul_(C[ii])\n        energy=K[ii] @ W\n        result[i]=((energy/mass).mean(0)/torch.tensor([len(idx)+len(jdx) for jdx in tr])).numpy()\n    return result\n\n\n'''\ns3=s2.replace(helper,helper2)\nsave(707,'blocked_coupling_responses',s3,'Use candidate-block GEMMs with one response per reference batch and reference-block GEMMs with one per candidate batch, reducing zero RHS work while sharing dispatch.')\n# Separate products by candidate blocks after building the kernel; control contiguous reference view copies.\ns4=s3.replace('''col=K[:,jj].T @ U[:,:,j]''','''col=K[:,jj].T.contiguous() @ U[:,:,j].contiguous()''')\nsave(708,'blocked_coupling_contiguous_columns',s4,'Control physical contiguity of the grouped reference contraction; same grouped exact coupling algorithm.')\n(root/'episode12_round4_manifest.json').write_text(json.dumps(entries,indent=2));print(json.dumps(entries,indent=2))\nPY\npython /tmp/research_history/episode12_build_round4.py\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

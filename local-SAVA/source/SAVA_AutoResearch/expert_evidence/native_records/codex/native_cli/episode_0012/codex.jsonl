{"type": "item.started", "item": {"id": "item_76", "type": "command_execution", "command": "/bin/sh -lc \"python - <<'PY'\nfrom pathlib import Path\np=Path('/tmp/research_history/episode12_index.py');s=p.read_text();(p.parent/'episode12_index_initial_unexecuted.py').write_text(s)\ns=s.replace(\\\"c['quality_runs']\\\",\\\"c['quality']\\\").replace(\\\"m['nrmse']\\\",\\\"m['normalized_rmse']\\\").replace(\\\"m['top_quarter_overlap']\\\",\\\"m['top_quartile_overlap']\\\")\np.write_text(s)\nPY\ncat > /tmp/research_history/episode12_stress.py <<'PY'\nfrom pathlib import Path\nimport importlib.util,json,time,sys\nimport numpy as np\nfrom scipy.stats import spearmanr\nroot=Path('/tmp/research_history')\ndef load(name):\n p=root/name/'method.py';spec=importlib.util.spec_from_file_location(name,p);m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m);return m\ncanonical=load('000_baseline');names=sys.argv[1:];mods=[load(n) for n in names];records=[];targets=[]\ncase_ids=['seed_202_uniform_labels','seed_505_gaussian_016','seed_101_mixed']\nsizes=[(2200,1800),(3600,2400),(1800,1200)]\nfor ci,case in enumerate(case_ids):\n z=np.load('/workspace/environment/public_assets/dev/'+case+'.npz')\n for si,(N,M) in enumerate(sizes):\n  rngseed=120000+100*ci+si;rng=np.random.default_rng(rngseed)\n  ai=rng.choice(len(z['x']),N,replace=N>len(z['x']));bi=rng.choice(len(z['r']),M,replace=M>len(z['r']))\n  args=(z['x'][ai],z['y'][ai],z['r'][bi],z['ry'][bi],int(z['seed']))\n  t=time.perf_counter();target=np.asarray(canonical.value(*args));dt=time.perf_counter()-t\n  targets.append({'case':case,'n':N,'m':M,'rngseed':rngseed,'canonical_seconds':dt})\n  b=np.argsort(-target,kind='stable')[:N//4]\n  for name,mod in zip(names,mods):\n   t=time.perf_counter();out=np.asarray(mod.value(*args));dt=time.perf_counter()-t\n   nr=float(np.sqrt(np.mean((out-target)**2))/target.std());rho=float(spearmanr(out,target).statistic)\n   a=np.argsort(-out,kind='stable')[:N//4];top=len(set(a)&set(b))/(N//4)\n   rec={'source':name,'case':case,'n':N,'m':M,'rngseed':rngseed,'nrmse':nr,'rho':rho,'top':top,'seconds':dt,'valid':bool(out.shape==(N,) and np.isfinite(out).all() and nr<=.01 and rho>=.999 and top>=.98)}\n   records.append(rec);print(json.dumps(rec),flush=True)\nsummary=[]\nfor name in names:\n rr=[r for r in records if r['source']==name]\n s={'source':name,'cases':len(rr),'valid':all(r['valid'] for r in rr),'worst_nrmse':max(r['nrmse'] for r in rr),'min_rho':min(r['rho'] for r in rr),'min_top':min(r['top'] for r in rr)}\n summary.append(s);print('SUMMARY',json.dumps(s),flush=True)\n(root/'episode12_size_stress.json').write_text(json.dumps({'targets':targets,'summary':summary,'records':records},indent=2))\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

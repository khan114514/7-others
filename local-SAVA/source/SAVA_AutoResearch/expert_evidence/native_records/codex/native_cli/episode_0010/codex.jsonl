{"type": "item.started", "item": {"id": "item_18", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/research_history/episode10_build_round1.py <<'PY'\nfrom pathlib import Path\nimport json,hashlib\nroot=Path('/tmp/research_history');base=(root/'554_episode9_shared_coupling_cancel_gemm_columns/method.py').read_text();entries=[]\ndef save(num,name,s,h):\n d=root/f'{num}_episode10_{name}';d.mkdir(exist_ok=True);(d/'method.py').write_text(s)\n entries.append({'name':d.name,'sha256':hashlib.sha256(s.encode()).hexdigest(),'hypothesis':h})\na=base.index('def _dual');b=base.index('def _label_cost');dual=base[a:b]\nold='''            K.mul_((m/rs).sqrt()[:,None]).mul_((n/cs).sqrt()[None,:])\n            if abs(pe/eps-4.)<1e-5:\n                K.square_().square_()\n            else:K.pow_(pe/eps)'''\nfor num,tile in [(566,64),(567,128),(568,256),(569,512)]:\n new=f'''            ar=(m/rs).sqrt();bc=(n/cs).sqrt()\n            rows=torch.empty(n);cols=torch.zeros(m)\n            q=pe/eps\n            for start in range(0,n,{tile}):\n                stop=min(start+{tile},n);part=K[start:stop]\n                part.mul_(ar[start:stop,None]).mul_(bc[None,:])\n                if abs(q-4.)<1e-5:part.square_().square_()\n                else:part.pow_(q)\n                rows[start:stop]=part.sum(1)\n                cols.add_(part.sum(0))'''\n s=dual.replace(old,new).replace('''            rs=K.sum(1);cs=K.sum(0)''','''            rs=rows;cs=cols''')\n assert old in dual and s\"'!=dual\n save(num,f'\"'point_recurrence_tile{tile}',base[:a]+s+base[b:],f'Cache-block point kernel scaling/fourth powers and marginal reductions into{tile}-row tiles; full dense supports and fallback retained.')\n# Compare matrix product marginal dispatch with regular reductions.\nfor num,name,rows,cols in [(570,'point_gemm_marginals',True,True),(571,'point_gemm_columns',False,True),(572,'point_gemm_rows',True,False)]:\n s=dual.replace('''    shift=0.''','''    shift=0.\n    rowones=torch.ones((n,1));colones=torch.ones((m,1))''',1)\n for var in ('R','K'):\n  if rows:s=s.replace(f'{var}.sum(1)',f'({var} @ colones)[:,0]')\n  if cols:s=s.replace(f'{var}.sum(0)',f'({var}.T @ rowones)[:,0]')\n save(num,name,base[:a]+s+base[b:],'Replace point marginal sums by GEMM against two-dimensional all-ones columns; isolate row/column physical reduction kernels without changing objectives.')\na=base.index('def _label_cost');b=base.index('def _expectation');cl=base[a:b]\nfor num,name,rows,cols in [(573,'class_bmm_marginals',True,True),(574,'class_bmm_columns',False,True),(575,'class_bmm_rows',True,False)]:\n s=cl.replace('''    amask =''','''    rowones=torch.ones((100,nmax,1));colones=torch.ones((100,mmax,1))\n    amask =''',1)\n if rows:s=s.replace('K.sum(2)','torch.bmm(K,colones)[:,:,0]')\n if cols:s=s.replace('K.sum(1)','torch.bmm(K.transpose(1,2),rowones)[:,:,0]')\n save(num,name,base[:a]+s+base[b:],'Replace padded class marginal sums by BMM against all-ones columns, preserving masks, finite schedule and all empirical supports.')\n(root/'episode10_round1_manifest.json').write_text(json.dumps(entries,indent=2));print(json.dumps(entries,indent=2))\nPY\npython /tmp/research_history/episode10_build_round1.py\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

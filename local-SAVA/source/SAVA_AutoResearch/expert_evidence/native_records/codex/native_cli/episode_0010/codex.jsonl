n', 33, -1))\\\")\"}\n{\"name\": \"597_episode10_point_column_kernel_gemm_marginals\", \"case\": \"seed_101_asymmetric_labels\", \"seconds\": 8.330098353326321e-07, \"valid\": false, \"error\": \"RuntimeError(\\\"IndentationError('unexpected indent', ('/tmp/research_history/597_episode10_point_column_kernel_gemm_marginals/method.py', 33, 12, '            rowmax=R.amax(1);colmax=R.amax(0)\\\\\\\\n', 33, -1))\\\")\"}\n{\"name\": \"598_episode10_point_exp_gemm_columns\", \"case\": \"seed_101_asymmetric_labels\", \"seconds\": 0.03760691599745769, \"nrmse\": 0.005729378697395691, \"rho\": 0.9999815693312855, \"top\": 0.9986666666666667, \"valid\": true}\n{\"name\": \"599_episode10_class_exp_gemm_columns\", \"case\": \"seed_101_asymmetric_labels\", \"seconds\": 0.05010354099795222, \"nrmse\": 0.0057293816506111764, \"rho\": 0.9999815808868422, \"top\": 0.9986666666666667, \"valid\": true}\n    la=float(np.log(np.float32(1./n)));lb=float(np.log(np.float32(1./m)))\n    shift=0.\n    def direct(f,g,eps):\n        R=torch.empty((m,n)).T\n        torch.sub(C,f[:,None],out=R);R.sub_(g[None,:])\n        if eps<=2.:\n            return f+R.amin(1)-eps*lb,g+R.amin(0)-eps*la,None,0.,None,None\n        if step==0 and (float(f.max())+float(g.max()))/eps<60.:\n            rm=0.\n            R.mul_(-1.4426950408889634/eps).exp2_()\n        else:\n            rm=float(R.min());R-=rm;R.mul_(-1.4426950408889634/eps).exp2_()\n        rs=R.sum(1);cs=R.sum(0)\n        if min(float(rs.min()),float(cs.min()))<=2e-22:\n            R=torch.empty((m,n)).T\n        torch.sub(C,f[:,None],out=R);R.sub_(g[None,:]);R*=(-1./eps)\n            rowmax=R.amax(1);colmax=R.amax(0)\n            rr=torch.exp(R-rowmax[:,None]).sum(1);cc=torch.exp(R-colmax[None,:]).sum(0)\n            return f-eps*(rowmax+rr.log()+lb),g-eps*(colmax+cc.log()+la),None,0.,None,None\n        return f+rm-eps*(rs.log()+lb),g+rm-eps*(cs.log()+la),R,rm,rs,cs\n    f,g=initial\n    \n    K=None;rs=None;cs=None\n    pe=schedule[0]\n    point_steps=schedule[3:-3]\n    for step,eps in enumerate(point_steps):\n        last=step==len(point_steps)-1\n        if last and (K is None or eps<=2.):\n            if eps<=2.:g=(g+(C-f[:,None]).amin(0)-eps*la)*.5\n            else:g=(g-eps*(((f[:,None]-C)/eps).logsumexp(0)+la))*.5\n            break\n        if K is None or eps<=2.:\n            ft,gt,K,shift,rs,cs=direct(f,g,eps)\n", "exit_code": 0, "status": "completed"}}

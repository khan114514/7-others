{"type": "item.started", "item": {"id": "item_31", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/research_history/episode10_bench.py <<'PY'\nimport subprocess,sys,json\nfrom pathlib import Path\nimport numpy as np\nroot=Path('/tmp/research_history');names=sys.argv[2:];roundname=sys.argv[1]\nchild='''import importlib.util,sys,time,json\nimport numpy as np\np=sys.argv[1];spec=importlib.util.spec_from_file_location('candidate',p);m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)\nz=np.load('/workspace/environment/public_assets/dev/'+sys.argv[2]+'.npz');args=(z['x'],z['y'],z['r'],z['ry'],int(z['seed']))\nt=time.perf_counter();v=m.value(*args);dt=time.perf_counter()-t\nprint(json.dumps({'time':dt,'std':float(v.std())}))\n'''\nrecords=[];cases=['seed_303_gaussian_016','seed_202_uniform_labels','seed_505_mixed']\nfor t in range(6):\n for k in (range(len(names)) if t%2==0 else range(len(names)-1,-1,-1)):\n  case=cases[t%3];z=json.loads(subprocess.run([sys.executable,'-c',child,str(root/names[k]/'method.py'),case],check=True,capture_output=True,text=True).stdout)\n  records.append({'name':names[k],'round':t,'case':case,**z})\n  print(json.dumps(records[-1]),flush=True)\nsummary=[{'name':n,'median':float(np.median([r['time'] for r in records if r['name']==n])),'mean':float(np.mean([r['time'] for r in records if r['name']==n]))} for n in names]\nfor r in summary:print('SUMMARY',json.dumps(r),flush=True)\n(root/(roundname+'.json')).write_text(json.dumps({'records':records,'summary':summary},indent=2))\nPY\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

{"type": "item.started", "item": {"id": "item_30", "type": "command_execution", "command": "/bin/sh -lc \"cd /workspace/solution && python -c \\\"\nimport numpy as np\nimport sys, time\nimport method\nimport importlib.util\nspec = importlib.util.spec_from_file_location('m4', 'method_v4.py')\nm4 = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(m4)\n\ndata = np.load('/workspace/environment/public_assets/dev/seed_101_uniform_labels.npz')\nx = data['x']; y = data['y']; r = data['r']; ry = data['ry']\n\n# Canonical F and Q\nimport ot\nfrom scipy.spatial.distance import cdist\nfrom geomloss import SamplesLoss\nimport torch\n\nbatch_size = 1024\nx32 = np.asarray(x, np.float32); r32 = np.asarray(r, np.float32)\ny64 = np.asarray(y, np.int64); ry64 = np.asarray(ry, np.int64)\ntx = [np.arange(i, min(i+batch_size, len(x))) for i in range(0, len(x), batch_size)]\ntr = [np.arange(i, min(i+batch_size, len(r))) for i in range(0, len(r), batch_size)]\n\nW = method._label_cost(x32[tx[0]], y64[tx[0]], r32[tr[0]], ry64[tr[0]])\ndef cost(z1,z2):\n    d=torch.cdist(z1[:,:,:-1],z2[:,:,:-1]).square()/2\n    return d+torch.as_tensor(W)[z1[:,:,-1].long().unsqueeze(2),z2[:,:,-1].long().unsqueeze(1)]/2\npotential=SamplesLoss('sinkhorn',p=2,blur=np.sqrt(.1),debias=False,potentials=True,cost=cost,backend='tensorized')\n\nF_canon = {}; bc_canon = np.zeros((len(tx), len(tr)))\nF_v4 = {}; bc_v4 = np.zeros((len(tx), len(tr)))\nreg = 0.1\n\nfor i,idx in enumerate(tx):\n    for j,jdx in enumerate(tr):\n        a=x32[idx]; b=r32[jdx]\n        C=cdist(a,b,'sqeuclidean')/2+W[y64[idx,None],ry64[jdx][None,:]+10]/2\n        P=ot.sinkhorn(ot.unif(len(idx)),ot.unif(len(jdx)),C/max(float(C.max()),1e-12),.1)\n        bc_canon[i,j]=float(np.sum(P*C))/(len(idx)+len(jdx))\n        z1=torch.tensor(np.column_stack([a,y64[idx]]),dtype=torch.float32)[None]\n        z2=torch.tensor(np.column_stack([b,ry64[jdx]+10]),dtype=torch.float32)[None]\n        with torch.inference_mode(): f,_=potential(z1,z2)\n        f=f.numpy().ravel().astype(float)\n        F_canon[i,j]=(f-f.mean())*len(f)/(len(f)-1)\n        # v4: derive P from f, g at reg=0.1\n        # We need g too - let me re-run\n        with torch.inference_mode(): f_t, g_t = potential(z1,z2)\n        f2 = f_t.numpy().ravel().astype(np.float64)\n        g2 = g_t.numpy().ravel().astype(np.float64)\n        P_v4 = np.exp((f2[:,None] + g2[None,:] - C) / reg)\n        bc_v4[i,j] = np.sum(P_v4 * C) / (len(idx)+len(jdx))\n        F_v4[i,j] = (f2 - f2.mean()) * len(f2) / (len(f2)-1)\n\nprint('Canonical batchcost:')\nprint(bc_canon)\nprint('v4 batchcost:')\nprint(bc_v4)\nprint('Ratio bc_v4/bc_canon:')\nprint(bc_v4 / bc_canon)\n\n# Q canonical\nQ_canon = ot.sinkhorn(ot.unif(len(tx)), ot.unif(len(tr)),\n    bc_canon/max(float(bc_canon.max()),1e-12), .01, numItermax=10000, stopThr=1e-10)\nQ_v4 = ot.sinkhorn(ot.unif(len(tx)), ot.unif(len(tr)),\n    bc_v4/max(float(bc_v4.max()),1e-12), .01, numItermax=10000, stopThr=1e-10)\nprint('Q canonical:')\nprint(Q_canon)\nprint('Q v4:')\nprint(Q_v4)\n\n# Test: use v4 F but canonical Q\nv_fcanon_qcanon = np.zeros(len(x))\nfor i,idx in enumerate(tx): v_fcanon_qcanon[idx] = sum(Q_canon[i,j]*F_canon[i,j] for j in range(len(tr)))\nv_fv4_qcanon = np.zeros(len(x))\nfor i,idx in enumerate(tx): v_fv4_qcanon[idx] = sum(Q_canon[i,j]*F_v4[i,j] for j in range(len(tr)))\nv_fcanon_qv4 = np.zeros(len(x))\nfor i,idx in enumerate(tx): v_fcanon_qv4[idx] = sum(Q_v4[i,j]*F_canon[i,j] for j in range(len(tr)))\nv_fv4_qv4 = np.zeros(len(x))\nfor i,idx in enumerate(tx): v_fv4_qv4[idx] = sum(Q_v4[i,j]*F_v4[i,j] for j in range(len(tr)))\n\nfrom scipy.stats import spearmanr\ndef metrics(pred, ref):\n    nrmse = np.sqrt(np.mean((pred-ref)**2)) / np.std(ref)\n    spear = spearmanr(pred, ref)[0]\n    n_top = len(pred)//4\n    top_r = set(np.argsort(-ref)[:n_top])\n    top_p = set(np.argsort(-pred)[:n_top])\n    overlap = len(top_r & top_p) / n_top\n    return nrmse, spear, overlap\n\nprint('F_canon+Q_canon (should be
{"type": "item.started", "item": {"id": "item_41", "type": "command_execution", "command": "/bin/sh -lc \"python3 -c \\\"\nimport numpy as np\nimport ot\nfrom scipy.spatial.distance import cdist\n\nnp.random.seed(0)\nn, m = 200, 150\na = np.random.randn(n, 10).astype(np.float32)\nb = np.random.randn(m, 10).astype(np.float32)\nC = cdist(a, b, 'sqeuclidean') / 2.0\nreg = 0.1\n\n# Standard POT sinkhorn\nP_std = ot.sinkhorn(ot.unif(n), ot.unif(m), C, reg)\ncost_std = np.sum(P_std * C) / (n + m)\n\n# Log-domain sinkhorn with log=True\nresult = ot.sinkhorn(ot.unif(n), ot.unif(m), C, reg, method='sinkhorn_log', log=True)\nprint('type of result:', type(result))\nif isinstance(result, tuple):\n    print('len:', len(result))\n    P_log, log_dict = result\n    print('log_dict keys:', log_dict.keys())\n    log_u = log_dict['logu']\n    log_v = log_dict['logv']\n    print('log_u shape:', log_u.shape, 'log_v shape:', log_v.shape)\n    print('cost_std:', cost_std)\n    print('cost_log (P_log):', np.sum(P_log * C) / (n + m))\n    # Check: P_log = diag(u) K diag(v) where u = exp(log_u), v = exp(log_v)\n    u = np.exp(log_u)\n    v = np.exp(log_v)\n    K = np.exp(-C / reg)\n    P_recon = u[:, None] * K * v[None, :] * ot.unif(n)[:, None]\n    print('cost_recon:', np.sum(P_recon * C) / (n + m))\n    print('P_recon row sums[0:3]:', P_recon.sum(1)[:3])\n    print('P_log row sums[0:3]:', P_log.sum(1)[:3])\n    print('P_std row sums[0:3]:', P_std.sum(1)[:3])\nelse:\n    print(result)\n\\\"\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

{"type": "item.started", "item": {"id": "item_34", "type": "command_execution", "command": "/bin/sh -lc \"cat > /workspace/solution/method.py << 'PYEOF'\n\\\"\\\"\\\"v9: Single log-domain Sinkhorn per batch pair (POT).\nOne solve yields coupling P (for batchcost) and dual potentials f (for valuation).\nEliminates redundant GeomLoss solve. Label cost uses GeomLoss (same as canonical).\n\\\"\\\"\\\"\nimport numpy as np\nimport torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nimport ot\n\n\ndef _label_cost(x, y, r, ry):\n    xx = torch.tensor(np.concatenate([x, r]), dtype=torch.float32)\n    yy = np.concatenate([y, ry + 10])\n    W = np.zeros((20, 20), dtype=np.float32)\n    loss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\n    with torch.inference_mode():\n        for i in range(20):\n            for j in range(i + 1, 20):\n                if not (yy == i).any() or not (yy == j).any():\n                    raise ValueError('Initial batch lacks a label support')\n                W[i, j] = W[j, i] = float(loss(xx[yy == i], xx[yy == j]))\n    return W\n\n\ndef value(x, y, r, ry, seed=17, batch_size=1024):\n    torch.set_num_threads(2)\n    x = np.asarray(x, np.float32); r = np.asarray(r, np.float32)\n    y = np.asarray(y, np.int64); ry = np.asarray(ry, np.int64)\n    tx = [np.arange(i, min(i + batch_size, len(x))) for i in range(0, len(x), batch_size)]\n    tr = [np.arange(i, min(i + batch_size, len(r))) for i in range(0, len(r), batch_size)]\n\n    W = _label_cost(x[tx[0]], y[tx[0]], r[tr[0]], ry[tr[0]])\n\n    reg = 0.1\n    F = {}\n    batchcost = np.zeros((len(tx), len(tr)))\n\n    for i, idx in enumerate(tx):\n        for j, jdx in enumerate(tr):\n            a = x[idx]; b = r[jdx]\n            C = cdist(a, b, 'sqeuclidean') / 2.0 + W[y[idx, None], ry[jdx][None, :] + 10] / 2.0\n            C_max = float(C.max())\n            a_w = ot.unif(len(idx))\n            b_w = ot.unif(len(jdx))\n\n            log_u, log_v = ot.sinkhorn(a_w, b_w, C / C_max, reg / C_max,\n                                       method='sinkhorn_log', numItermax=2000,\n                                       stopThr=1e-9, log=True)\n            log_P = log_u[:, None] + log_v[None, :] - C / C_max / (reg / C_max)\n            log_P = log_P - np.log(C_max) + np.log(C_max)\n\n            P = np.exp(log_u[:, None] + log_v[None, :] - C / reg) * a_w[:, None]\n\n            batchcost[i, j] = float(np.sum(P * C)) / (len(idx) + len(jdx))\n\n            f = -reg * log_u\n            f = f - f.mean()\n            F[i, j] = f * len(f) / (len(f) - 1)\n\n    Q = ot.sinkhorn(ot.unif(len(tx)), ot.unif(len(tr)),\n                    batchcost / max(float(batchcost.max()), 1e-12), .01,\n                    numItermax=10000, stopThr=1e-10)\n    residual = max(np.max(np.abs(Q.sum(1) - ot.unif(len(tx)))),\n                   np.max(np.abs(Q.sum(0) - ot.unif(len(tr)))))\n    if residual > 1e-6:\n        raise ValueError(f'Unconverged batch transport: {residual}')\n\n    values = np.zeros(len(x))\n    for i, idx in enumerate(tx):\n        values[idx] = sum(Q[i, j] * F[i, j] for j in range(len(tr)))\n    return values\nPYEOF\necho \\\"wrote v9\\\"\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

{"type": "item.completed", "item": {"id": "item_7", "type": "command_execution", "command": "/bin/sh -lc 'cat /workspace/solution/method.py'", "aggregated_output": "\"\"\"v8: GeomLoss potentials + POT label cost.\nSingle GeomLoss solve per batch pair gives both F and batchcost.\nLabel cost uses POT sinkhorn (~2x faster than GeomLoss).\n\"\"\"\nimport numpy as np\nimport torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nimport ot\n\n\ndef _label_cost(x, y, r, ry):\n    \"\"\"Compute label cost matrix using POT Sinkhorn (faster than GeomLoss).\"\"\"\n    xx = np.concatenate([x, r]).astype(np.float64)\n    yy = np.concatenate([y, ry + 10])\n    W = np.zeros((20, 20), dtype=np.float64)\n    reg = 0.1\n\n    class_samples = [xx[yy == k] for k in range(20)]\n    for k in range(20):\n        if len(class_samples[k]) == 0:\n            raise ValueError(\"Initial batch lacks a label support\")\n\n    for i in range(20):\n        xi = class_samples[i]\n        ni = len(xi)\n        a = np.ones(ni) / ni\n        for j in range(i + 1, 20):\n            xj = class_samples[j]\n            nj = len(xj)\n            b = np.ones(nj) / nj\n            C = cdist(xi, xj, \"sqeuclidean\") / 2.0\n            C_max = C.max()\n            P = ot.sinkhorn(a, b, C / C_max, reg / C_max,\n                            numItermax=500, stopThr=1e-6)\n            W[i, j] = W[j, i] = np.sum(P * C)\n    return W.astype(np.float32)\n\n\ndef value(x, y, r, ry, seed=17, batch_size=1024):\n    torch.set_num_threads(2)\n    x = np.asarray(x, np.float32); r = np.asarray(r, np.float32)\n    y = np.asarray(y, np.int64); ry = np.asarray(ry, np.int64)\n    tx = [np.arange(i, min(i + batch_size, len(x))) for i in range(0, len(x), batch_size)]\n    tr = [np.arange(i, min(i + batch_size, len(r))) for i in range(0, len(r), batch_size)]\n\n    W = _label_cost(x[tx[0]], y[tx[0]], r[tr[0]], ry[tr[0]])\n\n    def cost(z1, z2):\n        d = torch.cdist(z1[:, :, :-1], z2[:, :, :-1]).square() / 2\n        return d + torch.as_tensor(W)[z1[:, :, -1].long().unsqueeze(2),\n                                      z2[:, :, -1].long().unsqueeze(1)] / 2\n\n    potential = SamplesLoss(\"sinkhorn\", p=2, blur=np.sqrt(.1), debias=False,\n                            potentials=True, cost=cost, backend=\"tensorized\")\n\n    F = {}\n    batchcost = np.zeros((len(tx), len(tr)))\n\n    for i, idx in enumerate(tx):\n        for j, jdx in enumerate(tr):\n            a = x[idx]; b = r[jdx]\n            z1 = torch.tensor(np.column_stack([a, y[idx]]), dtype=torch.float32)[None]\n            z2 = torch.tensor(np.column_stack([b, ry[jdx] + 10]), dtype=torch.float32)[None]\n            with torch.inference_mode():\n                f, g = potential(z1, z2)\n            f_np = f.numpy().ravel().astype(float)\n            g_np = g.numpy().ravel().astype(float)\n\n            n_src = len(idx); n_tgt = len(jdx)\n            batchcost[i, j] = (f_np.mean() + g_np.mean()) / 2.0 * (n_src * n_tgt) / (n_src + n_tgt)\n\n            F[i, j] = (f_np - f_np.mean()) * len(f_np) / (len(f_np) - 1)\n\n    Q = ot.sinkhorn(ot.unif(len(tx)), ot.unif(len(tr)),\n                    batchcost / max(float(batchcost.max()), 1e-12), .01,\n                    numItermax=10000, stopThr=1e-10)\n    residual = max(np.max(np.abs(Q.sum(1) - ot.unif(len(tx)))),\n                   np.max(np.abs(Q.sum(0) - ot.unif(len(tr)))))\n    if residual > 1e-6:\n        raise ValueError(f\"Unconverged batch transport: {residual}\")\n\n    values = np.zeros(len(x))\n    for i, idx in enumerate(tx):\n        values[idx] = sum(Q[i, j] * F[i, j] for j in range(len(tr)))\n    return values\n", "exit_code": 0, "status": "completed"}}

potential\nf_pot = reg * log_u  # positive\nprint('GeomLoss de-meaned f[:5]:', (f_g - f_g.mean())[:5])\nprint('POT de-meaned f[:5] (reg*logu):', (f_pot - f_pot.mean())[:5])\nprint()\nprint('Correlation:', np.corrcoef(f_g - f_g.mean(), f_pot - f_pot.mean())[0,1])\nprint()\n\n# Try negation\nprint('POT de-meaned -f[:5]:', (-f_pot + f_pot.mean())[:5])\nprint('Correlation (-f):', np.corrcoef(f_g - f_g.mean(), -f_pot + f_pot.mean())[0,1])\nprint()\n\n# Try scaling by something\nfor scale in [0.5, 1.0, 2.0, 0.25, 4.0]:\n    print(f'scale={scale}, corr:', np.corrcoef(f_g - f_g.mean(), scale*(f_pot - f_pot.mean()))[0,1])\n\\\"\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

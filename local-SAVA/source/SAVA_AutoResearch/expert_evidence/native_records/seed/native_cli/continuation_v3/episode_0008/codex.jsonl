{"type": "item.started", "item": {"id": "item_49", "type": "command_execution", "command": "/bin/sh -lc \"python3 -c \\\"\nimport numpy as np\nimport torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nimport ot\n\nnp.random.seed(42)\nn, m = 100, 80\na_np = np.random.randn(n, 10).astype(np.float32)\nb_np = np.random.randn(m, 10).astype(np.float32)\n\n# Check: what does GeomLoss compute as loss value?\nloss_fn = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(0.1), debias=False, backend='tensorized')\na_t = torch.tensor(a_np, dtype=torch.float32)[None]\nb_t = torch.tensor(b_np, dtype=torch.float32)[None]\nwith torch.inference_mode():\n    loss_val = float(loss_fn(a_t, b_t))\n    f_g, g_g = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(0.1), debias=False,\n                           potentials=True, backend='tensorized')(a_t, b_t)\nf_g = f_g.numpy().ravel()\ng_g = g_g.numpy().ravel()\n\nprint('GeomLoss loss value:', loss_val)\nprint('GeomLoss mean(f)+mean(g):', f_g.mean() + g_g.mean())\nprint('GeomLoss loss == mean(f)+mean(g)?', abs(loss_val - (f_g.mean()+g_g.mean())))\nprint()\n\n# POT with reg=0.1\nC = cdist(a_np, b_np, 'sqeuclidean') / 2.0\nreg = 0.1\nP_log, log_dict = ot.sinkhorn(ot.unif(n), ot.unif(m), C, reg, method='sinkhorn_log', log=True)\nlog_u = log_dict['log_u']\nlog_v = log_dict['log_v']\n\n# Compute full entropic cost: <P,C> + reg * (P*log(P) - P*log(a) - P*log(b) + P)\na_w = ot.unif(n); b_w = ot.unif(m)\npc = np.sum(P_log * C)\nkl = np.sum(P_log * np.log(P_log + 1e-300)) - np.sum(P_log * np.log(a_w[:, None])) - np.sum(P_log * np.log(b_w[None, :])) + np.sum(P_log)\nprint('POT <P,C>    :', pc)\nprint('POT entropic :', pc + reg * kl)\nprint()\n\n# Different convention: maybe POT uses KL(P|a*b\"'^T) = sum P log(P/(a b''^T))\nkl2 = np.sum(P_log * (np.log(P_log + 1e-300) - np.log(a_w[:, None]) - np.log(b_w[None, :])))\nprint('\"'POT entropic (KL = P log(P/(a b\"'^T))):'\"', pc + reg * kl2)\nprint()\n\n# GeomLoss with different blur values\nfor blur_val in [0.1, np.sqrt(0.1), 0.3162, 0.5, 1.0]:\n    loss_fn2 = SamplesLoss('sinkhorn', p=2, blur=blur_val, debias=False, backend='tensorized')\n    with torch.inference_mode():\n        lv = float(loss_fn2(a_t, b_t))\n    print(f'blur={blur_val:.4f}, loss={lv:.6f}')\n\\\"\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

{"type": "item.started", "item": {"id": "item_58", "type": "command_execution", "command": "/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np\nimport time\nimport ot\nfrom scipy.spatial.distance import cdist\n\nnp.random.seed(42)\nN, M = 1024, 1024\nx = np.random.randn(N, 10).astype(np.float64)\nr = np.random.randn(M, 10).astype(np.float64)\ny = np.random.randint(0, 10, N)\nry = np.random.randint(0, 10, M)\n\nW = np.random.rand(20, 20).astype(np.float64) * 4\nW = (W + W.T)\nC = cdist(x, r, 'sqeuclidean') / 2.0 + W[y[:,None], ry[None,:]+10] / 2.0\nC_max = C.max()\nC_norm = C / C_max\n\na = np.ones(N) / N\nb = np.ones(M) / M\nreg = 0.1\n\n# Time just ot.sinkhorn\nt0 = time.time()\nfor _ in range(10):\n    P = ot.sinkhorn(a, b, C_norm, reg, numItermax=10000, stopThr=1e-10)\nprint(f'ot.sinkhorn x10: {time.time()-t0:.4f}s')\n\n# Time ot.sinkhorn + K computation + potential recovery\nt0 = time.time()\nfor _ in range(10):\n    P = ot.sinkhorn(a, b, C_norm, reg, numItermax=10000, stopThr=1e-10)\n    K = np.exp(-C_norm / reg)\n    v = np.ones_like(b)\n    for _ in range(5):\n        u = a / (K  @  v)\n        v = b / (K.T  @  u)\n    f = reg * np.log(u)\nprint(f'ot.sinkhorn + K + potentials x10: {time.time()-t0:.4f}s')\n\n# Compare with GeomLoss\nimport torch\nfrom geomloss import SamplesLoss\nWf = W.astype(np.float32)\ndef cost(z1, z2):\n    d = torch.cdist(z1[:, :, :-1], z2[:, :, :-1]).square() / 2\n    return d + torch.as_tensor(Wf)[z1[:, :, -1].long().unsqueeze(2),\n                                  z2[:, :, -1].long().unsqueeze(1)] / 2\npotential = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                        potentials=True, cost=cost, backend='tensorized')\nz1 = torch.tensor(np.column_stack([x.astype(np.float32), y]), dtype=torch.float32)[None]\nz2 = torch.tensor(np.column_stack([r.astype(np.float32), ry + 10]), dtype=torch.float32)[None]\nt0 = time.time()\nfor _ in range(10):\n    with torch.inference_mode():\n       
{"type": "item.started", "item": {"id": "item_70", "type": "command_execution", "command": "/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np\nimport time\nimport ot\nfrom scipy.spatial.distance import cdist\n\nnp.random.seed(42)\nN, M = 2048, 2048\nx = np.random.randn(N, 10).astype(np.float64)\nr = np.random.randn(M, 10).astype(np.float64)\ny = np.random.randint(0, 10, N)\nry = np.random.randint(0, 10, M)\n\nW = np.abs(np.random.randn(20, 20)) * 5\nW = (W + W.T) / 2\n\nt0 = time.time()\nC = cdist(x, r, 'sqeuclidean') / 2.0 + W[y[:,None], ry[None,:]+10] / 2.0\nC_max = C.max()\nC_norm = C / C_max\nprint(f'C computation: {time.time()-t0:.3f}s, shape: {C.shape}, C_max={C_max:.2f}')\n\na = np.ones(N) / N\nb = np.ones(M) / M\nreg = 0.1\n\nt0 = time.time()\nP = ot.sinkhorn(a, b, C_norm, reg, numItermax=10000, stopThr=1e-10)\nprint(f'ot.sinkhorn 2048x2048: {time.time()-t0:.3f}s')\n\n# K computation\nt0 = time.time()\nK = np.exp(-C_norm / reg)\nprint(f'K computation: {time.time()-t0:.3f}s')\n\n# Potential recovery\nt0 = time.time()\nv = np.ones_like(b)\nfor _ in range(5):\n    u = a / (K  @  v)\n    v = b / (K.T  @  u)\nf = reg * np.log(u)\nprint(f'Potential recovery (5 iters): {time.time()-t0:.3f}s')\n\n# Batch cost\nt0 = time.time()\nbc = np.sum(P * C_norm) * C_max / (N + M)\nprint(f'Batch cost: {time.time()-t0:.3f}s')\n\\\" 2>&1 | grep -v UserWarning\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

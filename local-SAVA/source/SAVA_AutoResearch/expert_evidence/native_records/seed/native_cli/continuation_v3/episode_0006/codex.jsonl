{"type": "item.started", "item": {"id": "item_42", "type": "command_execution", "command": "/bin/sh -lc \"cat > /workspace/solution/method.py << 'PYEOF'\n\\\"\\\"\\\"v6: POT-based Sinkhorn for all solves.\n- One POT sinkhorn solve per batch pair gives both coupling and potentials\n- Label cost also uses POT sinkhorn (no GeomLoss at all)\n- Precomputed cost matrices avoid per-iteration custom cost evaluation\n\\\"\\\"\\\"\nimport numpy as np\nimport ot\nfrom scipy.spatial.distance import cdist\n\n\ndef _sinkhorn_log(a, b, C, reg, numItermax=10000, stopThr=1e-10):\n    \\\"\\\"\\\"Log-domain Sinkhorn. Returns P, f, g where P = diag(exp(f/reg)) K diag(exp(g/reg)).\n    OT entropic cost = sum(a*f) + sum(b*g) = sum(P*C) + reg*KL(P || ab\"'^T).\n    \"\"\"\n    a = np.asarray(a, dtype=np.float64)\n    b = np.asarray(b, dtype=np.float64)\n    C = np.asarray(C, dtype=np.float64)\n    \n    log_a = np.log(a)\n    log_b = np.log(b)\n    log_u = np.zeros_like(a)\n    log_v = np.zeros_like(b)\n    \n    for i in range(numItermax):\n        log_v_prev = log_v\n        M = -C / reg + log_v[None, :]\n        log_u = log_a - np.log(np.sum(np.exp(M), axis=1))\n        M = -C / reg + log_u[:, None]\n        log_v = log_b - np.log(np.sum(np.exp(M), axis=0))\n        \n        if i % 10 == 9:\n            if np.abs(log_v - log_v_prev).max() < stopThr:\n                break\n    \n    f = reg * log_u\n    g = reg * log_v\n    P = np.exp(log_u[:, None] + log_v[None, :] - C / reg)\n    return P, f, g\n\n\ndef _label_cost_fast(x, y, r, ry):\n    \"\"\"Compute label cost matrix using log-domain Sinkhorn.\n    Equivalent to GeomLoss SamplesLoss('\"'sinkhorn', p=2, blur=sqrt(0.1), debias=False).\n    blur\"'^2 = reg = 0.1\n    \"\"\"\n    xx = np.concatenate([x, r])\n    yy = np.concatenate([y, ry + 10])\n    W = np.zeros((20, 20), dtype=np.float64)\n    reg = 0.1\n    \n    class_samples = []\n    for k in range(20):\n        mask = yy == k\n        if not mask.any():\n            raise ValueError('\"'Initial batch lacks a label support')\n        class_samples.append(xx[mask].astype(np.float64))\n    \n    for i in range(20):\n        xi = class_samples[i]\n        ni = len(xi)\n        a = np.ones(ni) / ni\n        for j in range(i + 1, 20):\n            xj = class_samples[j]\n            nj = len(xj)\n            b = np.ones(nj) / nj\n            C = cdist(xi, xj, 'sqeuclidean') / 2.0\n            C_max = C.max()\n            P, f, g = _sinkhorn_log(a, b, C / C_max, reg / C_max,\n                                    numItermax=500, stopThr=1e-8)\n            # Sinkhorn divergence (entropic OT cost) = sum(a*f_scaled) + sum(b*g_scaled)\n            # where f_scaled = f * C_max for the unscaled problem\n            W[i, j] = W[j, i] = C_max * (np.sum(a * f) + np.sum(b * g))\n    return W.astype(np.float32)\n\n\ndef value(x, y, r, ry, seed=17, batch_size=1024):\n    x = np.asarray(x, np.float32)\n    r = np.asarray(r, np.float32)\n    y = np.asarray(y, np.int64)\n    ry = np.asarray(ry, np.int64)\n    \n    tx = [np.arange(i, min(i + batch_size, len(x))) for i in range(0, len(x), batch_size)]\n    tr = [np.arange(i, min(i + batch_size, len(r))) for i in range(0, len(r), batch_size)]\n    \n    W = _label_cost_fast(x[tx[0]], y[tx[0]], r[tr[0]], ry[tr[0]])\n    W64 = W.astype(np.float64)\n    \n    F = {}\n    batchcost = np.zeros((len(tx), len(tr)), dtype=np.float64)\n    reg = 0.1\n    \n    for i, idx in enumerate(tx):\n        a = x[idx].astype(np.float64)\n        ya = y[idx]\n        ni = len(idx)\n        a_w = np.ones(ni, dtype=np.float64) / ni\n        \n        for j, jdx in enumerate(tr):\n            b = r[jdx].astype(np.float64)\n            yb = ry[jdx]\n            nj = len(jdx)\n            b_w = np.ones(nj, dtype=np.float64) / nj\n            \n            C_eucl = cdist(a, b, 'sqeuclidean') / 2.0\n            C_label = W64[ya[:, None], yb[None, :] + 10] / 2.0\n            C = C_eucl + C_label\n            \n            C_max = max(float(C.max()), 1e-12)\n            P, f, g = _sinkhorn_log(a_w, b_w, C / C_max, reg,\n                                    numItermax=10000, stopThr=1e-10)\n            \n            # Primal cost (sum P*C) scaled back\n            batchcost[i, j] = np.sum(P * (C / C_max)) * C_max / (ni + nj)\n            \n            # Potentials scaled back; canonical normalizes: (f - mean(f)) * n / (n-1)\n            f_unscaled = f * C_max\n            F[i, j] = (f_unscaled - f_unscaled.mean()) * ni / (ni - 1)\n    \n    # Batch-level transport\n    n_tx = len(tx)\n    n_tr = len(tr)\n    bc_max = max(float(batchcost.max()), 1e-12)\n    q_a = np.ones(n_tx) / n_tx\n    q_b = np.ones(n_tr) / n_tr\n    Q, _, _ = _sinkhorn_log(q_a, q_b, batchcost / bc_max, 0.01,\n                            numItermax=10000, stopThr=1e-10)\n    \n    residual = max(np.max(np.abs(Q.sum(1) - 1.0 / n_tx)),\n                   np.max(np.abs(Q.sum(0) - 1.0 / n_tr)))\n    if residual > 1e-6:\n        raise ValueError(f'Unconverged batch transport: {residual}')\n    \n    values = np.zeros(len(x), dtype=np.float64)\n    for i, idx in enumerate(tx):\n        values[idx] = sum(Q[i, j] * F[i, j] for j in range(n_tr))\n    return values\nPYEOF\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

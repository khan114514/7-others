             numItermax=500, stopThr=1e-6\n            )\n            W[i, j] = W[j, i] = C_max * (np.sum(a * f) + np.sum(b * g))\n    return W.astype(np.float32)\n\n\ndef value(x, y, r, ry, seed=17, batch_size=2048):\n    x = np.asarray(x, np.float32)\n    r = np.asarray(r, np.float32)\n    y = np.asarray(y, np.int64)\n    ry = np.asarray(ry, np.int64)\n    \n    tx = [np.arange(i, min(i + batch_size, len(x))) for i in range(0, len(x), batch_size)]\n    tr = [np.arange(i, min(i + batch_size, len(r))) for i in range(0, len(r), batch_size)]\n    \n    W = _label_cost(x[tx[0]], y[tx[0]], r[tr[0]], ry[tr[0]])\n    W64 = W.astype(np.float64)\n    \n    F = {}\n    batchcost = np.zeros((len(tx), len(tr)), dtype=np.float64)\n    reg = 0.1\n    \n    for i, idx in enumerate(tx):\n        a = x[idx].astype(np.float64)\n        ya = y[idx]\n        ni = len(idx)\n        a_w = np.ones(ni, dtype=np.float64) / ni\n        \n        for j, jdx in enumerate(tr):\n            b = r[jdx].astype(np.float64)\n            yb = ry[jdx]\n            nj = len(jdx)\n            b_w = np.ones(nj, dtype=np.float64) / nj\n            \n            C_eucl = cdist(a, b, 'sqeuclidean') / 2.0\n            C_label = W64[ya[:, None], yb[None, :] + 10] / 2.0\n            C = C_eucl + C_label\n            \n            C_max = max(float(C.max()), 1e-12)\n            P, f, g = _sinkhorn_potentials(\n                a_w, b_w, C / C_max, reg,\n                numItermax=10000, stopThr=1e-10\n            )\n            \n            batchcost[i, j] = np.sum(P * (C / C_max)) * C_max / (ni + nj)\n            \n            f_unscaled = f * C_max\n            F[i, j] = (f_unscaled - f_unscaled.mean()) * ni / (ni - 1)\n    \n    n_tx = len(tx)\n    n_tr = len(tr)\n    bc_max = max(float(batchcost.max()), 1e-12)\n    q_a = np.ones(n_tx) / n_tx\n    q_b = np.ones(n_tr) / n_tr\n    Q, _, _ = _sinkhorn_potentials(\n        q_a, q_b, batchcost / bc_max, 0.01,\n        numItermax=10000, stopThr=1e-10\n    )\n    \n    residual = max(np.max(np.abs(Q.sum(1) - 1.0 / n_tx)),\n                   np.max(np.abs(Q.sum(0) - 1.0 / n_tr)))\n    if residual > 1e-6:\n        raise ValueError(f'Unconverged batch transport: {residual}')\n    \n    values = np.zeros(len(x), dtype=np.float64)\n    for i, idx in enumerate(tx):\n        values[idx] = sum(Q[i, j] * F[i, j] for j in range(n_tr))\n    return values\nPYEOF\n\"", "aggregated_output": "", "exit_code": 0, "status": "completed"}}
{"type": "item.started", "item": {"id": "item_68", "type": "command_execution", "command": "/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np\nimport time\nimport importlib\nimport method\nimportlib.reload(method)\n\nnp.random.seed(42)\nfor N, M in [(3000, 2000), (5000, 4000), (8000, 6000)]:\n    x = np.random.randn(N, 10).astype(np.float32)\n    r = np.random.randn(M, 10).astype(np.float32)\n    y = np.random.randint(0, 10, N)\n    ry = np.random.randint(0, 10, M)\n    importlib.reload(method)\n    t0 = time.time()\n    v = method.value(x, y, r, ry, seed=42)\n    print(f'N={N}: {time.time()-t0:.3f}s, mean={v.mean():.6f}')\n\\\" 2>&1 | grep -v UserWarning | grep -v warnings.warn\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

{"type": "item.started", "item": {"id": "item_71", "type": "command_execution", "command": "/bin/sh -lc \"python3 << 'EOF'\nimport numpy as np, sys, time, importlib.util\nfrom scipy.spatial.distance import cdist\nfrom scipy.stats import spearmanr\nimport torch\nfrom geomloss import SamplesLoss\nimport ot\n\nspec = importlib.util.spec_from_file_location('method_canonical', '/tmp/research_history/method_canonical_v0.py')\nmc = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(mc)\n\ndata = np.load('/workspace/environment/public_assets/dev/seed_101_gaussian_008.npz')\nx, y, r, ry = data['x'], data['y'], data['r'], data['ry']\n\ntorch.set_num_threads(2)\nx = np.asarray(x, np.float32); r = np.asarray(r, np.float32)\ny = np.asarray(y, np.int64); ry = np.asarray(ry, np.int64)\n\nbatch_size = 1024\ntx = [np.arange(i, min(i+batch_size, len(x))) for i in range(0, len(x), batch_size)]\ntr = [np.arange(i, min(i+batch_size, len(r))) for i in range(0, len(r), batch_size)]\n\nW = mc._label_cost(x[tx[0]], y[tx[0]], r[tr[0]], ry[tr[0]])\n\ndef cost(z1, z2):\n    d = torch.cdist(z1[:,:,:-1], z2[:,:,:-1]).square()/2\n    return d + torch.as_tensor(W)[z1[:,:,-1].long().unsqueeze(2), z2[:,:,-1].long().unsqueeze(1)]/2\n\npotential = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                       potentials=True, cost=cost, backend='tensorized')\n\n# Canonical values\nprint('Canonical...')\nvals_canon = mc.value(x, y, r, ry, seed=101)\n\n# Compute F from GeomLoss (same potentials as canonical)\nF = {}\ngeom_batchcost = np.zeros((len(tx), len(tr)))\ncentroid_bc = np.zeros((len(tx), len(tr)))\nmeandist_bc = np.zeros((len(tx), len(tr)))\ngeomloss_bc = np.zeros((len(tx), len(tr)))\n\nloss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, cost=cost, backend='tensorized')\n\nt0 = time.time()\nfor i, idx in enumerate(tx):\n    for j, jdx in enumerate(tr):\n        a = x[idx]; b = r[jdx]\n        z1 = torch.tensor(np.column_stack([a, y[idx]]), dtype=torch.float32)[None]\n        z2 = torch.tensor(np.column_stack([b, ry[jdx]+10]), dtype=torch.float32)[None]\n        with torch.inference_mode():\n            f, g = potential(z1, z2)\n            loss_val = loss(z1, z2)\n        f_np = f.numpy().ravel().astype(float)\n        g_np = g.numpy().ravel().astype(float)\n        F[i,j] = (f_np - f_np.mean()) * len(f_np) / (len(f_np) - 1)\n        \n        # Sinkhorn divergence from loss()\n        geomloss_bc[i,j] = float(loss_val) / (len(idx) + len(jdx)) * len(idx) * len(jdx) / (len(idx) + len(jdx))\n        \n        # Entropic OT cost from duals: mean(f) + mean(g)\n        n_src, n_tgt = len(idx), len(jdx)\n        geom_batchcost[i,j] = (f_np.mean() + g_np.mean()) / (n_src + n_tgt) * n_src * n_tgt / (n_src + n_tgt)\n        # simpler: just use (f.mean()+g.mean())/(n+m)\n        geom_batchcost[i,j] = (f_np.mean() + g_np.mean()) / (n_src + n_tgt)\n        \n        # Centroid distance\n        C_full = cdist(a, b, 'sqeuclidean')/2 + W[y[idx,None], ry[jdx][None,:]+10]/2\n        centroid_bc[i,j] = C_full.mean()\n        meandist_bc[i,j] = C_full.mean() / (n_src + n_tgt) * n_src * n_tgt / (n_src + n_tgt)  # no, just keep mean\n\nt1 = time.time()\nprint(f'GeomLoss F + various BC: {t1-t0:.3f}s')\n\n# Canonical batchcosts for reference\ncanon_bc = np.zeros((len(tx), len(tr)))\nfor i, idx in enumerate(tx):\n    for j, jdx in enumerate(tr):\n        a = x[idx]; b = r[jdx]\n        C = cdist(a, b, 'sqeuclidean')/2 + W[y[idx,None], ry[jdx][None,:]+10]/2\n        P = ot.sinkhorn(ot.unif(len(idx)), ot.unif(len(jdx)), C/max(float(C.max()), 1e-12), .1)\n        canon_bc[i,j] = float(np.sum(P*C)) / (len(idx)+len(jdx))\n\nprint(f'Canonical bc:\\\\n{canon_bc}')\nprint(f'GeomLoss dual bc:\\\\n{geom_batchcost}')\nprint(f'Mean distance bc:\\\\n{centroid_bc}')\nprint(f'Geomloss() bc:\\\\n{geomloss_bc}')\n\n# Try Q from each approximation\nfor name, bc in [('geom_dual', geom_batchcost), ('centroid', centroid_bc), ('geomloss', geomloss_bc)]:\n    Q = ot.sinkhorn(ot.unif(len(tx)), ot.unif(len(tr)),\n                    bc / max(float(bc.max()), 1e-12), .01,\n                    numItermax=10000, stopThr=1e-10)\n    vals = np.zeros(len(x))\n    for i, idx in enumerate(tx):\n        vals[idx] = sum(Q[i,j] * F[i,j] for j in range(len(tr)))\n    \n    nrmse = np.sqrt(np.mean((vals - vals_canon)**2)) / np.std(vals_canon)\n    spearman, _ = spearmanr(vals, vals_canon)\n    n = len(vals); k = n // 4\n    idx_c = np.argsort(-vals_canon)[:k]\n    idx_v = np.argsort(-vals)[:k]\n    overlap = len(set(idx_c) & set(idx_v)) / k\n    print(f'Q from {name}: NRMSE={nrmse:.6f}  Spearman={spearman:.6f}  Overlap={overlap:.4f}')\n\n# Also try uniform Q\nQ_unif = np.ones((len(tx), len(tr))) / (len(tx) * len(tr))\nvals_unif = np.zeros(len(x))\nfor i, idx in enumerate(tx):\n    vals_unif[idx] = sum(Q_unif[i,j] * F[i,j] for j in range(len(tr)))\nnrmse = np.sqrt(np.mean((vals_unif - vals_canon)**2)) / np.std(vals_canon)\nspearman, _ = spearmanr(vals_unif, vals_canon)\nidx_v = np.argsort(-vals_unif)[:k]\noverlap = len(set(idx_c) & set(idx_v)) / k\nprint(f'Uniform Q: NRMSE={nrmse:.6f}  Spearman={spearman:.6f}  Overlap={overlap:.4f}')\nEOF\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

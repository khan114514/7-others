{"type": "item.started", "item": {"id": "item_53", "type": "command_execution", "command": "/bin/sh -lc \"python3 << 'EOF'\nimport numpy as np, sys, time, importlib.util\nfrom scipy.spatial.distance import cdist\nimport torch\nfrom geomloss import SamplesLoss\nimport ot\n\n# Load canonical\nspec = importlib.util.spec_from_file_location('method_canonical', '/tmp/research_history/method_canonical_v0.py')\nmc = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(mc)\n\ndata = np.load('/workspace/environment/public_assets/dev/seed_101_gaussian_008.npz')\nx, y, r, ry = data['x'], data['y'], data['r'], data['ry']\n\ntorch.set_num_threads(2)\nx = np.asarray(x, np.float32); r = np.asarray(r, np.float32)\ny = np.asarray(y, np.int64); ry = np.asarray(ry, np.int64)\n\nbatch_size = 1024\ntx = [np.arange(i, min(i+batch_size, len(x))) for i in range(0, len(x), batch_size)]\ntr = [np.arange(i, min(i+batch_size, len(r))) for i in range(0, len(r), batch_size)]\n\nW = mc._label_cost(x[tx[0]], y[tx[0]], r[tr[0]], ry[tr[0]])\n\n# Compare for first batch pair\ni, j = 0, 0\nidx, jdx = tx[i], tr[j]\na = x[idx]; b = r[jdx]\n\n# Canonical POT\nC = cdist(a, b, 'sqeuclidean')/2 + W[y[idx,None], ry[jdx][None,:]+10]/2\nP = ot.sinkhorn(ot.unif(len(idx)), ot.unif(len(jdx)), C/max(float(C.max()), 1e-12), .1)\ncanon_bc = float(np.sum(P*C)) / (len(idx)+len(jdx))\nprint(f'Canonical batchcost[0,0]: {canon_bc:.6f}')\n\n# GeomLoss potentials\ndef cost(z1, z2):\n    d = torch.cdist(z1[:,:,:-1], z2[:,:,:-1]).square()/2\n    return d + torch.as_tensor(W)[z1[:,:,-1].long().unsqueeze(2), z2[:,:,-1].long().unsqueeze(1)]/2\n\npotential = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                       potentials=True, cost=cost, backend='tensorized')\nz1 = torch.tensor(np.column_stack([a, y[idx]]), dtype=torch.float32)[None]\nz2 = torch.tensor(np.column_stack([b, ry[jdx]+10]), dtype=torch.float32)[None]\nwith torch.inference_mode():\n    f, g = potential(z1, z2)\nf_np = f.numpy().ravel().astype(float)\ng_np = g.numpy().ravel().astype(float)\n\nn_src = len(idx); n_tgt = len(jdx)\nprint(f'GeomLoss f mean: {f_np.mean():.6f}, g mean: {g_np.mean():.6f}')\nprint(f'Entropic OT cost (mean f + mean g): {f_np.mean() + g_np.mean():.6f}')\n\n# Canonical: sum(P*C) / (n+m)\n# Let's compute sum(P*C) directly\nprint(f'sum(P*C) = {np.sum(P*C):.6f}')\nprint(f'n+m = {n_src + n_tgt}')\nprint(f'Canonical bc = sum(P*C)/(n+m) = {np.sum(P*C)/(n_src+n_tgt):.6f}')\n\n# Try different formulas for batchcost:\nbc1 = (f_np.mean() + g_np.mean()) / 2.0 * (n_src * n_tgt) / (n_src + n_tgt)\nbc2 = (n_src * f_np.mean() + n_tgt * g_np.mean()) / (n_src + n_tgt)\nbc3 = (f_np.mean() + g_np.mean()) / (n_src + n_tgt)\nprint(f'\\\\nFormula 1: {bc1:.6f}')\nprint(f'Formula 2: {bc2:.6f}')\nprint(f'Formula 3: {bc3:.6f}')\n\n# All batch pairs\ncanon_bcs = np.zeros((len(tx), len(tr)))\ngeom_bcs = np.zeros((len(tx), len(tr)))\nfor i, idx in enumerate(tx):\n    for j, jdx in enumerate(tr):\n        a = x[idx]; b = r[jdx]\n        C = cdist(a, b, 'sqeuclidean')/2 + W[y[idx,None], ry[jdx][None,:]+10]/2\n        P = ot.sinkhorn(ot.unif(len(idx)), ot.unif(len(jdx)), C/max(float(C.max()), 1e-12), .1)\n        canon_bcs[i,j] = np.sum(P*C) / (len(idx)+len(jdx))\n        \n        z1 = torch.tensor(np.column_stack([a, y[idx]]), dtype=torch.float32)[None]\n        z2 = torch.tensor(np.column_stack([b, ry[jdx]+10]), dtype=torch.float32)[None]\n        with torch.inference_mode():\n            f, g = potential(z1, z2)\n        f_np = f.numpy().ravel().astype(float)\n        g_np = g.numpy().ravel().astype(float)\n        geom_bcs[i,j] = (f_np.mean() + g_np.mean()) / 2.0 * (len(idx) * len(jdx)) / (len(idx)+len(jdx))\n\nprint(f'\\\\nCanonical batchcosts:\\\\n{canon_bcs}')\nprint(f'Geomloss batchcosts:\\\\n{geom_bcs}')\nprint(f'Ratio (canon/geom):\\\\n{canon_bcs / geom_bcs}')\nEOF\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

{"type": "item.started", "item": {"id": "item_101", "type": "command_execution", "command": "/bin/sh -lc \"python3 -c \\\"\nimport numpy as np\nfrom scipy.spatial.distance import cdist\nimport ot\nimport time\n\nnp.random.seed(42)\nn, m = 1024, 1024\nC = cdist(np.random.randn(n, 10).astype(np.float64), \n          np.random.randn(m, 10).astype(np.float64), 'sqeuclidean') / 2.0\nC_max = C.max()\na = np.ones(n) / n\nb = np.ones(m) / m\n\n# With default numItermax=1000\nt0 = time.time()\nfor _ in range(5):\n    P = ot.sinkhorn(a, b, C / C_max, 0.1, method='sinkhorn_log')\nt_default = (time.time() - t0) / 5\nprint(f'POT default (numItermax=1000): {t_default*1000:.1f}ms')\n\n# With 50 iters\nt0 = time.time()\nfor _ in range(5):\n    P = ot.sinkhorn(a, b, C / C_max, 0.1, method='sinkhorn_log', numItermax=50, stopThr=0)\nt_50 = (time.time() - t0) / 5\nprint(f'POT 50 iters: {t_50*1000:.1f}ms')\n\n# cdist time\nx = np.random.randn(n, 10).astype(np.float32)\ny = np.random.randn(m, 10).astype(np.float32)\nt0 = time.time()\nfor _ in range(5):\n    C = cdist(x, y, 'sqeuclidean') / 2.0\nt_cdist = (time.time() - t0) / 5\nprint(f'cdist sqeuclidean /2: {t_cdist*1000:.1f}ms')\n\n# GeomLoss\nimport torch\nfrom geomloss import SamplesLoss\ntorch.set_num_threads(2)\nxt = torch.tensor(x, dtype=torch.float32)[None]\nyt = torch.tensor(y, dtype=torch.float32)[None]\nloss_p = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, potentials=True, backend='tensorized')\nwith torch.inference_mode():\n    f, g = loss_p(xt, yt)\nt0 = time.time()\nfor _ in range(5):\n    with torch.inference_mode():\n        f, g = loss_p(xt, yt)\nt_geom = (time.time() - t0) / 5\nprint(f'GeomLoss potentials: {t_geom*1000:.1f}ms')\n\\\"\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

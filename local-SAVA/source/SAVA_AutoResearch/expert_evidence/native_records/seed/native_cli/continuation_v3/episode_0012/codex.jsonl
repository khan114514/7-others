{"type": "item.started", "item": {"id": "item_86", "type": "command_execution", "command": "/bin/sh -lc \"python3 -c \\\"\nimport numpy as np\nimport torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nimport ot\n\n# Simulate a real case with 3 candidate batches, 2 reference batches\nnp.random.seed(101)\nN, M = 3000, 2000\nx = np.random.randn(N, 10).astype(np.float32)\nr = np.random.randn(M, 10).astype(np.float32)\ny = np.random.randint(0, 10, N).astype(np.int64)\nry = np.random.randint(0, 10, M).astype(np.int64)\ntorch.set_num_threads(2)\n\nbatch_size = 1024\ntx = [np.arange(i, min(i + batch_size, len(x))) for i in range(0, len(x), batch_size)]\ntr = [np.arange(i, min(i + batch_size, len(r))) for i in range(0, len(r), batch_size)]\n\n# Canonical label cost\nxx = torch.tensor(np.concatenate([x[tx[0]], r[tr[0]]]), dtype=torch.float32)\nyy = np.concatenate([y[tx[0]], ry[tr[0]] + 10])\nW = np.zeros((20, 20), dtype=np.float32)\nloss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\nwith torch.inference_mode():\n    for i in range(20):\n        for j in range(i + 1, 20):\n            W[i, j] = W[j, i] = float(loss(xx[yy == i], xx[yy == j]))\n\n# Canonical: POT batchcost + GeomLoss potentials + Q transport\ndef cost_fn(z1, z2):\n    d = torch.cdist(z1[:, :, :-1], z2[:, :, :-1]).square() / 2\n    return d + torch.as_tensor(W)[z1[:, :, -1].long().unsqueeze(2), z2[:, :, -1].long().unsqueeze(1)] / 2\n\npotential = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                        potentials=True, cost=cost_fn, backend='tensorized')\n\nF_can = {}\nbatchcost_can = np.zeros((len(tx), len(tr)))\nfor i, idx in enumerate(tx):\n    for j, jdx in enumerate(tr):\n        a = x[idx]; b = r[jdx]\n        C = cdist(a, b, 'sqeuclidean') / 2 + W[y[idx, None], ry[jdx][None, :] + 10] / 2\n        P = ot.sinkhorn(ot.unif(len(idx)), ot.unif(len(jdx)), C / max(float(C.max()), 1e-12), .1, numItermax=10000)\n        batchcost_can[i, j] = float(np.sum(P * C)) / (len(idx) + len(jdx))\n        z1 = torch.tensor(np.column_stack([a, y[idx]]), dtype=torch.float32)[None]\n        z2 = torch.tensor(np.column_stack([b, ry[jdx] + 10]), dtype=torch.float32)[None]\n        with torch.inference_mode(): f, _ = potential(z1, z2)\n        f = f.numpy().ravel().astype(float)\n        F_can[i, j] = (f - f.mean()) * len(f) / (len(f) - 1)\n\nQ = ot.sinkhorn(ot.unif(len(tx)), ot.unif(len(tr)),\n                batchcost_can / max(float(batchcost_can.max()), 1e-12), .01,\n                numItermax=10000, stopThr=1e-10)\n\nvalues_can = np.zeros(len(x))\nfor i, idx in enumerate(tx):\n    values_can[idx] = sum(Q[i, j] * F_can[i, j] for j in range(len(tr)))\n\n# Hypothesis 1: uniform Q (all batches equally weighted)\nvalues_uniform = np.zeros(len(x))\nfor i, idx in enumerate(tx):\n    values_uniform[idx] = sum(1.0/len(tr) * F_can[i, j] for j in range(len(tr)))\n\n# Compare\nnrmse = np.sqrt(np.mean((values_can - values_uniform)**2)) / np.std(values_can)\nspearman = np.corrcoef(np.argsort(np.argsort(-values_can)), np.argsort(np.argsort(-values_uniform)))[0,1]\n# top quartile overlap\nn_top = len(x) // 4\nidx_can = set(np.argsort(-values_can)[:n_top])\nidx_unif = set(np.argsort(-values_uniform)[:n_top])\ntqo = len(idx_can & idx_unif) / n_top\nprint(f'Uniform Q:')\nprint(f'  NRMSE: {nrmse:.6f} (gate: 0.01)')\nprint(f'  Spearman: {spearman:.6f} (gate: 0.999)')\nprint(f'  TQO: {tqo:.6f} (gate: 0.98)')\n\n# Hypothesis 2: 1 big GeomLoss solve (no batching)\nz1 = torch.tensor(np.column_stack([x, y]), dtype=torch.float32)[None]\nz2 = torch.tensor(np.column_stack([r, ry + 10]), dtype=torch.float32)[None]\nwith torch.inference_mode():\n    f_big, g_big = potential(z1, z2)\nf_big_np = f_big.numpy().ravel().astype(float)\nvalues_big = (f_big_np - f_big_np.mean()) * len(f_big_np) / (len(f_big_np) - 1)\n\nnrmse2 = np.sqrt(np.mean((values_can - values_big)**2)) / np.std(values_can)\nspearman2 = np.corrcoef(np.argsort(np.argsort(-values_can)), np.argsort(np.argsort(-values_big)))[0,1]\nidx_big = set(np.argsort(-values_big)[:n_top])\ntqo2 = len(idx_can & idx_big) / n_top\nprint(f'One big GeomLoss solve:')\nprint(f'  NRMSE: {nrmse2:.6f} (gate: 0.01)')\nprint(f'  Spearman: {spearman2:.6f} (gate: 0.999)')\nprint(f'  TQO: {tqo2:.6f} (gate: 0.98)')\n\\\"\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

{"type": "item.started", "item": {"id": "item_43", "type": "command_execution", "command": "/bin/sh -lc \"python3 -c \\\"\nimport numpy as np\nimport torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nimport ot\n\nnp.random.seed(42)\nn, m = 100, 80\nx = np.random.randn(n, 10).astype(np.float32)\ny = np.random.randn(m, 10).astype(np.float32)\n\n# Canonical uses custom cost: d.square()/2 + W/2\n# Let's just test with simple euclidean, no label cost for clarity\nxt = torch.tensor(x, dtype=torch.float32)[None]\nyt = torch.tensor(y, dtype=torch.float32)[None]\n\n# GeomLoss default p=2 Sinkhorn cost is (1/p)*||x-y||\"'^p = 0.5*||x-y||''^2\n# That matches our C = cdist(x,y,'\"'sqeuclidean')/2\nC = cdist(x, y, 'sqeuclidean') / 2.0\nprint('C mean/median/max:', C.mean(), np.median(C), C.max())\n\n# GeomLoss with default\nloss_d = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\nloss_p = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, potentials=True, backend='tensorized')\nwith torch.inference_mode():\n    val = float(loss_d(xt, yt))\n    f_g, g_g = loss_p(xt, yt)\nf_geom = f_g.numpy().ravel()\ng_geom = g_g.numpy().ravel()\n\nprint('GeomLoss Sinkhorn value:', val)\nprint('GeomLoss f mean:', f_geom.mean())\nprint('GeomLoss g mean:', g_geom.mean())\nprint('mean(f)+mean(g):', f_geom.mean() + g_geom.mean())\n\n# Now POT\na = np.ones(n) / n\nb = np.ones(m) / m\n\n# With reg = blur\"'^2 = 0.1 on raw C\nP, logd = ot.sinkhorn(a, b, C, 0.1, method='\"'sinkhorn_log', log=True)\nlog_u = logd['log_u']\nlog_v = logd['log_v']\nf_pot = 0.1 * log_u\ng_pot = 0.1 * log_v\n\nprint()\nprint('POT sum(P*C):', np.sum(P * C))\nprint('POT f mean:', f_pot.mean())\nprint('POT g mean:', g_pot.mean())\nprint('POT mean(f)+mean(g):', f_pot.mean() + g_pot.mean())\n\n# OT primal = sum(P*C), dual = sum(a*f)+sum(b*g)\n# With entropic regularization: dual = primal + reg*H(P)\nprint()\nprint('POT dual (a*f + b*g):', np.sum(a * f_pot) + np.sum(b * g_pot))\nprint('POT primal (P*C):', np.sum(P * C))\nH = -np.sum(P * (np.log(P + 1e-300) - np.log(a[:,None]) - np.log(b[None,:])))\nprint('POT entropic:', np.sum(P*C) + 0.1 * H)\n\n# Hmm, the values don't match. Maybe GeomLoss convention is different.\n# Let me check: maybe f and g are the OTHER way around in GeomLoss?\n# Or maybe GeomLoss uses Sinkhorn divergence (debiased) even with debias=False?\nprint()\nprint('=== checking sign ===')\nprint('GeomLoss f[:3]:', f_geom[:3])\nprint('POT f[:3]:', f_pot[:3])\n\\\"\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

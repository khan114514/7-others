 = torch.tensor(np.column_stack([a, y[idx]]), dtype=torch.float32)[None]\n        z2 = torch.tensor(np.column_stack([b, ry[jdx] + 10]), dtype=torch.float32)[None]\n        with torch.inference_mode(): f, _ = potential(z1, z2)\n        f = f.numpy().ravel().astype(float)\n        F[i, j] = (f - f.mean()) * len(f) / (len(f) - 1)\n\nQ_can = ot.sinkhorn(ot.unif(len(tx)), ot.unif(len(tr)),\n                    batchcost_can / max(float(batchcost_can.max()), 1e-12), .01,\n                    numItermax=10000, stopThr=1e-10)\n\nvalues_can = np.zeros(len(x))\nfor i, idx in enumerate(tx):\n    values_can[idx] = sum(Q_can[i, j] * F[i, j] for j in range(len(tr)))\n\n# Test: POT low-reg batchcost (same reg as GeomLoss, from potentials)\n# This is essentially what v10 does\nbatchcost_low = np.zeros((len(tx), len(tr)))\nreg = 0.1\nfor i, idx in enumerate(tx):\n    for j, jdx in enumerate(tr):\n        a = x[idx]; b = r[jdx]\n        z1 = torch.tensor(np.column_stack([a, y[idx]]), dtype=torch.float32)[None]\n        z2 = torch.tensor(np.column_stack([b, ry[jdx] + 10]), dtype=torch.float32)[None]\n        with torch.inference_mode():\n            f_t, g_t = potential(z1, z2)\n        f_np = f_t.numpy().ravel().astype(np.float64)\n        g_np = g_t.numpy().ravel().astype(np.float64)\n        C = cdist(a, b, 'sqeuclidean') / 2.0 + W[y[idx[:, None]], ry[jdx[None, :]] + 10] / 2.0\n        P = (1.0/len(idx)) * (1.0/len(jdx)) * np.exp((f_np[:, None] + g_np[None, :] - C) / reg)\n        batchcost_low[i, j] = float(np.sum(P * C)) / (len(idx) + len(jdx))\n\nQ_low = ot.sinkhorn(ot.unif(len(tx)), ot.unif(len(tr)),\n                    batchcost_low / max(float(batchcost_low.max()), 1e-12), .01,\n                    numItermax=10000, stopThr=1e-10)\n\nvalues_low_q = np.zeros(len(x))\nfor i, idx in enumerate(tx):\n    values_low_q[idx] = sum(Q_low[i, j] * F[i, j] for j in range(len(tr)))\n\nn_top = len(x) // 4\ndef quality(v1, v2):\n    nrmse = np.sqrt(np.mean((v1 - v2)**2)) / np.std(v1)\n    ranks1 = np.argsort(np.argsort(-v1))\n    ranks2 = np.argsort(np.argsort(-v2))\n    spear = np.corrcoef(ranks1, ranks2)[0,1]\n    tqo = len(set(np.argsort(-v1)[:n_top]) & set(np.argsort(-v2)[:n_top])) / n_top\n    return nrmse, spear, tqo\n\nnrmse, spear, tqo = quality(values_can, values_low_q)\nprint(f'GeomLoss F + low-reg Q (v10 scenario):')\nprint(f'  NRMSE: {nrmse:.6f}')\nprint(f'  Spearman: {spear:.6f}')\nprint(f'  TQO: {tqo:.6f}')\nprint()\n\n# Test: just use mean cost as batchcost proxy (no Sinkhorn needed for batchcost)\n# With correction factor\nratio = batchcost_can / batchcost_low\nprint(f'Ratio can/low:', ratio)\nprint(f'Mean ratio: {ratio.mean():.4f}')\n\n# Correct batchcost_low by factor\nbatchcost_corrected = batchcost_low * ratio.mean()\nQ_corr = ot.sinkhorn(ot.unif(len(tx)), ot.unif(len(tr)),\n                     batchcost_corrected / max(float(batchcost_corrected.max()), 1e-12), .01,\n                     numItermax=10000, stopThr=1e-10)\nvalues_corr = np.zeros(len(x))\nfor i, idx in enumerate(tx):\n    values_corr[idx] = sum(Q_corr[i, j] * F[i, j] for j in range(len(tr)))\nnrmse2, spear2, tqo2 = quality(values_can, values_corr)\nprint(f'GeomLoss F + corrected Q:')\nprint(f'  NRMSE: {nrmse2:.6f}')\nprint(f'  Spearman: {spear2:.6f}')\nprint(f'  TQO: {tqo2:.6f}')\n\\\"\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

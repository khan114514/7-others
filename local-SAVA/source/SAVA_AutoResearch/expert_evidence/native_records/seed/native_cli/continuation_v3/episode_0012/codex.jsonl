)\nprint('Canonical batch cost:', bc_can)\nprint('Ratio:', (f_geom.mean() + g_geom.mean()) / bc_can)\n\n# Let's also compute: what does batchcost look like if we use GeomLoss potentials?\n# The key question is: if we use GeomLoss-based batchcost, is Q similar enough?\n# Q is 3x2 for typical cases - very small.\n\n# Let's try: approximate batchcost as (mean(f) + mean(g)) * n*m / (n+m) / 2? No...\n# Actually canonical: batchcost = sum(P*C) / (n+m)\n# sum(P*C) is the PRIMAL transport cost\n# mean(f) + mean(g) is the DUAL (entropic OT cost)\n# primal = dual - reg * H(P) (approximately, depends on convention)\n\n# Let's just compute primal from GeomLoss P if we could get it\n# P = a_i b_j exp((f_i + g_j - C_ij) / reg)\nreg = 0.1\nP_from_geom = np.outer(np.ones(n)/n, np.ones(m)/m) * np.exp((f_geom[:, None] + g_geom[None, :] - C) / reg)\nprint()\nprint('P_from_geom row sum check:', P_from_geom.sum(1)[:5])\nprint('P_from_geom col sum check:', P_from_geom.sum(0)[:5])\n\nbc_geom = float(np.sum(P_from_geom * C)) / (n + m)\nprint('Batch cost from GeomLoss P:', bc_geom)\nprint('Canonical batch cost:', bc_can)\nprint('Ratio geom/can:', bc_geom / bc_can)\n\\\"\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

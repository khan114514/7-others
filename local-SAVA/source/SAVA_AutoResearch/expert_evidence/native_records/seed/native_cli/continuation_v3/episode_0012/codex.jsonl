erence_mode():\n    f_geom, g_geom = potential(z1, z2)\nf_geom_np = f_geom.numpy().ravel().astype(np.float64)\nf_geom_centered = (f_geom_np - f_geom_np.mean()) * len(f_geom_np) / (len(f_geom_np) - 1)\n\n# POT with same reg=0.1 on raw C\na_w = np.ones(len(idx)) / len(idx)\nb_w = np.ones(len(jdx)) / len(jdx)\nP_pot, logd = ot.sinkhorn(a_w, b_w, C, 0.1, method='sinkhorn_log', log=True, numItermax=5000)\nf_pot = 0.1 * logd['log_u']\nf_pot_centered = (f_pot - f_pot.mean()) * len(f_pot) / (len(f_pot) - 1)\n\n# Compare\ncorr = np.corrcoef(f_geom_centered, f_pot_centered)[0,1]\nprint(f'POT reg=0.1 raw C vs GeomLoss:')\nprint(f'  Correlation: {corr:.6f}')\nprint(f'  Max diff (centered): {np.abs(f_geom_centered - f_pot_centered).max():.6f}')\nprint(f'  Ratio geom/pot (centered): {f_geom_centered[:5] / f_pot_centered[:5]}')\n\n# Wait, these should be the same\"'! Let me check...\n# Maybe POT uses different convention (flipped sign?)\n# Or maybe GeomLoss uses Sinkhorn DIVERGENCE (debiased) even with debias=False?\n# Let me check the Sinkhorn value\ngeom_val = float(SamplesLoss('\"'sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized', cost=cost_fn)(z1, z2))\nprint(f'  GeomLoss value: {geom_val:.6f}')\nprint(f'  POT sum(P*C): {np.sum(P_pot * C):.6f}')\nprint(f'  POT dual (a*f + b*g): {np.sum(a_w * 0.1*logd[\\\\\\\"log_u\\\\\\\"]) + np.sum(b_w * 0.1*logd[\\\\\\\"log_v\\\\\\\"]):.6f}')\n\\\"\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

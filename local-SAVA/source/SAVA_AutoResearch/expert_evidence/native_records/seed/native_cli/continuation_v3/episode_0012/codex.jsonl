{"type": "item.started", "item": {"id": "item_80", "type": "command_execution", "command": "/bin/sh -lc \"python3 -c \\\"\nimport numpy as np\nfrom scipy.spatial.distance import cdist\nimport time\n\n# Test custom numpy log-domain Sinkhorn speed vs POT\nnp.random.seed(42)\nn, m = 1024, 1024\nC = cdist(np.random.randn(n, 10).astype(np.float64), \n          np.random.randn(m, 10).astype(np.float64), 'sqeuclidean') / 2.0\nC_max = C.max()\na = np.ones(n) / n\nb = np.ones(m) / m\nreg = 0.1\n\n# Custom numpy log-domain\ndef logsumexp(a, axis=None):\n    a_max = np.max(a, axis=axis, keepdims=True)\n    return np.log(np.sum(np.exp(a - a_max), axis=axis)) + a_max.squeeze(axis=axis)\n\ndef sinkhorn_log(a, b, C, reg, numItermax=2000, stopThr=1e-9):\n    log_a = np.log(a)\n    log_b = np.log(b)\n    log_u = np.zeros_like(a)\n    log_v = np.zeros_like(b)\n    C_over_reg = -C / reg\n    for it in range(numItermax):\n        log_v_prev = log_v\n        log_u = log_a - logsumexp(C_over_reg + log_v[None, :], axis=1)\n        log_v = log_b - logsumexp(C_over_reg + log_u[:, None], axis=0)\n        if it % 10 == 9:\n            if np.abs(log_v - log_v_prev).max() < stopThr:\n                break\n    P = np.exp(log_u[:, None] + log_v[None, :] + C_over_reg)\n    return P, log_u, log_v, it\n\nt0 = time.time()\nP1, lu1, lv1, it1 = sinkhorn_log(a, b, C / C_max, reg, numItermax=2000, stopThr=1e-9)\nt_custom = time.time() - t0\nprint(f'Custom numpy (normalized, 1024x1024): {t_custom:.3f}s, {it1+1} iters')\nprint(f'Row sum err: {np.abs(P1.sum(1) - a).max():.2e}')\nprint(f'Col sum err: {np.abs(P1.sum(0) - b).max():.2e}')\n\n# POT\nimport ot\nt0 = time.time()\nP2 = ot.sinkhorn(a, b, C / C_max, reg, method='sinkhorn_log', numItermax=2000, stopThr=1e-9)\nt_pot = time.time() - t0\nprint(f'POT (normalized, 1024x1024): {t_pot:.3f}s')\nprint(f'Row sum err: {np.abs(P2.sum(1) - a).max():.2e}')\nprint(f'Col sum err: {np.abs(P2.sum(0) - b).max():.2e}')\n\nprint(f'Speedup custom vs POT: {t_pot/t_custom:.2f}x')\nprint(f'P diff max: {np.abs(P1 - P2).max():.2e}')\n\\\"\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

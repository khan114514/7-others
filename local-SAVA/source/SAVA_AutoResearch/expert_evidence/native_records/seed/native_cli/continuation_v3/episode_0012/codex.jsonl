rmax=10000)\n        batchcost_can[i, j] = float(np.sum(P * C)) / (len(idx) + len(jdx))\n        z1 = torch.tensor(np.column_stack([a, y[idx]]), dtype=torch.float32)[None]\n        z2 = torch.tensor(np.column_stack([b, ry[jdx] + 10]), dtype=torch.float32)[None]\n        with torch.inference_mode(): f, _ = potential(z1, z2)\n        f = f.numpy().ravel().astype(float)\n        F[i, j] = (f - f.mean()) * len(f) / (len(f) - 1)\n\nQ_can = ot.sinkhorn(ot.unif(len(tx)), ot.unif(len(tr)),\n                    batchcost_can / max(float(batchcost_can.max()), 1e-12), .01,\n                    numItermax=10000, stopThr=1e-10)\nvalues_can = np.zeros(len(x))\nfor i, idx in enumerate(tx):\n    values_can[idx] = sum(Q_can[i, j] * F[i, j] for j in range(len(tr)))\n\nn_top = len(x) // 4\ndef quality(v1, v2):\n    nrmse = np.sqrt(np.mean((v1 - v2)**2)) / np.std(v1)\n    ranks1 = np.argsort(np.argsort(-v1))\n    ranks2 = np.argsort(np.argsort(-v2))\n    spear = np.corrcoef(ranks1, ranks2)[0,1]\n    tqo = len(set(np.argsort(-v1)[:n_top]) & set(np.argsort(-v2)[:n_top])) / n_top\n    return nrmse, spear, tqo\n\n# Test: subsample to estimate batchcost\nfor sub_size in [50, 100, 200, 500]:\n    batchcost_sub = np.zeros((len(tx), len(tr)))\n    t0 = time.time()\n    for i, idx in enumerate(tx):\n        for j, jdx in enumerate(tr):\n            si = np.random.choice(len(idx), min(sub_size, len(idx)), replace=False)\n            sj = np.random.choice(len(jdx), min(sub_size, len(jdx)), replace=False)\n            a_sub = x[idx[si]]\n            b_sub = r[jdx[sj]]\n            C_sub = cdist(a_sub, b_sub, 'sqeuclidean') / 2 + W[y[idx[si], None], ry[jdx[sj][None, :]] + 10] / 2\n            P_sub = ot.sinkhorn(ot.unif(len(si)), ot.unif(len(sj)), C_sub / max(float(C_sub.max()), 1e-12), .1, numItermax=10000)\n            batchcost_sub[i, j] = float(np.sum(P_sub * C_sub)) / (len(si) + len(sj))\n    t_sub = time.time() - t0\n    \n    Q_sub = ot.sinkhorn(ot.unif(len(tx)), ot.unif(len(tr)),\n                        batchcost_sub / max(float(batchcost_sub.max()), 1e-12), .01,\n                        numItermax=10000, stopThr=1e-10)\n    values_sub = np.zeros(len(x))\n    for i, idx in enumerate(tx):\n        values_sub[idx] = sum(Q_sub[i, j] * F[i, j] for j in range(len(tr)))\n    \n    nrmse, spear, tqo = quality(values_can, values_sub)\n    bc_err = np.abs(batchcost_can - batchcost_sub) / batchcost_can\n    print(f'Subsample {sub_size}: time={t_sub:.3f}s, Qdiff={np.abs(Q_can - Q_sub).max():.4f}, NRMSE={nrmse:.4f}, Spear={spear:.4f}, TQO={tqo:.4f}')\n\\\"\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

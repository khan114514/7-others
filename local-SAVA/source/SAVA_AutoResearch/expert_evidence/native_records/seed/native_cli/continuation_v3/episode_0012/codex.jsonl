{"type": "item.started", "item": {"id": "item_41", "type": "command_execution", "command": "/bin/sh -lc 'python3 -c \"\nimport numpy as np\nimport ot\nfrom scipy.spatial.distance import cdist\nimport torch\nfrom geomloss import SamplesLoss\n\n# Let me understand the relationship more carefully\n# Canonical POT: C/max with reg=0.1 (effective: 0.1*C_max on raw C)\n# Canonical GeomLoss: raw C with reg=blur''^2=0.1\n# These are DIFFERENT regularization strengths!\n\nnp.random.seed(42)\nn, m = 100, 80\nx = np.random.randn(n, 10).astype(np.float32)\ny = np.random.randn(m, 10).astype(np.float32)\nC = cdist(x, y, '\"'sqeuclidean') / 2.0\nC_max = C.max()\nprint('C_max:', C_max)\n\na = np.ones(n) / n\nb = np.ones(m) / m\n\n# Test 1: GeomLoss with default cost (sq euclidean, p=2)\nxt = torch.tensor(x, dtype=torch.float32)[None]\nyt = torch.tensor(y, dtype=torch.float32)[None]\nloss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, potentials=True, backend='tensorized')\nwith torch.inference_mode():\n    f_g, g_g = loss(xt, yt)\nf_geom = f_g.numpy().ravel()\n\n# The cost function in GeomLoss for p=2 is: c(x,y) = (1/p) * ||x-y||\"'^p = (1/2)*||x-y||''^2\n# That'\"'s exactly our C = cdist(x, y, 'sqeuclidean') / 2.0\n# So GeomLoss: cost = C, reg = blur\"'^2 = 0.1\n\n# Test 2: POT with same cost and reg\nP1, logd1 = ot.sinkhorn(a, b, C, 0.1, method='\"'sinkhorn_log', log=True)\nlog_u1 = logd1['log_u']\nf_pot1 = 0.1 * log_u1\n\nprint('GeomLoss f[:5]:', f_geom[:5])\nprint('POT f (reg=0.1 on raw C)[:5]:', f_pot1[:5])\nprint('Correlation:', np.corrcoef(f_geom, f_pot1)[0,1])\nprint('Centered max diff:', np.abs((f_geom - f_geom.mean()) - (f_pot1 - f_pot1.mean())).max())\n\n# Maybe the sign convention differs? \n# In POT: P = exp(log_u[:,None] + log_v[None,:] - C/reg)\n# In GeomLoss: let me check the convention\n# GeomLoss output f such that OT = (1/n)*sum(f_i * alpha_i) + (1/m)*sum(g_j * beta_j) (with debias=False)\n# Actually GeomLoss SamplesLoss returns the Sinkhorn divergence potential\n\n# Let me check the Sinkhorn cost from both\nprint()\nprint('GeomLoss value:', float(SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')(xt, yt)))\nprint('POT cost (sum P*C):', float(np.sum(P1 * C)))\n\\\"\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

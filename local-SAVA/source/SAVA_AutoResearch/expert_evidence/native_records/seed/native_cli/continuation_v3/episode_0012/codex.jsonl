{"type": "item.started", "item": {"id": "item_92", "type": "command_execution", "command": "/bin/sh -lc \"python3 -c \\\"\nimport numpy as np\nimport torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nimport ot\n\nnp.random.seed(101)\nN, M = 3000, 2000\nx = np.random.randn(N, 10).astype(np.float32)\nr = np.random.randn(M, 10).astype(np.float32)\ny = np.random.randint(0, 10, N).astype(np.int64)\nry = np.random.randint(0, 10, M).astype(np.int64)\ntorch.set_num_threads(2)\n\nbatch_size = 1024\ntx = [np.arange(i, min(i + batch_size, len(x))) for i in range(0, len(x), batch_size)]\ntr = [np.arange(i, min(i + batch_size, len(r))) for i in range(0, len(r), batch_size)]\n\n# Canonical label cost\nxx = torch.tensor(np.concatenate([x[tx[0]], r[tr[0]]]), dtype=torch.float32)\nyy = np.concatenate([y[tx[0]], ry[tr[0]] + 10])\nW = np.zeros((20, 20), dtype=np.float32)\nloss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\nwith torch.inference_mode():\n    for i in range(20):\n        for j in range(i + 1, 20):\n            W[i, j] = W[j, i] = float(loss(xx[yy == i], xx[yy == j]))\n\n# Canonical: compute batchcost + Q + values\ndef cost_fn(z1, z2):\n    d = torch.cdist(z1[:, :, :-1], z2[:, :, :-1]).square() / 2\n    return d + torch.as_tensor(W)[z1[:, :, -1].long().unsqueeze(2), z2[:, :, -1].long().unsqueeze(1)] / 2\n\npotential = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                        potentials=True, cost=cost_fn, backend='tensorized')\n\nF_can = {}\nbatchcost_can = np.zeros((len(tx), len(tr)))\nfor i, idx in enumerate(tx):\n    for j, jdx in enumerate(tr):\n        a = x[idx]; b = r[jdx]\n        C = cdist(a, b, 'sqeuclidean') / 2 + W[y[idx, None], ry[jdx][None, :] + 10] / 2\n        P = ot.sinkhorn(ot.unif(len(idx)), ot.unif(len(jdx)), C / max(float(C.max()), 1e-12), .1, numItermax=10000)\n        batchcost_can[i, j] = float(np.sum(P * C)) / (len(idx) + len(jdx))\n        z1 = torch.tensor(np.column_stack([a, y[idx]]), dtype=torch.float32)[None]\n        z2 = torch.tensor(np.column_stack([b, ry[jdx] + 10]), dtype=torch.float32)[None]\n        with torch.inference_mode(): f, _ = potential(z1, z2)\n        f = f.numpy().ravel().astype(float)\n        F_can[i, j] = (f - f.mean()) * len(f) / (len(f) - 1)\n\nQ_can = ot.sinkhorn(ot.unif(len(tx)), ot.unif(len(tr)),\n                    batchcost_can / max(float(batchcost_can.max()), 1e-12), .01,\n                    numItermax=10000, stopThr=1e-10)\n\nvalues_can = np.zeros(len(x))\nfor i, idx in enumerate(tx):\n    values_can[idx] = sum(Q_can[i, j] * F_can[i, j] for j in range(len(tr)))\n\n# Test: approximate batchcost with mean cost (no OT needed)\nbatchcost_approx = np.zeros((len(tx), len(tr)))\nfor i, idx in enumerate(tx):\n    for j, jdx in enumerate(tr):\n        a = x[idx]; b = r[jdx]\n        C = cdist(a, b, 'sqeuclidean') / 2 + W[y[idx, None], ry[jdx][None, :] + 10] / 2\n        batchcost_approx[i, j] = C.mean() / (len(idx) + len(jdx)) * len(idx) * len(jdx)\n        # Actually batchcost = sum(P*C) / (n+m). For P uniform, sum(P*C) = mean(C)\n        # So approximate: batchcost = mean(C) * n*m / (n+m)? No...\n        # sum(P*C) where P is a coupling with uniform marginals: sum_ij P_ij * C_ij\n        # If P = 1/(n*m), then sum(P*C) = mean(C) and marginals are 1/n, 1/m\n        batchcost_approx[i, j] = C.mean()\n\nprint('Canonical batchcost:')\nprint(batchcost_can)\nprint()\nprint('Mean cost approx:')\nprint(batchcost_approx)\nprint()\nprint('Ratio can/mean:', batchcost_can / batchcost_approx)\nprint()\n\nQ_approx = ot.sinkhorn(ot.unif(len(tx)), ot.unif(len(tr)),\n                       batchcost_approx / max(float(batchcost_approx.max()), 1e-12), .01,\n                       numItermax=10000, stopThr=1e-10)\nprint('Q canonical:')\nprint(Q_can)\nprint('Q approx (mean cost):')\nprint(Q_approx)\nprint('Q diff max:', np.abs(Q_can - Q_approx).max())\n\n# Values with approx Q\nvalues_approx = np.zeros(len(x))\nfor i, idx in enumerate(tx):\n    values_approx[idx] = sum(Q_approx[i, j] * F_can[i, j] for j in range(len(tr)))\n\nn_top = len(x) // 4\nnrmse = np.sqrt(np.mean((values_can - values_approx)**2)) / np.std(values_can)\nspearman = np.corrcoef(np.argsort(np.argsort(-values_can)), np.argsort(np.argsort(-values_approx)))[0,1]\ntqo = len(set(np.argsort(-values_can)[:n_top]) & set(np.argsort(-values_approx)[:n_top])) / n_top\nprint()\nprint(f'Mean-cost Q approximation quality:')\nprint(f'  NRMSE: {nrmse:.6f}')\nprint(f'  Spearman: {spearman:.6f}')\nprint(f'  TQO: {tqo:.6f}')\n\\\"\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

{"type": "item.completed", "item": {"id": "item_22", "type": "command_execution", "command": "/bin/sh -lc 'cat /tmp/research_history/method_v3_fast.py'", "aggregated_output": "\"\"\"Optimized v3: unified numpy log-domain Sinkhorn for everything.\n- One Sinkhorn solve per batch pair (replaces both POT and GeomLoss)\n- Numpy log-domain Sinkhorn for label cost (190 pairs)\n- Same Sinkhorn produces both coupling cost and potentials\n\"\"\"\nimport numpy as np\nfrom scipy.spatial.distance import cdist\n\ndef _logsumexp(a, axis=None):\n    a_max = np.max(a, axis=axis, keepdims=True)\n    return np.log(np.sum(np.exp(a - a_max), axis=axis)) + a_max.squeeze(axis=axis)\n\ndef _sinkhorn_log(a, b, C, reg, numItermax=10000, stopThr=1e-10):\n    \"\"\"Log-domain Sinkhorn. Returns P, f, g.\n    P[i,j] = exp((f[i] + g[j] - C[i,j]) / reg)\n    with row sums a and col sums b.\n    f and g are dual potentials in the entropic OT primal:\n    OT_cost = sum(a * f) + sum(b * g)\n    \"\"\"\n    a = np.asarray(a, dtype=np.float64)\n    b = np.asarray(b, dtype=np.float64)\n    C = np.asarray(C, dtype=np.float64)\n    \n    log_a = np.log(a)\n    log_b = np.log(b)\n    log_u = np.zeros_like(a)\n    log_v = np.zeros_like(b)\n    \n    for i in range(numItermax):\n        log_v_prev = log_v\n        M = -C / reg + log_v[None, :]\n        log_u = log_a - _logsumexp(M, axis=1)\n        M = -C / reg + log_u[:, None]\n        log_v = log_b - _logsumexp(M, axis=0)\n        \n        if i % 10 == 9:\n            if np.abs(log_v - log_v_prev).max() < stopThr:\n                break\n    \n    f = reg * log_u\n    g = reg * log_v\n    P = np.exp(log_u[:, None] + log_v[None, :] - C / reg)\n    return P, f, g\n\ndef _label_cost_fast(x, y, r, ry, reg=0.1):\n    \"\"\"Compute label cost matrix using numpy log-domain Sinkhorn.\"\"\"\n    xx = np.concatenate([x, r])\n    yy = np.concatenate([y, ry + 10])\n    W = np.zeros((20, 20), dtype=np.float64)\n    \n    class_samples = []\n    for k in range(20):\n        mask = yy == k\n        if not mask.any():\n            raise ValueError('Initial batch lacks a label support')\n        class_samples.append(xx[mask])\n    \n    for i in range(20):\n        xi = class_samples[i]\n        a_w = np.ones(len(xi)) / len(xi)\n        for j in range(i + 1, 20):\n            xj = class_samples[j]\n            b_w = np.ones(len(xj)) / len(xj)\n            C = cdist(xi, xj, 'sqeuclidean') / 2.0\n            C_max = C.max()\n            P, f, g = _sinkhorn_log(a_w, b_w, C / C_max, reg / C_max,\n                                    numItermax=500, stopThr=1e-8)\n            # Sinkhorn divergence = sum(a * f) + sum(b * g), on scaled problem\n            # W[i,j] = C_max * (sum(a*f) + sum(b*g))\n            W[i, j] = W[j, i] = C_max * (np.sum(a_w * f) + np.sum(b_w * g))\n    return W.astype(np.float32)\n\ndef value(x, y, r, ry, seed=17, batch_size=1024):\n    x = np.asarray(x, np.float32); r = np.asarray(r, np.float32)\n    y = np.asarray(y, np.int64); ry = np.asarray(ry, np.int64)\n    tx = [np.arange(i, min(i + batch_size, len(x))) for i in range(0, len(x), batch_size)]\n    tr = [np.arange(i, min(i + batch_size, len(r))) for i in range(0, len(r), batch_size)]\n    \n    W = _label_cost_fast(x[tx[0]], y[tx[0]], r[tr[0]], ry[tr[0]])\n    W64 = W.astype(np.float64)\n    \n    F = {}\n    batchcost = np.zeros((len(tx), len(tr)), dtype=np.float64)\n    reg = 0.1\n    \n    for i, idx in enumerate(tx):\n        a = x[idx].astype(np.float64)\n        ya = y[idx]\n        a_w = np.ones(len(idx), dtype=np.float64) / len(idx)\n        for j, jdx in enumerate(tr):\n            b = r[jdx].astype(np.float64)\n            yb = ry[jdx]\n            b_w = np.ones(len(jdx), dtype=np.float64) / len(jdx)\n            \n            C_eucl = cdist(a, b, 'sqeuclidean') / 2.0\n            C_label = W64[ya[:, None], yb[None, :] + 10] / 2.0\n            C = C_eucl + C_label\n            \n            C_max = max(float(C.max()), 1e-12)\n            P, f, g = _sinkhorn_log(a_w, b_w, C / C_max, reg,\n                                    numItermax=10000, stopThr=1e-10)\n            \n            # Batch transport cost: unscaled\n            batchcost[i, j] = np.sum(P * (C / C_max)) * C_max / (len(idx) + len(jdx))\n            \n            # Potentials: need to scale back. f is for C/C_max with reg=0.1 (scaled)\n            # In canonical: potentials are computed on raw C with reg (blur^2=0.1)\n            # We compute on C/C_max with reg=0.1 -> f in our space corresponds to f * C_max in real space\n            f_unscaled = f * C_max\n            F[i, j] = (f_unscaled - f_unscaled.mean()) * len(f_unscaled) / (len(f_unscaled) - 1)\n    \n    # Batch-level transport\n    n_tx = len(tx); n_tr = len(tr)\n    bc_max = max(float(batchcost.max()), 1e-12)\n    q_a = np.ones(n_tx) / n_tx\n    q_b = np.ones(n_tr) / n_tr\n    Q, f_q, g_q = _sinkhorn_log(q_a, q_b, batchcost / bc_max, 0.01,\n                                numItermax=10000, stopThr=1e-10)\n    \n    residual = max(np.max(np.abs(Q.sum(1) - 1.0/n_tx)),\n                   np.max(np.abs(Q.sum(0) - 1.0/n_tr)))\n    if residual > 1e-6:\n        raise ValueError(f'Unconverged batch transport: {residual}')\n    \n    values = np.zeros(len(x), dtype=np.float64)\n    for i, idx in enumerate(tx):\n        values[idx] = sum(Q[i, j] * F[i, j] for j in range(n_tr))\n    return values.astype(np.float64)\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_23", "type": "command_execution", "command": "/bin/sh -lc 'cat /tmp/research_history/method_v1_fastsink.py'", "aggregated_output": "\"\"\"Optimized v1: custom log-domain Sinkhorn + fast label cost.\"\"\"\nimport numpy as np\nimport torch\nimport ot\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\n\ndef _logsumexp(a, axis=None):\n    a_max = np.max(a, axis=axis, keepdims=True)\n    return np.log(np.sum(np.exp(a - a_max), axis=axis)) + a_max.squeeze(axis=axis)\n\ndef _sinkhorn_log(a, b, C, reg, numItermax=10000, stopThr=1e-10):\n    \"\"\"Fast log-domain Sinkhorn in pure numpy. Returns P, log_u, log_v.\"\"\"\n    a = np.asarray(a, dtype=np.float64)\n    b = np.asarray(b, dtype=np.float64)\n    C = np.asarray(C, dtype=np.float64)\n    \n    log_a = np.log(a)\n    log_b = np.log(b)\n    log_u = np.zeros_like(a)\n    log_v = np.zeros_like(b)\n    \n    for i in range(numItermax):\n        log_v_prev = log_v\n        # Source update\n        M = -C / reg + log_v[None, :]\n        log_u = log_a - _logsumexp(M, axis=1)\n        # Target update\n        M = -C / reg + log_u[:, None]\n        log_v = log_b - _logsumexp(M, axis=0)\n        \n        if i % 10 == 9:\n            if np.abs(log_v - log_v_prev).max() < stopThr:\n                break\n    \n    P = np.exp(log_u[:, None] + log_v[None, :] - C / reg)\n    return P, log_u, log_v\n\ndef _label_cost_fast(x, y, r, ry):\n    \"\"\"Compute label cost matrix using custom fast Sinkhorn.\n    Uses POT log-domain for class-pair Sinkhorn divergences.\"\"\"\n    xx = np.concatenate([x, r])\n    yy = np.concatenate([y, ry + 10])\n    W = np.zeros((20, 20), dtype=np.float64)\n    reg = 0.1  # match canonical: blur=sqrt(0.1), p=2 => reg=blur^2=0.1\n    \n    # Precompute per-class samples\n    class_samples = {}\n    for k in range(20):\n        mask = yy == k\n        if mask.any():\n            class_samples[k] = xx[mask]\n    \n    for i in range(20):\n        if i not in class_samples:\n            raise ValueError('Initial batch lacks a label support')\n        xi = class_samples[i]\n        for j in range(i + 1, 20):\n            if j not in class_samples:\n                raise ValueError('Initial batch lacks a label support')\n            xj = class_samples[j]\n            C = cdist(xi, xj, 'sqeuclidean') / 2.0\n            C_max = C.max()\n            a = np.ones(len(xi)) / len(xi)\n            b = np.ones(len(xj)) / len(xj)\n            P, _, _ = _sinkhorn_log(a, b, C / C_max, reg / C_max, numItermax=1000, stopThr=1e-8)\n            W[i, j] = W[j, i] = np.sum(P * C)\n    return W.astype(np.float32)\n\ndef value(x, y, r, ry, seed=17, batch_size=1024):\n    torch.set_num_threads(2)\n    x = np.asarray(x, np.float32); r = np.asarray(r, np.float32)\n    y = np.asarray(y, np.int64); ry = np.asarray(ry, np.int64)\n    tx = [np.arange(i, min(i + batch_size, len(x))) for i in range(0, len(x), batch_size)]\n    tr = [np.arange(i, min(i + batch_size, len(r))) for i in range(0, len(r), batch_size)]\n    \n    W = _label_cost_fast(x[tx[0]], y[tx[0]], r[tr[0]], ry[tr[0]])\n    \n    def cost(z1, z2):\n        d = torch.cdist(z1[:, :, :-1], z2[:, :, :-1]).square() / 2\n        return d + torch.as_tensor(W)[z1[:, :, -1].long().unsqueeze(2), z2[:, :, -1].long().unsqueeze(1)] / 2\n    \n    potential = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                           potentials=True, cost=cost, backend='tensorized')\n    F = {}; batchcost = np.zeros((len(tx), len(tr)))\n    reg = 0.1\n    for i, idx in enumerate(tx):\n        for j, jdx in enumerate(tr):\n            a = x[idx]; b = r[jdx]\n            C = cdist(a, b, 'sqeuclidean') / 2 + W[y[idx, None], ry[jdx][None, :] + 10] / 2\n            C = C.astype(np.float64)\n            C_max = max(float(C.max()), 1e-12)\n            a_w = np.ones(len(idx)) / len(idx)\n            b_w = np.ones(len(jdx)) / len(jdx)\n            P, _, _ = _sinkhorn_log(a_w, b_w, C / C_max, reg, numItermax=10000, stopThr=1e-10)\n            batchcost[i, j] = float(np.sum(P * C)) / (len(idx) + len(jdx))\n            z1 = torch.tensor(np.column_stack([a, y[idx]]), dtype=torch.float32)[None]\n            z2 = torch.tensor(np.column_stack([b, ry[jdx] + 10]), dtype=torch.float32)[None]\n            with torch.inference_mode(): f, _ = potential(z1, z2)\n            f = f.numpy().ravel().astype(float)\n            F[i, j] = (f - f.mean()) * len(f) / (len(f) - 1)\n    \n    Q, _, _ = _sinkhorn_log(\n        np.ones(len(tx)) / len(tx),\n        np.ones(len(tr)) / len(tr),\n        batchcost / max(float(batchcost.max()), 1e-12),\n        0.01, numItermax=10000, stopThr=1e-10\n    )\n    residual = max(np.max(np.abs(Q.sum(1) - 1.0 / len(tx))),\n                   np.max(np.abs(Q.sum(0) - 1.0 / len(tr))))\n    if residual > 1e-6:\n        raise ValueError(f'Unconverged batch transport: {residual}')\n    values = np.zeros(len(x))\n    for i, idx in enumerate(tx):\n        values[idx] = sum(Q[i, j] * F[i, j] for j in range(len(tr)))\n    return values\n", "exit_code": 0, "status": "completed"}}

{"type": "item.started", "item": {"id": "item_64", "type": "command_execution", "command": "/bin/sh -lc \"python3 << 'EOF'\nimport numpy as np\nimport torch\nfrom geomloss import SamplesLoss\nimport ot\nfrom scipy.spatial.distance import cdist\n\ntorch.set_num_threads(2)\nnp.random.seed(42)\n\n# Use small problem to make convergence easier\nn, m = 50, 50\nx = np.random.randn(n, 10).astype(np.float32) * 0.5\ny = np.random.randn(m, 10).astype(np.float32) * 0.5 + 0.2\nC = cdist(x, y, 'sqeuclidean').astype(np.float64) / 2.0\nreg = 0.1\na = np.ones(n) / n\nb = np.ones(m) / m\n\n# POT with many iterations\nP, log_dict = ot.sinkhorn(a, b, C, reg, method='sinkhorn_log', log=True, numItermax=50000, stopThr=1e-15)\nlog_u = log_dict['log_u']\nlog_v = log_dict['log_v']\nf_p = reg * (log_u - np.log(a))\ng_p = reg * (log_v - np.log(b))\nprint(\\\"POT iterations:\\\", log_dict['niter'])\nprint(\\\"POT final err:\\\", log_dict['err'][-1] if isinstance(log_dict['err'], list) else log_dict['err'])\n\nf_p_c = (f_p - f_p.mean()) * n / (n - 1)\n\n# GeomLoss\npotential = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                        potentials=True, backend='tensorized', scaling=0.9)\nwith torch.inference_mode():\n    f_g, g_g = potential(torch.tensor(x)[None], torch.tensor(y)[None])\nf_g = f_g.numpy().ravel()\ng_g = g_g.numpy().ravel()\nf_g_c = (f_g - f_g.mean()) * n / (n - 1)\n\ncorr = np.corrcoef(f_p_c, f_g_c)[0,1]\nnrmse = np.sqrt(np.mean((f_p_c - f_g_c)**2)) / f_g_c.std()\nprint(f\\\"corr={corr:.8f}, nrmse={nrmse:.8f}\\\")\nprint(f\\\"POT primal={np.sum(P*C):.6f}\\\")\nprint(f\\\"GeomLoss value={f_g.mean() + g_g.mean():.6f}\\\")\nprint(f\\\"POT dual={np.dot(a, f_p) + np.dot(b, g_p):.6f}\\\")\n\n# Maybe the potentials are different because of the gauge freedom?\n# In Sinkhorn, f and g are only defined up to a constant shift:\n# f' = f + c, g' = g - c gives the same P.\n# GeomLoss and POT might choose different gauges.\n# But we center them, so that shouldn't matter.\n# Unless the issue is not gauge but the actual POT solution is different.\n\n# Let me verify: does the POT coupling satisfy the constraints?\nprint(\\\"\\\\nPOT row sum error:\\\", np.max(np.abs(P.sum(axis=1) - a)))\nprint(\\\"POT col sum error:\\\", np.max(np.abs(P.sum(axis=0) - b)))\n\n# Reconstruct P from GeomLoss potentials\nP_g = a[:, None] * b[None, :] * np.exp((f_g[:, None] + g_g[None, :] - C) / reg)\nprint(\\\"\\\\nGeomLoss P row sum error:\\\", np.max(np.abs(P_g.sum(axis=1) - a)))\nprint(\\\"GeomLoss P col sum error:\\\", np.max(np.abs(P_g.sum(axis=0) - b)))\nprint(\\\"GeomLoss P sum:\\\", P_g.sum())\nprint(\\\"GeomLoss P primal:\\\", np.sum(P_g * C))\n\n# If the row/col sums don't match, it's because the formula is wrong for GeomLoss.\n# Maybe GeomLoss uses a different normalization: P = exp((f+g-C)/reg) without a*b?\nP_g2 = np.exp((f_g[:, None] + g_g[None, :] - C) / reg)\nprint(\\\"\\\\nGeomLoss P2 (no a*b) row sum first 3:\\\", P_g2.sum(axis=1)[:3])\nprint(\\\"GeomLoss P2 (no a*b) col sum first 3:\\\", P_g2.sum(axis=0)[:3])\nEOF\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

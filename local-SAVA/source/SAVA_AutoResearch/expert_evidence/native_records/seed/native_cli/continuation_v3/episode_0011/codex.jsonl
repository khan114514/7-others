{"type": "item.started", "item": {"id": "item_52", "type": "command_execution", "command": "/bin/sh -lc \"python3 << 'EOF'\nimport numpy as np\nimport ot\nfrom scipy.spatial.distance import cdist\n\nnp.random.seed(42)\nn, m = 50, 60\nC = np.random.randn(n, m) ** 2 + 5\na = np.ones(n) / n\nb = np.ones(m) / m\n\nP, log_dict = ot.sinkhorn(a, b, C, 0.1, method='sinkhorn_log', log=True, numItermax=2000, stopThr=1e-9)\nlog_u = log_dict['log_u']\nlog_v = log_dict['log_v']\n\n# Verify: P = exp(log_u)[:,None] * exp(-C/reg) * exp(log_v)[None,:]\nP2 = np.exp(log_u[:, None] + log_v[None, :] - C / 0.1)\nprint(\\\"P vs P2 max diff:\\\", np.max(np.abs(P - P2)))\nprint(\\\"P sum:\\\", P.sum())\nprint(\\\"P2 sum:\\\", P2.sum())\n\n# Primal: sum P * C \nprimal = np.sum(P * C)\nprint(\\\"Primal:\\\", primal)\n\n# Dual potentials: f = reg * log(u), but u is the scaling factor\n# P = diag(u) * K * diag(v), where K = exp(-C/reg), u = exp(log_u), v = exp(log_v)\n# Standard: P_ij = a_i * b_j * exp((f_i + g_j - C_ij)/reg)\n# So: u_i * v_j * exp(-C_ij/reg) = a_i * b_j * exp((f_i+g_j-C_ij)/reg)\n# => u_i = a_i * exp(f_i/reg), v_j = b_j * exp(g_j/reg)\n# => f_i = reg * (log(u_i) - log(a_i)), g_j = reg * (log(v_j) - log(b_j))\n\nf_pot = 0.1 * (log_u - np.log(a))\ng_pot = 0.1 * (log_v - np.log(b))\ndual_val = np.dot(a, f_pot) + np.dot(b, g_pot)\nprint(\\\"Dual value <a,f>+<b,g>:\\\", dual_val)\nprint(\\\"Primal - Dual:\\\", primal - dual_val)\nEOF\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

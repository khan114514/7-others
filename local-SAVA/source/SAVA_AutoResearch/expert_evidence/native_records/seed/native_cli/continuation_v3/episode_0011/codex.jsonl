{"type": "item.started", "item": {"id": "item_58", "type": "command_execution", "command": "/bin/sh -lc \"python3 << 'EOF'\nimport numpy as np\nimport torch\nfrom geomloss import SamplesLoss\nimport ot\nfrom scipy.spatial.distance import cdist\n\ntorch.set_num_threads(2)\nnp.random.seed(42)\n\nn, m = 200, 180\nx = np.random.randn(n, 10).astype(np.float32)\ny = np.random.randn(m, 10).astype(np.float32) + 0.3\n\n# GeomLoss\npotential = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                        potentials=True, backend='tensorized')\nwith torch.inference_mode():\n    f_g, g_g = potential(torch.tensor(x)[None], torch.tensor(y)[None])\nf_g = f_g.numpy().ravel()\ng_g = g_g.numpy().ravel()\ngeom_loss_val = f_g.mean() + g_g.mean()\nprint(\\\"GeomLoss value:\\\", geom_loss_val)\n\n# Reconstruct the coupling from GeomLoss potentials\n# GeomLoss: P_ij = alpha_i * beta_j * exp((f_i + g_j - C_ij)/eps)\n# where alpha, beta are the weights (summing to 1 each)\n# Let's verify with C = sqeucl / 2\nC = cdist(x, y, 'sqeuclidean').astype(np.float64) / 2.0\nreg = 0.1\nalpha = np.ones(n) / n\nbeta = np.ones(m) / m\nP_g = alpha[:, None] * beta[None, :] * np.exp((f_g[:, None] + g_g[None, :] - C) / reg)\nprint(\\\"GeomLoss P sum:\\\", P_g.sum())\nprint(\\\"GeomLoss P row sum (first 3):\\\", P_g.sum(axis=1)[0], P_g.sum(axis=1)[1])\nprint(\\\"alpha[0]:\\\", alpha[0])\nprint(\\\"GeomLoss primal sum(P*C):\\\", np.sum(P_g * C))\n\n# Now compare with POT\nP_p, log_dict = ot.sinkhorn(alpha, beta, C, reg, method='sinkhorn_log', log=True, numItermax=5000, stopThr=1e-12)\nprint(\\\"\\\\nPOT P sum:\\\", P_p.sum())\nprint(\\\"POT primal sum(P*C):\\\", np.sum(P_p * C))\n\n# The POT log_u is the log of the row scaling\n# POT: P = u * K * v where K = exp(-C/reg)\n# P_ij = u_i * exp(-C_ij/reg) * v_j\n# Standard: P_ij = alpha_i * beta_j * exp((f_i + g_j - C_ij)/reg)\n# So u_i = alpha_i * exp(f_i/reg), v_j = beta_j * exp(g_j/reg)\n# log_u_i = log(alpha_i) + f_i/reg\n# f_i = reg * (log_u_i - log(alpha_i))\n\nlog_u = log_dict['log_u']\nlog_v = log_dict['log_v']\nf_p = reg * (log_u - np.log(alpha))\ng_p = reg * (log_v - np.log(beta))\n\nprint(\\\"\\\\nPOT f mean:\\\", f_p.mean())\nprint(\\\"Geom f mean:\\\", f_g.mean())\nprint(\\\"POT g mean:\\\", g_p.mean())\nprint(\\\"Geom g mean:\\\", g_g.mean())\nprint(\\\"POT dual:\\\", np.dot(alpha, f_p) + np.dot(beta, g_p))\nprint(\\\"Geom dual:\\\", geom_loss_val)\n\n# Let me also check: what if there's a sign flip?\nprint(\\\"\\\\nPOT -f mean:\\\", -f_p.mean())\n# Or what if POT potentials are f_i = -reg * log_u_i (no alpha subtraction)?\nprint(\\\"POT -reg*log_u mean:\\\", (-reg * log_u).mean())\n\n# The canonical code uses f = -reg * log_u\n# Let's check what that gives\nf_can = -reg * log_u\nf_can_c = (f_can - f_can.mean()) * n / (n - 1)\nf_g_c = (f_g - f_g.mean()) * n / (n - 1)\nprint(\\\"\\\\nCanonical-style f (= -reg * log_u) vs GeomLoss f:\\\")\nprint(\\\"  corr:\\\", np.corrcoef(f_can_c, f_g_c)[0,1])\nprint(\\\"  nrmse:\\\", np.sqrt(np.mean((f_can_c - f_g_c)**2)) / f_g_c.std())\n\n# What about POT coupling-based potential: f = -reg * log(K v) / a?\n# This is the standard: f_i = -reg * log(sum_j K_ij v_j / a_i)\n# Let me check the relationship between v9's formula and the correct one.\nEOF\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

{"type": "item.started", "item": {"id": "item_93", "type": "command_execution", "command": "/bin/sh -lc \"python3 << 'PYEOF'\nimport numpy as np\nimport sys, time, os\nimport torch\ntorch.set_num_threads(2)\nimport importlib.util\n\n# Load canonical\nspec = importlib.util.spec_from_file_location(\\\"canonical\\\", \\\"/tmp/research_history/method_canonical.py\\\")\ncanonical = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(canonical)\n\n# Load v10\nspec = importlib.util.spec_from_file_location(\\\"v10\\\", \\\"/tmp/v10_method.py\\\")\nv10 = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(v10)\n\ncase_files = sorted([f for f in os.listdir('/workspace/environment/public_assets/dev')\n                     if f.endswith('.npz') and '101' in f])\n\nprint(f\\\"Testing {len(case_files)} cases (seed 101)\\\")\nprint(\\\"=\\\" * 70)\n\nfor cf in case_files:\n    data = np.load(f'/workspace/environment/public_assets/dev/{cf}')\n    x, y, r, ry = data['x'], data['y'], data['r'], data['ry']\n    seed = int(data['seed'])\n    \n    # Canonical (target)\n    t0 = time.time()\n    v_canon = canonical.value(x, y, r, ry, seed)\n    t_canon = time.time() - t0\n    \n    # v10\n    t0 = time.time()\n    v_v10 = v10.value(x, y, r, ry, seed)\n    t_v10 = time.time() - t0\n    \n    # Metrics\n    nrmse = np.sqrt(np.mean((v_v10 - v_canon)**2)) / v_canon.std()\n    \n    # Spearman\n    from scipy.stats import spearmanr\n    sp, _ = spearmanr(v_v10, v_canon)\n    \n    # Top quarter overlap\n    N = len(v_v10)\n    k = N // 4\n    # stable descending sort by index (like numpy argsort with stable and -values)\n    idx_canon = np.argsort(-v_canon, kind='stable')[:k]\n    idx_v10 = np.argsort(-v_v10, kind='stable')[:k]\n    overlap = len(np.intersect1d(idx_canon, idx_v10)) / k\n    \n    print(f\\\"{cf}\\\")\n    print(f\\\"  canonical time: {t_canon:.3f}s, v10 time: {t_v10:.3f}s, speedup: {t_canon/t_v10:.2f}x\\\")\n    print(f\\\"  NRMSE: {nrmse:.6f} (need ≤0.01)\\\")\n    print(f\\\"  Spearman: {sp:.6f} (need ≥0.999)\\\")\n    print(f\\\"  TopQ overlap: {overlap:.4f} (need ≥0.98)\\\")\n    print()\n\nPYEOF\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

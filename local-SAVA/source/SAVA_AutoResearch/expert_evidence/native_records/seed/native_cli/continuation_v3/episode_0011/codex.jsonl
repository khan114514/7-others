{"type": "item.started", "item": {"id": "item_60", "type": "command_execution", "command": "/bin/sh -lc \"python3 << 'EOF'\nimport numpy as np\nimport torch\nfrom geomloss import SamplesLoss\n\ntorch.set_num_threads(2)\nnp.random.seed(42)\n\nn, m = 200, 180\nx = torch.tensor(np.random.randn(n, 10).astype(np.float32))\ny = torch.tensor(np.random.randn(m, 10).astype(np.float32)) + 0.3\na = torch.ones(n) / n\nb = torch.ones(m) / m\n\n# GeomLoss loss value (debias=False = standard Sinkhorn)\nloss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\nwith torch.inference_mode():\n    loss_val = loss(x, y).item()\nprint(\\\"GeomLoss loss value:\\\", loss_val)\n\n# GeomLoss potentials\npotential = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                        potentials=True, backend='tensorized')\nwith torch.inference_mode():\n    f_g, g_g = potential(x[None], y[None])\nf_g = f_g.numpy().ravel()\ng_g = g_g.numpy().ravel()\n\n# Reconstruct loss from potentials\n# Standard entropic OT: W_eps = <a, f> + <b, g> - eps * (sum a exp(f/eps) * sum b exp(g/eps) - 1)?\n# Or: W_eps = sup_{f,g} <a,f> + <b,g> - eps * <a, exp(f/eps)> * <b, exp(g/eps)> + eps\n# With optimal f, g:\n# a_i * exp(f_i / eps) = scaling u_i... \n# Wait, let me just try the formula <a,f> + <b,g> directly:\na_np = a.numpy()\nb_np = b.numpy()\nprint(\\\"<a,f> + <b,g>:\\\", np.dot(a_np, f_g) + np.dot(b_np, g_g))\n\n# Or maybe it's <a, f> only (the left potential)?\nprint(\\\"<a,f>:\\\", np.dot(a_np, f_g))\nprint(\\\"<b,g>:\\\", np.dot(b_np, g_g))\n\n# Or maybe it's 0.5 * (<a,f> + <b,g>)?\nprint(\\\"0.5*(<a,f>+<b,g>):\\\", 0.5*(np.dot(a_np, f_g) + np.dot(b_np, g_g)))\n\n# Let me check GeomLoss source - what does 'sinkhorn' loss compute?\n# GeomLoss: S_eps(mu, nu) = inf_gamma <gamma, c> + eps * KL(gamma | mu x nu)\n# Dual: sup_{f,g} int f dmu + int g dnu - eps * (int exp(f/eps) dmu * int exp(g/eps) dnu - 1)\n# Wait no, the entropic regularized OT problem is:\n# min_{P: P1=a, P\"'^T1=b} <P,C> + eps * KL(P | a b''^T)\n# Dual: sup_{f,g} <a,f> + <b,g> - eps * (sum_i a_i exp(f_i/eps)) * (sum_j b_j exp(g_j/eps)) + eps\n# \n# And the optimal P is:\n# P_ij = a_i b_j exp((f_i + g_j - C_ij) / eps)\n# \n# And the dual value = primal value + eps * (sum P - 1)? No...\n\n# Let me just compute the Sinkhorn loss from POT and compare\nimport ot\nfrom scipy.spatial.distance import cdist\n\nC = cdist(x.numpy(), y.numpy(), '\"'sqeuclidean').astype(np.float64) / 2.0\nreg = 0.1\nP_p, log_dict = ot.sinkhorn(a_np, b_np, C, reg, method='sinkhorn_log', log=True, numItermax=5000, stopThr=1e-12)\nprimal = np.sum(P_p * C)\nprint(\\\"\\\\nPOT primal:\\\", primal)\n# Entropic OT value = primal + reg * KL(P | a b\"'^T)\n# KL(P | a b''^T) = sum P * (log P - log a - log b) + sum a b''^T - sum P\n# Hmm this is getting complex. Let me just compute it:\nlog_a = np.log(a_np)\nlog_b = np.log(b_np)\nlog_P = np.log(P_p + 1e-300)\nkl = np.sum(P_p * (log_P - log_a[:, None] - log_b[None, :])) - np.sum(P_p) + np.sum(a_np) * np.sum(b_np)\nprint(\"POT primal + reg*KL:\", primal + reg * kl)\n\n# What about just the total <a,f> + <b,g> from POT dual?\nlog_u = log_dict['\"'log_u']\nlog_v = log_dict['log_v']\nf_p = reg * (log_u - log_a)\ng_p = reg * (log_v - log_b)\npot_dual = np.dot(a_np, f_p) + np.dot(b_np, g_p)\nprint(\\\"POT dual <a,f>+<b,g>:\\\", pot_dual)\n\n# The relationship between POT dual and primal for entropic OT:\n# dual value = primal + reg * (1 - sum a*exp(f/reg) * sum b*exp(g/reg))?\n# Let me compute exp term:\nexp_f = np.sum(a_np * np.exp(f_p / reg))\nexp_g = np.sum(b_np * np.exp(g_p / reg))\nprint(\\\"sum a*exp(f/reg):\\\", exp_f)\nprint(\\\"sum b*exp(g/reg):\\\", exp_g)\nprint(\\\"product:\\\", exp_f * exp_g)\nprint(\\\"dual - reg*(product - 1):\\\", pot_dual - reg * (exp_f * exp_g - 1))\nEOF\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

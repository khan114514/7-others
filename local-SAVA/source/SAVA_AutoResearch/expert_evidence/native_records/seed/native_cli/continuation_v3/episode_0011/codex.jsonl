{"type": "item.started", "item": {"id": "item_56", "type": "command_execution", "command": "/bin/sh -lc \"python3 << 'EOF'\nimport numpy as np\nimport torch\nfrom geomloss import SamplesLoss\nimport ot\nfrom scipy.spatial.distance import cdist\n\ntorch.set_num_threads(2)\nnp.random.seed(42)\n\nn, m = 200, 180\nx = np.random.randn(n, 10).astype(np.float32)\ny = np.random.randn(m, 10).astype(np.float32) + 0.3\n\n# GeomLoss p=2 uses squared distance? Let me check with direct Euclidean cost.\n# GeomLoss: 'sinkhorn' with p=2 computes the Sinkhorn loss with L\"'^2 cost.\n# The cost function is ||x-y||''^2 / 2 or ||x-y||''^2? Let'\"'s check.\n\n# Test with Euclidean distance not divided by 2\nC_full = cdist(x, y, 'sqeuclidean').astype(np.float64)\nC_half = C_full / 2.0\na = np.ones(n) / n\nb = np.ones(m) / m\nreg = 0.1\n\nfor C, name in [(C_full, 'full sqeucl'), (C_half, 'sqeucl/2')]:\n    P, log_dict = ot.sinkhorn(a, b, C, reg, method='sinkhorn_log', log=True, numItermax=5000, stopThr=1e-12)\n    log_u = log_dict['log_u']\n    f_pot = reg * (log_u - np.log(a))\n    f_pot_c = (f_pot - f_pot.mean()) * n / (n - 1)\n    print(f\\\"{name}: primal={np.sum(P*C):.4f}, dual={np.dot(a, reg*(log_u-np.log(a))) + np.dot(b, reg*(log_dict['log_v']-np.log(b))):.4f}\\\")\n\n# GeomLoss\npotential = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                        potentials=True, backend='tensorized')\nwith torch.inference_mode():\n    f_g, g_g = potential(torch.tensor(x)[None], torch.tensor(y)[None])\nf_g = f_g.numpy().ravel()\nf_g_c = (f_g - f_g.mean()) * n / (n - 1)\n\n# Compute POT with different reg values, check correlation\nfor reg_val in [0.05, 0.1, 0.2, 0.5]:\n    P, log_dict = ot.sinkhorn(a, b, C_full, reg_val, method='sinkhorn_log', log=True, numItermax=5000, stopThr=1e-12)\n    log_u = log_dict['log_u']\n    f_pot = reg_val * (log_u - np.log(a))\n    f_pot_c = (f_pot - f_pot.mean()) * n / (n - 1)\n    corr = np.corrcoef(f_pot_c, f_g_c)[0,1]\n    nrmse = np.s
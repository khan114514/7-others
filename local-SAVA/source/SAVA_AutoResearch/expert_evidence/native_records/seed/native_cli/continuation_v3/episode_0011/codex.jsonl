{"type": "item.started", "item": {"id": "item_99", "type": "command_execution", "command": "/bin/sh -lc \"python3 << 'PYEOF'\nimport numpy as np\nimport sys, time, os\nimport torch\ntorch.set_num_threads(2)\nimport importlib.util\nfrom scipy.stats import spearmanr\nfrom scipy.spatial.distance import cdist\nimport ot\n\n# Load canonical\nspec = importlib.util.spec_from_file_location(\\\"canonical\\\", \\\"/tmp/research_history/method_canonical.py\\\")\ncanonical = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(canonical)\n\n# Load one case\ndata = np.load('/workspace/environment/public_assets/dev/seed_101_gaussian_008.npz')\nx, y, r, ry = data['x'], data['y'], data['r'], data['ry']\nseed = int(data['seed'])\n\n# Compute canonical step by step and the unified approach step by step\nbatch_size = 1024\ntx = [np.arange(i, min(i + batch_size, len(x))) for i in range(0, len(x), batch_size)]\ntr = [np.arange(i, min(i + batch_size, len(r))) for i in range(0, len(r), batch_size)]\n\n# Canonical label cost\nW = canonical._label_cost(x[tx[0]], y[tx[0]], r[tr[0]], ry[tr[0]])\n\n# Canonical: POT batchcosts\nbc_canon = np.zeros((len(tx), len(tr)))\nfor i, idx in enumerate(tx):\n    for j, jdx in enumerate(tr):\n        a = x[idx]; b = r[jdx]\n        C = cdist(a, b, 'sqeuclidean') / 2 + W[y[idx, None], ry[jdx][None, :] + 10] / 2\n        P = ot.sinkhorn(ot.unif(len(idx)), ot.unif(len(jdx)), C / max(float(C.max()), 1e-12), .1)\n        bc_canon[i, j] = float(np.sum(P * C)) / (len(idx) + len(jdx))\n\n# Unified (GeomLoss) batchcosts\nfrom geomloss import SamplesLoss\ndef cost(z1, z2):\n    d = torch.cdist(z1[:, :, :-1], z2[:, :, :-1]).square() / 2\n    return d + torch.as_tensor(W)[z1[:, :, -1].long().unsqueeze(2),\n                                  z2[:, :, -1].long().unsqueeze(1)] / 2\n\npotential = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                        potentials=True, cost=cost, backend='tensorized')\nbc_geom = np.zeros((len(tx), len(tr)))\nF_canon = {}\nF_geom = {}\nreg = 0.1\n\nfor i, idx in enumerate(tx):\n    for j, jdx in enumerate(tr):\n        a = x[idx]; b = r[jdx]\n        z1 = torch.tensor(np.column_stack([a, y[idx]]), dtype=torch.float32)[None]\n        z2 = torch.tensor(np.column_stack([b, ry[jdx] + 10]), dtype=torch.float32)[None]\n        with torch.inference_mode():\n            f, g = potential(z1, z2)\n        f_np = f.numpy().ravel().astype(float)\n        g_np = g.numpy().ravel().astype(float)\n        n_src = len(idx); n_tgt = len(jdx)\n        \n        C = cdist(a, b, 'sqeuclidean') / 2.0 + W[y[idx, None], ry[jdx][None, :] + 10] / 2.0\n        alpha = np.ones(n_src) / n_src\n        beta = np.ones(n_tgt) / n_tgt\n        P = alpha[:, None] * beta[None, :] * np.exp((f_np[:, None] + g_np[None, :] - C) / reg)\n        bc_geom[i, j] = float(np.sum(P * C)) / (n_src + n_tgt)\n        \n        F_geom[i, j] = (f_np - f_np.mean()) * len(f_np) / (len(f_np) - 1)\n        \n        # Also compute canonical F for comparison\n        with torch.inference_mode():\n            f_c, _ = potential(z1, z2)\n        f_c_np = f_c.numpy().ravel().astype(float)\n        F_canon[i, j] = (f_c_np - f_c_np.mean()) * len(f_c_np) / (len(f_c_np) - 1)\n\nprint(\\\"POT batchcosts (canonical):\\\")\nprint(bc_canon)\nprint()\nprint(\\\"GeomLoss batchcosts:\\\")\nprint(bc_geom)\nprint()\nprint(\\\"Ratio bc_geom / bc_canon:\\\")\nprint(bc_geom / bc_canon)\nprint()\n\n# Compute Q matrices\nQ_canon = ot.sinkhorn(ot.unif(len(tx)), ot.unif(len(tr)),\n                      bc_canon / max(float(bc_canon.max()), 1e-12), .01,\n                      numItermax=10000, stopThr=1e-10)\nQ_geom = ot.sinkhorn(ot.unif(len(tx)), ot.unif(len(tr)),\n                     bc_geom / max(float(bc_geom.max()), 1e-12), .01,\n                     numItermax=10000, stopThr=1e-10)\n\nprint(\\\"Q canonical:\\\")\nprint(Q_canon)\nprint(\\\"Q geomloss:\\\")\nprint(Q_geom)\nprint()\n\n# Compare F matrices (should be identical since they come from same GeomLoss call)\nfor i, idx in enumerate(tx):\n    for j, jdx in enumerate(tr):\n        diff = np.max(np.abs(F_canon[i,j] - F_geom[i,j]))\n        print(f\\\"F[{i},{j}] max diff: {diff}\\\")\n\n# Now compute final values using canonical F + Q_canon (should match canonical)\nvalues_cf_cq = np.zeros(len(x))\nfor i, idx in enumerate(tx):\n    values_cf_cq[idx] = sum(Q_canon[i, j] * F_canon[i, j] for j in range(len(tr)))\n\n# Values using canonical F + Q_geom\nvalues_cf_gq = np.zeros(len(x))\nfor i, idx in enumerate(tx):\n    values_cf_gq[idx] = sum(Q_geom[i, j] * F_canon[i, j] for j in range(len(tr)))\n\n# Values using geom F + Q_geom\nvalues_gf_gq = np.zeros(len(x))\nfor i, idx in enumerate(tx):\n    values_gf_gq[idx] = sum(Q_geom[i, j] * F_geom[i, j] for j in range(len(tr)))\n\n# Reference canonical\nv_canon = canonical.value(x, y, r, ry, seed)\n\ndef metrics(v, name):\n    nrmse = np.sqrt(np.mean((v - v_canon)**2)) / v_canon.std()\n    sp, _ = spearmanr(v, v_canon)\n    N = len(v); k = N // 4\n    idx_c = np.argsort(-v_canon, kind='stable')[:k]\n    idx_v = np.argsort(-v, kind='stable')[:k]\n    overlap = len(np.intersect1d(idx_c, idx_v)) / k\n    print(f\\\"  {name}: NRMSE={nrmse:.6f}, Spearman={sp:.6f}, TopQ={overlap:.4f}\\\")\n\nprint(\\\"\\\\nQuality comparisons (vs canonical value):\\\")\nmetrics(values_cf_cq, \\\"canon F + canon Q\\\")\nmetrics(values_cf_gq, \\\"canon F + geom Q\\\")\nmetrics(values_gf_gq, \\\"geom F + geom Q\\\")\nPYEOF\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

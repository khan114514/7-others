{"type": "item.started", "item": {"id": "item_97", "type": "command_execution", "command": "/bin/sh -lc \"python3 << 'PYEOF'\nimport numpy as np\nimport sys, time, os\nimport torch\ntorch.set_num_threads(2)\nimport importlib.util\nfrom scipy.stats import spearmanr\n\n# Load canonical\nspec = importlib.util.spec_from_file_location(\\\"canonical\\\", \\\"/tmp/research_history/method_canonical.py\\\")\ncanonical = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(canonical)\n\n# Load v10b\nspec = importlib.util.spec_from_file_location(\\\"v10b\\\", \\\"/tmp/v10b_method.py\\\")\nv10b = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(v10b)\n\ncase_files = sorted([f for f in os.listdir('/workspace/environment/public_assets/dev')\n                     if f.endswith('.npz') and '101' in f])\n\nprint(f\\\"Testing {len(case_files)} cases (seed 101)\\\")\nprint(\\\"=\\\" * 70)\n\nfor cf in case_files:\n    data = np.load(f'/workspace/environment/public_assets/dev/{cf}')\n    x, y, r, ry = data['x'], data['y'], data['r'], data['ry']\n    seed = int(data['seed'])\n    \n    # Canonical (target)\n    t0 = time.time()\n    v_canon = canonical.value(x, y, r, ry, seed)\n    t_canon = time.time() - t0\n    \n    # v10b\n    t0 = time.time()\n    v = v10b.value(x, y, r, ry, seed)\n    t_v = time.time() - t0\n    \n    nrmse = np.sqrt(np.mean((v - v_canon)**2)) / v_canon.std()\n    sp, _ = spearmanr(v, v_canon)\n    \n    N = len(v)\n    k = N // 4\n    idx_canon = np.argsort(-v_canon, kind='stable')[:k]\n    idx_v = np.argsort(-v, kind='stable')[:k]\n    overlap = len(np.intersect1d(idx_canon, idx_v)) / k\n    \n    print(f\\\"{cf}\\\")\n    print(f\\\"  canon: {t_canon:.3f}s, v10b: {t_v:.3f}s, speedup: {t_canon/t_v:.2f}x\\\")\n    print(f\\\"  NRMSE: {nrmse:.6f} {'✓' if nrmse <= 0.01 else '✗'}\\\")\n    print(f\\\"  Spearman: {sp:.6f} {'✓' if sp >= 0.999 else '✗'}\\\")\n    print(f\\\"  TopQ: {overlap:.4f} {'✓' if overlap >= 0.98 else '✗'}\\\")\n    print()\n\nPYEOF\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

{"type": "item.started", "item": {"id": "item_54", "type": "command_execution", "command": "/bin/sh -lc \"python3 << 'EOF'\nimport numpy as np\nimport torch\nfrom geomloss import SamplesLoss\nimport ot\nfrom scipy.spatial.distance import cdist\n\ntorch.set_num_threads(2)\nnp.random.seed(42)\n\nn, m = 200, 180\nx = np.random.randn(n, 10).astype(np.float32)\ny = np.random.randn(m, 10).astype(np.float32) + 0.3\n\n# POT log-domain Sinkhorn  \nC = cdist(x, y, 'sqeuclidean').astype(np.float64) / 2.0\na = np.ones(n) / n\nb = np.ones(m) / m\nreg = 0.1\n\nP, log_dict = ot.sinkhorn(a, b, C, reg, method='sinkhorn_log', log=True, numItermax=2000, stopThr=1e-9)\nlog_u = log_dict['log_u']\nlog_v = log_dict['log_v']\n\nf_pot = reg * (log_u - np.log(a))\ng_pot = reg * (log_v - np.log(b))\n\n# Centered potentials, n/(n-1) scaling like canonical\nf_pot_c = (f_pot - f_pot.mean()) * n / (n - 1)\n\n# GeomLoss\npotential = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                        potentials=True, backend='tensorized')\nwith torch.inference_mode():\n    f_g, g_g = potential(torch.tensor(x)[None], torch.tensor(y)[None])\nf_g = f_g.numpy().ravel()\ng_g = g_g.numpy().ravel()\nf_g_c = (f_g - f_g.mean()) * n / (n - 1)\n\nprint(\\\"POT f_pot mean:\\\", f_pot.mean())\nprint(\\\"Geom f_g mean:\\\", f_g.mean())\nprint()\nprint(\\\"Correlation of centered POT f vs Geom f:\\\", np.corrcoef(f_pot_c, f_g_c)[0,1])\nprint(\\\"NRMSE of POT f vs Geom f:\\\", np.sqrt(np.mean((f_pot_c - f_g_c)**2)) / f_g_c.std())\nprint()\nprint(\\\"POT dual value:\\\", np.dot(a, f_pot) + np.dot(b, g_pot))\nprint(\\\"GeomLoss value:\\\", f_g.mean() + g_g.mean())  # since weights are uniform\nprint()\nprint(\\\"POT primal sum(P*C):\\\", np.sum(P * C))\n\n# Check if POT total / (n+m) matches GeomLoss? No, earlier it didn't.\n# Check ratio\nprint()\nprint(\\\"GeomLoss total / POT dual:\\\", (f_g.mean() + g_g.mean()) / (np.dot(a, f_pot) + np.dot(b, g_pot)))\nEOF\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

[idx];b=r[jdx]\n            C=cdist(a,b,'sqeuclidean')/2+W[y[idx,None],ry[jdx][None,:]+10]/2\n            P=ot.sinkhorn(ot.unif(len(idx)),ot.unif(len(jdx)),C/max(float(C.max()),1e-12),.1)\n            batchcost[i,j]=float(np.sum(P*C))/(len(idx)+len(jdx))\n            z1=torch.tensor(np.column_stack([a,y[idx]]),dtype=torch.float32)[None]\n            z2=torch.tensor(np.column_stack([b,ry[jdx]+10]),dtype=torch.float32)[None]\n            with torch.inference_mode(): f,_=potential(z1,z2)\n            f=f.numpy().ravel().astype(float)\n            F[i,j]=(f-f.mean())*len(f)/(len(f)-1)\n    Q=ot.sinkhorn(ot.unif(len(tx)),ot.unif(len(tr)),\n                  batchcost/max(float(batchcost.max()),1e-12),.01,\n                  numItermax=10000,stopThr=1e-10)\n    values=np.zeros(len(x))\n    for i,idx in enumerate(tx): values[idx]=sum(Q[i,j]*F[i,j] for j in range(len(tr)))\n    return values\n\ndef run_v12(x, y, r, ry, seed=17, batch_size=1024):\n    x=np.asarray(x,np.float32); r=np.asarray(r,np.float32)\n    y=np.asarray(y,np.int64); ry=np.asarray(ry,np.int64)\n    tx=[np.arange(i,min(i+batch_size,len(x))) for i in range(0,len(x),batch_size)]\n    tr=[np.arange(i,min(i+batch_size,len(r))) for i in range(0,len(r),batch_size)]\n    xx=torch.tensor(np.concatenate([x[tx[0]],r[tr[0]]]),dtype=torch.float32)\n    yy=np.concatenate([y[tx[0]],ry[tr[0]]+10])\n    W=np.zeros((20,20),dtype=np.float32)\n    loss=SamplesLoss('sinkhorn',p=2,blur=np.sqrt(.1),debias=False,backend='tensorized')\n    with torch.inference_mode():\n        for i in range(20):\n            for j in range(i+1,20):\n                W[i,j]=W[j,i]=float(loss(xx[yy==i],xx[yy==j]))\n    def cost(z1,z2):\n        d=torch.cdist(z1[:,:,:-1],z2[:,:,:-1]).square()/2\n        return d+torch.as_tensor(W)[z1[:,:,-1].long().unsqueeze(2),z2[:,:,-1].long().unsqueeze(1)]/2\n    potential=SamplesLoss('sinkhorn',p=2,blur=np.sqrt(.1),debias=False,\n                         potentials=True,cost=cost,backend='tensorized')\n    F={}; batchcost=np.zeros((len(tx),len(tr)))\n    for i,idx in enumerate(tx):\n        for j,jdx in enumerate(tr):\n            a=x[idx];b=r[jdx]\n            n_src=len(idx);n_tgt=len(jdx)\n            z1=torch.tensor(np.column_stack([a,y[idx]]),dtype=torch.float32)[None]\n            z2=torch.tensor(np.column_stack([b,ry[jdx]+10]),dtype=torch.float32)[None]\n            \n            # F from GeomLoss (canonical reg = 0.1)\n            with torch.inference_mode(): f_t,_=potential(z1,z2)\n            f=f_t.numpy().ravel().astype(float)\n            F[i,j]=(f-f.mean())*len(f)/(len(f)-1)\n            \n            # Batchcost from GeomLoss with matched effective reg\n            C=cdist(a,b,'sqeuclidean')/2+W[y[idx,None],ry[jdx][None,:]+10]/2\n            c_max = float(C.max())\n            reg_match = 0.1 * c_max\n            blur_match = np.sqrt(reg_match)\n            pot_match = SamplesLoss('sinkhorn', p=2, blur=blur_match, debias=False,\n                                   potentials=True, cost=cost, backend='tensorized')\n            with torch.inference_mode():\n                fm_t, gm_t = pot_match(z1, z2)\n            fm = fm_t.numpy().ravel()\n            gm = gm_t.numpy().ravel()\n            \n            # Reconstruct P and compute batchcost\n            alpha = 1.0 / n_src\n            beta = 1.0 / n_tgt\n            P = alpha * beta * np.exp((fm[:, None] + gm[None, :] - C) / reg_match)\n            batchcost[i, j] = float(np.sum(P * C)) / (n_src + n_tgt)\n    \n    Q=ot.sinkhorn(ot.unif(len(tx)),ot.unif(len(tr)),\n                  batchcost/max(float(batchcost.max()),1e-12),.01,\n                  numItermax=10000,stopThr=1e-10)\n    values=np.zeros(len(x))\n    for i,idx in enumerate(tx): values[idx]=sum(Q[i,j]*F[i,j] for j in range(len(tr)))\n    return values\n\n# Test all 30 cases\nall_cases = sorted([f[:-4] for f in os.listdir('/workspace/environment/public_assets/dev/') if f.endswith('.npz')])\n\nprint(f\\\"Testing {len(all_cases)} cases...\\\")\nprint(\\\"=\\\" * 80)\n\ncanonical_times = []\nv12_times = []\nall_pass = True\n\nfor case_id in all_cases:\n    d = np.load(f'/workspace/environment/public_assets/dev/{case_id}.npz')\n    x, y, r, ry, seed = d['x'], d['y'], d['r'], d['ry'], int(d['seed'])\n    \n    # Canonical (run once)\n    t0 = time.perf_counter()\n    v_c = run_canonical(x, y, r, ry, seed=seed)\n    t1 = time.perf_counter()\n    canonical_times.append(t1 - t0)\n    \n    # v12\n    t0 = time.perf_counter()\n    v_f = run_v12(x, y, r, ry, seed=seed)\n    t1 = time.perf_counter()\n    v12_times.append(t1 - t0)\n    \n    # Quality\n    nrm = nrmse(v_f, v_c)\n    sp = spearmanr(v_f, v_c)[0]\n    tq = top_q_overlap(v_f, v_c)\n    ok = nrm <= 0.01 and sp >= 0.999 and tq >= 0.98\n    if not ok:\n        all_pass = False\n    \n    status = \\\"PASS\\\" if ok else \\\"FAIL\\\"\n    print(f\\\"{case_id:40s}: canon={canonical_times[-1]:.2f}s v12={v12_times[-1]:.2f}s \\\"\n          f\\\"NRMSE={nrm:.5f} Spear={sp:.5f} TopQ={tq:.5f} [{status}]\\\")\n\nprint(\\\"=\\\" * 80)\nprint(f\\\"Mean canonical time: {np.mean(canonical_times):.3f}s\\\")\nprint(f\\\"Mean v12 time: {np.mean(v12_times):.3f}s\\\")\nprint(f\\\"Speedup: {np.mean(canonical_times) / np.mean(v12_times):.2f}x\\\")\nprint(f\\\"All pass: {all_pass}\\\")\nPYEOF\npython3 /tmp/test_v12_multi.py 2>&1 | grep -v UserWarning | grep -v \\\"warnings.warn\\\"\"", "aggregated_output": "Testing 30 cases...\n================================================================================\nseed_101_asymmetric_labels              : canon=3.23s v12=1.32s NRMSE=0.00350 Spear=0.99999 TopQ=0.99867 [PASS]\nseed_101_gaussian_008                   : canon=3.56s v12=1.23s NRMSE=0.00394 Spear=0.99999 TopQ=0.99733 [PASS]\nseed_101_gaussian_016                   : canon=3.17s v12=1.37s NRMSE=0.00307 Spear=0.99999 TopQ=0.99867 [PASS]\nseed_101_gaussian_024                   : canon=3.60s v12=1.92s NRMSE=0.00287 Spear=1.00000 TopQ=0.99867 [PASS]\nseed_101_mixed                          : canon=3.99s v12=1.34s NRMSE=0.00256 Spear=1.00000 TopQ=0.99867 [PASS]\nseed_101_uniform_labels                 : canon=3.45s v12=1.21s NRMSE=0.00170 Spear=1.00000 TopQ=0.99867 [PASS]\nseed_202_asymmetric_labels              : canon=4.70s v12=1.40s NRMSE=0.06440 Spear=0.99511 TopQ=0.97467 [FAIL]\nseed_202_gaussian_008                   : canon=3.98s v12=1.37s NRMSE=0.08953 Spear=0.99550 TopQ=0.96800 [FAIL]\nseed_202_gaussian_016                   : canon=4.54s v12=1.70s NRMSE=0.07726 Spear=0.99721 TopQ=0.98000 [FAIL]\nseed_202_gaussian_024                   : canon=2.47s v12=2.08s NRMSE=0.07457 Spear=0.99743 TopQ=0.97733 [FAIL]\nseed_202_mixed                          : canon=3.81s v12=1.30s NRMSE=0.07364 Spear=0.99677 TopQ=0.98400 [FAIL]\nseed_202_uniform_labels                 : canon=3.69s v12=1.75s NRMSE=0.05621 Spear=0.99422 TopQ=0.98000 [FAIL]\nseed_303_asymmetric_labels              : canon=5.16s v12=2.37s NRMSE=0.00669 Spear=0.99995 TopQ=0.99733 [PASS]\nseed_303_gaussian_008                   : canon=6.61s v12=1.16s NRMSE=0.05408 Spear=0.99915 TopQ=0.97600 [FAIL]\nseed_303_gaussian_016                   : canon=4.31s v12=2.06s NRMSE=0.04707 Spear=0.99928 TopQ=0.97733 [FAIL]\nseed_303_gaussian_024                   : canon=4.37s v12=2.14s NRMSE=0.04584 Spear=0.99935 TopQ=0.97467 [FAIL]\nseed_303_mixed                          : canon=5.92s v12=1.24s NRMSE=0.04452 Spear=0.99936 TopQ=0.98000 [FAIL]\nseed_303_uniform_labels                 : canon=3.27s v12=1.13s NRMSE=0.03764 Spear=0.99813 TopQ=0.99467 [FAIL]\nseed_404_asymmetric_labels              : canon=4.06s v12=1.15s NRMSE=0.07495 Spear=0.99452 TopQ=0.97467 [FAIL]\nseed_404_gaussian_008                   : canon=3.05s v12=1.35s NRMSE=0.08493 Spear=0.99726 TopQ=0.95200 [FAIL]\nseed_404_gaussian_016                   : canon=3.44s v12=1.11s NRMSE=0.07294 Spear=0.99821 TopQ=0.98400 [FAIL]\nseed_404_gaussian_024                   : canon=5.71s v12=1.44s NRMSE=0.06961 Spear=0.99820 TopQ=0.99200 [FAIL
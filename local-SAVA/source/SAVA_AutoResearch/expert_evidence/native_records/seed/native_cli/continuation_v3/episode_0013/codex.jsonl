{"type": "item.started", "item": {"id": "item_56", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/test_batchcost_fix.py << 'PYEOF'\n\\\"\\\"\\\"Test: fix batchcost from GeomLoss potentials by using correct P formula.\\\"\\\"\\\"\nimport numpy as np, sys\nsys.path.insert(0, '/workspace/solution')\n\nimport torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nimport ot\n\nd = np.load('/workspace/environment/public_assets/dev/seed_101_uniform_labels.npz')\nx, y, r, ry, seed = d['x'], d['y'], d['r'], d['ry'], int(d['seed'])\n\ntorch.set_num_threads(2)\nx=np.asarray(x,np.float32); r=np.asarray(r,np.float32)\ny=np.asarray(y,np.int64); ry=np.asarray(ry,np.int64)\nbatch_size = 1024\ntx=[np.arange(i,min(i+batch_size,len(x))) for i in range(0,len(x),batch_size)]\ntr=[np.arange(i,min(i+batch_size,len(r))) for i in range(0,len(r),batch_size)]\n\nxx=torch.tensor(np.concatenate([x[tx[0]],r[tr[0]]]),dtype=torch.float32)\nyy=np.concatenate([y[tx[0]],ry[tr[0]]+10])\nW=np.zeros((20,20),dtype=np.float32)\nloss=SamplesLoss('sinkhorn',p=2,blur=np.sqrt(.1),debias=False,backend='tensorized')\nwith torch.inference_mode():\n    for i in range(20):\n        for j in range(i+1,20):\n            W[i,j]=W[j,i]=float(loss(xx[yy==i],xx[yy==j]))\n\ndef cost(z1,z2):\n    d=torch.cdist(z1[:,:,:-1],z2[:,:,:-1]).square()/2\n    return d+torch.as_tensor(W)[z1[:,:,-1].long().unsqueeze(2),z2[:,:,-1].long().unsqueeze(1)]/2\n\npotential=SamplesLoss('sinkhorn',p=2,blur=np.sqrt(.1),debias=False,\n                     potentials=True,cost=cost,backend='tensorized')\n\n# Test pair (0,0)\ni, j = 0, 0\nidx = tx[i]; jdx = tr[j]\na = x[idx]; b = r[jdx]\nn, m = len(idx), len(jdx)\n\n# Canonical POT\nC = cdist(a, b, 'sqeuclidean') / 2 + W[y[idx[:, None]], ry[jdx][None, :] + 10] / 2\nP_pot = ot.sinkhorn(ot.unif(n), ot.unif(m), C / max(float(C.max()), 1e-12), .1)\nbc_pot = float(np.sum(P_pot * C)) / (n + m)\nprint(f\\\"POT batchcost: {bc_pot:.6f}\\\")\nprint(f\\\"POT sum(P): {P_pot.sum():.6f} (should be 1.0)\\\")\nprint(f\\\"POT row sums: {P_pot.sum(axis=1)[:5]} (should be {1/n:.6f})\\\")\nprint(f\\\"POT col sums: {P_pot.sum(axis=0)[:5]} (should be {1/m:.6f})\\\")\n\n# GeomLoss potentials\nz1=torch.tensor(np.column_stack([a,y[idx]]),dtype=torch.float32)[None]\nz2=torch.tensor(np.column_stack([b,ry[jdx]+10]),dtype=torch.float32)[None]\nwith torch.inference_mode(): f_t,g_t=potential(z1,z2)\nf = f_t.numpy().ravel().astype(np.float64)\ng = g_t.numpy().ravel().astype(np.float64)\n\n# Standard Sinkhorn: P_ij = a_i * b_j * exp((f_i + g_j - C_ij) / reg)\nreg = 0.1\na_w = 1.0 / n  # uniform source weight\nb_w = 1.0 / m  # uniform target weight\n\n# Wait - let's check what convention GeomLoss uses\n# GeomLoss uses: loss = <a, f> + <b, g>\n# where f and g are such that: P = diag(a) * K * diag(b) satisfies\n# K_ij = exp(-C_ij / reg), i.e., P_ij = a_i * b_j * exp(-C_ij / reg + log(u_i) + log(v_j))\n# In the dual formulation: f = reg * log(u), g = reg * log(v)\n# So P_ij = a_i * b_j * exp((f_i + g_j - C_ij) / reg)\n\nP_geom = a_w * b_w * np.exp((f[:, None] + g[None, :] - C) / reg)\nprint(f\\\"\\\\nGeomLoss P sum: {P_geom.sum():.6f} (should be 1.0)\\\")\nprint(f\\\"GeomLoss row sums: {P_geom.sum(axis=1)[:5]} (should be {a_w:.6f})\\\")\nprint(f\\\"GeomLoss col sums: {P_geom.sum(axis=0)[:5]} (should be {b_w:.6f})\\\")\nprint(f\\\"GeomLoss batchcost: {float(np.sum(P_geom * C)) / (n + m):.6f}\\\")\n\n# What if we compute batchcost differently?\n# The Sinkhorn divergence is: W_eps = sum_{ij} P_ij * C_ij\n# But batchcost divides by (n+m). Let's check what it should be.\n# POT P_ij = a_i b_j exp(...) where a_i = 1/n, b_j = 1/m\n# sum P = 1, and sum P*C = transport cost between distributions a and b\n\n# Wait, canonical divides by (n+m). That's odd. \n# Let's check: canonical batchcost[i,j] = sum(P*C) / (n+m)\n# P has total mass 1, so sum(P*C) is the total transport cost.\n# Dividing by (n+m) is unusual... \n\n# Let's look at the canonical values more carefully\nprint(f\\\"\\\\nPOT sum(P*C): {float(np.sum(P_pot * C)):.6f}\\\")\nprint(f\\\"POT batchcost (sum/(n+m)): {float(np.sum(P_pot * C)) / (n + m):.6f}\\\")\n\n# Check: is P_pot * C the right thing?\n# Actually in Sinkhorn, the transport cost is sum_{ij} P_ij * C_ij\n# And P has marginal constraints sum_j P_ij = a_i, sum_i P_ij = b_j\n# With uniform a (1/n) and uniform b (1/m), sum P = 1\n\n# Now what is GeomLoss's P?\nprint(f\\\"\\\\nGeomLoss f range: [{f.min():.2f}, {f.max():.2f}]\\\")\nprint(f\\\"GeomLoss g range: [{g.min():.2f}, {g.max():.2f}]\\\")\nprint(f\\\"C range: [{C.min():.2f}, {C.max():.2f}]\\\")\nprint(f\\\"exp((f+g-C)/reg) range: [{np.exp((f[:, None] + g[None, :] - C) / reg).min():.2e}, {np.exp((f[:, None] + g[None, :] - C) / reg).max():.2e}]\\\")\n\n# Maybe the GeomLoss convention is different? f and g might not be\n# the standard Sinkhorn potentials. Let's check the GeomLoss formula.\n# In GeomLoss, the Sinkhorn loss is:\n# S_eps(alpha, beta) = sum_i alpha_i f_i + sum_j beta_j g_j\n# where f and g are the dual potentials.\n# The coupling is P_ij = alpha_i * beta_j * K_ij = alpha_i * beta_j * exp(-C_ij / eps)\n# With scalings: log(u_i) = f_i / eps, log(v_j) = g_j / eps\n# So P_ij = alpha_i * beta_j * exp((f_i + g_j - C_ij) / eps)\n\n# Let me try: just use the loss value directly?\n# SamplesLoss with loss=True gives S_eps = <alpha, f> + <beta, g>\nloss_fn = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\nwith torch.inference_mode():\n    loss_val = float(loss_fn(z1, z2))\nprint(f\\\"\\\\nGeomLoss loss value: {loss_val:.6f}\\\")\n\n# S_eps = sum a_i f_i + sum b_j g_j\n# With uniform a (1/n) and b (1/m):\n# S_eps = mean(f) + mean(g)\nmanual_sinkhorn = f.mean() + g.mean()\nprint(f\\\"Manual S_eps (mean f + mean g): {manual_sinkhorn:.6f}\\\")\n\n# Hmm, but that might not match the transport cost.\n# The OT cost sum(P*C) = S_eps - eps * (sum a_i log(a_i) + sum b_j log(b_j) - sum P_ij log(P_ij))\n# No, that's the entropy-regularized OT value = sum P*C + eps * H(P)\n# And the dual S_eps = primal = sum P*C + eps * H(P)\n\n# So S_eps is the entropy-regularized transport cost, which is exactly what we need.\n# But canonical uses sum(P*C) / (n+m). Let's see the relationship.\n\n# Actually, let's just check: what if we use loss_val as batchcost?\nprint(f\\\"\\\\nIf we use S_eps as batchcost: {loss_val:.6f}\\\")\nprint(f\\\"vs canonical batchcost: {bc_pot:.6f}\\\")\n\n# The scaling is very different. But maybe the Q normalization handles it?\n# Let's test with all batch pairs and see if Q is similar.\n\n# Let me compute all pairs with both methods\nprint(\\\"\\\\n=== All pairs: S_eps from GeomLoss vs batchcost from POT ===\\\")\nfor i, idx in enumerate(tx):\n    for j, jdx in enumerate(tr):\n        a=x[idx]; b=r[jdx]\n        n=len(idx); m=len(jdx)\n        C = cdist(a, b, 'sqeuclidean') / 2 + W[y[idx[:, None]], ry[jdx][None, :] + 10] / 2\n        P_pot = ot.sinkhorn(ot.unif(n), ot.unif(m), C / max(float(C.max()), 1e-12), .1)\n        bc_pot = float(np.sum(P_pot * C)) / (n + m)\n        \n        z1=torch.tensor(np.column_stack([a,y[idx]]),dtype=torch.float32)[None]\n        z2=torch.tensor(np.column_stack([b,ry[jdx]+10]),dtype=torch.float32)[None]\n        with torch.inference_mode():\n            f_t,g_t=potential(z1,z2)\n        s_eps = float(loss_fn(z1, z2))\n        \n        print(f\\\"  ({i},{j}): POT_BC={bc_pot:.6f}, S_eps={s_eps:.6f}, ratio={s_eps/bc_pot:.2f}\\\")\nPYEOF\npython3 /tmp/test_batchcost_fix.py\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

{"type": "item.started", "item": {"id": "item_132", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/direct_compare.py << 'PYEOF'\n\\\"\\\"\\\"Direct comparison: canonical values vs v12 values on one case.\nFind what's different.\\\"\\\"\\\"\nimport numpy as np\nimport torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nfrom scipy.stats import spearmanr\nimport ot\n\ntorch.set_num_threads(2)\n\nd = np.load('/workspace/environment/public_assets/dev/seed_202_uniform_labels.npz')\nx, y, r, ry, seed = d['x'], d['y'], d['r'], d['ry'], int(d['seed'])\n\nbatch_size = 1024\n\ndef compute_all(x, y, r, ry, mode='canonical'):\n    x=np.asarray(x,np.float32); r=np.asarray(r,np.float32)\n    y=np.asarray(y,np.int64); ry=np.asarray(ry,np.int64)\n    tx=[np.arange(i,min(i+batch_size,len(x))) for i in range(0,len(x),batch_size)]\n    tr=[np.arange(i,min(i+batch_size,len(r))) for i in range(0,len(r),batch_size)]\n    xx=torch.tensor(np.concatenate([x[tx[0]],r[tr[0]]]),dtype=torch.float32)\n    yy=np.concatenate([y[tx[0]],ry[tr[0]]+10])\n    W=np.zeros((20,20),dtype=np.float32)\n    loss=SamplesLoss('sinkhorn',p=2,blur=np.sqrt(.1),debias=False,backend='tensorized')\n    with torch.inference_mode():\n        for i in range(20):\n            for j in range(i+1,20):\n                W[i,j]=W[j,i]=float(loss(xx[yy==i],xx[yy==j]))\n    def cost(z1,z2):\n        d=torch.cdist(z1[:,:,:-1],z2[:,:,:-1]).square()/2\n        return d+torch.as_tensor(W)[z1[:,:,-1].long().unsqueeze(2),z2[:,:,-1].long().unsqueeze(1)]/2\n    potential=SamplesLoss('sinkhorn',p=2,blur=np.sqrt(.1),debias=False,\n                         potentials=True,cost=cost,backend='tensorized')\n    F={}; batchcost=np.zeros((len(tx),len(tr)))\n    for i,idx in enumerate(tx):\n        for j,jdx in enumerate(tr):\n            a=x[idx];b=r[jdx]\n            n_src=len(idx);n_tgt=len(jdx)\n            \n            # F from GeomLoss (same for both modes)\n            z1=torch.tensor(np.column_stack([a,y[idx]]),dtype=torch.float32)[None]\n            z2=torch.tensor(np.column_stack([b,ry[jdx]+10]),dtype=torch.float32)[None]\n            with torch.inference_mode(): f_t,_=potential(z1,z2)\n            f=f_t.numpy().ravel().astype(float)\n            F[i,j]=(f-f.mean())*len(f)/(len(f)-1)\n            \n            if mode == 'canonical':\n                C=cdist(a,b,'sqeuclidean')/2+W[y[idx,None],ry[jdx][None,:]+10]/2\n                P=ot.sinkhorn(ot.unif(n_src),ot.unif(n_tgt),C/max(float(C.max()),1e-12),.1)\n                batchcost[i,j]=float(np.sum(P*C))/(n_src+n_tgt)\n            elif mode == 'v12':\n                C=cdist(a,b,'sqeuclidean')/2+W[y[idx,None],ry[jdx][None,:]+10]/2\n                c_max = float(C.max())\n                reg_match = 0.1 * c_max\n                blur_match = np.sqrt(reg_match)\n                pot_match = SamplesLoss('sinkhorn', p=2, blur=blur_match, debias=False,\n                                       potentials=True, cost=cost, backend='tensorized')\n                with torch.inference_mode():\n                    fm_t, gm_t = pot_match(z1, z2)\n                fm = fm_t.numpy().ravel()\n                gm = gm_t.numpy().ravel()\n                P = (1.0/n_src) * (1.0/n_tgt) * np.exp((fm[:, None] + gm[None, :] - C) / reg_match)\n                batchcost[i, j] = float(np.sum(P * C)) / (n_src + n_tgt)\n    \n    Q=ot.sinkhorn(ot.unif(len(tx)),ot.unif(len(tr)),\n                  batchcost/max(float(batchcost.max()),1e-12),.01,\n                  numItermax=10000,stopThr=1e-10)\n    values=np.zeros(len(x))\n    for i,idx in enumerate(tx): values[idx]=sum(Q[i,j]*F[i,j] for j in range(len(tr)))\n    return values, F, batchcost, Q\n\nv_c, F_c, bc_c, Q_c = compute_all(x, y, r, ry, mode='canonical')\nv_v, F_v, bc_v, Q_v = compute_all(x, y, r, ry, mode='v12')\n\ndef nrmse(p, t): return np.sqrt(np.mean((p-t)**2)) / np.std(t)\ndef topq(a, b, q=0.25):\n    k = int(len(a)*q)\n    return len(set(np.argsort(-a)[:k]) & set(np.argsort(-b)[:k])) / k\n\nprint(f\\\"NRMSE: {nrmse(v_v, v_c):.5f}\\\")\nprint(f\\\"Spearman: {spearmanr(v_v, v_c)[0]:.5f}\\\")\nprint(f\\\"TopQ: {topq(v_v, v_c):.5f}\\\")\n\n# Compare F matrices\nprint(\\\"\\\\n=== F comparison ===\\\")\nfor (i,j), f_c in F_c.items():\n    f_v = F_v[i,j]\n    print(f\\\"  F[{i},{j}]: max diff = {abs(f_c - f_v).max():.6e}, \\\"\n          f\\\"mean diff = {abs(f_c - f_v).mean():.6e}\\\")\n\n# Compare batchcost\nprint(\\\"\\\\n=== Batchcost ===\\\")\nprint(f\\\"  Canonical: {bc_c.ravel()}\\\")\nprint(f\\\"  v12:       {bc_v.ravel()}\\\")\nprint(f\\\"  Q canon:   {Q_c.ravel()}\\\")\nprint(f\\\"  Q v12:     {Q_v.ravel()}\\\")\nprint(f\\\"  Q diff max: {abs(Q_c - Q_v).max():.6e}\\\")\n\n# If F is same, then the difference must come from Q * F\n# But wait, if rank corr is 1.0 and Q comes from normalized batchcost,\n# Q should be identical since OT result depends on relative values.\nprint(f\\\"\\\\n  Q uniform Q: {np.ones_like(Q_c) / Q_c.size}\\\")\nPYEOF\npython3 /tmp/direct_compare.py 2>&1 | grep -v UserWarning | grep -v \\\"warnings.warn\\\"\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

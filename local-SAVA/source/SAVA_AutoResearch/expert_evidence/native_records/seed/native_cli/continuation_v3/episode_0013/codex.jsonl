ch = SamplesLoss('sinkhorn', p=2, blur=blur_match, debias=False, potentials=True, cost=cost_fn, backend='tensorized')\n\nwith torch.inference_mode(): _ = pot_match(z1, z2)  # warmup\nt0 = time.perf_counter()\nfor _ in range(10):\n    with torch.inference_mode():\n        fm, gm = pot_match(z1, z2)\nt1 = time.perf_counter()\nprint(f\\\"GeomLoss pot (reg=0.1*C_max): {(t1-t0)/10*1000:.1f}ms per call (1024x1024)\\\")\nprint(f\\\"  C_max={c_max:.1f}, blur_match={blur_match:.2f}\\\")\n\n# Time: just loss (not potentials)\nloss_match = SamplesLoss('sinkhorn', p=2, blur=blur_match, debias=False, cost=cost_fn, backend='tensorized')\nwith torch.inference_mode(): _ = loss_match(z1, z2)  # warmup\nt0 = time.perf_counter()\nfor _ in range(10):\n    with torch.inference_mode():\n        l = loss_match(z1, z2)\nt1 = time.perf_counter()\nprint(f\\\"GeomLoss loss (reg=0.1*C_max): {(t1-t0)/10*1000:.1f}ms per call\\\")\n\n# Time POT sinkhorn for comparison\nimport ot\nC_norm = C / c_max\nalpha = ot.unif(len(a))\nbeta = ot.unif(len(b))\nt0 = time.perf_counter()\nfor _ in range(10):\n    P = ot.sinkhorn(alpha, beta, C_norm, 0.1, numItermax=10000)\nt1 = time.perf_counter()\nprint(f\\\"POT sinkhorn (reg=0.1 normalized): {(t1-t0)/10*1000:.1f}ms per call\\\")\n\n# Can we use higher scaling for the matched-reg GeomLoss (fewer iterations)?\n# Default scaling=0.5 means many epsilon steps.\n# With such a large reg, maybe scaling=0.9 is fine\nfor scaling in [0.5, 0.7, 0.8, 0.9]:\n    pot_s = SamplesLoss('sinkhorn', p=2, blur=blur_match, debias=False, potentials=True, \n                        cost=cost_fn, backend='tensorized', scaling=scaling)\n    with torch.inference_mode(): _ = pot_s(z1, z2)  # warmup\n    t0 = time.perf_counter()\n    for _ in range(10):\n        with torch.inference_mode():\n            fm_s, gm_s = pot_s(z1, z2)\n    t1 = time.perf_counter()\n    \n    # Check accuracy of batchcost\n    fm_np = fm_s.numpy().ravel()\n    gm_np = gm_s.numpy().ravel()\n    reg_match = 0.1 * c_max\n    P_s = (1.0/len(a)) * (1.0/len(b)) * np.exp((fm_np[:, None] + gm_np[None, :] - C) / reg_match)\n    bc_s = float(np.sum(P_s * C)) / (len(a) + len(b))\n    \n    # Reference (scaling=0.5)\n    fm_ref, gm_ref = pot_match(z1, z2)\n    fm_ref_np = fm_ref.numpy().ravel()\n    gm_ref_np = gm_ref.numpy().ravel()\n    P_ref = (1.0/len(a)) * (1.0/len(b)) * np.exp((fm_ref_np[:, None] + gm_ref_np[None, :] - C) / reg_match)\n    bc_ref = float(np.sum(P_ref * C)) / (len(a) + len(b))\n    \n    print(f\\\"  scaling={scaling}: {(t1-t0)/10*1000:.1f}ms, bc_err={abs(bc_s-bc_ref)/bc_ref:.6f}\\\")\nPYEOF\npython3 /tmp/test_detailed_timing.py 2>&1 | grep -v UserWarning | grep -v \\\"warnings.warn\\\"\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

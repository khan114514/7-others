{"type": "item.started", "item": {"id": "item_128", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/small_v12_debug.py << 'PYEOF'\nimport numpy as np\nimport torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nimport ot\n\ntorch.set_num_threads(2)\n\n# Small test case\nnp.random.seed(42)\nn, m = 500, 400\na_np = np.random.randn(n, 10).astype(np.float32) * 2\nb_np = np.random.randn(m, 10).astype(np.float32) * 2\n\n# Dummy \\\"labels\\\" for W\nay = np.random.randint(0, 10, n)\nby = np.random.randint(0, 10, m)\n\n# Fake W matrix\nW = np.zeros((20, 20), dtype=np.float32)\nfor i in range(20):\n    for j in range(i+1, 20):\n        W[i,j] = W[j,i] = abs(i - j) * 50.0\n\ndef cost_fn(z1, z2):\n    d = torch.cdist(z1[:, :, :-1], z2[:, :, :-1]).square() / 2\n    return d + torch.as_tensor(W)[z1[:, :, -1].long().unsqueeze(2), z2[:, :, -1].long().unsqueeze(1)] / 2\n\nC = cdist(a_np, b_np, 'sqeuclidean') / 2 + W[ay[:, None], by[None, :] + 10] / 2\nc_max = float(C.max())\nprint(f\\\"C_max: {c_max:.1f}\\\")\n\n# Canonical POT\nalpha = np.ones(n) / n\nbeta = np.ones(m) / m\nP_pot = ot.sinkhorn(alpha, beta, C / c_max, 0.1, numItermax=10000)\ncost_pot = float(np.sum(P_pot * C))\nprint(f\\\"POT cost: {cost_pot:.6f}\\\")\n\n# GeomLoss matched reg\nreg_match = 0.1 * c_max\nblur_match = np.sqrt(reg_match)\na_t = torch.tensor(np.column_stack([a_np, ay]), dtype=torch.float32)[None]\nb_t = torch.tensor(np.column_stack([b_np, by + 10]), dtype=torch.float32)[None]\n\npot_match = SamplesLoss('sinkhorn', p=2, blur=blur_match, debias=False,\n                       potentials=True, cost=cost_fn, backend='tensorized')\nwith torch.inference_mode():\n    fm, gm = pot_match(a_t, b_t)\n\nfm_np = fm.numpy().ravel()\ngm_np = gm.numpy().ravel()\n\n# Reconstruct P\nP_geom = alpha[:, None] * beta[None, :] * np.exp((fm_np[:, None] + gm_np[None, :] - C) / reg_match)\ncost_geom = float(np.sum(P_geom * C))\nprint(f\\\"GeomLoss cost (reconstructed): {cost_geom:.6f}\\\")\nprint(f\\\"Ratio: {cost_geom / cost_pot:.6f}\\\")\nprint(f\\\"Row sum err: {abs(P_geom.sum(1) - alpha).max():.2e}\\\")\nprint(f\\\"Col sum err: {abs(P_geom.sum(0) - beta).max():.2e}\\\")\n\n# Try: normalize P to satisfy marginals exactly\n# Sinkhorn has one degree of freedom: f_i + g_j vs f_i + c + g_j - c\n# But that doesn't change P. The issue is GeomLoss convergence.\n# Let's try: take the P_geom and do a few Sinkhorn iterations to correct it\n\n# Log-domain correction\nf_corr = fm_np.copy()\ng_corr = gm_np.copy()\na_log = np.log(alpha)\nb_log = np.log(beta)\n\nfrom scipy.special import logsumexp\nfor it in range(5):\n    # f correction: f_i = -eps * logsumexp_j (b_log_j + g_j/eps - C_ij/eps)\n    f_new = -reg_match * logsumexp(b_log[None, :] + g_corr[None, :]/reg_match - C/reg_match, axis=1)\n    g_new = -reg_match * logsumexp(a_log[:, None] + f_new[:, None]/reg_match - C/reg_match, axis=0)\n    f_corr = f_new\n    g_corr = g_new\n\nP_corr = alpha[:, None] * beta[None, :] * np.exp((f_corr[:, None] + g_corr[None, :] - C) / reg_match)\ncost_corr = float(np.sum(P_corr * C))\nprint(f\\\"\\\\nAfter 5 log-domain correction iters:\\\")\nprint(f\\\"  cost: {cost_corr:.6f}\\\")\nprint(f\\\"  ratio: {cost_corr / cost_pot:.6f}\\\")\nprint(f\\\"  row sum err: {abs(P_corr.sum(1) - alpha).max():.2e}\\\")\nprint(f\\\"  col sum err: {abs(P_corr.sum(0) - beta).max():.2e}\\\")\nPYEOF\npython3 /tmp/small_v12_debug.py 2>&1 | grep -v UserWarning | grep -v \\\"warnings.warn\\\"\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

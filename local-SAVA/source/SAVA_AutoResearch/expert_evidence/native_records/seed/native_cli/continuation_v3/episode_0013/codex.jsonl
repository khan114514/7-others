{"type": "item.started", "item": {"id": "item_142", "type": "command_execution", "command": "/bin/sh -lc \"python3 << 'PYEOF'\n\\\"\\\"\\\"Key test: does v12 give correct F (point potentials)?\nIf yes, quality difference is purely from Q.\nIf no, we need to fix F too.\\\"\\\"\\\"\nimport numpy as np\nimport torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nimport ot\n\ntorch.set_num_threads(2)\n\nd = np.load('/workspace/environment/public_assets/dev/seed_202_uniform_labels.npz')\nx, y, r, ry = d['x'], d['y'], d['r'], d['ry']\n\n# First batch pair only (1024x1024)\nidx = slice(0, 1024)\njdx = slice(0, 1024)\na = x[idx]; b = r[jdx]\nay = y[idx]; by = ry[jdx]\n\n# Label cost from first batch\nxx = torch.tensor(np.concatenate([a, b]), dtype=torch.float32)\nyy = np.concatenate([ay, by + 10])\nW = np.zeros((20, 20), dtype=np.float32)\nloss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\nwith torch.inference_mode():\n    for i in range(20):\n        for j in range(i + 1, 20):\n            W[i, j] = W[j, i] = float(loss(xx[yy == i], xx[yy == j]))\n\ndef cost_fn(z1, z2):\n    d = torch.cdist(z1[:, :, :-1], z2[:, :, :-1]).square() / 2\n    return d + torch.as_tensor(W)[z1[:, :, -1].long().unsqueeze(2), z2[:, :, -1].long().unsqueeze(1)] / 2\n\n# F from canonical (GeomLoss with reg=0.1)\npotential = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                         potentials=True, cost=cost_fn, backend='tensorized')\nz1 = torch.tensor(np.column_stack([a, ay]), dtype=torch.float32)[None]\nz2 = torch.tensor(np.column_stack([b, by + 10]), dtype=torch.float32)[None]\nwith torch.inference_mode():\n    f_canon_t, _ = potential(z1, z2)\nf_canon = f_canon_t.numpy().ravel()\nF_canon = (f_canon - f_canon.mean()) * len(f_canon) / (len(f_canon) - 1)\n\n# v12 also uses the same GeomLoss for F (same call)\n# So F should be identical. Let's verify.\nwith torch.inference_mode():\n    f_v12_t, _ = potential(z1, z2)\nf_v12 = f_v12_t.numpy().ravel()\nF_v12 = (f_v12 - f_v12.mean()) * len(f_v12) / (len(f_v12) - 1)\n\nprint(f\\\"F max diff: {np.max(np.abs(F_canon - F_v12)):.6e}\\\")\nprint(f\\\"F is identical: {np.allclose(F_canon, F_v12)}\\\")\n\n# So the quality difference must come from Q difference * F magnitude.\n# Let's compute the expected NRMSE from Q difference.\n# values[i] = sum_j Q[i,j] * F[i,j]\n# If Q changes by dQ, values change by dQ * F\n# NRMSE = std(dQ * F) / std(values)\n\n# For the first candidate batch:\n# Q[i,:] changes by some amount, and F[i,0] and F[i,1] are the two potentials.\n# The error in values for batch i is dQ[i,0] * F[i,0] + dQ[i,1] * F[i,1]\n\n# Let's compute a rough estimate\n# Typical Q diff ~ 0.05 (from earlier max Q diff ~ 0.078)\n# F std ~ 100 (from earlier: std=105)\n# So error ~ 0.05 * 100 = 5\n# Value std ~ 100\n# NRMSE ~ 5/100 = 0.05 = 5%\n# But v12 has NRMSE=5.6% on seed_202... that matches\"'!\n\nprint(f\"'\"\\\\nF std (first pair): {F_canon.std():.2f}\\\")\nprint(f\\\"Q diff of 0.078 * F_std = {0.078 * F_canon.std():.2f}\\\")\nprint(f\\\"F_std ratio to NRMSE estimate = {0.078 * F_canon.std() / F_canon.std():.3f}\\\")\n\n# Yep, that's about right. The 5.6% NRMSE comes from Q differences.\n# Fix: use larger reg for Q computation to make Q less sensitive.\nPYEOF\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

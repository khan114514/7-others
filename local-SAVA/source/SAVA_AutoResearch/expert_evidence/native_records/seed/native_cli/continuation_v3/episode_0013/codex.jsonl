{"type": "item.started", "item": {"id": "item_109", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/test_pot_accel.py << 'PYEOF'\n\\\"\\\"\\\"Test: accelerate POT sinkhorn with log domain, float32, fewer iters.\\\"\\\"\\\"\nimport numpy as np, time\nimport ot\nfrom scipy.spatial.distance import cdist\n\n# Real-world-like cost\nnp.random.seed(42)\nn, m = 1024, 1024\na = np.random.randn(n, 10).astype(np.float32) * 3\nb = np.random.randn(m, 10).astype(np.float32) * 3\nC = cdist(a, b, 'sqeuclidean') / 2.0\nprint(f\\\"C shape: {C.shape}, dtype: {C.dtype}, max: {C.max():.1f}\\\")\n\nC_norm = C / C.max()\nalpha = np.ones(n, dtype=np.float64) / n\nbeta = np.ones(m, dtype=np.float64) / m\nreg = 0.1\n\n# Standard (default)\nP, log = ot.sinkhorn(alpha, beta, C_norm, reg, numItermax=10000, log=True)\ncost_ref = np.sum(P * C_norm)\nprint(f\\\"\\\\nStandard (float64): niter={log['niter']}, time to be measured...\\\")\n\ndef time_fn(fn, n_runs=5):\n    # warmup\n    fn()\n    times = []\n    for _ in range(n_runs):\n        t0 = time.perf_counter()\n        fn()\n        t1 = time.perf_counter()\n        times.append(t1 - t0)\n    return np.median(times)\n\n# Standard\nt = time_fn(lambda: ot.sinkhorn(alpha, beta, C_norm, reg, numItermax=10000))\nprint(f\\\"Standard: {t*1000:.1f}ms\\\")\n\n# float32\nalpha32 = alpha.astype(np.float32)\nbeta32 = beta.astype(np.float32)\nC_norm32 = C_norm.astype(np.float32)\nt = time_fn(lambda: ot.sinkhorn(alpha32, beta32, C_norm32, np.float32(reg), numItermax=10000))\nP32 = ot.sinkhorn(alpha32, beta32, C_norm32, np.float32(reg), numItermax=10000)\nprint(f\\\"float32: {t*1000:.1f}ms, cost_err={abs(np.sum(P32*C_norm32)-cost_ref)/cost_ref:.6f}\\\")\n\n# sinkhorn_log\nt = time_fn(lambda: ot.bregman.sinkhorn_log(alpha, beta, C_norm, reg, numItermax=10000))\nprint(f\\\"sinkhorn_log: {t*1000:.1f}ms\\\")\n\n# Try: manual Sinkhorn with torch\nimport torch\ntorch.set_num_threads(2)\n\nC_t = torch.tensor(C_norm, dtype=torch.float32)\na_t = torch.ones(n, dtype=torch.float32) / n\nb_t = torch.ones(m, dtype=torch.float32) / m\n\ndef torch_sinkhorn(a, b, C, reg, numItermax=1000, stopThr=1e-9):\n    u = torch.ones_like(a)\n    v = torch.ones_like(b)\n    K = torch.exp(-C / reg)\n    K_t = K.t()\n    for i in range(numItermax):\n        u_old = u.clone()\n        u = a / (K  @  v)\n        v = b / (K_t  @  u)\n        err = float(torch.max(torch.abs(u - u_old)))\n        if err < stopThr:\n            break\n    P = u[:, None] * K * v[None, :]\n    return P, i + 1\n\n# Warmup\n_, niter = torch_sinkhorn(a_t, b_t, C_t, 0.1)\nprint(f\\\"\\\\nTorch Sinkhorn: niter={niter}\\\")\nt = time_fn(lambda: torch_sinkhorn(a_t, b_t, C_t, 0.1))\nprint(f\\\"Torch Sinkhorn: {t*1000:.1f}ms\\\")\nP_t, _ = torch_sinkhorn(a_t, b_t, C_t, 0.1)\ncost_t = float((P_t * C_t).sum())\nprint(f\\\"  cost_err: {abs(cost_t - cost_ref) / cost_ref:.6f}\\\")\n\n# Torch log-domain\ndef torch_sinkhorn_log(a_log, b_log, C, reg, numItermax=1000, stopThr=1e-9):\n    f = torch.zeros_like(a_log)\n    g = torch.zeros_like(b_log)\n    for i in range(numItermax):\n        f_old = f.clone()\n        # f_i = -eps * logsumexp_j (b_log_j + g_j/eps - C_ij/eps)\n        f = -reg * torch.logsumexp(b_log[None, :] + g[None, :]/reg - C/reg, dim=1)\n        g = -reg * torch.logsumexp(a_log[:, None] + f[:, None]/reg - C/reg, dim=0)\n        err = float(torch.max(torch.abs(f - f_old)))\n        if err < stopThr:\n            break\n    P = torch.exp(a_log[:, None] + b_log[None, :] + (f[:, None] + g[None, :] - C) / reg)\n    return P, i + 1\n\na_log_t = torch.log(a_t)\nb_log_t = torch.log(b_t)\nP_log, niter_log = torch_sinkhorn_log(a_log_t, b_log_t, C_t, 0.1)\nprint(f\\\"\\\\nTorch Sinkhorn log: niter={niter_log}\\\")\nt = time_fn(lambda: torch_sinkhorn_log(a_log_t, b_log_t, C_t, 0.1))\nprint(f\\\"Torch Sinkhorn log: {t*1000:.1f}ms\\\")\ncost_log = float((P_log * C_t).sum())\nprint(f\\\"  cost_err: {abs(cost_log - cost_ref) / cost_ref:.6f}\\\")\nPYEOF\npython3 /tmp/test_pot_accel.py 2>&1 | grep -v UserWarning | grep -v \\\"warnings.warn\\\"\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

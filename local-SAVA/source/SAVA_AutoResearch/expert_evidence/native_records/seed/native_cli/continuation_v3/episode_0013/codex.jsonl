{"type": "item.started", "item": {"id": "item_54", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/test_v10_variants.py << 'PYEOF'\n\\\"\\\"\\\"Test v10 variants: try different Q approximations while keeping GeomLoss potentials.\\\"\\\"\\\"\nimport time, numpy as np, sys\nsys.path.insert(0, '/workspace/solution')\n\nimport torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nimport ot\n\ndef run_canonical(x, y, r, ry, seed=17, batch_size=1024):\n    torch.set_num_threads(2)\n    x=np.asarray(x,np.float32); r=np.asarray(r,np.float32)\n    y=np.asarray(y,np.int64); ry=np.asarray(ry,np.int64)\n    tx=[np.arange(i,min(i+batch_size,len(x))) for i in range(0,len(x),batch_size)]\n    tr=[np.arange(i,min(i+batch_size,len(r))) for i in range(0,len(r),batch_size)]\n    xx=torch.tensor(np.concatenate([x[tx[0]],r[tr[0]]]),dtype=torch.float32)\n    yy=np.concatenate([y[tx[0]],ry[tr[0]]+10])\n    W=np.zeros((20,20),dtype=np.float32)\n    loss=SamplesLoss('sinkhorn',p=2,blur=np.sqrt(.1),debias=False,backend='tensorized')\n    with torch.inference_mode():\n        for i in range(20):\n            for j in range(i+1,20):\n                W[i,j]=W[j,i]=float(loss(xx[yy==i],xx[yy==j]))\n    def cost(z1,z2):\n        d=torch.cdist(z1[:,:,:-1],z2[:,:,:-1]).square()/2\n        return d+torch.as_tensor(W)[z1[:,:,-1].long().unsqueeze(2),z2[:,:,-1].long().unsqueeze(1)]/2\n    potential=SamplesLoss('sinkhorn',p=2,blur=np.sqrt(.1),debias=False,\n                         potentials=True,cost=cost,backend='tensorized')\n    F={}; batchcost=np.zeros((len(tx),len(tr)))\n    for i,idx in enumerate(tx):\n        for j,jdx in enumerate(tr):\n            a=x[idx];b=r[jdx]\n            C=cdist(a,b,'sqeuclidean')/2+W[y[idx,None],ry[jdx][None,:]+10]/2\n            P=ot.sinkhorn(ot.unif(len(idx)),ot.unif(len(jdx)),C/max(float(C.max()),1e-12),.1)\n            batchcost[i,j]=float(np.sum(P*C))/(len(idx)+len(jdx))\n            z1=torch.tensor(np.column_stack([a,y[idx]]),dtype=torch.float32)[None]\n            z2=torch.tensor(np.column_stack([b,ry[jdx]+10]),dtype=torch.float32)[None]\n            with torch.inference_mode(): f,_=potential(z1,z2)\n            f=f.numpy().ravel().astype(float)\n            F[i,j]=(f-f.mean())*len(f)/(len(f)-1)\n    Q=ot.sinkhorn(ot.unif(len(tx)),ot.unif(len(tr)),\n                  batchcost/max(float(batchcost.max()),1e-12),.01,\n                  numItermax=10000,stopThr=1e-10)\n    values=np.zeros(len(x))\n    for i,idx in enumerate(tx): values[idx]=sum(Q[i,j]*F[i,j] for j in range(len(tr)))\n    return values, F, batchcost, Q\n\ndef run_geomloss_potentials(x, y, r, ry, seed=17, batch_size=1024):\n    \\\"\\\"\\\"Only compute potentials and batchcost using GeomLoss + P reconstruction.\\\"\\\"\\\"\n    torch.set_num_threads(2)\n    x=np.asarray(x,np.float32); r=np.asarray(r,np.float32)\n    y=np.asarray(y,np.int64); ry=np.asarray(ry,np.int64)\n    tx=[np.arange(i,min(i+batch_size,len(x))) for i in range(0,len(x),batch_size)]\n    tr=[np.arange(i,min(i+batch_size,len(r))) for i in range(0,len(r),batch_size)]\n    xx=torch.tensor(np.concatenate([x[tx[0]],r[tr[0]]]),dtype=torch.float32)\n    yy=np.concatenate([y[tx[0]],ry[tr[0]]+10])\n    W=np.zeros((20,20),dtype=np.float32)\n    loss=SamplesLoss('sinkhorn',p=2,blur=np.sqrt(.1),debias=False,backend='tensorized')\n    with torch.inference_mode():\n        for i in range(20):\n            for j in range(i+1,20):\n                W[i,j]=W[j,i]=float(loss(xx[yy==i],xx[yy==j]))\n    def cost(z1,z2):\n        d=torch.cdist(z1[:,:,:-1],z2[:,:,:-1]).square()/2\n        return d+torch.as_tensor(W)[z1[:,:,-1].long().unsqueeze(2),z2[:,:,-1].long().unsqueeze(1)]/2\n    potential=SamplesLoss('sinkhorn',p=2,blur=np.sqrt(.1),debias=False,\n                         potentials=True,cost=cost,backend='tensorized')\n    reg = 0.1\n    F={}; batchcost=np.zeros((len(tx),len(tr)))\n    for i,idx in enumerate(tx):\n        for j,jdx in enumerate(tr):\n            a=x[idx];b=r[jdx]\n            z1=torch.tensor(np.column_stack([a,y[idx]]),dtype=torch.float32)[None]\n            z2=torch.tensor(np.column_stack([b,ry[jdx]+10]),dtype=torch.float32)[None]\n            with torch.inference_mode(): f_t,g_t=potential(z1,z2)\n            f=f_t.numpy().ravel().astype(np.float64)\n            g=g_t.numpy().ravel().astype(np.float64)\n            C_eucl = cdist(a, b, 'sqeuclidean') / 2.0\n            C_label = W[y[idx[:, None]], ry[jdx][None, :] + 10] / 2.0\n            C = C_eucl + C_label\n            P = np.exp((f[:, None] + g[None, :] - C) / reg)\n            # Normalize rows/cols to match uniform marginals\n            # P from GeomLoss should already satisfy: sum_j P_ij = a_i, sum_i P_ij = b_j\n            # Check: a_i = 1/n, b_j = 1/m\n            batchcost[i,j] = float(np.sum(P * C)) / (len(idx) + len(jdx))\n            F[i,j] = (f - f.mean()) * len(f) / (len(f) - 1)\n    return F, batchcost\n\ndef values_from_Q(F, Q, tx, n):\n    values = np.zeros(n)\n    for i, idx in enumerate(tx):\n        values[idx] = sum(Q[i, j] * F[i, j] for j in range(Q.shape[1]))\n    return values\n\ndef nrmse(pred, target):\n    return np.sqrt(np.mean((pred - target)**2)) / np.std(target)\n\ndef spearman(a, b):\n    from scipy.stats import spearmanr\n    return spearmanr(a, b)[0]\n\ndef top_q_overlap(a, b, q=0.25):\n    n = len(a)\n    k = int(n * q)\n    top_a = set(np.argsort(-a)[:k])\n    top_b = set(np.argsort(-b)[:k])\n    return len(top_a & top_b) / k\n\n# Load case\nd = np.load('/workspace/environment/public_assets/dev/seed_101_uniform_labels.npz')\nx, y, r, ry, seed = d['x'], d['y'], d['r'], d['ry'], int(d['seed'])\n\nprint(\\\"Running canonical...\\\")\nt0 = time.perf_counter()\nv_canon, F_canon, bc_canon, Q_canon = run_canonical(x, y, r, ry, seed=seed)\nt1 = time.perf_counter()\nprint(f\\\"Canonical: {t1-t0:.2f}s\\\")\n\nprint(\\\"\\\\nRunning GeomLoss-only potentials...\\\")\nt0 = time.perf_counter()\nF_geom, bc_geom = run_geomloss_potentials(x, y, r, ry, seed=seed)\nt1 = time.perf_counter()\nprint(f\\\"GeomLoss-only: {t1-t0:.2f}s\\\")\n\nbatch_size = 1024\ntx = [np.arange(i, min(i + batch_size, len(x))) for i in range(0, len(x), batch_size)]\ntr = [np.arange(i, min(i + batch_size, len(r))) for i in range(0, len(r), batch_size)]\n\nprint(\\\"\\\\n=== Batch cost comparison ===\\\")\nprint(\\\"Canonical batchcost:\\\")\nprint(bc_canon)\nprint(\\\"GeomLoss batchcost:\\\")\nprint(bc_geom)\nprint(\\\"Ratio GeomLoss/Canonical:\\\")\nprint(bc_geom / bc_canon)\n\nprint(\\\"\\\\n=== Q matrix comparison ===\\\")\nQ_geom = ot.sinkhorn(ot.unif(len(tx)), ot.unif(len(tr)),\n                     bc_geom / max(float(bc_geom.max()), 1e-12), .01,\n                     numItermax=10000, stopThr=1e-10)\nprint(\\\"Canonical Q:\\\")\nprint(Q_canon)\nprint(\\\"GeomLoss Q:\\\")\nprint(Q_geom)\n\nprint(\\\"\\\\n=== Quality with canonical F + different Q ===\\\")\n# Test: use canonical F with different Q matrices\nv_geomQ = values_from_Q(F_canon, Q_geom, tx, len(x))\nprint(f\\\"Canonical F + GeomLoss Q: NRMSE={nrmse(v_geomQ, v_canon):.5f}, Spearman={spearman(v_geomQ, v_canon):.5f}, TopQ={top_q_overlap(v_geomQ, v_canon):.5f}\\\")\n\n# Test: use GeomLoss F + canonical Q\nv_geomF = values_from_Q(F_geom, Q_canon, tx, len(x))\nprint(f\\\"GeomLoss F + Canonical Q: NRMSE={nrmse(v_geomF, v_canon):.5f}, Spearman={spearman(v_geomF, v_canon):.5f}, TopQ={top_q_overlap(v_geomF, v_canon):.5f}\\\")\n\n# Test: use GeomLoss F + GeomLoss Q (v10)\nv_geom_both = values_from_Q(F_geom, Q_geom, tx, len(x))\nprint(f\\\"GeomLoss F + GeomLoss Q: NRMSE={nrmse(v_geom_both, v_canon):.5f}, Spearman={spearman(v_geom_both, v_canon):.5f}, TopQ={top_q_overlap(v_geom_both, v_canon):.5f}\\\")\n\n# Test: uniform Q\nQ_unif = np.ones((len(tx), len(tr))) / (len(tx) * len(tr))\nv_unif = values_from_Q(F_canon, Q_unif, tx, len(x))\nprint(f\\\"Canonical F + Uniform Q: NRMSE={nrmse(v_unif, v_canon):.5f}, Spearman={spearman(v_unif, v_canon):.5f}, TopQ={top_q_overlap(v_unif, v_canon):.5f}\\\")\n\n# Test: F correlation across j for same i\nprint(\\\"\\\\n=== F correlation across ref batches for same cand batch ===\\\")\nfor i in range(len(tx)):\n    f0 = F_canon[i, 0]\n    for j in range(1, len(tr)):\n        fj = F_canon[i, j]\n        # Need to align lengths? No, F[i,j] is same length for all j (all are len(idx))\n        corr = np.corrcoef(f0, fj)[0,1]\n        print(f\\\"  batch i={i}: corr(F[{i},0], F[{i},{j}]) = {corr:.5f}\\\")\nPYEOF\npython3 /tmp/test_v10_variants.py\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

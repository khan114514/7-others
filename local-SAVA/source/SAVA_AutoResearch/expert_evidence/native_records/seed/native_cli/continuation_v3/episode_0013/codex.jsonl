{"type": "item.started", "item": {"id": "item_98", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/test_geomloss_matched_reg.py << 'PYEOF'\n\\\"\\\"\\\"Test: match GeomLoss reg to POT effective reg to get accurate batchcost.\\\"\\\"\\\"\nimport numpy as np, time\nimport torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nfrom scipy.stats import spearmanr\nimport ot\n\ntorch.set_num_threads(2)\n\nd = np.load('/workspace/environment/public_assets/dev/seed_101_uniform_labels.npz')\nx, y, r, ry = d['x'], d['y'], d['r'], d['ry']\n\n# Compute label cost first\nxx = torch.tensor(np.concatenate([x[:1024], r[:1024]]), dtype=torch.float32)\nyy = np.concatenate([y[:1024], ry[:1024] + 10])\nW = np.zeros((20, 20), dtype=np.float32)\nloss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\nwith torch.inference_mode():\n    for i in range(20):\n        for j in range(i + 1, 20):\n            W[i, j] = W[j, i] = float(loss(xx[yy == i], xx[yy == j]))\n\nbatch_size = 1024\ntx = [np.arange(i, min(i + batch_size, len(x))) for i in range(0, len(x), batch_size)]\ntr = [np.arange(i, min(i + batch_size, len(r))) for i in range(0, len(r), batch_size)]\n\ndef cost_fn(z1, z2):\n    d = torch.cdist(z1[:, :, :-1], z2[:, :, :-1]).square() / 2\n    return d + torch.as_tensor(W)[z1[:, :, -1].long().unsqueeze(2), z2[:, :, -1].long().unsqueeze(1)] / 2\n\n# Canonical batchcost via POT\nbc_canon = np.zeros((len(tx), len(tr)))\nfor i, idx in enumerate(tx):\n    for j, jdx in enumerate(tr):\n        a = x[idx]; b = r[jdx]\n        C = cdist(a, b, 'sqeuclidean') / 2 + W[y[idx[:, None]], ry[jdx][None, :] + 10] / 2\n        P = ot.sinkhorn(ot.unif(len(idx)), ot.unif(len(jdx)), C / max(float(C.max()), 1e-12), .1)\n        bc_canon[i, j] = float(np.sum(P * C)) / (len(idx) + len(jdx))\n\nprint(\\\"Canonical batchcost:\\\")\nprint(bc_canon)\n\n# Strategy 1: Use GeomLoss with matched effective reg\n# POT effective reg = 0.1 * C_max\n# GeomLoss reg = blur\"'^2\n# To match: blur''^2 = 0.1 * C_max => blur = sqrt(0.1 * C_max)\nbc_geom1 = np.zeros((len(tx), len(tr)))\nt0 = time.perf_counter()\nfor i, idx in enumerate(tx):\n    for j, jdx in enumerate(tr):\n        a = x[idx]; b = r[jdx]\n        C = cdist(a, b, '\"'sqeuclidean') / 2 + W[y[idx[:, None]], ry[jdx][None, :] + 10] / 2\n        c_max = float(C.max())\n        # blur = sqrt(0.1 * C_max)\n        blur = np.sqrt(0.1 * c_max)\n        loss_fn = SamplesLoss('sinkhorn', p=2, blur=blur, debias=False, cost=cost_fn, backend='tensorized')\n        z1 = torch.tensor(np.column_stack([a, y[idx]]), dtype=torch.float32)[None]\n        z2 = torch.tensor(np.column_stack([b, ry[jdx] + 10]), dtype=torch.float32)[None]\n        with torch.inference_mode():\n            s_eps = float(loss_fn(z1, z2))\n        # S_eps is the entropy-regularized OT cost = sum(P*C) + eps*H(P)\n        # batchcost = sum(P*C) / (n+m)\n        # But we have S_eps which is sum(P*C) + eps*H(P)\n        # Hmm, the canonical uses sum(P*C) / (n+m), not S_eps.\n        # Let's try just S_eps / (n+m) as proxy and see if Q is similar\n        bc_geom1[i, j] = s_eps / (len(idx) + len(jdx))\nt1 = time.perf_counter()\nprint(f\\\"\\\\nGeomLoss matched-reg batchcost (S_eps/(n+m)): time={t1-t0:.3f}s\\\")\nprint(bc_geom1)\nprint(f\\\"Ratio: {bc_geom1 / bc_canon}\\\")\nprint(f\\\"Rank correlation: {spearmanr(bc_geom1.ravel(), bc_canon.ravel())[0]:.4f}\\\")\n\n# Strategy 2: Use GeomLoss default blur but also compute P from potentials with proper normalization\n# Then compute sum(P*C) / (n+m) from the reconstructed P\n# Issue: GeomLoss default reg=0.1 is much smaller than POT effective reg = 0.1*C_max\n# So the P will be different.\n# But wait - Q is just used to weight F[i,j]. If the ordering of batchcost is similar, Q will be similar.\n# Let's see if default GeomLoss S_eps gives a similar Q structure.\n\nbc_geom2 = np.zeros((len(tx), len(tr)))\nloss_def = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, cost=cost_fn, backend='tensorized')\nt0 = time.perf_counter()\nfor i, idx in enumerate(tx):\n    for j, jdx in enumerate(tr):\n        a = x[idx]; b = r[jdx]\n        z1 = torch.tensor(np.column_stack([a, y[idx]]), dtype=torch.float32)[None]\n        z2 = torch.tensor(np.column_stack([b, ry[jdx] + 10]), dtype=torch.float32)[None]\n        with torch.inference_mode():\n            s_eps = float(loss_def(z1, z2))\n        bc_geom2[i, j] = s_eps / (len(idx) + len(jdx))\nt1 = time.perf_counter()\nprint(f\\\"\\\\nGeomLoss default-reg batchcost (S_eps/(n+m)): time={t1-t0:.3f}s\\\")\nprint(bc_geom2)\nprint(f\\\"Ratio: {bc_geom2 / bc_canon}\\\")\nprint(f\\\"Rank correlation: {spearmanr(bc_geom2.ravel(), bc_canon.ravel())[0]:.4f}\\\")\n\n# Compute Q for each\nQ_canon = ot.sinkhorn(ot.unif(len(tx)), ot.unif(len(tr)),\n                      bc_canon / max(float(bc_canon.max()), 1e-12), .01,\n                      numItermax=10000, stopThr=1e-10)\nQ_geom1 = ot.sinkhorn(ot.unif(len(tx)), ot.unif(len(tr)),\n                      bc_geom1 / max(float(bc_geom1.max()), 1e-12), .01,\n                      numItermax=10000, stopThr=1e-10)\nQ_geom2 = ot.sinkhorn(ot.unif(len(tx)), ot.unif(len(tr)),\n                      bc_geom2 / max(float(bc_geom2.max()), 1e-12), .01,\n                      numItermax=10000, stopThr=1e-10)\n\nprint(f\\\"\\\\nQ canonical: {Q_canon.ravel()}\\\")\nprint(f\\\"Q geom1: {Q_geom1.ravel()}\\\")\nprint(f\\\"Q geom2: {Q_geom2.ravel()}\\\")\nPYEOF\npython3 /tmp/test_geomloss_matched_reg.py 2>&1 | grep -v UserWarning | grep -v \\\"warnings.warn\\\"\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

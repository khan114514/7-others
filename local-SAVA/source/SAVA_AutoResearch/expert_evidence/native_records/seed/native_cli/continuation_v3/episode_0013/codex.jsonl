{"type": "item.started", "item": {"id": "item_151", "type": "command_execution", "command": "/bin/sh -lc \"python3 << 'PYEOF'\n\\\"\\\"\\\"Test: refine GeomLoss P with log-domain Sinkhorn iterations.\nCheck how many iters needed for accurate batchcost.\\\"\\\"\\\"\nimport numpy as np\nimport torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nfrom scipy.special import logsumexp\nimport ot, time\n\ntorch.set_num_threads(2)\n\n# Small test for speed comparison\nnp.random.seed(42)\nn, m = 1024, 1024\na_np = np.random.randn(n, 10).astype(np.float32) * 2\nb_np = np.random.randn(m, 10).astype(np.float32) * 2\nay = np.random.randint(0, 10, n)\nby = np.random.randint(0, 10, m)\n\nW = np.zeros((20, 20), dtype=np.float32)\nfor i in range(20):\n    for j in range(i+1, 20):\n        W[i,j] = W[j,i] = abs(i-j) * 50.0\n\ndef cost_fn(z1, z2):\n    d = torch.cdist(z1[:, :, :-1], z2[:, :, :-1]).square() / 2\n    return d + torch.as_tensor(W)[z1[:, :, -1].long().unsqueeze(2), z2[:, :, -1].long().unsqueeze(1)] / 2\n\nC = cdist(a_np, b_np, 'sqeuclidean') / 2 + W[ay[:, None], by[None, :] + 10] / 2\nc_max = float(C.max())\nreg_match = 0.1 * c_max\nblur_match = np.sqrt(reg_match)\n\nalpha = np.ones(n) / n\nbeta = np.ones(m) / m\na_log = np.log(alpha)\nb_log = np.log(beta)\n\n# GeomLoss warm start\nz1 = torch.tensor(np.column_stack([a_np, ay]), dtype=torch.float32)[None]\nz2 = torch.tensor(np.column_stack([b_np, by + 10]), dtype=torch.float32)[None]\npot = SamplesLoss('sinkhorn', p=2, blur=blur_match, debias=False,\n                 potentials=True, cost=cost_fn, backend='tensorized')\nwith torch.inference_mode():\n    fm, gm = pot(z1, z2)\nf0 = fm.numpy().ravel()\ng0 = gm.numpy().ravel()\n\n# Reference: POT\nprint(\\\"Computing POT reference...\\\")\nt0 = time.perf_counter()\nP_ref = ot.sinkhorn(alpha, beta, C / c_max, 0.1, numItermax=10000)\nt1 = time.perf_counter()\ncost_ref = float(np.sum(P_ref * C))\nprint(f\\\"POT: {t1-t0:.3f}s, cost={cost_ref:.2f}\\\")\n\n# GeomLoss P\nP0 = alpha[:, None] * beta[None, :] * np.exp((f0[:, None] + g0[None, :] - C) / reg_match)\ncost0 = float(np.sum(P0 * C))\nprint(f\\\"GeomLoss initial: cost={cost0:.2f}, err={abs(cost0-cost_ref)/cost_ref:.6f}\\\")\n\n# Refine with log-domain Sinkhorn iterations\nf = f0.copy()\ng = g0.copy()\n\nprint(f\\\"\\\\nLog-domain refinement iterations:\\\")\nfor i in range(1, 11):\n    f = -reg_match * logsumexp(b_log[None, :] + g[None, :]/reg_match - C/reg_match, axis=1)\n    g = -reg_match * logsumexp(a_log[:, None] + f[:, None]/reg_match - C/reg_match, axis=0)\n    P = alpha[:, None] * beta[None, :] * np.exp((f[:, None] + g[None, :] - C) / reg_match)\n    cost_i = float(np.sum(P * C))\n    row_err = abs(P.sum(1) - alpha).max()\n    print(f\\\"  iter {i}: cost_err={abs(cost_i-cost_ref)/cost_ref:.6e}, row_err={row_err:.2e}\\\")\n\n# Time the refinement\nt0 = time.perf_counter()\nfor _ in range(5):\n    f = f0.copy()\n    g = g0.copy()\n    for i in range(5):\n        f = -reg_match * logsumexp(b_log[None, :] + g[None, :]/reg_match - C/reg_match, axis=1)\n        g = -reg_match * logsumexp(a_log[:, None] + f[:, None]/reg_match - C/reg_match, axis=0)\nt1 = time.perf_counter()\nprint(f\\\"\\\\n5 refinement iters (avg of 5): {(t1-t0)/5*1000:.1f}ms\\\")\n\n# Total: GeomLoss (23ms) + 5 iters log-domain (?)\n# Let's also time just GeomLoss\nt0 = time.perf_counter()\nfor _ in range(10):\n    with torch.inference_mode():\n        fm, gm = pot(z1, z2)\nt1 = time.perf_counter()\nprint(f\\\"GeomLoss pot (avg of 10): {(t1-t0)/10*1000:.1f}ms\\\")\nPYEOF\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

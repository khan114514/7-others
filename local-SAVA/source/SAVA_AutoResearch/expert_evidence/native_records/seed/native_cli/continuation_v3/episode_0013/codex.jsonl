{"type": "item.started", "item": {"id": "item_130", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/v12_quick_compare.py << 'PYEOF'\n\\\"\\\"\\\"Quick test: rank correlation of batchcost between canonical and v12.\nUses the first case only, small matrices.\\\"\\\"\\\"\nimport numpy as np\nimport torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nfrom scipy.stats import spearmanr\nimport ot\n\ntorch.set_num_threads(2)\n\nd = np.load('/workspace/environment/public_assets/dev/seed_202_uniform_labels.npz')\nx, y, r, ry = d['x'], d['y'], d['r'], d['ry']\n\nbatch_size = 1024\ntx = [np.arange(i, min(i + batch_size, len(x))) for i in range(0, len(x), batch_size)]\ntr = [np.arange(i, min(i + batch_size, len(r))) for i in range(0, len(r), batch_size)]\n\n# Label cost\nxx = torch.tensor(np.concatenate([x[tx[0]], r[tr[0]]]), dtype=torch.float32)\nyy = np.concatenate([y[tx[0]], ry[tr[0]] + 10])\nW = np.zeros((20, 20), dtype=np.float32)\nloss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\nwith torch.inference_mode():\n    for i in range(20):\n        for j in range(i + 1, 20):\n            W[i, j] = W[j, i] = float(loss(xx[yy == i], xx[yy == j]))\n\ndef cost_fn(z1, z2):\n    d = torch.cdist(z1[:, :, :-1], z2[:, :, :-1]).square() / 2\n    return d + torch.as_tensor(W)[z1[:, :, -1].long().unsqueeze(2), z2[:, :, -1].long().unsqueeze(1)] / 2\n\nbc_canon = []\nbc_v12 = []\npairs = []\n\nfor i, idx in enumerate(tx):\n    for j, jdx in enumerate(tr):\n        a = x[idx]; b = r[jdx]\n        n_src = len(idx); n_tgt = len(jdx)\n        C = cdist(a, b, 'sqeuclidean') / 2 + W[y[idx[:, None]], ry[jdx][None, :] + 10] / 2\n        c_max = float(C.max())\n        \n        # Canonical POT\n        P = ot.sinkhorn(ot.unif(n_src), ot.unif(n_tgt), C / c_max, .1, numItermax=10000)\n        bc_c = float(np.sum(P * C)) / (n_src + n_tgt)\n        bc_canon.append(bc_c)\n        \n        # v12: matched reg GeomLoss\n        reg_match = 0.1 * c_max\n        blur_match = np.sqrt(reg_match)\n        z1 = torch.tensor(np.column_stack([a, y[idx]]), dtype=torch.float32)[None]\n        z2 = torch.tensor(np.column_stack([b, ry[jdx] + 10]), dtype=torch.float32)[None]\n        pot_match = SamplesLoss('sinkhorn', p=2, blur=blur_match, debias=False,\n                               potentials=True, cost=cost_fn, backend='tensorized')\n        with torch.inference_mode():\n            fm_t, gm_t = pot_match(z1, z2)\n        fm = fm_t.numpy().ravel()\n        gm = gm_t.numpy().ravel()\n        P_v = (1.0/n_src) * (1.0/n_tgt) * np.exp((fm[:, None] + gm[None, :] - C) / reg_match)\n        bc_v = float(np.sum(P_v * C)) / (n_src + n_tgt)\n        bc_v12.append(bc_v)\n        pairs.append((i, j, c_max, n_src, n_tgt))\n\nprint(f\\\"Canonical: {[f'{x:.6f}' for x in bc_canon]}\\\")\nprint(f\\\"v12:       {[f'{x:.6f}' for x in bc_v12]}\\\")\nprint(f\\\"Ratio:     {[f'{bc_v12[i]/bc_canon[i]:.4f}' for i in range(len(bc_canon))]}\\\")\nprint(f\\\"Rank corr: {spearmanr(bc_canon, bc_v12)[0]:.4f}\\\")\nprint()\nfor k, (i, j, cm, ns, nt) in enumerate(pairs):\n    print(f\\\"  pair ({i},{j}): n={ns}, m={nt}, C_max={cm:.1f}, \\\"\n          f\\\"canon={bc_canon[k]:.6f}, v12={bc_v12[k]:.6f}, \\\"\n          f\\\"ratio={bc_v12[k]/bc_canon[k]:.4f}\\\")\nPYEOF\npython3 /tmp/v12_quick_compare.py 2>&1 | grep -v UserWarning | grep -v \\\"warnings.warn\\\"\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

{"type": "item.started", "item": {"id": "item_100", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/test_v11.py << 'PYEOF'\n\\\"\\\"\\\"Test v11: GeomLoss for both F (canonical reg) and batchcost (matched reg).\nTime comparison vs canonical.\\\"\\\"\\\"\nimport numpy as np, time, sys\nsys.path.insert(0, '/workspace/solution')\nimport torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nfrom scipy.stats import spearmanr\nimport ot\n\ntorch.set_num_threads(2)\n\ndef nrmse(pred, target):\n    return np.sqrt(np.mean((pred - target)**2)) / np.std(target)\n\ndef top_q_overlap(a, b, q=0.25):\n    n = len(a)\n    k = int(n * q)\n    top_a = set(np.argsort(-a)[:k])\n    top_b = set(np.argsort(-b)[:k])\n    return len(top_a & top_b) / k\n\ndef run_variant(x, y, r, ry, seed=17, batch_size=1024, mode='canonical'):\n    x=np.asarray(x,np.float32); r=np.asarray(r,np.float32)\n    y=np.asarray(y,np.int64); ry=np.asarray(ry,np.int64)\n    tx=[np.arange(i,min(i+batch_size,len(x))) for i in range(0,len(x),batch_size)]\n    tr=[np.arange(i,min(i+batch_size,len(r))) for i in range(0,len(r),batch_size)]\n    \n    xx=torch.tensor(np.concatenate([x[tx[0]],r[tr[0]]]),dtype=torch.float32)\n    yy=np.concatenate([y[tx[0]],ry[tr[0]]+10])\n    W=np.zeros((20,20),dtype=np.float32)\n    loss=SamplesLoss('sinkhorn',p=2,blur=np.sqrt(.1),debias=False,backend='tensorized')\n    with torch.inference_mode():\n        for i in range(20):\n            for j in range(i+1,20):\n                W[i,j]=W[j,i]=float(loss(xx[yy==i],xx[yy==j]))\n    \n    def cost(z1,z2):\n        d=torch.cdist(z1[:,:,:-1],z2[:,:,:-1]).square()/2\n        return d+torch.as_tensor(W)[z1[:,:,-1].long().unsqueeze(2),z2[:,:,-1].long().unsqueeze(1)]/2\n    \n    potential=SamplesLoss('sinkhorn',p=2,blur=np.sqrt(.1),debias=False,\n                         potentials=True,cost=cost,backend='tensorized')\n    \n    F={}; batchcost=np.zeros((len(tx),len(tr)))\n    \n    for i,idx in enumerate(tx):\n        for j,jdx in enumerate(tr):\n            a=x[idx];b=r[jdx]\n            n_src=len(idx);n_tgt=len(jdx)\n            \n            # Always use GeomLoss for F (canonical reg = 0.1)\n            z1=torch.tensor(np.column_stack([a,y[idx]]),dtype=torch.float32)[None]\n            z2=torch.tensor(np.column_stack([b,ry[jdx]+10]),dtype=torch.float32)[None]\n            with torch.inference_mode(): f_t,_=potential(z1,z2)\n            f=f_t.numpy().ravel().astype(float)\n            F[i,j]=(f-f.mean())*len(f)/(len(f)-1)\n            \n            if mode == 'canonical':\n                # POT sinkhorn for batchcost (canonical)\n                C=cdist(a,b,'sqeuclidean')/2+W[y[idx,None],ry[jdx][None,:]+10]/2\n                P=ot.sinkhorn(ot.unif(n_src),ot.unif(n_tgt),C/max(float(C.max()),1e-12),.1)\n                batchcost[i,j]=float(np.sum(P*C))/(n_src+n_tgt)\n            elif mode == 'geomloss_matched':\n                # GeomLoss with matched effective reg for batchcost\n                C=cdist(a,b,'sqeuclidean')/2+W[y[idx,None],ry[jdx][None,:]+10]/2\n                c_max = float(C.max())\n                blur_match = np.sqrt(0.1 * c_max)\n                loss_match = SamplesLoss('sinkhorn', p=2, blur=blur_match, debias=False, cost=cost, backend='tensorized')\n                with torch.inference_mode():\n                    s_eps = float(loss_match(z1, z2))\n                # S_eps is entropic OT cost; canonical uses sum(P*C) which is slightly lower\n                # Use S_eps / (n+m) as batchcost proxy\n                batchcost[i,j] = s_eps / (n_src + n_tgt)\n            elif mode == 'geomloss_match_reconstruct':\n                # GeomLoss matched reg + reconstruct P for exact sum(P*C)\n                C=cdist(a,b,'sqeuclidean')/2+W[y[idx,None],ry[jdx][None,:]+10]/2\n                c_max = float(C.max())\n                blur_match = np.sqrt(0.1 * c_max)\n                reg_match = 0.1 * c_max\n                pot_match = SamplesLoss('sinkhorn', p=2, blur=blur_match, debias=False,\n                                       potentials=True, cost=cost, backend='tensorized')\n                with torch.inference_mode():\n                    fm_t, gm_t = pot_match(z1, z2)\n                fm = fm_t.numpy().ravel()\n                gm = gm_t.numpy().ravel()\n                alpha = 1.0 / n_src\n                beta = 1.0 / n_tgt\n                P = alpha * beta * np.exp((fm[:, None] + gm[None, :] - C) / reg_match)\n                batchcost[i,j] = float(np.sum(P * C)) / (n_src + n_tgt)\n    \n    Q=ot.sinkhorn(ot.unif(len(tx)),ot.unif(len(tr)),\n                  batchcost/max(float(batchcost.max()),1e-12),.01,\n                  numItermax=10000,stopThr=1e-10)\n    \n    values=np.zeros(len(x))\n    for i,idx in enumerate(tx): values[idx]=sum(Q[i,j]*F[i,j] for j in range(len(tr)))\n    return values\n\nd = np.load('/workspace/environment/public_assets/dev/seed_101_uniform_labels.npz')\nx, y, r, ry, seed = d['x'], d['y'], d['r'], d['ry'], int(d['seed'])\n\n# Warmup\nprint(\\\"Warmup canonical...\\\")\nv_canon = run_variant(x, y, r, ry, seed=seed, mode='canonical')\n\n# Time canonical\nt0 = time.perf_counter()\nv_canon = run_variant(x, y, r, ry, seed=seed, mode='canonical')\nt1 = time.perf_counter()\nprint(f\\\"Canonical: {t1-t0:.3f}s\\\")\n\n# Test matched-reg GeomLoss for batchcost\nfor mode in ['geomloss_matched', 'geomloss_match_reconstruct']:\n    # Warmup\n    _ = run_variant(x, y, r, ry, seed=seed, mode=mode)\n    t0 = time.perf_counter()\n    v_fast = run_variant(x, y, r, ry, seed=seed, mode=mode)\n    t1 = time.perf_counter()\n    print(f\\\"\\\\n{mode}: {t1-t0:.3f}s\\\")\n    print(f\\\"  NRMSE: {nrmse(v_fast, v_canon):.5f}\\\")\n    print(f\\\"  Spearman: {spearmanr(v_fast, v_canon)[0]:.5f}\\\")\n    print(f\\\"  TopQ: {top_q_overlap(v_fast, v_canon):.5f}\\\")\nPYEOF\npython3 /tmp/test_v11.py 2>&1 | grep -v UserWarning | grep -v \\\"warnings.warn\\\"\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

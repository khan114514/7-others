{"type": "item.started", "item": {"id": "item_73", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/test_geomloss_p_verify.py << 'PYEOF'\n\\\"\\\"\\\"Verify GeomLoss potential convention and P reconstruction with simple case.\\\"\\\"\\\"\nimport numpy as np\nimport torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nimport ot\n\ntorch.set_num_threads(2)\n\nnp.random.seed(42)\nn, m = 20, 15\na_np = np.random.randn(n, 3).astype(np.float32) * 2\nb_np = np.random.randn(m, 3).astype(np.float32) * 2\n\na = torch.tensor(a_np)[None]  # (1, N, D)\nb = torch.tensor(b_np)[None]  # (1, M, D)\n\nblur = 0.5\nreg = blur ** 2\n\npot_fn = SamplesLoss('sinkhorn', p=2, blur=blur, debias=False, potentials=True, backend='tensorized')\nloss_fn = SamplesLoss('sinkhorn', p=2, blur=blur, debias=False, backend='tensorized')\n\nwith torch.inference_mode():\n    f_t, g_t = pot_fn(a, b)\n    loss_val = float(loss_fn(a, b))\n\nf = f_t.numpy().ravel()\ng = g_t.numpy().ravel()\n\nC = cdist(a_np, b_np, 'sqeuclidean') / 2\nalpha = 1.0 / n\nbeta = 1.0 / m\n\n# Standard P formula\nP = alpha * beta * np.exp((f[:, None] + g[None, :] - C) / reg)\nprint(f\\\"Standard P (with alpha,beta): sum={P.sum():.6f}, row_err={abs(P.sum(1)-alpha).max():.6e}, col_err={abs(P.sum(0)-beta).max():.6e}\\\")\n\n# POT reference\nP_pot = ot.sinkhorn(np.ones(n)/n, np.ones(m)/m, C, reg, numItermax=10000)\nprint(f\\\"POT P: sum={P_pot.sum():.6f}, row_err={abs(P_pot.sum(1)-alpha).max():.6e}, col_err={abs(P_pot.sum(0)-beta).max():.6e}\\\")\n\n# Are P and P_pot close?\nprint(f\\\"|P - P_pot|_max: {abs(P - P_pot).max():.6e}\\\")\nprint(f\\\"P cost: {np.sum(P * C):.6f}\\\")\nprint(f\\\"POT cost: {np.sum(P_pot * C):.6f}\\\")\n\n# Check: maybe f, g are log(u), log(v) i.e. P = diag(u) K diag(v)?\nu = np.exp(f / reg)\nv = np.exp(g / reg)\nK = np.exp(-C / reg)\nP_alt = u[:, None] * K * v[None, :]\nprint(f\\\"\\\\nP_alt = diag(u)Kdiag(v): sum={P_alt.sum():.6f}\\\")\nprint(f\\\"  row sums range: [{P_alt.sum(1).min():.6f}, {P_alt.sum(1).max():.6f}]\\\")\nprint(f\\\"  col sums range: [{P_alt.sum(0).min():.6f}, {P_alt.sum(0).max():.6f}]\\\")\n\n# Check: maybe GeomLoss uses debias=True by default for something?\n# Let's try with debias=True\npot_fn_db = SamplesLoss('sinkhorn', p=2, blur=blur, debias=True, potentials=True, backend='tensorized')\nwith torch.inference_mode():\n    f_db, g_db = pot_fn_db(a, b)\nf_db_np = f_db.numpy().ravel()\ng_db_np = g_db.numpy().ravel()\n\nP_db = alpha * beta * np.exp((f_db_np[:, None] + g_db_np[None, :] - C) / reg)\nprint(f\\\"\\\\nDebiased P (with alpha,beta): sum={P_db.sum():.6f}\\\")\nprint(f\\\"  row sums range: [{P_db.sum(1).min():.6f}, {P_db.sum(1).max():.6f}]\\\")\nprint(f\\\"  col sums range: [{P_db.sum(0).min():.6f}, {P_db.sum(0).max():.6f}]\\\")\n\n# Let's check: what if we compute P from softmin directly?\n# softmin(eps, C_xy, b_log + g/eps) = f\n# -eps * logsumexp_j [ b_log_j + g_j/eps - C_ij/eps ] = f_i\n# logsumexp_j [ log(beta_j) + g_j/eps - C_ij/eps ] = -f_i/eps\n# sum_j exp(log(beta_j) + g_j/eps - C_ij/eps) = exp(-f_i/eps)\n# sum_j beta_j * exp(g_j/eps) * exp(-C_ij/eps) = exp(-f_i/eps)\n# sum_j beta_j * v_j * K_ij = 1/u_i   (where v_j = exp(g_j/eps), u_i = exp(f_i/eps))\n# sum_j beta_j * v_j * K_ij = 1/u_i\n# => (K diag(beta v))_i = 1/u_i\n# => diag(alpha) K diag(beta v) has row i sum: alpha_i / u_i\n\n# Let's verify:\nK = np.exp(-C / reg)\nv = np.exp(g / reg)\nu = np.exp(f / reg)\nprint(f\\\"\\\\nVerification of softmin formula:\\\")\nlhs = K  @  (beta * v)  # (n,)\nrhs = 1.0 / u\nprint(f\\\"  K @ (beta*v) vs 1/u: max diff = {abs(lhs - rhs).max():.6e}\\\")\n\n# Now, P with balanced Sinkhorn:\n# Standard: P = diag(u) K diag(v), P1 = alpha, P\"'^T1 = beta\n# But from above: K  @  (beta * v) = 1/u\n# => u_i * sum_j K_ij * beta_j * v_j = u_i * 1/u_i = 1\n# => sum_j u_i * K_ij * beta_j * v_j = 1\n# => sum_j (u_i * K_ij * v_j) * beta_j = 1\n# \n# Hmm that'\"'s not the same as sum_j P_ij = alpha_i.\n\n# Let me try: maybe the convention is:\n# P_ij = alpha_i * beta_j * exp((f_i + g_j - C_ij)/eps)\n# where f_i = eps * log(u_i), g_j = eps * log(v_j)\n# Then P_ij = alpha_i * beta_j * u_i * v_j * K_ij\n# Row sum: sum_j alpha_i * beta_j * u_i * v_j * K_ij = alpha_i * u_i * (K  @  (beta * v))_i\n# If (K  @  (beta*v))_i = 1/u_i, then row sum = alpha_i. Yes\"'!\nprint(f\"'\"\\\\nRow sum of P = alpha*beta*exp((f+g-C)/eps):\\\")\nprint(f\\\"  expected: alpha = {alpha:.6f}\\\")\nprint(f\\\"  actual row 0: {P[0, :].sum():.6f}\\\")\nprint(f\\\"  u[0] * (K  @  (beta*v))[0] = {u[0] * (K  @  (beta*v))[0]:.6f}\\\")\n\n# So the row sum should be alpha\"'!\n# Wait but our test shows row sums range [0.041, 0.086] vs target 0.05\n# That'\"'s pretty close but not exact. Let's check with more iterations.\n\n# Maybe GeomLoss hasn't fully converged? Let's check scaling parameter.\nprint(f\\\"\\\\nChecking with more iterations (lower scaling):\\\")\nfor scaling in [0.5, 0.3, 0.1]:\n    pot_fn2 = SamplesLoss('sinkhorn', p=2, blur=blur, debias=False, potentials=True, backend='tensorized', scaling=scaling)\n    with torch.inference_mode():\n        f2_t, g2_t = pot_fn2(a, b)\n    f2 = f2_t.numpy().ravel()\n    g2 = g2_t.numpy().ravel()\n    P2 = alpha * beta * np.exp((f2[:, None] + g2[None, :] - C) / reg)\n    print(f\\\"  scaling={scaling}: row_err={abs(P2.sum(1)-alpha).max():.6e}, col_err={abs(P2.sum(0)-beta).max():.6e}\\\")\n\nPYEOF\npython3 /tmp/test_geomloss_p_verify.py 2>&1 | grep -v UserWarning | grep -v \\\"warnings.warn\\\"\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

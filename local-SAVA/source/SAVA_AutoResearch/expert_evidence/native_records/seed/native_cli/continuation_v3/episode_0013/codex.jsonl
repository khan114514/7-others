{"type": "item.started", "item": {"id": "item_79", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/test_convergence.py << 'PYEOF'\nimport numpy as np\nimport torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nfrom scipy.special import logsumexp\nimport ot\n\ntorch.set_num_threads(2)\n\nnp.random.seed(42)\nn, m = 20, 15\na_np = np.random.randn(n, 3).astype(np.float32) * 2\nb_np = np.random.randn(m, 3).astype(np.float32) * 2\n\na = torch.tensor(a_np)[None]\nb = torch.tensor(b_np)[None]\n\nC = cdist(a_np, b_np, 'sqeuclidean') / 2\nreg = 0.25\nalpha = np.ones(n) / n\nbeta = np.ones(m) / m\n\n# POT reference\nP_pot = ot.sinkhorn(alpha, beta, C, reg, numItermax=100000)\ncost_pot = np.sum(P_pot * C)\nprint(f\\\"POT cost: {cost_pot:.6f}\\\")\n\n# GeomLoss with various settings\nfor scaling in [0.5, 0.3, 0.7, 0.9]:\n    for backend in ['tensorized']:\n        pot_fn = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(reg), debias=False, \n                             potentials=True, backend=backend, scaling=scaling)\n        loss_fn = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(reg), debias=False, \n                              backend=backend, scaling=scaling)\n        with torch.inference_mode():\n            f_t, g_t = pot_fn(a, b)\n            loss_val = float(loss_fn(a, b))\n        \n        f = f_t.numpy().ravel()\n        g = g_t.numpy().ravel()\n        \n        # Check optimality residual\n        rhs_f = -reg * logsumexp(np.log(beta)[None, :] + g[None, :]/reg - C/reg, axis=1)\n        rhs_g = -reg * logsumexp(np.log(alpha)[:, None] + f[:, None]/reg - C/reg, axis=0)\n        res_f = abs(f - rhs_f).max()\n        res_g = abs(g - rhs_g).max()\n        \n        # Reconstruct P\n        P = alpha[:, None] * beta[None, :] * np.exp((f[:, None] + g[None, :] - C) / reg)\n        row_err = abs(P.sum(1) - alpha).max()\n        col_err = abs(P.sum(0) - beta).max()\n        cost_rec = np.sum(P * C)\n        \n        print(f\\\"scaling={scaling}: loss={loss_val:.6f}, cost={cost_rec:.6f}, \\\"\n              f\\\"res_f={res_f:.2e}, res_g={res_g:.2e}, row_err={row_err:.2e}, col_err={col_err:.2e}\\\")\n\n# Let's also try with the actual task's reg=0.1 and high-dimensional data\nprint(\\\"\\\\n--- Task-like settings (dim=10, reg=0.1) ---\\\")\nnp.random.seed(123)\nn, m = 100, 80\na_np = np.random.randn(n, 10).astype(np.float32) * 2\nb_np = np.random.randn(m, 10).astype(np.float32) * 2\na = torch.tensor(a_np)[None]\nb = torch.tensor(b_np)[None]\n\nC = cdist(a_np, b_np, 'sqeuclidean') / 2\nreg = 0.1\nalpha = np.ones(n) / n\nbeta = np.ones(m) / m\n\n# POT\nP_pot = ot.sinkhorn(alpha, beta, C, reg, numItermax=100000)\nprint(f\\\"POT cost: {np.sum(P_pot * C):.6f}\\\")\n\n# GeomLoss\npot_fn = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(reg), debias=False, \n                     potentials=True, backend='tensorized', scaling=0.5)\nwith torch.inference_mode():\n    f_t, g_t = pot_fn(a, b)\n    loss_val = float(SamplesLoss('sinkhorn', p=2, blur=np.sqrt(reg), debias=False, backend='tensorized')(a, b))\n\nf = f_t.numpy().ravel()\ng = g_t.numpy().ravel()\nP = alpha[:, None] * beta[None, :] * np.exp((f[:, None] + g[None, :] - C) / reg)\nprint(f\\\"GeomLoss cost (reconstructed): {np.sum(P * C):.6f}\\\")\nprint(f\\\"GeomLoss loss: {loss_val:.6f}\\\")\nprint(f\\\"Row err: {abs(P.sum(1) - alpha).max():.2e}\\\")\nprint(f\\\"Col err: {abs(P.sum(0) - beta).max():.2e}\\\")\nprint(f\\\"Cost ratio: {np.sum(P*C) / np.sum(P_pot*C):.4f}\\\")\nPYEOF\npython3 /tmp/test_convergence.py 2>&1 | grep -v UserWarning | grep -v \\\"warnings.warn\\\"\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

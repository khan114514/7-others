{"type": "item.started", "item": {"id": "item_138", "type": "command_execution", "command": "/bin/sh -lc \"python3 << 'PYEOF'\n\\\"\\\"\\\"Test: use GeomLoss S_eps (matched reg) as batchcost directly, without P reconstruction.\\\"\\\"\\\"\nimport numpy as np\nimport torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nimport ot, time\n\ntorch.set_num_threads(2)\n\nd = np.load('/workspace/environment/public_assets/dev/seed_202_uniform_labels.npz')\nx, y, r, ry = d['x'], d['y'], d['r'], d['ry']\n\nbatch_size = 1024\ntx = [np.arange(i, min(i + batch_size, len(x))) for i in range(0, len(x), batch_size)]\ntr = [np.arange(i, min(i + batch_size, len(r))) for i in range(0, len(r), batch_size)]\n\nxx = torch.tensor(np.concatenate([x[tx[0]], r[tr[0]]]), dtype=torch.float32)\nyy = np.concatenate([y[tx[0]], ry[tr[0]] + 10])\nW = np.zeros((20, 20), dtype=np.float32)\nloss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\nwith torch.inference_mode():\n    for i in range(20):\n        for j in range(i + 1, 20):\n            W[i, j] = W[j, i] = float(loss(xx[yy == i], xx[yy == j]))\n\ndef cost_fn(z1, z2):\n    d = torch.cdist(z1[:, :, :-1], z2[:, :, :-1]).square() / 2\n    return d + torch.as_tensor(W)[z1[:, :, -1].long().unsqueeze(2), z2[:, :, -1].long().unsqueeze(1)] / 2\n\nbc_canon = np.zeros((len(tx), len(tr)))\nbc_s_eps = np.zeros((len(tx), len(tr)))\n\nt0 = time.perf_counter()\nfor i, idx in enumerate(tx):\n    for j, jdx in enumerate(tr):\n        a = x[idx]; b = r[jdx]\n        n_src = len(idx); n_tgt = len(jdx)\n        C = cdist(a, b, 'sqeuclidean') / 2 + W[y[idx[:, None]], ry[jdx][None, :] + 10] / 2\n        P = ot.sinkhorn(ot.unif(n_src), ot.unif(n_tgt), C / max(float(C.max()), 1e-12), .1)\n        bc_canon[i, j] = float(np.sum(P * C)) / (n_src + n_tgt)\nt_canon = time.perf_counter() - t0\n\nt0 = time.perf_counter()\nfor i, idx in enumerate(tx):\n    for j, jdx in enumerate(tr):\n        a = x[idx]; b = r[jdx]\n        n_src = len(idx); n_tgt = len(jdx)\n        C = cdist(a, b, 'sqeuclidean') / 2 + W[y[idx[:, None]], ry[jdx][None, :] + 10] / 2\n        c_max = float(C.max())\n        reg_match = 0.1 * c_max\n        blur_match = np.sqrt(reg_match)\n        z1 = torch.tensor(np.column_stack([a, y[idx]]), dtype=torch.float32)[None]\n        z2 = torch.tensor(np.column_stack([b, ry[jdx] + 10]), dtype=torch.float32)[None]\n        loss_match = SamplesLoss('sinkhorn', p=2, blur=blur_match, debias=False,\n                                cost=cost_fn, backend='tensorized')\n        with torch.inference_mode():\n            s_eps = float(loss_match(z1, z2))\n        # S_eps is the entropic OT cost = <alpha, f> + <beta, g>\n        # Canonical batchcost = sum(P*C) / (n+m)\n        # S_eps ≈ sum(P*C) + eps*H(P)  (very close for strong reg)\n        # Let's just use S_eps / (n+m) scaled\n        bc_s_eps[i, j] = s_eps / (n_src + n_tgt)\nt_geom = time.perf_counter() - t0\n\nprint(f\\\"Canonical time: {t_canon:.3f}s\\\")\nprint(f\\\"GeomLoss time: {t_geom:.3f}s\\\")\nprint(f\\\"Speedup: {t_canon/t_geom:.2f}x\\\")\n\nfrom scipy.stats import spearmanr\nprint(f\\\"\\\\nCanonical bc: {bc_canon.ravel()}\\\")\nprint(f\\\"S_eps bc:      {bc_s_eps.ravel()}\\\")\nprint(f\\\"Rank corr: {spearmanr(bc_canon.ravel(), bc_s_eps.ravel())[0]:.4f}\\\")\n\n# Compute Q for each\nQ_c = ot.sinkhorn(ot.unif(len(tx)), ot.unif(len(tr)),\n                  bc_canon / bc_canon.max(), 0.01, numItermax=10000)\nQ_v = ot.sinkhorn(ot.unif(len(tx)), ot.unif(len(tr)),\n                  bc_s_eps / bc_s_eps.max(), 0.01, numItermax=10000)\nprint(f\\\"Q_canon: {Q_c.ravel()}\\\")\nprint(f\\\"Q_s_eps: {Q_v.ravel()}\\\")\nprint(f\\\"Q max diff: {np.max(np.abs(Q_c - Q_v)):.6f}\\\")\nPYEOF\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

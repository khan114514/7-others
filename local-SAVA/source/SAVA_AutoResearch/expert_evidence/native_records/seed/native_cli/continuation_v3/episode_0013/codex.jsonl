{"type": "item.started", "item": {"id": "item_72", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/test_geomloss_p_verify.py << 'PYEOF'\n\\\"\\\"\\\"Verify GeomLoss potential convention and P reconstruction with simple case.\\\"\\\"\\\"\nimport numpy as np\nimport torch\nfrom geomloss import SamplesLoss\n\ntorch.set_num_threads(2)\n\nnp.random.seed(42)\nn, m = 20, 15\na_np = np.random.randn(n, 3).astype(np.float32) * 2\nb_np = np.random.randn(m, 3).astype(np.float32) * 2\n\na = torch.tensor(a_np)[None]  # (1, N, D)\nb = torch.tensor(b_np)[None]  # (1, M, D)\n\nblur = 0.5  # larger blur = more entropic = easier to verify\nreg = blur ** 2  # 0.25\n\npot_fn = SamplesLoss('sinkhorn', p=2, blur=blur, debias=False, potentials=True, backend='tensorized')\nloss_fn = SamplesLoss('sinkhorn', p=2, blur=blur, debias=False, backend='tensorized')\n\nwith torch.inference_mode():\n    f_t, g_t = pot_fn(a, b)\n    loss_val = float(loss_fn(a, b))\n\nf = f_t.numpy().ravel()\ng = g_t.numpy().ravel()\n\nprint(f\\\"Loss: {loss_val:.6f}\\\")\nprint(f\\\"mean(f) + mean(g): {f.mean() + g.mean():.6f}\\\")\n\n# Compute C matrix\nfrom scipy.spatial.distance import cdist\nC = cdist(a_np, b_np, 'sqeuclidean') / 2\n\n# P from standard formula\nalpha = 1.0 / n\nbeta = 1.0 / m\nP = alpha * beta * np.exp((f[:, None] + g[None, :] - C) / reg)\n\nprint(f\\\"\\\\nStandard P formula (with alpha, beta):\\\")\nprint(f\\\"  sum(P) = {P.sum():.6f}\\\")\nprint(f\\\"  row sums: [{P.sum(axis=1).min():.6f}, {P.sum(axis=1).max():.6f}] (target: {alpha:.6f})\\\")\nprint(f\\\"  col sums: [{P.sum(axis=0).min():.6f}, {P.sum(axis=0).max():.6f}] (target: {beta:.6f})\\\")\n\n# Try P without alpha, beta\nP2 = np.exp((f[:, None] + g[None, :] - C) / reg)\nprint(f\\\"\\\\nP without alpha, beta:\\\")\nprint(f\\\"  sum(P2) = {P2.sum():.6f}\\\")\nprint(f\\\"  row sums range: [{P2.sum(axis=1).min():.6f}, {P2.sum(axis=1).max():.6f}]\\\")\n\n# Try alternative: P_ij = exp(f_i/reg) * K_ij * exp(g_j/reg)\n# where K_ij = exp(-C_ij/reg)\n# This is the standard: P = diag(u) K diag(v), u = exp(f/eps), v = exp(g/eps)\nu = np.exp(f / reg)\nv = np.exp(g / reg)\nK = np.exp(-C / reg)\nP3 = u[:, None] * K * v[None, :]\nprint(f\\\"\\\\nP = diag(u) K diag(v) (u=exp(f/eps), v=exp(g/eps)):\\\")\nprint(f\\\"  sum(P3) = {P3.sum():.6f}\\\")\nprint(f\\\"  row sums range: [{P3.sum(axis=1).min():.6f}, {P3.sum(axis=1).max():.6f}]\\\")\nprint(f\\\"  col sums range: [{P3.sum(axis=0).min():.6f}, {P3.sum(axis=0).max():.6f}]\\\")\n\n# What if we need to normalize? The balanced Sinkhorn:\n# u_i = alpha_i / (K v)_i, v_j = beta_j / (K\"'^T u)_j\n# So P_ij = u_i * K_ij * v_j has marginals alpha_i, beta_j\n# But GeomLoss f and g are not necessarily log(u) and log(v).\n\n# Let me compare with POT sinkhorn\nimport ot\nP_pot = ot.sinkhorn(np.ones(n)/n, np.ones(m)/m, C, reg)\nprint(f\"'\"\\\\nPOT Sinkhorn:\\\")\nprint(f\\\"  sum(P_pot) = {P_pot.sum():.6f}\\\")\nprint(f\\\"  row sums range: [{P_pot.sum(axis=1).min():.6f}, {P_pot.sum(axis=1).max():.6f}]\\\")\nprint(f\\\"  col sums range: [{P_pot.sum(axis=0).min():.6f}, {P_pot.sum(axis=0).max():.6f}]\\\")\nprint(f\\\"  POT transport cost: {np.sum(P_pot * C):.6f}\\\")\n\n# Can we find POT dual potentials?\n# From POT: P = diag(u) K diag(v), with u_i = a_i / sum_j K_ij v_j\n# Let's extract u, v from P_pot\nu_pot = P_pot.sum(axis=1) / (K  @  (P_pot.sum(axis=0) / u[:, None] ... ))  # no\n\n# Actually let's just use sinkhorn_log to get f, g:\nf_pot, g_pot = ot.bregman.sinkhorn_log(np.ones(n)/n, np.ones(m)/m, C, reg, log=True)\n# Wait, does sinkhorn_log return potentials?\nprint(f\\\"\\\\nPOT sinkhorn_log:\\\")\nprint(f\\\"  output shape: {f_pot.shape if hasattr(f_pot, 'shape') else 'N/A'}\\\")\nprint(f\\\"  type: {type(f_pot)}\\\")\nPYEOF\npython3 /tmp/test_geomloss_p_verify.py\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

{"type": "item.started", "item": {"id": "item_140", "type": "command_execution", "command": "/bin/sh -lc \"python3 << 'PYEOF'\nimport numpy as np\nimport ot\n\n# Simulate: if we have very close batchcost values, how much does Q differ?\nbc1 = np.array([[1.0, 1.1], [1.05, 1.15], [1.08, 1.2]])\n# Slight relative perturbation \nfor factor in [1.001, 1.01, 1.02, 1.05, 1.10]:\n    bc2 = bc1 * factor + np.random.RandomState(42).randn(*bc1.shape) * 0.001\n    Q1 = ot.sinkhorn(ot.unif(3), ot.unif(2), bc1/bc1.max(), 0.01, numItermax=10000)\n    Q2 = ot.sinkhorn(ot.unif(3), ot.unif(2), bc2/bc2.max(), 0.01, numItermax=10000)\n    print(f\\\"factor={factor}: max Q diff={np.max(np.abs(Q1-Q2)):.6f}\\\")\n    \n# What about with larger reg? (less sensitive)\nfor reg_q in [0.01, 0.05, 0.1, 0.2, 0.5]:\n    bc1 = np.array([[1.0, 1.1], [1.05, 1.15], [1.08, 1.2]])\n    bc2 = bc1 * 1.05  # 5% uniform scaling\n    Q1 = ot.sinkhorn(ot.unif(3), ot.unif(2), bc1/bc1.max(), reg_q, numItermax=10000)\n    Q2 = ot.sinkhorn(ot.unif(3), ot.unif(2), bc2/bc2.max(), reg_q, numItermax=10000)\n    # With uniform scaling bc2 = k*bc1, normalization makes them identical\n    # So Q should be the same... unless the normalization is different\n    print(f\\\"reg={reg_q}: max Q diff (uniform 5%): {np.max(np.abs(Q1-Q2)):.6f}\\\")\n\n# The issue must be non-uniform perturbation\nfor reg_q in [0.01, 0.05, 0.1]:\n    bc1 = np.array([[1.0, 1.1], [1.05, 1.15], [1.08, 1.2]])\n    # 2% random perturbation\n    np.random.seed(42)\n    bc2 = bc1 * (1 + np.random.randn(*bc1.shape) * 0.02)\n    Q1 = ot.sinkhorn(ot.unif(3), ot.unif(2), bc1/bc1.max(), reg_q, numItermax=10000)\n    Q2 = ot.sinkhorn(ot.unif(3), ot.unif(2), bc2/bc2.max(), reg_q, numItermax=10000)\n    print(f\\\"reg={reg_q}, 2% random pert: max Q diff={np.max(np.abs(Q1-Q2)):.6f}, rel bc err={np.max(np.abs(bc1-bc2)/bc1):.4f}\\\")\nPYEOF\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

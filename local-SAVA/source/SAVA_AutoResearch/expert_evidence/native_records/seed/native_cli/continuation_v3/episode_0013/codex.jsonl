* c_max\n    P_s = (1.0/len(a)) * (1.0/len(b)) * np.exp((fm_np[:, None] + gm_np[None, :] - C) / reg_match)\n    bc_s = float(np.sum(P_s * C)) / (len(a) + len(b))\n    \n    # Reference (scaling=0.5)\n    fm_ref, gm_ref = pot_match(z1, z2)\n    fm_ref_np = fm_ref.numpy().ravel()\n    gm_ref_np = gm_ref.numpy().ravel()\n    P_ref = (1.0/len(a)) * (1.0/len(b)) * np.exp((fm_ref_np[:, None] + gm_ref_np[None, :] - C) / reg_match)\n    bc_ref = float(np.sum(P_ref * C)) / (len(a) + len(b))\n    \n    print(f\\\"  scaling={scaling}: {(t1-t0)/10*1000:.1f}ms, bc_err={abs(bc_s-bc_ref)/bc_ref:.6f}\\\")\nPYEOF\npython3 /tmp/test_detailed_timing.py 2>&1 | grep -v UserWarning | grep -v \\\"warnings.warn\\\"\"", "aggregated_output": "GeomLoss pot (reg=0.1): 98.8ms per call (1024x1024)\nGeomLoss pot (reg=0.1*C_max): 22.6ms per call (1024x1024)\n  C_max=20892.8, blur_match=45.71\nGeomLoss loss (reg=0.1*C_max): 25.3ms per call\nPOT sinkhorn (reg=0.1 normalized): 988.5ms per call\n  scaling=0.5: 22.3ms, bc_err=0.000000\n  scaling=0.7: 31.1ms, bc_err=0.005502\n  scaling=0.8: 48.4ms, bc_err=0.008897\n  scaling=0.9: 307.2ms, bc_err=0.009107\n", "exit_code": 0, "status": "completed"}}

{"type": "item.started", "item": {"id": "item_102", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/test_cheap_bc.py << 'PYEOF'\n\\\"\\\"\\\"Test cheap batchcost approximations: mean C, median C, etc.\\\"\\\"\\\"\nimport numpy as np, sys\nsys.path.insert(0, '/workspace/solution')\nimport torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nfrom scipy.stats import spearmanr\nimport ot\n\ntorch.set_num_threads(2)\n\ndef nrmse(pred, target):\n    return np.sqrt(np.mean((pred - target)**2)) / np.std(target)\n\ndef top_q_overlap(a, b, q=0.25):\n    n = len(a); k = int(n * q)\n    return len(set(np.argsort(-a)[:k]) & set(np.argsort(-b)[:k])) / k\n\ncases = [\n    'seed_101_uniform_labels',\n    'seed_101_gaussian_016',\n    'seed_202_mixed',\n    'seed_404_gaussian_024',\n    'seed_505_asymmetric_labels',\n]\n\nfor case_id in cases:\n    d = np.load(f'/workspace/environment/public_assets/dev/{case_id}.npz')\n    x, y, r, ry, seed = d['x'], d['y'], d['r'], d['ry'], int(d['seed'])\n    \n    batch_size = 1024\n    tx = [np.arange(i, min(i + batch_size, len(x))) for i in range(0, len(x), batch_size)]\n    tr = [np.arange(i, min(i + batch_size, len(r))) for i in range(0, len(r), batch_size)]\n    \n    # Label cost\n    xx = torch.tensor(np.concatenate([x[tx[0]], r[tr[0]]]), dtype=torch.float32)\n    yy = np.concatenate([y[tx[0]], ry[tr[0]] + 10])\n    W = np.zeros((20, 20), dtype=np.float32)\n    loss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\n    with torch.inference_mode():\n        for i in range(20):\n            for j in range(i + 1, 20):\n                W[i, j] = W[j, i] = float(loss(xx[yy == i], xx[yy == j]))\n    \n    # Canonical F via GeomLoss (fast)\n    def cost(z1,z2):\n        d=torch.cdist(z1[:,:,:-1],z2[:,:,:-1]).square()/2\n        return d+torch.as_tensor(W)[z1[:,:,-1].long().unsqueeze(2),z2[:,:,-1].long().unsqueeze(1)]/2\n    potential = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                           potentials=True, cost=cost, backend='tensorized')\n    \n    F = {}\n    bc_canon = np.zeros((len(tx), len(tr)))\n    bc_mean = np.zeros((len(tx), len(tr)))\n    bc_median = np.zeros((len(tx), len(tr)))\n    bc_min = np.zeros((len(tx), len(tr)))\n    \n    for i, idx in enumerate(tx):\n        for j, jdx in enumerate(tr):\n            a = x[idx]; b = r[jdx]\n            n_src = len(idx); n_tgt = len(jdx)\n            \n            C = cdist(a, b, 'sqeuclidean') / 2 + W[y[idx[:, None]], ry[jdx][None, :] + 10] / 2\n            \n            # Canonical batchcost\n            P = ot.sinkhorn(ot.unif(n_src), ot.unif(n_tgt), C / max(float(C.max()), 1e-12), .1)\n            bc_canon[i, j] = float(np.sum(P * C)) / (n_src + n_tgt)\n            \n            # Cheap approximations\n            bc_mean[i, j] = float(C.mean()) / (n_src + n_tgt) * n_src * n_tgt / (n_src + n_tgt)\n            # Wait, mean(C) is average cost. OT cost with uniform weights should be close.\n            # Actually: mean over all entries of C = sum(C) / (n*m)\n            # OT cost = sum(P*C) where P has total mass 1\n            # So OT cost ~ mean(C) when P is close to uniform (strong reg)\n            bc_mean[i, j] = float(C.mean())  # sum(P*C) approx = mean(C) when P uniform\n            bc_median[i, j] = float(np.median(C))\n            bc_min[i, j] = float(C.min())\n            \n            # F from GeomLoss\n            z1 = torch.tensor(np.column_stack([a, y[idx]]), dtype=torch.float32)[None]\n            z2 = torch.tensor(np.column_stack([b, ry[jdx] + 10]), dtype=torch.float32)[None]\n            with torch.inference_mode(): f_t, _ = potential(z1, z2)\n            f = f_t.numpy().ravel().astype(float)\n            F[i, j] = (f - f.mean()) * len(f) / (len(f) - 1)\n    \n    # Compute Q and values for each approximation\n    def compute_values(bc):\n        Q = ot.sinkhorn(ot.unif(len(tx)), ot.unif(len(tr)),\n                       bc / max(float(bc.max()), 1e-12), .01,\n                       numItermax=10000, stopThr=1e-10)\n        values = np.zeros(len(x))\n        for i, idx in enumerate(tx):\n            values[idx] = sum(Q[i, j] * F[i, j] for j in range(len(tr)))\n        return values\n    \n    v_canon = compute_values(bc_canon)\n    v_mean = compute_values(bc_mean)\n    v_median = compute_values(bc_median)\n    v_min = compute_values(bc_min)\n    \n    print(f\\\"\\\\n=== {case_id} ===\\\")\n    print(f\\\"  Canonical bc:  {bc_canon.ravel()}\\\")\n    print(f\\\"  Mean C:        {bc_mean.ravel()}\\\")\n    print(f\\\"  Rank corr (mean): {spearmanr(bc_canon.ravel(), bc_mean.ravel())[0]:.4f}\\\")\n    print(f\\\"  Rank corr (median): {spearmanr(bc_canon.ravel(), bc_median.ravel())[0]:.4f}\\\")\n    \n    print(f\\\"  Mean C NRMSE:  {nrmse(v_mean, v_canon):.5f}\\\")\n    print(f\\\"  Mean C Spear:  {spearmanr(v_mean, v_canon)[0]:.5f}\\\")\n    print(f\\\"  Mean C TopQ:   {top_q_overlap(v_mean, v_canon):.5f}\\\")\n    \n    print(f\\\"  Median NRMSE:  {nrmse(v_median, v_canon):.5f}\\\")\n    print(f\\\"  Median Spear:  {spearmanr(v_median, v_canon)[0]:.5f}\\\")\n    print(f\\\"  Median TopQ:   {top_q_overlap(v_median, v_canon):.5f}\\\")\nPYEOF\npython3 /tmp/test_cheap_bc.py 2>&1 | grep -v UserWarning | grep -v \\\"warnings.warn\\\"\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

{"type": "item.started", "item": {"id": "item_53", "type": "command_execution", "command": "/bin/sh -lc \"python3 -c \\\"\nimport numpy as np, time\nimport torch\ntorch.set_num_threads(2)\nimport ot\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\n\nd = np.load('/workspace/environment/public_assets/dev/seed_101_uniform_labels.npz')\nx, y, r, ry = d['x'][:512], d['y'][:512], d['r'][:512], d['ry'][:512]\n\nC = cdist(x, r, 'sqeuclidean').astype(np.float64) / 2\na = np.ones(len(x)) / len(x)\nb = np.ones(len(r)) / len(r)\n\n# POT with various reg values\nfor reg in [0.05, 0.1, 0.2, 0.5]:\n    P, log_dict = ot.sinkhorn(a, b, C, reg, method='sinkhorn_log', log=True, numItermax=5000)\n    f_pot = -reg * log_dict['log_u']  # source Kantorovich potential\n    f_pot_c = (f_pot - f_pot.mean()) * len(f_pot) / (len(f_pot) - 1)\n    \n    # GeomLoss: p=2, cost = sqeuclidean/2 (built-in)\n    # For built-in Sinkhorn: cost = ||x-y||\"'^p / p = ||x-y||''^2 / 2 for p=2\n    # blur parameter: kernel = exp(-||x-y||''^p / blur''^p) = exp(-||x-y||''^2 / blur''^2)\n    # For p=2: K = exp(-C * 2 / blur''^2) since C = ||x-y||''^2/2, so ||x-y||''^2 = 2C\n    # And standard Sinkhorn: K = exp(-C/reg) => 2/blur''^2 = 1/reg => blur = sqrt(2*reg)\n    \n    for blur_name, blur_val in [('\"'sqrt(2*reg)', np.sqrt(2*reg)), ('sqrt(reg)', np.sqrt(reg)), ('reg', reg)]:\n        potential = SamplesLoss('sinkhorn', p=2, blur=blur_val, debias=False,\n                               potentials=True, backend='tensorized')\n        z1=torch.tensor(x,dtype=torch.float64)[None]\n        z2=torch.tensor(r,dtype=torch.float64)[None]\n        with torch.inference_mode(): f_geom, g_geom = potential(z1, z2)\n        f_geom = f_geom.numpy().ravel()\n        f_geom_c = (f_geom - f_geom.mean()) * len(f_geom) / (len(f_geom) - 1)\n        \n        diff = np.abs(f_pot_c - f_geom_c).max()\n        scale = f_geom_c.std() / f_pot_c.std() if f_pot_c.std() > 0 else 0\n        # Also check raw (uncentered)\n        diff_raw = np.abs(f_pot - f_geom).max()\n        print(f'reg={reg}, blur={blur_name}={blur_val:.4f}: centered_maxdiff={diff:.4f}, scale={scale:.4f}, raw_maxdiff={diff_raw:.2f}')\n\\\" 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

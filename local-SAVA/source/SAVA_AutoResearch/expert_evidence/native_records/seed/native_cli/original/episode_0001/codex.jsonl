{"type": "item.started", "item": {"id": "item_72", "type": "command_execution", "command": "/bin/sh -lc 'python3 -c \"\nimport numpy as np\nimport torch\ntorch.set_num_threads(2)\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nimport ot\n\nnp.random.seed(42)\nn, m = 50, 60\nx = np.random.randn(n, 2).astype(np.float64)\ny = np.random.randn(m, 2).astype(np.float64)\na = np.ones(n)/n; b = np.ones(m)/m\n\n# GeomLoss with custom cost - use cost=||x-y||''^2 to be clear\ndef my_cost(z1, z2):\n    return torch.cdist(z1, z2).square()\n\nfor blur in [0.3, 0.5, 1.0]:\n    loss_fn = SamplesLoss('\"'sinkhorn', p=2, blur=blur, debias=False, cost=my_cost, backend='tensorized')\n    z1 = torch.tensor(x)[None]\n    z2 = torch.tensor(y)[None]\n    with torch.inference_mode():\n        loss_val = float(loss_fn(z1, z2))\n    \n    # C = ||x-y||\"'^2, kernel = exp(-C/blur''^p) = exp(-C/blur''^2)\n    # => reg = blur''^2\n    C = cdist(x, y, '\"'sqeuclidean')\n    P = ot.sinkhorn(a, b, C, blur**2, method='sinkhorn_log', numItermax=20000)\n    W = np.sum(P * C)\n    print(f'blur={blur}: custom_cost GeomLoss={loss_val:.6f}, POT(C=||x-y||\"'^2,reg=blur''^2)={W:.6f}, ratio={loss_val/W:.6f}'\"')\n\\\" 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

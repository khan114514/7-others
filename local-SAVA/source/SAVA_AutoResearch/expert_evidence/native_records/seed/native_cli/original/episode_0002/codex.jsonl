{"type": "item.started", "item": {"id": "item_27", "type": "command_execution", "command": "/bin/sh -lc \"cd /workspace/solution && python -c \\\"\nimport numpy as np, time, sys\nsys.path.insert(0, '.')\nimport method\nimport torch\nfrom scipy.spatial.distance import cdist\nfrom geomloss import SamplesLoss\nimport ot\n\ndata = np.load('/workspace/environment/public_assets/dev/seed_101_uniform_labels.npz')\nx = data['x'].astype(np.float32)\ny = data['y'].astype(np.int64)\nr = data['r'].astype(np.float32)\nry = data['ry'].astype(np.int64)\ntorch.set_num_threads(2)\n\nbatch_size = 1024\ntx = [np.arange(i, min(i + batch_size, len(x))) for i in range(0, len(x), batch_size)]\ntr = [np.arange(i, min(i + batch_size, len(r))) for i in range(0, len(r), batch_size)]\nprint(f'{len(tx)} candidate batches, {len(tr)} ref batches = {len(tx)*len(tr)} pairs')\n\nt0 = time.time()\nW = method._label_cost(x[tx[0]], y[tx[0]], r[tr[0]], ry[tr[0]])\nt1 = time.time()\nprint(f'Label cost: {t1-t0:.3f}s')\n\ndef cost(z1, z2, W):\n    d = torch.cdist(z1[:, :, :-1], z2[:, :, :-1]).square() / 2\n    return d + torch.as_tensor(W)[z1[:, :, -1].long().unsqueeze(2), z2[:, :, -1].long().unsqueeze(1)] / 2\n\npotential = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                       potentials=True, cost=lambda a,b: cost(a,b,W), backend='tensorized')\n\n# Profile one batch pair\ni, j = 0, 0\nidx, jdx = tx[i], tr[j]\na, b = x[idx], r[jdx]\n\nt2 = time.time()\nC = cdist(a, b, 'sqeuclidean') / 2 + W[y[idx, None], ry[jdx][None, :] + 10] / 2\nt3 = time.time()\nP = ot.sinkhorn(ot.unif(len(idx)), ot.unif(len(jdx)), C / max(float(C.max()), 1e-12), .1)\nt4 = time.time()\nbatchcost_val = float(np.sum(P * C)) / (len(idx) + len(jdx))\nt5 = time.time()\nz1 = torch.tensor(np.column_stack([a, y[idx]]), dtype=torch.float32)[None]\nz2 = torch.tensor(np.column_stack([b, ry[jdx] + 10]), dtype=torch.float32)[None]\nwith torch.inference_mode(): f, _ = potential(z1, z2)\nt6 = time.time()\nf = f.numpy().ravel().astype(float)\nFval = (f - f.mean()) * len(f) / (len(f) - 1)\n\nprint(f'Pair ({i},{j}): size {len(idx)}x{len(jdx)}')\nprint(f'  C compute: {t3-t2:.3f}s')\nprint(f'  POT sinkhorn: {t4-t3:.3f}s')\nprint(f'  batchcost sum: {t5-t4:.3f}s')\nprint(f'  GeomLoss potentials: {t6-t5:.3f}s')\nprint(f'  Total pair: {t6-t2:.3f}s')\n\\\"\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

{"type": "item.started", "item": {"id": "item_43", "type": "command_execution", "command": "/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np\nimport torch\nimport time\nimport ot\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\n\ntorch.set_num_threads(2)\n\ndata = np.load('/workspace/environment/public_assets/dev/seed_101_gaussian_016.npz')\nx = data['x']; y = data['y']; r = data['r']; ry = data['ry']\nbatch_size = 1024\n\ntx=[np.arange(i,min(i+batch_size,len(x))) for i in range(0,len(x),batch_size)]\ntr=[np.arange(i,min(i+batch_size,len(r))) for i in range(0,len(r),batch_size)]\nprint(f'Batch pairs: {len(tx)} x {len(tr)} = {len(tx)*len(tr)}')\n\n# Time label cost\nt0 = time.time()\nxx=torch.tensor(np.concatenate([x[tx[0]],r[tr[0]]]),dtype=torch.float32)\nyy=np.concatenate([y[tx[0]],ry[tr[0]]+10])\nW=np.zeros((20,20),dtype=np.float32)\nloss=SamplesLoss('sinkhorn',p=2,blur=np.sqrt(.1),debias=False,backend='tensorized')\nwith torch.inference_mode():\n    for i in range(20):\n        for j in range(i+1,20):\n            W[i,j]=W[j,i]=float(loss(xx[yy==i],xx[yy==j]))\nt1 = time.time()\nprint(f'Label cost: {t1-t0:.3f}s')\n\n# Time one batch pair (POT + GeomLoss)\nidx = tx[0]; jdx = tr[0]\na=x[idx];b=r[jdx]\nya=y[idx];yb=ry[jdx]\n\n# POT\nt0 = time.time()\nC=cdist(a,b,'sqeuclidean')/2+W[ya[:,None],yb[None,:]+10]/2\nP=ot.sinkhorn(ot.unif(len(idx)),ot.unif(len(jdx)),C/max(float(C.max()),1e-12),.1)\nbc = float(np.sum(P*C))/(len(idx)+len(jdx))\nt1 = time.time()\nprint(f'POT per pair: {t1-t0:.3f}s')\n\n# GeomLoss potentials\ndef cost(z1,z2):\n    d=torch.cdist(z1[:,:,:-1],z2[:,:,:-1]).square()/2\n    return d+torch.as_tensor(W)[z1[:,:,-1].long().unsqueeze(2),z2[:,:,-1].long().unsqueeze(1)]/2\npotential=SamplesLoss('sinkhorn',p=2,blur=np.sqrt(.1),debias=False,\n                     potentials=True,cost=cost,backend='tensorized')\nz1=torch.tensor(np.column_stack([a,ya]),dtype=torch.float32)[None]\nz2=torch.tensor(np.column_stack([b,yb+10]),dtype=torch.float32)[None]\n\nt0 = time.time()\nwith torch.inference_mode(): f,_=potential(z1,z2)\nt1 = time.time()\nprint(f'GeomLoss per pair: {t1-t0:.3f}s')\n\n# Verify: can we get batchcost from GeomLoss potentials?\nf_np = f.numpy().ravel().astype(float)\n# OT_cost = sum(a*f) + sum(b*g) - but need g too\n# Let's get both\nwith torch.inference_mode(): f_t,g_t=potential(z1,z2)\nf_np = f_t.numpy().ravel().astype(float)\ng_np = g_t.numpy().ravel().astype(float)\nn1 = len(f_np); n2 = len(g_np)\not_cost = np.mean(f_np) + np.mean(g_np)  # uniform weights\nbc_gl = ot_cost / (n1 + n2) * n1 * n2 / (n1 + n2)  # wait, need to check units\nprint(f'POT batchcost: {bc:.4f}')\nprint(f'GL ot_cost: {ot_cost:.4f}, simple divide: {ot_cost/(n1+n2):.4f}')\n\\\"\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

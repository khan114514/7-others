{"type": "item.started", "item": {"id": "item_68", "type": "command_execution", "command": "/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport time, numpy as np\nimport torch, ot\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\n\ntorch.set_num_threads(2)\ndata = np.load('/workspace/environment/public_assets/dev/seed_101_uniform_labels.npz')\nx = np.asarray(data['x'], np.float32)\ny = np.asarray(data['y'], np.int64)\nr = np.asarray(data['r'], np.float32)\nry = np.asarray(data['ry'], np.int64)\n\n# Get W quickly\nxx=torch.tensor(np.concatenate([x[:1024],r[:1024]]),dtype=torch.float32)\nyy=np.concatenate([y[:1024],ry[:1024]+10])\nW=np.zeros((20,20),dtype=np.float32)\nloss=SamplesLoss('sinkhorn',p=2,blur=np.sqrt(.1),debias=False,backend='tensorized')\nwith torch.inference_mode():\n    for i in range(20):\n        for j in range(i+1,20):\n            W[i,j]=W[j,i]=float(loss(xx[yy==i],xx[yy==j]))\n\n# Test: use ot.sinkhorn_log and extract potentials\na = x[:1024]; b = r[:1024]\nay = y[:1024]; by = ry[:1024] + 10\nC = cdist(a, b, 'sqeuclidean')/2 + W[ay[:,None], by[None,:]]/2\nC = C.astype(np.float64)\nC_max = C.max()\nreg = 0.1\na_w = ot.unif(len(a))\nb_w = ot.unif(len(b))\n\n# POT sinkhorn (stable version)\nt0 = time.time()\nP1 = ot.sinkhorn(a_w, b_w, C/C_max, reg)\nt1 = time.time()\nprint(f'ot.sinkhorn: {t1-t0:.3f}s')\n\n# POT sinkhorn_log\nt0 = time.time()\nlog_u, log_v = ot.sinkhorn_log(a_w, b_w, C/C_max, reg, log=True)\nt1 = time.time()\nprint(f'ot.sinkhorn_log: {t1-t0:.3f}s')\nprint(f'log_u shape: {log_u.shape}, log_v shape: {log_v.shape}')\nprint(f'log_u range: [{log_u.min():.4f}, {log_u.max():.4f}]')\n\n# Reconstruct coupling and compare\nP2 = np.exp(log_u[:, None] + log_v[None, :] - C/(C_max*reg))\nprint(f'Max P diff: {np.abs(P1-P2).max():.6e}')\nprint(f'Batch cost POT: {np.sum(P1*C)/(len(a)+len(b)):.6f}')\nprint(f'Batch cost log: {np.sum(P2*C)/(len(a)+len(b)):.6f}')\n\n# Compare potentials with GeomLoss\ndef cost(z1,z2):\n    d=torch.cdist(z1[:,:,:-1],z2[:,:,:-1]).square()/2\n    return d+torch.as_tensor(W)[z1[:,:,-1].long().unsqueeze(2),z2[:,:,-1].long().unsqueeze(1)]/2\npotential_loss = SamplesLoss('sinkhorn',p=2,blur=np.sqrt(.1),debias=False,potentials=True,cost=cost,backend='tensorized')\nz1 = torch.tensor(np.column_stack([a, ay]), dtype=torch.float32)[None]\nz2 = torch.tensor(np.column_stack([b, by]), dtype=torch.float32)[None]\nt0 = time.time()\nwith torch.inference_mode():\n    f_geom, g_geom = potential_loss(z1, z2)\nt1 = time.time()\nprint(f'GeomLoss potentials: {t1-t0:.3f}s')\nf_geom = f_geom.numpy().ravel()\n\n# POT potentials: f = reg * log_u (but need to check scaling convention)\n# In POT: P = diag(a) K diag(b) with K = exp(-C/reg)\n# In log-domain: log_u, log_v such that P = exp(log_u + log_v - C/reg)\n# Potential f such that (f/reg) = log_u (up to additive constant)\n# But POT's sinkhorn_log returns log of u,v where u*v gives the scaling\n# Let me check\nf_pot = log_u * reg * C_max  # scale back since C was divided by C_max\nprint(f'GeomLoss f range: [{f_geom.min():.4f}, {f_geom.max():.4f}]')\nprint(f'POT f range: [{f_pot.min():.4f}, {f_pot.max():.4f}]')\n# Normalize both\nn = len(a)\nf_g_norm = (f_geom - f_geom.mean()) * n / (n-1)\nf_p_norm = (f_pot - f_pot.mean()) * n / (n-1)\nprint(f'Max abs diff (norm): {np.abs(f_g_norm - f_p_norm).max():.6f}')\nprint(f'Correlation: {np.corrcoef(f_g_norm, f_p_norm)[0,1]:.10f}')\n\\\" 2>&1\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

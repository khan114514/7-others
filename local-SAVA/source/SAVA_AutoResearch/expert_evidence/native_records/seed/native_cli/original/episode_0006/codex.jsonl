{"type": "item.started", "item": {"id": "item_57", "type": "command_execution", "command": "/bin/sh -lc \"cd /workspace/solution && cat > /tmp/test_unified.py << 'PYEOF'\n\\\"\\\"\\\"Test: unified log-domain Sinkhorn gives same potentials as GeomLoss.\\\"\\\"\\\"\nimport numpy as np\nimport torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\n\ntorch.set_num_threads(2)\n\ndata = np.load('/workspace/environment/public_assets/dev/seed_101_uniform_labels.npz')\nx = np.asarray(data['x'], np.float32)\ny = np.asarray(data['y'], np.int64)\nr = np.asarray(data['r'], np.float32)\nry = np.asarray(data['ry'], np.int64)\n\n# Get W\nxx=torch.tensor(np.concatenate([x[:1024],r[:1024]]),dtype=torch.float32)\nyy=np.concatenate([y[:1024],ry[:1024]+10])\nW=np.zeros((20,20),dtype=np.float32)\nloss=SamplesLoss('sinkhorn',p=2,blur=np.sqrt(.1),debias=False,backend='tensorized')\nwith torch.inference_mode():\n    for i in range(20):\n        for j in range(i+1,20):\n            W[i,j]=W[j,i]=float(loss(xx[yy==i],xx[yy==j]))\n\n# One batch pair\na = x[:1024]\nb = r[:1024]\nay = y[:1024]\nby = ry[:1024] + 10\n\n# GeomLoss reference\ndef cost(z1,z2):\n    d=torch.cdist(z1[:,:,:-1],z2[:,:,:-1]).square()/2\n    return d+torch.as_tensor(W)[z1[:,:,-1].long().unsqueeze(2),z2[:,:,-1].long().unsqueeze(1)]/2\npotential_loss = SamplesLoss('sinkhorn',p=2,blur=np.sqrt(.1),debias=False,potentials=True,cost=cost,backend='tensorized')\nz1 = torch.tensor(np.column_stack([a, ay]), dtype=torch.float32)[None]\nz2 = torch.tensor(np.column_stack([b, by]), dtype=torch.float32)[None]\nwith torch.inference_mode():\n    f_geom, g_geom = potential_loss(z1, z2)\nf_geom = f_geom.numpy().ravel()\nprint(f\\\"GeomLoss f: min={f_geom.min():.4f}, max={f_geom.max():.4f}, mean={f_geom.mean():.4f}\\\")\n\n# Unified numpy log-sinkhorn\ndef logsumexp(a, axis=None):\n    a_max = np.max(a, axis=axis, keepdims=True)\n    return np.log(np.sum(np.exp(a - a_max), axis=axis)) + a_max.squeeze(axis=axis)\n\nC = cdist(a, b, 'sqeuclidean')/2 + W[ay[:, None], by[None, :]]/2\nC = C.astype(np.float64)\nC_max = C.max()\nreg = 0.1\nn, m = len(a), len(b)\na_w = np.ones(n) / n\nb_w = np.ones(m) / m\n\nlog_a = np.log(a_w)\nlog_b = np.log(b_w)\nlog_u = np.zeros(n)\nlog_v = np.zeros(m)\nC_scaled = C / C_max\nreg_scaled = reg / C_max\n\nfor it in range(5000):\n    log_v_prev = log_v.copy()\n    M = -C_scaled / reg_scaled + log_v[None, :]\n    log_u = log_a - logsumexp(M, axis=1)\n    M = -C_scaled / reg_scaled + log_u[:, None]\n    log_v = log_b - logsumexp(M, axis=0)\n    if it % 10 == 9:\n        if np.abs(log_v - log_v_prev).max() < 1e-10:\n            print(f\\\"Converged at iteration {it+1}\\\")\n            break\n\nf_sink = log_u * reg  # unnormalized potential\ng_sink = log_v * reg\n# Normalize like canonical: (f - f.mean()) * n/(n-1)\nf_sink_norm = (f_sink - f_sink.mean()) * n / (n - 1)\nf_geom_norm = (f_geom - f_geom.mean()) * n / (n - 1)\n\nprint(f\\\"Custom f: min={f_sink.min():.4f}, max={f_sink.max():.4f}, mean={f_sink.mean():.4f}\\\")\nprint(f\\\"Max abs diff (unnorm): {np.abs(f_sink - f_geom).max():.6f}\\\")\nprint(f\\\"Max abs diff (norm): {np.abs(f_sink_norm - f_geom_norm).max():.6f}\\\")\nprint(f\\\"Correlation: {np.corrcoef(f_sink_norm, f_geom_norm)[0,1]:.10f}\\\")\n\n# Also check batch cost\nP = np.exp(log_u[:, None] + log_v[None, :] - C_scaled / reg_scaled)\nbc_my = np.sum(P * C) / (n + m)\nprint(f\\\"batch cost (my): {bc_my:.6f}\\\")\nPYEOF\npython3 /tmp/test_unified.py 2>&1\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

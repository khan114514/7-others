,yb+10]),dtype=torch.float32)[None]\n\nfor blur_sq in [0.1, 1, 10, 50, 100, 200, 500, 1000, 2000]:\n    blur = np.sqrt(blur_sq)\n    cost = cost_fn(W)\n    loss_obj = SamplesLoss('sinkhorn',p=2,blur=blur,debias=False,cost=cost,backend='tensorized')\n    with torch.inference_mode():\n        l = float(loss_obj(z1, z2))\n    # Normalize same as canonical: / (ni+nj)\n    bc_geom = l / (ni + nj)\n    print(f\\\"blur\"'^2={blur_sq:5d}, loss={l:.4f}, bc_geom={bc_geom:.6f}, ratio={bc_geom/bc_canon:.4f}\")\nEOF\ncd /tmp && python3 test_blur.py'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

{"type": "item.started", "item": {"id": "item_64", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/test_batchcost_proxy.py << 'EOF'\nimport sys, time, numpy as np\nsys.path.insert(0, '/workspace/solution')\nimport torch, ot\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\n\ndata = np.load('/workspace/environment/public_assets/dev/seed_101_gaussian_024.npz')\nx = data['x'].astype(np.float32)\ny = data['y'].astype(np.int64)\nr = data['r'].astype(np.float32)\nry = data['ry'].astype(np.int64)\n\ntorch.set_num_threads(2)\nbatch_size = 1024\ntx=[np.arange(i,min(i+batch_size,len(x))) for i in range(0,len(x),batch_size)]\ntr=[np.arange(i,min(i+batch_size,len(r))) for i in range(0,len(r),batch_size)]\n\ndef _label_cost(x,y,r,ry):\n    xx=torch.tensor(np.concatenate([x,r]),dtype=torch.float32)\n    yy=np.concatenate([y,ry+10])\n    W=np.zeros((20,20),dtype=np.float32)\n    loss=SamplesLoss('sinkhorn',p=2,blur=np.sqrt(.1),debias=False,backend='tensorized')\n    with torch.inference_mode():\n        for i in range(20):\n            for j in range(i+1,20):\n                W[i,j]=W[j,i]=float(loss(xx[yy==i],xx[yy==j]))\n    return W\n\nW = _label_cost(x[tx[0]],y[tx[0]],r[tr[0]],ry[tr[0]])\n\ndef cost(z1,z2):\n    d=torch.cdist(z1[:,:,:-1],z2[:,:,:-1]).square()/2\n    return d+torch.as_tensor(W)[z1[:,:,-1].long().unsqueeze(2),z2[:,:,-1].long().unsqueeze(1)]/2\n\npotential=SamplesLoss('sinkhorn',p=2,blur=np.sqrt(.1),debias=False,\n                     potentials=True,cost=cost,backend='tensorized')\n\n# Canonical\nF={}; bc_canon=np.zeros((len(tx),len(tr)))\nfor i,idx in enumerate(tx):\n    for j,jdx in enumerate(tr):\n        a=x[idx];b=r[jdx]\n        ya=y[idx]; yb=ry[jdx]\n        C=cdist(a,b,'sqeuclidean')/2+W[ya[:,None],yb[None,:]+10]/2\n        P=ot.sinkhorn(ot.unif(len(idx)),ot.unif(len(jdx)),C/max(float(C.max()),1e-12),.1)\n        bc_canon[i,j]=float(np.sum(P*C))/(len(idx)+len(jdx))\n        z1=torch.tensor(np.column_stack([a,ya]),dtype=torch.float32)[None]\n        z2=torch.tensor(np.column_stack([b,yb+10]),dtype=torch.float32)[None]\n        with torch.inference_mode(): f,_=potential(z1,z2)\n        f=f.numpy().ravel().astype(float)\n        F[i,j]=(f-f.mean())*len(f)/(len(f)-1)\n\nQ_canon=ot.sinkhorn(ot.unif(len(tx)),ot.unif(len(tr)),\n              bc_canon/max(float(bc_canon.max()),1e-12),.01,\n              numItermax=10000,stopThr=1e-10)\n\nvalues_canon = np.zeros(len(x))\nfor i,idx in enumerate(tx):\n    values_canon[idx] = sum(Q_canon[i,j]*F[i,j] for j in range(len(tr)))\n\n# Proxy: mean cost per pair (no Sinkhorn at all)\nbc_mean = np.zeros((len(tx), len(tr)))\nfor i,idx in enumerate(tx):\n    for j,jdx in enumerate(tr):\n        a=x[idx];b=r[jdx]\n        ya=y[idx]; yb=ry[jdx]\n        C=cdist(a,b,'sqeuclidean')/2+W[ya[:,None],yb[None,:]+10]/2\n        bc_mean[i,j] = C.mean() / (len(idx)+len(jdx)) * len(idx)  # scale factor?\n\nprint(\\\"Canonical batchcost:\\\")\nprint(bc_canon)\nprint(\\\"\\\\nMean cost / (ni+nj):\\\")\nbc_mean2 = np.zeros((len(tx), len(tr)))\nfor i,idx in enumerate(tx):\n    for j,jdx in enumerate(tr):\n        a=x[idx];b=r[jdx]\n        ya=y[idx]; yb=ry[jdx]\n        C=cdist(a,b,'sqeuclidean')/2+W[ya[:,None],yb[None,:]+10]/2\n        bc_mean2[i,j] = np.sum(C) / (len(idx) * len(jdx)) / (len(idx)+len(jdx)) * len(idx)*len(jdx) / 2\n        # Wait let's just try avg cost\n        bc_mean2[i,j] = C.mean()\n\nprint(bc_mean2)\nprint(f\\\"\\\\nCanonical / mean ratio: {bc_canon / bc_mean2}\\\")\n\n# Proxy: Sinkhorn divergence from GeomLoss\nbc_geom = np.zeros((len(tx), len(tr)))\nloss=SamplesLoss('sinkhorn',p=2,blur=np.sqrt(.1),debias=False,backend='tensorized')\nfor i,idx in enumerate(tx):\n    for j,jdx in enumerate(tr):\n        a=x[idx];b=r[jdx]\n        ya=y[idx]; yb=ry[jdx]\n        z1=torch.tensor(np.column_stack([a,ya]),dtype=torch.float32)[None]\n        z2=torch.tensor(np.column_stack([b,yb+10]),dtype=torch.float32)[None]\n        with torch.inference_mode():\n            bc_geom[i,j] = float(loss(z1, z2))\n        # Normalize the same way as canonical\n        bc_geom[i,j] = bc_geom[i,j] / (len(idx) + len(jdx)) * len(idx) * len(jdx) / 2  # ???\n\nprint(\\\"\\\\nGeomLoss batchcost (raw):\\\")\nbc_geom2 = np.zeros((len(tx), len(tr)))\nfor i,idx in enumerate(tx):\n    for j,jdx in enumerate(tr):\n        a=x[idx];b=r[jdx]\n        ya=y[idx]; yb=ry[jdx]\n        z1=torch.tensor(np.column_stack([a,ya]),dtype=torch.float32)[None]\n        z2=torch.tensor(np.column_stack([b,yb+10]),dtype=torch.float32)[None]\n        with torch.inference_mode():\n            bc_geom2[i,j] = float(loss(z1, z2)) / (len(idx) + len(jdx)) * len(idx)\nprint(bc_geom2)\nprint(f\\\"\\\\nCanonical / geomloss ratio: {bc_canon / bc_geom2}\\\")\n\n# Try using GeomLoss-derived batchcost for Q\nQ_geom=ot.sinkhorn(ot.unif(len(tx)),ot.unif(len(tr)),\n              bc_geom2/max(float(bc_geom2.max()),1e-12),.01,\n              numItermax=10000,stopThr=1e-10)\nprint(f\\\"\\\\nQ canonical:\\\\n{Q_canon}\\\")\nprint(f\\\"Q geom:\\\\n{Q_geom}\\\")\n\nvalues_geom = np.zeros(len(x))\nfor i,idx in enumerate(tx):\n    values_geom[idx] = sum(Q_geom[i,j]*F[i,j] for j in range(len(tr)))\n\nnrmse = np.sqrt(np.mean((values_canon - values_geom)**2)) / np.std(values_canon)\nfrom scipy.stats import spearmanr\nrho, _ = spearmanr(values_canon, values_geom)\nn = len(x); k = n//4\nidx_c = set(np.argsort(-values_canon)[:k])\nidx_g = set(np.argsort(-values_geom)[:k])\noverlap = len(idx_c & idx_g) / k\nprint(f\\\"\\\\nGeomLoss Q - NRMSE: {nrmse:.6f}, Spearman: {rho:.6f}, Overlap: {overlap:.6f}\\\")\nEOF\ncd /tmp && python3 test_batchcost_proxy.py\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

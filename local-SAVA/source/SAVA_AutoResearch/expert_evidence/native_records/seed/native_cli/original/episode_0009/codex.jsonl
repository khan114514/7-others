ros_like(b)\n    K = -C / reg\n    \n    for it in range(numItermax):\n        log_v_prev = log_v\n        log_u = log_a - _logsumexp(K + log_v[None, :], axis=1)\n        log_v = log_b - _logsumexp(K + log_u[:, None], axis=0)\n        if it % 10 == 9:\n            if np.max(np.abs(log_v - log_v_prev)) < stopThr:\n                break\n    \n    P = np.exp(log_u[:, None] + log_v[None, :] + K)\n    return P, it\n\ndef _logsumexp(a, axis=None):\n    a_max = np.max(a, axis=axis, keepdims=True)\n    return np.log(np.sum(np.exp(a - a_max), axis=axis)) + a_max.squeeze(axis=axis)\n\nt0 = time.perf_counter()\nP_np, iters = sinkhorn_log(a_w, b_w, C_scaled, reg)\nbc_np = float(np.sum(P_np * C)) / (ni + nj)\nt_np = time.perf_counter() - t0\nprint(f\\\"Numpy log: {t_np*1000:.1f}ms, iters={iters}, batchcost={bc_np:.6f}\\\")\nprint(f\\\"Batchcost diff: {abs(bc_pot - bc_np):.2e}\\\")\nprint(f\\\"P diff max: {np.abs(P_pot - P_np).max():.2e}\\\")\n\n# Try with float32\ndef sinkhorn_log32(a, b, C, reg, numItermax=10000, stopThr=1e-8):\n    a32 = a.astype(np.float32)\n    b32 = b.astype(np.float32)\n    C32 = C.astype(np.float32)\n    log_a = np.log(a32)\n    log_b = np.log(b32)\n    log_u = np.zeros_like(a32)\n    log_v = np.zeros_like(b32)\n    K = (-C32 / reg).astype(np.float32)\n    \n    for it in range(numItermax):\n        log_v_prev = log_v\n        log_u = log_a - _logsumexp(K + log_v[None, :], axis=1)\n        log_v = log_b - _logsumexp(K + log_u[:, None], axis=0)\n        if it % 10 == 9:\n            if np.max(np.abs(log_v - log_v_prev)) < stopThr:\n                break\n    \n    P = np.exp(log_u[:, None] + log_v[None, :] + K)\n    return P, it\n\nt0 = time.perf_counter()\nP_32, iters32 = sinkhorn_log32(a_w, b_w, C_scaled, reg)\nbc_32 = float(np.sum(P_32 * C)) / (ni + nj)\nt_32 = time.perf_counter() - t0\nprint(f\\\"Numpy log float32: {t_32*1000:.1f}ms, iters={iters32}, batchcost={bc_32:.6f}\\\")\nprint(f\\\"Batchcost diff: {abs(bc_pot - bc_32):.2e}\\\")\nEOF\ncd /tmp &&
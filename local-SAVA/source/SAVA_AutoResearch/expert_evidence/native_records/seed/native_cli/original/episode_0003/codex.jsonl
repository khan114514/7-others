{"type": "item.started", "item": {"id": "item_52", "type": "command_execution", "command": "/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np, time, torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\n\ntorch.set_num_threads(2)\nd = np.load('/workspace/environment/public_assets/dev/seed_101_uniform_labels.npz')\nx = d['x'].astype(np.float32)\ny = d['y'].astype(np.int64)\nr = d['r'].astype(np.float32)\nry = d['ry'].astype(np.int64)\n\nbatch_size = 1024\ntx = [np.arange(i, min(i+batch_size, len(x))) for i in range(0, len(x), batch_size)]\ntr = [np.arange(i, min(i+batch_size, len(r))) for i in range(0, len(r), batch_size)]\n\n# Compute W using GeomLoss\nxx = torch.tensor(np.concatenate([x[tx[0]], r[tr[0]]]), dtype=torch.float32)\nyy = np.concatenate([y[tx[0]], ry[tr[0]]+10])\nW = np.zeros((20,20), dtype=np.float32)\nloss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\nwith torch.inference_mode():\n    for i in range(20):\n        for j in range(i+1, 20):\n            W[i,j] = W[j,i] = float(loss(xx[yy==i], xx[yy==j]))\n\n# Test: compute Sinkhorn with PyTorch and get potentials\ndef cost_fn(z1, z2, W_tensor):\n    d = torch.cdist(z1[:, :, :-1], z2[:, :, :-1]).square() / 2\n    return d + W_tensor[z1[:, :, -1].long().unsqueeze(2), z2[:, :, -1].long().unsqueeze(1)] / 2\n\nW_tensor = torch.as_tensor(W)\nidx, jdx = tx[0], tr[0]\nz1 = torch.tensor(np.column_stack([x[idx], y[idx]]), dtype=torch.float32)[None]\nz2 = torch.tensor(np.column_stack([r[jdx], ry[jdx]+10]), dtype=torch.float32)[None]\n\n# GeomLoss potentials\npotential = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                       potentials=True, cost=lambda a,b: cost_fn(a,b,W_tensor), backend='tensorized')\nwith torch.inference_mode():\n    f_gl, g_gl = potential(z1, z2)\nf_gl = f_gl.numpy().ravel()\n\n# Custom PyTorch log-sinkhorn\nC = cost_fn(z1, z2, W_tensor).squeeze(0)\na_w = torch.ones(len(idx
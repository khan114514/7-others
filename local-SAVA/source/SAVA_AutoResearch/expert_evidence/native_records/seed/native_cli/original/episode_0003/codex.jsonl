{"type": "item.started", "item": {"id": "item_41", "type": "command_execution", "command": "/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np, time\nfrom scipy.spatial.distance import cdist\n\ndef _logsumexp(a, axis=None):\n    a_max = np.max(a, axis=axis, keepdims=True)\n    return np.log(np.sum(np.exp(a - a_max), axis=axis)) + a_max.squeeze(axis=axis)\n\ndef _sinkhorn_log(a, b, C, reg, numItermax=10000, stopThr=1e-10):\n    log_a = np.log(a)\n    log_b = np.log(b)\n    log_u = np.zeros_like(a)\n    log_v = np.zeros_like(b)\n    for i in range(numItermax):\n        log_v_prev = log_v\n        M = -C / reg + log_v[None, :]\n        log_u = log_a - _logsumexp(M, axis=1)\n        M = -C / reg + log_u[:, None]\n        log_v = log_b - _logsumexp(M, axis=0)\n        if i % 10 == 9:\n            if np.abs(log_v - log_v_prev).max() < stopThr:\n                break\n    P = np.exp(log_u[:, None] + log_v[None, :] - C / reg)\n    return P, log_u, log_v, i\n\n# Load data\nd = np.load('/workspace/environment/public_assets/dev/seed_101_uniform_labels.npz')\nx = d['x'].astype(np.float64)\ny = d['y'].astype(np.int64)\nr = d['r'].astype(np.float64)\nry = d['ry'].astype(np.int64)\n\n# Compute label cost first (simplified - just use first batch)\nbatch_size = 1024\ntx = [np.arange(i, min(i+batch_size, len(x))) for i in range(0, len(x), batch_size)]\ntr = [np.arange(i, min(i+batch_size, len(r))) for i in range(0, len(r), batch_size)]\n\n# Quick label cost with custom sinkhorn\nt0 = time.time()\nxx = np.concatenate([x[tx[0]], r[tr[0]]])\nyy = np.concatenate([y[tx[0]], ry[tr[0]]+10])\nW = np.zeros((20,20))\nreg_label = 0.1\nclass_samples = {}\nfor k in range(20):\n    mask = yy == k\n    if mask.any():\n        class_samples[k] = xx[mask]\nfor i in range(20):\n    for j in range(i+1, 20):\n        xi, xj = class_samples[i], class_samples[j]\n        C = cdist(xi, xj, 'sqeuclidean') / 2.0\n        C_max = C.max()\n        a = np.ones(len(xi)) / len(xi)\n      
{"type": "item.started", "item": {"id": "item_49", "type": "command_execution", "command": "/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np, time, torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\n\ntorch.set_num_threads(2)\nd = np.load('/workspace/environment/public_assets/dev/seed_101_uniform_labels.npz')\nx = d['x'].astype(np.float32)\ny = d['y'].astype(np.int64)\nr = d['r'].astype(np.float32)\nry = d['ry'].astype(np.int64)\n\nbatch_size = 1024\ntx = [np.arange(i, min(i+batch_size, len(x))) for i in range(0, len(x), batch_size)]\ntr = [np.arange(i, min(i+batch_size, len(r))) for i in range(0, len(r), batch_size)]\n\n# PyTorch-based label cost (faster than numpy loops for small sizes)\nxx = torch.tensor(np.concatenate([x[tx[0]], r[tr[0]]]), dtype=torch.float32)\nyy = np.concatenate([y[tx[0]], ry[tr[0]]+10])\n\n# Method: compute all pairwise class costs using batched PyTorch operations\nclass_tensors = []\nfor k in range(20):\n    class_tensors.append(xx[yy==k])\n\n# GeomLoss timing\nt0 = time.time()\nW_gl = np.zeros((20,20), dtype=np.float32)\nloss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\nwith torch.inference_mode():\n    for i in range(20):\n        for j in range(i+1, 20):\n            W_gl[i,j] = W_gl[j,i] = float(loss(class_tensors[i], class_tensors[j]))\nt1 = time.time()\nprint(f'GeomLoss label cost: {t1-t0:.3f}s')\n\n# POT numpy log-sinkhorn for label cost timing\ndef _logsumexp(a, axis=None):\n    a_max = np.max(a, axis=axis, keepdims=True)\n    return np.log(np.sum(np.exp(a - a_max), axis=axis)) + a_max.squeeze(axis=axis)\n\ndef _sinkhorn_log(a, b, C, reg, numItermax=1000, stopThr=1e-8):\n    log_a = np.log(a)\n    log_b = np.log(b)\n    log_u = np.zeros_like(a)\n    log_v = np.zeros_like(b)\n    for i in range(numItermax):\n        log_v_prev = log_v\n        M = -C / reg + log_v[None, :]\n        log_u = log_a - _logsumexp(M, axis=1)\n        M = -C / reg + log_u[:, None]\n        log_v = log_b - _logsumexp(M, axis=0)\n        if i % 5 == 4:\n            if np.abs(log_v - log_v_prev).max() < stopThr:\n                break\n    P = np.exp(log_u[:, None] + log_v[None, :] - C / reg)\n    return P\n\nt0 = time.time()\nW_np = np.zeros((20,20))\nreg = 0.1\nclass_np = [t.numpy() for t in class_tensors]\nfor i in range(20):\n    for j in range(i+1, 20):\n        xi, xj = class_np[i], class_np[j]\n        C = cdist(xi, xj, 'sqeuclidean') / 2.0\n        a = np.ones(len(xi)) / len(xi)\n        b = np.ones(len(xj)) / len(xj)\n        P = _sinkhorn_log(a, b, C, reg, numItermax=1000, stopThr=1e-8)\n        W_np[i,j] = W_np[j,i] = np.sum(P * C)\nt1 = time.time()\nprint(f'NumPy log-sinkhorn label cost: {t1-t0:.3f}s')\n\nprint('Max abs diff (W_gl vs W_np):', np.abs(W_gl - W_np).max())\nprint('Mean abs diff:', np.abs(W_gl - W_np).mean())\nprint('Correlation:', np.corrcoef(W_gl.ravel(), W_np.ravel())[0,1])\n\\\"\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

 for k in range(20):\n        mask = yy == k\n        if not mask.any():\n            raise ValueError('Initial batch lacks a label support')\n        class_samples.append(xx[mask])\n    \n    for i in range(20):\n        xi = class_samples[i]\n        a_w = np.ones(len(xi)) / len(xi)\n        for j in range(i + 1, 20):\n            xj = class_samples[j]\n            b_w = np.ones(len(xj)) / len(xj)\n            C = cdist(xi, xj, 'sqeuclidean') / 2.0\n            C_max = C.max()\n            P, f, g = _sinkhorn_log(a_w, b_w, C / C_max, reg / C_max,\n                                    numItermax=500, stopThr=1e-8)\n            # Sinkhorn divergence = sum(a * f) + sum(b * g), on scaled problem\n            # W[i,j] = C_max * (sum(a*f) + sum(b*g))\n            W[i, j] = W[j, i] = C_max * (np.sum(a_w * f) + np.sum(b_w * g))\n    return W.astype(np.float32)\n\ndef value(x, y, r, ry, seed=17, batch_size=1024):\n    x = np.asarray(x, np.float32); r = np.asarray(r, np.float32)\n    y = np.asarray(y, np.int64); ry = np.asarray(ry, np.int64)\n    tx = [np.arange(i, min(i + batch_size, len(x))) for i in range(0, len(x), batch_size)]\n    tr = [np.arange(i, min(i + batch_size, len(r))) for i in range(0, len(r), batch_size)]\n    \n    W = _label_cost_fast(x[tx[0]], y[tx[0]], r[tr[0]], ry[tr[0]])\n    W64 = W.astype(np.float64)\n    \n    F = {}\n    batchcost = np.zeros((len(tx), len(tr)), dtype=np.float64)\n    reg = 0.1\n    \n    for i, idx in enumerate(tx):\n        a = x[idx].astype(np.float64)\n        ya = y[idx]\n        a_w = np.ones(len(idx), dtype=np.float64) / len(idx)\n        for j, jdx in enumerate(tr):\n            b = r[jdx].astype(np.float64)\n            yb = ry[jdx]\n            b_w = np.ones(len(jdx), dtype=np.float64) / len(jdx)\n            \n            C_eucl = cdist(a, b, 'sqeuclidean') / 2.0\n            C_label = W64[ya[:, None], yb[None, :] + 10] / 2.0\n            C = C_eucl + C_label\n            \n            C_max = max(float(C.max()), 1e-12)\n            P, f, g = _sinkhorn_log(a_w, b_w, C / C_max, reg,\n                                    numItermax=10000, stopThr=1e-10)\n            \n            # Batch transport cost: unscaled\n            batchcost[i, j] = np.sum(P * (C / C_max)) * C_max / (len(idx) + len(jdx))\n            \n            # Potentials: need to scale back. f is for C/C_max with reg=0.1 (scaled)\n            # In canonical: potentials are computed on raw C with reg (blur\"'^2=0.1)\n            # We compute on C/C_max with reg=0.1 -> f in our space corresponds to f * C_max in real space\n            f_unscaled = f * C_max\n            F[i, j] = (f_unscaled - f_unscaled.mean()) * len(f_unscaled) / (len(f_unscaled) - 1)\n    \n    # Batch-level transport\n    n_tx = len(tx); n_tr = len(tr)\n    bc_max = max(float(batchcost.max()), 1e-12)\n    q_a = np.ones(n_tx) / n_tx\n    q_b = np.ones(n_tr) / n_tr\n    Q, f_q, g_q = _sinkhorn_log(q_a, q_b, batchcost / bc_max, 0.01,\n                                numItermax=10000, stopThr=1e-10)\n    \n    residual = max(np.max(np.abs(Q.sum(1) - 1.0/n_tx)),\n                   np.max(np.abs(Q.sum(0) - 1.0/n_tr)))\n    if residual > 1e-6:\n        raise ValueError(f'\"'Unconverged batch transport: {residual}')\n    \n    values = np.zeros(len(x), dtype=np.float64)\n    for i, idx in enumerate(tx):\n        values[idx] = sum(Q[i, j] * F[i, j] for j in range(n_tr))\n    return values.astype(np.float64)\nPYEOF\necho \\\"v3 fixed\\\"\"", "aggregated_output": "v3 fixed\n", "exit_code": 0, "status": "completed"}}

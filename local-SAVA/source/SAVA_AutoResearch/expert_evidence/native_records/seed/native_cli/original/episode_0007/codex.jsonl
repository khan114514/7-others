{"type": "item.started", "item": {"id": "item_67", "type": "command_execution", "command": "/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np, time\nfrom scipy.spatial.distance import cdist\n\ndef _logsumexp(a, axis=None):\n    a_max = np.max(a, axis=axis, keepdims=True)\n    return np.log(np.sum(np.exp(a - a_max), axis=axis)) + a_max.squeeze(axis=axis)\n\ndef _sinkhorn_log(a, b, C, reg, numItermax=10000, stopThr=1e-10):\n    a = np.asarray(a, dtype=np.float64)\n    b = np.asarray(b, dtype=np.float64)\n    C = np.asarray(C, dtype=np.float64)\n    \n    log_a = np.log(a)\n    log_b = np.log(b)\n    log_u = np.zeros_like(a)\n    log_v = np.zeros_like(b)\n    \n    for i in range(numItermax):\n        log_v_prev = log_v\n        M = -C / reg + log_v[None, :]\n        log_u = log_a - _logsumexp(M, axis=1)\n        M = -C / reg + log_u[:, None]\n        log_v = log_b - _logsumexp(M, axis=0)\n        \n        if i % 10 == 9:\n            if np.abs(log_v - log_v_prev).max() < stopThr:\n                print(f'  Converged at iter {i+1}')\n                break\n    \n    P = np.exp(log_u[:, None] + log_v[None, :] - C / reg)\n    f = reg * log_u\n    return P, f, i+1\n\n# Test with 1024x1024\nnp.random.seed(0)\nC = np.random.rand(1024, 1024).astype(np.float64) * 10\nC_max = C.max()\na = np.ones(1024) / 1024\nb = np.ones(1024) / 1024\nreg = 0.1\n\nt0 = time.perf_counter()\nP, f, n_iter = _sinkhorn_log(a, b, C/C_max, reg)\nt = time.perf_counter() - t0\nprint(f'Numpy log-domain 1024x1024: {t:.3f}s, {n_iter} iters')\n\n# Compare with POT\nimport ot\nt0 = time.perf_counter()\nP_ot = ot.sinkhorn(a, b, C/C_max, reg)\nt_ot = time.perf_counter() - t0\nprint(f'POT sinkhorn 1024x1024: {t_ot:.3f}s')\n\n# Compare with scaled reg (matching _label_cost_fast approach)\nt0 = time.perf_counter()\nP2, f2, n_iter2 = _sinkhorn_log(a, b, C/C_max, reg/C_max)\nt2 = time.perf_counter() - t0\nprint(f'Numpy log-domain (scaled reg) 1024x1024: {t2:.3f}s, {n_iter2} iters')\n\\\" 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

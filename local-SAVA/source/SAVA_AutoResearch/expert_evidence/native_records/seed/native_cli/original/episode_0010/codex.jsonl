]\n    eps = diameter ** p\n    while eps > target_eps * 1.0001:\n        eps_list.append(eps)\n        eps *= ratio\n    eps_list.append(target_eps)\n    \n    f, g, _ = sinkhorn_alt(a, b, C, eps_list[0], numItermax=10, stopThr=1e-4)\n    \n    for eps in eps_list[1:]:\n        f, g, _ = sinkhorn_alt(a, b, C, eps, numItermax=100, stopThr=1e-8)\n    \n    # Final refine\n    f, g, it = sinkhorn_alt(a, b, C, target_eps, numItermax=5000, stopThr=1e-10)\n    \n    return f, g, eps_list, it\n\n\nnp.random.seed(42)\nN, M = 500, 400\nx = np.random.randn(N, 10).astype(np.float64)\ny = np.random.randn(M, 10).astype(np.float64)\nya = np.random.randint(0, 5, N)\nyb = np.random.randint(0, 5, M)\nW = np.abs(np.random.randn(10, 10).astype(np.float64)) * 3\nW = (W + W.T) / 2\n\nC = cdist(x, y, 'sqeuclidean')/2 + W[ya[:,None], yb[None,:]+5]/2\nblur = np.sqrt(0.1)\neps = blur**2\n\n# GeomLoss\nz1 = torch.tensor(np.column_stack([x, ya]), dtype=torch.float32)[None]\nz2 = torch.tensor(np.column_stack([y, yb+5]), dtype=torch.float32)[None]\ndef cost_fn(z1, z2):\n    d = torch.cdist(z1[:,:,:-1], z2[:,:,:-1]).square()/2\n    return d + torch.as_tensor(W)[z1[:,:,-1].long().unsqueeze(2), z2[:,:,-1].long().unsqueeze(1)]/2\npot_fn = SamplesLoss('sinkhorn', p=2, blur=blur, debias=False, potentials=True, cost=cost_fn, backend='tensorized')\nwith torch.inference_mode():\n    f_gl, g_gl = pot_fn(z1, z2)\nf_gl = f_gl.numpy().ravel().astype(np.float64)\nf_gl_norm = (f_gl - f_gl.mean()) * len(f_gl) / (len(f_gl) - 1)\n\n# Test: direct alternating Sinkhorn at target eps\nt0 = time.time()\nf_alt, g_alt, it = sinkhorn_alt(np.ones(N)/N, np.ones(M)/M, C, eps, numItermax=10000, stopThr=1e-12)\nt1 = time.time()\nf_alt_norm = (f_alt - f_alt.mean()) * len(f_alt) / (len(f_alt) - 1)\ncorr = np.corrcoef(f_gl_norm, f_alt_norm)[0, 1]\nprint(f\\\"Direct alt Sinkhorn (target eps={eps:.4f}): time={t1-t0:.4f}s iters={it} corr={corr:.10f}\\\")\nprint(f\\\"  f GL range: [{f_gl.min():.4f}, {f_gl.max():.4f}]\\\")\nprint(
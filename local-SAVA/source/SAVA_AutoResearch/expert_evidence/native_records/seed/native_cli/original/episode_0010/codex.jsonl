{"type": "item.started", "item": {"id": "item_55", "type": "command_execution", "command": "/bin/sh -lc \"cd /workspace/solution && timeout 30 python -c \\\"\nimport numpy as np\nimport torch\nimport ot\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nimport time\n\nnp.random.seed(42)\nN, M = 50, 40\na = np.random.randn(N, 10).astype(np.float32)\nb = np.random.randn(M, 10).astype(np.float32)\nya = np.random.randint(0, 3, N)\nyb = np.random.randint(0, 3, M)\nW = np.abs(np.random.randn(6, 6).astype(np.float32)) * 2\nW = (W + W.T) / 2\n\nC = cdist(a, b, 'sqeuclidean')/2 + W[ya[:,None], yb[None,:]+3]/2\nC_max = C.max()\nreg = 0.1\n\n# 1. Canonical batch cost: POT with C/C_max, reg=0.1\nP1 = ot.sinkhorn(ot.unif(N), ot.unif(M), C/C_max, reg)\ncost1 = np.sum(P1 * C)\nprint(f'POT scaled: batch_cost/(N+M) = {cost1/(N+M):.6f}')\n\n# 2. GeomLoss potentials (unscaled cost)\nz1 = torch.tensor(np.column_stack([a, ya]), dtype=torch.float32)[None]\nz2 = torch.tensor(np.column_stack([b, yb+3]), dtype=torch.float32)[None]\ndef cost_fn(z1, z2):\n    d = torch.cdist(z1[:,:,:-1], z2[:,:,:-1]).square()/2\n    return d + torch.as_tensor(W)[z1[:,:,-1].long().unsqueeze(2), z2[:,:,-1].long().unsqueeze(1)]/2\npot_fn = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, potentials=True, cost=cost_fn, backend='tensorized')\nwith torch.inference_mode():\n    f_gl, g_gl = pot_fn(z1, z2)\nf_gl = f_gl.numpy().ravel()\ng_gl = g_gl.numpy().ravel()\nprint(f'GeomLoss f range: [{f_gl.min():.4f}, {f_gl.max():.4f}]')\n\n# Sinkhorn divergence from GeomLoss potentials\ndiv_gl = f_gl.mean() + g_gl.mean()\nprint(f'GeomLoss dual div: {div_gl:.6f}')\n\n# What OT problem does GeomLoss solve?\n# cost = ||x-y||\"'^2/2 + label_cost/2, reg = blur''^2 = 0.1\nP2 = ot.sinkhorn(ot.unif(N), ot.unif(M), C, reg)\ncost2 = np.sum(P2 * C)\nprint(f'\"'POT unscaled (C, reg=0.1): cost={cost2:.6f}')\nprint(f'  ratio div_gl/cost2 = {div_gl/cost2:.4f}')\n\n# Let's try to recover f from POT unscaled\n# Dual potentials: f_i = -reg * log(u_i), g_j = -reg * log(v_j) where P = diag(u) K diag(v)\n# Or P = exp((f + g - C)/reg) so a = P.sum(1), b = P.sum(0)\n# Actually: Sinkhorn in standard form: P_ij = a_i * b_j * exp((f_i + g_j - C_ij)/reg)\n# Wait, different conventions. Let me just check.\n# POT sinkhorn: P = diag(u)  @  K  @  diag(v), K = exp(-C/reg)\n# u = a / (K v), v = b / (K\"'^T u)\n# Then OT = sum P * C\n# Dual potentials: f = reg * log(u), g = reg * log(v)\n# OT_cost = sum a_i f_i + sum b_j g_j\n\nu, v = ot.sinkhorn(ot.unif(N), ot.unif(M), C, reg, log=True)\n# Check\nK = np.exp(-C / reg)\nP_check = u[:, None] * K * v[None, :]\nprint(f'\"'POT log u,v: P check max diff: {np.abs(P_check - P2).max():.6e}')\n\n# Dual potentials from POT (scaling=u, v)\n# f_pot = reg * log(u), g_pot = reg * log(v)\nf_pot = reg * np.log(u)\ng_pot = reg * np.log(v)\ndiv_pot = np.sum(ot.unif(N) * f_pot) + np.sum(ot.unif(M) * g_pot)\nprint(f'POT dual div: {div_pot:.6f}')\nprint(f'POT cost from primal: {cost2:.6f}')\nprint(f'GeomLoss vs POT dual: {div_gl:.6f} vs {div_pot:.6f}')\n\n# f_pot vs f_gl\nf_gl_norm = (f_gl - f_gl.mean()) * len(f_gl) / (len(f_gl) - 1)\nf_pot_norm = (f_pot - f_pot.mean()) * len(f_pot) / (len(f_pot) - 1)\nprint(f'Correlation of f_gl vs f_pot (normalized): {np.corrcoef(f_gl_norm, f_pot_norm)[0,1]:.6f}')\nprint(f'f_gl_norm range: [{f_gl_norm.min():.4f}, {f_gl_norm.max():.4f}]')\nprint(f'f_pot_norm range: [{f_pot_norm.min():.4f}, {f_pot_norm.max():.4f}]')\n\\\"\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

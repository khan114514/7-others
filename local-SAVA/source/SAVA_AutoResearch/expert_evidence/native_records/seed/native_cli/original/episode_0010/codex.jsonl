en(idx)\n        for j, jdx in enumerate(tr):\n            b = r[jdx].astype(np.float64)\n            yb = ry[jdx]\n            b_w = np.ones(len(jdx), dtype=np.float64) / len(jdx)\n            C_eucl = cdist(a, b, 'sqeuclidean') / 2.0\n            C_label = W64[ya[:, None], yb[None, :] + 10] / 2.0\n            C = C_eucl + C_label\n            if style == 'geomloss_match':\n                f, g = _sinkhorn_sym_eps(a_w, b_w, C, blur=blur, p=2, scaling=0.5, n_inner=1)\n                P = a_w[:, None] * b_w[None, :] * np.exp((f[:, None] + g[None, :] - C) / reg)\n            elif style == 'converged':\n                P, f, g, _ = _sinkhorn_alt(a_w, b_w, C, reg, numItermax=5000, stopThr=1e-10)\n            elif style == 'converged_loose':\n                P, f, g, _ = _sinkhorn_alt(a_w, b_w, C, reg, numItermax=500, stopThr=1e-6)\n            batchcost[i, j] = np.sum(P * C) / (len(idx) + len(jdx))\n            f_norm = (f - f.mean()) * len(f) / (len(f) - 1)\n            F[i, j] = f_norm\n    n_tx = len(tx); n_tr = len(tr)\n    bc_max = max(float(batchcost.max()), 1e-12)\n    q_a = np.ones(n_tx) / n_tx\n    q_b = np.ones(n_tr) / n_tr\n    Q, _, _, _ = _sinkhorn_alt(q_a, q_b, batchcost / bc_max, 0.01,\n                               numItermax=10000, stopThr=1e-10)\n    residual = max(np.max(np.abs(Q.sum(1) - 1.0/n_tx)),\n                   np.max(np.abs(Q.sum(0) - 1.0/n_tr)))\n    if residual > 1e-6:\n        raise ValueError(f'Unconverged batch transport: {residual}')\n    values = np.zeros(len(x), dtype=np.float64)\n    for i, idx in enumerate(tx):\n        values[idx] = sum(Q[i, j] * F[i, j] for j in range(n_tr))\n    return values\n\nd = np.load('/workspace/environment/public_assets/dev/seed_101_uniform_labels.npz')\nx, y, r, ry, seed = d['x'], d['y'], d['r'], d['ry'], int(d['seed'])\n\nsys.path.insert(0, '/workspace/solution')\nfrom method import value as value_canonical\nt0 = time.time()\nv_canon = value_canonical(x, y, r, ry, seed)\nt_canon = time.time() - t0\nprint(f'Canonical: {t_canon:.3f}s')\n\nfor style in ['geomloss_match', 'converged_loose', 'converged']:\n    t0 = time.time()\n    v_fast = value_fast(x, y, r, ry, seed, style=style)\n    t_fast = time.time() - t0\n    rmse = np.sqrt(np.mean((v_fast - v_canon)**2))\n    nrmse = rmse / np.std(v_canon)\n    from scipy.stats import spearmanr\n    rho, _ = spearmanr(v_fast, v_canon)\n    N = len(v_fast)\n    topq = N // 4\n    idx_f = np.argsort(-v_fast, kind='stable')[:topq]\n    idx_c = np.argsort(-v_canon, kind='stable')[:topq]\n    overlap = len(np.intersect1d(idx_f, idx_c)) / topq\n    print(f'{style:20s}: {t_fast:.3f}s (speedup {t_canon/t_fast:.2f}x)  NRMSE={nrmse:.6f} Spearman={rho:.8f} Overlap={overlap:.4f}')\nPYEOF\ntimeout 120 python /tmp/test_full_case2.py\"", "aggregated_output": "", "exit_code": 124, "status": "failed"}}

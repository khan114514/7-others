{"type": "item.started", "item": {"id": "item_76", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/test_sinkhorn_eps.py << 'EOF'\nimport numpy as np\nimport torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nimport time\n\ndef _logsumexp(a, axis=None):\n    a_max = np.max(a, axis=axis, keepdims=True)\n    return np.log(np.sum(np.exp(a - a_max), axis=axis)) + a_max.squeeze(axis=axis)\n\ndef sinkhorn_eps_scaling(a, b, C, blur, p=2, scaling=0.5, debias=False, diameter=None,\n                         numinner=1, stop_thr=1e-10):\n    \\\"\\\"\\\"Epsilon-scaling Sinkhorn matching GeomLoss conventions.\n    C = cost matrix (1/p * ||x-y||\"'^p + label_cost/2 in our case)\n    blur = target blur (in same units as input space for p=2)\n    Target eps = blur''^p\n    \"\"\"\n    a = np.asarray(a, dtype=np.float64)\n    b = np.asarray(b, dtype=np.float64)\n    C = np.asarray(C, dtype=np.float64)\n    N, M = C.shape\n    \n    if diameter is None:\n        diameter = np.sqrt(C.max() * p)  # rough upper bound\n    \n    # Build eps_list: start from diameter''^p, divide by scaling''^p each step, end at blur''^p\n    eps_list = []\n    eps = diameter ** p\n    target_eps = blur ** p\n    ratio = scaling ** p\n    while eps > target_eps * 1.0001:\n        eps_list.append(eps)\n        eps *= ratio\n    eps_list.append(target_eps)\n    \n    log_a = np.log(a)\n    log_b = np.log(b)\n    \n    # Initialize dual potentials\n    # At eps=large, f ≈ -eps*log(sum_j b_j exp(-C_ij/eps)) ≈ -eps*log(1) = 0\n    # Actually f_ba = -eps * logsumexp_j(log_b + (-C_xy/eps)) = -eps*log(1) = 0 when eps large\n    f_ba = np.zeros(N, dtype=np.float64)\n    g_ab = np.zeros(M, dtype=np.float64)\n    \n    for eps in eps_list:\n        for _ in range(numinner):\n            # f update: f_i = -eps * logsumexp_j(log_b_j + g_j/eps - C_ij/eps)\n            f_ba = -eps * _logsumexp(log_b[None, :] + g_ab[None, :] / eps - C / eps, axis=1)\n            # g update: g_j = -eps * logsumexp_i(log_a_i + f_i/eps - C_ij/eps)\n            g_ab = -eps * _logsumexp(log_a[:, None] + f_ba[:, None] / eps - C / eps, axis=0)\n    \n    # Check convergence with one final iteration\n    f_prev = f_ba.copy()\n    f_ba = -eps * _logsumexp(log_b[None, :] + g_ab[None, :] / eps - C / eps, axis=1)\n    g_ab = -eps * _logsumexp(log_a[:, None] + f_ba[:, None] / eps - C / eps, axis=0)\n    f_change = np.abs(f_ba - f_prev).max()\n    \n    return f_ba, g_ab, eps_list, f_change\n\n\nnp.random.seed(42)\nN, M = 500, 400\nx = np.random.randn(N, 10).astype(np.float64)\ny = np.random.randn(M, 10).astype(np.float64)\nya = np.random.randint(0, 5, N)\nyb = np.random.randint(0, 5, M)\nW = np.abs(np.random.randn(10, 10).astype(np.float64)) * 3\nW = (W + W.T) / 2\n\nC = cdist(x, y, '\"'sqeuclidean')/2 + W[ya[:,None], yb[None,:]+5]/2\nblur = np.sqrt(0.1)\n\n# GeomLoss with custom cost\nz1 = torch.tensor(np.column_stack([x, ya]), dtype=torch.float32)[None]\nz2 = torch.tensor(np.column_stack([y, yb+5]), dtype=torch.float32)[None]\ndef cost_fn(z1, z2):\n    d = torch.cdist(z1[:,:,:-1], z2[:,:,:-1]).square()/2\n    return d + torch.as_tensor(W)[z1[:,:,-1].long().unsqueeze(2), z2[:,:,-1].long().unsqueeze(1)]/2\npot_fn = SamplesLoss('sinkhorn', p=2, blur=blur, debias=False, potentials=True, cost=cost_fn, backend='tensorized')\nwith torch.inference_mode():\n    f_gl, g_gl = pot_fn(z1, z2)\nf_gl = f_gl.numpy().ravel().astype(np.float64)\ng_gl = g_gl.numpy().ravel().astype(np.float64)\n\n# Our epsilon-scaling Sinkhorn\nt0 = time.time()\nf_np, g_np, eps_list, f_change = sinkhorn_eps_scaling(\n    np.ones(N)/N, np.ones(M)/M, C, blur=blur, p=2, scaling=0.5, debias=False,\n    diameter=None, numinner=1)\nt1 = time.time()\n\nprint(f\\\"Eps list: {[f'{e:.4f}' for e in eps_list]} ({len(eps_list)} steps)\\\")\nprint(f\\\"Our time: {t1-t0:.4f}s, last change: {f_change:.2e}\\\")\nprint(f\\\"GeomLoss dual div: {f_gl.mean() + g_gl.mean():.6f}\\\")\nprint(f\\\"Our dual div: {f_np.mean() + g_np.mean():.6f}\\\")\n\nf_gl_norm = (f_gl - f_gl.mean()) * len(f_gl) / (len(f_gl) - 1)\nf_np_norm = (f_np - f_np.mean()) * len(f_np) / (len(f_np) - 1)\ncorr = np.corrcoef(f_gl_norm, f_np_norm)[0, 1]\nprint(f\\\"f (normalized) correlation: {corr:.8f}\\\")\nprint(f\\\"f norm max abs diff: {np.abs(f_gl_norm - f_np_norm).max():.6f}\\\")\nprint(f\\\"f range GL: [{f_gl.min():.4f}, {f_gl.max():.4f}]\\\")\nprint(f\\\"f range NP: [{f_np.min():.4f}, {f_np.max():.4f}]\\\")\n\n# Test quality with more inner iterations\nfor numinner in [1, 2, 5, 10]:\n    f_np, g_np, eps_list, f_change = sinkhorn_eps_scaling(\n        np.ones(N)/N, np.ones(M)/M, C, blur=blur, p=2, scaling=0.5, numinner=numinner)\n    f_np_norm = (f_np - f_np.mean()) * len(f_np) / (len(f_np) - 1)\n    corr = np.corrcoef(f_gl_norm, f_np_norm)[0, 1]\n    maxdiff = np.abs(f_gl_norm - f_np_norm).max()\n    print(f\\\"  numinner={numinner}: corr={corr:.8f} maxdiff={maxdiff:.6f} change={f_change:.2e}\\\")\nEOF\ntimeout 30 python /tmp/test_sinkhorn_eps.py\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

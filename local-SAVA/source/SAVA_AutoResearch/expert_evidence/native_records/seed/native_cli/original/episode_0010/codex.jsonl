{"type": "item.started", "item": {"id": "item_101", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/test_norm.py << 'EOF'\nimport numpy as np\nimport torch\nimport ot\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\n\nnp.random.seed(42)\nN, M = 30, 25\nx = np.random.randn(N, 3).astype(np.float64)\ny = np.random.randn(M, 3).astype(np.float64)\n\nC = cdist(x, y, 'sqeuclidean') / 2.0\neps = 0.1\n\n# POT Sinkhorn\nP_pot = ot.sinkhorn(np.ones(N)/N, np.ones(M)/M, C, eps, numItermax=10000, stopThr=1e-12)\n\n# Recover POT potentials (standard: P = diag(u) K diag(v), K = exp(-C/eps))\nK = np.exp(-C/eps)\nu = np.ones(N)/N\nv = np.ones(M)/M\nfor _ in range(5000):\n    u = np.ones(N)/N / (K  @  v)\n    v = np.ones(M)/M / (K.T  @  u)\nP_check = u[:, None] * K * v[None, :]\nprint(f\\\"POT P check: {np.abs(P_pot - P_check).max():.2e}\\\")\n\nf_pot = eps * np.log(u)\ng_pot = eps * np.log(v)\nprint(f\\\"POT f range: [{f_pot.min():.6f}, {f_pot.max():.6f}]\\\")\n\n# GeomLoss\nblur = np.sqrt(eps)\nxa = torch.tensor(x, dtype=torch.float64)[None]\nyb = torch.tensor(y, dtype=torch.float64)[None]\npot_fn = SamplesLoss('sinkhorn', p=2, blur=blur, debias=False, potentials=True, backend='tensorized')\nwith torch.inference_mode():\n    f_gl, g_gl = pot_fn(xa, yb)\nf_gl = f_gl.numpy().ravel()\ng_gl = g_gl.numpy().ravel()\nprint(f\\\"GL  f range: [{f_gl.min():.6f}, {f_gl.max():.6f}]\\\")\n\n# Normalize both (mean center)\nf_pot_n = f_pot - f_pot.mean()\nf_gl_n = f_gl - f_gl.mean()\nprint(f\\\"\\\\nNormalized comparison:\\\")\nprint(f\\\"  max abs diff: {np.abs(f_pot_n - f_gl_n).max():.6f}\\\")\nprint(f\\\"  correlation: {np.corrcoef(f_pot_n, f_gl_n)[0,1]:.10f}\\\")\n\n# What's the difference?\nprint(f\\\"\\\\nDifferences:\\\")\nprint(f\\\"  f_pot_n range: [{f_pot_n.min():.6f}, {f_pot_n.max():.6f}]\\\")\nprint(f\\\"  f_gl_n  range: [{f_gl_n.min():.6f}, {f_gl_n.max():.6f}]\\\")\nprint(f\\\"  ratio f_gl_n / f_pot_n: {(f_gl_n/f_pot_n).mean():.6f} (mean), {(f_gl_n/f_pot_n)[~np.isnan(f_gl_n/f_pot_n)][:5]}\\\")\n\n# Maybe GeomLoss has a different normalization (uses sum-to-1 weights in a different way)\n# Try: f_gl = f_pot + c (constant offset, gauge freedom)\n# We saw f_pot vs f_alt have corr=1 and diff=0.34 constant\n# Now: what's the relation between GL and POT?\n\n# Try: maybe GeomLoss uses log(weights) differently\n# GeomLoss: softmin(eps, C, log_b + g/eps) - if b is uniform 1/M, log_b = -log(M)\n# Standard Sinkhorn: same thing\n# Let me check directly with the softmin formula\n\n# Compute GeomLoss-like softmin iteration manually in numpy\ndef _logsumexp(a, axis=None):\n    a_max = np.max(a, axis=axis, keepdims=True)\n    return np.log(np.sum(np.exp(a - a_max), axis=axis)) + a_max.squeeze(axis=axis)\n\ndef softmin(eps, C, h):\n    return -eps * _logsumexp(h[None, :] - C/eps, axis=1)\n\n# Simulate 1-step GeomLoss-style\nlog_a = np.log(np.ones(N)/N)\nlog_b = np.log(np.ones(M)/M)\n\n# Initial step\neps0 = 50  # large\nf = softmin(eps0, C, log_b)\ng = softmin(eps0, C.T, log_a)\nprint(f\\\"\\\\nInitial (eps={eps0}): f mean={f.mean():.6f}, g mean={g.mean():.6f}\\\")\n\n# Sinkhorn loop with epsilon scaling\nfor e in [20, 10, 5, 2, 1, 0.5, 0.2, eps]:\n    for _ in range(1):\n        ft = softmin(e, C, log_b + g/e)\n        gt = softmin(e, C.T, log_a + f/e)\n        f = 0.5*(f + ft)\n        g = 0.5*(g + gt)\n    P = (np.ones(N)/N)[:,None]*(np.ones(M)/M)[None,:]*np.exp((f[:,None]+g[None,:]-C)/e)\n    res = np.abs(P.sum(1) - 1/N).max() / (1/N)\n    print(f\\\"  eps={e:.2f}: f mean={f.mean():.6f}, row_res={res:.2e}\\\")\n\nprint(f\\\"\\\\nFinal f range: [{f.min():.6f}, {f.max():.6f}]\\\")\nf_n = f - f.mean()\nprint(f\\\"  corr with POT: {np.corrcoef(f_pot_n, f_n)[0,1]:.10f}\\\")\nprint(f\\\"  corr with GL:  {np.corrcoef(f_gl_n, f_n)[0,1]:.10f}\\\")\nEOF\ntimeout 30 python /tmp/test_norm.py\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

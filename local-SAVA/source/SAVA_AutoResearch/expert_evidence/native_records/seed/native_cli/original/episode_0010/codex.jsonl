{"type": "item.completed", "item": {"id": "item_91", "type": "reasoning", "text": "The correlation of 0.96 with residual 1e-12 indicates my Sinkhorn implementation diverges from GeomLoss's results,which is likely caused by GeomLoss' epsilon-scaling annealing approach. My symmetric epsilon-scaling version has a much higher correlation of 0.99, but I found its performance drops with more iterations, and there's a fundamental bug in the symmetric implementation as a single iteration per epsilon already yields the best result.\n\nI've located two key bugs in the Sinkhorn implementation: one is the incorrect softmin function used, and the other is the wrong handling of log-weight offsets. I will re-derive the softmin update from GeomLoss to fix these issues.\n\nLog weights will be the code baseline with potentials added on top.\n"}}
{"type": "item.started", "item": {"id": "item_92", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/test_correct_sym.py << 'EOF'\nimport numpy as np\nimport torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nimport time\n\ndef _logsumexp(a, axis=None):\n    a_max = np.max(a, axis=axis, keepdims=True)\n    return np.log(np.sum(np.exp(a - a_max), axis=axis)) + a_max.squeeze(axis=axis)\n\ndef _softmin(eps, C, h):\n    \\\"\\\"\\\"f_i = -eps * logsumexp_j (h_j - C_ij / eps)\\\"\\\"\\\"\n    return -eps * _logsumexp(h[None, :] - C / eps, axis=1)\n\ndef sinkhorn_sym(a, b, C, blur, p=2, scaling=0.5, n_inner=1):\n    \\\"\\\"\\\"Symmetric epsilon-scaling Sinkhorn matching GeomLoss exactly.\n    GeomLoss convention: softmin(eps, C, h) returns:\n        f_i = -eps * logsumexp_j (h_j - C_ij/eps)\n    Initial: g_ab = softmin(eps, C\"'^T, a_log)\n             f_ba = softmin(eps, C,   b_log)\n    Iterate: ft = softmin(eps, C,   b_log + g_ab/eps)\n             gt = softmin(eps, C''^T, a_log + f_ba/eps)\n             f = 0.5*(f + ft), g = 0.5*(g + gt)\n    \"\"\"\n    a = np.asarray(a, dtype=np.float64)\n    b = np.asarray(b, dtype=np.float64)\n    C = np.asarray(C, dtype=np.float64)\n    N, M = C.shape\n    \n    log_a = np.log(a)\n    log_b = np.log(b)\n    \n    diameter = np.sqrt(C.max() * p)\n    target_eps = blur ** p\n    ratio = scaling ** p\n    eps_list = []\n    eps = diameter ** p\n    while eps > target_eps * 1.0001:\n        eps_list.append(eps)\n        eps *= ratio\n    eps_list.append(target_eps)\n    \n    # Initial with first eps\n    eps0 = eps_list[0]\n    f = _softmin(eps0, C, log_b)\n    g = _softmin(eps0, C.T, log_a)\n    \n    for eps in eps_list:\n        for _ in range(n_inner):\n            ft = _softmin(eps, C, log_b + g / eps)\n            gt = _softmin(eps, C.T, log_a + f / eps)\n            f = 0.5 * (f + ft)\n            g = 0.5 * (g + gt)\n    \n    return f, g, eps_list\n\n\nnp.random.seed(42)\nN, M = 500, 400\nx = np.random.randn(N, 3).astype(np.float64)\ny = np.random.randn(M, 3).astype(np.float64)\nC = cdist(x, y, '\"'sqeuclidean') / 2.0\nblur = np.sqrt(0.1)\n\n# GeomLoss default\nxa = torch.tensor(x, dtype=torch.float32)[None]\nyb = torch.tensor(y, dtype=torch.float32)[None]\npot_fn = SamplesLoss('sinkhorn', p=2, blur=blur, debias=False, potentials=True, backend='tensorized')\nwith torch.inference_mode():\n    f_gl, g_gl = pot_fn(xa, yb)\nf_gl = f_gl.numpy().ravel().astype(np.float64)\ng_gl = g_gl.numpy().ravel().astype(np.float64)\n\n# Our symmetric Sinkhorn with epsilon scaling\nprint(\\\"Testing symmetric epsilon-scaling Sinkhorn vs GeomLoss:\\\")\nprint(f\\\"GeomLoss div: {f_gl.mean() + g_gl.mean():.6f}\\\")\nfor n_inner in [1, 2, 3, 5, 10, 20, 50]:\n    t0 = time.time()\n    f, g, eps_list = sinkhorn_sym(np.ones(N)/N, np.ones(M)/M, C, blur=blur, p=2, scaling=0.5, n_inner=n_inner)\n    t = time.time() - t0\n    \n    f_norm = (f - f.mean()) * len(f) / (len(f) - 1)\n    f_gl_norm = (f_gl - f_gl.mean()) * len(f_gl) / (len(f_gl) - 1)\n    corr = np.corrcoef(f_norm, f_gl_norm)[0, 1]\n    div = f.mean() + g.mean()\n    \n    # Convergence: compute P and check marginals\n    eps = blur**2\n    P = (np.ones(N)/N)[:, None] * (np.ones(M)/M)[None, :] * np.exp((f[:, None] + g[None, :] - C) / eps)\n    row_res = np.abs(P.sum(1) - 1/N).max() / (1/N)\n    col_res = np.abs(P.sum(0) - 1/M).max() / (1/M)\n    \n    print(f\\\"  n_inner={n_inner:3d}: time={t:.4f}s corr={corr:.10f} div={div:.6f} row_res={row_res:.2e} col_res={col_res:.2e}\\\")\n\n# Also try alternating Sinkhorn starting from high eps\nprint(\\\"\\\\nAlternating Sinkhorn (fixed eps=blur\"'^2):\")\ndef sinkhorn_alt(a, b, C, eps, numItermax=5000, stopThr=1e-12):\n    log_a = np.log(a); log_b = np.log(b)\n    N, M = C.shape\n    f = np.zeros(N); g = np.zeros(M)\n    for i in range(numItermax):\n        g_prev = g\n        f = -eps * _logsumexp(log_b[None, :] + g[None, :]/eps - C/eps, axis=1)\n        g = -eps * _logsumexp(log_a[:, None] + f[:, None]/eps - C/eps, axis=0)\n        if i % 10 == 9 and np.abs(g - g_prev).max() < stopThr:\n            break\n    return f, g, i+1\n\nfor it in [10, 50, 100, 500, 1000]:\n    t0 = time.time()\n    f, g, nit = sinkhorn_alt(np.ones(N)/N, np.ones(M)/M, C, blur**2, numItermax=it, stopThr=1e-14)\n    t = time.time() - t0\n    f_norm = (f - f.mean()) * len(f) / (len(f) - 1)\n    corr = np.corrcoef(f_norm, f_gl_norm)[0, 1]\n    P = (np.ones(N)/N)[:, None] * (np.ones(M)/M)[None, :] * np.exp((f[:, None] + g[None, :] - C) / (blur**2))\n    row_res = np.abs(P.sum(1) - 1/N).max() / (1/N)\n    print(f\"  iters={nit:4d}: time={t:.4f}s corr={corr:.10f} row_res={row_res:.2e}\")\nEOF\ntimeout 60 python /tmp/test_correct_sym.py'", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

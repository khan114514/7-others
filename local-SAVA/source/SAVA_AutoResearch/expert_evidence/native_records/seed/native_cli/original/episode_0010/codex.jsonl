{"type": "item.started", "item": {"id": "item_104", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/test_full_case.py << 'EOF'\nimport numpy as np\nimport sys\nimport time\nfrom scipy.spatial.distance import cdist\n\ndef _logsumexp(a, axis=None):\n    a_max = np.max(a, axis=axis, keepdims=True)\n    return np.log(np.sum(np.exp(a - a_max), axis=axis)) + a_max.squeeze(axis=axis)\n\ndef _softmin(eps, C, h):\n    return -eps * _logsumexp(h[None, :] - C/eps, axis=1)\n\ndef _sinkhorn_sym_eps(a, b, C, blur, p=2, scaling=0.5, n_inner=1):\n    \\\"\\\"\\\"Symmetric epsilon-scaling Sinkhorn matching GeomLoss style.\\\"\\\"\\\"\n    C = np.asarray(C, dtype=np.float64)\n    N, M = C.shape\n    log_a = np.log(a); log_b = np.log(b)\n    \n    diameter = np.sqrt(C.max() * p)\n    target_eps = blur ** p\n    ratio = scaling ** p\n    eps_list = []\n    eps = diameter ** p\n    while eps > target_eps * 1.0001:\n        eps_list.append(eps)\n        eps *= ratio\n    eps_list.append(target_eps)\n    \n    eps0 = eps_list[0]\n    f = _softmin(eps0, C, log_b)\n    g = _softmin(eps0, C.T, log_a)\n    \n    for eps in eps_list:\n        for _ in range(n_inner):\n            ft = _softmin(eps, C, log_b + g/eps)\n            gt = _softmin(eps, C.T, log_a + f/eps)\n            f = 0.5 * (f + ft)\n            g = 0.5 * (g + gt)\n    \n    return f, g\n\ndef _sinkhorn_alt(a, b, C, eps, numItermax=5000, stopThr=1e-10):\n    \\\"\\\"\\\"Alternating log-domain Sinkhorn, fully converged.\\\"\\\"\\\"\n    C = np.asarray(C, dtype=np.float64)\n    N, M = C.shape\n    log_a = np.log(a); log_b = np.log(b)\n    f = np.zeros(N); g = np.zeros(M)\n    for i in range(numItermax):\n        g_prev = g\n        f = -eps * _logsumexp(log_b[None, :] + g[None, :]/eps - C/eps, axis=1)\n        g = -eps * _logsumexp(log_a[:, None] + f[:, None]/eps - C/eps, axis=0)\n        if i % 10 == 9 and np.abs(g - g_prev).max() < stopThr:\n            break\n    return f, g, i+1\n\ndef _label_cost_fast(x, y, r, ry, blur=np.sqrt(0.1)):\n    \\\"\\\"\\\"Compute label cost matrix using numpy Sinkhorn (matching GeomLoss style).\\\"\\\"\\\"\n    xx = np.concatenate([x, r])\n    yy = np.concatenate([y, ry + 10])\n    W = np.zeros((20, 20), dtype=np.float64)\n    reg = blur**2\n    \n    class_samples = []\n    for k in range(20):\n        mask = yy == k\n        if not mask.any():\n            raise ValueError('Initial batch lacks a label support')\n        class_samples.append(xx[mask])\n    \n    for i in range(20):\n        xi = class_samples[i].astype(np.float64)\n        a_w = np.ones(len(xi)) / len(xi)\n        for j in range(i + 1, 20):\n            xj = class_samples[j].astype(np.float64)\n            b_w = np.ones(len(xj)) / len(xj)\n            C = cdist(xi, xj, 'sqeuclidean') / 2.0\n            # Use epsilon-scaling symmetric Sinkhorn to match GeomLoss\n            f, g = _sinkhorn_sym_eps(a_w, b_w, C, blur=blur, p=2, scaling=0.5, n_inner=1)\n            W[i, j] = W[j, i] = f.mean() + g.mean()\n    return W.astype(np.float32)\n\ndef value_fast(x, y, r, ry, seed=17, batch_size=1024, style='geomloss_match'):\n    x = np.asarray(x, np.float32); r = np.asarray(r, np.float32)\n    y = np.asarray(y, np.int64); ry = np.asarray(ry, np.int64)\n    tx = [np.arange(i, min(i + batch_size, len(x))) for i in range(0, len(x), batch_size)]\n    tr = [np.arange(i, min(i + batch_size, len(r))) for i in range(0, len(r), batch_size)]\n    \n    blur = np.sqrt(0.1)\n    reg = blur**2\n    \n    W = _label_cost_fast(x[tx[0]], y[tx[0]], r[tr[0]], ry[tr[0]], blur=blur)\n    W64 = W.astype(np.float64)\n    \n    F = {}\n    batchcost = np.zeros((len(tx), len(tr)), dtype=np.float64)\n    \n    for i, idx in enumerate(tx):\n        a = x[idx].astype(np.float64)\n        ya = y[idx]\n        a_w = np.ones(len(idx), dtype=np.float64) / len(idx)\n        for j, jdx in enumerate(tr):\n            b = r[jdx].astype(np.float64)\n            yb = ry[jdx]\n            b_w = np.ones(len(jdx), dtype=np.float64) / len(jdx)\n            \n            C_eucl = cdist(a, b, 'sqeuclidean') / 2.0\n            C_label = W64[ya[:, None], yb[None, :] + 10] / 2.0\n            C = C_eucl + C_label\n            \n            if style == 'geomloss_match':\n                f, g = _sinkhorn_sym_eps(a_w, b_w, C, blur=blur, p=2, scaling=0.5, n_inner=1)\n            elif style == 'converged':\n                f, g, _ = _sinkhorn_alt(a_w, b_w, C, reg, numItermax=5000, stopThr=1e-10)\n            elif style == 'converged_loose':\n                f, g, _ = _sinkhorn_alt(a_w, b_w, C, reg, numItermax=500, stopThr=1e-6)\n            \n            # Batch cost: compute from coupling\n            # P = a_i b_j exp((f_i + g_j - C_ij)/eps)\n            P = a_w[:, None] * b_w[None, :] * np.exp((f[:, None] + g[None, :] - C) / reg)\n            batchcost[i, j] = np.sum(P * C) / (len(idx) + len(jdx))\n            \n            f_norm = (f - f.mean()) * len(f) / (len(f) - 1)\n            F[i, j] = f_norm\n    \n    # Batch-level transport\n    n_tx = len(tx); n_tr = len(tr)\n    bc_max = max(float(batchcost.max()), 1e-12)\n    q_a = np.ones(n_tx) / n_tx\n    q_b = np.ones(n_tr) / n_tr\n    Q, _, _ = _sinkhorn_alt(q_a, q_b, batchcost / bc_max, 0.01, \n                            numItermax=10000, stopThr=1e-10)\n    \n    residual = max(np.max(np.abs(Q.sum(1) - 1.0/n_tx)),\n                   np.max(np.abs(Q.sum(0) - 1.0/n_tr)))\n    if residual > 1e-6:\n        raise ValueError(f'Unconverged batch transport: {residual}')\n    \n    values = np.zeros(len(x), dtype=np.float64)\n    for i, idx in enumerate(tx):\n        values[idx] = sum(Q[i, j] * F[i, j] for j in range(n_tr))\n    return values\n\n\n# Load test case\nd = np.load('/workspace/environment/public_assets/dev/seed_101_uniform_labels.npz')\nx, y, r, ry, seed = d['x'], d['y'], d['r'], d['ry'], int(d['seed'])\n\n# Canonical reference\nsys.path.insert(0, '/workspace/solution')\nfrom method import value as value_canonical\nt0 = time.time()\nv_canon = value_canonical(x, y, r, ry, seed)\nt_canon = time.time() - t0\nprint(f'Canonical: {t_canon:.3f}s')\n\nfor style in ['geomloss_match', 'converged_loose', 'converged']:\n    t0 = time.time()\n    v_fast = value_fast(x, y, r, ry, seed, style=style)\n    t_fast = time.time() - t0\n    \n    rmse = np.sqrt(np.mean((v_fast - v_canon)**2))\n    nrmse = rmse / np.std(v_canon)\n    from scipy.stats import spearmanr\n    rho, _ = spearmanr(v_fast, v_canon)\n    N = len(v_fast)\n    topq = N // 4\n    idx_f = np.argsort(-v_fast, kind='stable')[:topq]\n    idx_c = np.argsort(-v_canon, kind='stable')[:topq]\n    overlap = len(np.intersect1d(idx_f, idx_c)) / topq\n    \n    print(f'{style:20s}: {t_fast:.3f}s (speedup {t_canon/t_fast:.2f}x)  NRMSE={nrmse:.6f} Spearman={rho:.8f} Overlap={overlap:.4f}')\nEOF\ntimeout 120 python /tmp/test_full_case.py\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

{"type": "item.started", "item": {"id": "item_90", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/test_cost_match.py << 'EOF'\nimport numpy as np\nimport torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nimport time\n\ndef _logsumexp(a, axis=None):\n    a_max = np.max(a, axis=axis, keepdims=True)\n    return np.log(np.sum(np.exp(a - a_max), axis=axis)) + a_max.squeeze(axis=axis)\n\ndef sinkhorn_alt(a, b, C, eps, numItermax=10000, stopThr=1e-12):\n    a = np.asarray(a, dtype=np.float64)\n    b = np.asarray(b, dtype=np.float64)\n    C = np.asarray(C, dtype=np.float64)\n    N, M = C.shape\n    log_a = np.log(a)\n    log_b = np.log(b)\n    f = np.zeros(N, dtype=np.float64)\n    g = np.zeros(M, dtype=np.float64)\n    for i in range(numItermax):\n        g_prev = g\n        f = -eps * _logsumexp(log_b[None, :] + g[None, :]/eps - C/eps, axis=1)\n        g = -eps * _logsumexp(log_a[:, None] + f[:, None]/eps - C/eps, axis=0)\n        if i % 10 == 9 and np.abs(g - g_prev).max() < stopThr:\n            break\n    return f, g, i+1\n\nnp.random.seed(42)\nN, M = 200, 150\nx = np.random.randn(N, 3).astype(np.float32)\ny = np.random.randn(M, 3).astype(np.float32)\nblur = 0.5\n\n# GeomLoss default: p=2, Euclidean\nxa = torch.tensor(x, dtype=torch.float32)[None]\nyb = torch.tensor(y, dtype=torch.float32)[None]\npot_fn = SamplesLoss('sinkhorn', p=2, blur=blur, debias=False, potentials=True, backend='tensorized')\nwith torch.inference_mode():\n    f_gl, g_gl = pot_fn(xa, yb)\nf_gl = f_gl.numpy().ravel().astype(np.float64)\ng_gl = g_gl.numpy().ravel().astype(np.float64)\nprint(f\\\"GeomLoss f range: [{f_gl.min():.6f}, {f_gl.max():.6f}]\\\")\nprint(f\\\"GeomLoss dual div: {f_gl.mean() + g_gl.mean():.6f}\\\")\n\n# Try different cost conventions\nfor name, C_func, reg_func in [\n    (\\\"||x-y||\"'^2/2, reg=blur''^2\", \n     lambda: cdist(x, y, '\"'sqeuclidean')/2, \n     lambda: blur**2),\n    (\\\"||x-y||\"'^2, reg=blur''^2\", \n     lambda: cdist(x, y, '\"'sqeuclidean'), \n     lambda: blur**2),\n    (\\\"||x-y||\"'^2/2, reg=blur\", \n     lambda: cdist(x, y, '\"'sqeuclidean')/2, \n     lambda: blur),\n    (\\\"||x-y||\"'^2/(2*blur''^2), reg=1\", \n     lambda: cdist(x, y, '\"'sqeuclidean')/(2*blur**2), \n     lambda: 1.0),\n    (\\\"||x-y||\"'^p/p with p=2, reg=blur''^p\",\n     lambda: cdist(x, y, '\"'sqeuclidean')/2,\n     lambda: blur**2),\n]:\n    C = C_func().astype(np.float64)\n    reg = reg_func()\n    f, g, it = sinkhorn_alt(np.ones(N)/N, np.ones(M)/M, C, reg, numItermax=10000)\n    div = f.mean() + g.mean()\n    f_norm = (f - f.mean()) * len(f) / (len(f) - 1)\n    f_gl_norm = (f_gl - f_gl.mean()) * len(f_gl) / (len(f_gl) - 1)\n    corr = np.corrcoef(f_norm, f_gl_norm)[0, 1]\n    # check residual\n    P = (np.ones(N)/N)[:, None] * (np.ones(M)/M)[None, :] * np.exp((f[:, None] + g[None, :] - C) / reg)\n    res = np.abs(P.sum(1) - 1/N).max() / (1/N)\n    print(f\\\"{name:40s}: div={div:.6f} corr={corr:.8f} iters={it} res={res:.2e}\\\")\nEOF\ntimeout 30 python /tmp/test_cost_match.py\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

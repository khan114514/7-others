{"type": "item.started", "item": {"id": "item_99", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/test_pot_match.py << 'EOF'\nimport numpy as np\nimport torch\nimport ot\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\n\ndef _logsumexp(a, axis=None):\n    a_max = np.max(a, axis=axis, keepdims=True)\n    return np.log(np.sum(np.exp(a - a_max), axis=axis)) + a_max.squeeze(axis=axis)\n\ndef sinkhorn_alt(a, b, C, eps, numItermax=10000, stopThr=1e-12):\n    log_a = np.log(a); log_b = np.log(b)\n    N, M = C.shape\n    f = np.zeros(N); g = np.zeros(M)\n    for i in range(numItermax):\n        g_prev = g\n        f = -eps * _logsumexp(log_b[None, :] + g[None, :]/eps - C/eps, axis=1)\n        g = -eps * _logsumexp(log_a[:, None] + f[:, None]/eps - C/eps, axis=0)\n        if i % 10 == 9 and np.abs(g - g_prev).max() < stopThr:\n            break\n    return f, g, i+1\n\nnp.random.seed(42)\nN, M = 30, 25\nx = np.random.randn(N, 3).astype(np.float64)\ny = np.random.randn(M, 3).astype(np.float64)\n\nC = cdist(x, y, 'sqeuclidean') / 2.0\neps = 0.1\n\n# POT Sinkhorn\nP_pot = ot.sinkhorn(np.ones(N)/N, np.ones(M)/M, C, eps, numItermax=10000, stopThr=1e-12)\ncost_pot = np.sum(P_pot * C)\nprint(f\\\"POT sinkhorn: cost={cost_pot:.10f}\\\")\n# Recover potentials from P: P = diag(u) K diag(v), K = exp(-C/eps)\nK = np.exp(-C/eps)\nu = np.ones(N)/N / (K  @  (np.ones(M)/M))\nfor _ in range(1000):\n    v = np.ones(M)/M / (K.T  @  u)\n    u = np.ones(N)/N / (K  @  v)\nP_check = u[:, None] * K * v[None, :]\nf_pot = eps * np.log(u * N)  # f = eps*log(u) if a = ones/N and u s.t. u*K*v = a\n# Wait POT scaling convention: P = diag(u) K diag(v), row sums = u * (K v)\n# if u is such that u_i * sum_j K_ij v_j = a_i\n# Standard: f_i = eps * log u_i, g_j = eps * log v_j\n# Then P_ij = u_i K_ij v_j = exp(f_i/eps) * exp(-C_ij/eps) * exp(g_j/eps) = exp((f_i+g_j-C_ij)/eps)\n# sum_j P_ij = sum_j exp((f_i+g_j-C_ij)/eps) = exp(f_i/eps) * sum_j exp((g_j-C_ij)/eps)
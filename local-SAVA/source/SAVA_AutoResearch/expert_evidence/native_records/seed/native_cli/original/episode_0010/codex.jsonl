{"type": "item.started", "item": {"id": "item_84", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/test_sinkhorn_iters.py << 'EOF'\nimport numpy as np\nimport torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nimport time\n\ndef _logsumexp(a, axis=None):\n    a_max = np.max(a, axis=axis, keepdims=True)\n    return np.log(np.sum(np.exp(a - a_max), axis=axis)) + a_max.squeeze(axis=axis)\n\ndef _softmin(eps, C, h):\n    return -eps * _logsumexp(h[None, :] - C / eps, axis=1)\n\ndef sinkhorn_eps(a, b, C, blur, p=2, scaling=0.5, n_inner=5):\n    a = np.asarray(a, dtype=np.float64)\n    b = np.asarray(b, dtype=np.float64)\n    C = np.asarray(C, dtype=np.float64)\n    N, M = C.shape\n    log_a = np.log(a)\n    log_b = np.log(b)\n    \n    diameter = np.sqrt(C.max() * p)\n    target_eps = blur ** p\n    ratio = scaling ** p\n    eps_list = []\n    eps = diameter ** p\n    while eps > target_eps * 1.0001:\n        eps_list.append(eps)\n        eps *= ratio\n    eps_list.append(target_eps)\n    \n    eps0 = eps_list[0]\n    f = _softmin(eps0, C, log_b)\n    g = _softmin(eps0, C.T, log_a)\n    \n    for eps in eps_list:\n        for _ in range(n_inner):\n            ft = _softmin(eps, C, log_b + g / eps)\n            gt = _softmin(eps, C.T, log_a + f / eps)\n            f = 0.5 * (f + ft)\n            g = 0.5 * (g + gt)\n    \n    return f, g, eps_list\n\nnp.random.seed(42)\nN, M = 1024, 1024\nx = np.random.randn(N, 10).astype(np.float64)\ny = np.random.randn(M, 10).astype(np.float64)\nya = np.random.randint(0, 10, N)\nyb = np.random.randint(0, 10, M)\nW = np.abs(np.random.randn(20, 20).astype(np.float64)) * 3\nW = (W + W.T) / 2\n\nC = cdist(x, y, 'sqeuclidean')/2 + W[ya[:,None], yb[None,:]+10]/2\nblur = np.sqrt(0.1)\n\n# GeomLoss\nz1 = torch.tensor(np.column_stack([x, ya]), dtype=torch.float32)[None]\nz2 = torch.tensor(np.column_stack([y, yb+10]), dtype=torch.float32)[None]\ndef cost_fn(z1, z2):\n    d = torch.cdist(z1[:,:,:-1], z2[:,:,:-1]).square()/2\n    return d + torch.as_tensor(W)[z1[:,:,-1].long().unsqueeze(2), z2[:,:,-1].long().unsqueeze(1)]/2\npot_fn = SamplesLoss('sinkhorn', p=2, blur=blur, debias=False, potentials=True, cost=cost_fn, backend='tensorized')\nwith torch.inference_mode():\n    f_gl, g_gl = pot_fn(z1, z2)\nf_gl = f_gl.numpy().ravel().astype(np.float64)\nf_gl_norm = (f_gl - f_gl.mean()) * len(f_gl) / (len(f_gl) - 1)\n\nfor n_inner in [1, 2, 5, 10, 20, 50]:\n    t0 = time.time()\n    f_np, g_np, eps_list = sinkhorn_eps(np.ones(N)/N, np.ones(M)/M, C, blur=blur, p=2, scaling=0.5, n_inner=n_inner)\n    t1 = time.time()\n    f_np_norm = (f_np - f_np.mean()) * len(f_np) / (len(f_np) - 1)\n    corr = np.corrcoef(f_gl_norm, f_np_norm)[0, 1]\n    maxdiff = np.abs(f_gl_norm - f_np_norm).max()\n    # Convergence check: residual of marginals\n    P = np.exp((f_np[:, None] + g_np[None, :] - C) / (blur**2)) * (np.ones(N)/N)[:, None] * (np.ones(M)/M)[None, :]\n    # Wait need to check convention\n    # softmin: f_i = -eps * log sum_j exp(h_j - C_ij/eps)\n    # At convergence with h_j = log b_j + g_j/eps:\n    # f_i = -eps * log sum_j b_j exp(g_j/eps - C_ij/eps)\n    # exp(-f_i/eps) = sum_j b_j exp((g_j - C_ij)/eps)\n    # 1 = sum_j b_j exp((f_i + g_j - C_ij)/eps)\n    # This matches P_ij = a_i b_j exp((f_i+g_j-C_ij)/eps) with P.sum(1) = a_i... no\n    # P_ij = a_i b_j exp((f_i + g_j - C_ij)/eps)\n    # Check: P.sum(1) = a_i * sum_j b_j exp((f_i+g_j-C_ij)/eps)\n    #        = a_i * exp(f_i/eps) * sum_j b_j exp((g_j-C_ij)/eps)\n    #        = a_i * exp(f_i/eps) * exp(-f_i/eps) = a_i ✓\n    P_test = (np.ones(N)/N)[:, None] * (np.ones(M)/M)[None, :] * np.exp((f_np[:, None] + g_np[None, :] - C) / (blur**2))\n    row_res = np.abs(P_test.sum(1) - 1/N).max() / (1/N)\n    col_res = np.abs(P_test.sum(0) - 1/M).max() / (1/M)\n    print(f\\\"n_inner={n_inner:3d}: time={t1-t0:.4f}s corr={corr:.10f} maxdiff={maxdiff:.4f} row_res={row_res:.2e} col_res={col_res:.2e}\\\")\nEOF\ntimeout 60 python /t
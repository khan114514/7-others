{"type": "item.started", "item": {"id": "item_81", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/test_sinkhorn_sym.py << 'EOF'\nimport numpy as np\nimport torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nimport time\n\ndef _logsumexp(a, axis=None):\n    a_max = np.max(a, axis=axis, keepdims=True)\n    return np.log(np.sum(np.exp(a - a_max), axis=axis)) + a_max.squeeze(axis=axis)\n\ndef _softmin(eps, C, h):\n    \\\"\\\"\\\"softmin_i = -eps * logsumexp_j (h_j - C_ij/eps)\\\"\\\"\\\"\n    return -eps * _logsumexp(h[None, :] - C / eps, axis=1)\n\ndef sinkhorn_eps_scaling(a, b, C, blur, p=2, scaling=0.5, diameter=None):\n    \\\"\\\"\\\"Symmetric epsilon-scaling Sinkhorn matching GeomLoss.\n    C = (1/p)*||x-y||\"'^p + label_cost (custom cost)\n    blur = target blur\n    target eps = blur''^p\n    \"\"\"\n    a = np.asarray(a, dtype=np.float64)\n    b = np.asarray(b, dtype=np.float64)\n    C = np.asarray(C, dtype=np.float64)\n    N, M = C.shape\n    \n    log_a = np.log(a)\n    log_b = np.log(b)\n    \n    # Build eps_list\n    if diameter is None:\n        diameter = np.sqrt(C.max() * p)\n    target_eps = blur ** p\n    ratio = scaling ** p\n    eps_list = []\n    eps = diameter ** p\n    while eps > target_eps * 1.0001:\n        eps_list.append(eps)\n        eps *= ratio\n    eps_list.append(target_eps)\n    \n    # Initialization (first step with eps = diameter''^p)\n    eps0 = eps_list[0]\n    f_ba = _softmin(eps0, C, log_b)\n    g_ab = _softmin(eps0, C.T, log_a)\n    \n    # Iterate over eps schedule\n    for eps in eps_list:\n        # Symmetric update\n        ft = _softmin(eps, C, log_b + g_ab / eps)\n        gt = _softmin(eps, C.T, log_a + f_ba / eps)\n        f_ba = 0.5 * (f_ba + ft)\n        g_ab = 0.5 * (g_ab + gt)\n    \n    return f_ba, g_ab, eps_list\n\n\nnp.random.seed(42)\nN, M = 500, 400\nx = np.random.randn(N, 10).astype(np.float64)\ny = np.random.randn(M, 10).astype(np.float64)\nya = np.random.randint(0, 5, N)\nyb = np.random.randint(0, 5, M)\nW = np.abs(np.random.randn(10, 10).astype(np.float64)) * 3\nW = (W + W.T) / 2\n\nC = cdist(x, y, '\"'sqeuclidean')/2 + W[ya[:,None], yb[None,:]+5]/2\nblur = np.sqrt(0.1)\n\n# GeomLoss with custom cost\nz1 = torch.tensor(np.column_stack([x, ya]), dtype=torch.float32)[None]\nz2 = torch.tensor(np.column_stack([y, yb+5]), dtype=torch.float32)[None]\ndef cost_fn(z1, z2):\n    d = torch.cdist(z1[:,:,:-1], z2[:,:,:-1]).square()/2\n    return d + torch.as_tensor(W)[z1[:,:,-1].long().unsqueeze(2), z2[:,:,-1].long().unsqueeze(1)]/2\npot_fn = SamplesLoss('sinkhorn', p=2, blur=blur, debias=False, potentials=True, cost=cost_fn, backend='tensorized')\nwith torch.inference_mode():\n    f_gl, g_gl = pot_fn(z1, z2)\nf_gl = f_gl.numpy().ravel().astype(np.float64)\ng_gl = g_gl.numpy().ravel().astype(np.float64)\n\n# Our symmetric epsilon-scaling Sinkhorn\nt0 = time.time()\nf_np, g_np, eps_list = sinkhorn_eps_scaling(\n    np.ones(N)/N, np.ones(M)/M, C, blur=blur, p=2, scaling=0.5)\nt1 = time.time()\n\nprint(f\\\"Eps list: {[f'{e:.4f}' for e in eps_list]} ({len(eps_list)} steps)\\\")\nprint(f\\\"Our time: {t1-t0:.4f}s\\\")\nprint(f\\\"GeomLoss dual div: {f_gl.mean() + g_gl.mean():.6f}\\\")\nprint(f\\\"Our dual div: {f_np.mean() + g_np.mean():.6f}\\\")\nprint(f\\\"Ratio our/GL: {(f_np.mean() + g_np.mean())/(f_gl.mean() + g_gl.mean()):.6f}\\\")\n\nf_gl_norm = (f_gl - f_gl.mean()) * len(f_gl) / (len(f_gl) - 1)\nf_np_norm = (f_np - f_np.mean()) * len(f_np) / (len(f_np) - 1)\ncorr = np.corrcoef(f_gl_norm, f_np_norm)[0, 1]\nprint(f\\\"f (normalized) correlation: {corr:.10f}\\\")\nprint(f\\\"f norm max abs diff: {np.abs(f_gl_norm - f_np_norm).max():.6f}\\\")\nprint(f\\\"f range GL: [{f_gl.min():.4f}, {f_gl.max():.4f}]\\\")\nprint(f\\\"f range NP: [{f_np.min():.4f}, {f_np.max():.4f}]\\\")\n\n# Also test pure Euclidean (no labels, default cost)\nprint(\\\"\\\\n--- Pure Euclidean (no labels) ---\\\")\nC_eucl = cdist(x, y, 'sqeuclidean')/2\nxa = torch.tensor(x, dtype=torch.float32)[None]\nyb = torch.tensor(y, dtype=torch.float32)[None]\npot_fn_eucl = SamplesLoss('sinkhorn', p=2, blur=blur, debias=False, potentials=True, backend='tensorized')\nwith torch.inference_mode():\n    f_gl2, g_gl2 = pot_fn_eucl(xa, yb)\nf_gl2 = f_gl2.numpy().ravel().astype(np.float64)\nf_np2, g_np2, _ = sinkhorn_eps_scaling(np.ones(N)/N, np.ones(M)/M, C_eucl, blur=blur, p=2, scaling=0.5)\n\nf_gl2_norm = (f_gl2 - f_gl2.mean()) * len(f_gl2) / (len(f_gl2) - 1)\nf_np2_norm = (f_np2 - f_np2.mean()) * len(f_np2) / (len(f_np2) - 1)\ncorr2 = np.corrcoef(f_gl2_norm, f_np2_norm)[0, 1]\nprint(f\\\"GeomLoss div: {f_gl2.mean() + g_gl2.mean():.6f}\\\")\nprint(f\\\"Our div: {f_np2.mean() + g_np2.mean():.6f}\\\")\nprint(f\\\"f (normalized) correlation: {corr2:.10f}\\\")\nprint(f\\\"f norm max abs diff: {np.abs(f_gl2_norm - f_np2_norm).max():.6f}\\\")\nEOF\ntimeout 30 python /tmp/test_sinkhorn_sym.py\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

{"type": "item.started", "item": {"id": "item_57", "type": "command_execution", "command": "/bin/sh -lc \"cd /workspace/solution && timeout 60 python -c \\\"\nimport numpy as np\nimport torch\nimport ot\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nimport time\n\ndef _logsumexp(a, axis=None):\n    a_max = np.max(a, axis=axis, keepdims=True)\n    return np.log(np.sum(np.exp(a - a_max), axis=axis)) + a_max.squeeze(axis=axis)\n\ndef sinkhorn_log(a, b, C, reg, numItermax=10000, stopThr=1e-10):\n    log_a = np.log(a)\n    log_b = np.log(b)\n    log_u = np.zeros_like(a)\n    log_v = np.zeros_like(b)\n    for i in range(numItermax):\n        log_v_prev = log_v\n        M = -C / reg + log_v[None, :]\n        log_u = log_a - _logsumexp(M, axis=1)\n        M = -C / reg + log_u[:, None]\n        log_v = log_b - _logsumexp(M, axis=0)\n        if i % 10 == 9:\n            if np.abs(log_v - log_v_prev).max() < stopThr:\n                break\n    f = reg * log_u\n    g = reg * log_v\n    P = np.exp(log_u[:, None] + log_v[None, :] - C / reg)\n    return P, f, g, i\n\nnp.random.seed(42)\nN, M = 200, 150\na = np.random.randn(N, 10).astype(np.float64)\nb = np.random.randn(M, 10).astype(np.float64)\nya = np.random.randint(0, 5, N)\nyb = np.random.randint(0, 5, M)\nW = np.abs(np.random.randn(10, 10).astype(np.float64)) * 5\nW = (W + W.T) / 2\n\nC = cdist(a, b, 'sqeuclidean')/2 + W[ya[:,None], yb[None,:]+5]/2\nreg = 0.1\n\n# Our log-domain Sinkhorn with unscaled C\nt0 = time.time()\nP, f, g, iters = sinkhorn_log(np.ones(N)/N, np.ones(M)/M, C, reg, numItermax=10000, stopThr=1e-10)\nt1 = time.time()\nprint(f'Log-domain Sinkhorn (unscaled): {t1-t0:.4f}s, {iters} iters')\nprint(f'  Primal cost: {np.sum(P * C):.6f}')\nprint(f'  Dual div: {np.sum(np.ones(N)/N * f) + np.sum(np.ones(M)/M * g):.6f}')\n\n# GeomLoss\nz1 = torch.tensor(np.column_stack([a, ya]), dtype=torch.float32)[None]\nz2 = torch.tensor(np.column_stack([b, yb+5]), dtype=torch.float32)[None]\ndef cost_fn(z1, z2):\n    d = torch.cdist(z1[:,:,:-1], z2[:,:,:-1]).square()/2\n    return d + torch.as_tensor(W)[z1[:,:,-1].long().unsqueeze(2), z2[:,:,-1].long().unsqueeze(1)]/2\npot_fn = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, potentials=True, cost=cost_fn, backend='tensorized')\nwith torch.inference_mode():\n    f_gl, g_gl = pot_fn(z1, z2)\nf_gl = f_gl.numpy().ravel().astype(np.float64)\ng_gl = g_gl.numpy().ravel().astype(np.float64)\nprint(f'GeomLoss: dual div = {f_gl.mean() + g_gl.mean():.6f}')\n\n# Compare f\nf_norm = (f - f.mean()) * len(f) / (len(f) - 1)\nf_gl_norm = (f_gl - f_gl.mean()) * len(f_gl) / (len(f_gl) - 1)\ncorr = np.corrcoef(f_norm, f_gl_norm)[0, 1]\nprint(f'f norm correlation: {corr:.8f}')\nprint(f'f_norm max abs diff: {np.abs(f_norm - f_gl_norm).max():.6f}')\n\n# Compare ratios\nprint(f'dual div ratio (our/gl): {(f.mean()+g.mean())/(f_gl.mean()+g_gl.mean()):.6f}')\n\\\"\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

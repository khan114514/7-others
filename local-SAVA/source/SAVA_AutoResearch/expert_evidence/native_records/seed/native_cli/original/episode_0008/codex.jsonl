{"type": "item.started", "item": {"id": "item_65", "type": "command_execution", "command": "/bin/sh -lc \"cd /workspace/solution && python -c \\\"\nimport time, numpy as np, torch, ot\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\n\n# Replicate canonical method but compute batchcost from GeomLoss potentials\nnp.random.seed(42)\ndata = np.load('/workspace/environment/public_assets/dev/seed_101_uniform_labels.npz')\nx, y, r, ry = data['x'], data['y'], data['r'], data['ry']\nN, M = len(x), len(r)\nbatch_size = 1024\n\ndef _label_cost(x,y,r,ry):\n    xx=torch.tensor(np.concatenate([x,r]),dtype=torch.float32)\n    yy=np.concatenate([y,ry+10])\n    W=np.zeros((20,20),dtype=np.float32)\n    loss=SamplesLoss('sinkhorn',p=2,blur=np.sqrt(.1),debias=False,backend='tensorized')\n    with torch.inference_mode():\n        for i in range(20):\n            for j in range(i+1,20):\n                W[i,j]=W[j,i]=float(loss(xx[yy==i],xx[yy==j]))\n    return W\n\ntorch.set_num_threads(2)\nx=np.asarray(x,np.float32); r=np.asarray(r,np.float32)\ny=np.asarray(y,np.int64); ry=np.asarray(ry,np.int64)\ntx=[np.arange(i,min(i+batch_size,N)) for i in range(0,N,batch_size)]\ntr=[np.arange(i,min(i+batch_size,M)) for i in range(0,M,batch_size)]\nW=_label_cost(x[tx[0]],y[tx[0]],r[tr[0]],ry[tr[0]])\n\ndef cost(z1,z2):\n    d=torch.cdist(z1[:,:,:-1],z2[:,:,:-1]).square()/2\n    return d+torch.as_tensor(W)[z1[:,:,-1].long().unsqueeze(2),z2[:,:,-1].long().unsqueeze(1)]/2\n\npotential=SamplesLoss('sinkhorn',p=2,blur=np.sqrt(.1),debias=False,\n                     potentials=True,cost=cost,backend='tensorized')\nF={}; batchcost=np.zeros((len(tx),len(tr)))\nt0 = time.time()\nfor i,idx in enumerate(tx):\n    for j,jdx in enumerate(tr):\n        a=x[idx];b=r[jdx]\n        C=cdist(a,b,'sqeuclidean')/2+W[y[idx,None],ry[jdx][None,:]+10]/2\n        P=ot.sinkhorn(ot.unif(len(idx)),ot.unif(len(jdx)),C/max(float(C.max()),1e-12),.1)\n        batchcost[i,j]=float(np.sum(P*C))/(len(idx)+len(jdx))\n        z1=torch.tensor(np.column_stack([a,y[idx]]),dtype=torch.float32)[None]\n        z2=torch.tensor(np.column_stack([b,ry[jdx]+10]),dtype=torch.float32)[None]\n        with torch.inference_mode(): f,_=potential(z1,z2)\n        f=f.numpy().ravel().astype(float)\n        F[i,j]=(f-f.mean())*len(f)/(len(f)-1)\nt_canon = time.time()-t0\nprint(f'Canonical inner loop: {t_canon:.2f}s')\n\nQ=ot.sinkhorn(ot.unif(len(tx)),ot.unif(len(tr)),\n              batchcost/max(float(batchcost.max()),1e-12),.01,\n              numItermax=10000,stopThr=1e-10)\nvalues=np.zeros(N)\nfor i,idx in enumerate(tx): values[idx]=sum(Q[i,j]*F[i,j] for j in range(len(tr)))\nprint(f'Canonical values: mean={values.mean():.4f} std={values.std():.4f}')\n\n# ------- Unified version -------\n# Compute batchcost from GeomLoss potentials (same eps=0.1)\nF2={}; batchcost2=np.zeros((len(tx),len(tr)))\nt0 = time.time()\nfor i,idx in enumerate(tx):\n    for j,jdx in enumerate(tr):\n        a=x[idx];b=r[jdx]\n        z1=torch.tensor(np.column_stack([a,y[idx]]),dtype=torch.float32)[None]\n        z2=torch.tensor(np.column_stack([b,ry[jdx]+10]),dtype=torch.float32)[None]\n        with torch.inference_mode(): f,g=potential(z1,z2)\n        f=f.numpy().ravel().astype(float)\n        g=g.numpy().ravel().astype(float)\n        # W from potentials: W = a·f + b·g (uniform weights => mean(f)+mean(g))\n        W_pair = f.mean() + g.mean()\n        batchcost2[i,j] = W_pair / (1 + len(jdx)/len(idx))  # normalize like canonical\n        F2[i,j]=(f-f.mean())*len(f)/(len(f)-1)\nt_unified = time.time()-t0\nprint(f'Unified inner loop: {t_unified:.2f}s')\nprint(f'Speedup: {t_canon/t_unified:.2f}x')\n\nprint(f'batchcost canon: {batchcost}')\nprint(f'batchcost unified: {batchcost2}')\n\nQ2=ot.sinkhorn(ot.unif(len(tx)),ot.unif(len(tr)),\n               batchcost2/max(float(batchcost2.max()),1e-12),.01,\n               numItermax=10000,stopThr=1e-10)\nvalues2=np.zeros(N)\nfor i,idx in enumerate(tx): values2[idx]=sum(Q2[i,j]*F2[i,j] for j in range(len(tr)))\n\n# Compare\nfrom scipy.stats import spearmanr\nrmse = np.sqrt(np.mean((values - values2)**2)) / values.std()\nspear, _ = spearmanr(values, values2)\nk = N // 4\ntop_canon = set(np.argsort(-values)[:k])\ntop_unified = set(np.argsort(-values2)[:k])\noverlap = len(top_canon & top_unified) / k\nprint(f'NRMSE: {rmse:.6f}')\nprint(f'Spearman: {spear:.6f}')\nprint(f'Top quarter overlap: {overlap:.6f}')\n\\\" 2>&1\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

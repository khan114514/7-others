{"type": "item.started", "item": {"id": "item_21", "type": "command_execution", "command": "/bin/sh -lc \"cd /workspace/solution && python -c \\\"\nimport numpy as np, torch, ot\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nfrom method import _label_cost\n\nnp.random.seed(42)\ndata = np.load('/workspace/environment/public_assets/dev/seed_101_uniform_labels.npz')\nx, y, r, ry = data['x'][:1024], data['y'][:1024], data['r'][:1024], data['ry'][:1024]\n\nW = _label_cost(x[:200], y[:200], r[:200], ry[:200])\n\n# Cost matrix\nC = cdist(x, r, 'sqeuclidean')/2 + W[y[:,None], ry[None,:]+10]/2\nepsilon = 0.1\nn, m = C.shape\na = np.ones(n)/n\nb = np.ones(m)/m\n\n# POT sinkhorn\nP = ot.sinkhorn(a, b, C / C.max(), epsilon, numItermax=10000)\n# Get u,v from log\nimport warnings\nwith warnings.catch_warnings():\n    warnings.simplefilter('ignore')\n    _, log = ot.sinkhorn(a, b, C / C.max(), epsilon, log=True, numItermax=10000)\nu_pot, v_pot = log['u'], log['v']\n\n# Sinkhorn potentials from u/v: f = epsilon * log(u) + constant\n# But note: POT normalizes differently. Let's check.\n# P = diag(u)  @  K  @  diag(v), K = exp(-C/epsilon)\n# The potential: f_i = epsilon * log(u_i)\n\nf_pot = epsilon * np.log(u_pot + 1e-300)\ng_pot = epsilon * np.log(v_pot + 1e-300)\n\n# GeomLoss potentials\ndef cost(z1,z2):\n    d = torch.cdist(z1[:,:,:-1], z2[:,:,:-1]).square()/2\n    return d + torch.as_tensor(W)[z1[:,:,-1].long().unsqueeze(2), z2[:,:,-1].long().unsqueeze(1)]/2\n\npotential = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                       potentials=True, cost=cost, backend='tensorized')\nz1 = torch.tensor(np.column_stack([x,y]), dtype=torch.float32)[None]\nz2 = torch.tensor(np.column_stack([r,ry+10]), dtype=torch.float32)[None]\nwith torch.inference_mode():\n    f_geom, g_geom = potential(z1, z2)\nf_geom = f_geom.numpy().ravel()\ng_geom = g_geom.numpy().ravel()\n\n# Compare\nprint('f_pot stats:', f_pot.mean(), f_pot.std())\nprint('f_geom stats:', f_geom.mean(), f_geom.std())\n\n# POT scales by C.max()\nprint()\nprint('C.max():', C.max())\n\n# The POT was on C/C.max(), so epsilon is also scaled. Let's de-scale.\n# Actual epsilon = 0.1 * C.max()\n# Wait no: the regularization parameter is in the same units as C.\n# If C is divided by C.max(), then epsilon=0.1 means actual epsilon = 0.1 * C.max()\n# But the canonical uses epsilon = 0.1 with unscaled C for GeomLoss...\n# Let me re-read the code.\n\nprint()\nprint('Checking POT normalization...')\n# In canonical: P = ot.sinkhorn(..., C/max(C.max(), 1e-12), .1)\n# So cost is normalized, epsilon=0.1 is in normalized units\n# But GeomLoss uses blur=sqrt(0.1) = 0.316 with original cost...\n# Hmm, GeomLoss blur parameter is different from epsilon.\n# For p=2, blur\"'^2 = epsilon? Let'\"'s check.\nprint('blur = sqrt(0.1) =', np.sqrt(0.1))\nprint('blur\"'^2 ='\"', 0.1)\n# Yes, for Sinkhorn with p=2, blur\"'^2 = epsilon (in entropic regularization terms in GeomLoss)\n# But GeomLoss uses unscaled cost, while POT uses C/C.max().\n# These are DIFFERENT problems!\n\n# So the canonical method actually computes two different Sinkhorn problems:\n# 1. POT: normalized cost C/C.max(), epsilon=0.1 — for batch cost\n# 2. GeomLoss: original cost, blur=sqrt(0.1) — for potentials\n# These have different effective epsilon values!\n\nprint()\nprint('\"'POT effective epsilon (original units):', 0.1 * C.max())\nprint('GeomLoss epsilon (blur\"'^2):'\"', 0.1)\n\\\"\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

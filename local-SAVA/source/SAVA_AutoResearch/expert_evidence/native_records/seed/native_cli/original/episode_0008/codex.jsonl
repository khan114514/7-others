{"type": "item.started", "item": {"id": "item_27", "type": "command_execution", "command": "/bin/sh -lc \"cd /workspace/solution && python -c \\\"\nimport time, numpy as np, ot, torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\n\nnp.random.seed(42)\n# Let me understand: label cost is computed on first batches (first 1024 of candidate + reference)\n# Each label group might have ~100 samples (for 10 classes, uniform)\n# 20*19/2 = 190 pairs\n# Each pair ~200 samples total\n# GeomLoss tensorized Sinkhorn... let's time per pair\n\nn_per_class = 100\nd = 10\na = np.random.randn(n_per_class, d).astype(np.float32)\nb = np.random.randn(n_per_class, d).astype(np.float32)\n\n# GeomLoss\nloss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\nta = torch.tensor(a)[None]\ntb = torch.tensor(b)[None]\nwith torch.inference_mode():\n    _ = loss(ta, tb)\nt0 = time.time()\nfor _ in range(10):\n    with torch.inference_mode():\n        _ = loss(ta, tb)\nprint(f'GeomLoss Sinkhorn 100x100: {(time.time()-t0)/10*1000:.1f}ms')\n\n# POT\nC = cdist(a, b, 'sqeuclidean')/2\naa = np.ones(n_per_class)/n_per_class\nbb = np.ones(n_per_class)/n_per_class\nt0 = time.time()\nfor _ in range(10):\n    P = ot.sinkhorn(aa, bb, C / C.max(), 0.1, numItermax=10000)\n    val = np.sum(P * C)\nprint(f'POT sinkhorn 100x100: {(time.time()-t0)/10*1000:.1f}ms, val={val:.4f}')\n\n# Custom log-domain Sinkhorn\ndef sinkhorn_log(a, b, C, eps, max_iter=1000, tol=1e-9):\n    n, m = C.shape\n    f = np.zeros(n)\n    g = np.zeros(m)\n    log_a = np.log(a + 1e-300)\n    log_b = np.log(b + 1e-300)\n    for i in range(max_iter):\n        f_prev = f\n        # f = eps * (log_a - logsumexp((f[:,None] + g[None,:] - C) / eps, axis=1))\n        M = (f[:, None] + g[None, :] - C) / eps\n        g = eps * (log_b - _logsumexp(M.T, axis=1))\n        M = (f[:, None] + g[None, :] - C) / eps\n        f = eps * (log_a - _logsumexp(M, axis=1))\n        if np.max(np.abs(f - f_prev)) < tol:\n            break\n    return f, g\n\ndef _logsumexp(M, axis):\n    mx = M.max(axis=axis, keepdims=True)\n    return np.log(np.sum(np.exp(M - mx), axis=axis, keepdims=False)) + mx.squeeze(axis)\n\nC = cdist(a, b, 'sqeuclidean').astype(np.float64)/2\neps = 0.1\nt0 = time.time()\nfor _ in range(10):\n    f, g = sinkhorn_log(aa, bb, C, eps, max_iter=500, tol=1e-8)\nprint(f'Custom log-sinkhorn 100x100: {(time.time()-t0)/10*1000:.1f}ms')\n\n# Compute the Sinkhorn distance from potentials\n# W = sum(a_i * f_i) + sum(b_j * g_j)\nW_custom = np.sum(aa * f) + np.sum(bb * g)\nprint(f'Custom W: {W_custom:.4f}')\n\n# Compare with POT normalized (which uses C/C.max(), eps=0.1)\nCn = C / C.max()\nf_n, g_n = sinkhorn_log(aa, bb, Cn, 0.1, max_iter=500, tol=1e-8)\nW_pot_like = np.sum(aa * f_n) + np.sum(bb * g_n)\nprint(f'Custom normalized W (POT-like): {W_pot_like:.4f}')\n\n# POT actual\nP = ot.sinkhorn(aa, bb, C / C.max(), 0.1, numItermax=10000)\nW_pot = np.sum(P * C)  # in original units\nprint(f'POT W (original units): {W_pot:.4f}')\n\n# GeomLoss actual\nwith torch.inference_mode():\n    w_geom = float(loss(ta, tb))\nprint(f'GeomLoss W: {w_geom:.4f}')\n\\\"\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

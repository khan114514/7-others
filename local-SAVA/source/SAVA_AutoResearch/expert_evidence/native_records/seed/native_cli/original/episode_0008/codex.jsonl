{"type": "item.started", "item": {"id": "item_59", "type": "command_execution", "command": "/bin/sh -lc \"cd /workspace/solution && python -c \\\"\nimport numpy as np, time\nfrom scipy.spatial.distance import cdist\n\nnp.random.seed(42)\nn, m = 1024, 1024\nd = 10\na = np.random.randn(n, d).astype(np.float64)\nb = np.random.randn(m, d).astype(np.float64)\n\nC = cdist(a, b, 'sqeuclidean') / 2\neps = 0.1\naa = np.ones(n) / n\nbb = np.ones(m) / m\n\n# Stabilized log-sinkhorn using logsumexp (vectorized numpy)\ndef logsumexp(M, axis):\n    mx = M.max(axis=axis, keepdims=True)\n    out = np.log(np.sum(np.exp(M - mx), axis=axis, keepdims=True)) + mx\n    return out.squeeze(axis)\n\ndef sinkhorn_log_stable(a, b, C, eps, max_iter=500, tol=1e-8):\n    log_a = np.log(a)\n    log_b = np.log(b)\n    f = np.zeros_like(a)\n    g = np.zeros_like(b)\n    for it in range(max_iter):\n        f_old = f.copy()\n        # g update: g = eps * (log_b - lse_rows((f[:,None] - C) / eps))\n        M = (f[:, None] - C) / eps  # (n, m)\n        g = eps * (log_b - logsumexp(M.T + g[None, :] / eps, axis=1))\n        # Wait, proper form: f_i + g_j - C_ij all over eps\n        # lse over i for g update: logsumexp_i ((f_i + g_j - C_ij)/eps) = log_b_j\n        # => g_j = eps * (log_b_j - logsumexp_i ((f_i - C_ij)/eps))\n        # Actually let me redo this properly.\n        break\n    return f, g\n\n# Wait, proper iteration\n# Sinkhorn in dual space:\n# u\"'^{k+1}_i = a_i / (K v''^k)_i\n# v''^{k+1}_j = b_j / (K''^T u''^{k+1})_j\n# In log domain with f = eps log u, g = eps log v:\n# f''^{k+1}_i = eps * (log a_i - logsumexp_j ((g''^k_j - C_ij) / eps))\n# g''^{k+1}_j = eps * (log b_j - logsumexp_i ((f''^{k+1}_i - C_ij) / eps))\n\ndef sinkhorn_log(a, b, C, eps, max_iter=500, tol=1e-8):\n    log_a = np.log(a)\n    log_b = np.log(b)\n    f = np.zeros_like(a)\n    g = np.zeros_like(b)\n    C_eps = C / eps\n    for it in range(max_iter):\n        f_prev = f\n        # f update\n        # logsumexp_j(g_j/eps - C_ij/eps) = logsumexp_j ((g_j - C_ij)/eps)\n        # M_ij = g_j/eps - C_ij/eps (for all i,j)\n        M = g[None, :] / eps - C_eps  # (n, m)\n        f = eps * (log_a - logsumexp(M, axis=1))\n        # g update\n        M = f[:, None] / eps - C_eps  # (n, m)\n        g = eps * (log_b - logsumexp(M, axis=0))\n        if np.max(np.abs(f - f_prev)) < tol:\n            return f, g, it\n    return f, g, max_iter\n\n# Use float64, but only allocate once\nt0 = time.time()\nf, g, iters = sinkhorn_log(aa, bb, C, eps, max_iter=200, tol=1e-6)\nt = (time.time()-t0)*1000\nprint(f'\"'Custom log-sinkhorn float64: {t:.0f}ms, iters={iters}')\n\n# Check convergence\nu = np.exp(f / eps)\nv = np.exp(g / eps)\nK = np.exp(-C / eps)\nP = u[:, None] * K * v[None, :]\nrow_err = np.max(np.abs(P.sum(1) - aa))\ncol_err = np.max(np.abs(P.sum(0) - bb))\nprint(f'Row err: {row_err:.2e}, Col err: {col_err:.2e}')\nW = np.sum(P * C)\nprint(f'W = {W:.4f}')\n\\\" 2>&1\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

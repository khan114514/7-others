{"type": "item.started", "item": {"id": "item_125", "type": "command_execution", "command": "/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np, time, glob\nimport torch\nfrom scipy.stats import spearmanr\nimport sys\nsys.path.insert(0, '/tmp/research_history')\nimport method_canonical_v0 as mc\nimport method as mv17\nimport importlib\nimportlib.reload(mc)\nimportlib.reload(mv17)\n\ntorch.set_num_threads(2)\n\ncases = [\n    'seed_101_uniform_labels',\n    'seed_101_mixed',\n    'seed_202_asymmetric_labels',\n    'seed_303_gaussian_016',\n]\n\nall_pass = True\nfor case in cases:\n    data = np.load(f'/workspace/environment/public_assets/dev/{case}.npz')\n    x, y, r, ry = data['x'], data['y'], data['r'], data['ry']\n    \n    t0 = time.perf_counter()\n    v_c = mc.value(x, y, r, ry, seed=int(case.split('_')[1]))\n    t_c = time.perf_counter() - t0\n    \n    t0 = time.perf_counter()\n    v_n = mv17.value(x, y, r, ry, seed=int(case.split('_')[1]))\n    t_n = time.perf_counter() - t0\n    \n    nrmse = np.sqrt(np.mean((v_n - v_c)**2)) / np.std(v_c)\n    rho, _ = spearmanr(v_n, v_c)\n    N = len(v_n)\n    top_q = N // 4\n    idx_c = set(np.argsort(-v_c)[:top_q])\n    idx_n = set(np.argsort(-v_n)[:top_q])\n    overlap = len(idx_c & idx_n) / top_q\n    \n    valid = nrmse <= 0.01 and rho >= 0.999 and overlap >= 0.98\n    all_pass = all_pass and valid\n    \n    print(f'{case:35s}: can={t_c:.2f}s v17={t_n:.2f}s speedup={t_c/t_n:.1f}x NRMSE={nrmse:.2e} rho={rho:.8f} overlap={overlap:.4f} {\\\\\\\"OK\\\\\\\" if valid else \\\\\\\"FAIL\\\\\\\"}')\n\nprint(f'All pass: {all_pass}')\n\\\" 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

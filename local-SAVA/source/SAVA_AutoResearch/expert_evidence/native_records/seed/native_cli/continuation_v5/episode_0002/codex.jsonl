ime += t_p1 - t_p0\n        batchcost[i,j] = float(np.sum(P*C))/(len(idx)+len(jdx))\n        \n        t_g0 = time.perf_counter()\n        z1 = torch.tensor(np.column_stack([a, y[idx]]), dtype=torch.float32)[None]\n        z2 = torch.tensor(np.column_stack([b, ry[jdx]+10]), dtype=torch.float32)[None]\n        with torch.inference_mode(): f,_ = potential(z1, z2)\n        t_g1 = time.perf_counter()\n        geom_time += t_g1 - t_g0\n        pair_count += 1\n\nt2 = time.perf_counter()\nprint(f'Pairs: {pair_count}')\nprint(f'  cdist total: {cdist_time:.3f}s')\nprint(f'  POT Sinkhorn total: {pot_time:.3f}s ({pot_time/pair_count:.3f}s/pair)')\nprint(f'  GeomLoss potentials total: {geom_time:.3f}s ({geom_time/pair_count:.3f}s/pair)')\nprint(f'  Total pair time: {t2-t1:.3f}s')\n\nQ = ot.sinkhorn(ot.unif(len(tx)), ot.unif(len(tr)),\n                batchcost/max(float(batchcost.max()), 1e-12), .01,\n                numItermax=10000, stopThr=1e-10)\nt3 = time.perf_counter()\nprint(f'Batch-level OT: {t3-t2:.3f}s')\nprint(f'Total: {t3-t0:.3f}s')\n\\\" 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

{"type": "item.started", "item": {"id": "item_94", "type": "command_execution", "command": "/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np, time\nimport torch\nimport ot\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\n\ndata = np.load('/workspace/environment/public_assets/dev/seed_101_uniform_labels.npz')\nx, y, r, ry = data['x'], data['y'], data['r'], data['ry']\nx = np.asarray(x, np.float32); r = np.asarray(r, np.float32)\ny = np.asarray(y, np.int64); ry = np.asarray(ry, np.int64)\ntorch.set_num_threads(2)\n\nbatch_size = 1024\n# Get W\ndef label_cost_geom(x_, y_, r_, ry_):\n    xx = torch.tensor(np.concatenate([x_, r_]), dtype=torch.float32)\n    yy = np.concatenate([y_, ry_ + 10])\n    W = np.zeros((20, 20), dtype=np.float32)\n    loss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\n    with torch.inference_mode():\n        for i in range(20):\n            for j in range(i+1, 20):\n                W[i,j] = W[j,i] = float(loss(xx[yy==i], xx[yy==j]))\n    return W\nW = label_cost_geom(x[:batch_size], y[:batch_size], r[:batch_size], ry[:batch_size])\n\ndef cost_fn(W):\n    def cost(z1, z2):\n        d = torch.cdist(z1[:, :, :-1], z2[:, :, :-1]).square() / 2\n        return d + torch.as_tensor(W)[z1[:, :, -1].long().unsqueeze(2),\n                                       z2[:, :, -1].long().unsqueeze(1)] / 2\n    return cost\n\n# Test: Can GeomLoss at higher blur match canonical POT batchcost?\n# Canonical: POT on C/C_max with reg=0.1 => effective eps = 0.1 * C_max\nidx = np.arange(batch_size); jdx = np.arange(batch_size)\na = x[idx]; b = r[jdx]\nC = cdist(a, b, 'sqeuclidean')/2 + W[y[idx,None], ry[jdx][None,:]+10]/2\nC_max = C.max()\nprint(f'C_max: {C_max:.2f}')\n\n# Canonical\nP_can = ot.sinkhorn(np.ones(len(idx))/len(idx), np.ones(len(jdx))/len(jdx), C/C_max, 0.1)\nbc_can = float(np.sum(P_can * C)) / (len(idx) + len(jdx))\nprint(f'Canonical POT batchcost: {bc_can:.8f}')\n\n# GeomLoss at matched blur (blur = sqrt(0.1 * C_max))\nblur_matched = np.sqrt(0.1 * C_max)\nprint(f'Matched blur: {blur_matched:.2f}')\npot_match = SamplesLoss('sinkhorn', p=2, blur=blur_matched, debias=False,\n                        potentials=True, cost=cost_fn(W), backend='tensorized')\nz1 = torch.tensor(np.column_stack([a, y[idx]]), dtype=torch.float32)[None]\nz2 = torch.tensor(np.column_stack([b, ry[jdx]+10]), dtype=torch.float32)[None]\n\nt0 = time.perf_counter()\nwith torch.inference_mode(): f_t, g_t = pot_match(z1, z2)\nt1 = time.perf_counter()\nf = f_t.numpy().ravel().astype(np.float64)\ng = g_t.numpy().ravel().astype(np.float64)\n\n# Reconstruct P\nreg_matched = 0.1 * C_max\nn, m = len(idx), len(jdx)\nP_match = (1.0/n) * (1.0/m) * np.exp((f[:, None] + g[None, :] - C) / reg_matched)\nbc_match = float(np.sum(P_match * C)) / (n + m)\nprint(f'GeomLoss matched batchcost: {bc_match:.8f}, diff={abs(bc_match-bc_can)/bc_can:.6e}')\nprint(f'P_match sum: {P_match.sum():.6f}')\nprint(f'GeomLoss matched time: {t1-t0:.3f}s')\n\n# Compare potentials to canonical GeomLoss potentials (for F value)\n# Canonical GeomLoss uses reg=0.1\npot_canon = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                        potentials=True, cost=cost_fn(W), backend='tensorized')\nwith torch.inference_mode(): f_c_t, g_c_t = pot_canon(z1, z2)\nf_c = f_c_t.numpy().ravel().astype(np.float64)\n# Both normalized: (f - mean(f)) * n/(n-1)\nF_match = (f - f.mean()) * n / (n-1)\nF_canon = (f_c - f_c.mean()) * n / (n-1)\nfrom scipy.stats import spearmanr\nrho, _ = spearmanr(F_match, F_canon)\nprint(f'F spearman (matched vs canonical): {rho:.10f}')\nnrmse_f = np.sqrt(np.mean((F_match - F_canon)**2)) / np.std(F_canon)\nprint(f'F NRMSE: {nrmse_f:.6f}')\n\n# Time both canonical pair components\nt_pot = 0\nt_geom = 0\nfor _ in range(3):\n    t0 = time.perf_counter()\n    P_can = ot.sinkhorn(np.ones(n)/n, np.ones(m)/m, C/C_max, 0.1)\n    t_pot += time.perf_counter() - t0\n    t0 = time.perf_counter()\n    with torch.inference_mode(): f_c_t, _ = pot_canon(z1, z2)\n    t_geom += time.perf_counter() - t0\nprint(f'POT time: {t_pot/3:.3f}s, GeomLoss time: {t_geom/3:.3f}s')\nprint(f'Total canonical pair time: {(t_pot+t_geom)/3:.3f}s')\n\\\" 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

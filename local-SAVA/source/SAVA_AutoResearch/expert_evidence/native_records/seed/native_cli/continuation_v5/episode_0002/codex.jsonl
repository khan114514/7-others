{"type": "item.started", "item": {"id": "item_121", "type": "command_execution", "command": "/bin/sh -lc \"cp /workspace/solution/method.py /tmp/research_history/method_v16_fastnp.py\n\ncat > /workspace/solution/method.py << 'PYEOF'\n\\\"\\\"\\\"v17: Matched-blur GeomLoss for batchcost + canonical GeomLoss for F potentials.\n- Replaces slow POT Sinkhorn with fast matched-blur GeomLoss + 2 log-domain refinement iters\n- ~6x faster per-pair than canonical POT+GeomLoss\n- Quality: NRMSE~1e-5, Spearman~1.0, overlap=1.0\n\\\"\\\"\\\"\nimport numpy as np\nimport torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nfrom scipy.special import logsumexp\nimport ot\n\n\ndef _label_cost(x, y, r, ry):\n    xx = torch.tensor(np.concatenate([x, r]), dtype=torch.float32)\n    yy = np.concatenate([y, ry + 10])\n    W = np.zeros((20, 20), dtype=np.float32)\n    loss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\n    with torch.inference_mode():\n        for i in range(20):\n            for j in range(i + 1, 20):\n                if not (yy == i).any() or not (yy == j).any():\n                    raise ValueError('Initial batch lacks a label support')\n                W[i, j] = W[j, i] = float(loss(xx[yy == i], xx[yy == j]))\n    return W\n\n\ndef _make_cost_fn(W):\n    def cost(z1, z2):\n        d = torch.cdist(z1[:, :, :-1], z2[:, :, :-1]).square() / 2\n        return d + torch.as_tensor(W)[z1[:, :, -1].long().unsqueeze(2),\n                                      z2[:, :, -1].long().unsqueeze(1)] / 2\n    return cost\n\n\ndef value(x, y, r, ry, seed=17, batch_size=1024):\n    torch.set_num_threads(2)\n    x = np.asarray(x, np.float32); r = np.asarray(r, np.float32)\n    y = np.asarray(y, np.int64); ry = np.asarray(ry, np.int64)\n    tx = [np.arange(i, min(i + batch_size, len(x))) for i in range(0, len(x), batch_size)]\n    tr = [np.arange(i, min(i + batch_size, len(r))) for i in range(0, len(r), batch_size)]\n\n    W = _label_cost(x[tx[0]], y[tx[0]], r[tr[0]], ry[tr[0]])\n    cost_fn = _make_cost_fn(W)\n\n    # F potentials: canonical reg\n    pot_f = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                        potentials=True, cost=cost_fn, backend='tensorized')\n\n    F = {}\n    batchcost = np.zeros((len(tx), len(tr)))\n    reg_norm = 0.1\n    refine_iters = 2\n\n    for i, idx in enumerate(tx):\n        for j, jdx in enumerate(tr):\n            a = x[idx]; b = r[jdx]\n            n_src = len(idx); n_tgt = len(jdx)\n\n            z1 = torch.tensor(np.column_stack([a, y[idx]]), dtype=torch.float32)[None]\n            z2 = torch.tensor(np.column_stack([b, ry[jdx] + 10]), dtype=torch.float32)[None]\n\n            # Batchcost: matched-blur GeomLoss + log-domain refinement\n            C = (cdist(a, b, 'sqeuclidean') / 2.0 +\n                 W[y[idx, None], ry[jdx][None, :] + 10] / 2.0).astype(np.float64)\n            C_max = max(float(C.max()), 1e-12)\n            blur_match = np.sqrt(reg_norm * C_max)\n            pot_bc = SamplesLoss('sinkhorn', p=2, blur=blur_match, debias=False,\n                                 potentials=True, cost=cost_fn, backend='tensorized')\n            with torch.inference_mode():\n                f_bc_t, g_bc_t = pot_bc(z1, z2)\n            f_bc = f_bc_t.numpy().ravel().astype(np.float64) / C_max\n            g_bc = g_bc_t.numpy().ravel().astype(np.float64) / C_max\n\n            a_w = np.ones(n_src, np.float64) / n_src\n            b_w = np.ones(n_tgt, np.float64) / n_tgt\n            log_a = np.log(a_w)\n            log_b = np.log(b_w)\n            C_norm = C / C_max\n\n            for _ in range(refine_iters):\n                f_bc = -reg_norm * logsumexp(log_b[None, :] + (g_bc[None, :] - C_norm) / reg_norm, axis=1)\n                g_bc = -reg_norm * logsumexp(log_a[:, None] + (f_bc[:, None] - C_norm) / reg_norm, axis=0)\n\n            log_P = log_a[:, None] + log_b[None, :] + (f_bc[:, None] + g_bc[None, :] - C_norm) / reg_norm\n            P = np.exp(log_P)\n            batchcost[i, j] = float(np.sum(P * C)) / (n_src + n_tgt)\n\n            # F from canonical GeomLoss\n            with torch.inference_mode():\n                f, _ = pot_f(z1, z2)\n            f = f.numpy().ravel().astype(float)\n            F[i, j] = (f - f.mean()) * len(f) / (len(f) - 1)\n\n    bc_max = max(float(batchcost.max()), 1e-12)\n    Q = ot.sinkhorn(np.ones(len(tx)) / len(tx),\n                    np.ones(len(tr)) / len(tr),\n                    batchcost / bc_max, .01,\n                    numItermax=10000, stopThr=1e-10)\n    residual = max(np.max(np.abs(Q.sum(1) - 1.0 / len(tx))),\n                   np.max(np.abs(Q.sum(0) - 1.0 / len(tr))))\n    if residual > 1e-6:\n        raise ValueError(f'Unconverged batch transport: {residual}')\n\n    values = np.zeros(len(x))\n    for i, idx in enumerate(tx):\n        values[idx] = sum(Q[i, j] * F[i, j] for j in range(len(tr)))\n    return values\nPYEOF\necho \\\"v17 written\\\"\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

{"type": "item.started", "item": {"id": "item_78", "type": "command_execution", "command": "/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np, time\nimport torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nfrom scipy.stats import spearmanr\n\ndata = np.load('/workspace/environment/public_assets/dev/seed_101_uniform_labels.npz')\nx, y, r, ry = data['x'], data['y'], data['r'], data['ry']\nx = np.asarray(x, np.float32); r = np.asarray(r, np.float32)\ny = np.asarray(y, np.int64); ry = np.asarray(ry, np.int64)\ntorch.set_num_threads(2)\n\nbatch_size = 1024\n# Canonical W (ground truth)\ndef label_cost_geom(x_, y_, r_, ry_):\n    xx = torch.tensor(np.concatenate([x_, r_]), dtype=torch.float32)\n    yy = np.concatenate([y_, ry_ + 10])\n    W = np.zeros((20, 20), dtype=np.float32)\n    loss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\n    with torch.inference_mode():\n        for i in range(20):\n            for j in range(i+1, 20):\n                W[i,j] = W[j,i] = float(loss(xx[yy==i], xx[yy==j]))\n    return W\n\nt0 = time.perf_counter()\nW_canon = label_cost_geom(x[:batch_size], y[:batch_size], r[:batch_size], ry[:batch_size])\nt1 = time.perf_counter()\nprint(f'Canonical W: {t1-t0:.3f}s, range=[{W_canon.min():.1f}, {W_canon.max():.1f}]')\n\n# Method 1: Class mean pairwise distance\nt0 = time.perf_counter()\nxx = np.concatenate([x[:batch_size], r[:batch_size]])\nyy = np.concatenate([y[:batch_size], ry[:batch_size] + 10])\nmeans = np.array([xx[yy == k].mean(axis=0) for k in range(20)])\nW_mean = cdist(means, means, 'sqeuclidean').astype(np.float32)\nt1 = time.perf_counter()\nprint(f'Mean W: {t1-t0:.4f}s, range=[{W_mean.min():.1f}, {W_mean.max():.1f}]')\nmask = ~np.eye(20, dtype=bool)\ncorr_mean, _ = spearmanr(W_canon[mask], W_mean[mask])\nprint(f'  Spearman corr with canonical: {corr_mean:.6f}')\n\n# Method 2: Subsampled GeomLoss (e.g. 20 samples per class)\nt0 = time.perf_counter()\nnp.random.seed(42)\nxx = np.concatenate([x[:batch_size], r[:batch_size]])\nyy = np.concatenate([y[:batch_size], ry[:batch_size] + 10])\nW_sub = np.zeros((20, 20), dtype=np.float32)\nloss_sub = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\nsub_n = 50\nclass_data = []\nfor k in range(20):\n    idx_k = np.where(yy == k)[0]\n    if len(idx_k) > sub_n:\n        idx_k = np.random.choice(idx_k, sub_n, replace=False)\n    class_data.append(torch.tensor(xx[idx_k], dtype=torch.float32))\nwith torch.inference_mode():\n    for i in range(20):\n        for j in range(i+1, 20):\n            W_sub[i,j] = W_sub[j,i] = float(loss_sub(class_data[i], class_data[j]))\nt1 = time.perf_counter()\nprint(f'Subsampled W (n=50): {t1-t0:.3f}s, range=[{W_sub.min():.1f}, {W_sub.max():.1f}]')\ncorr_sub, _ = spearmanr(W_canon[mask], W_sub[mask])\nrel_err = np.abs(W_canon[mask] - W_sub[mask]) / W_canon[mask]\nprint(f'  Spearman corr: {corr_sub:.6f}, max rel err: {rel_err.max():.4f}, mean rel err: {rel_err.mean():.4f}')\n\n# Method 3: Subsampled n=20\nt0 = time.perf_counter()\nnp.random.seed(42)\nW_sub20 = np.zeros((20, 20), dtype=np.float32)\nsub_n = 20\nclass_data20 = []\nfor k in range(20):\n    idx_k = np.where(yy == k)[0]\n    if len(idx_k) > sub_n:\n        idx_k = np.random.choice(idx_k, sub_n, replace=False)\n    class_data20.append(torch.tensor(xx[idx_k], dtype=torch.float32))\nwith torch.inference_mode():\n    for i in range(20):\n        for j in range(i+1, 20):\n            W_sub20[i,j] = W_sub20[j,i] = float(loss_sub(class_data20[i], class_data20[j]))\nt1 = time.perf_counter()\nprint(f'Subsampled W (n=20): {t1-t0:.3f}s')\ncorr_sub20, _ = spearmanr(W_canon[mask], W_sub20[mask])\nrel_err20 = np.abs(W_canon[mask] - W_sub20[mask]) / W_canon[mask]\nprint(f'  Spearman corr: {corr_sub20:.6f}, max rel err: {rel_err20.max():.4f}, mean rel err: {rel_err20.mean():.4f}')\n\\\" 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

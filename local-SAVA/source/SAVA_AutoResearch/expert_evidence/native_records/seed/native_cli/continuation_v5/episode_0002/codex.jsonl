{"type": "item.started", "item": {"id": "item_52", "type": "command_execution", "command": "/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np, time\nimport torch\nimport ot\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\n\ndata = np.load('/workspace/environment/public_assets/dev/seed_101_uniform_labels.npz')\nx, y, r, ry = data['x'], data['y'], data['r'], data['ry']\nx = np.asarray(x, np.float32); r = np.asarray(r, np.float32)\ny = np.asarray(y, np.int64); ry = np.asarray(ry, np.int64)\ntorch.set_num_threads(2)\n\n# Compare GeomLoss label cost vs POT label cost for a subset\nbatch_size = 1024\nxx = np.concatenate([x[:batch_size], r[:batch_size]])\nyy = np.concatenate([y[:batch_size], ry[:batch_size] + 10])\n\n# Canonical GeomLoss W\nt0 = time.perf_counter()\nxx_t = torch.tensor(xx, dtype=torch.float32)\nW_geom = np.zeros((20, 20), dtype=np.float32)\nloss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\nwith torch.inference_mode():\n    for i in range(20):\n        for j in range(i+1, 20):\n            W_geom[i,j] = W_geom[j,i] = float(loss(xx_t[yy==i], xx_t[yy==j]))\nt1 = time.perf_counter()\nprint(f'GeomLoss W: {t1-t0:.3f}s')\nprint(f'W_geom range: [{W_geom.min():.2f}, {W_geom.max():.2f}]')\n\n# POT-based label cost with proper scaling\nt0 = time.perf_counter()\nW_pot = np.zeros((20, 20), dtype=np.float64)\nclass_samples = [xx[yy == k] for k in range(20)]\nfor i in range(20):\n    xi = class_samples[i]\n    ni = len(xi)\n    if ni == 0: continue\n    a = np.ones(ni) / ni\n    for j in range(i+1, 20):\n        xj = class_samples[j]\n        nj = len(xj)\n        if nj == 0: continue\n        b = np.ones(nj) / nj\n        C = cdist(xi, xj, 'sqeuclidean') / 2.0\n        C_max = C.max()\n        if C_max < 1e-12:\n            W_pot[i,j] = W_pot[j,i] = 0.0\n            continue\n        # Use reg = 0.1 (matches GeomLoss blur\"'^2=0.1, but need to match normalization)\n        # GeomLoss uses absolute reg=0.1, so we use reg/C_max normalization\n        P = ot.sinkhorn(a, b, C / C_max, 0.1 / C_max,\n                        numItermax=500, stopThr=1e-6)\n        W_pot[i,j] = W_pot[j,i] = np.sum(P * C)\nt2 = time.perf_counter()\nprint(f'\"'POT W (reg=0.1, scaled): {t2-t0:.3f}s')\nprint(f'W_pot range: [{W_pot.min():.2f}, {W_pot.max():.2f}]')\n\n# Compare\ndiff = np.abs(W_geom - W_pot)\nmask = ~np.eye(20, dtype=bool)\nprint(f'Max abs diff: {diff[mask].max():.4f}')\nprint(f'Mean abs diff: {diff[mask].mean():.4f}')\nprint(f'Rel diff (W>1): {(diff[W_geom>1]/W_geom[W_geom>1]).max():.4f}')\n\\\" 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

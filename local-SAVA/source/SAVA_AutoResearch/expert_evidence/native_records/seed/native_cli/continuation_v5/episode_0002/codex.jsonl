{"type": "item.started", "item": {"id": "item_63", "type": "command_execution", "command": "/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np, time\nimport ot\nfrom scipy.spatial.distance import cdist\n\ndata = np.load('/workspace/environment/public_assets/dev/seed_101_uniform_labels.npz')\nx, y, r, ry = data['x'], data['y'], data['r'], data['ry']\nx = np.asarray(x, np.float32); r = np.asarray(r, np.float32)\ny = np.asarray(y, np.int64); ry = np.asarray(ry, np.int64)\n\n# 1024x1024 pair WITH label cost\nN, M = 1024, 1024\nW = np.random.rand(20, 20).astype(np.float32) * 1000\nW = (W + W.T) / 2\nnp.fill_diagonal(W, 0)\nC = cdist(x[:N], r[:M], 'sqeuclidean')/2.0 + W[y[:N,None], ry[:M][None,:]+10]/2.0\nC_max = C.max()\na = np.ones(N)/N\nb = np.ones(M)/M\n\nprint(f'C range: [{C.min():.2f}, {C.max():.2f}], C_max={C_max:.2f}')\n\n# POT timing (3 runs)\ntimes = []\nfor _ in range(3):\n    t0 = time.perf_counter()\n    P = ot.sinkhorn(a, b, C/C_max, 0.1)\n    t1 = time.perf_counter()\n    times.append(t1-t0)\nprint(f'POT sinkhorn (avg of 3): {np.mean(times):.3f}s')\nbc_pot = np.sum(P * C) / (N + M)\nres_row = np.max(np.abs(P.sum(1) - a))\nprint(f'  batchcost={bc_pot:.6f}, row_res={res_row:.2e}')\n\n# numpy direct timing\ndef np_sinkhorn(a, b, K, max_iter=500, tol=1e-9):\n    u = np.ones_like(a)\n    v = np.ones_like(b)\n    Kt = K.T\n    for it in range(max_iter):\n        u_prev = u\n        u = a / (K  @  v)\n        v = b / (Kt  @  u)\n        if np.max(np.abs(u - u_prev)) < tol:\n            break\n    return u[:, None] * K * v[None, :]\n\nK = np.exp(-C/C_max / 0.1).astype(np.float64)\nprint(f'K range: [{K.min():.2e}, {K.max():.2e}]')\ntimes = []\nfor _ in range(3):\n    t0 = time.perf_counter()\n    P2 = np_sinkhorn(a, b, K, max_iter=200)\n    t1 = time.perf_counter()\n    times.append(t1-t0)\nprint(f'numpy sinkhorn (avg of 3): {np.mean(times):.3f}s')\nbc_np = np.sum(P2 * C) / (N + M)\nres_row2 = np.max(np.abs(P2.sum(1) - a))\nprint(f'  batchco
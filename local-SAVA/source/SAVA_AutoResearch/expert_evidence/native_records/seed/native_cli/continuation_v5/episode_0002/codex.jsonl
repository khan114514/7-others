{"type": "item.started", "item": {"id": "item_59", "type": "command_execution", "command": "/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np, time\nimport torch\nimport ot\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\n\ndata = np.load('/workspace/environment/public_assets/dev/seed_101_uniform_labels.npz')\nx, y, r, ry = data['x'], data['y'], data['r'], data['ry']\nx = np.asarray(x, np.float32); r = np.asarray(r, np.float32)\ny = np.asarray(y, np.int64); ry = np.asarray(ry, np.int64)\ntorch.set_num_threads(2)\n\n# Get canonical W\nbatch_size = 1024\ndef _label_cost(x,y,r,ry):\n    xx=torch.tensor(np.concatenate([x,r]),dtype=torch.float32)\n    yy=np.concatenate([y,ry+10])\n    W=np.zeros((20,20),dtype=np.float32)\n    loss=SamplesLoss('sinkhorn',p=2,blur=np.sqrt(.1),debias=False,backend='tensorized')\n    with torch.inference_mode():\n        for i in range(20):\n            for j in range(i+1,20):\n                W[i,j]=W[j,i]=float(loss(xx[yy==i],xx[yy==j]))\n    return W\n\nW = _label_cost(x[:batch_size], y[:batch_size], r[:batch_size], ry[:batch_size])\n\n# Compare batchcost computation methods for one pair\nidx = np.arange(batch_size)\njdx = np.arange(batch_size)\na = x[idx]; b = r[jdx]\nC = cdist(a, b, 'sqeuclidean')/2 + W[y[idx,None], ry[jdx][None,:]+10]/2\nn, m = len(idx), len(jdx)\n\n# Canonical batchcost\nC_max = C.max()\nP_can = ot.sinkhorn(ot.unif(n), ot.unif(m), C/C_max, 0.1,\n                    numItermax=1000, stopThr=1e-9)\nbc_can = float(np.sum(P_can * C)) / (n + m)\nprint(f'Canonical batchcost: {bc_can:.8f}')\nprint(f'C_max: {C_max:.2f}')\n\n# GeomLoss potentials method\ndef cost(z1,z2):\n    d=torch.cdist(z1[:,:,:-1],z2[:,:,:-1]).square()/2\n    return d+torch.as_tensor(W)[z1[:,:,-1].long().unsqueeze(2),z2[:,:,-1].long().unsqueeze(1)]/2\npotential = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                       potentials=True, cost=cost, backend='tensorized')\nz1 = torch.tensor(np.column_stack([a, y[idx]]), dtype=torch.float32)[None]\nz2 = torch.tensor(np.column_stack([b, ry[jdx]+10]), dtype=torch.float32)[None]\nwith torch.inference_mode(): f_t, g_t = potential(z1, z2)\nf = f_t.numpy().ravel().astype(np.float64)\ng = g_t.numpy().ravel().astype(np.float64)\nprint(f'f range: [{f.min():.4f}, {f.max():.4f}], g range: [{g.min():.4f}, {g.max():.4f}]')\n\n# Method 1: Reconstruct P from potentials (v10 style)\nreg = 0.1\nP_rec = (1.0/n) * (1.0/m) * np.exp((f[:, None] + g[None, :] - C) / reg)\nbc_rec = float(np.sum(P_rec * C)) / (n + m)\nprint(f'v10 batchcost:     {bc_rec:.8f}, ratio: {bc_rec/bc_can:.6f}')\n\n# Method 2: Use Sinkhorn loss formula: <a, f> + <b, g> (which equals sum(P*C) + reg*KL(P||ab))\nbc_sink = (np.sum(f) / n + np.sum(g) / m) / 2.0  # avg of dual potentials\nprint(f'Sinkhorn dual loss: {(f.mean() + g.mean()):.8f}')\n\n# Check: sum(P*C) should equal sum(a*f) + sum(b*g) - reg*sum(P)\n# Actually Sinkhorn primal = dual - reg*sum(P) + reg... let me check\nprint(f'sum(a*f) + sum(b*g): {(f.mean() + g.mean()):.8f}')\nprint(f'sum(P_can*C) canonical: {float(np.sum(P_can*C)):.8f}')\n\n# Check P reconstruction vs canonical P\nprint(f'P_can sum: {P_can.sum():.6f}, P_rec sum: {P_rec.sum():.6f}')\nprint(f'P_can row sums: [{P_can.sum(1).min():.6f}, {P_can.sum(1).max():.6f}]')\nprint(f'P_rec row sums: [{P_rec.sum(1).min():.6f}, {P_rec.sum(1).max():.6f}]')\n\\\" 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

{"type": "item.started", "item": {"id": "item_106", "type": "command_execution", "command": "/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np, time\nimport torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nfrom scipy.stats import spearmanr\nimport sys\nsys.path.insert(0, '/tmp/research_history')\nimport method_canonical_v0 as mc\nimport importlib\nimportlib.reload(mc)\n\ndata = np.load('/workspace/environment/public_assets/dev/seed_101_uniform_labels.npz')\nx, y, r, ry = data['x'], data['y'], data['r'], data['ry']\nx = np.asarray(x, np.float32); r = np.asarray(r, np.float32)\ny = np.asarray(y, np.int64); ry = np.asarray(ry, np.int64)\ntorch.set_num_threads(2)\n\n# Canonical values\nt0 = time.perf_counter()\nv_c = mc.value(x, y, r, ry, seed=101)\nt_c = time.perf_counter() - t0\nprint(f'Canonical: {t_c:.3f}s')\n\n# v17: matched-blur GeomLoss for batchcost + canonical GeomLoss for F\nbatch_size = 1024\ntx = [np.arange(i, min(i+batch_size, len(x))) for i in range(0, len(x), batch_size)]\ntr = [np.arange(i, min(i+batch_size, len(r))) for i in range(0, len(r), batch_size)]\n\n# Canonical W\ndef label_cost_geom(x_, y_, r_, ry_):\n    xx = torch.tensor(np.concatenate([x_, r_]), dtype=torch.float32)\n    yy = np.concatenate([y_, ry_ + 10])\n    W = np.zeros((20, 20), dtype=np.float32)\n    loss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\n    with torch.inference_mode():\n        for i in range(20):\n            for j in range(i+1, 20):\n                W[i,j] = W[j,i] = float(loss(xx[yy==i], xx[yy==j]))\n    return W\n\nt0 = time.perf_counter()\nW = label_cost_geom(x[tx[0]], y[tx[0]], r[tr[0]], ry[tr[0]])\nt_w = time.perf_counter() - t0\n\ndef cost_fn(W):\n    def cost(z1, z2):\n        d = torch.cdist(z1[:, :, :-1], z2[:, :, :-1]).square() / 2\n        return d + torch.as_tensor(W)[z1[:, :, -1].long().unsqueeze(2),\n                                       z2[:, :, -1].long().unsqueeze(1)] / 2\n    return cost\n\n# F potentials (canonical reg)\npot_f = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                    potentials=True, cost=cost_fn(W), backend='tensorized')\n\nF = {}\nbatchcost = np.zeros((len(tx), len(tr)))\n\nt_pairs = 0\nfor i, idx in enumerate(tx):\n    for j, jdx in enumerate(tr):\n        a = x[idx]; b = r[jdx]\n        n_src = len(idx); n_tgt = len(jdx)\n        \n        z1 = torch.tensor(np.column_stack([a, y[idx]]), dtype=torch.float32)[None]\n        z2 = torch.tensor(np.column_stack([b, ry[jdx]+10]), dtype=torch.float32)[None]\n        \n        tp0 = time.perf_counter()\n        # Batchcost from matched-blur GeomLoss\n        C = cdist(a, b, 'sqeuclidean')/2 + W[y[idx,None], ry[jdx][None,:]+10]/2\n        C_max = C.max()\n        blur_match = np.sqrt(0.1 * C_max)\n        pot_bc = SamplesLoss('sinkhorn', p=2, blur=blur_match, debias=False,\n                             potentials=True, cost=cost_fn(W), backend='tensorized')\n        with torch.inference_mode():\n            f_bc, g_bc = pot_bc(z1, z2)\n        f_bc = f_bc.numpy().ravel().astype(np.float64)\n        g_bc = g_bc.numpy().ravel().astype(np.float64)\n        reg_match = 0.1 * C_max\n        P_bc = (1.0/n_src) * (1.0/n_tgt) * np.exp((f_bc[:, None] + g_bc[None, :] - C.astype(np.float64)) / reg_match)\n        batchcost[i,j] = float(np.sum(P_bc * C)) / (n_src + n_tgt)\n        \n        # F from canonical GeomLoss\n        with torch.inference_mode():\n            f_f, _ = pot_f(z1, z2)\n        f_f = f_f.numpy().ravel().astype(float)\n        F[i,j] = (f_f - f_f.mean()) * len(f_f) / (len(f_f) - 1)\n        t_pairs += time.perf_counter() - tp0\n\nimport ot\nQ = ot.sinkhorn(np.ones(len(tx))/len(tx), np.ones(len(tr))/len(tr),\n                batchcost/max(float(batchcost.max()), 1e-12), .01,\n                numItermax=10000, stopThr=1e-10)\nresidual = max(np.max(np.abs(Q.sum(1) - 1.0/len(tx))),\n               np.max(np.abs(Q.sum(0) - 1.0/len(tr))))\nif residual > 1e-6: raise ValueError(f'Unconverged batch transport: {residual}')\n\nvalues = np.zeros(len(x))\nfor i, idx in enumerate(tx):\n    values[idx] = sum(Q[i,j] * F[i,j] for j in range(len(tr)))\n\nt_total = time.perf_counter() - t0\nprint(f'v17 (matched-blur bc): {t_total:.3f}s, label_cost={t_w:.3f}s, pairs={t_pairs:.3f}s')\n\n# Quality\nnrmse = np.sqrt(np.mean((values - v_c)**2)) / np.std(v_c)\nrho, _ = spearmanr(values, v_c)\nN = len(values)\ntop_q = N // 4\nidx_c = np.argsort(-v_c)[:top_q]\nidx_n = np.argsort(-values)[:top_q]\noverlap = len(set(idx_c) & set(idx_n)) / top_q\nprint(f'NRMSE: {nrmse:.6e}')\nprint(f'Spearman: {rho:.10f}')\nprint(f'Top-quarter overlap: {overlap:.6f}')\nprint(f'Speedup vs canonical: {t_c/t_total:.2f}x')\n\\\" 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

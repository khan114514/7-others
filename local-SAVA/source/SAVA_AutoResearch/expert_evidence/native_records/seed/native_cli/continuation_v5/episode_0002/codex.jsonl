{"type": "item.started", "item": {"id": "item_66", "type": "command_execution", "command": "/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np, time\nimport torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\n\ndata = np.load('/workspace/environment/public_assets/dev/seed_101_uniform_labels.npz')\nx, y, r, ry = data['x'], data['y'], data['r'], data['ry']\nx = np.asarray(x, np.float32); r = np.asarray(r, np.float32)\ny = np.asarray(y, np.int64); ry = np.asarray(ry, np.int64)\ntorch.set_num_threads(2)\n\nbatch_size = 1024\ndef _label_cost(x,y,r,ry):\n    xx=torch.tensor(np.concatenate([x,r]),dtype=torch.float32)\n    yy=np.concatenate([y,ry+10])\n    W=np.zeros((20,20),dtype=np.float32)\n    loss=SamplesLoss('sinkhorn',p=2,blur=np.sqrt(.1),debias=False,backend='tensorized')\n    with torch.inference_mode():\n        for i in range(20):\n            for j in range(i+1,20):\n                W[i,j]=W[j,i]=float(loss(xx[yy==i],xx[yy==j]))\n    return W\n\ndef _fast_sinkhorn(a, b, C_norm, reg=0.1, max_iter=500, tol=1e-9):\n    K = np.exp(-C_norm / reg)\n    Kt = K.T\n    u = np.ones_like(a)\n    v = np.ones_like(b)\n    for it in range(max_iter):\n        u_prev = u.copy()\n        u = a / (K  @  v)\n        v = b / (Kt  @  u)\n        if np.max(np.abs(u - u_prev)) < tol:\n            break\n    P = u[:, None] * K * v[None, :]\n    return P\n\ntx = [np.arange(i, min(i+batch_size, len(x))) for i in range(0, len(x), batch_size)]\ntr = [np.arange(i, min(i+batch_size, len(r))) for i in range(0, len(r), batch_size)]\n\nt0 = time.perf_counter()\nW = _label_cost(x[tx[0]], y[tx[0]], r[tr[0]], ry[tr[0]])\nt1 = time.perf_counter()\nprint(f'Label cost: {t1-t0:.3f}s')\n\n# Test fast sinkhorn on all 6 pairs vs POT\ndef cost(z1,z2):\n    d=torch.cdist(z1[:,:,:-1],z2[:,:,:-1]).square()/2\n    return d+torch.as_tensor(W)[z1[:,:,-1].long().unsqueeze(2),z2[:,:,-1].long().unsqueeze(1)]/2\npotential = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                       potentials=True, cost=cost, backend='tensorized')\n\nbc_fast = np.zeros((len(tx), len(tr)))\nbc_pot = np.zeros((len(tx), len(tr)))\nt_fast = 0\nt_pot = 0\nt_geom = 0\nfor i, idx in enumerate(tx):\n    for j, jdx in enumerate(tr):\n        a = x[idx]; b = r[jdx]\n        C = cdist(a, b, 'sqeuclidean')/2 + W[y[idx,None], ry[jdx][None,:]+10]/2\n        C_max = C.max()\n        C_norm = C / C_max\n        a_w = np.ones(len(idx))/len(idx)\n        b_w = np.ones(len(jdx))/len(jdx)\n        \n        tf = time.perf_counter()\n        P_f = _fast_sinkhorn(a_w, b_w, C_norm, 0.1, max_iter=200, tol=1e-8)\n        t_fast += time.perf_counter() - tf\n        bc_fast[i,j] = float(np.sum(P_f * C)) / (len(idx) + len(jdx))\n        \n        import ot\n        tp = time.perf_counter()\n        P_p = ot.sinkhorn(a_w, b_w, C_norm, 0.1)\n        t_pot += time.perf_counter() - tp\n        bc_pot[i,j] = float(np.sum(P_p * C)) / (len(idx) + len(jdx))\n        \n        tg = time.perf_counter()\n        z1 = torch.tensor(np.column_stack([a, y[idx]]), dtype=torch.float32)[None]\n        z2 = torch.tensor(np.column_stack([b, ry[jdx]+10]), dtype=torch.float32)[None]\n        with torch.inference_mode(): f,_ = potential(z1, z2)\n        t_geom += time.perf_counter() - tg\n\nprint(f'Fast Sinkhorn total: {t_fast:.3f}s')\nprint(f'POT Sinkhorn total: {t_pot:.3f}s')\nprint(f'GeomLoss potentials total: {t_geom:.3f}s')\nprint(f'bc_fast vs bc_pot max rel diff: {np.max(np.abs(bc_fast - bc_pot) / np.abs(bc_pot)):.6e}')\nprint(f'bc_fast: {bc_fast}')\nprint(f'bc_pot: {bc_pot}')\n\\\" 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

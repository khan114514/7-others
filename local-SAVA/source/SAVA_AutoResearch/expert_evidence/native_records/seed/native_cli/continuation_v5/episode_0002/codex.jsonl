{"type": "item.started", "item": {"id": "item_96", "type": "command_execution", "command": "/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np, time\nimport torch\nimport ot\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nfrom scipy.special import logsumexp\n\ndata = np.load('/workspace/environment/public_assets/dev/seed_101_uniform_labels.npz')\nx, y, r, ry = data['x'], data['y'], data['r'], data['ry']\nx = np.asarray(x, np.float32); r = np.asarray(r, np.float32)\ny = np.asarray(y, np.int64); ry = np.asarray(ry, np.int64)\ntorch.set_num_threads(2)\n\nbatch_size = 1024\n# Get W\ndef label_cost_geom(x_, y_, r_, ry_):\n    xx = torch.tensor(np.concatenate([x_, r_]), dtype=torch.float32)\n    yy = np.concatenate([y_, ry_ + 10])\n    W = np.zeros((20, 20), dtype=np.float32)\n    loss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\n    with torch.inference_mode():\n        for i in range(20):\n            for j in range(i+1, 20):\n                W[i,j] = W[j,i] = float(loss(xx[yy==i], xx[yy==j]))\n    return W\nW = label_cost_geom(x[:batch_size], y[:batch_size], r[:batch_size], ry[:batch_size])\n\ndef cost_fn(W):\n    def cost(z1, z2):\n        d = torch.cdist(z1[:, :, :-1], z2[:, :, :-1]).square() / 2\n        return d + torch.as_tensor(W)[z1[:, :, -1].long().unsqueeze(2),\n                                       z2[:, :, -1].long().unsqueeze(1)] / 2\n    return cost\n\n# Idea: use matched-blur GeomLoss for batchcost + canonical GeomLoss for F\n# Compare total pair time vs canonical (POT + GeomLoss)\n\nidx = np.arange(batch_size); jdx = np.arange(batch_size)\na = x[idx]; b = r[jdx]\nC = cdist(a, b, 'sqeuclidean')/2 + W[y[idx,None], ry[jdx][None,:]+10]/2\nC_max = C.max()\nn, m = len(idx), len(jdx)\n\nz1 = torch.tensor(np.column_stack([a, y[idx]]), dtype=torch.float32)[None]\nz2 = torch.tensor(np.column_stack([b, ry[jdx]+10]), dtype=torch.float32)[None]\n\n# Canonical: POT + GeomLoss\nt0 = time.perf_counter()\nP_can = ot.sinkhorn(np.ones(n)/n, np.ones(m)/m, C/C_max, 0.1)\nbc_can = float(np.sum(P_can * C)) / (n + m)\nt_pot = time.perf_counter() - t0\n\npot_f = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                    potentials=True, cost=cost_fn(W), backend='tensorized')\nt0 = time.perf_counter()\nwith torch.inference_mode(): f_c, _ = pot_f(z1, z2)\nt_geom = time.perf_counter() - t0\n\nprint(f'Canonical pair: POT={t_pot:.3f}s + GeomLoss(F)={t_geom:.3f}s = {t_pot+t_geom:.3f}s')\nprint(f'  bc_can={bc_can:.8f}')\n\n# v17: matched-blur GeomLoss (batchcost) + canonical GeomLoss (F)\nblur_matched = np.sqrt(0.1 * C_max)\npot_bc = SamplesLoss('sinkhorn', p=2, blur=blur_matched, debias=False,\n                     potentials=True, cost=cost_fn(W), backend='tensorized')\n\nt0 = time.perf_counter()\nwith torch.inference_mode(): f_m, g_m = pot_bc(z1, z2)\nt_bc_geom = time.perf_counter() - t0\nreg_m = 0.1 * C_max\nP_m = (1.0/n) * (1.0/m) * np.exp((f_m.numpy().ravel()[:,None] + g_m.numpy().ravel()[None,:] - C) / reg_m)\nbc_m = float(np.sum(P_m * C)) / (n + m)\n\n# F from canonical GeomLoss (same as before)\nt0 = time.perf_counter()\nwith torch.inference_mode(): f_f, _ = pot_f(z1, z2)\nt_f_geom = time.perf_counter() - t0\n\nprint(f'v17 pair: GeomLoss(bc)={t_bc_geom:.3f}s + GeomLoss(F)={t_f_geom:.3f}s = {t_bc_geom+t_f_geom:.3f}s')\nprint(f'  bc_m={bc_m:.8f}, rel_diff={abs(bc_m-bc_can)/bc_can:.6e}')\n\n# v17b: same GeomLoss object reused (might be faster due to caching)\nt0 = time.perf_counter()\nwith torch.inference_mode(): \n    f_m2, g_m2 = pot_bc(z1, z2)\n    f_f2, _ = pot_f(z1, z2)\nt_both = time.perf_counter() - t0\nprint(f'v17 both GeomLoss: {t_both:.3f}s')\n\\\" 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

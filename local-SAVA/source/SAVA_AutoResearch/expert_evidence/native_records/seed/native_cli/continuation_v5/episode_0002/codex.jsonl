{"type": "item.started", "item": {"id": "item_92", "type": "command_execution", "command": "/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np, time\nimport torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nfrom scipy.special import logsumexp\nfrom scipy.stats import spearmanr\nimport sys\n\n# Canonical method\nsys.path.insert(0, '/tmp/research_history')\nimport method_canonical_v0 as mc\nimport importlib\nimportlib.reload(mc)\n\ndata = np.load('/workspace/environment/public_assets/dev/seed_101_uniform_labels.npz')\nx, y, r, ry = data['x'], data['y'], data['r'], data['ry']\nx = np.asarray(x, np.float32); r = np.asarray(r, np.float32)\ny = np.asarray(y, np.int64); ry = np.asarray(ry, np.int64)\ntorch.set_num_threads(2)\n\nt0 = time.perf_counter()\nv_c = mc.value(x, y, r, ry, seed=101)\nt_c = time.perf_counter() - t0\nprint(f'Canonical: {t_c:.3f}s')\n\n# Test: single GeomLoss solve per pair, no POT\n# Use POT-like normalized cost for batchcost from GeomLoss\n# Key: GeomLoss uses cost = sqeuclidean/2 + W/2, at reg=0.1\n# Canonical batch cost uses same C, but normalized by C_max with reg=0.1\n# These are DIFFERENT problems\"'! \n# Try: use GeomLoss at matched reg (C_max * 0.1)\nbatch_size = 1024\ntx = [np.arange(i, min(i+batch_size, len(x))) for i in range(0, len(x), batch_size)]\ntr = [np.arange(i, min(i+batch_size, len(r))) for i in range(0, len(r), batch_size)]\n\n# Get W\ndef label_cost_geom(x_, y_, r_, ry_):\n    xx = torch.tensor(np.concatenate([x_, r_]), dtype=torch.float32)\n    yy = np.concatenate([y_, ry_ + 10])\n    W = np.zeros((20, 20), dtype=np.float32)\n    loss = SamplesLoss('\"'sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\n    with torch.inference_mode():\n        for i in range(20):\n            for j in range(i+1, 20):\n                W[i,j] = W[j,i] = float(loss(xx[yy==i], xx[yy==j]))\n    return W\nW = label_cost_geom(x[tx[0]], y[tx[0]], r[tr[0]], ry[tr[0]])\n\ndef cost_fn(W):\n    def cost(z1, z2):\n        d = torch.cdist(z1[:, :, :-1], z2[:, :, :-1]).square() / 2\n        return d + torch.as_tensor(W)[z1[:, :, -1].long().unsqueeze(2),\n                                       z2[:, :, -1].long().unsqueeze(1)] / 2\n    return cost\n\n# Compute for one pair both ways\nidx = tx[0]; jdx = tr[0]\na = x[idx]; b = r[jdx]\nC = cdist(a, b, 'sqeuclidean')/2 + W[y[idx,None], ry[jdx][None,:]+10]/2\nC_max = C.max()\n\nimport ot\nP_can = ot.sinkhorn(np.ones(len(idx))/len(idx), np.ones(len(jdx))/len(jdx), C/C_max, 0.1)\nbc_can = float(np.sum(P_can * C)) / (len(idx) + len(jdx))\nprint(f'Canonical batchcost: {bc_can:.8f}, C_max={C_max:.2f}')\n\n# GeomLoss at canonical reg (blur=sqrt(0.1))\npotential = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                       potentials=True, cost=cost_fn(W), backend='tensorized')\nz1 = torch.tensor(np.column_stack([a, y[idx]]), dtype=torch.float32)[None]\nz2 = torch.tensor(np.column_stack([b, ry[jdx]+10]), dtype=torch.float32)[None]\nwith torch.inference_mode(): f_t, g_t = potential(z1, z2)\nf = f_t.numpy().ravel().astype(np.float64)\ng = g_t.numpy().ravel().astype(np.float64)\nprint(f'GeomLoss reg=0.1: f range=[{f.min():.2f}, {f.max():.2f}]')\n\n# Reconstruct P from GeomLoss potentials\nreg = 0.1\nn, m = len(idx), len(jdx)\nP_geom = (1.0/n) * (1.0/m) * np.exp((f[:, None] + g[None, :] - C) / reg)\nbc_geom = float(np.sum(P_geom * C)) / (n + m)\nprint(f'GeomLoss batchcost (P recon): {bc_geom:.8f}, ratio={bc_geom/bc_can:.6f}')\nprint(f'P_geom sum: {P_geom.sum():.6f}')\nprint(f'P_geom row sums: [{P_geom.sum(1).min():.6f}, {P_geom.sum(1).max():.6f}]')\n\n# Refine P from GeomLoss init with a few Sinkhorn iters on normalized problem\na_w = np.ones(n)/n; b_w = np.ones(m)/m\nC_norm = C / C_max\nreg_norm = 0.1\n# Get dual potentials for normalized problem: f_norm = f / C_max, g_norm = g / C_max\n# But these are from reg=0.1 on unnormalized C, not reg=0.1 on normalized C\n# So we can't just divide...\n# Instead: use GeomLoss f,g as warm start for the normalized problem\n# via a few log-domain Sinkhorn iters\nf_norm_init = f.copy()\ng_norm_init = g.copy()\n# Actually, f and g are in units of C (unscaled). To match C_norm with reg=0.1:\n# C_norm = C/C_max, so f_norm = f/C_max, g_norm = g/C_max, reg_norm=0.1 means reg = 0.1*C_max\n# GeomLoss uses reg=0.1 on unnormalized C. So it's a DIFFERENT problem.\n\n# Let me compute directly: for the unnormalized problem with reg=0.1,\n# sum(P*C) = ?\nP_geom_un = (1.0/n) * (1.0/m) * np.exp((f[:, None] + g[None, :] - C) / 0.1)\nprint(f'GeomLoss P (reg=0.1, unnormalized): sum={P_geom_un.sum():.6f}')\nprint(f'  row sums: [{P_geom_un.sum(1).min():.6f}, {P_geom_un.sum(1).max():.6f}]')\nprint(f'  col sums: [{P_geom_un.sum(0).min():.6f}, {P_geom_un.sum(0).max():.6f}]')\n\\\" 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

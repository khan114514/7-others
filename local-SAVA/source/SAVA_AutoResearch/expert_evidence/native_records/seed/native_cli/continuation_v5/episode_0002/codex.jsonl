{"type": "item.completed", "item": {"id": "item_24", "type": "command_execution", "command": "/bin/sh -lc 'cat /tmp/research_history/method_v13_matched_logrefine.py'", "aggregated_output": "\"\"\"v13: GeomLoss for both F and batchcost (matched reg + log-domain refinement).\n- Eliminates slow POT sinkhorn for batch cost\n- Uses matched effective reg to match canonical\n- Adds a few log-domain Sinkhorn iterations for accuracy\n- Uses larger reg for Q-level Sinkhorn for robustness\n\"\"\"\nimport numpy as np\nimport torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nfrom scipy.special import logsumexp\nimport ot\n\n\ndef _label_cost(x, y, r, ry):\n    xx = torch.tensor(np.concatenate([x, r]), dtype=torch.float32)\n    yy = np.concatenate([y, ry + 10])\n    W = np.zeros((20, 20), dtype=np.float32)\n    loss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\n    with torch.inference_mode():\n        for i in range(20):\n            for j in range(i + 1, 20):\n                if not (yy == i).any() or not (yy == j).any():\n                    raise ValueError('Initial batch lacks a label support')\n                W[i, j] = W[j, i] = float(loss(xx[yy == i], xx[yy == j]))\n    return W\n\n\ndef value(x, y, r, ry, seed=17, batch_size=1024):\n    torch.set_num_threads(2)\n    x = np.asarray(x, np.float32); r = np.asarray(r, np.float32)\n    y = np.asarray(y, np.int64); ry = np.asarray(ry, np.int64)\n    tx = [np.arange(i, min(i + batch_size, len(x))) for i in range(0, len(x), batch_size)]\n    tr = [np.arange(i, min(i + batch_size, len(r))) for i in range(0, len(r), batch_size)]\n\n    W = _label_cost(x[tx[0]], y[tx[0]], r[tr[0]], ry[tr[0]])\n\n    def cost(z1, z2):\n        d = torch.cdist(z1[:, :, :-1], z2[:, :, :-1]).square() / 2\n        return d + torch.as_tensor(W)[z1[:, :, -1].long().unsqueeze(2),\n                                      z2[:, :, -1].long().unsqueeze(1)] / 2\n\n    # For F: canonical reg (blur=sqrt(0.1))\n    potential = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                            potentials=True, cost=cost, backend='tensorized')\n\n    F = {}\n    batchcost = np.zeros((len(tx), len(tr)))\n\n    for i, idx in enumerate(tx):\n        for j, jdx in enumerate(tr):\n            a = x[idx]; b = r[jdx]\n            n_src = len(idx); n_tgt = len(jdx)\n            z1 = torch.tensor(np.column_stack([a, y[idx]]), dtype=torch.float32)[None]\n            z2 = torch.tensor(np.column_stack([b, ry[jdx] + 10]), dtype=torch.float32)[None]\n\n            # F from canonical GeomLoss (reg=0.1)\n            with torch.inference_mode():\n                f_t, _ = potential(z1, z2)\n            f = f_t.numpy().ravel().astype(np.float64)\n            F[i, j] = (f - f.mean()) * n_src / (n_src - 1)\n\n            # Batchcost from matched-reg GeomLoss + log-domain refinement\n            C = cdist(a, b, 'sqeuclidean') / 2.0 + W[y[idx[:, None]], ry[jdx[None, :]] + 10] / 2.0\n            c_max = float(C.max())\n            reg_match = 0.1 * c_max\n            blur_match = np.sqrt(reg_match)\n            pot_match = SamplesLoss('sinkhorn', p=2, blur=blur_match, debias=False,\n                                   potentials=True, cost=cost, backend='tensorized')\n            with torch.inference_mode():\n                fm_t, gm_t = pot_match(z1, z2)\n            fm = fm_t.numpy().ravel().astype(np.float64)\n            gm = gm_t.numpy().ravel().astype(np.float64)\n\n            # Log-domain refinement (a few iters for accuracy)\n            a_log = np.full(n_src, -np.log(n_src), dtype=np.float64)\n            b_log = np.full(n_tgt, -np.log(n_tgt), dtype=np.float64)\n            for _ in range(5):\n                fm = -reg_match * logsumexp(b_log[None, :] + gm[None, :] / reg_match - C / reg_match, axis=1)\n                gm = -reg_match * logsumexp(a_log[:, None] + fm[:, None] / reg_match - C / reg_match, axis=0)\n\n            # Reconstruct P and compute batchcost\n            P = np.exp(a_log[:, None] + b_log[None, :] + (fm[:, None] + gm[None, :] - C) / reg_match)\n            batchcost[i, j] = float(np.sum(P * C)) / (n_src + n_tgt)\n\n    Q = ot.sinkhorn(ot.unif(len(tx)), ot.unif(len(tr)),\n                    batchcost / max(float(batchcost.max()), 1e-12), .01,\n                    numItermax=10000, stopThr=1e-10)\n    residual = max(np.max(np.abs(Q.sum(1) - ot.unif(len(tx)))),\n                   np.max(np.abs(Q.sum(0) - ot.unif(len(tr)))))\n    if residual > 1e-6:\n        raise ValueError(f'Unconverged batch transport: {residual}')\n\n    values = np.zeros(len(x))\n    for i, idx in enumerate(tx):\n        values[idx] = sum(Q[i, j] * F[i, j] for j in range(len(tr)))\n    return values\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_25", "type": "command_execution", "command": "/bin/sh -lc 'cat /tmp/research_history/last_stopped_method_v15.py'", "aggregated_output": "\"\"\"v15: POT-accelerated Sinkhorn with potential derivation from coupling.\nUses ot.sinkhorn (C-optimized) instead of numpy log-domain loop.\nSingle full pair (N x M) to minimize pair count.\nPotentials derived from P via Sinkhorn relation f_i + g_j = eps*log(P_ij nm) + C_ij.\n\"\"\"\nimport numpy as np\nimport torch\nimport ot\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\n\n\ndef _label_cost(x, y, r, ry):\n    xx = torch.tensor(np.concatenate([x, r]), dtype=torch.float32)\n    yy = np.concatenate([y, ry + 10])\n    W = np.zeros((20, 20), dtype=np.float32)\n    loss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\n    with torch.inference_mode():\n        for i in range(20):\n            for j in range(i + 1, 20):\n                if not (yy == i).any() or not (yy == j).any():\n                    raise ValueError('Initial batch lacks a label support')\n                W[i, j] = W[j, i] = float(loss(xx[yy == i], xx[yy == j]))\n    return W\n\n\ndef _sinkhorn_potentials(C, reg, a_w, b_w, max_iter=2000):\n    \"\"\"Return (f, g, P) using POT's sinkhorn then deriving potentials.\"\"\"\n    n, m = C.shape\n    P = ot.sinkhorn(a_w, b_w, C, reg, numItermax=max_iter)\n    # Sinkhorn relation: P_ij = a_i b_j exp((f_i + g_j - C_ij)/reg)\n    # => f_i + g_j = reg * log(P_ij / (a_i b_j)) + C_ij\n    log_ratio = np.log(P + 1e-300) - np.log(a_w[:, None]) - np.log(b_w[None, :])\n    fg_sum = reg * log_ratio + C\n    f = fg_sum.mean(axis=1)\n    g = fg_sum.mean(axis=0)\n    # Center (potentials are defined up to constant)\n    offset = (f.mean() + g.mean()) / 2\n    f = f - offset\n    g = g - offset\n    return f, g, P\n\n\ndef value(x, y, r, ry, seed=17, batch_size=4096):\n    torch.set_num_threads(2)\n    x = np.asarray(x, np.float32)\n    r = np.asarray(r, np.float32)\n    y = np.asarray(y, np.int64)\n    ry = np.asarray(ry, np.int64)\n    N = len(x)\n    M = len(r)\n\n    tx = [np.arange(i, min(i + batch_size, N)) for i in range(0, N, batch_size)]\n    tr = [np.arange(i, min(i + batch_size, M)) for i in range(0, M, batch_size)]\n\n    W = _label_cost(x[tx[0]], y[tx[0]], r[tr[0]], ry[tr[0]])\n\n    eps = 0.1\n    F = {}\n    batchcost = np.zeros((len(tx), len(tr)))\n\n    for i, idx in enumerate(tx):\n        for j, jdx in enumerate(tr):\n            a = x[idx].astype(np.float64)\n            b = r[jdx].astype(np.float64)\n            n_src = len(idx)\n            n_tgt = len(jdx)\n\n            C = cdist(a, b, 'sqeuclidean') / 2.0 + W[y[idx[:, None]], ry[jdx[None, :]] + 10].astype(np.float64) / 2.0\n\n            f, g, P = _sinkhorn_potentials(C, eps,\n                                           np.ones(n_src) / n_src,\n                                           np.ones(n_tgt) / n_tgt,\n                                           max_iter=2000)\n\n            batchcost[i, j] = float(np.sum(P * C)) / (n_src + n_tgt)\n            f64 = f.astype(np.float64)\n            F[i, j] = (f64 - f64.mean()) * n_src / (n_src - 1)\n\n    bc_max = max(float(batchcost.max()), 1e-12)\n    Q = ot.sinkhorn(np.ones(len(tx)) / len(tx),\n                    np.ones(len(tr)) / len(tr),\n                    batchcost / bc_max, .01,\n                    numItermax=10000, stopThr=1e-10)\n    residual = max(np.max(np.abs(Q.sum(1) - 1.0 / len(tx))),\n                   np.max(np.abs(Q.sum(0) - 1.0 / len(tr))))\n    if residual > 1e-6:\n        raise ValueError(f'Unconverged batch transport: {residual}')\n\n    values = np.zeros(N)\n    for i, idx in enumerate(tx):\n        values[idx] = sum(Q[i, j] * F[i, j] for j in range(len(tr)))\n    return values\n", "exit_code": 0, "status": "completed"}}

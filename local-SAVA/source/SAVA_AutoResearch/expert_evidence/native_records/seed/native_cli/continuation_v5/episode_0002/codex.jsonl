{"type": "item.started", "item": {"id": "item_90", "type": "command_execution", "command": "/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np, time\nimport torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\n\ndata = np.load('/workspace/environment/public_assets/dev/seed_101_uniform_labels.npz')\nx, y, r, ry = data['x'], data['y'], data['r'], data['ry']\nx = np.asarray(x, np.float32); r = np.asarray(r, np.float32)\ny = np.asarray(y, np.int64); ry = np.asarray(ry, np.int64)\ntorch.set_num_threads(2)\n\nbatch_size = 1024\n# Get canonical W\ndef label_cost_geom(x_, y_, r_, ry_):\n    xx = torch.tensor(np.concatenate([x_, r_]), dtype=torch.float32)\n    yy = np.concatenate([y_, ry_ + 10])\n    W = np.zeros((20, 20), dtype=np.float32)\n    loss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\n    with torch.inference_mode():\n        for i in range(20):\n            for j in range(i+1, 20):\n                W[i,j] = W[j,i] = float(loss(xx[yy==i], xx[yy==j]))\n    return W\n\nW_canon = label_cost_geom(x[:batch_size], y[:batch_size], r[:batch_size], ry[:batch_size])\n\n# Test: faster GeomLoss with higher blur\n# Higher blur = less accurate but faster Sinkhorn\nxx_full = torch.tensor(np.concatenate([x[:batch_size], r[:batch_size]]), dtype=torch.float32)\nyy_full = np.concatenate([y[:batch_size], ry[:batch_size] + 10])\n\nfor blur_val in [np.sqrt(.1), np.sqrt(.2), np.sqrt(.5), np.sqrt(1.0), np.sqrt(2.0)]:\n    t0 = time.perf_counter()\n    W = np.zeros((20, 20), dtype=np.float32)\n    loss = SamplesLoss('sinkhorn', p=2, blur=blur_val, debias=False, backend='tensorized')\n    with torch.inference_mode():\n        for i in range(20):\n            for j in range(i+1, 20):\n                W[i,j] = W[j,i] = float(loss(xx_full[yy_full==i], xx_full[yy_full==j]))\n    t1 = time.perf_counter()\n    mask = ~np.eye(20, dtype=bool)\n    rel_err = np.abs(W_canon[mask] - W[mask]) / np.maximum(W_canon[mask], 1e-10)\n    print(f'blur={blur_val:.3f}: {t1-t0:.3f}s, max rel err: {rel_err.max():.4f}, mean rel err: {rel_err.mean():.4f}')\n\\\" 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

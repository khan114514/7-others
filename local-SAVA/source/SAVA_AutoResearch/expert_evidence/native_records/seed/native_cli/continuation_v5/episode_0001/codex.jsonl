potentials=True,cost=cost,backend='tensorized')\n\nF = {}\nbatchcost = np.zeros((len(tx), len(tr)))\nfor i, idx in enumerate(tx):\n    for j, jdx in enumerate(tr):\n        a = x[idx]; b = r[jdx]\n        C = cdist(a,b,'sqeuclidean')/2 + W[y[idx,None],ry[jdx][None,:]+10]/2\n        P = ot.sinkhorn(ot.unif(len(idx)),ot.unif(len(jdx)),C/max(float(C.max()),1e-12),.1)\n        batchcost[i,j]=float(np.sum(P*C))/(len(idx)+len(jdx))\n        z1=torch.tensor(np.column_stack([a,y[idx]]),dtype=torch.float32)[None]\n        z2=torch.tensor(np.column_stack([b,ry[jdx]+10]),dtype=torch.float32)[None]\n        with torch.inference_mode(): f,_=potential(z1,z2)\n        f=f.numpy().ravel().astype(float)\n        F[i,j]=(f-f.mean())*len(f)/(len(f)-1)\n\nQ = ot.sinkhorn(ot.unif(len(tx)), ot.unif(len(tr)),\n              batchcost/max(float(batchcost.max()),1e-12), .01,\n              numItermax=10000, stopThr=1e-10)\nprint(\\\"batchcost:\\\")\nprint(batchcost)\nprint(\\\"Q:\\\")\nprint(Q)\nprint(\\\"Row sums:\\\", Q.sum(axis=1))\nprint(\\\"Col sums:\\\", Q.sum(axis=0))\nprint(\\\"Uniform Q would be:\\\", 1/(len(tx)*len(tr)))\n\n# Compute values with uniform Q\nvalues_uniform = np.zeros(len(x))\nfor i, idx in enumerate(tx):\n    values_uniform[idx] = sum(F[i,j] for j in range(len(tr))) / len(tr)\n\nnrmse = np.sqrt(np.mean((values_uniform - v_canon)**2)) / np.std(v_canon)\nspearman, _ = stats.spearmanr(values_uniform, v_canon)\nn = len(v_canon)\ntopk = n // 4\nidx_c = np.argsort(-v_canon)[:topk]\nidx_u = np.argsort(-values_uniform)[:topk]\noverlap = len(np.intersect1d(idx_c, idx_u)) / topk\nprint(f\\\"\\\\nUniform Q vs canonical:\\\")\nprint(f\\\"NRMSE: {nrmse:.6f}\\\")\nprint(f\\\"Spearman: {spearman:.10f}\\\")\nprint(f\\\"Top overlap: {overlap:.4f}\\\")\nPYEOF\npython3 /tmp/test_q_uniform.py\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

{"type": "item.started", "item": {"id": "item_42", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/test_v16_theory.py << 'PYEOF'\nimport numpy as np\nimport torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nimport ot\nimport sys, time\n\nsys.path.insert(0, '/workspace/solution')\n\ntorch.set_num_threads(2)\n\ndata = np.load('/workspace/environment/public_assets/dev/seed_101_gaussian_008.npz')\nx = data['x'].astype(np.float32)\ny = data['y'].astype(np.int64)\nr = data['r'].astype(np.float32)\nry = data['ry'].astype(np.int64)\nprint(f\\\"N={len(x)}, M={len(r)}\\\")\n\n# Canonical setup, batch 0\nbatch_size = 1024\ntx = [np.arange(i, min(i+batch_size, len(x))) for i in range(0, len(x), batch_size)]\ntr = [np.arange(i, min(i+batch_size, len(r))) for i in range(0, len(r), batch_size)]\n\ndef _label_cost(x,y,r,ry):\n    xx=torch.tensor(np.concatenate([x,r]),dtype=torch.float32)\n    yy=np.concatenate([y,ry+10])\n    W=np.zeros((20,20),dtype=np.float32)\n    loss=SamplesLoss('sinkhorn',p=2,blur=np.sqrt(.1),debias=False,backend='tensorized')\n    with torch.inference_mode():\n        for i in range(20):\n            for j in range(i+1,20):\n                if not (yy==i).any() or not (yy==j).any():\n                    raise ValueError('Initial batch lacks a label support')\n                W[i,j]=W[j,i]=float(loss(xx[yy==i],xx[yy==j]))\n    return W\n\nW = _label_cost(x[tx[0]], y[tx[0]], r[tr[0]], ry[tr[0]])\n\ndef cost(z1,z2):\n    d=torch.cdist(z1[:,:,:-1],z2[:,:,:-1]).square()/2\n    return d+torch.as_tensor(W)[z1[:,:,-1].long().unsqueeze(2),z2[:,:,-1].long().unsqueeze(1)]/2\n\npotential=SamplesLoss('sinkhorn',p=2,blur=np.sqrt(.1),debias=False,\n                     potentials=True,cost=cost,backend='tensorized')\n\n# Pair (0,0)\nidx = tx[0]\njdx = tr[0]\na = x[idx]; b = r[jdx]\nn_src = len(idx); n_tgt = len(jdx)\n\n# Canonical batchcost via POT\nC = cdist(a,b,'sqeuclidean')/2 + W[y[idx,None],ry[jdx][None,:]+10]/2\nC_max = max(float(C.max()), 1e-12)\nP_canon = ot.sinkhorn(ot.unif(n_src), ot.unif(n_tgt), C / C_max, .1)\nbc_canon = float(np.sum(P_canon * C)) / (n_src + n_tgt)\n\n# Canonical potentials via GeomLoss\nz1=torch.tensor(np.column_stack([a,y[idx]]),dtype=torch.float32)[None]\nz2=torch.tensor(np.column_stack([b,ry[jdx]+10]),dtype=torch.float32)[None]\nwith torch.inference_mode():\n    f_t, g_t = potential(z1, z2)\nf_np = f_t.numpy().ravel().astype(np.float64)\ng_np = g_t.numpy().ravel().astype(np.float64)\n\n# GeomLoss Sinkhorn loss value\nloss_fn = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, cost=cost, backend='tensorized')\nwith torch.inference_mode():\n    loss_val = float(loss_fn(z1, z2))\n\n# GeomLoss uses blurring = sqrt(reg) for p=2\n# So reg = blur\"'^2 = 0.1\n# Sinkhorn loss = <f, a> + <g, b>  (with debias=False)\n# Let'\"'s verify\na_w = 1.0/n_src\nb_w = 1.0/n_tgt\nf_mean = f_np.mean()\ng_mean = g_np.mean()\nprint(f\\\"GeomLoss loss: {loss_val:.10f}\\\")\nprint(f\\\"<f,a>+<g,b>: {f_np.dot(np.ones(n_src)/n_src)+g_np.dot(np.ones(n_tgt)/n_tgt):.10f}\\\")\nprint(f\\\"f_mean + g_mean: {f_mean + g_mean:.10f}\\\")\n\n# Now try to compute batchcost from GeomLoss potentials\n# P_ij = a_i * b_j * exp((f_i + g_j - C_ij) / reg)\n# batchcost = sum(P * C) / (n + m)\nreg = 0.1  # blur\"'^2 = (sqrt(0.1))''^2 = 0.1\nP_gl = a_w * b_w * np.exp((f_np[:, None] + g_np[None, :] - C) / reg)\nbc_from_gl = float(np.sum(P_gl * C)) / (n_src + n_tgt)\nprint(f\"Canonical batchcost: {bc_canon:.10f}\")\nprint(f\"GeomLoss-derived batchcost: {bc_from_gl:.10f}\")\nprint(f\"Ratio: {bc_from_gl / bc_canon:.6f}\")\n\n# Check row/col sums of P_gl\nprint(f\"P row sum (should be a): {P_gl.sum(axis=1)[:3]}\")\nprint(f\"P col sum (should be b): {P_gl.sum(axis=0)[:3]}\")\nprint(f\"a[0]={a_w}\")\n\n# Now check: does POT Sinkhorn with reg=0.1 (unscaled C) give same potentials?\n# Canonical uses C/C_max with reg=0.1, so effective reg on actual cost is 0.1*C_max\nP_pot_unscaled = ot.sinkhorn(ot.unif(n_src), ot.unif(n_tgt), C, 0.1*C_max)\nbc_pot_unscaled = float(np.sum(P_pot_unscaled * C)) / (n_src + n_tgt)\nprint(f\"POT with reg=0.1*C_max batchcost: {bc_pot_unscaled:.10f}\")\nprint(f\"Same as canonical? {abs(bc_pot_unscaled - bc_canon) < 1e-12}\")\n\n# Now try GeomLoss-based batchcost using the same formula as POT\n# The Sinkhorn loss (regularized) = sum(P*C) + reg*KL(P||a b''^T) = <f,a> + <g,b>\n# But batchcost = sum(P*C) / (n+m)  (unregularized transport cost)\n# From duality: S = sum(P*C) + reg*(sum(P log P) - sum(P log a) - sum(P log b))\n# = sum(P*C) + reg*H(P|a,b)\n# S = <f,a> + <g,b>  (dual)\n# Hmm, but we want sum(P*C), not S.\n\n# Actually from P = diag(a) K diag(b) where K = exp(-C/reg), \n# we have sum(P*C) = sum(a_i b_j exp(f_i/reg + g_j/reg - C_ij/reg) * C_ij)\n# but we can also get it from potentials:\n# sum(P*C) = <f, a> + <g, b> - reg * sum(P log(P / (a b''^T)))\n# = S - reg * KL divergence...\n\n# Wait. Let me just check numerically: \n# Sinkhorn loss = sum_ij P_ij C_ij + reg * KL(P || a b''^T)\n# = <f,a> + <g, b>\n# and batchcost = sum(P*C) / (n+m)\n# So if we know P from potentials, sum(P*C) = sum_ij a_i b_j exp((f_i+g_j-C_ij)/reg) * C_ij\n\n# But POT'\"'s batchcost is sum(P_canon * C) / (n+m)\n# where P_canon uses C/C_max with reg 0.1 (so effective reg = 0.1*C_max)\n# and GeomLoss uses reg = 0.1 (not scaled by C_max)\n# So they use DIFFERENT regularization\"'!\nprint(f\"'\"\\\\nC_max = {C_max}\\\")\nprint(f\\\"POT effective reg = {0.1 * C_max}\\\")\nprint(f\\\"GeomLoss reg = 0.1\\\")\nPYEOF\npython3 /tmp/test_v16_theory.py\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

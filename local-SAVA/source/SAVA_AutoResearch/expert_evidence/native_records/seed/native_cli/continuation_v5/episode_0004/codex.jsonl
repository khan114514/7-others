{"type": "item.started", "item": {"id": "item_53", "type": "command_execution", "command": "/bin/sh -lc \"python3 << 'EOF'\n# Test: fast log-domain NumPy Sinkhorn accuracy and speed\nimport numpy as np, time\nfrom scipy.spatial.distance import cdist\nfrom scipy.special import logsumexp\nimport ot\n\nnp.random.seed(42)\nn, m = 1024, 1024\na = np.random.randn(n, 10).astype(np.float32)\nb = np.random.randn(m, 10).astype(np.float32)\nC = (cdist(a, b, 'sqeuclidean') / 2.0).astype(np.float64)\nC_max = C.max()\nC_norm = C / C_max\nreg = 0.1\n\na_w = np.ones(n) / n\nb_w = np.ones(m) / m\nlog_a = np.log(a_w)\nlog_b = np.log(b_w)\n\n# POT sinkhorn (canonical)\nt0 = time.time()\nP_pot = ot.sinkhorn(a_w, b_w, C_norm, reg)\nprint(f'POT sinkhorn: {time.time()-t0:.3f}s')\not_cost = np.sum(P_pot * C)\n\n# Log-domain NumPy Sinkhorn\ndef log_sinkhorn(log_a, log_b, C, reg, max_iter=1000, tol=1e-10):\n    f = np.zeros_like(log_a)\n    g = np.zeros_like(log_b)\n    for it in range(max_iter):\n        f_prev = f\n        f = -reg * logsumexp(log_b[None, :] + (g[None, :] - C) / reg, axis=1)\n        g = -reg * logsumexp(log_a[:, None] + (f[:, None] - C) / reg, axis=0)\n        if np.max(np.abs(f - f_prev)) < tol:\n            break\n    log_P = log_a[:, None] + log_b[None, :] + (f[:, None] + g[None, :] - C) / reg\n    P = np.exp(log_P)\n    return P, it\n\nt0 = time.time()\nP_np, iters = log_sinkhorn(log_a, log_b, C_norm, reg, max_iter=500, tol=1e-10)\nprint(f'NumPy log-sinkhorn ({iters} iters): {time.time()-t0:.3f}s')\nnp_cost = np.sum(P_np * C)\n\nprint(f'POT cost: {ot_cost:.10f}')\nprint(f'NP cost:  {np_cost:.10f}')\nprint(f'Relative diff: {abs(ot_cost - np_cost) / ot_cost:.2e}')\n\n# Try fewer iterations\nfor mi in [20, 50, 100, 200]:\n    t0 = time.time()\n    P_fast, iters = log_sinkhorn(log_a, log_b, C_norm, reg, max_iter=mi, tol=1e-15)\n    elapsed = time.time() - t0\n    fast_cost = np.sum(P_fast * C)\n    rel = abs(ot_cost - fast_cost) / ot_cost\n    # Marginal error\n    row_err = np.max(np.abs(P_fast.sum(1) - a_w))\n    col_err = np.max(np.abs(P_fast.sum(0) - b_w))\n    print(f'  {mi} iters ({elapsed*1000:.1f}ms): cost_rel={rel:.2e}, row_err={row_err:.2e}, col_err={col_err:.2e}')\nEOF\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

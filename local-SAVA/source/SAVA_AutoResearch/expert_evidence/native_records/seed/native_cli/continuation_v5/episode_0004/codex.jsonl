{"type": "item.started", "item": {"id": "item_71", "type": "command_execution", "command": "/bin/sh -lc \"python3 << 'EOF'\n# GeomLoss loss (sqdist/2 cost, p=2, blur=sqrt(0.1)) = 0.6706\n# NumPy loss (C=sqdist/2, reg=0.1) = 0.6495\n# They don't match\"'! So the convention is different.\n# \n# Let me figure out what reg makes numpy match geomloss\n\nimport numpy as np, torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nfrom scipy.special import logsumexp\n\nnp.random.seed(42)\ntorch.set_num_threads(2)\n\nn, m = 100, 80\na = np.random.randn(n, 3).astype(np.float32)\nb = np.random.randn(m, 3).astype(np.float32)\nza = torch.tensor(a, dtype=torch.float32)[None]\nzb = torch.tensor(b, dtype=torch.float32)[None]\n\ndef cost_sqhalf(z1, z2):\n    return torch.cdist(z1, z2).square() / 2.0\n\npot = SamplesLoss('\"'sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                  potentials=True, cost=cost_sqhalf, backend='tensorized')\nwith torch.inference_mode():\n    f_g, g_g = pot(za, zb)\nf_g = f_g.numpy().ravel().astype(np.float64)\ng_g = g_g.numpy().ravel().astype(np.float64)\nloss_g = float(pot(za, zb))\n\nC = cdist(a, b, 'sqeuclidean').astype(np.float64) / 2.0\na_w = np.ones(n) / n; b_w = np.ones(m) / m\nlog_a = np.log(a_w); log_b = np.log(b_w)\n\ndef sinkhorn_loss(C, reg, max_iter=5000):\n    f, g = np.zeros(n), np.zeros(m)\n    for _ in range(max_iter):\n        f = -reg * logsumexp(log_b[None, :] + (g[None, :] - C) / reg, axis=1)\n        g = -reg * logsumexp(log_a[:, None] + (f[:, None] - C) / reg, axis=0)\n    loss = np.sum(a_w * f) + np.sum(b_w * g)\n    return loss, f, g\n\n# Binary search for the right reg\nlo, hi = 0.01, 1.0\nfor _ in range(30):\n    mid = (lo + hi) / 2\n    l, _, _ = sinkhorn_loss(C, mid)\n    if l < loss_g:\n        lo = mid\n    else:\n        hi = mid\nbest_reg = (lo + hi) / 2\nloss_best, f_best, g_best = sinkhorn_loss(C, best_reg)\nprint(f'GeomLoss loss: {loss_g:.6f}')\nprint(f'Best reg: {best_reg:.6f}')\nprint(f'Best loss: {loss_best:.6f}')\nprint(f'blur\"'^2 = {np.sqrt(0.1)**2:.6f}'\"')\nprint(f'blur = {np.sqrt(0.1):.6f}')\nprint(f'ratio best_reg/blur\"'^2 = {best_reg / 0.1:.4f}'\"')\nprint(f'ratio best_reg/blur = {best_reg / np.sqrt(0.1):.4f}')\n\n# Maybe GeomLoss uses cost\"'^(p/2) internally and then eps = blur''^p?\n# For p=2: cost''^(p/2) = cost''^1 = cost, so same thing...\n# \n# Wait: what about the 1/p factor? \n# GeomLoss default uses (1/p)||x-y||''^p = sqdist/2\n# My custom cost also returns sqdist/2\n# The loss values match between default and custom sqhalf (both 0.6706)\n# But NumPy gives 0.6495\n\n# Let me verify: maybe the issue is debias=False vs debias with reference?\n# Or maybe GeomLoss uses a different formula\n\n# Check: S_eps = min_P <P,C> + eps*KL(P||alpha x beta)\n# The dual: max_{f,g} sum_i alpha_i f_i + sum_j beta_j g_j \n#           s.t. f_i + g_j <= C_ij + eps*(log(f_i/alpha_i) + log(g_j/beta_j))...\n# Wait, no. The standard Sinkhorn dual is:\n# max_{f,g} sum_i alpha_i f_i + sum_j beta_j g_j - eps * sum_{i,j} e''^{(f_i + g_j - C_ij)/eps} alpha_i beta_j\n# \n# And the first-order conditions give:\n# P_ij = alpha_i beta_j e''^{(f_i + g_j - C_ij)/eps}\n# f_i = -eps * log(sum_j beta_j e''^{(g_j - C_ij)/eps})\n# g_j = -eps * log(sum_i alpha_i e''^{(f_i - C_ij)/eps})\n# \n# This is what I implemented...\n\n# Let me check POT too for comparison\nimport ot\nP = ot.sinkhorn(a_w, b_w, C / C.max(), 0.1)\n# Wait, POT normalizes cost. Let me do it properly.\nP2 = ot.sinkhorn(a_w, b_w, C, 0.1)\nloss_pot = np.sum(P2 * C) - 0.1 * (np.sum(P2 * np.log(P2 / (a_w[:, None] * b_w[None, :]))))\nprint(f'\"'\\\\nPOT sinkhorn (reg=0.1, no normalization):')\nprint(f'  loss = {loss_pot:.6f}')\n\nP3 = ot.sinkhorn(a_w, b_w, C / C.max(), 0.1)\nloss_pot3 = np.sum(P3 * C) - 0.1 * np.sum(P3 * np.log(P3 / (a_w[:, None] * b_w[None, :])))\nprint(f'POT sinkhorn (C/C_max, reg=0.1):')\nprint(f'  loss = {loss_pot3:.6f}')\nEOF\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

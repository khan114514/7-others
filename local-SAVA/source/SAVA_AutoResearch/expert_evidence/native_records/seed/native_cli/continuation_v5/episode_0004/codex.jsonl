{"type": "item.started", "item": {"id": "item_50", "type": "command_execution", "command": "/bin/sh -lc \"python3 << 'EOF'\n# Test: can we approximate W with cheap centroid/moment-based distances?\nimport numpy as np, sys\nsys.path.insert(0, '/workspace/solution')\nimport method as m\n\nnp.random.seed(42)\nN, M = 3000, 2000\nx = np.random.randn(N, 10).astype(np.float32)\ny = np.random.randint(0, 10, N).astype(np.int64)\nr = np.random.randn(M, 10).astype(np.float32)\nry = np.random.randint(0, 10, M).astype(np.int64)\n\nimport torch\ntorch.set_num_threads(2)\nbatch_size = 1024\ntx = [np.arange(i, min(i + batch_size, len(x))) for i in range(0, len(x), batch_size)]\ntr = [np.arange(i, min(i + batch_size, len(r))) for i in range(0, len(r), batch_size)]\n\n# Full canonical label cost\nW_full = m._label_cost(x[tx[0]], y[tx[0]], r[tr[0]], ry[tr[0]])\n\n# Centroid-based label cost\ndef _label_cost_centroid(x, y, r, ry):\n    xx = np.concatenate([x, r])\n    yy = np.concatenate([y, ry + 10])\n    W = np.zeros((20, 20), dtype=np.float32)\n    for i in range(20):\n        mask_i = yy == i\n        if not mask_i.any():\n            raise ValueError('Missing label')\n        for j in range(i + 1, 20):\n            mask_j = yy == j\n            if not mask_j.any():\n                raise ValueError('Missing label')\n            d = np.mean((xx[mask_i].mean(axis=0) - xx[mask_j].mean(axis=0))**2) / 2.0\n            W[i, j] = W[j, i] = d\n    return W\n\nimport time\nt0 = time.time()\nW_cent = _label_cost_centroid(x[tx[0]], y[tx[0]], r[tr[0]], ry[tr[0]])\nprint(f'Centroid time: {time.time()-t0:.4f}s')\nprint(f'W_full[0,10]: {W_full[0,10]:.4f}, W_cent[0,10]: {W_cent[0,10]:.4f}')\nprint(f'Correlation of upper tri: {np.corrcoef(W_full[np.triu_indices(20,1)], W_cent[np.triu_indices(20,1)])[0,1]:.4f}')\n\n# Full valuation comparison\nimport ot\nfrom scipy.spatial.distance import cdist\nfrom geomloss import SamplesLoss\n\ndef compute_values(W, x, y, r, ry, tx, tr):\n    def cost(z1,z2):\n        d=torch.cdist(z1[:,:,:-1],z2[:,:,:-1]).square()/2\n        return d+torch.as_tensor(W)[z1[:,:,-1].long().unsqueeze(2),z2[:,:,-1].long().unsqueeze(1)]/2\n    potential=SamplesLoss('sinkhorn',p=2,blur=np.sqrt(.1),debias=False,\n                         potentials=True,cost=cost,backend='tensorized')\n    F={}; batchcost=np.zeros((len(tx),len(tr)))\n    for i,idx in enumerate(tx):\n        for j,jdx in enumerate(tr):\n            a=x[idx];b=r[jdx]\n            C=cdist(a,b,'sqeuclidean')/2+W[y[idx,None],ry[jdx][None,:]+10]/2\n            P=ot.sinkhorn(ot.unif(len(idx)),ot.unif(len(jdx)),C/max(float(C.max()),1e-12),.1)\n            batchcost[i,j]=float(np.sum(P*C))/(len(idx)+len(jdx))\n            z1=torch.tensor(np.column_stack([a,y[idx]]),dtype=torch.float32)[None]\n            z2=torch.tensor(np.column_stack([b,ry[jdx]+10]),dtype=torch.float32)[None]\n            with torch.inference_mode(): f,_=potential(z1,z2)\n            f=f.numpy().ravel().astype(float)\n            F[i,j]=(f-f.mean())*len(f)/(len(f)-1)\n    Q=ot.sinkhorn(ot.unif(len(tx)),ot.unif(len(tr)),\n                  batchcost/max(float(batchcost.max()),1e-12),.01,\n                  numItermax=10000,stopThr=1e-10)\n    values=np.zeros(len(x))\n    for i,idx in enumerate(tx): values[idx]=sum(Q[i,j]*F[i,j] for j in range(len(tr)))\n    return values\n\nvals_full = compute_values(W_full, x, y, r, ry, tx, tr)\nvals_cent = compute_values(W_cent, x, y, r, ry, tx, tr)\n\nfrom scipy.stats import spearmanr\nnrmse = np.sqrt(np.mean((vals_full - vals_cent)**2)) / np.std(vals_full)\nspear, _ = spearmanr(vals_full, vals_cent)\ntop_q = int(np.floor(len(vals_full)/4))\nidx_full = np.argsort(-vals_full)[:top_q]\nidx_cent = np.argsort(-vals_cent)[:top_q]\noverlap = len(np.intersect1d(idx_full, idx_cent)) / top_q\nprint(f'\\\\nCentroid W vs full W:')\nprint(f'  NRMSE: {nrmse:.6f}')\nprint(f'  Spearman: {spear:.6f}')\nprint(f'  Top-quartile overlap: {overlap:.4f}')\nprint(f'  (Need: NRMSE<=0.01, Spear>=0.999, overlap>=0.98)')\nEOF\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

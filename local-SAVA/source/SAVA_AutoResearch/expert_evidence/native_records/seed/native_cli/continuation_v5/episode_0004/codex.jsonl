{"type": "item.started", "item": {"id": "item_47", "type": "command_execution", "command": "/bin/sh -lc \"python3 << 'EOF'\n# Test: how accurate is subsampled label cost?\nimport numpy as np, sys\nsys.path.insert(0, '/workspace/solution')\nimport method as m\n\nnp.random.seed(42)\nN, M = 3000, 2000\nx = np.random.randn(N, 10).astype(np.float32)\ny = np.random.randint(0, 10, N).astype(np.int64)\nr = np.random.randn(M, 10).astype(np.float32)\nry = np.random.randint(0, 10, M).astype(np.int64)\n\nimport torch\nfrom geomloss import SamplesLoss\n\ntorch.set_num_threads(2)\nbatch_size = 1024\ntx = [np.arange(i, min(i + batch_size, len(x))) for i in range(0, len(x), batch_size)]\ntr = [np.arange(i, min(i + batch_size, len(r))) for i in range(0, len(r), batch_size)]\n\n# Full label cost (canonical)\nimport time\nt0 = time.time()\nW_full = m._label_cost(x[tx[0]], y[tx[0]], r[tr[0]], ry[tr[0]])\nprint(f'Full label cost: {time.time()-t0:.3f}s')\n\n# Subsampled label cost\ndef _label_cost_subsampled(x, y, r, ry, n_per_class=50):\n    xx = np.concatenate([x, r])\n    yy = np.concatenate([y, ry + 10])\n    W = np.zeros((20, 20), dtype=np.float32)\n    loss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\n    with torch.inference_mode():\n        for i in range(20):\n            mask_i = yy == i\n            if not mask_i.any():\n                raise ValueError('Missing label')\n            pts_i = xx[mask_i]\n            if len(pts_i) > n_per_class:\n                idx_i = np.random.choice(len(pts_i), n_per_class, replace=False)\n                pts_i = pts_i[idx_i]\n            xi = torch.tensor(pts_i, dtype=torch.float32)\n            for j in range(i + 1, 20):\n                mask_j = yy == j\n                if not mask_j.any():\n                    raise ValueError('Missing label')\n                pts_j = xx[mask_j]\n                if len(pts_j) > n_per_class:\n                    idx_j = np.random.choice(len(pts_j), n_per_class, replace=False)\n                    pts_j = pts_j[idx_j]\n                xj = torch.tensor(pts_j, dtype=torch.float32)\n                W[i, j] = W[j, i] = float(loss(xi, xj))\n    return W\n\nnp.random.seed(123)\nt0 = time.time()\nW_sub = _label_cost_subsampled(x[tx[0]], y[tx[0]], r[tr[0]], ry[tr[0]], 30)\nprint(f'Subsampled (30): {time.time()-t0:.3f}s')\nprint(f'Max abs diff: {np.max(np.abs(W_full - W_sub)):.6f}')\nprint(f'Relative diff: {np.max(np.abs(W_full - W_sub)) / (np.max(np.abs(W_full)) + 1e-10):.6f}')\n\nnp.random.seed(123)\nt0 = time.time()\nW_sub100 = _label_cost_subsampled(x[tx[0]], y[tx[0]], r[tr[0]], ry[tr[0]], 100)\nprint(f'Subsampled (100): {time.time()-t0:.3f}s')\nprint(f'Max abs diff: {np.max(np.abs(W_full - W_sub100)):.6f}')\nprint(f'Relative diff: {np.max(np.abs(W_full - W_sub100)) / (np.max(np.abs(W_full)) + 1e-10):.6f}')\nEOF\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

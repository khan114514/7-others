 time.time() - t0\nprint(f'POT sinkhorn per pair: {t_pot:.3f}s')\n\n# NumPy log-Sinkhorn\na_w = np.ones(n_src, np.float64) / n_src\nb_w = np.ones(n_tgt, np.float64) / n_tgt\nlog_a = np.log(a_w)\nlog_b = np.log(b_w)\nreg = 0.1\n\nt0 = time.time()\nf_np, g_np = np.zeros(n_src), np.zeros(n_tgt)\nfor _ in range(20):\n    f_np = -reg * logsumexp(log_b[None, :] + (g_np[None, :] - C / C_max) / reg, axis=1)\n    g_np = -reg * logsumexp(log_a[:, None] + (f_np[:, None] - C / C_max) / reg, axis=0)\nt_np = time.time() - t0\nprint(f'NumPy log-Sinkhorn (20 iters, C/C_max): {t_np:.3f}s')\n\n# Check convergence of numpy log-sinkhorn\nf_c, g_c = np.zeros(n_src), np.zeros(n_tgt)\nfor it in range(200):\n    f_prev = f_c\n    f_c = -reg * logsumexp(log_b[None, :] + (g_c[None, :] - C / C_max) / reg, axis=1)\n    g_c = -reg * logsumexp(log_a[:, None] + (f_c[:, None] - C / C_max) / reg, axis=0)\n    diff = np.max(np.abs(f_c - f_prev))\n    if it < 10 or it % 10 == 0:\n        P = np.exp(log_a[:, None] + log_b[None, :] + (f_c[:, None] + g_c[None, :] - C/C_max) / reg)\n        cost = np.sum(P * C)\n        print(f'  iter {it}: f_change={diff:.2e}, batchcost={cost/(n_src+n_tgt):.6f}')\n\n# Also POT batchcost\nP_pot = ot.sinkhorn(ot.unif(n_src), ot.unif(n_tgt), C / C_max, .1)\npot_bc = float(np.sum(P_pot * C)) / (n_src + n_tgt)\nprint(f'POT batchcost: {pot_bc:.6f}')\n\n# Also GeomLoss loss\npot_loss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, cost=cost_fn, backend='tensorized')\nwith torch.inference_mode():\n    geom_loss = float(pot_loss(z1, z2))\nprint(f'GeomLoss loss value: {geom_loss:.6f}')\n\nprint(f'\\\\nEstimated total per case (6 pairs):')\nprint(f'  Label cost: {t_label:.3f}s')\nprint(f'  6 x GeomLoss: {6*t_geom:.3f}s')\nprint(f'  6 x cdist+W: ~{6*0.005:.3f}s')\nprint(f'  Batch OT: ~0.001s')\nprint(f'  Total with POT: {t_label + 6*t_geom + 6*t_pot + 0.03:.3f}s')\nprint(f'  Total with NumPy Sinkhorn: {t_label + 6*t_geom + 6*t_np + 0.03:.3f}s')\nEOF\"", "aggregated_o
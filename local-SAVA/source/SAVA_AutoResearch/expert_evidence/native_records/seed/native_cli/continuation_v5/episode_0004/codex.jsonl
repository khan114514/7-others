{"type": "item.started", "item": {"id": "item_63", "type": "command_execution", "command": "/bin/sh -lc \"python3 << 'EOF'\n# Check if the difference is just a uniform scaling + offset, or pointwise\nimport numpy as np, torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nfrom scipy.special import logsumexp\nfrom scipy.stats import spearmanr\n\nnp.random.seed(42)\ntorch.set_num_threads(2)\n\nn, m = 1024, 1024\na = np.random.randn(n, 10).astype(np.float32)\nb = np.random.randn(m, 10).astype(np.float32)\ny_a = np.random.randint(0, 5, n).astype(np.int64)\ny_b = np.random.randint(10, 15, m).astype(np.int64)\n\nW = np.zeros((20, 20), dtype=np.float32)\nfor i in range(5):\n    for j in range(10, 15):\n        ci = a[y_a == i].mean(axis=0)\n        cj = b[y_b == j].mean(axis=0)\n        W[i, j] = W[j, i] = np.sum((ci - cj)**2) / 2\n\ndef cost_fn(z1, z2):\n    d = torch.cdist(z1[:, :, :-1], z2[:, :, :-1]).square() / 2\n    return d + torch.as_tensor(W)[z1[:, :, -1].long().unsqueeze(2),\n                                   z2[:, :, -1].long().unsqueeze(1)] / 2\n\npot = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                  potentials=True, cost=cost_fn, backend='tensorized')\n\nz1 = torch.tensor(np.column_stack([a, y_a]), dtype=torch.float32)[None]\nz2 = torch.tensor(np.column_stack([b, y_b]), dtype=torch.float32)[None]\n\nwith torch.inference_mode():\n    f_geom, g_geom = pot(z1, z2)\nf_geom = f_geom.numpy().ravel().astype(np.float64)\ng_geom = g_geom.numpy().ravel().astype(np.float64)\n\nC = (cdist(a, b, 'sqeuclidean') / 2.0 + W[y_a[:, None], y_b[None, :]] / 2.0).astype(np.float64)\nreg = 0.1\na_w = np.ones(n) / n\nb_w = np.ones(m) / m\nlog_a = np.log(a_w)\nlog_b = np.log(b_w)\n\nf, g = np.zeros(n), np.zeros(m)\nfor _ in range(500):\n    f = -reg * logsumexp(log_b[None, :] + (g[None, :] - C) / reg, axis=1)\n    g = -reg * logsumexp(log_a[:, None] + (f[:, None] - C) / reg, axis=0)\n\n# Normalize same as canonical\nF_geom = (f_geom - f_geom.mean()) * len(f_geom) / (len(f_geom) - 1)\nF_np = (f - f.mean()) * len(f) / (len(f) - 1)\n\nprint('Correlation and ranking analysis:')\nprint(f'  Spearman: {spearmanr(F_geom, F_np)[0]:.8f}')\nprint(f'  Pearson: {np.corrcoef(F_geom, F_np)[0,1]:.8f}')\nprint(f'  NRMSE: {np.sqrt(np.mean((F_geom - F_np)**2)) / np.std(F_geom):.6f}')\n\n# Top quartile overlap\ntop_q = n // 4\nidx_geom = np.argsort(-F_geom)[:top_q]\nidx_np = np.argsort(-F_np)[:top_q]\noverlap = len(np.intersect1d(idx_geom, idx_np)) / top_q\nprint(f'  Top-quartile overlap: {overlap:.6f}')\n\n# Try: maybe GeomLoss uses different reg. Try reg = blur (not blur\"'^2)\nfor reg_test in [np.sqrt(0.1), 0.1, 0.05, 0.2, 0.01]:\n    f2, g2 = np.zeros(n), np.zeros(m)\n    for _ in range(500):\n        f2 = -reg_test * logsumexp(log_b[None, :] + (g2[None, :] - C) / reg_test, axis=1)\n        g2 = -reg_test * logsumexp(log_a[:, None] + (f2[:, None] - C) / reg_test, axis=0)\n    F2 = (f2 - f2.mean()) * len(f2) / (len(f2) - 1)\n    sp, _ = spearmanr(F_geom, F2)\n    nrm = np.sqrt(np.mean((F_geom - F2)**2)) / np.std(F_geom)\n    print(f'\"'  reg={reg_test:.4f}: spearman={sp:.8f}, nrmse={nrm:.6f}')\nEOF\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

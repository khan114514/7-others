{"type": "item.started", "item": {"id": "item_44", "type": "command_execution", "command": "/bin/sh -lc \"python3 << 'EOF'\nimport numpy as np, time, sys\nsys.path.insert(0, '/workspace/solution')\nimport method as m\n\nnp.random.seed(42)\nN, M = 3000, 2000\nx = np.random.randn(N, 10).astype(np.float32)\ny = np.random.randint(0, 10, N).astype(np.int64)\nr = np.random.randn(M, 10).astype(np.float32)\nry = np.random.randint(0, 10, M).astype(np.int64)\n\nimport torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nfrom scipy.special import logsumexp\nimport ot\n\ntorch.set_num_threads(2)\nbatch_size = 1024\ntx = [np.arange(i, min(i + batch_size, len(x))) for i in range(0, len(x), batch_size)]\ntr = [np.arange(i, min(i + batch_size, len(r))) for i in range(0, len(r), batch_size)]\n\n# Time label cost\nt0 = time.time()\nW = m._label_cost(x[tx[0]], y[tx[0]], r[tr[0]], ry[tr[0]])\nprint(f'Label cost: {time.time()-t0:.3f}s')\n\ncost_fn = m._make_cost_fn(W)\npot_f = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                    potentials=True, cost=cost_fn, backend='tensorized')\n\n# Time one pair\ni, j = 0, 0\nidx, jdx = tx[i], tr[j]\na, b = x[idx], r[jdx]\nz1 = torch.tensor(np.column_stack([a, y[idx]]), dtype=torch.float32)[None]\nz2 = torch.tensor(np.column_stack([b, ry[jdx] + 10]), dtype=torch.float32)[None]\n\n# GeomLoss call\nt0 = time.time()\nfor _ in range(3):\n    with torch.inference_mode():\n        f, g = pot_f(z1, z2)\nprint(f'GeomLoss potentials (x3): {time.time()-t0:.3f}s per call: {(time.time()-t0)/3:.3f}s')\n\n# C matrix\nC = (cdist(a, b, 'sqeuclidean') / 2.0 + W[y[idx, None], ry[jdx][None, :] + 10] / 2.0).astype(np.float64)\n\n# Log refinement\nf_np = f.numpy().ravel().astype(np.float64)\ng_np = g.numpy().ravel().astype(np.float64)\nn_src, n_tgt = len(idx), len(jdx)\na_w = np.ones(n_src, np.float64) / n_src\nb_w = np.ones(n_tgt, np.float64) / n_tgt\nlog_a = np.log(a_w)\nlog_b = np.log(b_w)\nreg_norm = 0.1\n\nt0 = time.time()\nf_bc, g_bc = f_np.copy(), g_np.copy()\nfor _ in range(6):\n    f_bc = -reg_norm * logsumexp(log_b[None, :] + (g_bc[None, :] - C) / reg_norm, axis=1)\n    g_bc = -reg_norm * logsumexp(log_a[:, None] + (f_bc[:, None] - C) / reg_norm, axis=0)\nprint(f'6 log refinements: {time.time()-t0:.3f}s')\n\n# POT Sinkhorn\nC_max = max(float(C.max()), 1e-12)\nt0 = time.time()\nfor _ in range(3):\n    P = ot.sinkhorn(np.ones(n_src)/n_src, np.ones(n_tgt)/n_tgt, C/C_max, 0.1)\nprint(f'POT sinkhorn (x3): {time.time()-t0:.3f}s per call: {(time.time()-t0)/3:.3f}s')\n\n# Batch-level OT\nbatchcost = np.random.rand(3, 2).astype(np.float64)\nt0 = time.time()\nfor _ in range(30):\n    Q = ot.sinkhorn(np.ones(3)/3, np.ones(2)/2, batchcost/batchcost.max(), .01, numItermax=10000, stopThr=1e-10)\nprint(f'Batch OT (x30): {time.time()-t0:.3f}s per: {(time.time()-t0)/30:.5f}s')\n\n# Full 6 pairs\nprint(f'\\\\nEstimated per-case:')\nprint(f'  Label cost: 0.02s')\nprint(f'  6 x GeomLoss: {6*0.045:.3f}s')\nprint(f'  6 x (cdist + 6 log refinements): ~{6*0.015:.3f}s')\nprint(f'  Batch OT: 0.001s')\nprint(f'  Total: ~{0.02 + 6*0.045 + 6*0.015 + 0.001:.3f}s')\nEOF\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

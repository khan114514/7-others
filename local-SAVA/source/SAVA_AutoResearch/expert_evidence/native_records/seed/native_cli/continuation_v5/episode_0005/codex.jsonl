cdist(a, b, 'sqeuclidean') / 2.0 +\n     W[y[idx, None], ry[jdx][None, :] + 10] / 2.0).astype(np.float64)\nC_max = max(float(C.max()), 1e-12)\n\n# Canonical: POT with C/C_max, reg=0.1\nP_canon = ot.sinkhorn(ot.unif(n_src), ot.unif(n_tgt), C / C_max, 0.1)\nbc_canon = float(np.sum(P_canon * C)) / (n_src + n_tgt)\nprint(f'Canonical (POT C/C_max reg=0.1): batchcost = {bc_canon:.6f}')\nprint(f'  C_max = {C_max:.2f}')\n\n# v17: matched-blur GeomLoss + 2 refine iters, with C_norm and reg=0.1\nz1 = torch.tensor(np.column_stack([a, y[idx]]), dtype=torch.float32)[None]\nz2 = torch.tensor(np.column_stack([b, ry[jdx] + 10]), dtype=torch.float32)[None]\nreg_norm = 0.1\nblur_match = np.sqrt(reg_norm * C_max)\npot_bc = SamplesLoss('sinkhorn', p=2, blur=blur_match, debias=False,\n                     potentials=True, cost=cf, backend='tensorized')\nwith torch.inference_mode():\n    f_bc_t, g_bc_t = pot_bc(z1, z2)\nf_bc = f_bc_t.numpy().ravel().astype(np.float64) / C_max\ng_bc = g_bc_t.numpy().ravel().astype(np.float64) / C_max\n\na_w = np.ones(n_src, np.float64) / n_src\nb_w = np.ones(n_tgt, np.float64) / n_tgt\nlog_a = np.log(a_w); log_b = np.log(b_w)\nC_norm = C / C_max\n\nf_ref = f_bc.copy(); g_ref = g_bc.copy()\nfor k in range(10):\n    f_ref = -reg_norm * logsumexp(log_b[None, :] + (g_ref[None, :] - C_norm) / reg_norm, axis=1)\n    g_ref = -reg_norm * logsumexp(log_a[:, None] + (f_ref[:, None] - C_norm) / reg_norm, axis=0)\n    log_P = log_a[:, None] + log_b[None, :] + (f_ref[:, None] + g_ref[None, :] - C_norm) / reg_norm\n    P = np.exp(log_P)\n    bc = float(np.sum(P * C)) / (n_src + n_tgt)\n    print(f'  v17 refine iter {k+1}: bc={bc:.6f}, diff_from_canon={bc-bc_canon:.6e}')\n\n# Check: GeomLoss potentials at canonical blur, what reg do they correspond to?\n# If GeomLoss blur = sqrt(0.1) with C in raw units, effective reg = 0.1 (raw units)\n# But canonical has reg=0.1 with C/C_max, meaning reg_raw = 0.1 * C_max\n# So canonical is way less regularized\n\n# Let's try: v18 style but with C_max normalization (i.e. use canonical GeomLoss as initial guess for C/C_max, reg=0.1)\n# The canonical GeomLoss has blur=√0.1 with raw C, so effective reg_raw = 0.1\n# In C_norm space: reg_norm = reg_raw / C_max = 0.1 / C_max\nwith torch.inference_mode():\n    f_c_t, g_c_t = pot_f(z1, z2)\nf_c = f_c_t.numpy().ravel().astype(np.float64) / C_max  # scale to C_norm space\ng_c = g_c_t.numpy().ravel().astype(np.float64) / C_max\n\nf_ref2 = f_c.copy(); g_ref2 = g_c.copy()\nfor k in range(20):\n    f_ref2 = -reg_norm * logsumexp(log_b[None, :] + (g_ref2[None, :] - C_norm) / reg_norm, axis=1)\n    g_ref2 = -reg_norm * logsumexp(log_a[:, None] + (f_ref2[:, None] - C_norm) / reg_norm, axis=0)\n    log_P = log_a[:, None] + log_b[None, :] + (f_ref2[:, None] + g_ref2[None, :] - C_norm) / reg_norm\n    P = np.exp(log_P)\n    bc = float(np.sum(P * C)) / (n_src + n_tgt)\n    if k < 5 or k % 5 == 4:\n        print(f'  v18-style (canon init, C_norm, reg=0.1) iter {k+1}: bc={bc:.6f}, diff={bc-bc_canon:.6e}')\n\n# Also: direct log-sinkhorn from uniform init\nf_unif = np.zeros(n_src); g_unif = np.zeros(n_tgt)\nfor k in range(100):\n    f_unif = -reg_norm * logsumexp(log_b[None, :] + (g_unif[None, :] - C_norm) / reg_norm, axis=1)\n    g_unif = -reg_norm * logsumexp(log_a[:, None] + (f_unif[:, None] - C_norm) / reg_norm, axis=0)\n    if k in [9, 19, 49, 99]:\n        log_P = log_a[:, None] + log_b[None, :] + (f_unif[:, None] + g_unif[None, :] - C_norm) / reg_norm\n        P = np.exp(log_P)\n        bc = float(np.sum(P * C)) / (n_src + n_tgt)\n        print(f'  log-sink from zero iter {k+1}: bc={bc:.6f}, diff={bc-bc_canon:.6e}')\nEOF\npython3 /tmp/debug_bc.py 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

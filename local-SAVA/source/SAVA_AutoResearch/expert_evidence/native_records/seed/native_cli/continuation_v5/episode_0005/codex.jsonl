me *relative* potentials as canonical GeomLoss.\n# Test: run POT at various reg values and compare F = (f - f.mean()) * n/(n-1)\n\npot_c = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                    potentials=True, cost=cost_fn, backend='tensorized')\nz1 = torch.tensor(np.column_stack([a, ay]), dtype=torch.float32)[None]\nz2 = torch.tensor(np.column_stack([b, by]), dtype=torch.float32)[None]\nwith torch.inference_mode():\n    f_gl, g_gl = pot_c(z1, z2)\nf_gl = f_gl.numpy().ravel().astype(np.float64)\nF_gl = (f_gl - f_gl.mean()) * n / (n - 1)\nprint(f'GeomLoss F: std={F_gl.std():.4f}')\nprint()\n\n# Test various reg_raw values with log-sinkhorn (from zero)\nfor reg_raw in [0.1, 1.0, 5.0, 10.0, 50.0, 100.0, 500.0, 1000.0, 2000.0]:\n    f = np.zeros(n); g = np.zeros(m)\n    # Run many iters\n    for _ in range(200):\n        f = -reg_raw * logsumexp(log_b[None, :] + (g[None, :] - C) / reg_raw, axis=1)\n        g = -reg_raw * logsumexp(log_a[:, None] + (f[:, None] - C) / reg_raw, axis=0)\n    F_pot = (f - f.mean()) * n / (n - 1)\n    # compare relative magnitudes\n    ratio = F_pot.std() / F_gl.std()\n    diff = np.abs(F_pot - F_gl).max()\n    print(f'reg_raw={reg_raw:7.1f}: F std={F_pot.std():.4f}, ratio={ratio:.4f}, max abs diff={diff:.4f}')\n\nPYEOF\npython3 /tmp/verify_reg3.py 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

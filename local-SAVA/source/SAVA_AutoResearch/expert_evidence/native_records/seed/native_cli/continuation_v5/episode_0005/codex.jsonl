{"type": "item.started", "item": {"id": "item_111", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/label_cost_speed.py << 'PYEOF'\n\\\"\\\"\\\"Benchmark label cost computation options.\\\"\\\"\\\"\nimport numpy as np, torch, time\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nfrom scipy.special import logsumexp\ntorch.set_num_threads(2)\n\nd = np.load('/workspace/environment/public_assets/dev/seed_101_gaussian_008.npz')\nx, y, r, ry = d['x'], d['y'], d['r'], d['ry']\nx = np.asarray(x, np.float32); r = np.asarray(r, np.float32)\ny = np.asarray(y, np.int64); ry = np.asarray(ry, np.int64)\n\nxx = np.concatenate([x[:1024], r[:1024]])\nyy = np.concatenate([y[:1024], ry[:1024] + 10])\nxx_t = torch.tensor(xx, dtype=torch.float32)\n\n# Reference\nW_ref = np.zeros((20,20), np.float32)\nloss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\nt0 = time.perf_counter()\nwith torch.inference_mode():\n    for i in range(20):\n        for j in range(i+1, 20):\n            W_ref[i,j] = W_ref[j,i] = float(loss(xx_t[yy==i], xx_t[yy==j]))\nt_ref = time.perf_counter() - t0\nprint(f'Reference GeomLoss: {t_ref:.3f}s,  max W={W_ref.max():.2f}')\n\n# Try: POT log-sinkhorn with log-domain stability for all 190 pairs\ndef pot_logsinkhorn(C, reg, a=None, b=None, max_iter=100):\n    n, m = C.shape\n    if a is None: a = np.ones(n) / n\n    if b is None: b = np.ones(m) / m\n    log_a = np.log(a); log_b = np.log(b)\n    f = np.zeros(n); g = np.zeros(m)\n    for _ in range(max_iter):\n        f = -reg * logsumexp(log_b[None, :] + (g[None, :] - C) / reg, axis=1)\n        g = -reg * logsumexp(log_a[:, None] + (f[:, None] - C) / reg, axis=0)\n    log_P = log_a[:, None] + log_b[None, :] + (f[:, None] + g[None, :] - C) / reg\n    P = np.exp(log_P)\n    return P, f, g\n\n# For label cost: small point sets, Euclidean cost\n# reg = 0.1 (raw units, which in Euclidean 10-dim means very small reg)\n# For accurate W2: we need 
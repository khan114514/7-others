{"type": "item.started", "item": {"id": "item_119", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/eps_calibrate.py << 'PYEOF'\n\\\"\\\"\\\"Calibrate eps for GeomLoss with custom cost / Euclidean cost.\\\"\\\"\\\"\nimport numpy as np, torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nfrom scipy.special import logsumexp\ntorch.set_num_threads(2)\n\nd = np.load('/workspace/environment/public_assets/dev/seed_101_gaussian_008.npz')\nx, y, r, ry = d['x'], d['y'], d['r'], d['ry']\nx = np.asarray(x, np.float32); r = np.asarray(r, np.float32)\ny = np.asarray(y, np.int64); ry = np.asarray(ry, np.int64)\n\nxx = np.concatenate([x[:1024], r[:1024]])\nyy = np.concatenate([y[:1024], ry[:1024] + 10])\nxx_t = torch.tensor(xx, dtype=torch.float32)\n\ni, j = 0, 10\na = xx_t[yy==i]; b = xx_t[yy==j]\na_np = a.numpy(); b_np = b.numpy()\nC = cdist(a_np, b_np, 'sqeuclidean') / 2.0\nna, nb = a_np.shape[0], b_np.shape[0]\n\n# GeomLoss with Euclidean cost (default) at blur=sqrt(0.1), p=2\nloss_euc = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\nwith torch.inference_mode():\n    w_euc = float(loss_euc(a, b))\nprint(f'GeomLoss Euclidean blur=√0.1: {w_euc:.6f}')\n\n# For Euclidean p=2 cost: C = ||x-y||²/2, eps = blur\"'^p = 0.1\n# Sinkhorn loss = OT_ε(C, eps)\n\nlog_a = np.log(np.ones(na) / na)\nlog_b = np.log(np.ones(nb) / nb)\n\ndef sinkhorn_loss(C, eps, n_iter=500):\n    f = np.zeros(na); g = np.zeros(nb)\n    for _ in range(n_iter):\n        f = -eps * logsumexp(log_b[None, :] + (g[None, :] - C) / eps, axis=1)\n        g = -eps * logsumexp(log_a[:, None] + (f[:, None] - C) / eps, axis=0)\n    log_P = log_a[:, None] + log_b[None, :] + (f[:, None] + g[None, :] - C) / eps\n    P = np.exp(log_P)\n    ent = np.sum(P * (log_P - log_a[:, None] - log_b[None, :]))\n    return float(np.sum(P * C)) + eps * ent\n\n# Test: does eps=0.1 match?\nfor eps in [0.05, 0.1, 0.15, 0.2, 0.25, 0.3, 0.316, 0.5, 1.0]:\n    sl = sinkhorn_loss(C, eps, n_iter=1000)\n    print(f'\"'  eps={eps:.3f}: sinkhorn_loss={sl:.4f}, rel_diff={abs(sl-w_euc)/w_euc:.4e}')\n\nprint()\n# Now test custom cost case (same cost, different formula)\ndef my_cost(z1, z2):\n    return torch.cdist(z1, z2).square() / 2\n\nloss_custom = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized', cost=my_cost)\nwith torch.inference_mode():\n    w_custom = float(loss_custom(a[None], b[None]))\nprint(f'GeomLoss custom cost blur=√0.1: {w_custom:.6f}')\n# For custom cost: eps = blur (= √0.1 ≈ 0.316)? Or eps = blur\"'^p = 0.1?\n# Docs say: ε = blur''^p for Euclidean, but for custom cost the blur is used as ε directly?\n# Actually: with custom cost, there'\"'s no \\\"p\\\" interpretation - eps is just ε\n# Let me check what eps matches\n\nfor eps in [0.1, 0.15, 0.2, 0.25, 0.3, 0.316, 0.4, 0.5]:\n    sl = sinkhorn_loss(C, eps, n_iter=1000)\n    print(f'  eps={eps:.3f}: sinkhorn_loss={sl:.4f}, rel_diff={abs(sl-w_custom)/w_custom:.4e}')\n\nPYEOF\npython3 /tmp/eps_calibrate.py 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

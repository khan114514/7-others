{"type": "item.started", "item": {"id": "item_60", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/bench_subsample_w.py << 'EOF'\nimport numpy as np, torch, time\nfrom geomloss import SamplesLoss\ntorch.set_num_threads(2)\n\nd = np.load('/workspace/environment/public_assets/dev/seed_101_gaussian_008.npz')\nx, y, r, ry = d['x'], d['y'], d['r'], d['ry']\nx = np.asarray(x, np.float32); r = np.asarray(r, np.float32)\ny = np.asarray(y, np.int64); ry = np.asarray(ry, np.int64)\n\n# Full label cost\ndef label_cost_full(x, y, r, ry, max_per_class=1024):\n    xx = torch.tensor(np.concatenate([x, r]), dtype=torch.float32)\n    yy = np.concatenate([y, ry + 10])\n    W = np.zeros((20, 20), dtype=np.float32)\n    loss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\n    with torch.inference_mode():\n        for i in range(20):\n            for j in range(i + 1, 20):\n                xi = xx[yy == i]\n                xj = xx[yy == j]\n                if len(xi) > max_per_class:\n                    idx = np.random.choice(len(xi), max_per_class, replace=False)\n                    xi = xi[idx]\n                if len(xj) > max_per_class:\n                    idx = np.random.choice(len(xj), max_per_class, replace=False)\n                    xj = xj[idx]\n                W[i, j] = W[j, i] = float(loss(xi, xj))\n    return W\n\nnp.random.seed(42)\nt0 = time.perf_counter()\nW_full = label_cost_full(x[:1024], y[:1024], r[:1024], ry[:1024], max_per_class=1024)\nprint(f'Full W (1024 per class): {time.perf_counter()-t0:.3f}s, max={W_full.max():.2f}')\n\nnp.random.seed(42)\nfor n in [500, 200, 100, 50]:\n    t0 = time.perf_counter()\n    W_sub = label_cost_full(x[:1024], y[:1024], r[:1024], ry[:1024], max_per_class=n)\n    print(f'W ({n} per class): {time.perf_counter()-t0:.3f}s, max_diff={np.abs(W_full-W_sub).max():.4f}, rel_max={np.abs(W_full-W_sub).max()/max(W_full.max(),1e-12):.4e}')\nEOF\npython3 /tmp/bench_subsample_w.py 2>&1\"",
{"type": "item.started", "item": {"id": "item_48", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/debug_components.py << 'EOF'\nimport numpy as np, sys, importlib.util, time\n\ndef _label_cost(x, y, r, ry):\n    import torch\n    from geomloss import SamplesLoss\n    xx = torch.tensor(np.concatenate([x, r]), dtype=torch.float32)\n    yy = np.concatenate([y, ry + 10])\n    W = np.zeros((20, 20), dtype=np.float32)\n    loss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\n    with torch.inference_mode():\n        for i in range(20):\n            for j in range(i + 1, 20):\n                if not (yy == i).any() or not (yy == j).any():\n                    raise ValueError('Initial batch lacks a label support')\n                W[i, j] = W[j, i] = float(loss(xx[yy == i], xx[yy == j]))\n    return W\n\ndef _make_cost_fn(W):\n    import torch\n    def cost(z1, z2):\n        d = torch.cdist(z1[:, :, :-1], z2[:, :, :-1]).square() / 2\n        return d + torch.as_tensor(W)[z1[:, :, -1].long().unsqueeze(2),\n                                      z2[:, :, -1].long().unsqueeze(1)] / 2\n    return cost\n\nd = np.load('/workspace/environment/public_assets/dev/seed_101_gaussian_008.npz')\nx, y, r, ry, seed = d['x'], d['y'], d['r'], d['ry'], int(d['seed'])\nx = np.asarray(x, np.float32); r = np.asarray(r, np.float32)\ny = np.asarray(y, np.int64); ry = np.asarray(ry, np.int64)\nbatch_size = 1024\ntx = [np.arange(i, min(i + batch_size, len(x))) for i in range(0, len(x), batch_size)]\ntr = [np.arange(i, min(i + batch_size, len(r))) for i in range(0, len(r), batch_size)]\n\nimport torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nfrom scipy.special import logsumexp\nimport ot\n\nW = _label_cost(x[tx[0]], y[tx[0]], r[tr[0]], ry[tr[0]])\ncost_fn = _make_cost_fn(W)\nreg_norm = 0.1\n\npot_f = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                    potentials=True, cost=cost_fn, backend='tensorized')\n\nF_v17 = {}\nF_v18 = {}\nbc_v17 = np.zeros((len(tx), len(tr)))\nbc_v18 = np.zeros((len(tx), len(tr)))\n\nfor i, idx in enumerate(tx):\n    for j, jdx in enumerate(tr):\n        a = x[idx]; b = r[jdx]\n        n_src = len(idx); n_tgt = len(jdx)\n\n        z1 = torch.tensor(np.column_stack([a, y[idx]]), dtype=torch.float32)[None]\n        z2 = torch.tensor(np.column_stack([b, ry[jdx] + 10]), dtype=torch.float32)[None]\n\n        C = (cdist(a, b, 'sqeuclidean') / 2.0 +\n             W[y[idx, None], ry[jdx][None, :] + 10] / 2.0).astype(np.float64)\n        C_max = max(float(C.max()), 1e-12)\n\n        # v17: matched-blur for batchcost\n        blur_match = np.sqrt(reg_norm * C_max)\n        pot_bc = SamplesLoss('sinkhorn', p=2, blur=blur_match, debias=False,\n                             potentials=True, cost=cost_fn, backend='tensorized')\n        with torch.inference_mode():\n            f_bc_t, g_bc_t = pot_bc(z1, z2)\n        f_bc17 = f_bc_t.numpy().ravel().astype(np.float64) / C_max\n        g_bc17 = g_bc_t.numpy().ravel().astype(np.float64) / C_max\n\n        a_w = np.ones(n_src, np.float64) / n_src\n        b_w = np.ones(n_tgt, np.float64) / n_tgt\n        log_a = np.log(a_w); log_b = np.log(b_w)\n        C_norm = C / C_max\n\n        f_ref = f_bc17.copy(); g_ref = g_bc17.copy()\n        for _ in range(2):\n            f_ref = -reg_norm * logsumexp(log_b[None, :] + (g_ref[None, :] - C_norm) / reg_norm, axis=1)\n            g_ref = -reg_norm * logsumexp(log_a[:, None] + (f_ref[:, None] - C_norm) / reg_norm, axis=0)\n        log_P = log_a[:, None] + log_b[None, :] + (f_ref[:, None] + g_ref[None, :] - C_norm) / reg_norm\n        P = np.exp(log_P)\n        bc_v17[i, j] = float(np.sum(P * C)) / (n_src + n_tgt)\n\n        # F v17\n        with torch.inference_mode():\n            f_f, _ = pot_f(z1, z2)\n        f_f = f_f.numpy().ravel().astype(float)\n        F_v17[i, j] = (f_f - f_f.mean()) * len(f_f) / (len(f_f) - 1)\n\n        # v18: single canonical-blur GeomLoss for both\n        with torch.inference_mode():\n            f_t, g_t = pot_f(z1, z2)\n        f = f_t.numpy().ravel().astype(np.float64)\n        g = g_t.numpy().ravel().astype(np.float64)\n        \n        F_v18[i, j] = (f - f.mean()) * len(f) / (len(f) - 1)\n\n        # v18 batchcost: refine canonical potentials in log-domain\n        f_bc18 = f.copy()\n        g_bc18 = g.copy()\n        for _ in range(6):\n            f_bc18 = -reg_norm * logsumexp(log_b[None, :] + (g_bc18[None, :] - C) / reg_norm, axis=1)\n            g_bc18 = -reg_norm * logsumexp(log_a[:, None] + (f_bc18[:, None] - C) / reg_norm, axis=0)\n        log_P18 = log_a[:, None] + log_b[None, :] + (f_bc18[:, None] + g_bc18[None, :] - C) / reg_norm\n        P18 = np.exp(log_P18)\n        bc_v18[i, j] = float(np.sum(P18 * C)) / (n_src + n_tgt)\n\n        # Compare F\n        fd = np.abs(F_v17[i,j] - F_v18[i,j]).max()\n        print(f'Pair ({i},{j}): F diff max={fd:.4e}, bc17={bc_v17[i,j]:.4f}, bc18={bc_v18[i,j]:.4f}, diff={bc_v17[i,j]-bc_v18[i,j]:.4e}')\n\nprint()\nprint(f'batchcost v17:\\\\n{bc_v17}')\nprint(f'batchcost v18:\\\\n{bc_v18}')\nprint(f'bc diff:\\\\n{bc_v17 - bc_v18}')\n\n# Q comparison\nbc_max17 = max(float(bc_v17.max()), 1e-12)\nQ17 = ot.sinkhorn(np.ones(len(tx)) / len(tx),\n                  np.ones(len(tr)) / len(tr),\n                  bc_v17 / bc_max17, .01,\n                  numItermax=10000, stopThr=1e-10)\nbc_max18 = max(float(bc_v18.max()), 1e-12)\nQ18 = ot.sinkhorn(np.ones(len(tx)) / len(tx),\n                  np.ones(len(tr)) / len(tr),\n                  bc_v18 / bc_max18, .01,\n                  numItermax=10000, stopThr=1e-10)\nprint(f'Q17:\\\\n{Q17}')\nprint(f'Q18:\\\\n{Q18}')\nprint(f'Q diff max: {np.abs(Q17-Q18).max():.4e}')\nEOF\npython3 /tmp/debug_components.py 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

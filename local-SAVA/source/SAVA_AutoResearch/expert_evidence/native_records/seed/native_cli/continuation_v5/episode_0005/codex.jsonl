{"type": "item.started", "item": {"id": "item_80", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/bench_label.py << 'EOF'\nimport numpy as np, torch, time\nfrom geomloss import SamplesLoss\ntorch.set_num_threads(2)\n\nd = np.load('/workspace/environment/public_assets/dev/seed_101_gaussian_008.npz')\nx, y, r, ry = d['x'], d['y'], d['r'], d['ry']\nx = np.asarray(x, np.float32); r = np.asarray(r, np.float32)\ny = np.asarray(y, np.int64); ry = np.asarray(ry, np.int64)\n\nxx = np.concatenate([x[:1024], r[:1024]])\nyy = np.concatenate([y[:1024], ry[:1024] + 10])\nxx_t = torch.tensor(xx, dtype=torch.float32)\n\n# Time 1 pair of 100x100 with default SamplesLoss (Euclidean cost, no custom\nloss_def = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\nloss_euc = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\n\na = xx_t[yy==0][:100]\nb = xx_t[yy==10][:100]\nprint(f'Shapes: {a.shape}, {b.shape}')\n\n# Warmup\nwith torch.inference_mode():\n    _ = loss_def(a, b)\n\nt0 = time.perf_counter()\nfor _ in range(20):\n    with torch.inference_mode():\n        _ = loss_def(a, b)\nprint(f'Euclidean 100x100: {(time.perf_counter()-t0)/20*1000:.2f}ms per pair')\n\n# Number of iterations\nprint(f'190 pairs estimate: {(time.perf_counter()-t0)/20*190:.3f}s')\n\n# Time a pair with custom cost (what about the custom cost adds nothing because label cost uses no custom cost, right?\n# The _label_cost uses raw embeddings, no custom cost needed\n# Yes\"'! So 11.78ms * 190 = 2.24s\n# But the full v17 label_cost takes 1.37s - that'\"'s because 1024 batch gives fewer points\n\n# Actually earlier test of the custom cost\n\n# Let me time the full label cost accurately\nW = np.zeros((20,20), dtype=np.float32)\nloss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\nt0 = time.perf_counter()\nwith torch.inference_mode():\n    for i in range(20):\n        for j in range(i+1, 20):\n     
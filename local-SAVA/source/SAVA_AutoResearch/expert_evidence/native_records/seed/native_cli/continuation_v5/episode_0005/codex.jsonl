{"type": "item.started", "item": {"id": "item_101", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/test_f_consistency.py << 'PYEOF'\n\\\"\\\"\\\"Test: Are F potentials from different j (reference batch) pairs consistent?\nIf so, we could compute F once per candidate batch instead of per pair.\\\"\\\"\\\"\nimport numpy as np, torch, time\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nfrom scipy.special import logsumexp\nimport ot\ntorch.set_num_threads(2)\n\nd = np.load('/workspace/environment/public_assets/dev/seed_101_gaussian_008.npz')\nx, y, r, ry = d['x'], d['y'], d['r'], d['ry']\nx = np.asarray(x, np.float32); r = np.asarray(r, np.float32)\ny = np.asarray(y, np.int64); ry = np.asarray(ry, np.int64)\n\nbatch_size = 1024\ntx = [np.arange(i, min(i + batch_size, len(x))) for i in range(0, len(x), batch_size)]\ntr = [np.arange(i, min(i + batch_size, len(r))) for i in range(0, len(r), batch_size)]\n\n# Compute W\nxx = np.concatenate([x[tx[0]], r[tr[0]]])\nyy = np.concatenate([y[tx[0]], ry[tr[0]] + 10])\nxx_t = torch.tensor(xx, dtype=torch.float32)\nloss_w = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\nW = np.zeros((20,20), np.float32)\nwith torch.inference_mode():\n    for i in range(20):\n        for j in range(i+1, 20):\n            W[i,j] = W[j,i] = float(loss_w(xx_t[yy==i], xx_t[yy==j]))\n\ndef cost_fn(z1, z2):\n    d2 = torch.cdist(z1[:,:,:-1], z2[:,:,:-1]).square() / 2\n    return d2 + torch.as_tensor(W)[z1[:,:,-1].long().unsqueeze(2), z2[:,:,-1].long().unsqueeze(1)] / 2\n\npot = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                  potentials=True, cost=cost_fn, backend='tensorized')\n\n# Compute F[0,0] and F[0,1] and compare\nFs = {}\nfor j, jdx in enumerate(tr):\n    z1 = torch.tensor(np.column_stack([x[tx[0]], y[tx[0]]]), dtype=torch.float32)[None]\n    z2 = torch.tensor(np.column_stack([r[jdx], ry[jdx] + 10]), dtype=torch.float32)[None]\n    wi
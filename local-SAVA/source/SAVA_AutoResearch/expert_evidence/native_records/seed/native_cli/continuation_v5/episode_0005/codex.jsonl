{"type": "item.started", "item": {"id": "item_109", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/test_w_approximation.py << 'PYEOF'\n\\\"\\\"\\\"Test: how much does W approximation affect final values?\\\"\\\"\\\"\nimport numpy as np, torch, time\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nfrom scipy.special import logsumexp\nimport ot\ntorch.set_num_threads(2)\n\ndef compute_values(x, y, r, ry, W_val):\n    x = np.asarray(x, np.float32); r = np.asarray(r, np.float32)\n    y = np.asarray(y, np.int64); ry = np.asarray(ry, np.int64)\n    batch_size = 1024\n    tx = [np.arange(i, min(i + batch_size, len(x))) for i in range(0, len(x), batch_size)]\n    tr = [np.arange(i, min(i + batch_size, len(r))) for i in range(0, len(r), batch_size)]\n    \n    def cost_fn(z1, z2):\n        d2 = torch.cdist(z1[:,:,:-1], z2[:,:,:-1]).square() / 2\n        return d2 + torch.as_tensor(W_val)[z1[:,:,-1].long().unsqueeze(2), z2[:,:,-1].long().unsqueeze(1)] / 2\n    \n    F = {}; batchcost = np.zeros((len(tx), len(tr)))\n    reg_norm = 0.1\n    \n    pot_f = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                        potentials=True, cost=cost_fn, backend='tensorized')\n    \n    for i, idx in enumerate(tx):\n        for j, jdx in enumerate(tr):\n            a = x[idx]; b = r[jdx]\n            n_src = len(idx); n_tgt = len(jdx)\n            C = (cdist(a, b, 'sqeuclidean') / 2.0 +\n                 W_val[y[idx, None], ry[jdx][None, :] + 10] / 2.0).astype(np.float64)\n            C_max = max(float(C.max()), 1e-12)\n            blur_match = np.sqrt(reg_norm * C_max)\n            pot_bc = SamplesLoss('sinkhorn', p=2, blur=blur_match, debias=False,\n                                 potentials=True, cost=cost_fn, backend='tensorized')\n            z1 = torch.tensor(np.column_stack([a, y[idx]]), dtype=torch.float32)[None]\n            z2 = torch.tensor(np.column_stack([b, ry[jdx] + 10]), dtype=torch.float32)[None]\n            \n            with torch.inference_mode():\n                f_bc_t, g_bc_t = pot_bc(z1, z2)\n            f_bc = f_bc_t.numpy().ravel().astype(np.float64) / C_max\n            g_bc = g_bc_t.numpy().ravel().astype(np.float64) / C_max\n            \n            a_w = np.ones(n_src, np.float64) / n_src\n            b_w = np.ones(n_tgt, np.float64) / n_tgt\n            log_a = np.log(a_w); log_b = np.log(b_w)\n            C_norm = C / C_max\n            f_ref = f_bc.copy(); g_ref = g_bc.copy()\n            for _ in range(2):\n                f_ref = -reg_norm * logsumexp(log_b[None, :] + (g_ref[None, :] - C_norm) / reg_norm, axis=1)\n                g_ref = -reg_norm * logsumexp(log_a[:, None] + (f_ref[:, None] - C_norm) / reg_norm, axis=0)\n            log_P = log_a[:, None] + log_b[None, :] + (f_ref[:, None] + g_ref[None, :] - C_norm) / reg_norm\n            P = np.exp(log_P)\n            batchcost[i, j] = float(np.sum(P * C)) / (n_src + n_tgt)\n            \n            with torch.inference_mode():\n                f, _ = pot_f(z1, z2)\n            f = f.numpy().ravel().astype(float)\n            F[i, j] = (f - f.mean()) * len(f) / (len(f) - 1)\n    \n    bc_max = max(float(batchcost.max()), 1e-12)\n    Q = ot.sinkhorn(np.ones(len(tx)) / len(tx),\n                    np.ones(len(tr)) / len(tr),\n                    batchcost / bc_max, .01,\n                    numItermax=10000, stopThr=1e-10)\n    values = np.zeros(len(x))\n    for i, idx in enumerate(tx):\n        values[idx] = sum(Q[i, j] * F[i, j] for j in range(len(tr)))\n    return values\n\nd = np.load('/workspace/environment/public_assets/dev/seed_101_gaussian_008.npz')\nx, y, r, ry, seed = d['x'], d['y'], d['r'], d['ry'], int(d['seed'])\n\n# Reference W (accurate)\nxx = np.concatenate([x[:1024], r[:1024]])\nyy = np.concatenate([y[:1024], ry[:1024] + 10])\nxx_t = torch.tensor(xx, dtype=torch.float32)\nloss_w = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\nW_ref = np.zeros((20,20), np.float32)\nt0 = time.perf_counter()\nwith torch.inference_mode():\n    for i in range(20):\n        for j in range(i+1, 20):\n            W_ref[i,j] = W_ref[j,i] = float(loss_w(xx_t[yy==i], xx_t[yy==j]))\nprint(f'Reference W time: {time.perf_counter()-t0:.3f}s')\n\nv_ref = compute_values(x, y, r, ry, W_ref)\n\n# Approximation 1: centroid-sqeuclidean\nt0 = time.perf_counter()\ncentroids = np.array([xx[yy==i].mean(0) for i in range(20)])\nW_cent = cdist(centroids, centroids, 'sqeuclidean') / 2.0\nprint(f'Centroid W time: {time.perf_counter()-t0:.3f}s')\n\nv_cent = compute_values(x, y, r, ry, W_cent.astype(np.float32))\ndiff = v_ref - v_cent\nnrmse = np.sqrt(np.mean(diff**2)) / np.std(v_ref)\nfrom scipy.stats import spearmanr\nspear = spearmanr(v_ref, v_cent)[0]\nn = len(v_ref); k = n // 4\ntop_ref = set(np.argsort(-v_ref)[:k])\ntop_cent = set(np.argsort(-v_cent)[:k])\noverlap = len(top_ref & top_cent) / k\nprint(f'Centroid W: NRMSE={nrmse:.4f}, Spearman={spear:.6f}, TopQ={overlap:.4f}')\nprint(f'  W max rel diff: {np.abs(W_ref - W_cent).max() / max(W_ref.max(), 1e-12):.4f}')\n\n# Approximation 2: centroid + scale factor\nt0 = time.perf_counter()\n# Use just a few accurate pairs to calibrate scale\npairs_to_compute = [(0,10), (5, 15), (9,19), (0,19)]\nW_approx = W_cent.copy()\n# Actually compute a few accurate and find ratio\nsum_ref = sum(W_ref[i,j] for i,j in pairs_to_compute)\nsum_cent = sum(W_cent[i,j] for i,j in pairs_to_compute)\nscale = sum_ref / sum_cent\nW_scaled = W_cent * scale\nprint(f'Scale factor: {scale:.4f}')\n\nv_scaled = compute_values(x, y, r, ry, W_scaled.astype(np.float32))\ndiff = v_ref - v_scaled\nnrmse = np.sqrt(np.mean(diff**2)) / np.std(v_ref)\nspear = spearmanr(v_ref, v_scaled)[0]\ntop_scaled = set(np.argsort(-v_scaled)[:k])\noverlap = len(top_ref & top_scaled) / k\nprint(f'Scaled centroid W: NRMSE={nrmse:.4f}, Spearman={spear:.6f}, TopQ={overlap:.4f}')\nprint(f'  W max rel diff: {np.abs(W_ref - W_scaled).max() / max(W_ref.max(), 1e-12):.4f}')\n\n# Approximation 3: centroid + sample-class correction\n# Use diagonal of within-class variance\nprint()\nt0 = time.perf_counter()\nvars_diag = np.array([xx[yy==i].var(0).sum() for i in range(20)])  # total within-class variance\n# W2 approx: ||c_i - c_j||\"'^2/2 + (σ_i² + σ_j²)/2... no, W2² ≈ ||c_i-c_j||² + trace(Σ_i + Σ_j - 2(Σ_i''^{1/2}Σ_jΣ_i''^{1/2})''^{1/2})\n# For diagonal: W2² ≈ ||c_i-c_j||² + sum_k (sqrt(σ_i_k) - sqrt(σ_j_k))²\nW2_approx = np.zeros((20,20), np.float64)\nfor i in range(20):\n    for j in range(20):\n        W2_approx[i,j] = W_cent[i,j] + np.sum((np.sqrt(np.maximum(xx[yy==i].var(0),0)) - np.sqrt(np.maximum(xx[yy==j].var(0),0)))**2) / 2\nprint(f'\"'W2 approx time: {time.perf_counter()-t0:.3f}s')\n# Scale to match\nsum_approx = sum(W2_approx[i,j] for i,j in pairs_to_compute)\nscale2 = sum_ref / sum_approx\nW2_scaled = W2_approx * scale2\nv_w2 = compute_values(x, y, r, ry, W2_scaled.astype(np.float32))\ndiff = v_ref - v_w2\nnrmse = np.sqrt(np.mean(diff**2)) / np.std(v_ref)\nspear = spearmanr(v_ref, v_w2)[0]\ntop_w2 = set(np.argsort(-v_w2)[:k])\noverlap = len(top_ref & top_w2) / k\nprint(f'W2 approx (scaled): NRMSE={nrmse:.4f}, Spearman={spear:.6f}, TopQ={overlap:.4f}')\nprint(f'  W max rel diff: {np.abs(W_ref - W2_scaled).max() / max(W_ref.max(), 1e-12):.4f}')\n\n# Check: does W error just get absorbed into potentials (relative)?\n# The F potentials are at the same regularization as W is used in the cost\n# If W is wrong, both the cost function and F computation are wrong in the same way\n# But the canonical target uses correct W, so we need close values\nprint()\n# The target is canonical values using correct W\n# We need NRMSE < 0.01\nPYEOF\ntimeout 300 python3 /tmp/test_w_approximation.py 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

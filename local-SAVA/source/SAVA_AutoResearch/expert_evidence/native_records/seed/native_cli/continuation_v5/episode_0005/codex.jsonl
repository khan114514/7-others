{"type": "item.started", "item": {"id": "item_74", "type": "command_execution", "command": "/bin/sh -lc \"python3 -c \\\"\nimport numpy as np, torch, time\nfrom geomloss import SamplesLoss\ntorch.set_num_threads(2)\n\nd = np.load('/workspace/environment/public_assets/dev/seed_101_gaussian_008.npz')\nx, y, r, ry = d['x'], d['y'], d['r'], d['ry']\nx = np.asarray(x, np.float32); r = np.asarray(r, np.float32)\ny = np.asarray(y, np.int64); ry = np.asarray(ry, np.int64)\n\nxx = np.concatenate([x[:1024], r[:1024]])\nyy = np.concatenate([y[:1024], ry[:1024] + 10])\nxx_t = torch.tensor(xx, dtype=torch.float32)\n\n# Default scaling\nloss_def = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\n# Lower scaling (fewer scaling steps)\nloss_s05 = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized', scaling=0.5)\nloss_s07 = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized', scaling=0.7)\nloss_s09 = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized', scaling=0.9)\n\n# Reference\nW_ref = np.zeros((20,20), dtype=np.float32)\nwith torch.inference_mode():\n    for i in range(20):\n        for j in range(i+1, 20):\n            W_ref[i,j] = W_ref[j,i] = float(loss_def(xx_t[yy==i], xx_t[yy==j]))\n\nfor name, loss in [('default', loss_def), ('scaling=0.5', loss_s05), ('scaling=0.7', loss_s07), ('scaling=0.9', loss_s09)]:\n    W = np.zeros((20,20), dtype=np.float32)\n    t0 = time.perf_counter()\n    with torch.inference_mode():\n        for i in range(20):\n            for j in range(i+1, 20):\n                W[i,j] = W[j,i] = float(loss(xx_t[yy==i], xx_t[yy==j]))\n    t = time.perf_counter() - t0\n    diff = np.abs(W_ref - W)\n    print(f'{name}: {t:.3f}s, max_abs_diff={diff.max():.4f}, max_rel_diff={(diff/np.maximum(W_ref,1e-12)).max():.4e}')\n\\\" 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

{"type": "item.started", "item": {"id": "item_76", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/test_warmstart.py << 'EOF'\n\\\"\\\"\\\"\nHypothesis: \n- We need F potentials at canonical reg (reg_c = 0.1, with raw C = 0.1*C_max in normalized space)\n- We already compute matched-blur potentials at reg_m = 0.1 (normalized C)\n- If we can convert matched-blur (reg_m=0.1 C_norm) potentials to canonical (reg_c = 0.1*C_max in raw = different reg) potentials with a few log-sinkhorn iterations, we can save the canonical GeomLoss call per pair.\n\nActually wait: \n- Canonical GeomLoss: blur=√0.1 with p=2, custom cost function using raw C\n  - For p=2, effective reg = blur²/2 * p = wait, let me recheck\n  - From geomloss docs: Sinkhorn divergence with cost c(x,y) = ||x-y||\"'^p/p and blur ε has reg = ε''^p\n  \nActually for p=2 and Euclidean cost, reg = blur². But we use custom cost (sqeuclidean/2 + W/2).\nThe cost function values are in the range [0, C_max]. The blur parameter is used as a regularization strength with respect to the cost.\n\nLet me just verify: canonical GeomLoss potentials correspond to POT with what reg?\n\"\"\"\nimport numpy as np, torch, time\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nfrom scipy.special import logsumexp\nimport ot\ntorch.set_num_threads(2)\n\nd = np.load('\"'/workspace/environment/public_assets/dev/seed_101_gaussian_008.npz')\nx, y, r, ry = d['x'], d['y'], d['r'], d['ry']\nx = np.asarray(x, np.float32); r = np.asarray(r, np.float32)\ny = np.asarray(y, np.int64); ry = np.asarray(ry, np.int64)\n\n# First batch pair\na = x[:1024]; b = r[:1024]\nay = y[:1024]; by = ry[:1024] + 10\n\nW = np.zeros((20,20), np.float32)\nloss_w = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\nxx_t = torch.tensor(np.concatenate([a, b]), dtype=torch.float32)\nyy = np.concatenate([ay, by])\nwith torch.inference_mode():\n    for i in range(20):\n        for j in range(i+1, 20):\n            W[i,j] = W[j,i] = float(loss_w(xx_t[yy==i], xx_t[yy==j]))\n\ndef cost_fn(z1, z2):\n    d2 = torch.cdist(z1[:,:,:-1], z2[:,:,:-1]).square() / 2\n    return d2 + torch.as_tensor(W)[z1[:,:,-1].long().unsqueeze(2), z2[:,:,-1].long().unsqueeze(1)] / 2\n\nC = (cdist(a, b, 'sqeuclidean') / 2.0 + W[ay[:, None], by[None, :]] / 2.0).astype(np.float64)\nC_max = float(C.max())\nC_norm = C / C_max\n\n# Canonical POT: C/C_max, reg=0.1\nn, m = 1024, 1024\nP_canon = ot.sinkhorn(ot.unif(n), ot.unif(m), C_norm, 0.1, numItermax=10000)\nbc_canon = float(np.sum(P_canon * C)) / (n + m)\nprint(f'Canonical POT batchcost: {bc_canon:.6f}')\n\n# Canonical GeomLoss potentials\npot_c = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                    potentials=True, cost=cost_fn, backend='tensorized')\nz1 = torch.tensor(np.column_stack([a, ay]), dtype=torch.float32)[None]\nz2 = torch.tensor(np.column_stack([b, by]), dtype=torch.float32)[None]\nwith torch.inference_mode():\n    f_c_t, g_c_t = pot_c(z1, z2)\nf_c = f_c_t.numpy().ravel().astype(np.float64)\ng_c = g_c_t.numpy().ravel().astype(np.float64)\nprint(f'Canonical GeomLoss f: mean={f_c.mean():.3f}, std={f_c.std():.3f}')\n# What reg in raw-C space does this correspond to?\n# Check by verifying f + g = C on the coupling support, or try to match POT at different reg\n\n# Try POT with various reg_raw values and compare potentials\nfor reg_raw in [0.05, 0.1, 0.5, 1.0, 2.0, 5.0, 10.0]:\n    # POT in raw C space, reg = reg_raw\n    P = ot.sinkhorn(ot.unif(n), ot.unif(m), C, reg_raw, numItermax=10000)\n    # Get dual potentials from POT\n    # Actually ot.sinkhorn returns P, we need potentials\n    # Use log-sinkhorn\n    log_a = np.log(ot.unif(n))\n    log_b = np.log(ot.unif(m))\n    f_pot = np.zeros(n); g_pot = np.zeros(m)\n    for _ in range(5000):\n        f_new = -reg_raw * logsumexp(log_b[None, :] + (g_pot[None, :] - C) / reg_raw, axis=1)\n        g_new = -reg_raw * logsumexp(log_a[:, None] + (f_pot[:, None] - C) / reg_raw, axis=0)\n        f_pot = f_new; g_pot = g_new\n    \n    # Compare with canonical GeomLoss (shift-invariant)\n    # f_c and f_pot should differ by a constant\n    diff_f = (f_c - f_c.mean()) - (f_pot - f_pot.mean())\n    diff_g = (g_c - g_c.mean()) - (g_pot - g_pot.mean())\n    print(f'  reg_raw={reg_raw}: f diff std={diff_f.std():.4f}, g diff std={diff_g.std():.4f}')\n\nprint()\n# Now: matched-blur potentials (in C_norm, reg=0.1)\nblur_match = np.sqrt(0.1 * C_max)\npot_m = SamplesLoss('sinkhorn', p=2, blur=blur_match, debias=False,\n                    potentials=True, cost=cost_fn, backend='tensorized')\nwith torch.inference_mode():\n    f_m_t, g_m_t = pot_m(z1, z2)\nf_m = f_m_t.numpy().ravel().astype(np.float64) / C_max  # in C_norm units\ng_m = g_m_t.numpy().ravel().astype(np.float64) / C_max\n# These satisfy Sinkhorn at reg=0.1 in C_norm space\nprint(f'Matched-blur potentials (C_norm space): f mean={f_m.mean():.4f}, std={f_m.std():.4f}')\n\n# Canonical potentials in C_norm space\nf_c_norm = f_c / C_max\ng_c_norm = g_c / C_max\nprint(f'Canonical potentials (C_norm space): f mean={f_c_norm.mean():.4f}, std={f_c_norm.std():.4f}')\ndiff_c = (f_c_norm - f_c_norm.mean()) - (f_m - f_m.mean())\nprint(f'Diff between matched and canonical (normalized): std={diff_c.std():.4f}, max={np.abs(diff_c).max():.4f}')\n\nEOF\npython3 /tmp/test_warmstart.py 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

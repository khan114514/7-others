{"type": "item.started", "item": {"id": "item_113", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/reg_calibrate.py << 'PYEOF'\n\\\"\\\"\\\"Find reg_raw that matches GeomLoss for a simple label-cost pair.\\\"\\\"\\\"\nimport numpy as np, torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nfrom scipy.special import logsumexp\ntorch.set_num_threads(2)\n\nd = np.load('/workspace/environment/public_assets/dev/seed_101_gaussian_008.npz')\nx, y, r, ry = d['x'], d['y'], d['r'], d['ry']\nx = np.asarray(x, np.float32); r = np.asarray(r, np.float32)\ny = np.asarray(y, np.int64); ry = np.asarray(ry, np.int64)\n\nxx = np.concatenate([x[:1024], r[:1024]])\nyy = np.concatenate([y[:1024], ry[:1024] + 10])\nxx_t = torch.tensor(xx, dtype=torch.float32)\n\n# Take one pair (0, 10)\ni, j = 0, 10\na = xx_t[yy==i]; b = xx_t[yy==j]\nloss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\nwith torch.inference_mode():\n    w_gl = float(loss(a, b))\nprint(f'GeomLoss W[{i},{j}] = {w_gl:.6f}')\n\na_np = a.numpy(); b_np = b.numpy()\nC = cdist(a_np, b_np, 'sqeuclidean') / 2.0\nna, nb = a_np.shape[0], b_np.shape[0]\nC_max = C.max()\nprint(f'C shape: {C.shape}, C_max: {C_max:.2f}')\n\n# For p=2 with Euclidean cost ||x-y||²/2, what is reg?\n# geomloss docs: cost(x,y) = ||x-y||\"'^p / p, blur = ε, Sinkhorn divergence with reg = ε''^p\n# For p=2: reg = ε² = blur² = 0.1\n# But the cost is ||x-y||²/2, so... hmm.\n# Actually with p=2 and Euclidean cost, the effective reg = blur² = 0.1\n\n# Verify by computing Sinkhorn loss = <P,C> + reg*KL(P|a⊗b) - reg*KL(a|a) - reg*KL(b|b)\n# debias=False means Sinkhorn loss = <P,C> + reg*KL(P|a⊗b) - reg*log(1) - reg*log(1) = <P,C> + reg*KL(P|a⊗b)\n# But loss() returns the scalar loss value, which should be the OT cost + reg*entropy\n\n# Let'\"'s compute log-sinkhorn at different reg values and compare the loss\nlog_a = np.log(np.ones(na) / na)\nlog_b = np.log(np.ones(nb) / nb)\n\nfor reg_raw in [0.05, 0.1, 0.2, 0.5, 1.0, 2.0, 5.0, 10.0, 20.0, 50.0, 100.0]:\n    f = np.zeros(na); g = np.zeros(nb)\n    for _ in range(500):\n        f = -reg_raw * logsumexp(log_b[None, :] + (g[None, :] - C) / reg_raw, axis=1)\n        g = -reg_raw * logsumexp(log_a[:, None] + (f[:, None] - C) / reg_raw, axis=0)\n    log_P = log_a[:, None] + log_b[None, :] + (f[:, None] + g[None, :] - C) / reg_raw\n    P = np.exp(log_P)\n    # Sinkhorn loss = sum(P*C) + reg * sum(P * log(P / (a⊗b)))\n    # = sum(P*C) + reg * (sum(P*logP) - sum(P*log(a⊗b)))\n    # Since log(a_i) = -log(na), etc.\n    ent = np.sum(P * (log_P - log_a[:, None] - log_b[None, :]))\n    sinkhorn_loss = float(np.sum(P * C)) + reg_raw * ent\n    w2_cost = float(np.sum(P * C))\n    rel_diff = abs(sinkhorn_loss - w_gl) / w_gl\n    print(f'reg={reg_raw:6.1f}: sinkhorn_loss={sinkhorn_loss:.4f}, W2_cost={w2_cost:.4f}, rel_diff={rel_diff:.4e}')\n\nPYEOF\npython3 /tmp/reg_calibrate.py 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

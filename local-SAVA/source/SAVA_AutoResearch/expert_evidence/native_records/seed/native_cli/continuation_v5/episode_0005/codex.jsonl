urate potentials at different reg values\nimport ot\nfor reg_raw in [50, 100, 200, 500, 1000, 2000]:\n    P = ot.sinkhorn(ot.unif(n), ot.unif(m), C, reg_raw, numItermax=10000)\n    # Recover potentials: f = reg_raw * log(u), g = reg_raw * log(v)\n    # where P = diag(u)  @  K  @  diag(v)\n    u = np.ones(n) / n\n    v = np.ones(m) / m\n    # Reconstruct from POT: P = u * K * v where K = exp(-C/reg)\n    K = np.exp(-C / reg_raw)\n    # u = P.sum(1) / (K  @  v), but easier: run a few iters from uniform to get u,v\n    for _ in range(2000):\n        u = ot.unif(n) / (K  @  v)\n        v = ot.unif(m) / (K.T  @  u)\n    f_pot = reg_raw * np.log(u)\n    F_pot = (f_pot - f_pot.mean()) * n / (n - 1)\n    ratio = F_pot.std() / F_std_gl\n    print(f'reg_raw={reg_raw:5d}: F_pot std={F_pot.std():.2f}, ratio={ratio:.4f}')\n\nPYEOF\ntimeout 120 python3 /tmp/reg_find2.py 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

{"type": "item.started", "item": {"id": "item_134", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/test_v19.py << 'PYEOF'\n\\\"\\\"\\\"v19: Single canonical GeomLoss per pair, used for both F and batchcost.\nBatchcost uses C_max-normalized refinement (fixes v18 bug).\n\\\"\\\"\\\"\nimport numpy as np, torch, time\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nfrom scipy.special import logsumexp\nimport ot\ntorch.set_num_threads(2)\n\nd = np.load('/workspace/environment/public_assets/dev/seed_101_gaussian_008.npz')\nx, y, r, ry, seed = d['x'], d['y'], d['r'], d['ry'], int(d['seed'])\n\ndef value_v19(x, y, r, ry, seed=17, batch_size=1024, refine_iters=10):\n    x = np.asarray(x, np.float32); r = np.asarray(r, np.float32)\n    y = np.asarray(y, np.int64); ry = np.asarray(ry, np.int64)\n    tx = [np.arange(i, min(i + batch_size, len(x))) for i in range(0, len(x), batch_size)]\n    tr = [np.arange(i, min(i + batch_size, len(r))) for i in range(0, len(r), batch_size)]\n\n    # Label cost\n    xx = torch.tensor(np.concatenate([x[tx[0]], r[tr[0]]]), dtype=torch.float32)\n    yy = np.concatenate([y[tx[0]], ry[tr[0]] + 10])\n    W = np.zeros((20, 20), dtype=np.float32)\n    loss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\n    with torch.inference_mode():\n        for i in range(20):\n            for j in range(i + 1, 20):\n                if not (yy == i).any() or not (yy == j).any():\n                    raise ValueError('Initial batch lacks a label support')\n                W[i, j] = W[j, i] = float(loss(xx[yy == i], xx[yy == j]))\n\n    def cost(z1, z2):\n        d2 = torch.cdist(z1[:, :, :-1], z2[:, :, :-1]).square() / 2\n        return d2 + torch.as_tensor(W)[z1[:, :, -1].long().unsqueeze(2),\n                                       z2[:, :, -1].long().unsqueeze(1)] / 2\n\n    # Single canonical GeomLoss for F potentials\n    pot_f = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                        potentials=True, cost=cost, backend='tensorized')\n\n    F = {}\n    batchcost = np.zeros((len(tx), len(tr)))\n    reg_norm = 0.1\n\n    for i, idx in enumerate(tx):\n        for j, jdx in enumerate(tr):\n            a = x[idx]; b = r[jdx]\n            n_src = len(idx); n_tgt = len(jdx)\n\n            z1 = torch.tensor(np.column_stack([a, y[idx]]), dtype=torch.float32)[None]\n            z2 = torch.tensor(np.column_stack([b, ry[jdx] + 10]), dtype=torch.float32)[None]\n\n            C = (cdist(a, b, 'sqeuclidean') / 2.0 +\n                 W[y[idx, None], ry[jdx][None, :] + 10] / 2.0).astype(np.float64)\n            C_max = max(float(C.max()), 1e-12)\n            C_norm = C / C_max\n\n            # Single canonical GeomLoss for F potentials\n            with torch.inference_mode():\n                f_t, g_t = pot_f(z1, z2)\n            f = f_t.numpy().ravel().astype(np.float64)\n            g = g_t.numpy().ravel().astype(np.float64)\n\n            # F potentials (same convention)\n            F[i, j] = (f - f.mean()) * len(f) / (len(f) - 1)\n\n            # Batchcost: use canonical potentials as warm start, refine in C_max-normalized space\n            # Canonical GeomLoss uses eps=0.1 (blur²) in raw C units\n            # In C_norm: eps_norm = 0.1 / C_max (very small)\n            # We need to refine to reg_norm=0.1 (C_norm space)\n            # \n            # Wait - canonical GeomLoss is at very low reg in C_norm space\n            # So the coupling from canonical is already very close to true OT\n            # For batchcost, we want reg=0.1 in C_norm space (much higher reg)\n            # Going from low reg to high reg is easy (a few iterations)\n            \n            a_w = np.ones(n_src, np.float64) / n_src\n            b_w = np.ones(n_tgt, np.float64) / n_tgt\n            log_a = np.log(a_w)\n            log_b = np.log(b_w)\n\n            # Scale canonical potentials to C_norm space\n            f_bc = f / C_max\n            g_bc = g / C_max\n\n            for _ in range(refine_iters):\n                f_bc = -reg_norm * logsumexp(log_b[None, :] + (g_bc[None, :] - C_norm) / reg_norm, axis=1)\n                g_bc = -reg_norm * logsumexp(log_a[:, None] + (f_bc[:, None] - C_norm) / reg_norm, axis=0)\n\n            log_P = log_a[:, None] + log_b[None, :] + (f_bc[:, None] + g_bc[None, :] - C_norm) / reg_norm\n            P = np.exp(log_P)\n            batchcost[i, j] = float(np.sum(P * C)) / (n_src + n_tgt)\n\n    bc_max = max(float(batchcost.max()), 1e-12)\n    Q = ot.sinkhorn(np.ones(len(tx)) / len(tx),\n                    np.ones(len(tr)) / len(tr),\n                    batchcost / bc_max, .01,\n                    numItermax=10000, stopThr=1e-10)\n    residual = max(np.max(np.abs(Q.sum(1) - 1.0 / len(tx))),\n                   np.max(np.abs(Q.sum(0) - 1.0 / len(tr))))\n    if residual > 1e-6:\n        raise ValueError(f'Unconverged batch transport: {residual}')\n\n    values = np.zeros(len(x))\n    for i, idx in enumerate(tx):\n        values[idx] = sum(Q[i, j] * F[i, j] for j in range(len(tr)))\n    return values\n\n# Reference v17\nimport importlib.util\nspec = importlib.util.spec_from_file_location('m17', '/opt/public_eval/results/d59d4477172c4c07879ab4c58e96cd07.method.py')\nm17 = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(m17)\n\nt0 = time.perf_counter()\nv_ref = m17.value(x, y, r, ry, seed)\nt17 = time.perf_counter() - t0\nprint(f'v17: {t17:.3f}s, std={v_ref.std():.2f}')\n\nfor ri in [1, 2, 3, 5, 10, 20]:\n    t0 = time.perf_counter()\n    v = value_v19(x, y, r, ry, seed, refine_iters=ri)\n    t = time.perf_counter() - t0\n    diff = v_ref - v\n    nrmse = np.sqrt(np.mean(diff**2)) / np.std(v_ref)\n    from scipy.stats import spearmanr\n    spear = spearmanr(v_ref, v)[0]\n    n = len(v_ref); k = n // 4\n    top_ref = set(np.argsort(-v_ref)[:k])\n    top_v = set(np.argsort(-v)[:k])\n    overlap = len(top_ref & top_v) / k\n    print(f'v19 refine={ri:2d}: {t:.3f}s, NRMSE={nrmse:.4e}, Spearman={spear:.6f}, TopQ={overlap:.4f}')\n\nPYEOF\ntimeout 200 python3 /tmp/test_v19.py 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

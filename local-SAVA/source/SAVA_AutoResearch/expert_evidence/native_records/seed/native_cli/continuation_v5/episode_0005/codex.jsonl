{"type": "item.started", "item": {"id": "item_129", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/v19_idea.py << 'PYEOF'\n\\\"\\\"\\\"v19 idea: use matched-blur potentials as warm start, refine to canonical reg.\nReplace the 2nd GeomLoss (canonical F) with log-sinkhorn iterations.\n\\\"\\\"\\\"\nimport numpy as np, torch, time\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nfrom scipy.special import logsumexp\nimport ot\ntorch.set_num_threads(2)\n\nd = np.load('/workspace/environment/public_assets/dev/seed_101_gaussian_008.npz')\nx, y, r, ry = d['x'], d['y'], d['r'], d['ry']\nx = np.asarray(x, np.float32); r = np.asarray(r, np.float32)\ny = np.asarray(y, np.int64); ry = np.asarray(ry, np.int64)\n\n# Setup first pair\na = x[:1024]; b = r[:1024]\nay = y[:1024]; by = ry[:1024] + 10\n\n# Compute W\nxx_t = torch.tensor(np.concatenate([a, b]), dtype=torch.float32)\nyy = np.concatenate([ay, by])\nloss_w = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\nW = np.zeros((20,20), np.float32)\nwith torch.inference_mode():\n    for i in range(20):\n        for j in range(i+1, 20):\n            W[i,j] = W[j,i] = float(loss_w(xx_t[yy==i], xx_t[yy==j]))\n\ndef cost_fn(z1, z2):\n    d2 = torch.cdist(z1[:,:,:-1], z2[:,:,:-1]).square() / 2\n    return d2 + torch.as_tensor(W)[z1[:,:,-1].long().unsqueeze(2), z2[:,:,-1].long().unsqueeze(1)] / 2\n\nC = (cdist(a, b, 'sqeuclidean') / 2.0 + W[ay[:, None], by[None, :]] / 2.0).astype(np.float64)\nC_max = float(C.max())\nC_norm = C / C_max\nn, m = 1024, 1024\nprint(f'C_max = {C_max:.2f}')\n\n# Reference: canonical GeomLoss F potentials\npot_c = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                    potentials=True, cost=cost_fn, backend='tensorized')\nz1 = torch.tensor(np.column_stack([a, ay]), dtype=torch.float32)[None]\nz2 = torch.tensor(np.column_stack([b, by]), dtype=torch.float32)[None]\nt0 = time.perf_counter()\nfor _ in range(3):\n    with torch.inference_mode():\n        f_c, g_c = pot_c(z1, z2)\nt_canon = (time.perf_counter() - t0) / 3\nf_c = f_c.numpy().ravel().astype(np.float64)\ng_c = g_c.numpy().ravel().astype(np.float64)\nF_c = (f_c - f_c.mean()) * n / (n - 1)\nprint(f'Canonical F: {t_canon*1000:.1f}ms, F_std={F_c.std():.2f}')\n\n# Matched-blur potentials (already used for batchcost)\nblur_match = np.sqrt(0.1 * C_max)\npot_m = SamplesLoss('sinkhorn', p=2, blur=blur_match, debias=False,\n                    potentials=True, cost=cost_fn, backend='tensorized')\nt0 = time.perf_counter()\nfor _ in range(3):\n    with torch.inference_mode():\n        f_m, g_m = pot_m(z1, z2)\nt_match = (time.perf_counter() - t0) / 3\nf_m = f_m.numpy().ravel().astype(np.float64)\ng_m = g_m.numpy().ravel().astype(np.float64)\nF_m = (f_m - f_m.mean()) * n / (n - 1)\nprint(f'Matched-blur: {t_match*1000:.1f}ms, F_std={F_m.std():.2f}')\n\n# How many log-sinkhorn iterations at canonical reg does it take to\n# refine matched-blur potentials to canonical accuracy?\n# First: what is the canonical reg in C_norm space?\n# From docs: with custom cost, eps = blur\n# Wait, no - for custom cost, eps = blur\"'^p where p is the exponent parameter\n# But cost can be anything...\n# Let me empirically find the reg_c in C_norm that gives matching F\n\nlog_a = np.log(np.ones(n) / n)\nlog_b = np.log(np.ones(m) / m)\n\n# Use matched-blur potentials in C_norm as initial guess\n# f_m is in raw-C units, convert to C_norm\nf_m_norm = f_m / C_max\ng_m_norm = g_m / C_max\n\n# Test different reg_norm values, refine from matched-blur init\nprint()\nprint('\"'Refining matched-blur init to find canonical reg:')\nbest_reg = None\nbest_diff = float('inf')\nfor reg_n in [1e-4, 5e-5, 2e-5, 1e-5, 5e-6, 2e-6, 1e-6, 5e-7]:\n    f = f_m_norm.copy(); g = g_m_norm.copy()\n    for it in range(100):\n        f = -reg_n * logsumexp(log_b[None, :] + (g[None, :] - C_norm) / reg_n, axis=1)\n        g = -reg_n * logsumexp(log_a[:, None] + (f[:, None] - C_norm) / reg_n, axis=0)\n        if it in [4, 9, 24, 49, 99]:\n            F_refine = (f * C_max - (f * C_max).mean()) * n / (n - 1)\n            diff = F_c - F_refine\n            d_std = diff.std()\n            if d_std < best_diff:\n                best_diff = d_std\n                best_reg = reg_n\n            print(f'  reg_n={reg_n:.1e}, iter={it+1}: diff_std={d_std:.2f} (rel={d_std/F_c.std():.4e})')\n\nprint()\nprint(f'Best reg_norm: {best_reg:.1e}, best_diff_std={best_diff:.2f}')\nprint(f'Equivalent reg_raw = {best_reg * C_max:.2f}')\n\nPYEOF\ntimeout 120 python3 /tmp/v19_idea.py 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

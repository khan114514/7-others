{"type": "item.completed", "item": {"id": "item_9", "type": "command_execution", "command": "/bin/sh -lc 'cat /workspace/solution/method.py'", "aggregated_output": "\"\"\"v18: Single canonical-blur GeomLoss per pair used for both F potentials and batchcost.\n- Removes second GeomLoss call; log-domain refines potentials for accurate batchcost\n- Expected: ~1.5-2x faster than v17 while maintaining quality\n\"\"\"\nimport numpy as np\nimport torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nfrom scipy.special import logsumexp\nimport ot\n\n\ndef _label_cost(x, y, r, ry):\n    xx = torch.tensor(np.concatenate([x, r]), dtype=torch.float32)\n    yy = np.concatenate([y, ry + 10])\n    W = np.zeros((20, 20), dtype=np.float32)\n    loss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\n    with torch.inference_mode():\n        for i in range(20):\n            for j in range(i + 1, 20):\n                if not (yy == i).any() or not (yy == j).any():\n                    raise ValueError('Initial batch lacks a label support')\n                W[i, j] = W[j, i] = float(loss(xx[yy == i], xx[yy == j]))\n    return W\n\n\ndef _make_cost_fn(W):\n    def cost(z1, z2):\n        d = torch.cdist(z1[:, :, :-1], z2[:, :, :-1]).square() / 2\n        return d + torch.as_tensor(W)[z1[:, :, -1].long().unsqueeze(2),\n                                      z2[:, :, -1].long().unsqueeze(1)] / 2\n    return cost\n\n\ndef value(x, y, r, ry, seed=17, batch_size=1024):\n    torch.set_num_threads(2)\n    x = np.asarray(x, np.float32); r = np.asarray(r, np.float32)\n    y = np.asarray(y, np.int64); ry = np.asarray(ry, np.int64)\n    tx = [np.arange(i, min(i + batch_size, len(x))) for i in range(0, len(x), batch_size)]\n    tr = [np.arange(i, min(i + batch_size, len(r))) for i in range(0, len(r), batch_size)]\n\n    W = _label_cost(x[tx[0]], y[tx[0]], r[tr[0]], ry[tr[0]])\n    cost_fn = _make_cost_fn(W)\n\n    pot_f = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                        potentials=True, cost=cost_fn, backend='tensorized')\n\n    F = {}\n    batchcost = np.zeros((len(tx), len(tr)))\n    reg_norm = 0.1\n    refine_iters = 6\n\n    for i, idx in enumerate(tx):\n        for j, jdx in enumerate(tr):\n            a = x[idx]; b = r[jdx]\n            n_src = len(idx); n_tgt = len(jdx)\n\n            z1 = torch.tensor(np.column_stack([a, y[idx]]), dtype=torch.float32)[None]\n            z2 = torch.tensor(np.column_stack([b, ry[jdx] + 10]), dtype=torch.float32)[None]\n\n            C = (cdist(a, b, 'sqeuclidean') / 2.0 +\n                 W[y[idx, None], ry[jdx][None, :] + 10] / 2.0).astype(np.float64)\n\n            # Single canonical GeomLoss for potentials\n            with torch.inference_mode():\n                f_t, g_t = pot_f(z1, z2)\n            f = f_t.numpy().ravel().astype(np.float64)\n            g = g_t.numpy().ravel().astype(np.float64)\n\n            # F potentials (normalized, same convention)\n            F[i, j] = (f - f.mean()) * len(f) / (len(f) - 1)\n\n            # Batchcost: log-domain refinement of canonical potentials for coupling accuracy\n            a_w = np.ones(n_src, np.float64) / n_src\n            b_w = np.ones(n_tgt, np.float64) / n_tgt\n            log_a = np.log(a_w)\n            log_b = np.log(b_w)\n\n            f_bc = f.copy()\n            g_bc = g.copy()\n            for _ in range(refine_iters):\n                f_bc = -reg_norm * logsumexp(log_b[None, :] + (g_bc[None, :] - C) / reg_norm, axis=1)\n                g_bc = -reg_norm * logsumexp(log_a[:, None] + (f_bc[:, None] - C) / reg_norm, axis=0)\n\n            log_P = log_a[:, None] + log_b[None, :] + (f_bc[:, None] + g_bc[None, :] - C) / reg_norm\n            P = np.exp(log_P)\n            batchcost[i, j] = float(np.sum(P * C)) / (n_src + n_tgt)\n\n    bc_max = max(float(batchcost.max()), 1e-12)\n    Q = ot.sinkhorn(np.ones(len(tx)) / len(tx),\n                    np.ones(len(tr)) / len(tr),\n                    batchcost / bc_max, .01,\n                    numItermax=10000, stopThr=1e-10)\n    residual = max(np.max(np.abs(Q.sum(1) - 1.0 / len(tx))),\n                   np.max(np.abs(Q.sum(0) - 1.0 / len(tr))))\n    if residual > 1e-6:\n        raise ValueError(f'Unconverged batch transport: {residual}')\n\n    values = np.zeros(len(x))\n    for i, idx in enumerate(tx):\n        values[idx] = sum(Q[i, j] * F[i, j] for j in range(len(tr)))\n    return values\n", "exit_code": 0, "status": "completed"}}

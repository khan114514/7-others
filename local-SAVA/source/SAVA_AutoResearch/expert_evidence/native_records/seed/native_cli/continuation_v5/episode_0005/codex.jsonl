ck([b, ry[jdx] + 10]), dtype=torch.float32)[None]\n\n            C = (cdist(a, b, 'sqeuclidean') / 2.0 +\n                 W[y[idx, None], ry[jdx][None, :] + 10] / 2.0).astype(np.float64)\n            C_max = max(float(C.max()), 1e-12)\n            blur_match = np.sqrt(reg_norm * C_max)\n            pot_bc = SamplesLoss('sinkhorn', p=2, blur=blur_match, debias=False,\n                                 potentials=True, cost=cost_fn, backend='tensorized')\n            with torch.inference_mode():\n                f_bc_t, g_bc_t = pot_bc(z1, z2)\n            f_bc = f_bc_t.numpy().ravel().astype(np.float64) / C_max\n            g_bc = g_bc_t.numpy().ravel().astype(np.float64) / C_max\n\n            a_w = np.ones(n_src, np.float64) / n_src\n            b_w = np.ones(n_tgt, np.float64) / n_tgt\n            log_a = np.log(a_w)\n            log_b = np.log(b_w)\n            C_norm = C / C_max\n\n            f_ref = f_bc.copy(); g_ref = g_bc.copy()\n            for _ in range(2):\n                f_ref = -reg_norm * logsumexp(log_b[None, :] + (g_ref[None, :] - C_norm) / reg_norm, axis=1)\n                g_ref = -reg_norm * logsumexp(log_a[:, None] + (f_ref[:, None] - C_norm) / reg_norm, axis=0)\n\n            log_P = log_a[:, None] + log_b[None, :] + (f_ref[:, None] + g_ref[None, :] - C_norm) / reg_norm\n            P = np.exp(log_P)\n            batchcost[i, j] = float(np.sum(P * C)) / (n_src + n_tgt)\n\n            with torch.inference_mode():\n                f, _ = pot_f(z1, z2)\n            f = f.numpy().ravel().astype(float)\n            F[i, j] = (f - f.mean()) * len(f) / (len(f) - 1)\n\n    bc_max = max(float(batchcost.max()), 1e-12)\n    Q = ot.sinkhorn(np.ones(len(tx)) / len(tx),\n                    np.ones(len(tr)) / len(tr),\n                    batchcost / bc_max, .01,\n                    numItermax=10000, stopThr=batch_stop)\n    values = np.zeros(len(x))\n    for i, idx in enumerate(tx):\n        values[idx] = sum(Q[i, j] * F[i, j] for j in range(len(tr)))\n    return values\n\n# Test looser batch OT\nfor stop in [1e-4, 1e-5, 1e-6, 1e-7]:\n    t0 = time.perf_counter()\n    v_test = value_looser_batchot(x, y, r, ry, seed, batch_stop=stop)\n    t = time.perf_counter() - t0\n    diff = v_ref - v_test\n    nrmse = np.sqrt(np.mean(diff**2)) / np.std(v_ref)\n    from scipy.stats import spearmanr\n    spear = spearmanr(v_ref, v_test)[0]\n    n = len(v_ref); k = n // 4\n    top_ref = set(np.argsort(-v_ref)[:k])\n    top_test = set(np.argsort(-v_test)[:k])\n    overlap = len(top_ref & top_test) / k\n    print(f'batch_stop={stop:.0e}: time={t:.3f}s, NRMSE={nrmse:.4e}, Spearman={spear:.6f}, TopQ={overlap:.4f}')\n\nPYEOF\npython3 /tmp/quick_tests.py 2>&1\"", "aggregated_output": "batch_stop=1e-04: time=5.823s, NRMSE=0.0000e+00, Spearman=1.000000, TopQ=1.0000\nbatch_stop=1e-05: time=1.804s, NRMSE=0.0000e+00, Spearman=1.000000, TopQ=1.0000\nbatch_stop=1e-06: time=1.814s, NRMSE=0.0000e+00, Spearman=1.000000, TopQ=1.0000\nbatch_stop=1e-07: time=2.280s, NRMSE=0.0000e+00, Spearman=1.000000, TopQ=1.0000\n", "exit_code": 0, "status": "completed"}}
{"type": "item.completed", "item": {"id": "item_126", "type": "reasoning", "text": "Batch OT tolerance doesn't matter since it's negligible for small 3x2 matrices and the time differences come from measurement noise. \n\nLabel cost and pairwise GeomLoss are the real bottlenecks. I've confirmed the effective regularization strength, and will first test the 50-point class subsampling approach to reduce label cost computation, with the ~10% relative error deemed acceptable.\n"}}
{"type": "item.started", "item": {"id": "item_127", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/label_subsample.py << 'PYEOF'\n\\\"\\\"\\\"Test: label cost from subsampled classes + scale calibration.\\\"\\\"\\\"\nimport numpy as np, torch, time, importlib.util\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nfrom scipy.special import logsumexp\nimport ot\ntorch.set_num_threads(2)\n\nd = np.load('/workspace/environment/public_assets/dev/seed_101_gaussian_008.npz')\nx, y, r, ry, seed = d['x'], d['y'], d['r'], d['ry'], int(d['seed'])\nx = np.asarray(x, np.float32); r = np.asarray(r, np.float32)\ny = np.asarray(y, np.int64); ry = np.asarray(ry, np.int64)\n\n# Reference\nspec = importlib.util.spec_from_file_location('m17', '/opt/public_eval/results/d59d4477172c4c07879ab4c58e96cd07.method.py')\nm17 = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(m17)\nv_ref = m17.value(x, y, r, ry, seed)\nprint(f'Reference computed')\n\ndef label_cost_subsampled(x, y, r, ry, subsample=50):\n    xx = torch.tensor(np.concatenate([x, r]), dtype=torch.float32)\n    yy = np.concatenate([y, ry + 10])\n    W = np.zeros((20, 20), dtype=np.float32)\n    loss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\n    with torch.inference_mode():\n        for i in range(20):\n            for j in range(i + 1, 20):\n                xi = xx[yy == i]\n                xj = xx[yy == j]\n                if len(xi) > subsample:\n                    idx = torch.randperm(len(xi))[:subsample]\n                    xi = xi[idx]\n                if len(xj) > subsample:\n                    idx = torch.randperm(len(xj))[:subsample]\n                    xj = xj[idx]\n                W[i, j] = W[j, i] = float(loss(xi, xj))\n    return W\n\ndef value_with_label_cost(x, y, r, ry, W, seed=17, batch_size=1024):\n    \\\"\\\"\\\"Same as v17 but uses provided W.\\\"\\\"\\\"\n    x = np.asarray(x, np.float32); r = np.asarray(r, np.float32)\n    y = np.asarray(y, np.int64); ry = np.asarray(ry, np.int64)\n    tx = [np.arange(i, min(i + batch_size, len(x))) for i in range(0, len(x), batch_size)]\n    tr = [np.arange(i, min(i + batch_size, len(r))) for i in range(0, len(r), batch_size)]\n    \n    def cost_fn(z1, z2):\n        d2 = torch.cdist(z1[:,:,:-1], z2[:,:,:-1]).square() / 2\n        return d2 + torch.as_tensor(W)[z1[:,:,-1].long().unsqueeze(2), z2[:,:,-1].long().unsqueeze(1)] / 2\n    \n    F = {}; batchcost = np.zeros((len(tx), len(tr)))\n    reg_norm = 0.1\n    pot_f = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                        potentials=True, cost=cost_fn, backend='tensorized')\n    \n    for i, idx in enumerate(tx):\n        for j, jdx in enumerate(tr):\n            a = x[idx]; b = r[jdx]\n            n_src = len(idx); n_tgt = len(jdx)\n            C = (cdist(a, b, 'sqeuclidean') / 2.0 +\n                 W[y[idx, None], ry[jdx][None, :] + 10] / 2.0).astype(np.float64)\n            C_max = max(float(C.max()), 1e-12)\n            blur_match = np.sqrt(reg_norm * C_max)\n            pot_bc = SamplesLoss('sinkhorn', p=2, blur=blur_match, debias=False,\n                                 potentials=True, cost=cost_fn, backend='tensorized')\n            z1 = torch.tensor(np.column_stack([a, y[idx]]), dtype=torch.float32)[None]\n            z2 = torch.tensor(np.column_stack([b, ry[jdx] + 10]), dtype=torch.float32)[None]\n            \n            with torch.inference_mode():\n                f_bc_t, g_bc_t = pot_bc(z1, z2)\n            f_bc = f_bc_t.numpy().ravel().astype(np.float64) / C_max\n            g_bc = g_bc_t.numpy().ravel().astype(np.float64) / C_max\n            \n            a_w = np.ones(n_src, np.float64) / n_src\n            b_w = np.ones(n_tgt, np.float64) / n_tgt\n            log_a = np.log(a_w); log_b = np.log(b_w)\n            C_norm = C / C_max\n            f_ref = f_bc.copy(); g_ref = g_bc.copy()\n            for _ in range(2):\n                f_ref = -reg_norm * logsumexp(log_b[None, :] + (g_ref[None, :] - C_norm) / reg_norm, axis=1)\n                g_ref = -reg_norm * logsumexp(log_a[:, None] + (f_ref[:, None] - C_norm) / reg_norm, axis=0)\n            log_P = log_a[:, None] + log_b[None, :] + (f_ref[:, None] + g_ref[None, :] - C_norm) / reg_norm\n            P = np.exp(log_P)\n            batchcost[i, j] = float(np.sum(P * C)) / (n_src + n_tgt)\n            \n            with torch.inference_mode():\n                f, _ = pot_f(z1, z2)\n            f = f.numpy().ravel().astype(float)\n            F[i, j] = (f - f.mean()) * len(f) / (len(f) - 1)\n    \n    bc_max = max(float(batchcost.max()), 1e-12)\n    Q = ot.sinkhorn(np.ones(len(tx)) / len(tx),\n                    np.ones(len(tr)) / len(tr),\n                    batchcost / bc_max, .01,\n                    numItermax=10000, stopThr=1e-10)\n    values = np.zeros(len(x))\n    for i, idx in enumerate(tx):\n        values[idx] = sum(Q[i, j] * F[i, j] for j in range(len(tr)))\n    return values\n\n# Test different subsample sizes\nfor ss in [50, 30, 20]:\n    np.random.seed(42); torch.manual_seed(42)\n    t0 = time.perf_counter()\n    W_ss = label_cost_subsampled(x[:1024], y[:1024], r[:1024], ry[:1024], subsample=ss)\n    t_label = time.perf_counter() - t0\n    \n    t0 = time.perf_counter()\n    v_ss = value_with_label_cost(x, y, r, ry, W_ss, seed)\n    t_total = time.perf_counter() - t0\n    \n    diff = v_ref - v_ss\n    nrmse = np.sqrt(np.mean(diff**2)) / np.std(v_ref)\n    from scipy.stats import spearmanr\n    spear = spearmanr(v_ref, v_ss)[0]\n    n = len(v_ref); k = n // 4\n    top_ref = set(np.argsort(-v_ref)[:k])\n    top_ss = set(np.argsort(-v_ss)[:k])\n    overlap = len(top_ref & top_ss) / k\n    print(f'subsample={ss:3d}: label_time={t_label:.3f}s, total_time={t_total:.3f}s, NRMSE={nrmse:.4e}, Spearman={spear:.6f}, TopQ={overlap:.4f}')\n\nPYEOF\ntimeout 200 python3 /tmp/label_subsample.py 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

{"type": "item.started", "item": {"id": "item_70", "type": "command_execution", "command": "/bin/sh -lc \"python3 -c \\\"\nimport numpy as np, torch, time, ot\nfrom scipy.spatial.distance import cdist\ntorch.set_num_threads(2)\n\nd = np.load('/workspace/environment/public_assets/dev/seed_101_gaussian_008.npz')\nx, y, r, ry = d['x'], d['y'], d['r'], d['ry']\nx = np.asarray(x, np.float32); r = np.asarray(r, np.float32)\ny = np.asarray(y, np.int64); ry = np.asarray(ry, np.int64)\n\nxx = np.concatenate([x[:1024], r[:1024]])\nyy = np.concatenate([y[:1024], ry[:1024] + 10])\n\n# Reference: GeomLoss label cost\nfrom geomloss import SamplesLoss\nxx_t = torch.tensor(xx, dtype=torch.float32)\nloss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\nW_ref = np.zeros((20, 20), dtype=np.float32)\nt0 = time.perf_counter()\nwith torch.inference_mode():\n    for i in range(20):\n        for j in range(i+1, 20):\n            W_ref[i,j] = W_ref[j,i] = float(loss(xx_t[yy==i], xx_t[yy==j]))\nt_geom = time.perf_counter() - t0\nprint(f'GeomLoss label cost: {t_geom:.3f}s')\n\n# POT sinkhorn on raw point clouds (no custom cost needed for label cost since W[i,j] = W2 between raw embeddings)\nW_pot = np.zeros((20, 20), dtype=np.float64)\nt0 = time.perf_counter()\nfor i in range(20):\n    for j in range(i+1, 20):\n        a = xx[yy==i]\n        b = xx[yy==j]\n        na = len(a); nb = len(b)\n        C = cdist(a, b, 'sqeuclidean') / 2.0\n        C_max = C.max()\n        P = ot.sinkhorn(ot.unif(na), ot.unif(nb), C / C_max, 0.1)\n        W_pot[i,j] = W_pot[j,i] = float(np.sum(P * C))\nt_pot = time.perf_counter() - t0\ndiff = np.abs(W_ref - W_pot)\nprint(f'POT label cost: {t_pot:.3f}s, max_abs_diff={diff.max():.3f}, max_rel_diff={(diff/np.maximum(W_ref,1e-12)).max():.4f}')\n\n# POT with fewer iterations (check convergence speed)\nfor niter in [50, 100, 200]:\n    W_pot2 = np.zeros((20, 20), dtype=np.float64)\n    t0 = time.perf_counter()\n    for i in range(20):\n        for j in range(i+1, 20):\n            a = xx[yy==i]\n            b = xx[yy==j]\n            na = len(a); nb = len(b)\n            C = cdist(a, b, 'sqeuclidean') / 2.0\n            C_max = C.max()\n            P = ot.sinkhorn(ot.unif(na), ot.unif(nb), C / C_max, 0.1, numItermax=niter)\n            W_pot2[i,j] = W_pot2[j,i] = float(np.sum(P * C))\n    t2 = time.perf_counter() - t0\n    diff = np.abs(W_ref - W_pot2)\n    print(f'POT {niter} iters: {t2:.3f}s, max_abs_diff={diff.max():.3f}, max_rel_diff={(diff/np.maximum(W_ref,1e-12)).max():.4f}')\n\\\" 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

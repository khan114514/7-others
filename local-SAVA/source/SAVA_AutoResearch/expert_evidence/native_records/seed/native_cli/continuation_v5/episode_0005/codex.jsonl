{"type": "item.started", "item": {"id": "item_68", "type": "command_execution", "command": "/bin/sh -lc \"python3 -c \\\"\n# v17 has 190 label cost pairs + 6*2 = 12 pair calls = 202 total, matches profile\n# Let's check: how much time is label cost (190 pairs ~100x100 each) vs pair calls (6 pairs ~1024x1024 each)?\nimport numpy as np, torch, time\nfrom geomloss import SamplesLoss\ntorch.set_num_threads(2)\n\nd = np.load('/workspace/environment/public_assets/dev/seed_101_gaussian_008.npz')\nx, y, r, ry = d['x'], d['y'], d['r'], d['ry']\nx = np.asarray(x, np.float32); r = np.asarray(r, np.float32)\ny = np.asarray(y, np.int64); ry = np.asarray(ry, np.int64)\n\nxx = np.concatenate([x[:1024], r[:1024]])\nyy = np.concatenate([y[:1024], ry[:1024] + 10])\nxx_t = torch.tensor(xx, dtype=torch.float32)\n\nloss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\n\n# Time 1 pair of 100x100\ni, j = 0, 10\na = xx_t[yy==i]; b = xx_t[yy==j]\nprint(f'Testing {len(a)}x{len(b)} pair')\nwith torch.inference_mode():\n    _ = loss(a, b)  # warmup\nt0 = time.perf_counter()\nfor _ in range(10):\n    with torch.inference_mode():\n        _ = loss(a, b)\nprint(f'100x100: {(time.perf_counter()-t0)/10*1000:.2f}ms per pair')\nprint(f'190 pairs estimate: {(time.perf_counter()-t0)/10*190:.3f}s')\n\n# Time a 1024x1024 pair with custom cost\nW = np.zeros((20, 20), dtype=np.float32)\nwith torch.inference_mode():\n    for i2 in range(20):\n        for j2 in range(i2+1, 20):\n            W[i2,j2] = W[j2,i2] = float(loss(xx_t[yy==i2], xx_t[yy==j2]))\n\ndef cost_fn(z1, z2):\n    d2 = torch.cdist(z1[:, :, :-1], z2[:, :, :-1]).square() / 2\n    return d2 + torch.as_tensor(W)[z1[:, :, -1].long().unsqueeze(2),\n                                    z2[:, :, -1].long().unsqueeze(1)] / 2\n\npot = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                  potentials=True, cost=cost_fn, backend='tensorized')\n\nz1 = torch.tensor(np.column_stack([x[:1024], y[:1024]]), dtype=torch.float32)[None]\nz2 = torch.tensor(np.column_stack([r[:1024], ry[:1024] + 10]), dtype=torch.float32)[None]\nwith torch.inference_mode():\n    _ = pot(z1, z2)  # warmup\nt0 = time.perf_counter()\nfor _ in range(3):\n    with torch.inference_mode():\n        _ = pot(z1, z2)\nprint(f'Canonical GeomLoss 1024x1024 custom cost: {(time.perf_counter()-t0)/3*1000:.2f}ms per pair')\nprint(f'6 pairs estimate: {(time.perf_counter()-t0)/3*6:.3f}s')\n\n# Matched blur\nblur_match = 45.75\npot_m = SamplesLoss('sinkhorn', p=2, blur=blur_match, debias=False,\n                    potentials=True, cost=cost_fn, backend='tensorized')\nwith torch.inference_mode():\n    _ = pot_m(z1, z2)\nt0 = time.perf_counter()\nfor _ in range(3):\n    with torch.inference_mode():\n        _ = pot_m(z1, z2)\nprint(f'Matched-blur GeomLoss 1024x1024: {(time.perf_counter()-t0)/3*1000:.2f}ms per pair')\n\\\" 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

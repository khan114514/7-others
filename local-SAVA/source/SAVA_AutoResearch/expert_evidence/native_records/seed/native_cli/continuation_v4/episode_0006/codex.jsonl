{"type": "item.started", "item": {"id": "item_35", "type": "command_execution", "command": "/bin/sh -lc \"cat > /workspace/solution/method.py << 'PYEOF'\n\\\"\\\"\\\"v14: Unified log-domain Sinkhorn — single solve per pair gives both F and batchcost.\nReplaces dual POT+GeomLoss per pair with one numpy log-domain Sinkhorn at ε=0.1\n(matches GeomLoss's potential regularization). Uses larger batch_size=2048 to\ncut pair count from 6 to 2 (2 candidate batches x 1 reference batch).\n\\\"\\\"\\\"\nimport numpy as np\nimport torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nfrom scipy.special import logsumexp\n\n\ndef _label_cost(x, y, r, ry):\n    xx = torch.tensor(np.concatenate([x, r]), dtype=torch.float32)\n    yy = np.concatenate([y, ry + 10])\n    W = np.zeros((20, 20), dtype=np.float32)\n    loss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\n    with torch.inference_mode():\n        for i in range(20):\n            for j in range(i + 1, 20):\n                if not (yy == i).any() or not (yy == j).any():\n                    raise ValueError('Initial batch lacks a label support')\n                W[i, j] = W[j, i] = float(loss(xx[yy == i], xx[yy == j]))\n    return W\n\n\ndef _log_sinkhorn(C, reg, a, b, max_iter=200, tol=1e-9):\n    \\\"\\\"\\\"Log-domain Sinkhorn. Returns (f, g, P) dual potentials and coupling.\\\"\\\"\\\"\n    n, m = C.shape\n    f = np.zeros(n, dtype=np.float64)\n    g = np.zeros(m, dtype=np.float64)\n    log_a = np.log(a)\n    log_b = np.log(b)\n    C_reg = C / reg\n    for it in range(max_iter):\n        f_prev = f\n        f = -reg * logsumexp(log_b[None, :] + (g[None, :] - C) / reg, axis=1)\n        g = -reg * logsumexp(log_a[:, None] + (f[:, None] - C) / reg, axis=0)\n        if np.max(np.abs(f - f_prev)) < tol:\n            break\n    logP = log_a[:, None] + log_b[None, :] + (f[:, None] + g[None, :] - C) / reg\n    P = np.exp(logP)\n    return f, g, P\n\n\ndef value(x, y, r, ry, seed=17, batch_size=2048):\n    torch.set_num_threads(2)\n    x = np.asarray(x, np.float32)\n    r = np.asarray(r, np.float32)\n    y = np.asarray(y, np.int64)\n    ry = np.asarray(ry, np.int64)\n    N = len(x)\n    M = len(r)\n\n    tx = [np.arange(i, min(i + batch_size, N)) for i in range(0, N, batch_size)]\n    tr = [np.arange(i, min(i + batch_size, M)) for i in range(0, M, batch_size)]\n\n    W = _label_cost(x[tx[0]], y[tx[0]], r[tr[0]], ry[tr[0]])\n\n    eps = 0.1\n    F = {}\n    batchcost = np.zeros((len(tx), len(tr)))\n\n    for i, idx in enumerate(tx):\n        for j, jdx in enumerate(tr):\n            a = x[idx]\n            b = r[jdx]\n            n_src = len(idx)\n            n_tgt = len(jdx)\n\n            C = cdist(a, b, 'sqeuclidean') / 2.0 + W[y[idx[:, None]], ry[jdx[None, :]] + 10] / 2.0\n\n            f, g, P = _log_sinkhorn(C, eps,\n                                    np.ones(n_src) / n_src,\n                                    np.ones(n_tgt) / n_tgt,\n                                    max_iter=200, tol=1e-9)\n\n            batchcost[i, j] = float(np.sum(P * C)) / (n_src + n_tgt)\n            f64 = f.astype(np.float64)\n            F[i, j] = (f64 - f64.mean()) * n_src / (n_src - 1)\n\n    bc_max = max(float(batchcost.max()), 1e-12)\n    import ot\n    Q = ot.sinkhorn(np.ones(len(tx)) / len(tx),\n                    np.ones(len(tr)) / len(tr),\n                    batchcost / bc_max, .01,\n                    numItermax=10000, stopThr=1e-10)\n    residual = max(np.max(np.abs(Q.sum(1) - 1.0 / len(tx))),\n                   np.max(np.abs(Q.sum(0) - 1.0 / len(tr))))\n    if residual > 1e-6:\n        raise ValueError(f'Unconverged batch transport: {residual}')\n\n    values = np.zeros(N)\n    for i, idx in enumerate(tx):\n        values[idx] = sum(Q[i, j] * F[i, j] for j in range(len(tr)))\n    return values\nPYEOF\necho \\\"Written v14 method\\\"\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

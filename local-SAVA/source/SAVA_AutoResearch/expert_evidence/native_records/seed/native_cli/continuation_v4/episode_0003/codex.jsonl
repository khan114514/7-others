{"type": "item.started", "item": {"id": "item_23", "type": "command_execution", "command": "/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np, time, torch, ot\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\n\nnp.random.seed(101)\ntorch.manual_seed(101)\nN, M, D = 1024, 1024, 10\na = np.random.randn(N, D).astype(np.float32)\nb = np.random.randn(M, D).astype(np.float32)\nya = np.random.randint(0, 10, N).astype(np.int64)\nyb = np.random.randint(10, 20, M).astype(np.int64)\nW = np.abs(np.random.randn(20, 20).astype(np.float32)) * 0.5\nW = (W + W.T) / 2\n\nC = cdist(a, b, 'sqeuclidean')/2 + W[ya[:,None], yb[None,:]]/2\nCmax = float(C.max())\n\n# warmup\n_ = ot.sinkhorn(ot.unif(N), ot.unif(M), C/Cmax, 0.1, numItermax=10)\n\n# Time POT Sinkhorn\nt0 = time.time()\nfor _ in range(5):\n    P = ot.sinkhorn(ot.unif(N), ot.unif(M), C/Cmax, 0.1)\nt1 = time.time()\nprint(f'POT sinkhorn (1024x1024): {(t1-t0)/5*1000:.1f}ms per call')\n\nz1 = torch.tensor(np.column_stack([a, ya]), dtype=torch.float32)[None]\nz2 = torch.tensor(np.column_stack([b, yb]), dtype=torch.float32)[None]\n\ndef cost(z1,z2):\n    d = torch.cdist(z1[:,:,:-1], z2[:,:,:-1]).square()/2\n    return d + torch.as_tensor(W)[z1[:,:,-1].long().unsqueeze(2), z2[:,:,-1].long().unsqueeze(1)]/2\n\npotential = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                        potentials=True, cost=cost, backend='tensorized')\n# warmup\nwith torch.inference_mode(): _ = potential(z1, z2)\n\nt0 = time.time()\nfor _ in range(5):\n    with torch.inference_mode(): f, g = potential(z1, z2)\nt1 = time.time()\nprint(f'GeomLoss potentials (1024x1024): {(t1-t0)/5*1000:.1f}ms per call')\n\nloss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, cost=cost, backend='tensorized')\nwith torch.inference_mode(): _ = loss(z1, z2)  # warmup\nt0 = time.time()\nfor _ in range(5):\n    with torch.inference_mode(): v = loss(z1, z2)\nt1 = time.time()\nprint(f'GeomLoss loss value (1024x1024): {(t1-t0)/5*1000:.1f}ms per call')\n\n# Label cost timing\nxx = torch.tensor(np.concatenate([a[:200], b[:200]]), dtype=torch.float32)\nyy = np.concatenate([ya[:200], yb[:200]])\nloss2 = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\nt0 = time.time()\ncnt = 0\nfor i in range(20):\n    for j in range(i+1, 20):\n        if (yy==i).any() and (yy==j).any():\n            with torch.inference_mode(): _ = float(loss2(xx[yy==i], xx[yy==j]))\n            cnt += 1\nt1 = time.time()\nprint(f'Label cost W ({cnt} pairs): {(t1-t0)*1000:.1f}ms total')\n\\\" 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

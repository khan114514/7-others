{"type": "item.started", "item": {"id": "item_29", "type": "command_execution", "command": "/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np, time, torch, ot\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nfrom scipy.stats import spearmanr\n\ndef _label_cost_sinkhorn(x,y,r,ry):\n    xx=torch.tensor(np.concatenate([x,r]),dtype=torch.float32)\n    yy=np.concatenate([y,ry+10])\n    W=np.zeros((20,20),dtype=np.float32)\n    loss=SamplesLoss('sinkhorn',p=2,blur=np.sqrt(.1),debias=False,backend='tensorized')\n    with torch.inference_mode():\n        for i in range(20):\n            for j in range(i+1,20):\n                W[i,j]=W[j,i]=float(loss(xx[yy==i],xx[yy==j]))\n    return W\n\ndef _label_cost_centroid(x,y,r,ry):\n    xx = np.concatenate([x, r])\n    yy = np.concatenate([y, ry+10])\n    centroids = np.zeros((20, x.shape[1]), dtype=np.float32)\n    for k in range(20):\n        mask = yy == k\n        if mask.any():\n            centroids[k] = xx[mask].mean(axis=0)\n    W = cdist(centroids, centroids, 'sqeuclidean').astype(np.float32)\n    return W\n\ndef compute_values(x,y,r,ry,W,batch_size=1024):\n    def cost(z1,z2):\n        d = torch.cdist(z1[:,:,:-1],z2[:,:,:-1]).square()/2\n        return d + torch.as_tensor(W)[z1[:,:,-1].long().unsqueeze(2), z2[:,:,-1].long().unsqueeze(1)]/2\n    potential = SamplesLoss('sinkhorn',p=2,blur=np.sqrt(.1),debias=False,\n                         potentials=True,cost=cost,backend='tensorized')\n    tx=[np.arange(i,min(i+batch_size,len(x))) for i in range(0,len(x),batch_size)]\n    tr=[np.arange(i,min(i+batch_size,len(r))) for i in range(0,len(r),batch_size)]\n    F={}; batchcost=np.zeros((len(tx),len(tr)))\n    for i,idx in enumerate(tx):\n        for j,jdx in enumerate(tr):\n            a=x[idx];b=r[jdx]\n            C=cdist(a,b,'sqeuclidean')/2+W[y[idx,None],ry[jdx][None,:]+10]/2\n            P=ot.sinkhorn(ot.unif(len(idx)),ot.unif(len(jdx)),C/max(float(C.max()),1e-12),.1)\n            batchcost[i,j]=float(np.sum(P*C))/(len(idx)+len(jdx))\n            z1=torch.tensor(np.column_stack([a,y[idx]]),dtype=torch.float32)[None]\n            z2=torch.tensor(np.column_stack([b,ry[jdx]+10]),dtype=torch.float32)[None]\n            with torch.inference_mode(): f,_=potential(z1,z2)\n            f=f.numpy().ravel().astype(float)\n            F[i,j]=(f-f.mean())*len(f)/(len(f)-1)\n    Q=ot.sinkhorn(ot.unif(len(tx)),ot.unif(len(tr)),\n                  batchcost/max(float(batchcost.max()),1e-12),.01,\n                  numItermax=10000,stopThr=1e-10)\n    values=np.zeros(len(x))\n    for i,idx in enumerate(tx): values[idx]=sum(Q[i,j]*F[i,j] for j in range(len(tr)))\n    return values\n\nnp.random.seed(101)\ntorch.manual_seed(101)\nN, M, D = 3000, 2000, 10\nx = np.random.randn(N, D).astype(np.float32)\ny = np.random.randint(0, 10, N).astype(np.int64)\nr = np.random.randn(M, D).astype(np.float32)\nry = np.random.randint(0, 10, M).astype(np.int64)\n\nt0 = time.time()\nW_sh = _label_cost_sinkhorn(x[:1024], y[:1024], r[:1024], ry[:1024])\nt1 = time.time()\nprint(f'Sinkhorn W: {(t1-t0)*1000:.0f}ms')\n\nt0 = time.time()\nW_cent = _label_cost_centroid(x[:1024], y[:1024], r[:1024], ry[:1024])\nt1 = time.time()\nprint(f'Centroid W: {(t1-t0)*1000:.1f}ms')\n\n# Compare W matrices\ndiff = np.abs(W_sh - W_cent)\nprint(f'W diff: max={diff.max():.4f}, mean={diff.mean():.4f}, ratio mean={diff.mean()/W_sh.mean():.4f}')\n\n# Now compute values with both\nv_sh = compute_values(x,y,r,ry,W_sh)\nv_cent = compute_values(x,y,r,ry,W_cent)\n\nstd_t = v_sh.std()\nnrmse = np.sqrt(np.mean((v_sh - v_cent)**2)) / std_t\nsp = spearmanr(v_sh, v_cent).correlation\ntop_q = int(np.floor(N/4))\nidx_sh = np.argsort(-v_sh)[:top_q]\nidx_cent = np.argsort(-v_cent)[:top_q]\noverlap = len(set(idx_sh) & set(idx_cent)) / top_q\nprint(f'NRMSE: {nrmse:.6f} (need <= 0.01)')\nprint(f'Spearman: {sp:.6f} (need >= 0.999)')\nprint(f'Top-quartile overlap: {overlap:.6f} (need >= 0.98)')\n\\\" 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

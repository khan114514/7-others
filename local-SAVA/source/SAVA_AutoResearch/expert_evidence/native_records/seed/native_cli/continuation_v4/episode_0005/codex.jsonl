rch.inference_mode(): f_t, g_t = pot_match(z1, z2)\n        f = f_t.numpy().ravel().astype(float)\n        g = g_t.numpy().ravel().astype(float)\n        \n        # Reconstruct P\n        loga = np.full(n, -np.log(n))\n        logb = np.full(m, -np.log(m))\n        log_P = loga[:,None] + logb[None,:] + (f[:,None] + g[None,:] - C) / reg_eff\n        P_geom = np.exp(log_P)\n        bc_geom = np.sum(P_geom * C) / (n + m)\n        \n        print(f'C_max={C_max:.1f}, reg_eff={reg_eff:.1f}')\n        print(f'POT batchcost:  {bc_pot:.6f}')\n        print(f'Geom batchcost: {bc_geom:.6f}')\n        print(f'ratio: {bc_geom/bc_pot:.6f}')\n        print(f'P_geom row sums max diff: {np.abs(P_geom.sum(axis=1) - 1/n).max():.6e}')\n        print(f'P_geom col sums max diff: {np.abs(P_geom.sum(axis=0) - 1/m).max():.6e}')\n\\\" 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

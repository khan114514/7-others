{"type": "item.started", "item": {"id": "item_42", "type": "command_execution", "command": "/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np, sys\nsys.path.insert(0, '.')\nimport method\nimport torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nimport ot\n\ndata = np.load('/workspace/environment/public_assets/dev/seed_101_uniform_labels.npz')\nx = data['x']; y = data['y']; r = data['r']; ry = data['ry']\ntorch.set_num_threads(2)\nx = np.asarray(x, np.float32); r = np.asarray(r, np.float32)\ny = np.asarray(y, np.int64); ry = np.asarray(ry, np.int64)\nbatch_size = 1024\ntx = [np.arange(i, min(i+batch_size, len(x))) for i in range(0, len(x), batch_size)]\ntr = [np.arange(i, min(i+batch_size, len(r))) for i in range(0, len(r), batch_size)]\n\n# Canonical\nimport copy\nv_canon = method.value(x, y, r, ry, 101)\n\n# Test: same F, but compute Q using approximate batchcost from GeomLoss potentials\nW = method._label_cost(x[tx[0]], y[tx[0]], r[tr[0]], ry[tr[0]])\ndef cost(z1,z2):\n    d = torch.cdist(z1[:,:,:-1], z2[:,:,:-1]).square()/2\n    return d + torch.as_tensor(W)[z1[:,:,-1].long().unsqueeze(2), z2[:,:,-1].long().unsqueeze(1)]/2\npotential = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                       potentials=True, cost=cost, backend='tensorized')\n\nF = {}\nbc_geom = np.zeros((len(tx), len(tr)))\nfor i, idx in enumerate(tx):\n    for j, jdx in enumerate(tr):\n        a = x[idx]; b = r[jdx]\n        z1 = torch.tensor(np.column_stack([a, y[idx]]), dtype=torch.float32)[None]\n        z2 = torch.tensor(np.column_stack([b, ry[jdx]+10]), dtype=torch.float32)[None]\n        with torch.inference_mode(): f_t, g_t = potential(z1, z2)\n        f = f_t.numpy().ravel().astype(float)\n        F[i,j] = (f - f.mean()) * len(f) / (len(f) - 1)\n        # Use entropic cost / (n+m) as batchcost approximation\n        n, m = len(idx), len(jdx)\n        g = g_t.numpy().ravel().astype(float)\n        bc_geom[i,j] = (f.mean() + g.mean()) * n * m / (n + m)\n\n# Also compute canonical batchcost for reference\nbc_pot = np.zeros((len(tx), len(tr)))\nfor i, idx in enumerate(tx):\n    for j, jdx in enumerate(tr):\n        a = x[idx]; b = r[jdx]\n        C = cdist(a,b,'sqeuclidean')/2 + W[y[idx,None], ry[jdx][None,:]+10]/2\n        P = ot.sinkhorn(ot.unif(len(idx)), ot.unif(len(jdx)), C/max(float(C.max()),1e-12), .1)\n        bc_pot[i,j] = float(np.sum(P*C))/(len(idx)+len(jdx))\n\nprint('POT batchcost:')\nprint(bc_pot)\nprint('Geom batchcost approx:')\nprint(bc_geom)\n\n# Compare Q matrices\nQ_pot = ot.sinkhorn(ot.unif(len(tx)), ot.unif(len(tr)),\n              bc_pot/max(float(bc_pot.max()),1e-12), .01,\n              numItermax=10000, stopThr=1e-10)\nQ_geom = ot.sinkhorn(ot.unif(len(tx)), ot.unif(len(tr)),\n              bc_geom/max(float(bc_geom.max()),1e-12), .01,\n              numItermax=10000, stopThr=1e-10)\nprint('Q_pot:')\nprint(Q_pot)\nprint('Q_geom:')\nprint(Q_geom)\nprint('Q diff:', np.abs(Q_pot - Q_geom).max())\n\n# Compute values\nv_geom = np.zeros(len(x))\nfor i, idx in enumerate(tx):\n    v_geom[idx] = sum(Q_geom[i,j] * F[i,j] for j in range(len(tr)))\n\n# Compare to canonical\nnrmse = np.sqrt(np.mean((v_geom - v_canon)**2)) / np.std(v_canon)\nfrom scipy.stats import spearmanr\nrho, _ = spearmanr(v_geom, v_canon)\n# top quartile overlap\nn_q = len(x) // 4\ntop_c = set(np.argsort(-v_canon)[:n_q])\ntop_g = set(np.argsort(-v_geom)[:n_q])\noverlap = len(top_c & top_g) / n_q\nprint(f'NRMSE: {nrmse:.6e}')\nprint(f'Spearman: {rho:.6f}')\nprint(f'Top quartile overlap: {overlap:.6f}')\n\\\" 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

{"type": "item.started", "item": {"id": "item_46", "type": "command_execution", "command": "/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np, sys, time\nsys.path.insert(0, '.')\nimport method\nimport torch\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\nimport ot\n\ndata = np.load('/workspace/environment/public_assets/dev/seed_101_uniform_labels.npz')\nx = data['x']; y = data['y']; r = data['r']; ry = data['ry']\ntorch.set_num_threads(2)\nx = np.asarray(x, np.float32); r = np.asarray(r, np.float32)\ny = np.asarray(y, np.int64); ry = np.asarray(ry, np.int64)\nbatch_size = 1024\ntx = [np.arange(i, min(i+batch_size, len(x))) for i in range(0, len(x), batch_size)]\ntr = [np.arange(i, min(i+batch_size, len(r))) for i in range(0, len(r), batch_size)]\n\n# Canonical result\nv_canon = method.value(x, y, r, ry, 101)\n\nW = method._label_cost(x[tx[0]], y[tx[0]], r[tr[0]], ry[tr[0]])\ndef cost(z1,z2):\n    d = torch.cdist(z1[:,:,:-1], z2[:,:,:-1]).square()/2\n    return d + torch.as_tensor(W)[z1[:,:,-1].long().unsqueeze(2), z2[:,:,-1].long().unsqueeze(1)]/2\n\n# Use GeomLoss for F (canonical reg) + matched-reg GeomLoss for batchcost\n# This replaces slow POT with much faster GeomLoss\npotential = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False,\n                       potentials=True, cost=cost, backend='tensorized')\n\nt0 = time.time()\nF = {}\nbc_new = np.zeros((len(tx), len(tr)))\nfor i, idx in enumerate(tx):\n    for j, jdx in enumerate(tr):\n        a = x[idx]; b = r[jdx]\n        n, m = len(idx), len(jdx)\n        z1 = torch.tensor(np.column_stack([a, y[idx]]), dtype=torch.float32)[None]\n        z2 = torch.tensor(np.column_stack([b, ry[jdx]+10]), dtype=torch.float32)[None]\n        \n        # F from canonical reg\n        with torch.inference_mode(): f_t, _ = potential(z1, z2)\n        f = f_t.numpy().ravel().astype(float)\n        F[i,j] = (f - f.mean()) * len(f) / (len(f) - 1)\n        \n        # batchcost from matched-reg GeomLoss\n        C = cdist(a, b, 'sqeuclidean')/2 + W[y[idx,None], ry[jdx][None,:]+10]/2\n        C_max = float(C.max())\n        reg_eff = 0.1 * C_max\n        pot_match = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(reg_eff), debias=False,\n                                potentials=True, cost=cost, backend='tensorized')\n        with torch.inference_mode(): fm_t, gm_t = pot_match(z1, z2)\n        fm = fm_t.numpy().ravel().astype(float)\n        gm = gm_t.numpy().ravel().astype(float)\n        loga = np.full(n, -np.log(n))\n        logb = np.full(m, -np.log(m))\n        log_P = loga[:,None] + logb[None,:] + (fm[:,None] + gm[None,:] - C) / reg_eff\n        P_g = np.exp(log_P)\n        bc_new[i,j] = np.sum(P_g * C) / (n + m)\nt1 = time.time()\nprint(f'Method time: {t1-t0:.3f}s')\n\n# Compute Q and values\nQ_new = ot.sinkhorn(ot.unif(len(tx)), ot.unif(len(tr)),\n              bc_new/max(float(bc_new.max()),1e-12), .01,\n              numItermax=10000, stopThr=1e-10)\nv_new = np.zeros(len(x))\nfor i, idx in enumerate(tx):\n    v_new[idx] = sum(Q_new[i,j] * F[i,j] for j in range(len(tr)))\n\nnrmse = np.sqrt(np.mean((v_new - v_canon)**2)) / np.std(v_canon)\nfrom scipy.stats import spearmanr\nrho, _ = spearmanr(v_new, v_canon)\nn_q = len(x) // 4\ntop_c = set(np.argsort(-v_canon)[:n_q])\ntop_g = set(np.argsort(-v_new)[:n_q])\noverlap = len(top_c & top_g) / n_q\nprint(f'NRMSE: {nrmse:.6e}')\nprint(f'Spearman: {rho:.6f}')\nprint(f'Top quartile overlap: {overlap:.6f}')\nprint('Q_new:')\nprint(Q_new)\n\\\" 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

m f, g (Ge\n        # P[i,j] = a[i] * b[j] * exp((f[i] + g[j] - C[i,j]) / reg)\n        loga = np.full(n, -np.log(n))\n        logb = np.full(m, -np.log(m))\n        log_P = loga[:,None] + logb[None,:] + (f[:,None] + g[None,:] - C) / reg\n        P_geom = np.exp(log_P)\n        bc_geom = np.sum(P_geom * C) / (n + m)\n        \n        # Also test entropic cost approx\n        ent_cost = (f.mean() + g.mean())\n        # bc approx = ent_cost * something\n        # canonical: bc = sum(P*C) / (n+m)\n        # ent cost = sum(a*f) + sum(b*g) = sum(P*C) + reg*KL\n        # sum(P*C) = ent_cost - reg*KL\n        # bc = (ent_cost - reg*KL) / (n+m)\n        \n        print(f'pair ({i},{j}): n={n}, m={m}, C_max={C.max():.1f}')\n        print(f'  POT batchcost:     {bc_pot:.6f}')\n        print(f'  Geom batchcost:    {bc_geom:.6f}')\n        print(f'  entropic cost/(nm): {ent_cost:.6f}')\n        print(f'  ratio: {bc_geom/bc_pot:.6f}')\n        print()\n\\\" 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

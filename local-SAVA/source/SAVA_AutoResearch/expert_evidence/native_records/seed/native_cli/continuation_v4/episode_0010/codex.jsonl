{"type": "item.started", "item": {"id": "item_120", "type": "command_execution", "command": "/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np, torch, ot, time\nfrom scipy.spatial.distance import cdist\nfrom geomloss import SamplesLoss\n\ntorch.set_num_threads(2)\nd = np.load('/workspace/environment/public_assets/dev/seed_101_asymmetric_labels.npz')\nx, y, r, ry = d['x'], d['y'], d['r'], d['ry']\n\n# Full canonical method timing\ndef canonical_value(x, y, r, ry, batch_size=1024):\n    x=np.asarray(x,np.float32); r=np.asarray(r,np.float32)\n    y=np.asarray(y,np.int64); ry=np.asarray(ry,np.int64)\n    tx=[np.arange(i,min(i+batch_size,len(x))) for i in range(0,len(x),batch_size)]\n    tr=[np.arange(i,min(i+batch_size,len(r))) for i in range(0,len(r),batch_size)]\n    def _label_cost(x,y,r,ry):\n        xx=torch.tensor(np.concatenate([x,r]),dtype=torch.float32)\n        yy=np.concatenate([y,ry+10])\n        W=np.zeros((20,20),dtype=np.float32)\n        loss=SamplesLoss('sinkhorn',p=2,blur=np.sqrt(.1),debias=False,backend='tensorized')\n        with torch.inference_mode():\n            for i in range(20):\n                for j in range(i+1,20):\n                    W[i,j]=W[j,i]=float(loss(xx[yy==i],xx[yy==j]))\n        return W\n    W=_label_cost(x[tx[0]],y[tx[0]],r[tr[0]],ry[tr[0]])\n    def cost(z1,z2):\n        dd=torch.cdist(z1[:,:,:-1],z2[:,:,:-1]).square()/2\n        return dd+torch.as_tensor(W)[z1[:,:,-1].long().unsqueeze(2),z2[:,:,-1].long().unsqueeze(1)]/2\n    potential=SamplesLoss('sinkhorn',p=2,blur=np.sqrt(.1),debias=False,\n                         potentials=True,cost=cost,backend='tensorized')\n    F={}; batchcost=np.zeros((len(tx),len(tr)))\n    for i,idx in enumerate(tx):\n        for j,jdx in enumerate(tr):\n            a=x[idx];b=r[jdx]\n            C=cdist(a,b,'sqeuclidean')/2+W[y[idx,None],ry[jdx][None,:]+10]/2\n            P=ot.sinkhorn(ot.unif(len(idx)),ot.unif(len(jdx)),C/max(float(C.max()),1e-12),.1)\n            batchcost[i,j]=float(np.sum(P*C))/(len(idx)+len(jdx))\n            z1=torch.tensor(np.column_stack([a,y[idx]]),dtype=torch.float32)[None]\n            z2=torch.tensor(np.column_stack([b,ry[jdx]+10]),dtype=torch.float32)[None]\n            with torch.inference_mode(): f,_=potential(z1,z2)\n            f=f.numpy().ravel().astype(float)\n            F[i,j]=(f-f.mean())*len(f)/(len(f)-1)\n    Q=ot.sinkhorn(ot.unif(len(tx)),ot.unif(len(tr)),\n                  batchcost/max(float(batchcost.max()),1e-12),.01,\n                  numItermax=10000,stopThr=1e-10)\n    values=np.zeros(len(x))\n    for i,idx in enumerate(tx): values[idx]=sum(Q[i,j]*F[i,j] for j in range(len(tr)))\n    return values\n\n# Warm up\n_ = canonical_value(x[:200], y[:200], r[:200], ry[:200])\n\nt0 = time.time()\nvals_can = canonical_value(x, y, r, ry)\nt1 = time.time()\nprint(f'Canonical: {t1-t0:.3f}s')\n\n# Now test GeomLoss-only label cost approach (v16):\n# Same label cost as canonical, but single batch + POT for potentials\nimport importlib.util\nspec = importlib.util.spec_from_file_location('method_v15', '/workspace/solution/method.py')\nm = importlib.util.module_from_spec(spec)\nspec.loader.exec_module(m)\n\nt0 = time.time()\nvals_v15 = m.value(x, y, r, ry, seed=101)\nt1 = time.time()\nprint(f'v15: {t1-t0:.3f}s')\n\ndef nrmse(pred, true):\n    return np.sqrt(np.mean((pred - true)**2)) / np.std(true)\ndef spearman(a, b):\n    from scipy.stats import spearmanr\n    return spearmanr(a, b)[0]\ndef topq_overlap(a, b, q=0.25):\n    k = int(len(a) * q)\n    return len(set(np.argsort(-a)[:k]) & set(np.argsort(-b)[:k])) / k\n\nprint()\nprint('v15 vs canonical:')\nprint(f'  NRMSE: {nrmse(vals_v15, vals_can):.6f}')\nprint(f'  Spearman: {spearman(vals_v15, vals_can):.6f}')\nprint(f'  Top25% overlap: {topq_overlap(vals_v15, vals_can):.4f}')\nprint(f'  std(can): {vals_can.std():.4f}, std(v15): {vals_v15.std():.4f}')\n\\\" 2>&1 | grep -v -i warning | grep -v divide | grep -v \\\"v = \\\" | grep -v \\\"u = \\\"\n\
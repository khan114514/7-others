{"type": "item.started", "item": {"id": "item_58", "type": "command_execution", "command": "/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np, time, torch, ot\nfrom scipy.spatial.distance import cdist\nfrom geomloss import SamplesLoss\n\ntorch.set_num_threads(2)\nd = np.load('/workspace/environment/public_assets/dev/seed_101_asymmetric_labels.npz')\nx, y, r, ry = d['x'], d['y'], d['r'], d['ry']\n\n# GeomLoss W (canonical)\ndef w_geomloss(x,y,r,ry):\n    xx=torch.tensor(np.concatenate([x,r]),dtype=torch.float32)\n    yy=np.concatenate([y,ry+10])\n    W=np.zeros((20,20),dtype=np.float64)\n    loss=SamplesLoss('sinkhorn',p=2,blur=np.sqrt(.1),debias=False,backend='tensorized')\n    with torch.inference_mode():\n        for i in range(20):\n            for j in range(i+1,20):\n                W[i,j]=W[j,i]=float(loss(xx[yy==i],xx[yy==j]))\n    return W\n\n# POT W (sinkhorn2)\ndef w_pot(x,y,r,ry):\n    xx=np.concatenate([x,r])\n    yy=np.concatenate([y,ry+10])\n    W=np.zeros((20,20),dtype=np.float64)\n    eps = 0.1\n    for i in range(20):\n        ai = xx[yy==i].astype(np.float64)\n        ni = len(ai)\n        for j in range(i+1,20):\n            bj = xx[yy==j].astype(np.float64)\n            nj = len(bj)\n            C = cdist(ai, bj, 'sqeuclidean') / 2.0\n            d = ot.sinkhorn2(np.ones(ni)/ni, np.ones(nj)/nj, C, eps)\n            W[i,j] = W[j,i] = float(d)\n    return W\n\nt0 = time.time()\nWg = w_geomloss(x[:1024], y[:1024], r[:1024], ry[:1024])\nt1 = time.time()\nprint(f'GeomLoss W: {t1-t0:.3f}s, max={Wg.max():.4f}')\n\nt0 = time.time()\nWp = w_pot(x[:1024], y[:1024], r[:1024], ry[:1024])\nt1 = time.time()\nprint(f'POT W: {t1-t0:.3f}s, max={Wp.max():.4f}')\n\ndiff = np.abs(Wg - Wp)\nprint(f'Max diff: {diff.max():.6f}')\nprint(f'Mean diff: {diff.mean():.6f}')\nprint(f'Relative max diff: {(diff/(Wg+1e-10)).max():.6f}')\n\\\" 2>&1 | grep -v -i warning | grep -v divide\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

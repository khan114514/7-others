{"type": "item.started", "item": {"id": "item_62", "type": "command_execution", "command": "/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np, time, ot\nfrom scipy.spatial.distance import cdist\n\nd = np.load('/workspace/environment/public_assets/dev/seed_101_asymmetric_labels.npz')\nx, y, r, ry = d['x'], d['y'], d['r'], d['ry']\n\n# POT-based label cost\ndef w_pot(x, y, r, ry):\n    xx = np.concatenate([x, r])\n    yy = np.concatenate([y, ry + 10])\n    W = np.zeros((20, 20), dtype=np.float64)\n    eps = 0.1\n    for i in range(20):\n        ai = xx[yy == i].astype(np.float64)\n        ni = len(ai)\n        for j in range(i + 1, 20):\n            bj = xx[yy == j].astype(np.float64)\n            nj = len(bj)\n            C = cdist(ai, bj, 'sqeuclidean') / 2.0\n            d = ot.sinkhorn2(np.ones(ni)/ni, np.ones(nj)/nj, C, eps)\n            W[i, j] = W[j, i] = float(d)\n    return W\n\nt0 = time.time()\nW = w_pot(x[:1024], y[:1024], r[:1024], ry[:1024])\nt1 = time.time()\nprint(f'POT label cost: {t1-t0:.3f}s')\nprint(f'W range: [{W.min():.4f}, {W.max():.4f}]')\n\n# Now do full v15-style computation with POT W\nN, M = len(x), len(r)\nC = cdist(x, r, 'sqeuclidean')/2.0 + W[y[:,None], ry[None,:]+10]/2.0\neps = 0.1\nt0 = time.time()\nP = ot.sinkhorn(np.ones(N)/N, np.ones(M)/M, C, eps, numItermax=2000)\nt1 = time.time()\nprint(f'POT sinkhorn: {t1-t0:.3f}s')\n\n# Derive potentials\nlog_ratio = np.log(P + 1e-300) - np.log(np.ones(N)/N)[:,None] - np.log(np.ones(M)/M)[None,:]\nfg_sum = eps * log_ratio + C\nf = fg_sum.mean(axis=1)\nf_normalized = (f - f.mean()) * N / (N - 1)\nprint(f'Vals: mean={f_normalized.mean():.4f}, std={f_normalized.std():.4f}')\n\n# Compare with v15 (GeomLoss W) values\n\\\" 2>&1 | grep -v -i warning | grep -v divide\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

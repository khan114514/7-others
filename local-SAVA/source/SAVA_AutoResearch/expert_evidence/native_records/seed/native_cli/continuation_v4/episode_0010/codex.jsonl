{"type": "item.started", "item": {"id": "item_49", "type": "command_execution", "command": "/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np, time, sys, torch, ot\nfrom scipy.spatial.distance import cdist\nfrom geomloss import SamplesLoss\n\ntorch.set_num_threads(2)\nd = np.load('/workspace/environment/public_assets/dev/seed_101_asymmetric_labels.npz')\nx, y, r, ry = d['x'], d['y'], d['r'], d['ry']\nN, M = len(x), len(r)\nbatch_size = 1024\ntx = [np.arange(i, min(i+batch_size, N)) for i in range(0, N, batch_size)]\ntr = [np.arange(i, min(i+batch_size, M)) for i in range(0, M, batch_size)]\n\n# Canonical-like timing breakdown\ndef _label_cost(x,y,r,ry):\n    xx=torch.tensor(np.concatenate([x,r]),dtype=torch.float32)\n    yy=np.concatenate([y,ry+10])\n    W=np.zeros((20,20),dtype=np.float32)\n    loss=SamplesLoss('sinkhorn',p=2,blur=np.sqrt(.1),debias=False,backend='tensorized')\n    with torch.inference_mode():\n        for i in range(20):\n            for j in range(i+1,20):\n                W[i,j]=W[j,i]=float(loss(xx[yy==i],xx[yy==j]))\n    return W\n\nt0 = time.time()\nW = _label_cost(x[tx[0]], y[tx[0]], r[tr[0]], ry[tr[0]])\nt1 = time.time()\nprint(f'Label cost: {t1-t0:.3f}s')\n\n# Cost per pair with POT+GeomLoss (like canonical)\ndef cost(z1,z2):\n    dd=torch.cdist(z1[:,:,:-1],z2[:,:,:-1]).square()/2\n    return dd+torch.as_tensor(W)[z1[:,:,-1].long().unsqueeze(2),z2[:,:,-1].long().unsqueeze(1)]/2\npotential=SamplesLoss('sinkhorn',p=2,blur=np.sqrt(.1),debias=False,\n                     potentials=True,cost=cost,backend='tensorized')\n\npair_times_pot = []\npair_times_geom = []\npair_times_cdist = []\nfor i, idx in enumerate(tx):\n    for j, jdx in enumerate(tr):\n        a=x[idx];b=r[jdx]\n        t_s = time.time()\n        C = cdist(a,b,'sqeuclidean')/2+W[y[idx,None],ry[jdx][None,:]+10]/2\n        pair_times_cdist.append(time.time()-t_s)\n        \n        t_s = time.time()\n        P=ot.sinkhorn(ot.unif(len(idx)),ot.unif(len(jdx)),C/max(float(C.max()),1e-12),.1)\n        pair_times_pot.append(time.time()-t_s)\n        \n        t_s = time.time()\n        z1=torch.tensor(np.column_stack([a,y[idx]]),dtype=torch.float32)[None]\n        z2=torch.tensor(np.column_stack([b,ry[jdx]+10]),dtype=torch.float32)[None]\n        with torch.inference_mode(): f,_=potential(z1,z2)\n        pair_times_geom.append(time.time()-t_s)\n\nprint(f'cdist total: {sum(pair_times_cdist):.3f}s')\nprint(f'POT total: {sum(pair_times_pot):.3f}s')\nprint(f'GeomLoss total: {sum(pair_times_geom):.3f}s')\nprint(f'Per-pair POT: {[f\\\\\\\"{t:.3f}\\\\\\\" for t in pair_times_pot]}')\nprint(f'Per-pair Geom: {[f\\\\\\\"{t:.3f}\\\\\\\" for t in pair_times_geom]}')\n\n# Batch-level OT\nbatchcost = np.random.rand(len(tx), len(tr))\nt_s = time.time()\nQ = ot.sinkhorn(ot.unif(len(tx)), ot.unif(len(tr)), batchcost/max(batchcost.max(),1e-12), .01, numItermax=10000, stopThr=1e-10)\nprint(f'Batch OT: {time.time()-t_s:.4f}s')\n\\\" 2>&1 | grep -v -i warning\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

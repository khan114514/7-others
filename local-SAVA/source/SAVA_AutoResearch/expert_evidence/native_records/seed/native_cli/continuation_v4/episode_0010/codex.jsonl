{"type": "item.started", "item": {"id": "item_118", "type": "command_execution", "command": "/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np, torch, ot, time\nfrom scipy.spatial.distance import cdist\nfrom scipy.special import logsumexp\nfrom geomloss import SamplesLoss\n\ntorch.set_num_threads(2)\nd = np.load('/workspace/environment/public_assets/dev/seed_101_asymmetric_labels.npz')\nx, y, r, ry = d['x'], d['y'], d['r'], d['ry']\n\n# Full label cost with log-domain annealing\ndef w_logsink_anneal(x, y, r, ry, iters_per=10):\n    xx = np.concatenate([x, r])\n    yy = np.concatenate([y, ry + 10])\n    W = np.zeros((20, 20), dtype=np.float64)\n    p = 2\n    blur = np.sqrt(0.1)\n    scaling = 0.5\n    for i in range(20):\n        ai = xx[yy == i].astype(np.float64)\n        ni = len(ai)\n        for j in range(i + 1, 20):\n            bj = xx[yy == j].astype(np.float64)\n            nj = len(bj)\n            C = cdist(ai, bj, 'sqeuclidean') / 2.0\n            # Epsilon schedule\n            mins = np.minimum(ai.min(0), bj.min(0))\n            maxs = np.maximum(ai.max(0), bj.max(0))\n            diameter = np.linalg.norm(maxs - mins)\n            eps_list = [diameter**p]\n            eps = diameter**p\n            while eps > blur**p * (scaling**p):\n                eps *= scaling**p\n                eps_list.append(eps)\n            eps_list.append(blur**p)\n            \n            # Log-domain sinkhorn\n            a_w = np.ones(ni)/ni\n            b_w = np.ones(nj)/nj\n            log_a = np.log(a_w)\n            log_b = np.log(b_w)\n            f = np.zeros(ni)\n            g = np.zeros(nj)\n            for eps_s in eps_list:\n                for _ in range(iters_per):\n                    f = -eps_s * logsumexp(log_b[None, :] + (g[None, :] - C) / eps_s, axis=1)\n                    g = -eps_s * logsumexp(log_a[:, None] + (f[:, None] - C) / eps_s, axis=0)\n            \n            logP = log_a[:, None] + log_b[None, :] + (f[:, None] + g[None, :] - C) / eps_s\n            P = np.exp(logP)\n            dist = np.sum(P * C)\n            W[i, j] = W[j, i] = dist\n    return W\n\ndef w_geomloss(x, y, r, ry):\n    xx=torch.tensor(np.concatenate([x,r]),dtype=torch.float32)\n    yy=np.concatenate([y,ry+10])\n    W=np.zeros((20,20),dtype=np.float64)\n    loss=SamplesLoss('sinkhorn',p=2,blur=np.sqrt(.1),debias=False,backend='tensorized')\n    with torch.inference_mode():\n        for i in range(20):\n            for j in range(i+1,20):\n                W[i,j]=W[j,i]=float(loss(xx[yy==i][None],xx[yy==j][None]))\n    return W\n\n# Warm up\n_ = w_logsink_anneal(x[:100], y[:100], r[:100], ry[:100], 5)\n\nt0 = time.time()\nW_log = w_logsink_anneal(x[:1024], y[:1024], r[:1024], ry[:1024], 10)\nt1 = time.time()\nprint(f'LogSink W: {t1-t0:.3f}s')\n\nt0 = time.time()\nW_geom = w_geomloss(x[:1024], y[:1024], r[:1024], ry[:1024])\nt1 = time.time()\nprint(f'GeomLoss W: {t1-t0:.3f}s')\n\n# W comparison\nrel = np.abs(W_log - W_geom) / (W_geom + 1e-10)\noff = rel[np.triu_indices(20, k=1)]\nprint(f'W off-diag mean rel diff: {off.mean():.6f}')\nprint(f'W off-diag max rel diff: {off.max():.6f}')\n\n# Full value comparison\ndef v15_value(x, y, r, ry, W):\n    N, M = len(x), len(r)\n    eps = 0.1\n    C = cdist(x, r, 'sqeuclidean')/2.0 + W[y[:,None], ry[None,:]+10]/2.0\n    P = ot.sinkhorn(np.ones(N)/N, np.ones(M)/M, C, eps, numItermax=2000)\n    log_ratio = np.log(P + 1e-300) - np.log(np.ones(N)/N)[:,None] - np.log(np.ones(M)/M)[None,:]\n    fg_sum = eps * log_ratio + C\n    f = fg_sum.mean(axis=1)\n    return (f - f.mean()) * N / (N - 1)\n\nvals_g = v15_value(x, y, r, ry, W_geom)\nvals_l = v15_value(x, y, r, ry, W_log)\n\ndef nrmse(pred, true):\n    return np.sqrt(np.mean((pred - true)**2)) / np.std(true)\ndef spearman(a, b):\n    from scipy.stats import spearmanr\n    return spearmanr(a, b)[0]\ndef topq_overlap(a, b, q=0.25):\n    k = int(len(a) * q)\n    return len(set(np.argsort(-a)[:k]) & set(np.argsort(-b)[:k])) / k\n\nprint()\nprint('Values comparison:')\nprint(f'  NRMSE: {nrmse(vals_l, vals_g):.6f}')\nprint(f'  Spearman: {spearman(vals_l, vals_g):.6f}')\nprint(f'  Top25% overlap: {topq_overlap(vals_l, vals_g):.4f}')\n\\\" 2>&1 | grep -v -i warning | grep -v divide | grep -v \\\"v = \\\" | grep -v \\\"u = \\\"\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

{"type": "item.started", "item": {"id": "item_86", "type": "command_execution", "command": "/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np, time, torch, ot\nfrom scipy.spatial.distance import cdist\nfrom geomloss import SamplesLoss\n\ntorch.set_num_threads(2)\nd = np.load('/workspace/environment/public_assets/dev/seed_101_asymmetric_labels.npz')\nx, y, r, ry = d['x'], d['y'], d['r'], d['ry']\nN, M = len(x), len(r)\n\ndef w_geomloss(x,y,r,ry):\n    xx=torch.tensor(np.concatenate([x,r]),dtype=torch.float32)\n    yy=np.concatenate([y,ry+10])\n    W=np.zeros((20,20),dtype=np.float64)\n    loss=SamplesLoss('sinkhorn',p=2,blur=np.sqrt(.1),debias=False,backend='tensorized')\n    with torch.inference_mode():\n        for i in range(20):\n            for j in range(i+1,20):\n                W[i,j]=W[j,i]=float(loss(xx[yy==i][None],xx[yy==j][None]))\n    return W\n\ndef w_centroid(x,y,r,ry):\n    xx=np.concatenate([x,r])\n    yy=np.concatenate([y,ry+10])\n    W=np.zeros((20,20),dtype=np.float64)\n    centroids = np.array([xx[yy==i].mean(0) for i in range(20)])\n    for i in range(20):\n        for j in range(i+1,20):\n            W[i,j]=W[j,i]=np.sum((centroids[i]-centroids[j])**2)/2\n    return W\n\ndef w_subsample_pot(x,y,r,ry, n_samples=30):\n    xx=np.concatenate([x,r])\n    yy=np.concatenate([y,ry+10])\n    W=np.zeros((20,20),dtype=np.float64)\n    eps = 0.1\n    rng = np.random.RandomState(42)\n    for i in range(20):\n        all_i = xx[yy==i]\n        if len(all_i) > n_samples:\n            idx = rng.choice(len(all_i), n_samples, replace=False)\n            ai = all_i[idx].astype(np.float64)\n        else:\n            ai = all_i.astype(np.float64)\n        ni = len(ai)\n        for j in range(i+1,20):\n            all_j = xx[yy==j]\n            if len(all_j) > n_samples:\n                jdx = rng.choice(len(all_j), n_samples, replace=False)\n                bj = all_j[jdx].astype(np.float64)\n            else:\n                bj = all_j.astype(np.float64)\n            nj = len(bj)\n            C = cdist(ai, bj, 'sqeuclidean') / 2.0\n            Cmax = max(C.max(), 1e-12)\n            dv = ot.sinkhorn2(np.ones(ni)/ni, np.ones(nj)/nj, C/Cmax, eps, numItermax=500)\n            W[i,j] = W[j,i] = float(dv) * Cmax\n    return W\n\n# Warm up torch\n_ = w_geomloss(x[:100], y[:100], r[:100], ry[:100])\n\nt0 = time.time()\nWg = w_geomloss(x[:1024], y[:1024], r[:1024], ry[:1024])\nt1 = time.time()\nprint(f'GeomLoss W: {t1-t0:.3f}s')\n\nt0 = time.time()\nWc = w_centroid(x[:1024], y[:1024], r[:1024], ry[:1024])\nt1 = time.time()\nprint(f'Centroid W: {t1-t0:.4f}s')\n\nt0 = time.time()\nWp30 = w_subsample_pot(x[:1024], y[:1024], r[:1024], ry[:1024], 30)\nt1 = time.time()\nprint(f'POT subsample 30 W: {t1-t0:.4f}s')\n\n# Compare W values\nprint(f'Geom W range: [{Wg.min():.1f}, {Wg.max():.1f}]')\nprint(f'Centroid W range: [{Wc.min():.1f}, {Wc.max():.1f}]')\nprint(f'POT30 W range: [{Wp30.min():.1f}, {Wp30.max():.1f}]')\n\n# Now test full value computation with each W\ndef v15_value(x, y, r, ry, W):\n    N, M = len(x), len(r)\n    eps = 0.1\n    C = cdist(x, r, 'sqeuclidean')/2.0 + W[y[:,None], ry[None,:]+10]/2.0\n    P = ot.sinkhorn(np.ones(N)/N, np.ones(M)/M, C, eps, numItermax=2000)\n    log_ratio = np.log(P + 1e-300) - np.log(np.ones(N)/N)[:,None] - np.log(np.ones(M)/M)[None,:]\n    fg_sum = eps * log_ratio + C\n    f = fg_sum.mean(axis=1)\n    return (f - f.mean()) * N / (N - 1)\n\nvals_geom = v15_value(x, y, r, ry, Wg)\nvals_cent = v15_value(x, y, r, ry, Wc)\nvals_p30 = v15_value(x, y, r, ry, Wp30)\n\ndef nrmse(pred, true):\n    return np.sqrt(np.mean((pred - true)**2)) / np.std(true)\ndef spearman(a, b):\n    from scipy.stats import spearmanr\n    return spearmanr(a, b)[0]\ndef topq_overlap(a, b, q=0.25):\n    k = int(len(a) * q)\n    sa = set(np.argsort(-a)[:k])\n    sb = set(np.argsort(-b)[:k])\n    return len(sa & sb) / k\n\nprint()\nprint('Centroid W vs GeomLoss W:')\nprint(f'  NRMSE: {nrmse(vals_cent, vals_geom):.6f}')\nprint(f'  Spearman: {spearman(vals_cent, vals_geom):.6f}')\nprint(f'  Top25% overlap: {topq_overlap(vals_cent, vals_geom):.4f}')\n\nprint('POT30 W vs GeomLoss W:')\nprint(f'  NRMSE: {nrmse(vals_p30, vals_geom):.6f}')\nprint(f'  Spearman: {spearman(vals_p30, vals_geom):.6f}')\nprint(f'  Top25% overlap: {topq_overlap(vals_p30, vals_geom):.4f}')\n\\\" 2>&1 | grep -v -i warning | grep -v divide | grep -v \\\"v = \\\"\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

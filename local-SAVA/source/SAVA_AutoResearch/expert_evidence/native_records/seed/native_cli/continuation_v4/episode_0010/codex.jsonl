{"type": "item.started", "item": {"id": "item_116", "type": "command_execution", "command": "/bin/sh -lc \"cd /workspace/solution && python3 -c \\\"\nimport numpy as np, torch, ot, time\nfrom scipy.spatial.distance import cdist\nfrom scipy.special import logsumexp\nfrom geomloss import SamplesLoss\n\ntorch.set_num_threads(2)\nd = np.load('/workspace/environment/public_assets/dev/seed_101_asymmetric_labels.npz')\nx, y, r, ry = d['x'], d['y'], d['r'], d['ry']\nxx = np.concatenate([x[:1024], r[:1024]])\nyy = np.concatenate([y[:1024], ry[:1024] + 10])\n\ni, j = 0, 5\nai = xx[yy == i].astype(np.float64)\nbj = xx[yy == j].astype(np.float64)\nni, nj = len(ai), len(bj)\n\nC = cdist(ai, bj, 'sqeuclidean') / 2.0\n\n# Log-domain Sinkhorn with annealing\ndef log_sinkhorn_anneal(C, eps_list, a, b, iters_per=20, tol=1e-9):\n    n, m = C.shape\n    f = np.zeros(n)\n    g = np.zeros(m)\n    log_a = np.log(a)\n    log_b = np.log(b)\n    for eps in eps_list:\n        for k in range(iters_per):\n            f_prev = f.copy()\n            # f_i = -eps * logsumexp_j(log_b_j + (g_j - C_ij) / eps)\n            f = -eps * logsumexp(log_b[None, :] + (g[None, :] - C) / eps, axis=1)\n            g = -eps * logsumexp(log_a[:, None] + (f[:, None] - C) / eps, axis=0)\n            if np.max(np.abs(f - f_prev)) < tol * eps:\n                break\n    # Compute distance\n    logP = log_a[:, None] + log_b[None, :] + (f[:, None] + g[None, :] - C) / eps\n    P = np.exp(logP)\n    dist = np.sum(P * C)\n    return dist, f, g, P\n\n# Build eps schedule\nmins = np.minimum(ai.min(0), bj.min(0))\nmaxs = np.maximum(ai.max(0), bj.max(0))\ndiameter = np.linalg.norm(maxs - mins)\np = 2\nblur = np.sqrt(0.1)\nscaling = 0.5\n\neps_list = [diameter**p]\neps = diameter**p\nwhile eps > blur**p * (scaling**p):\n    eps *= scaling**p\n    eps_list.append(eps)\neps_list.append(blur**p)\n\nprint(f'Eps list ({len(eps_list)}): {[f\\\\\\\"{e:.2f}\\\\\\\" for e in eps_list]}')\n\na_w = np.ones(ni)/ni\nb_w = np.ones(nj)/nj\n\nt0 = time.time()\ndist, f, g, P = log_sinkhorn_anneal(C, eps_list, a_w, b_w, iters_per=20)\nt1 = time.time()\nprint(f'Log-domain annealing: {dist:.4f} in {t1-t0:.4f}s')\n\n# GeomLoss\nloss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\nat = torch.tensor(ai[None], dtype=torch.float32)\nbt = torch.tensor(bj[None], dtype=torch.float32)\nwith torch.inference_mode():\n    gl = float(loss(at, bt))\nprint(f'GeomLoss: {gl:.4f}')\nprint(f'Relative diff: {abs(dist - gl) / gl:.6f}')\n\n# Try with fewer iterations\nfor n_iter in [30, 20, 15, 10, 5]:\n    d2, _, _, _ = log_sinkhorn_anneal(C, eps_list, a_w, b_w, iters_per=n_iter)\n    print(f'  {n_iter} iters/scale: dist={d2:.4f}, rel_err={abs(d2-gl)/gl:.6f}')\n\\\" 2>&1\n\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

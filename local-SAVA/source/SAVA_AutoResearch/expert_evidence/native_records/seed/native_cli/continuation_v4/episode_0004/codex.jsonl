nce.py\n-rw-r--r-- 1 actor actor 4283 Oct 10 12:26 /tmp/research_history/test_detailed_timing.py\n-rw-r--r-- 1 actor actor 4711 Oct 10 12:26 /tmp/research_history/test_fast_q.py\n-rw-r--r-- 1 actor actor 4083 Oct 10 12:26 /tmp/research_history/test_full_timing.py\n-rw-r--r-- 1 actor actor 5796 Oct 10 12:26 /tmp/research_history/test_geomloss_formulas.py\n-rw-r--r-- 1 actor actor 5130 Oct 10 12:26 /tmp/research_history/test_geomloss_matched_reg.py\n-rw-r--r-- 1 actor actor 4959 Oct 10 12:26 /tmp/research_history/test_geomloss_p_verify.py\n-rw-r--r-- 1 actor actor 3627 Oct 10 12:26 /tmp/research_history/test_pot_accel.py\n-rw-r--r-- 1 actor actor 2701 Oct 10 12:26 /tmp/research_history/test_sinkhorn_real.py\n-rw-r--r-- 1 actor actor 2661 Oct 10 12:26 /tmp/research_history/test_sinkhorn_speed.py\n-rw-r--r-- 1 actor actor  844 Oct 10 12:26 /tmp/research_history/test_timing2.py\n-rw-r--r-- 1 actor actor 7990 Oct 10 12:26 /tmp/research_history/test_v10_variants.py\n-rw-r--r-- 1 actor actor 5536 Oct 10 12:26 /tmp/research_history/test_v11.py\n-rw-r--r-- 1 actor actor 6902 Oct 10 12:26 /tmp/research_history/test_v12_multi.py\n-rw-r--r-- 1 actor actor 1598 Oct 10 12:26 /tmp/research_history/test_weights.py\n-rw-r--r-- 1 actor actor 3046 Oct 10 12:26 /tmp/research_history/v12_quick_compare.py\n", "exit_code": 0, "status": "completed"}}

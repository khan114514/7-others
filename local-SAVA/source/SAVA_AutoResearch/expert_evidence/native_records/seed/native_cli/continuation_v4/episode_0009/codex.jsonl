p[yy_np == j]\n        ni, nj = len(ai), len(bj)\n        if ni == 0 or nj == 0: continue\n        C = cdist(ai, bj, 'sqeuclidean') / 2.0\n        P = sinkhorn_log_fn(np.ones(ni)/ni, np.ones(nj)/nj, C, eps, numItermax=500)\n        W_pot[i, j] = W_pot[j, i] = np.sum(P * C)\nprint(f\\\"POT log W (500 iter): {time.time()-t0:.4f}s\\\")\nprint(f\\\"  max diff: {np.abs(W_geom-W_pot).max():.4f}, mean: {np.abs(W_geom-W_pot).mean():.6f}\\\")\nprint(f\\\"  ratio range: {np.min(W_pot[W_geom>0]/W_geom[W_geom>0]):.4f} - {np.max(W_pot[W_geom>0]/W_geom[W_geom>0]):.4f}\\\")\n\n# Fewer iterations\nfor niter in [200, 100, 50]:\n    t0 = time.time()\n    W_pot2 = np.zeros((20, 20), dtype=np.float64)\n    for i in range(20):\n        for j in range(i + 1, 20):\n            ai = xx_np[yy_np == i]\n            bj = xx_np[yy_np == j]\n            ni, nj = len(ai), len(bj)\n            if ni == 0 or nj == 0: continue\n            C = cdist(ai, bj, 'sqeuclidean') / 2.0\n            P = sinkhorn_log_fn(np.ones(ni)/ni, np.ones(nj)/nj, C, eps, numItermax=niter)\n            W_pot2[i, j] = W_pot2[j, i] = np.sum(P * C)\n    print(f\\\"POT log W ({niter} iter): {time.time()-t0:.4f}s, max diff: {np.abs(W_geom-W_pot2).max():.4f}\\\")\n\n# Wait - sum(P*C) is the OT cost, but GeomLoss Sinkhorn loss includes entropy term?\n# Actually, let me check the exact formula. GeomLoss returns the Sinkhorn loss.\n# Sinkhorn loss = OT_eps = min <P,C> + eps*KL(P|a⊗b)\n# But POT sinkhorn2 also returns the regularized OT value.\n# Hmm but they differ... Let me check a pair.\n\n# Actually, let me check what GeomLoss \\\"sinkhorn\\\" loss returns exactly.\n# From GeomLoss source: loss = SamplesLoss(\\\"sinkhorn\\\", p=2, blur=...)\n# Sinkhorn loss (debias=False) returns OT_ε, the full regularized OT.\n# Let me compute OT_eps = sum(P*C) + eps*(sum(P*log(P/(a b\"'^T))))\n\nfor niter in [500, 200]:\n    W_pot_full = np.zeros((20, 20), dtype=np.float64)\n    t0 = time.time()\n    for i in range(20):\n        for j in range(i + 1, 20):\n            ai = xx_np[yy_np == i]\n            bj = xx_np[yy_np == j]\n            ni, nj = len(ai), len(bj)\n            if ni == 0 or nj == 0: continue\n            C = cdist(ai, bj, '\"'sqeuclidean') / 2.0\n            a_w = np.ones(ni)/ni\n            b_w = np.ones(nj)/nj\n            P = sinkhorn_log_fn(a_w, b_w, C, eps, numItermax=niter)\n            # Full Sinkhorn loss (with entropy)\n            log_P = np.log(P + 1e-300)\n            log_ab = np.log(a_w[:,None]) + np.log(b_w[None,:])\n            kl = np.sum(P * (log_P - log_ab))\n            W_pot_full[i, j] = W_pot_full[j, i] = np.sum(P * C) + eps * kl\n    elapsed = time.time()-t0\n    print(f\\\"\\\\nPOT log W_full (OT_eps, {niter} iter): {elapsed:.4f}s\\\")\n    print(f\\\"  max diff: {np.abs(W_geom-W_pot_full).max():.4f}\\\")\n    print(f\\\"  ratio range: {np.min(W_pot_full[W_geom>0]/W_geom[W_geom>0]):.6f} - {np.max(W_pot_full[W_geom>0]/W_geom[W_geom>0]):.6f}\\\")\n\nPYEOF\ncd /workspace/solution && python /tmp/test_label_stable.py 2>&1 | grep -v Warning | grep -v divide | grep -v RuntimeWarning | grep -v UserWarning | grep -v \\\"\"'^  v =\" | grep -v \"''^  new_v\" | grep -v \"''^  G'\"\\\\[\\\" | grep -v viol\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

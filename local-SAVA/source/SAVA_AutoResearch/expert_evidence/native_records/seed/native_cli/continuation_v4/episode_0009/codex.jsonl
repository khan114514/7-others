hes: {len(tx)} x {len(tr)} = {len(tx)*len(tr)} pairs\\\")\n\nt0 = time.time()\nfor i, idx in enumerate(tx):\n    for j, jdx in enumerate(tr):\n        Cb = cdist(x[idx].astype(np.float64), r[jdx].astype(np.float64), 'sqeuclidean') / 2.0 + W[y[idx[:, None]], ry[jdx[None, :]] + 10].astype(np.float64) / 2.0\n        Pb = ot.sinkhorn(np.ones(len(idx))/len(idx), np.ones(len(jdx))/len(jdx), Cb, eps, numItermax=500)\nprint(f\\\"6 pairs POT 500 iter: {time.time()-t0:.4f}s\\\")\n\nt0 = time.time()\nfor i, idx in enumerate(tx):\n    for j, jdx in enumerate(tr):\n        Cb = cdist(x[idx].astype(np.float64), r[jdx].astype(np.float64), 'sqeuclidean') / 2.0 + W[y[idx[:, None]], ry[jdx[None, :]] + 10].astype(np.float64) / 2.0\n        Pb = ot.sinkhorn(np.ones(len(idx))/len(idx), np.ones(len(jdx))/len(jdx), Cb, eps, numItermax=200)\nprint(f\\\"6 pairs POT 200 iter: {time.time()-t0:.4f}s\\\")\n\n# Test 3: sinkhorn_log (stable, maybe faster)\nt0 = time.time()\nP2 = ot.sinkhorn(a_w, b_w, C, eps, numItermax=500, method='sinkhorn_log')\nprint(f\\\"sinkhorn_log 500 iter (3000x2000): {time.time()-t0:.4f}s\\\")\n\n# Test 4: greenkhorn (sparsity)\nt0 = time.time()\ntry:\n    P3 = ot.sinkhorn(a_w, b_w, C, eps, numItermax=200, method='greenkhorn')\n    print(f\\\"greenkhorn 200 iter: {time.time()-t0:.4f}s\\\")\nexcept Exception as e:\n    print(f\\\"greenkhorn failed: {e}\\\")\n\n# Test: POT's emd? No, that's exact and slower.\n\n# Check convergence: what's the typical error at 200 vs 500 iter?\nfrom ot.bregman import sinkhorn as sinkhorn_fn\nf, g = sinkhorn_fn(a_w, b_w, C, eps, numItermax=200, log=True)[1]['logu'], sinkhorn_fn(a_w, b_w, C, eps, numItermax=200, log=True)[1]['logv']\n# Not easy to check. Let's compare potentials\n# Use log method properly\nPYEOF\ncd /workspace/solution && python /tmp/test_variants.py 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

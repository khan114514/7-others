 = N // 4\n            top_ref = set(np.argsort(-v_ref)[:k])\n            top_test = set(np.argsort(-v_test)[:k])\n            overlap = len(top_ref & top_test) / k\n            \n            print(f\\\"label_n={label_n:4d} bs={bs:4d} iter={it:4d}: {elapsed:.4f}s  NRMSE={nrmse:.6f}  Spearman={sp:.6f}  Overlap={overlap:.4f}\\\")\n\nPYEOF\ncd /workspace/solution && python /tmp/test_fast_method.py 2>&1 | grep -v Warning | grep -v RuntimeWarning | grep -v UserWarning | grep -v \\\"  v =\\\" | grep -v \\\"  P =\\\" | grep -v \\\"  G =\\\" | grep -v \\\"viol\\\"\"", "aggregated_output": "v15 time: 1.2513s\nlabel_n= 512 bs=1024 iter= 500: 1.2293s  NRMSE=0.664716  Spearman=0.993712  Overlap=0.9680\nlabel_n= 512 bs=1024 iter= 200: 1.3268s  NRMSE=0.664716  Spearman=0.993712  Overlap=0.9680\nlabel_n= 512 bs=2048 iter= 500: 0.9907s  NRMSE=0.497962  Spearman=0.993733  Overlap=0.9680\nlabel_n= 512 bs=2048 iter= 200: 0.7334s  NRMSE=0.497962  Spearman=0.993733  Overlap=0.9680\nlabel_n= 256 bs=1024 iter= 500: 1.1147s  NRMSE=0.663216  Spearman=0.990754  Overlap=0.9613\nlabel_n= 256 bs=1024 iter= 200: 1.2946s  NRMSE=0.663216  Spearman=0.990754  Overlap=0.9613\nlabel_n= 256 bs=2048 iter= 500: 1.0031s  NRMSE=0.496303  Spearman=0.990747  Overlap=0.9627\nlabel_n= 256 bs=2048 iter= 200: 0.7925s  NRMSE=0.496303  Spearman=0.990747  Overlap=0.9627\nlabel_n= 128 bs=1024 iter= 500: 1.0987s  NRMSE=0.667863  Spearman=0.986819  Overlap=0.9467\nlabel_n= 128 bs=1024 iter= 200: 1.2990s  NRMSE=0.667863  Spearman=0.986819  Overlap=0.9467\nlabel_n= 128 bs=2048 iter= 500: 0.7937s  NRMSE=0.503100  Spearman=0.986793  Overlap=0.9453\nlabel_n= 128 bs=2048 iter= 200: 0.7408s  NRMSE=0.503100  Spearman=0.986793  Overlap=0.9453\n", "exit_code": 0, "status": "completed"}}

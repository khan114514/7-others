{"type": "item.started", "item": {"id": "item_38", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/test_label_cost_greenkhorn.py << 'PYEOF'\nimport sys, time\nsys.path.insert(0, '/workspace/solution')\nimport numpy as np\nimport torch\nimport ot\nfrom scipy.spatial.distance import cdist\nfrom geomloss import SamplesLoss\n\nimport os\ndev = '/workspace/environment/public_assets/dev'\nfiles = sorted(os.listdir(dev))\ndata = np.load(os.path.join(dev, files[0]))\nx = np.array(data['x'], dtype=np.float32)\ny = np.array(data['y'], dtype=np.int64)\nr = np.array(data['r'], dtype=np.float32)\nry = np.array(data['ry'], dtype=np.int64)\nN, M = len(x), len(r)\ntorch.set_num_threads(2)\n\n# Test 1: label cost with 1024 batch (canonical approach)\nt0 = time.time()\nxx = torch.tensor(np.concatenate([x[:1024], r[:1024]]), dtype=torch.float32)\nyy = np.concatenate([y[:1024], ry[:1024] + 10])\nW1024 = np.zeros((20, 20), dtype=np.float32)\nloss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\nwith torch.inference_mode():\n    for i in range(20):\n        for j in range(i + 1, 20):\n            W1024[i, j] = W1024[j, i] = float(loss(xx[yy == i], xx[yy == j]))\nprint(f\\\"Label cost (1024 batch): {time.time()-t0:.4f}s\\\")\n\n# Test 2: label cost with 512 batch\nt0 = time.time()\nxx = torch.tensor(np.concatenate([x[:512], r[:512]]), dtype=torch.float32)\nyy = np.concatenate([y[:512], ry[:512] + 10])\nW512 = np.zeros((20, 20), dtype=np.float32)\nwith torch.inference_mode():\n    for i in range(20):\n        for j in range(i + 1, 20):\n            W512[i, j] = W512[j, i] = float(loss(xx[yy == i], xx[yy == j]))\nprint(f\\\"Label cost (512 batch): {time.time()-t0:.4f}s\\\")\n\n# Compare W matrices\nprint(f\\\"W diff 1024 vs 512: max={np.abs(W1024-W512).max():.4f}, mean={np.abs(W1024-W512).mean():.6f}\\\")\n\n# Test 3: Use cdist centroid distances as cheap W approximation\nt0 = time.time()\nW_cheap = np.zeros((20, 20), dtype=np.float32)\nxx_all = np.concatenate([x, r])\nyy_all = np.concatenate([y, ry + 10])\ncentroids = np.zeros((20, 10), dtype=np.float32)\nfor i in range(20):\n    mask = yy_all == i\n    centroids[i] = xx_all[mask].mean(axis=0)\nfor i in range(20):\n    for j in range(i+1, 20):\n        W_cheap[i,j] = W_cheap[j,i] = np.sum((centroids[i] - centroids[j])**2) / 2.0\nprint(f\\\"Cheap W (centroids): {time.time()-t0:.4f}s\\\")\nprint(f\\\"W diff full vs cheap: max={np.abs(W1024-W_cheap).max():.4f}, mean={np.abs(W1024-W_cheap).mean():.6f}\\\")\n\n# Test greenkhorn quality - compare potentials with regular sinkhorn\neps = 0.1\nC = cdist(x.astype(np.float64), r.astype(np.float64), 'sqeuclidean') / 2.0 + W1024[y[:, None], ry[None, :] + 10].astype(np.float64) / 2.0\na_w = np.ones(N) / N\nb_w = np.ones(M) / M\n\ndef potentials_from_P(P, C, eps, a_w, b_w):\n    log_ratio = np.log(P + 1e-300) - np.log(a_w[:, None]) - np.log(b_w[None, :])\n    fg_sum = eps * log_ratio + C\n    f = fg_sum.mean(axis=1)\n    g = fg_sum.mean(axis=0)\n    offset = (f.mean() + g.mean()) / 2\n    return f - offset, g - offset\n\n# Reference: standard sinkhorn 2000 iter\nt0 = time.time()\nP_ref = ot.sinkhorn(a_w, b_w, C, eps, numItermax=2000)\nf_ref, g_ref = potentials_from_P(P_ref, C, eps, a_w, b_w)\nprint(f\\\"\\\\nRef sinkhorn 2000 iter: {time.time()-t0:.4f}s\\\")\n\n# Greenkhorn 500 iter\nt0 = time.time()\ntry:\n    P_gk = ot.sinkhorn(a_w, b_w, C, eps, numItermax=500, method='greenkhorn')\n    f_gk, g_gk = potentials_from_P(P_gk, C, eps, a_w, b_w)\n    print(f\\\"Greenkhorn 500 iter: {time.time()-t0:.4f}s\\\")\n    # Check if potentials are close\n    print(f\\\"  f error: max={np.abs(f_ref-f_gk).max():.6f}, mean={np.abs(f_ref-f_gk).mean():.6f}\\\")\n    print(f\\\"  mass error: {np.abs(P_gk.sum()-1):.2e}\\\")\nexcept Exception as e:\n    print(f\\\"Greenkhorn 500 failed: {e}\\\")\n\n# Greenkhorn 200 iter\nt0 = time.time()\ntry:\n    P_gk2 = ot.sinkhorn(a_w, b_w, C, eps, numItermax=200, method='greenkhorn')\n    f_gk2, g_gk2 = potentials_from_P(P_gk2, C, eps, a_w, b_w)\n    print(f\\\"Greenkhorn 200 iter: {time.time()-t0:.4f}s\\\")\n    print(f\\\"  f error: max={np.abs(f_ref-f_gk2).max():.6f}, mean={np.abs(f_ref-f_gk2).mean():.6f}\\\")\nexcept Exception as e:\n    print(f\\\"Greenkhorn 200 failed: {e}\\\")\n\n# Regular sinkhorn 200 iter\nt0 = time.time()\nP_200 = ot.sinkhorn(a_w, b_w, C, eps, numItermax=200)\nf_200, g_200 = potentials_from_P(P_200, C, eps, a_w, b_w)\nprint(f\\\"Sinkhorn 200 iter: {time.time()-t0:.4f}s\\\")\nprint(f\\\"  f error: max={np.abs(f_ref-f_200).max():.6f}, mean={np.abs(f_ref-f_200).mean():.6f}\\\")\n\nPYEOF\ncd /workspace/solution && python /tmp/test_label_cost_greenkhorn.py 2>&1\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

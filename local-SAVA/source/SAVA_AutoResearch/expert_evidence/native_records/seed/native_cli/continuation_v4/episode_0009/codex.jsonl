{"type": "item.started", "item": {"id": "item_41", "type": "command_execution", "command": "/bin/sh -lc \"cat > /tmp/test_fast_method.py << 'PYEOF'\nimport sys, time\nsys.path.insert(0, '/workspace/solution')\nimport numpy as np\nimport torch\nimport ot\nfrom scipy.spatial.distance import cdist\nfrom geomloss import SamplesLoss\n\nimport os\ndev = '/workspace/environment/public_assets/dev'\nfiles = sorted(os.listdir(dev))\ndata = np.load(os.path.join(dev, files[0]))\nx = np.array(data['x'], dtype=np.float32)\ny = np.array(data['y'], dtype=np.int64)\nr = np.array(data['r'], dtype=np.float32)\nry = np.array(data['ry'], dtype=np.int64)\nN, M = len(x), len(r)\ntorch.set_num_threads(2)\n\ndef label_cost_geomloss(x_sample, y_sample, r_sample, ry_sample):\n    xx = torch.tensor(np.concatenate([x_sample, r_sample]), dtype=torch.float32)\n    yy = np.concatenate([y_sample, ry_sample + 10])\n    W = np.zeros((20, 20), dtype=np.float32)\n    loss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\n    with torch.inference_mode():\n        for i in range(20):\n            for j in range(i + 1, 20):\n                W[i, j] = W[j, i] = float(loss(xx[yy == i], xx[yy == j]))\n    return W\n\ndef value_fast(x, y, r, ry, seed=17, batch_size=1024, label_n=512, sinkhorn_iter=500):\n    x = np.asarray(x, np.float32)\n    r = np.asarray(r, np.float32)\n    y = np.asarray(y, np.int64)\n    ry = np.asarray(ry, np.int64)\n    N = len(x)\n    M = len(r)\n\n    tx = [np.arange(i, min(i + batch_size, N)) for i in range(0, N, batch_size)]\n    tr = [np.arange(i, min(i + batch_size, M)) for i in range(0, M, batch_size)]\n\n    # Label cost from first sample\n    W = label_cost_geomloss(x[:label_n], y[:label_n], r[:label_n], ry[:label_n])\n\n    eps = 0.1\n    F = {}\n    batchcost = np.zeros((len(tx), len(tr)))\n\n    for i, idx in enumerate(tx):\n        for j, jdx in enumerate(tr):\n            a = x[idx].astype(np.float64)\n            b = r[jdx].astype(np.float64)\n            n_src = len(idx)\n            n_tgt = len(jdx)\n\n            C = cdist(a, b, 'sqeuclidean') / 2.0 + W[y[idx[:, None]], ry[jdx[None, :]] + 10].astype(np.float64) / 2.0\n\n            a_w = np.ones(n_src) / n_src\n            b_w = np.ones(n_tgt) / n_tgt\n            P = ot.sinkhorn(a_w, b_w, C, eps, numItermax=sinkhorn_iter)\n\n            log_ratio = np.log(P + 1e-300) - np.log(a_w[:, None]) - np.log(b_w[None, :])\n            fg_sum = eps * log_ratio + C\n            f = fg_sum.mean(axis=1)\n            g = fg_sum.mean(axis=0)\n            offset = (f.mean() + g.mean()) / 2\n            f = f - offset\n            g = g - offset\n\n            batchcost[i, j] = float(np.sum(P * C)) / (n_src + n_tgt)\n            f64 = f.astype(np.float64)\n            F[i, j] = (f64 - f64.mean()) * n_src / (n_src - 1)\n\n    bc_max = max(float(batchcost.max()), 1e-12)\n    Q = ot.sinkhorn(np.ones(len(tx)) / len(tx),\n                    np.ones(len(tr)) / len(tr),\n                    batchcost / bc_max, .01,\n                    numItermax=1000)\n    values = np.zeros(N)\n    for i, idx in enumerate(tx):\n        values[idx] = sum(Q[i, j] * F[i, j] for j in range(len(tr)))\n    return values\n\n# Reference: v15 (current method)\nimport importlib, method\nimportlib.reload(method)\nt0 = time.time()\nv_ref = method.value(x, y, r, ry, seed=101)\nprint(f\\\"v15 time: {time.time()-t0:.4f}s\\\")\n\n# Test v16 candidate\nfor label_n in [512, 256, 128]:\n    for bs in [1024, 2048]:\n        for it in [500, 200]:\n            t0 = time.time()\n            v_test = value_fast(x, y, r, ry, seed=101, batch_size=bs, label_n=label_n, sinkhorn_iter=it)\n            elapsed = time.time() - t0\n            \n            # Quality vs v15\n            nrmse = np.sqrt(np.mean((v_test - v_ref)**2)) / np.std(v_ref)\n            # Spearman\n            from scipy.stats import spearmanr\n            sp = spearmanr(v_test, v_ref)[0]\n            # top quartile overlap\n            k = N // 4\n            top_ref = set(np.argsort(-v_ref)[:k])\n            top_test = set(np.argsort(-v_test)[:k])\n            overlap = len(top_ref & top_test) / k\n            \n            print(f\\\"label_n={label_n:4d} bs={bs:4d} iter={it:4d}: {elapsed:.4f}s  NRMSE={nrmse:.6f}  Spearman={sp:.6f}  Overlap={overlap:.4f}\\\")\n\nPYEOF\ncd /workspace/solution && python /tmp/test_fast_method.py 2>&1 | grep -v Warning | grep -v RuntimeWarning | grep -v UserWarning | grep -v \\\"  v =\\\" | grep -v \\\"  P =\\\" | grep -v \\\"  G =\\\" | grep -v \\\"viol\\\"\"", "aggregated_output": "", "exit_code": null, "status": "in_progress"}}

{"type": "item.completed", "item": {"id": "item_2", "type": "command_execution", "command": "/bin/sh -lc 'cat /workspace/solution/method.py | head -50'", "aggregated_output": "\"\"\"v15: POT-accelerated Sinkhorn with potential derivation from coupling.\nUses ot.sinkhorn (C-optimized) instead of numpy log-domain loop.\nSingle full pair (N x M) to minimize pair count.\nPotentials derived from P via Sinkhorn relation f_i + g_j = eps*log(P_ij nm) + C_ij.\n\"\"\"\nimport numpy as np\nimport torch\nimport ot\nfrom geomloss import SamplesLoss\nfrom scipy.spatial.distance import cdist\n\n\ndef _label_cost(x, y, r, ry):\n    xx = torch.tensor(np.concatenate([x, r]), dtype=torch.float32)\n    yy = np.concatenate([y, ry + 10])\n    W = np.zeros((20, 20), dtype=np.float32)\n    loss = SamplesLoss('sinkhorn', p=2, blur=np.sqrt(.1), debias=False, backend='tensorized')\n    with torch.inference_mode():\n        for i in range(20):\n            for j in range(i + 1, 20):\n                if not (yy == i).any() or not (yy == j).any():\n                    raise ValueError('Initial batch lacks a label support')\n                W[i, j] = W[j, i] = float(loss(xx[yy == i], xx[yy == j]))\n    return W\n\n\ndef _sinkhorn_potentials(C, reg, a_w, b_w, max_iter=2000):\n    \"\"\"Return (f, g, P) using POT's sinkhorn then deriving potentials.\"\"\"\n    n, m = C.shape\n    P = ot.sinkhorn(a_w, b_w, C, reg, numItermax=max_iter)\n    # Sinkhorn relation: P_ij = a_i b_j exp((f_i + g_j - C_ij)/reg)\n    # => f_i + g_j = reg * log(P_ij / (a_i b_j)) + C_ij\n    log_ratio = np.log(P + 1e-300) - np.log(a_w[:, None]) - np.log(b_w[None, :])\n    fg_sum = reg * log_ratio + C\n    f = fg_sum.mean(axis=1)\n    g = fg_sum.mean(axis=0)\n    # Center (potentials are defined up to constant)\n    offset = (f.mean() + g.mean()) / 2\n    f = f - offset\n    g = g - offset\n    return f, g, P\n\n\ndef value(x, y, r, ry, seed=17, batch_size=4096):\n    torch.set_num_threads(2)\n    x = np.asarray(x, np.float32)\n    r = np.asarray(r, np.float32)\n    y = np.asarray(y, np.int64)\n    ry = np.asarray(ry, np.int64)\n    N = len(x)\n", "exit_code": 0, "status": "completed"}}
